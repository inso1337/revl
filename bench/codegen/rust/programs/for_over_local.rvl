// Build a list of records, then iterate it. The list is dead after the loop.
type Row = { id: Int, tag: Str }
pub fn for_over_local(n: Int) -> Int {
  var rows: List[Row] = []
  var i = 0
  while (i < n) {
    rows = rows.push({ id: i, tag: "row" })
    i = i + 1
  }
  var s = 0
  for (r of rows) {
    s = s + r.id
  }
  return s
}
