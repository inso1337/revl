// item 173 routed-require scenario, copied from
// backends/java/scenarios/router.rvl: three worker realms behind one Router.
// The Router `requires worker in realms(...)` and `provides worker`; its
// emitted body fans each call out across the worker realms through the
// cordis4j fork's strict single-realm liveness read (ctx.serviceInRealm) and
// fails over when a realm withdraws.
//
// F3: that fan-out probes every realm, discards the handle it just resolved,
// and then resolves the winner a second time.
service Worker { fn call(request: Str) -> Str }
component W1 provides worker: Worker {
  isolate worker in realm("w1")
  provide worker { fn call(request) = "w1:" + request }
}
component W2 provides worker: Worker {
  isolate worker in realm("w2")
  provide worker { fn call(request) = "w2:" + request }
}
component W3 provides worker: Worker {
  isolate worker in realm("w3")
  provide worker { fn call(request) = "w3:" + request }
}
component Router requires worker: Worker provides worker: Worker {
  // item 449 (G2): a `realms(...)` route realizes this component as a routing
  // proxy; the routed key is provided downstream through that proxy, so the
  // `provides worker: Worker` header clause alone is what the route needs. A
  // hand-written `provide worker { … }` body for the routed key is now refused
  // (it would be silently discarded at load) — dropped per #492's sanctioned
  // router shape. The EMITTED routing body still fans each call across the
  // worker realms; it derives from the `realms(...)` route, not from a body.
  isolate worker in realms("w1", "w2", "w3") strategy(round_robin)
}
