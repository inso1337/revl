// missing_compensate - the settlement has no compensation
//
// Seeded defect: `emit payments.settle(...)` carries no `compensate`, so a later failure leaves the settlement standing with no recorded action.
// Expected catch: missed
// Corpus index: bench/saga_defects/defects.json (issue #2736)

service Inventory {
  fn reserve(sku: Str, qty: Int) -> Int
  fn release(sku: Str, qty: Int) -> Int
}

service Payments {
  fn charge(order: Str, cents: Int) -> Str
  fn refund(order: Str, cents: Int) -> Int
  emission fn settle(order: Str, cents: Int) -> Int
  fn reverse(order: Str, cents: Int) -> Int
}

component Warehouse provides inventory: Inventory {
  let rows = effect Map.new() undo rows.drop()
  provide inventory {
    fn reserve(sku, qty) = rows.insert(sku, qty)
    fn release(sku, qty) = rows.remove(sku)
  }
}

component Ledger provides payments: Payments {
  let rows = effect Map.new() undo rows.drop()
  provide payments {
    fn charge(order, cents) = rows.insert(order, cents)
    fn refund(order, cents) = rows.remove(order)
    fn settle(order, cents) = rows.insert(order, cents)
    fn reverse(order, cents) = rows.remove(order)
  }
}

component Checkout requires inventory: Inventory, payments: Payments {
  let hold = effect inventory.reserve("sku-1", 1) undo inventory.release("sku-1", 1)
  let auth = effect payments.charge("order-1", 4200) undo payments.refund("order-1", 4200)
  emit payments.settle("order-1", 4200)
}
