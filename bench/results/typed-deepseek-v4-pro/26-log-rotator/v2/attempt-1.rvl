type Row = { id: Int }

service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

component LogRotator requires db: Database {
  config { keep: Int = 7 }

  emit db.execute(`INSERT INTO rotation_log (marker, keep) VALUES ('rotate', ${config.keep})`)
       compensate db.execute(`DELETE FROM rotation_log WHERE marker = 'rotate' AND keep = ${config.keep}`)
}
