service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

type Row = { id: Int }

component LogRotator requires db: Database {
  config { keep: Int = 7 }

  emit db.execute(`INSERT INTO rotation_log (keep) VALUES (${config.keep})`)
       compensate db.execute(`DELETE FROM rotation_log WHERE keep = ${config.keep}`)
}
