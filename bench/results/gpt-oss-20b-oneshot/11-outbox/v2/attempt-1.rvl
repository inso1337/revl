service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

component Outbox requires db: Database {
  let _ = effect { emit db.execute(`INSERT INTO outbox (status) VALUES ('pending')`) }
           undo   { emit db.execute(`DELETE FROM outbox WHERE status='pending'`) }

  let _ = effect { emit db.execute(`INSERT INTO outbox (status) VALUES ('dispatched')`) }
           undo   { emit db.execute(`DELETE FROM outbox WHERE status='dispatched'`) }
}
