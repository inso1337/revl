service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

service Billing {
  emission fn charge(acct: Str, cents: Str)
}

component BillingLedger requires db: Database provides billing: Billing {
  provide billing {
    fn charge(acct, cents) {
      emit db.execute(`INSERT INTO ledger (acct,cents,ts) VALUES (${acct},${cents},NOW())`)
           compensate db.execute(`INSERT INTO ledger (acct,cents,ts) VALUES (${acct},-${cents},NOW())`)
    }
  }
}
