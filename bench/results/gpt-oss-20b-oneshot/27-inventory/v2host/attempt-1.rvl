service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

service Inventory {
  emission fn reserve(sku: Str, n: Str)
  fn reserved(sku: Str) -> Opt[Str]
}

component InventoryKeeper requires db: Database provides inv: Inventory {
  config {}

  let store = effect Map.new() undo store.drop()

  provide inv {
    fn reserve(sku: Str, n: Str) {
      effect store.insert(sku, n)
      undo   store.remove(sku)
      emit db.execute(`INSERT INTO reservation_journal VALUES (${sku}, ${n})`)
    }

    fn reserved(sku: Str) -> Opt[Str] {
      store.get(sku)
    }
  }
}
