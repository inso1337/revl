fn normalize(key: Str) -> Str {
  key.slice(0, 8)
}

component NormCache provides cache: Cache {
  let store = effect Map.new() undo store.drop()

  provide cache {
    fn get(key) =
      let k = normalize(key)
      store.get(k)

    fn put(key, value) {
      let k = normalize(key)
      effect store.insert(k, value)
      undo   store.remove(k)
    }
  }
}
