service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

component PgDatabase provides db: Database {
  config { url: Str, pool_size: Int = 10 }

  let pool = effect Pool.open(url, pool_size) undo pool.close()

  provide db {
    fn query(sql: Str) = pool.query(sql)
    fn execute(sql: Str) { let _ = pool.execute(sql) }
  }
}
