service Locks {
  fn acquire_lock(name: Str)
  fn holder(name: Str) -> Opt[Str]
}

component LockManager provides locks: Locks {
  let store = effect Map.new() undo store.drop()

  provide locks {
    fn acquire_lock(name) {
      let _ = store.insert(name, "holder")
      undo   store.remove(name)
    }

    fn holder(name) = store.get(name)
  }
}
