service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

component LogRotator requires db: Database provides Rotator {
  config { keep: Int = 7 }

  await Job.run("activate")

  emit db.execute(`INSERT INTO rotation_log VALUES (${config.keep})`)
    compensate db.execute(`DELETE FROM rotation_log WHERE keep = ${config.keep}`)

  provide Rotator {}
}
