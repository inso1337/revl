type Row = { id: Int }

service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

component Migrator requires db: Database {
  effect db.query("SELECT pg_advisory_lock(7919)")
    undo db.query("SELECT pg_advisory_unlock(7919)")

  await Job.run("migrations")

  emit db.execute("INSERT INTO migration_log (name) VALUES ('migrations')")
       compensate db.execute("DELETE FROM migration_log WHERE name = 'migrations'")
}
