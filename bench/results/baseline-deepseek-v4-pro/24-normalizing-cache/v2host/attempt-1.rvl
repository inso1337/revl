service Cache {
  fn get(key: Str) -> Opt[Str]
  fn put(key: Str, value: Str)
}

fn normalize(key: Str) -> Str {
  return key.slice(0, 8)
}

component NormCache provides cache: Cache {
  let store = effect Map.new() undo store.drop()

  provide cache {
    fn get(key) = store.get(normalize(key))

    fn put(key, value) {
      let nk = normalize(key)
      effect store.insert(nk, value)
      undo   store.remove(nk)
    }
  }
}
