type Row = { id: Int }

service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

component TransferSaga requires ledger: Database {
  let lock = effect ledger.query("SELECT pg_advisory_lock(4242)")
    undo ledger.query("SELECT pg_advisory_unlock(4242)")

  emit ledger.execute("INSERT INTO entries (amount) VALUES (-100)")
       compensate ledger.execute("INSERT INTO entries (amount) VALUES (100)")

  emit ledger.execute("INSERT INTO entries (amount) VALUES (100)")
       compensate ledger.execute("INSERT INTO entries (amount) VALUES (-100)")

  await Job.run("settle")
}
