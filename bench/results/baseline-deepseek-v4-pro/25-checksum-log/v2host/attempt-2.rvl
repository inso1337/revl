service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

service Sum {
  fn digest(s: Str) -> Str
}

type Row = { id: Int, message: Str }

extern pure fn sha256(data: Str) -> Str
  = @ts { return require("crypto").createHash("sha256").update(data).digest("hex") }
  = @py { import hashlib; return hashlib.sha256(data.encode()).hexdigest() }

component ChecksumLog requires db: Database provides sum: Sum {
  emit db.execute("INSERT INTO service_log (message) VALUES ('digest service online')")

  provide sum {
    fn digest(s) = sha256(s)
  }
}
