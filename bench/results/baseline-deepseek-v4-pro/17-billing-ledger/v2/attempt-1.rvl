type Row = { acct: Str, cents: Str, kind: Str }

service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

service Billing {
  fn charge(acct: Str, cents: Str)
}

component BillingLedger requires db: Database provides billing: Billing {
  provide billing {
    fn charge(acct: Str, cents: Str) {
      emit db.execute(`INSERT INTO ledger (acct, cents, kind) VALUES ('${acct}', '${cents}', 'charge')`)
           compensate db.execute(`INSERT INTO ledger (acct, cents, kind) VALUES ('${acct}', '${cents}', 'reversal')`)
    }
  }
}
