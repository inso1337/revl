service Kv {
  fn get(key: Str) -> Opt[Str]
  fn put(key: Str, value: Str)
}

component MemKv provides kv: Kv {
  let map = effect Map.new() undo map.drop()

  provide kv {
    fn get(key) = map.get(key)

    fn put(key, value) {
      effect map.insert(key, value)
      undo   map.remove(key)
    }
  }
}
