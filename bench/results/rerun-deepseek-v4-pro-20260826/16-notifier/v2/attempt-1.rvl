service Mailer {
  emission fn send(to: Str, body: Str)
}

service Notify {
  emission fn ping(user: Str)
}

component Notifier requires mail: Mailer provides notify: Notify {
  provide notify {
    fn ping(user: Str) {
      emit mail.send(user, `Hello ${user}, you have a new notification`)
           compensate mail.send("ops", `Retracting the notification previously sent to ${user}`)
    }
  }
}
