type Row = { id: Int, name: Str, active: Bool }

service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

service Audit {
  emission fn log(event: Str)
}

component AuditLogger requires db: Database provides audit: Audit {
  provide audit {
    fn log(event: Str) {
      emit db.execute(`INSERT INTO audit_log VALUES ('${event}')`)
    }
  }
}
