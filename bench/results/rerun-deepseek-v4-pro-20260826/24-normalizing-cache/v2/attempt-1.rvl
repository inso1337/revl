fn norm(key: Str) -> Str {
  return key.slice(0, 8)
}

component NormCache provides cache: Cache {
  let store = effect Map.new() undo store.drop()

  provide cache {
    fn get(key: Str) -> Opt[Str] = store.get(norm(key))

    fn put(key: Str, value: Str) {
      effect store.insert(norm(key), value)
      undo   store.remove(norm(key))
    }
  }
}
