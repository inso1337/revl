service Limiter {
  fn allow(key: Str) -> Opt[Str]
  fn record(key: Str)
}

component RateLimiter provides limiter: Limiter {
  let store = effect Map.new() undo store.drop()

  provide limiter {
    fn allow(key: Str) = store.get(key)
    fn record(key: Str) {
      effect store.insert(key, "seen")
      undo   store.remove(key)
    }
  }
}
