service Database {
  fn query(sql: Str) -> List[Row]
  emission fn execute(sql: Str) -> Int
}

service Sum {
  fn digest(s: Str) -> Str
}

component ChecksumLog requires db: Database provides sum: Sum {
  emit db.execute("INSERT INTO service_log VALUES ('digest service online')")

  provide sum {
    fn digest(s) = `digest:${s}`
  }
}
