service Dedupe {
  fn seen(id: Str) -> Opt[Str]
  fn mark(id: Str)
}

component DedupeStore provides dedupe: Dedupe {
  let store = effect Map.new() undo store.drop()

  provide dedupe {
    fn seen(id: Str) = store.get(id)

    fn mark(id: Str) {
      effect store.insert(id, id)
      undo   store.remove(id)
    }
  }
}
