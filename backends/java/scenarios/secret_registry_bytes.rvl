// A `Secret[Bytes]` payload must not reach any java sink verbatim (roadmap
// item 421 F6, the java half): the operator console the runner prints and the
// seam-failure text a provider sends back to its consumer.
//
// `Bytes` is the one declared type whose java runtime value is not a `String`.
// The registry's fallback registered `String.valueOf(value)`, which for a
// `byte[]` is the identity string `[B@hash` — a needle no sink this tier has
// ever writes — so a byte payload crossed every funnel verbatim while a
// `Secret[Str]` beside it was redacted.
//
// The credential is minted by a host call (the `revlSecretResult` origin door)
// and quoted by a DIFFERENT host binding's failing body. It is therefore HELD,
// not one of the failing call's own arguments, which is exactly the case the
// seam funnel's argument stage cannot see by construction. `rows` carries the
// same payload one level down a container, so the walk has to recurse to a
// leaf to reach it.
extern emission[vault.mint] fn mint_raw(u: Str) -> Secret[Bytes]
  = @java { return "SEKRIT-JAVA-BYTES-CANARY-421-F6".getBytes(java.nio.charset.StandardCharsets.UTF_8); }

extern emission[vault.mint_rows] fn mint_rows(u: Str) -> Secret[List[Bytes]]
  = @java { return java.util.List.of("SEKRIT-JAVA-ROW-CANARY-421-F6".getBytes(java.nio.charset.StandardCharsets.UTF_8)); }

extern emission[vault.open] fn open_raw(raw: Secret[Bytes], rows: Secret[List[Bytes]], url: Str, user: Str) -> Unit
  = @java { throw new RuntimeException("vault refused key " + new String(raw, java.nio.charset.StandardCharsets.UTF_8) + " row " + new String(rows.get(0), java.nio.charset.StandardCharsets.UTF_8) + " at " + url + " for " + user); }

service Vault { emission fn open(user: Str) -> Str }
service Front { emission fn login(user: Str) -> Str }

component Keeper provides vault: Vault {
  config { url: Str = "pg://main" }

  provide vault {
    fn open(user) {
      let raw = emit mint_raw(user)
      let rows = emit mint_rows(user)
      emit open_raw(raw, rows, config.url, user)
      return "opened"
    }
  }
}

component Portal requires vault: Vault provides front: Front {
  provide front {
    fn login(user) {
      let r = emit vault.open(user)
      return r
    }
  }
}
