// A declared `Secret[T]` config field must not reach any java sink verbatim
// (roadmap item 421 F6, the java half): the operator console the runner
// prints, the seam-failure text a provider sends back to its consumer, and
// the durable WAL.
//
// The credential is handed to the component's OWN host binding, which is the
// legitimate use the checker does not refuse (a `Secret[T]` parameter is the
// declared receiver). The host body then fails with a message that quotes
// its arguments, the plain shape a driver error takes. Nothing the author
// wrote interpolates the secret, and the runner must still not repeat it.
extern emission[vault.connect] fn connect(key: Secret[Str], url: Str, user: Str) -> Unit
  = @java { throw new RuntimeException("vault refused key " + key + " at " + url + " for " + user); }

service Vault { emission fn open(user: Str) -> Str }
service Front { emission fn login(user: Str) -> Str }

component Keeper provides vault: Vault {
  config { url: Str = "pg://main", api_key: Secret[Str] = "k" }

  provide vault {
    fn open(user) {
      emit connect(config.api_key, config.url, user)
      return "opened"
    }
  }
}

component Portal requires vault: Vault provides front: Front {
  provide front {
    fn login(user) {
      let r = emit vault.open(user)
      return r
    }
  }
}
