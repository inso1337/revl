// A `Secret[T]` whose declared type is a RECORD or a VARIANT must not reach any
// java sink verbatim (roadmap item 421 F6, the java half).
//
// The registry's reflective walk descends through `java.lang.reflect.Record`,
// but this tier emits every declared record and every variant case as a plain
// `class`, never a java `record` — only the built-in `Result` is a real record.
// So `instanceof Record` was false for all of them, the walk fell through to
// `String.valueOf(value)`, and that is the identity string `Name@hash`: a
// needle no sink this tier writes. The container's own face ended up
// registered and its LEAVES crossed every funnel verbatim.
//
// The credentials are minted by host calls (the `revlSecretResult` origin door)
// and quoted by a DIFFERENT host binding's failing body, so they are HELD: not
// one of the failing call's own arguments, which is the case the seam funnel's
// argument stage cannot see by construction. `nest` puts a record one level
// down a container so the walk has to recurse to a leaf to reach it, and
// `audit` is a declared RECEIVER (a `Secret[Payload]` service parameter), so
// both registration ends are exercised by one document.
type Payload = { key: Str, label: Str }
type Step = Final(Str) | Retry
type Chain = { key: Str, kids: List[Chain] }

extern emission[vault.mint_record] fn mint_record(u: Str) -> Secret[Payload]
  = @java { return new Payload("SEKRIT-JAVA-REC-CANARY-421-F6", "label"); }

extern emission[vault.mint_variant] fn mint_variant(u: Str) -> Secret[Step]
  = @java { return new Step.Final("SEKRIT-JAVA-VAR-CANARY-421-F6"); }

extern emission[vault.mint_nested] fn mint_nested(u: Str) -> Secret[List[Payload]]
  = @java { return java.util.List.of(new Payload("SEKRIT-JAVA-NEST-CANARY-421-F6", "label")); }

extern emission[vault.quote] fn quote(rec: Secret[Payload], step: Secret[Step], nest: Secret[List[Payload]], url: Str, user: Str) -> Unit
  = @java { throw new RuntimeException("vault refused key " + rec.key + " step " + ((Step.Final) step).value + " nest " + nest.get(0).key + " at " + url + " for " + user); }

service Vault {
  emission fn open(user: Str) -> Str
  emission fn audit(rec: Secret[Payload]) -> Str
}
service Front { emission fn login(user: Str) -> Str }

component Keeper provides vault: Vault {
  config { url: Str = "pg://main" }

  provide vault {
    fn open(user) {
      let rec = emit mint_record(user)
      let step = emit mint_variant(user)
      let nest = emit mint_nested(user)
      emit quote(rec, step, nest, config.url, user)
      return "opened"
    }

    fn audit(rec) { return "audited" }
  }
}

component Portal requires vault: Vault provides front: Front {
  provide front {
    fn login(user) {
      let r = emit vault.open(user)
      return r
    }
  }
}
