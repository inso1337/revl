      "bodies": {
        "py": "\n    import revl_fs_workspace as _ws\n    src = _ws.resolve_within(w[\"from\"])      # must #2: BOTH endpoints confined\n    dst = _ws.resolve_within(w[\"to\"])\n    import os\n    # move it back. idempotent \u2014 once back (dst gone), a second replay no-ops.\n    if os.path.exists(dst):\n        os.replace(dst, src)\n    return\n"
      },
