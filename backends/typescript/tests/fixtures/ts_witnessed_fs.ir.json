      "returns": "Unit",
      "bodies": {
        "py": "\n    import revl_fs_workspace as _ws\n    # must #2: the inverse path is confined too. A raise here is recorded by\n    # the teardown loop as restore-residue, never a silent write outside root.\n    target = _ws.resolve_within(w[\"path\"])\n    import os\n    if w[\"created\"]:\n        # the file did not exist before the write: undo == delete it.\n        # idempotent \u2014 a second replay finds it already gone.\n        if os.path.exists(target):\n            os.remove(target)\n        return\n    # restore the preimage snapshot over the target. os.replace is atomic and\n    # consumes the snapshot (residue-free). idempotent \u2014 once the snapshot is\n    # gone (already restored), a second replay is a no-op.\n    if os.path.exists(w[\"preimage\"]):\n        os.replace(w[\"preimage\"], target)\n    return\n"
      },
