    {
      "name": "write",
      "class": "witnessed",
      "params": [
        {
          "name": "path",
          "type": "Str"
        },
        {
          "name": "contents",
          "type": "Str"
        }
      ],
      "returns": "Result[WriteWitness, FsError]",
      "bodies": {
        "py": "\n    import revl_fs_workspace as _ws\n    import os\n    try:\n        target = _ws.resolve_within(path)    # must #1: realpath BEFORE the check\n    except _ws.ConfinementError as e:\n        return Err(e.as_error())\n    existed = os.path.exists(target)\n    preimage = \"\"\n    if existed:\n        if not os.path.isfile(target):\n            return Err({\"code\": \"ENOTFILE\",\n                        \"message\": \"write target exists and is not a regular file\",\n                        \"path\": target})\n        # snapshot the preimage INSIDE the root (must #3) before diverging it.\n        preimage = _ws.fresh_sidecar(_ws.preimage_dir(), \"pre\")\n        _ws.snapshot(target, preimage)\n    else:\n        # require the parent to exist \u2014 we create no directories, so the\n        # inverse (delete the created file) leaves zero residue.\n        parent = os.path.dirname(target)\n        if parent and not os.path.isdir(parent):\n            return Err({\"code\": \"ENOENT\",\n                        \"message\": \"parent directory does not exist\",\n                        \"path\": target})\n    with open(target, \"w\", encoding=\"utf-8\") as fh:\n        fh.write(contents)\n    return Ok({\"path\": target, \"preimage\": preimage, \"created\": not existed})\n"
      },
