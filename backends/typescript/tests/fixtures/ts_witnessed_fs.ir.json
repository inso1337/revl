      "name": "rmdir_if_empty",
      "class": "pure",
      "params": [
        {
          "name": "w",
          "type": "MkdirWitness"
        }
      ],
      "returns": "Unit",
      "bodies": {
        "py": "\n    import revl_fs_workspace as _ws\n    target = _ws.resolve_within(w[\"path\"])   # must #2\n    import os\n    # remove the created directory iff still empty \u2014 never delete a dir the\n    # activation (or a concurrent writer) populated. idempotent + total: a\n    # missing or non-empty dir is left as-is, no raise.\n    try:\n        os.rmdir(target)\n    except OSError:\n        pass\n    return\n"
      },
      "refs": {
        "ts": {
