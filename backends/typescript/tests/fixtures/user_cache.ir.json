{
  "ir_version": 1,
  "services": {
    "Database": {
      "methods": {
        "query": {
          "params": [
            {
              "name": "sql",
              "type": "Str"
            }
          ],
          "returns": "List[Row]",
          "emission": false
        },
        "execute": {
          "params": [
            {
              "name": "sql",
              "type": "Str"
            }
          ],
          "returns": "Int",
          "emission": true
        }
      }
    },
    "Cache": {
      "methods": {
        "get": {
          "params": [
            {
              "name": "key",
              "type": "Str"
            }
          ],
          "returns": "Opt[Str]",
          "emission": false
        },
        "put": {
          "params": [
            {
              "name": "key",
              "type": "Str"
            },
            {
              "name": "value",
              "type": "Str"
            }
          ],
          "returns": null,
          "emission": true
        }
      }
    }
  },
  "components": [
    {
      "name": "PgDatabase",
      "source": "examples/user_cache.rvl",
      "config": [
        {
          "name": "url",
          "type": "Str",
          "default": null
        },
        {
          "name": "pool_size",
          "type": "Int",
          "default": 10
        }
      ],
      "requires": {},
      "provides": {
        "db": "Database"
      },
      "body": [
        {
          "step": "let-effect",
          "bind": "pool",
          "acquire": {
            "kind": "host",
            "fn": "Pool.open",
            "args": [
              {
                "kind": "config",
                "field": "url"
              },
              {
                "kind": "config",
                "field": "pool_size"
              }
            ]
          },
          "undo": {
            "kind": "call",
            "target": {
              "kind": "name",
              "id": "pool"
            },
            "method": "close",
            "args": []
          }
        },
        {
          "step": "provide",
          "name": "db",
          "service": "Database",
          "methods": [
            {
              "name": "query",
              "params": [
                "sql"
              ],
              "body": [
                {
                  "step": "return",
                  "expr": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "pool"
                    },
                    "method": "query",
                    "args": [
                      {
                        "kind": "name",
                        "id": "sql"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "execute",
              "params": [
                "sql"
              ],
              "body": [
                {
                  "step": "return",
                  "expr": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "pool"
                    },
                    "method": "execute",
                    "args": [
                      {
                        "kind": "name",
                        "id": "sql"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "UserCache",
      "source": "examples/user_cache.rvl",
      "config": [],
      "requires": {
        "db": "Database"
      },
      "provides": {
        "cache": "Cache"
      },
      "body": [
        {
          "step": "let-effect",
          "bind": "store",
          "acquire": {
            "kind": "host",
            "fn": "Map.new",
            "args": []
          },
          "undo": {
            "kind": "call",
            "target": {
              "kind": "name",
              "id": "store"
            },
            "method": "drop",
            "args": []
          }
        },
        {
          "step": "provide",
          "name": "cache",
          "service": "Cache",
          "methods": [
            {
              "name": "get",
              "params": [
                "key"
              ],
              "body": [
                {
                  "step": "return",
                  "expr": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "store"
                    },
                    "method": "get",
                    "args": [
                      {
                        "kind": "name",
                        "id": "key"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "put",
              "params": [
                "key",
                "value"
              ],
              "body": [
                {
                  "step": "effect",
                  "acquire": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "store"
                    },
                    "method": "insert",
                    "args": [
                      {
                        "kind": "name",
                        "id": "key"
                      },
                      {
                        "kind": "name",
                        "id": "value"
                      }
                    ]
                  },
                  "undo": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "store"
                    },
                    "method": "remove",
                    "args": [
                      {
                        "kind": "name",
                        "id": "key"
                      }
                    ]
                  }
                },
                {
                  "step": "emit",
                  "expr": {
                    "kind": "call",
                    "target": {
                      "kind": "req",
                      "name": "db"
                    },
                    "method": "execute",
                    "args": [
                      {
                        "kind": "format",
                        "template": "INSERT INTO cache_log VALUES ($0)",
                        "args": [
                          {
                            "kind": "name",
                            "id": "key"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "manifest": {
    "components": [
      {
        "name": "PgDatabase",
        "file": "examples/user_cache.rvl",
        "inject": [],
        "provides": [
          "db"
        ]
      },
      {
        "name": "UserCache",
        "file": "examples/user_cache.rvl",
        "inject": [
          "db"
        ],
        "provides": [
          "cache"
        ]
      }
    ],
    "loadOrder": [
      "PgDatabase",
      "UserCache"
    ]
  }
}
