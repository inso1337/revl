package stream130

// Executes the EMITTED stream components (from testdata/stream_130.rvl, lowered
// by backends/go/emit.py) against the REAL stc-go runtime. This is item 130
// Slice 3's exit proof on the go tier — docs/design/130-stream-reactive-types.md
// §4.6 (the go row), §9 Parts A and B, §10.2/§10.4/§10.5.
//
// White-box (same package) so it can drive the emitted host runtime's provider
// handles the way a harness drives a test provider (design §8: "a test provider
// `emit`s items explicitly").

import (
	stdctx "context"
	"reflect"
	"strings"
	"sync"
	"testing"
	"time"

	stc "github.com/0xdenny218/stc-go"
)

func bg() stdctx.Context { return stdctx.Background() }

func reset() {
	HostReset()
	StreamReset()
}

func marksIndex(marks []string, want string) int {
	for i, m := range marks {
		if m == want {
			return i
		}
	}
	return -1
}

// waitFor spins until cond holds or the budget runs out. Used only to observe
// another goroutine reaching its park; never to make a race "probably" pass —
// every assertion below is on a state that is stable once reached.
func waitFor(t *testing.T, what string, cond func() bool) {
	t.Helper()
	deadline := time.Now().Add(3 * time.Second)
	for time.Now().Before(deadline) {
		if cond() {
			return
		}
		time.Sleep(time.Millisecond)
	}
	t.Fatalf("timed out waiting for %s", what)
}

// -------------------------------------------------------------------------
// §10.2 — THE CORE GUARANTEE: unloading the owner CLOSES the stream, LIFO.
// -------------------------------------------------------------------------

func TestEmitted_UnloadClosesTheStream_LIFO(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	f := LoadConsumer(root)
	if err := f.Ready(bg()); err != nil {
		t.Fatalf("Consumer: %v", err)
	}
	if n := StreamLiveSubscriptions(); n != 1 {
		t.Fatalf("live subscriptions after activation = %d, want 1", n)
	}

	f.Dispose()
	if err := f.Gone(bg()); err != nil {
		t.Fatalf("Gone: %v", err)
	}

	marks := HostMarks()
	subClose := marksIndex(marks, "stream.close")
	srcClose := marksIndex(marks, "stream.source close")
	poolClose := marksIndex(marks, "pool.close")
	if subClose < 0 || srcClose < 0 || poolClose < 0 {
		t.Fatalf("teardown did not run every inverse: %v", marks)
	}
	// LIFO: the subscription (acquired last) closes first, then the source it
	// listens to, then the pool acquired before either.
	if !(subClose < srcClose && srcClose < poolClose) {
		t.Fatalf("teardown was not LIFO: %v", marks)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("stream residue after unload = %d, want 0", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources after unload = %d, want 0 (R1)", n)
	}
}

// -------------------------------------------------------------------------
// §9 Part A — a parked `next` is ALWAYS terminated by the owner's own
// teardown. The closure driven here is byte-for-byte the bracket inverse the
// emitter yields (`return func() error { sub.Close(); return nil }`, pinned in
// backends/go/test_stream_exec_130.py), run from a DIFFERENT goroutine — which
// is where the teardown loop runs it.
// -------------------------------------------------------------------------

func TestParkedNext_IsTerminatedByTheOwnersClose(t *testing.T) {
	reset()
	src := StreamSource()
	sub := StreamSubscribe(src, "error", 0)

	type outcome struct {
		v   any
		err error
	}
	done := make(chan outcome, 1)
	go func() {
		v, err := sub.Next()
		done <- outcome{v, err}
	}()
	// The consumer is parked: the provider never emits and never terminates.
	time.Sleep(20 * time.Millisecond)
	select {
	case got := <-done:
		t.Fatalf("Next resolved with no item and no terminal: %+v", got)
	default:
	}

	// Teardown: the bracket inverse. It must return IMMEDIATELY — it never
	// waits for the parked Next to drain — and it must resolve that park.
	started := time.Now()
	inverse := func() error { sub.Close(); return nil }
	if err := inverse(); err != nil {
		t.Fatalf("the bracket inverse must be infallible, got %v", err)
	}
	if elapsed := time.Since(started); elapsed > time.Second {
		t.Fatalf("close waited on the parked next (%v) — delivery-behind, not "+
			"cancellation-first", elapsed)
	}

	select {
	case got := <-done:
		if got.err != nil {
			t.Fatalf("owner teardown must resolve the park as Closed, got %v", got.err)
		}
		if !IsStreamClosed(got.v) {
			t.Fatalf("park resolved as %#v, want the Closed terminal", got.v)
		}
	case <-time.After(3 * time.Second):
		t.Fatal("the parked Next outlived its owner's close — the cancel case " +
			"of the select never fired")
	}

	// Idempotent, and the listener is released exactly once.
	if sub.Close() {
		t.Fatal("close must be idempotent")
	}
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// A `close` that races a buffered item still wins: cancellation-first means the
// cancel channel is probed BEFORE the buffer, so a withdrawn owner never
// observes one more item after its teardown began.
func TestClose_WinsOverABufferedItem(t *testing.T) {
	reset()
	src := StreamSource()
	sub := StreamSubscribe(src, "error", 0)
	src.Emit("buffered")
	sub.Close()
	v, err := sub.Next()
	if err != nil {
		t.Fatalf("Next after close: %v", err)
	}
	if !IsStreamClosed(v) {
		t.Fatalf("Next after close = %#v, want the Closed terminal", v)
	}
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// -------------------------------------------------------------------------
// §9 Part B — provider death is a terminal, never silence, and it reaches an
// outstanding `next` end-to-end through a real activation.
// -------------------------------------------------------------------------

func TestEmitted_ProviderFault_TerminatesAParkedNext_AndClosesTheBracket(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	errc := make(chan error, 1)
	go func() {
		f := LoadParked(root)
		errc <- f.Ready(bg())
	}()

	// The activation body is parked in the cancel-channel select.
	waitFor(t, "the activation to park in next", func() bool {
		return StreamLiveSubscriptions() == 1
	})
	time.Sleep(20 * time.Millisecond)
	select {
	case err := <-errc:
		t.Fatalf("activation completed without an item or a terminal: %v", err)
	default:
	}

	// The provider aborts. Its terminal must reach the parked `next`.
	providers := StreamProviders()
	if len(providers) != 1 {
		t.Fatalf("providers = %d, want 1", len(providers))
	}
	providers[0].Fault("provider gone")

	select {
	case err := <-errc:
		if err == nil {
			t.Fatal("a Faulted terminal must fail the activation")
		}
		if !strings.Contains(err.Error(), "provider gone") {
			t.Fatalf("activation error = %v, want the fault reason", err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("the parked next was never terminated by the provider's fault")
	}

	// The failed activation reverted its prefix LIFO, so the subscription
	// bracket closed — a fault never leaves a subscription active.
	marks := HostMarks()
	if marksIndex(marks, "stream.close") < 0 {
		t.Fatalf("the failed activation did not close the subscription: %v", marks)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("stream residue after the fault = %d, want 0", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources after the fault = %d, want 0 (R1)", n)
	}
}

// The orderly twin: the provider emits, the parked activation carries on, and
// the ordinary unload path closes the stream.
func TestEmitted_ParkedNext_ResumesOnAnItem(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	type loaded struct {
		f   *stc.Fiber
		err error
	}
	done := make(chan loaded, 1)
	go func() {
		f := LoadParked(root)
		done <- loaded{f, f.Ready(bg())}
	}()
	waitFor(t, "the activation to park in next", func() bool {
		return StreamLiveSubscriptions() == 1
	})
	StreamProviders()[0].Emit("order-1")

	var got loaded
	select {
	case got = <-done:
		if got.err != nil {
			t.Fatalf("activation: %v", got.err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("an emitted item never unparked the activation")
	}

	got.f.Dispose()
	if err := got.f.Gone(bg()); err != nil {
		t.Fatalf("Gone: %v", err)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue after unload = %d, want 0", n)
	}
}

// -------------------------------------------------------------------------
// `merge` — multi-source teardown, and the two fan-in terminal rules.
// -------------------------------------------------------------------------

func TestEmitted_Merge_MultiSourceTeardownIsOneLIFOStack(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	type loaded struct {
		f   *stc.Fiber
		err error
	}
	done := make(chan loaded, 1)
	go func() {
		f := LoadFanin(root)
		done <- loaded{f, f.Ready(bg())}
	}()
	waitFor(t, "the fan-in consumer to park", func() bool {
		return StreamLiveSubscriptions() == 1
	})
	// An item from EITHER source reaches the one consumer.
	providers := StreamProviders()
	if len(providers) != 3 {
		t.Fatalf("providers = %d, want 3 (two sources + the merge)", len(providers))
	}
	providers[1].Emit("from-b")

	var got loaded
	select {
	case got = <-done:
		if got.err != nil {
			t.Fatalf("activation: %v", got.err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("an item from the second source never reached the merged consumer")
	}

	got.f.Dispose()
	if err := got.f.Gone(bg()); err != nil {
		t.Fatalf("Gone: %v", err)
	}

	marks := HostMarks()
	subClose := marksIndex(marks, "stream.close")
	mergeClose := marksIndex(marks, "stream.merge close")
	if subClose < 0 || mergeClose < 0 {
		t.Fatalf("fan-in teardown incomplete: %v", marks)
	}
	// LIFO: subscription, then the merge, then the two sources. Neither source
	// is left holding the merged stream, and no subscription outlives its owner.
	if subClose > mergeClose {
		t.Fatalf("the merge closed before its subscriber: %v", marks)
	}
	sourceCloses := 0
	for i, m := range marks {
		if m == "stream.source close" {
			sourceCloses++
			if i < mergeClose {
				t.Fatalf("a source closed before the merge detached from it: %v", marks)
			}
		}
	}
	if sourceCloses != 2 {
		t.Fatalf("source closes = %d, want 2: %v", sourceCloses, marks)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("fan-in residue after unload = %d, want 0", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources after unload = %d, want 0 (R1)", n)
	}
}

// One source closing does NOT strand the consumer on the other, and the LAST
// source closing does deliver the merged `Closed` — so a parked next on a
// fan-in is always terminated.
func TestMerge_ClosedIsDeliveredOnlyWhenEverySourceIsDone(t *testing.T) {
	reset()
	a := StreamSource()
	b := StreamSource()
	m := StreamMerge(a, b)
	sub := StreamSubscribe(m, "error", 0)

	type outcome struct {
		v   any
		err error
	}
	done := make(chan outcome, 1)
	go func() {
		v, err := sub.Next()
		done <- outcome{v, err}
	}()

	a.Close() // one source gone; `b` can still feed the consumer
	time.Sleep(20 * time.Millisecond)
	select {
	case got := <-done:
		t.Fatalf("one source's close ended the fan-in early: %+v", got)
	default:
	}

	b.Close() // the last source: now the merged stream is done
	select {
	case got := <-done:
		if got.err != nil {
			t.Fatalf("want the Closed terminal, got %v", got.err)
		}
		if !IsStreamClosed(got.v) {
			t.Fatalf("fan-in terminal = %#v, want Closed", got.v)
		}
	case <-time.After(3 * time.Second):
		t.Fatal("the last source's close never terminated the parked next")
	}

	// The subscription OWNS the fan-in: one Close tears the merge down with it.
	sub.Close()
	a.Close()
	b.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// A fan-in source's FAULT propagates at once: no silent loss, and no waiting on
// the sibling source that is still live.
func TestMerge_AFaultPropagatesImmediately(t *testing.T) {
	reset()
	a := StreamSource()
	b := StreamSource()
	m := StreamMerge(a, b)
	sub := StreamSubscribe(m, "error", 0)

	errc := make(chan error, 1)
	go func() {
		_, err := sub.Next()
		errc <- err
	}()
	a.Fault("kafka gone")

	select {
	case err := <-errc:
		if err == nil || !strings.Contains(err.Error(), "kafka gone") {
			t.Fatalf("fan-in fault = %v, want the reason to reach the consumer", err)
		}
	case <-time.After(3 * time.Second):
		t.Fatal("a source's fault never reached the merged consumer")
	}

	sub.Close()
	a.Close()
	b.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources = %d, want 0 (R1)", n)
	}
}

// Merging composes: a merged stream is itself a terminal-delivering provider,
// so it can feed another merge with no second class of stream.
func TestMerge_Nests(t *testing.T) {
	reset()
	a := StreamSource()
	b := StreamSource()
	c := StreamSource()
	inner := StreamMerge(a, b)
	outer := StreamMerge(inner, c)
	sub := StreamSubscribe(outer, "error", 0)

	a.Emit("deep")
	v, err := sub.Next()
	if err != nil {
		t.Fatalf("nested merge: %v", err)
	}
	if v != "deep" {
		t.Fatalf("nested merge delivered %#v, want \"deep\"", v)
	}
	// One Close on the subscription unwinds the whole derived chain: the outer
	// merge, then the inner merge it owns. Only the plain sources are left to
	// their own brackets.
	sub.Close()
	a.Close()
	b.Close()
	c.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// -------------------------------------------------------------------------
// Backpressure: the default `error` policy faults on overflow — no silent loss.
// -------------------------------------------------------------------------

func TestBackpressureError_FaultsOnOverflow(t *testing.T) {
	reset()
	src := StreamSource()
	sub := StreamSubscribe(src, "error", 0)
	for i := 0; i < StreamBufferCapacity+1; i++ {
		src.Emit("x")
	}
	// The buffered prefix is delivered first, then the overflow terminal.
	for i := 0; i < StreamBufferCapacity; i++ {
		if _, err := sub.Next(); err != nil {
			t.Fatalf("buffered item %d: %v", i, err)
		}
	}
	_, err := sub.Next()
	if err == nil || !strings.Contains(err.Error(), "overflow") {
		t.Fatalf("overflow under the `error` policy = %v, want Faulted(overflow)", err)
	}
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// -------------------------------------------------------------------------
// Backpressure: the three NON-DEFAULT policies (item 130 Slice 2, §4.4).
//
// Each case below mirrors the py reference's own case in
// backends/python/tests/test_stream_runtime.py statement for statement — same
// capacity, same emit sequence, same drained values, same trace marks. That is
// deliberate: a policy that COMPILES on this tier and behaves differently from
// the reference is strictly worse than one that is refused by name, so the
// reference's case IS this tier's specification.
// -------------------------------------------------------------------------

func drainMarks(prefix string) []string {
	var out []string
	for _, m := range HostMarks() {
		if strings.HasPrefix(m, prefix) {
			out = append(out, m)
		}
	}
	return out
}

func nextItem(t *testing.T, sub *Subscription, want string) {
	t.Helper()
	v, err := sub.Next()
	if err != nil {
		t.Fatalf("Next: %v", err)
	}
	got, ok := v.(string)
	if !ok || got != want {
		t.Fatalf("Next = %#v, want %q", v, want)
	}
}

// `drop_newest` discards the INCOMING item and records the loss. A drop policy
// never blocks the provider and never pauses the subscription.
func TestDropNewest_DiscardsTheIncomingItemAndRecordsIt(t *testing.T) {
	reset()
	src := StreamSource()
	sub := StreamSubscribe(src, "drop_newest", 2)
	for _, item := range []string{"i0", "i1", "i2", "i3"} {
		if !src.Emit(item) {
			t.Fatalf("a drop policy never blocks the provider (%s)", item)
		}
	}
	nextItem(t, sub, "i0")
	nextItem(t, sub, "i1")
	// the buffered prefix survives; the overflow is DISCARDED and recorded, so
	// the loss is explicit rather than silent.
	if got := drainMarks("stream.drop_newest"); !reflect.DeepEqual(
		got, []string{"stream.drop_newest i2", "stream.drop_newest i3"}) {
		t.Fatalf("drop_newest marks = %v", got)
	}
	if st := sub.State(); st != "active" {
		t.Fatalf("a drop policy never pauses, state = %q", st)
	}
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// `drop_oldest` evicts the buffer HEAD and keeps the newest item (latest-wins
// gauges), recording the eviction.
func TestDropOldest_EvictsTheBufferHeadAndRecordsIt(t *testing.T) {
	reset()
	src := StreamSource()
	sub := StreamSubscribe(src, "drop_oldest", 2)
	for _, item := range []string{"i0", "i1", "i2"} {
		if !src.Emit(item) {
			t.Fatalf("a drop policy never blocks the provider (%s)", item)
		}
	}
	// latest-wins: the head was evicted, the newest item is buffered
	nextItem(t, sub, "i1")
	nextItem(t, sub, "i2")
	if got := drainMarks("stream.drop_oldest"); !reflect.DeepEqual(
		got, []string{"stream.drop_oldest i0"}) {
		t.Fatalf("drop_oldest marks = %v", got)
	}
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// `block` REFUSES the delivery and puts the subscription in the reserved
// `Paused` state. No implicit retry — `Emit` returns false, so the provider
// knows it is suspended, and the refusal is TRACED. Draining resumes it
// eagerly, which is what the reference does with no `drain` window declared;
// a declared window is refused by this tier's emitter rather than resumed early.
func TestBlock_PausesTheProviderUntilTheConsumerDrains(t *testing.T) {
	reset()
	src := StreamSource()
	sub := StreamSubscribe(src, "block", 2)
	if !src.Emit("i0") || !src.Emit("i1") {
		t.Fatal("the first two items fit the bounded buffer")
	}
	if st := sub.State(); st != "active" {
		t.Fatalf("state before the buffer fills = %q, want active", st)
	}
	if src.Emit("i2") {
		t.Fatal("the provider must be TOLD it is blocked — a `true` here is a silent loss")
	}
	if st := sub.State(); st != "paused" {
		t.Fatalf("state = %q, want the reserved `Paused` index", st)
	}
	if marksIndex(HostMarks(), "stream.paused") < 0 {
		t.Fatalf("the pause was not recorded: %v", HostMarks())
	}
	// the refused delivery is traced as such, exactly as the py reference and
	// the ts tier trace it — a refusal is never silent.
	if marksIndex(HostMarks(), "stream.emit i2 refused") < 0 {
		t.Fatalf("the refused emit was not recorded: %v", HostMarks())
	}

	nextItem(t, sub, "i0") // drains -> resumes eagerly
	if st := sub.State(); st != "active" {
		t.Fatalf("draining did not resume the provider, state = %q", st)
	}
	if marksIndex(HostMarks(), "stream.resume") < 0 {
		t.Fatalf("the resume was not recorded: %v", HostMarks())
	}
	if !src.Emit("i2") {
		t.Fatal("the provider may emit again once the subscription is Active")
	}
	nextItem(t, sub, "i1")
	nextItem(t, sub, "i2") // no silent loss: nothing was dropped
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// -------------------------------------------------------------------------
// §8 — the `block` DRAIN WINDOW, on this tier's own clock coeffect.
//
// The window was refused here for as long as its reason held: "the resume fires
// on a deterministic clock this tier does not carry". This tier carries one
// (item 57's RevlClockAdvance), so the window rides it, and these three tests
// are the reason the lowering is not a silent divergence — they are the go
// transcription of the py reference's own window tests
// (backends/python/tests/test_stream_runtime.py, §8):
//
//   * a windowed subscription does NOT resume when the consumer drains — only a
//     clock advance PAST the window resumes it (the whole observable difference
//     a window makes, and the thing an early resume would quietly get wrong);
//   * a firing that finds the buffer still full RE-ARMS rather than resuming, so
//     a consumer that never drains keeps the provider suspended;
//   * the window is a revertible schedule: closing a Paused subscription cancels
//     the armed one, so teardown leaves no orphaned interval.
// -------------------------------------------------------------------------

func TestDrainWindow_ResumesOnTheClockNotOnTheDrain(t *testing.T) {
	reset()
	RevlClockReset()
	src := StreamSource()
	sub := StreamSubscribe(src, "block", 2, 10)
	if !src.Emit("i0") || !src.Emit("i1") {
		t.Fatal("the first two items fit the bounded buffer")
	}
	if src.Emit("i2") {
		t.Fatal("the provider must be TOLD it is blocked")
	}
	if st := sub.State(); st != "paused" {
		t.Fatalf("state = %q, want paused", st)
	}

	nextItem(t, sub, "i0")
	if st := sub.State(); st != "paused" {
		t.Fatalf("draining resumed a WINDOWED subscription (state = %q); the "+
			"window, not the buffer, is what the provider waits on", st)
	}
	if src.Emit("i2") {
		t.Fatal("a windowed provider stays suspended until the window fires")
	}

	if n := RevlClockAdvance(5); n != 0 {
		t.Fatalf("firings before the window elapsed = %d, want 0", n)
	}
	if st := sub.State(); st != "paused" {
		t.Fatalf("state at half the window = %q, want paused", st)
	}
	if n := RevlClockAdvance(5); n != 1 {
		t.Fatalf("firings at the window = %d, want 1", n)
	}
	if st := sub.State(); st != "active" {
		t.Fatalf("state after the window fired = %q, want active", st)
	}
	if marksIndex(HostMarks(), "stream.resume") < 0 {
		t.Fatalf("the resume was not recorded: %v", HostMarks())
	}
	if !src.Emit("i2") {
		t.Fatal("the provider may emit again once the subscription is Active")
	}
	nextItem(t, sub, "i1")
	nextItem(t, sub, "i2") // no silent loss: nothing was dropped
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
	if n := RevlClockPending(); n != 0 {
		t.Fatalf("armed windows after close = %d, want 0", n)
	}
}

func TestDrainWindow_ReArmsWhileTheBufferIsStillFull(t *testing.T) {
	reset()
	RevlClockReset()
	src := StreamSource()
	sub := StreamSubscribe(src, "block", 1, 10)
	if !src.Emit("i0") {
		t.Fatal("the first item fits the bounded buffer")
	}
	if src.Emit("i1") {
		t.Fatal("the provider must be TOLD it is blocked")
	}
	// nothing drained: the window fires, finds the buffer still full, re-arms
	if n := RevlClockAdvance(10); n != 1 {
		t.Fatalf("firings = %d, want 1", n)
	}
	if st := sub.State(); st != "paused" {
		t.Fatalf("state = %q, want paused — the buffer is still full", st)
	}
	if n := RevlClockPending(); n != 1 {
		t.Fatalf("armed windows = %d, want the re-armed 1", n)
	}
	nextItem(t, sub, "i0")
	if n := RevlClockAdvance(10); n != 1 {
		t.Fatalf("firings on the re-armed window = %d, want 1", n)
	}
	if st := sub.State(); st != "active" {
		t.Fatalf("state = %q, want active", st)
	}
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
	if n := RevlClockPending(); n != 0 {
		t.Fatalf("close did not cancel the window: %d armed", n)
	}
}

func TestDrainWindow_ClosingAPausedSubscriptionLeavesNoArmedWindow(t *testing.T) {
	reset()
	RevlClockReset()
	src := StreamSource()
	sub := StreamSubscribe(src, "block", 1, 10)
	src.Emit("i0")
	if src.Emit("i1") {
		t.Fatal("the provider must be TOLD it is blocked")
	}
	if n := RevlClockPending(); n != 1 {
		t.Fatalf("armed windows while Paused = %d, want 1", n)
	}
	sub.Close()
	src.Close()
	if n := RevlClockPending(); n != 0 {
		t.Fatalf("armed windows after the bracket inverse = %d, want 0", n)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// An UNWINDOWED `block` subscription is untouched by the window machinery: it
// still resumes eagerly at the `next` that makes room, and it arms nothing. The
// window is opt-in, so this is what keeps the default behaviour the py
// reference's `drain_ms=None` behaviour.
func TestBlock_WithoutAWindow_ArmsNothing(t *testing.T) {
	reset()
	RevlClockReset()
	src := StreamSource()
	sub := StreamSubscribe(src, "block", 1)
	src.Emit("i0")
	if src.Emit("i1") {
		t.Fatal("the provider must be TOLD it is blocked")
	}
	if n := RevlClockPending(); n != 0 {
		t.Fatalf("an unwindowed pause armed %d timer(s), want 0", n)
	}
	nextItem(t, sub, "i0")
	if st := sub.State(); st != "active" {
		t.Fatalf("an unwindowed subscription must resume EAGERLY, state = %q", st)
	}
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// A `block`-paused subscription is still torn down by its own bracket inverse:
// the pause is a provider-side refusal, never a hold on the consumer, so the
// core guarantee (§9 Part A) is untouched by the policy.
func TestBlock_APausedSubscriptionStillClosesCleanly(t *testing.T) {
	reset()
	src := StreamSource()
	sub := StreamSubscribe(src, "block", 1)
	src.Emit("i0")
	src.Emit("i1") // refused: paused
	if st := sub.State(); st != "paused" {
		t.Fatalf("state = %q, want paused", st)
	}
	sub.Close()
	if st := sub.State(); st != "closed" {
		t.Fatalf("state after close = %q, want closed", st)
	}
	v, err := sub.Next()
	if err != nil || !IsStreamClosed(v) {
		t.Fatalf("Next after close = (%#v, %v), want the Closed terminal", v, err)
	}
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// A lossy/blocking POLICY and a `take(n)` link on the SAME subscription — the
// interaction between the two Slice 2 landings, which neither one tests alone.
//
// Both mechanisms ride the SAME boolean: the acceptance `deliver` answers.
// `take(n)` reserves its slot under the lock and REFUNDS it when the forward is
// refused, and a `block` pause is exactly such a refusal. So the pause must not
// spend the budget: a consumer that asked for two items has to receive two. If
// the two used different signalling, `take(2)` would exhaust after ONE delivered
// item, push its `Closed` terminal early, and the second item would be gone with
// no overflow, no drop mark and no fault — the silent loss §4.4 rules out.
//
// The sequence is the py reference's, asserted there by
// `test_a_block_pause_does_not_spend_the_take_budget`.
func TestBlockPause_DoesNotSpendTheTakeBudget(t *testing.T) {
	reset()
	src := StreamSource()
	chain := StreamTake(src, 2)
	sub := StreamSubscribe(chain, "block", 1)

	if !src.Emit("i0") {
		t.Fatal("the first item fits the bounded buffer")
	}
	// the buffer is full; `block` refuses and pauses, and the refusal travels UP
	// through the take link, which must hand its slot back.
	if src.Emit("i1") {
		t.Fatal("the consumer's pause did not reach the provider through the chain")
	}
	if st := sub.State(); st != "paused" {
		t.Fatalf("state = %q, want paused", st)
	}
	if marksIndex(HostMarks(), "stream.emit i1 refused") < 0 {
		t.Fatalf("the refusal was not traced: %v", HostMarks())
	}
	if i := marksIndex(HostMarks(), "stream.take exhausted"); i >= 0 {
		t.Fatalf("the refused item SPENT the take budget — take(2) exhausted "+
			"after one delivered item: %v", HostMarks())
	}

	nextItem(t, sub, "i0") // drains -> resumes eagerly
	if st := sub.State(); st != "active" {
		t.Fatalf("state = %q, want active", st)
	}
	// the budget survived the pause, so the second item is still admissible
	if !src.Emit("i1") {
		t.Fatal("the take budget was not refunded: the second item was refused")
	}
	nextItem(t, sub, "i1")
	v, err := sub.Next()
	if err != nil || !IsStreamClosed(v) {
		t.Fatalf("next = (%#v, %v), want take(2)'s Closed terminal", v, err)
	}
	if n := len(drainMarks("stream.take exhausted")); n != 1 {
		t.Fatalf("stream.take exhausted fired %d times, want exactly 1", n)
	}
	sub.Close()
	src.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// Subscribing to an already-terminal provider terminates at once, so the first
// `next` cannot park on a provider that is already gone.
func TestSubscribeAfterProviderClose_TerminatesImmediately(t *testing.T) {
	reset()
	src := StreamSource()
	src.Close()
	sub := StreamSubscribe(src, "error", 0)
	v, err := sub.Next()
	if err != nil {
		t.Fatalf("next on a dead provider: %v", err)
	}
	if !IsStreamClosed(v) {
		t.Fatalf("next on a dead provider = %#v, want Closed", v)
	}
	sub.Close()
	if n := StreamPending(); n != 0 {
		t.Fatalf("residue = %d, want 0", n)
	}
}

// -------------------------------------------------------------------------
// Slice 4 — `every o in sub { … }` iteration on the blocking tier. The
// emitted loop delivers each item to the effectful body, a `Closed` terminal
// ends the loop WITHOUT entering the body, and unloading the owner while parked
// closes the subscription. This drives the EMITTED Iterate component (the loop
// is codegen inside LoadIterate, not a runtime primitive), so it is the proof
// the for-loop the emitter now renders actually runs.
// -------------------------------------------------------------------------

// collectSink is a hand-written impl of the emitted Sink service interface —
// the observable the iteration body emits into (`every o in sub { emit
// sink.write(o) }`), so a delivered item is a recorded write.
type collectSink struct {
	mu  sync.Mutex
	got []string
}

func (s *collectSink) Write(v string) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.got = append(s.got, v)
}

func (s *collectSink) snapshot() []string {
	s.mu.Lock()
	defer s.mu.Unlock()
	return append([]string(nil), s.got...)
}

// sinkProvider provides the emitted `_keySink` so the Iterate consumer's Inject
// gate resolves and its activation runs — mirroring how a provide/inject graph
// wires a required service (reference_test.go's TestRef_ReactiveProvideInject).
func sinkProvider(impl *collectSink) stc.Component {
	return stc.Component{
		Name:    "SinkProvider",
		Provide: []stc.Key{_keySink},
		Apply: func(ctx *stc.Context) (stc.Inverse, error) {
			if _, err := ctx.Provide(_keySink, Sink(impl)); err != nil {
				return nil, err
			}
			return nil, nil
		},
	}
}

func TestEmitted_Iteration_DeliversEachItemThenEndsOnTheClosedTerminal(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	sink := &collectSink{}
	provider := root.Load(sinkProvider(sink))
	if err := provider.Ready(bg()); err != nil {
		t.Fatalf("SinkProvider: %v", err)
	}

	type loaded struct {
		f   *stc.Fiber
		err error
	}
	done := make(chan loaded, 1)
	go func() {
		f := LoadIterate(root)
		done <- loaded{f, f.Ready(bg())}
	}()

	// The loop parks in `next` on its own source.
	waitFor(t, "the iteration to subscribe", func() bool {
		return StreamLiveSubscriptions() == 1
	})
	providers := StreamProviders()
	if len(providers) != 1 {
		t.Fatalf("providers = %d, want 1 (the iteration's source)", len(providers))
	}
	src := providers[0]

	// Two items, then an orderly close. Each item runs the body once; the
	// `Closed` terminal ends the loop and is never delivered as an item.
	src.Emit("a")
	src.Emit("b")
	src.Close()

	var got loaded
	select {
	case got = <-done:
		if got.err != nil {
			t.Fatalf("the iteration activation failed: %v", got.err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("the Closed terminal never ended the loop")
	}

	if g := sink.snapshot(); !reflect.DeepEqual(g, []string{"a", "b"}) {
		t.Fatalf("delivered items = %v, want [a b] (the Closed terminal must "+
			"not enter the body)", g)
	}

	got.f.Dispose()
	if err := got.f.Gone(bg()); err != nil {
		t.Fatalf("Gone: %v", err)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("stream residue after unload = %d, want 0", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources after unload = %d, want 0 (R1)", n)
	}
}

// The core guarantee for the loop: unloading the owner while the iteration is
// PARKED in `next` closes the subscription — teardown trips the cancel channel,
// the parked `next` resolves as `Closed`, the loop exits, and the bracket
// inverse runs on the same LIFO stack, all without an item ever arriving.
func TestEmitted_Iteration_UnloadWhileParkedClosesTheStream(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	sink := &collectSink{}
	provider := root.Load(sinkProvider(sink))
	if err := provider.Ready(bg()); err != nil {
		t.Fatalf("SinkProvider: %v", err)
	}

	type loaded struct {
		f   *stc.Fiber
		err error
	}
	done := make(chan loaded, 1)
	go func() {
		f := LoadIterate(root)
		done <- loaded{f, f.Ready(bg())}
	}()
	waitFor(t, "the iteration to park in next", func() bool {
		return StreamLiveSubscriptions() == 1
	})

	// The provider never emits and never terminates: the loop is parked in the
	// cancel-channel select. The orderly close of the LAST source ends it.
	StreamProviders()[0].Close()

	var got loaded
	select {
	case got = <-done:
		if got.err != nil {
			t.Fatalf("an orderly source close must end the loop cleanly: %v", got.err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("the source close never unparked the loop")
	}
	if g := sink.snapshot(); len(g) != 0 {
		t.Fatalf("the body ran on a terminal: delivered %v, want none", g)
	}

	got.f.Dispose()
	if err := got.f.Gone(bg()); err != nil {
		t.Fatalf("Gone: %v", err)
	}
	marks := HostMarks()
	if marksIndex(marks, "stream.close") < 0 {
		t.Fatalf("unloading the iteration did not close the subscription: %v", marks)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("stream residue after unload = %d, want 0", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources after unload = %d, want 0 (R1)", n)
	}
}

// -------------------------------------------------------------------------
// Slice 2 — the derived-stream combinator chain, executed.
//
// The compile-time half proves the chain EMITS; only running it proves the
// three answers agree with the py reference, which is the whole point of
// lowering it here rather than leaving it refused:
//
//   * `filter(p)` drops an item without it ever reaching the body, and a
//     rejection is NOT backpressure (the provider's emit still succeeds);
//   * `map(f)` reaches the body TRANSFORMED;
//   * `take(n)` ends the derived stream with a `Closed` TERMINAL after n
//     accepted items — the loop ends on it, the terminal never enters the body,
//     and a later emit is not delivered;
//   * the whole chain unwinds off the ONE bracket the `subscribe` registered:
//     no stream residue and no live host resource after unload.
// -------------------------------------------------------------------------

func TestEmitted_CombinatorChain_FiltersMapsAndEndsOnTake(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	sink := &collectSink{}
	provider := root.Load(sinkProvider(sink))
	if err := provider.Ready(bg()); err != nil {
		t.Fatalf("SinkProvider: %v", err)
	}

	type loaded struct {
		f   *stc.Fiber
		err error
	}
	done := make(chan loaded, 1)
	go func() {
		f := LoadChain(root)
		done <- loaded{f, f.Ready(bg())}
	}()

	waitFor(t, "the chain to subscribe", func() bool {
		return StreamLiveSubscriptions() == 1
	})
	// One PROVIDER plus three derived links (filter, map, take) — every link is
	// a live stream owned by the subscription below it.
	waitFor(t, "the three combinator links to open", func() bool {
		return len(StreamProviders()) == 4
	})
	src := StreamProviders()[0]
	if src.kind != "source" {
		t.Fatalf("the first stream is %q, want the provider", src.kind)
	}

	src.Emit("skip")   // filtered: never reaches the body
	src.Emit("one")    // -> "one!"
	src.Emit("skip")   // filtered again
	src.Emit("two")    // -> "two!", which spends take(2)
	src.Emit("three")  // past take(2): never delivered

	var got loaded
	select {
	case got = <-done:
		if got.err != nil {
			t.Fatalf("the chain activation failed: %v", got.err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("a spent take(n) never ended the loop")
	}

	if g := sink.snapshot(); !reflect.DeepEqual(g, []string{"one!", "two!"}) {
		t.Fatalf("delivered items = %v, want [one! two!] — filtered items never "+
			"reach the body, mapped ones reach it transformed, and take(2) bounds it", g)
	}
	marks := HostMarks()
	if marksIndex(marks, "stream.take exhausted") < 0 {
		t.Fatalf("take(2) did not synthesise its terminal: %v", marks)
	}

	got.f.Dispose()
	if err := got.f.Gone(bg()); err != nil {
		t.Fatalf("Gone: %v", err)
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("stream residue after unload = %d, want 0 (the whole chain "+
			"must unwind off the one subscribe bracket)", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources after unload = %d, want 0 (R1)", n)
	}
}

// The core guarantee still holds THROUGH a chain: unloading the owner while the
// loop is parked trips the cancel channel, resolves the park as `Closed`, and
// the ONE bracket inverse closes every derived link down to (but not including)
// the provider, which is left to its own bracket.
func TestEmitted_CombinatorChain_UnloadWhileParkedUnwindsTheWholeChain(t *testing.T) {
	reset()
	root := stc.New()
	defer root.Close()

	sink := &collectSink{}
	provider := root.Load(sinkProvider(sink))
	if err := provider.Ready(bg()); err != nil {
		t.Fatalf("SinkProvider: %v", err)
	}

	type loaded struct {
		f   *stc.Fiber
		err error
	}
	done := make(chan loaded, 1)
	go func() {
		f := LoadChain(root)
		done <- loaded{f, f.Ready(bg())}
	}()
	waitFor(t, "the chain to park in next", func() bool {
		return StreamLiveSubscriptions() == 1
	})

	// The provider never emits an item the chain forwards, so the loop is parked.
	// An orderly close of the source reaches the consumer THROUGH all three links.
	StreamProviders()[0].Close()

	var got loaded
	select {
	case got = <-done:
		if got.err != nil {
			t.Fatalf("an orderly source close must end the loop cleanly: %v", got.err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("the terminal never reached the consumer through the chain")
	}
	if g := sink.snapshot(); len(g) != 0 {
		t.Fatalf("the body ran on a terminal: delivered %v, want none", g)
	}

	got.f.Dispose()
	if err := got.f.Gone(bg()); err != nil {
		t.Fatalf("Gone: %v", err)
	}
	marks := HostMarks()
	for _, want := range []string{
		"stream.stage close take",
		"stream.stage close map",
		"stream.stage close filter",
	} {
		if marksIndex(marks, want) < 0 {
			t.Fatalf("the chain did not unwind (%s missing): %v", want, marks)
		}
	}
	if n := StreamPending(); n != 0 {
		t.Fatalf("stream residue after unload = %d, want 0", n)
	}
	if n := revlHostLive(); n != 0 {
		t.Fatalf("live host resources after unload = %d, want 0 (R1)", n)
	}
}
