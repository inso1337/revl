// Extern-declared compensations on the go tier (issue #1511, the item-254
// shape). An extern may declare its own offset:
//
//     extern emission fn put_let(k: Str) -> Int compensate undo_let() = @go { ... }
//
// and every crossing of it owes that offset, whatever position the call is
// written in. Before #1511 the go emitter registered it nowhere, so an abort
// after the crossing ran nothing. The go mirror of
// tests/test_declared_compensate_positions.py (the py fix).
//
// `Agent` has one method per position, each crossing its own extern, so a
// test can call one and abort. Its activation carries a site-spelled
// compensation, which gives the base the same frame and abort seam, so the
// base fails these tests by what the abort runs, not by a missing frame.
// `Full` crosses every position in one method, with a site-spelled
// `compensate` among them, after an activation-body crossing, so the abort's
// order is observable across both registrations. Every forward call and every
// compensation records through `hostRecord`; exec_test.go (hand-written)
// drives the calls, the abort and the commit.
//
// The `lifecycle test` keeps the document on emit()'s live stc-go path.

extern pure fn double(n: Int) -> Int = @go {
	return n * 2
}

extern emission fn plain(k: Str) -> Int = @go {
	hostRecord("put:site")
	return 1
}
extern pure fn undo_site() -> Unit = @go {
	hostRecord("comp:site")
}

extern pure fn undo_statement() -> Unit = @go {
	hostRecord("comp:statement")
}
extern emission fn put_statement(k: Str) -> Int compensate undo_statement() = @go {
	hostRecord("put:statement")
	return 1
}
extern pure fn undo_let() -> Unit = @go {
	hostRecord("comp:let")
}
extern emission fn put_let(k: Str) -> Int compensate undo_let() = @go {
	hostRecord("put:let")
	return 1
}
extern pure fn undo_return() -> Unit = @go {
	hostRecord("comp:return")
}
extern emission fn put_return(k: Str) -> Int compensate undo_return() = @go {
	hostRecord("put:return")
	return 1
}
extern pure fn undo_argument() -> Unit = @go {
	hostRecord("comp:argument")
}
extern emission fn put_argument(k: Str) -> Int compensate undo_argument() = @go {
	hostRecord("put:argument")
	return 1
}
extern pure fn undo_ifarm() -> Unit = @go {
	hostRecord("comp:ifarm")
}
extern emission fn put_ifarm(k: Str) -> Int compensate undo_ifarm() = @go {
	hostRecord("put:ifarm")
	return 1
}
extern pure fn undo_nested() -> Unit = @go {
	hostRecord("comp:nested")
}
extern emission fn put_nested(k: Str) -> Int compensate undo_nested() = @go {
	hostRecord("put:nested")
	return 1
}
extern pure fn undo_unit() -> Unit = @go {
	hostRecord("comp:unit")
}
extern emission fn put_unit(k: Str) -> Unit compensate undo_unit() = @go {
	hostRecord("put:unit")
}
extern pure fn undo_first() -> Unit = @go {
	hostRecord("comp:first")
}
extern emission fn put_first(k: Str) -> Int compensate undo_first() = @go {
	hostRecord("put:first")
	return 1
}
extern pure fn undo_boom() -> Unit = @go {
	hostRecord("comp:boom")
}
extern emission fn put_boom(k: Str) -> Int compensate undo_boom() = @go {
	hostRecord("put:boom")
	panic("put:boom failed")
}
extern pure fn undo_act() -> Unit = @go {
	hostRecord("comp:act")
}
extern emission fn put_act(k: Str) -> Int compensate undo_act() = @go {
	hostRecord("put:act")
	return 1
}

service Ops {
  emission fn run_statement() -> Int
  emission fn run_let() -> Int
  emission fn run_return() -> Int
  emission fn run_argument() -> Int
  emission fn run_ifarm(c: Bool) -> Int
  emission fn run_nested() -> Int
  emission fn run_unit() -> Int
  emission fn run_boom() -> Int
}

service Every {
  emission fn run() -> Int
}

component Agent provides ops: Ops {
  emit plain("k") compensate undo_site()
  provide ops {
    fn run_statement() {
      emit put_statement("k")
      return 0
    }
    fn run_let() {
      let a = emit put_let("k")
      return a
    }
    fn run_return() {
      return emit put_return("k")
    }
    fn run_argument() {
      let s = double(emit put_argument("k"))
      return s
    }
    fn run_ifarm(c) {
      if (c) { emit put_ifarm("k") }
      return 0
    }
    fn run_nested() {
      let b = emit put_nested("k") + 1
      return b
    }
    fn run_unit() {
      emit put_unit("k")
      return 0
    }
    fn run_boom() {
      emit put_first("k")
      return emit put_boom("k")
    }
  }
}

component Full provides all: Every {
  emit put_act("k")
  provide all {
    fn run() {
      emit put_statement("k")
      let a = emit put_let("k")
      let s = double(emit put_argument("k"))
      if (true) { emit put_ifarm("k") }
      emit plain("k") compensate undo_site()
      let b = emit put_nested("k") + 1
      return emit put_return("k")
    }
  }
}

lifecycle test "clean unload of an un-called agent leaves no residue" {
  load Agent
  unload Agent
  assert no_residue
}
