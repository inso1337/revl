// A declared `Secret[T]` must not reach the go host trace verbatim
// (roadmap item 421 F6, the go half).
//
// The go host trace interpolates a `pool.query`/`pool.execute` sql straight into
// `_hostLog`, which `HostMarks` hands back to anything embedding the emitted
// package. A `Secret[Str]` minted at an emission and then executed as a statement
// (the shape the py tier's own regression uses) reached it verbatim, because
// nothing on this tier knew what a declared `Secret[T]` was.
//
// The emitted program now registers the declared marking itself, at both ends —
// `revlSecretResult` around the extern whose declared return was `Secret[T]` (the
// origin) and `revlMarkSecret` at the head of a provide method whose service
// declares that parameter `Secret[T]` (the receiver) — and `hostRecord` scrubs
// every registered value out of every trace event. gen_exec_test.go proves it by
// RUNNING on stc-go.
extern emission[vault.mint] fn mint_token(u: Str) -> Secret[Str]
  = @go { return "SEKRIT-CANARY" }

// The statement's inverse. A `pool.execute` is not pure, so the site needs one;
// the pool itself is reverted by the activation body's own `undo pool.close()`,
// and re-closing it here would double-release the R1 live-resource counter.
extern pure fn forget_statement() -> Unit = @go {
	return
}

service Vault {
  emission fn issue(user: Str) -> Str
  emission fn replay(token: Secret[Str]) -> Str
}

component Issuer provides vault: Vault {
  let pool = effect Pool.open("pg://main", 2) undo pool.close()

  provide vault {
    // the ORIGIN end: the token enters the value world here
    fn issue(user) {
      let t = emit mint_token(user)
      effect pool.execute(t)
      undo   forget_statement()
      return "issued"
    }
    // the RECEIVER end: a declared `Secret[T]` parameter, no origin in sight
    fn replay(token) {
      effect pool.execute(token)
      undo   forget_statement()
      return "replayed"
    }
  }
}

// The go lifecycle-test emitter needs at least one lifecycle block to keep this
// document on the live stc-go component path (a document with top-level
// declarations and no lifecycle test routes to the pure typed-core tier, which
// drops the components). Loading and unloading the issuer also proves the
// funnel costs the ordinary trace nothing: `pool.open`/`pool.close` are
// byte-identical to a composition that declares no `Secret[T]`.
lifecycle test "the issuer activates and reverts its pool" {
  load Issuer
  unload Issuer
  assert no_residue
}
