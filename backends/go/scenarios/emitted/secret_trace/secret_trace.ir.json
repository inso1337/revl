{
  "ir_version": 3,
  "services": {
    "Vault": {
      "methods": {
        "issue": {
          "params": [
            {
              "name": "user",
              "type": "Str"
            }
          ],
          "returns": "Str",
          "emission": true
        },
        "replay": {
          "params": [
            {
              "name": "token",
              "type": "Str",
              "secret": true
            }
          ],
          "returns": "Str",
          "emission": true
        }
      }
    }
  },
  "components": [
    {
      "name": "Issuer",
      "source": "backends/go/scenarios/secret_trace.rvl",
      "config": [],
      "requires": {},
      "provides": {
        "vault": "Vault"
      },
      "body": [
        {
          "step": "let-effect",
          "acquire": {
            "kind": "host",
            "fn": "Pool.open",
            "args": [
              {
                "kind": "lit",
                "value": "pg://main"
              },
              {
                "kind": "lit",
                "value": 2
              }
            ]
          },
          "undo": {
            "kind": "call",
            "target": {
              "kind": "name",
              "id": "pool"
            },
            "method": "close",
            "args": []
          },
          "bind": "pool"
        },
        {
          "step": "provide",
          "name": "vault",
          "service": "Vault",
          "methods": [
            {
              "name": "issue",
              "params": [
                "user"
              ],
              "body": [
                {
                  "step": "let",
                  "name": "t",
                  "value": {
                    "kind": "fn",
                    "name": "mint_token",
                    "args": [
                      {
                        "kind": "name",
                        "id": "user"
                      }
                    ]
                  },
                  "mutable": false
                },
                {
                  "step": "effect",
                  "acquire": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "pool"
                    },
                    "method": "execute",
                    "args": [
                      {
                        "kind": "name",
                        "id": "t"
                      }
                    ]
                  },
                  "undo": {
                    "kind": "fn",
                    "name": "forget_statement",
                    "args": []
                  }
                },
                {
                  "step": "return",
                  "expr": {
                    "kind": "lit",
                    "value": "issued"
                  }
                }
              ]
            },
            {
              "name": "replay",
              "params": [
                "token"
              ],
              "body": [
                {
                  "step": "effect",
                  "acquire": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "pool"
                    },
                    "method": "execute",
                    "args": [
                      {
                        "kind": "name",
                        "id": "token"
                      }
                    ]
                  },
                  "undo": {
                    "kind": "fn",
                    "name": "forget_statement",
                    "args": []
                  }
                },
                {
                  "step": "return",
                  "expr": {
                    "kind": "lit",
                    "value": "replayed"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "manifest": {
    "components": [
      {
        "name": "Issuer",
        "file": "backends/go/scenarios/secret_trace.rvl",
        "inject": [],
        "provides": [
          "vault"
        ]
      }
    ],
    "loadOrder": [
      "Issuer"
    ]
  },
  "externs": [
    {
      "name": "mint_token",
      "class": "emission",
      "params": [
        {
          "name": "u",
          "type": "Str"
        }
      ],
      "returns": "Str",
      "bodies": {
        "go": " return \"SEKRIT-CANARY\" "
      },
      "secret_return": true,
      "capabilities": [
        "vault.mint"
      ]
    },
    {
      "name": "forget_statement",
      "class": "pure",
      "params": [],
      "returns": "Unit",
      "bodies": {
        "go": "\n\treturn\n"
      }
    }
  ],
  "tests": [
    {
      "name": "the issuer activates and reverts its pool",
      "lifecycle": true,
      "body": [
        {
          "step": "load",
          "component": "Issuer",
          "config": {}
        },
        {
          "step": "unload",
          "component": "Issuer"
        },
        {
          "step": "assert_no_residue"
        }
      ]
    }
  ]
}
