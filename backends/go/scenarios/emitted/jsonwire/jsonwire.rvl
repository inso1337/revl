// item 140 proof (go tier): the stdlib JSON wire protocol crosses to Go.
//
// `json_stringify(json_parse(s))` round-trips a structured document — a
// record-shaped object carrying a nested list and a nested map — through the
// real `encoding/json` package that the @go extern bodies reach via the
// `//revl:import encoding/json` hoist directive. `Any` erases to Go's `any`,
// which is exactly the shape `encoding/json` decodes into. The emitted file
// is the proof: a `*_test.go` whose `Test…` func RUNS the round-trip under
// `go test`.
//
// Regenerated by backends/go/regen.sh; the source IR is compiled from this
// file by the frozen frontend:
//   revl compile backends/go/scenarios/emitted/jsonwire/jsonwire.rvl \
//     -o backends/go/scenarios/emitted/jsonwire/jsonwire.ir.json
use "../../../../../stdlib/json.rvl" { json_parse, json_stringify }

fn roundtrip(s: Str) -> Str { return json_stringify(json_parse(s)) }

test "the JSON wire protocol round-trips a structured value on go" {
  // keys are already in canonical (sorted) order and the form is compact, so
  // `encoding/json`'s deterministic re-encoding reproduces the input exactly.
  let wire = """{"args":["london","paris"],"meta":{"n":2},"name":"get_weather"}"""
  assert roundtrip(wire) == wire
}
