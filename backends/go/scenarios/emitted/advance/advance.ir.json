      "body": [
        {
          "step": "let-effect",
          "bind": "store",
          "acquire": {
            "kind": "host",
            "fn": "Map.new",
            "args": []
          },
          "undo": {
            "kind": "call",
            "target": {
              "kind": "name",
              "id": "store"
            },
            "method": "drop",
            "args": []
          }
        },
        {
          "step": "provide",
          "name": "counter",
          "service": "Counter",
          "methods": [
            {
              "name": "count",
