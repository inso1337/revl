  "tests": [
    {
      "name": "an every-timer fires on each advanced tick",
      "lifecycle": true,
      "body": [
        {
          "step": "load",
          "component": "TickCounter",
          "config": {}
        },
        {
          "step": "load",
          "component": "Heartbeat",
          "config": {}
        },
        {
          "step": "call",
          "key": "counter",
          "method": "count",
          "args": [],
          "bind": "before"
        },
        {
          "step": "assert",
          "expr": {
            "kind": "bin",
            "op": "==",
            "left": {
              "kind": "var",
              "name": "before"
            },
            "right": {
              "kind": "lit",
              "value": 0
            }
          }
        },
        {
          "step": "advance",
          "ms": 35000
        },
        {
          "step": "call",
          "key": "counter",
          "method": "count",
          "args": [],
          "bind": "ticks"
        },
        {
          "step": "assert",
          "expr": {
            "kind": "bin",
            "op": "==",
            "left": {
              "kind": "var",
              "name": "ticks"
            },
            "right": {
              "kind": "lit",
              "value": 3
            }
          }
        },
        {
          "step": "unload",
          "component": "Heartbeat"
        },
        {
          "step": "advance",
          "ms": 100000
        },
        {
          "step": "call",
          "key": "counter",
          "method": "count",
          "args": [],
          "bind": "settled"
        },
        {
          "step": "assert",
          "expr": {
            "kind": "bin",
            "op": "==",
            "left": {
              "kind": "var",
              "name": "settled"
            },
            "right": {
              "kind": "lit",
              "value": 3
            }
          }
        },
        {
          "step": "unload",
          "component": "TickCounter"
        },
        {
          "step": "assert_no_residue"
        }
      ]
    },
    {
      "name": "an after-timer fires once when its delay elapses",
      "lifecycle": true,
      "body": [
        {
          "step": "load",
          "component": "TickCounter",
          "config": {}
        },
        {
          "step": "load",
          "component": "Warmup",
          "config": {}
        },
        {
          "step": "advance",
          "ms": 30000
        },
        {
          "step": "call",
          "key": "counter",
          "method": "count",
          "args": [],
          "bind": "early"
        },
        {
          "step": "assert",
          "expr": {
            "kind": "bin",
            "op": "==",
            "left": {
              "kind": "var",
              "name": "early"
            },
            "right": {
              "kind": "lit",
              "value": 0
            }
          }
        },
        {
          "step": "advance",
          "ms": 30000
        },
        {
          "step": "call",
          "key": "counter",
          "method": "count",
          "args": [],
          "bind": "fired"
        },
        {
          "step": "assert",
          "expr": {
            "kind": "bin",
            "op": "==",
            "left": {
              "kind": "var",
              "name": "fired"
            },
            "right": {
              "kind": "lit",
              "value": 1
            }
          }
        },
        {
          "step": "advance",
          "ms": 100000
        },
        {
          "step": "call",
          "key": "counter",
          "method": "count",
          "args": [],
          "bind": "spent"
        },
        {
          "step": "assert",
          "expr": {
            "kind": "bin",
            "op": "==",
            "left": {
              "kind": "var",
              "name": "spent"
            },
            "right": {
              "kind": "lit",
              "value": 1
            }
          }
        },
        {
          "step": "unload",
          "component": "Warmup"
        },
        {
          "step": "unload",
          "component": "TickCounter"
        },
        {
          "step": "assert_no_residue"
        }
      ]
    }
