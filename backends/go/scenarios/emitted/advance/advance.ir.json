                      {
                        "kind": "name",
                        "id": "key"
                      },
                      {
                        "kind": "lit",
                        "value": "fired"
                      }
                    ]
                  },
                  "undo": {
                    "kind": "call",
                    "target": {
                      "kind": "name",
                      "id": "store"
                    },
                    "method": "remove",
                    "args": [
