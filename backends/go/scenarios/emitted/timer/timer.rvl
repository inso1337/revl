// Timer scenario for the cordis-go tier (item 57, docs/time-coeffect.md).
// A timer is a *revertible schedule*: `every`/`after` acquire a schedule whose
// inverse is cancellation, wired into the same effect ledger that reverts any
// other effect. Heartbeat arms a periodic + a one-shot timer; Sink provides the
// Log its firings emit to. gen_exec_test.go proves — by RUNNING on stc-go —
// that firings are deterministic under RevlClockAdvance and that unloading the
// component cancels its timers residue-free (no orphaned interval).
service Log { emission fn write(msg: Str) }

component Sink provides log: Log {
  provide log {
    fn write(msg) {}
  }
}

component Heartbeat requires log: Log {
  every 30s {
    emit log.write("tick")
  }
  after 5m {
    emit log.write("warmup done")
  }
}
