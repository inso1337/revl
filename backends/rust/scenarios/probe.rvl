// Runtime-scenario fixtures: every effect/undo/emission calls the Probe
// service, which the test harness implements as a recorder — the scenarios
// assert on the exact call order (backends/rust/scenarios/scenarios.rs).

service Probe {
  fn mark(m: Str) -> Int
  emission fn send(m: Str) -> Int
}

service Kv {
  fn put(k: Str, v: Str)
}

// G7: two effects, teardown must run the inverses in reverse order.
component TwoSteps requires probe: Probe {
  effect probe.mark("do:a") undo probe.mark("undo:a")
  effect probe.mark("do:b") undo probe.mark("undo:b")
}

// A1 probe: an await between effects, an emission after the boundary.
component Boundary requires probe: Probe {
  effect probe.mark("do:a") undo probe.mark("undo:a")
  await Job.run("boundary")
  effect probe.mark("do:b") undo probe.mark("undo:b")
  emit probe.send("post")
}

// A8 / L-Raise: activation fails after one accumulated effect.
component FailsAfter requires probe: Probe {
  effect probe.mark("do:a") undo probe.mark("undo:a")
  fail "boom"
}

// Reactive lifecycle: provider/consumer pair over a real provision.
component KvProvider requires probe: Probe provides kv: Kv {
  let store = effect Map.new() undo store.drop()
  effect probe.mark("provider:up") undo probe.mark("provider:down")
  provide kv {
    fn put(k, v) = store.insert(k, v)
  }
}

component KvConsumer requires kv: Kv, probe: Probe {
  effect probe.mark("consumer:up") undo probe.mark("consumer:down")
  effect kv.put("who", "consumer") undo kv.put("who", "")
}

// Realm-label registry proof (see backends/rust/emit.py `_revl_realm`).
// This provider provides `kv` isolated in realm("t"); scenarios.rs drives it
// on the real cordis-rs runtime and checks that another context branch keyed
// on the SAME label sees the provision (equal labels = same realm) while a
// branch keyed on a DIFFERENT label does not (distinct labels = distinct
// realms), and that the emitted labels never collide with cordis's counter.
component RealmStoreT requires probe: Probe provides kv: Kv {
  isolate kv in realm("t")
  let store = effect Map.new() undo store.drop()
  effect probe.mark("store_t:up") undo probe.mark("store_t:down")
  provide kv {
    fn put(k, v) = store.insert(k, v)
  }
}

// Reactive realm linking: a consumer that requires `kv` isolated in the SAME
// realm("t") as RealmStoreT. Placed on its own isolated branch, it must
// reactively activate when RealmStoreT provides `kv` in realm("t") — the bug
// this scenario pins is the consumer hanging Pending forever because the
// emitter used to isolate INSIDE the plugin body, after the Inject gate was
// already evaluated on the un-isolated root context.
component RealmKvConsumerT requires kv: Kv, probe: Probe {
  isolate kv in realm("t")
  effect probe.mark("consumer_t:up") undo probe.mark("consumer_t:down")
}

// A second, DISTINCT realm label. Its presence registers "other" in the
// compile-time realm registry so scenarios.rs can probe cross-realm
// separation; the two labels ("t", "other") must lower to distinct Isolations.
component RealmStoreOther requires probe: Probe provides kv: Kv {
  isolate kv in realm("other")
  let store = effect Map.new() undo store.drop()
  provide kv {
    fn put(k, v) = store.insert(k, v)
  }
}

// Instance-parametric components (docs/design-v2-instances.md, phase 2 rust).
// `spawn` plugs the target template as a CHILD FIBER of the spawner, each
// provided key isolated into a FRESH LOCAL realm — so two instances of one
// component coexist without colliding, each is its own nested teardown scope
// reclaimable early, and only the spawner reaches its instance. Worker marks
// its own activation (`up:<tag>`, carrying the config that flowed through the
// spawn) and its LIFO teardown (`d2` then `d1:<tag>`); Supervisor spawns two
// Workers in its activation body and can retire worker A on demand through the
// handle it alone holds. Driven on the real cordis-rs runtime in scenarios.rs.
service Counter { fn value() -> Int }
service Ctl { fn retire_a() -> Int }

component Worker requires probe: Probe provides counter: Counter {
  config { tag: Str }
  effect probe.mark(`up:${config.tag}`) undo probe.mark(`d1:${config.tag}`)
  effect probe.mark("up2") undo probe.mark("d2")
  provide counter {
    fn value() = 0
  }
}

component Supervisor requires probe: Probe provides ctl: Ctl {
  let w1 = effect spawn Worker with { tag: "a" } undo w1.dispose()
  let w2 = effect spawn Worker with { tag: "b" } undo w2.dispose()
  provide ctl {
    fn retire_a() { let r = w1.dispose() return 1 }
  }
}
