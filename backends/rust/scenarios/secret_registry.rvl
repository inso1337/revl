// A declared `Secret[T]` config field must not reach any rust EMITTED-RUNTIME
// sink verbatim (roadmap item 421 F6, the rust half): the ordered host trace
// `revl_stream_marks()` gathers, and the durable WAL under `--record`.
//
// The credential is handed to the component's OWN host binding, which is the
// legitimate use the checker does not refuse (a `Secret[T]` parameter is the
// declared receiver). The host body then fails with a message that quotes its
// arguments, the plain shape a driver error takes. Nothing the author wrote
// interpolates the secret; the registry, populated at load, is what lets a
// free-form host string that DOES quote it be scrubbed before any sink keeps a
// copy. A source stream is opened so the emitted host trace exists to prove it
// against.
//
// rust (native) has no reflection: the registry is a process-global the emitted
// code populates directly at load (`revl_mark_secret(&config.api_key)`), the
// same register-at-Load shape the go tier uses, and every emitted trace sink
// reads through `revl_redact_text`.
extern emission[vault.connect] fn connect(key: Secret[Str], url: Str, user: Str) -> Unit
  = @rs { panic!("vault refused key {} at {} for {}", key, url, user); }

service Vault { emission fn open(user: Str) -> Str }
service Front { emission fn login(user: Str) -> Str }

component Keeper provides vault: Vault {
  config { url: Str = "pg://main", api_key: Secret[Str] = "k" }

  let src = effect Stream.source() undo src.close()

  provide vault {
    fn open(user) {
      emit connect(config.api_key, config.url, user)
      return "opened"
    }
  }
}

component Portal requires vault: Vault provides front: Front {
  provide front {
    fn login(user) {
      let r = emit vault.open(user)
      return r
    }
  }
}
