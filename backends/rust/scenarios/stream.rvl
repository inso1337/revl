// item 130 Slice 3 — the blocking-tier (`rust`) stream lowering.
// docs/design/130-stream-reactive-types.md §4.6 (the rust row), §9.
//
// The same three components the go tier proves, so the two blocking tiers are
// held to one shape:
//
//   Consumer — the CORE GUARANTEE (§0, exit test §10.2): a sync resource, then a
//     subscription bracket. Unloading the owner runs the inverses LIFO, so
//     `close` runs before the pool's and no listener outlives the owner.
//   Parked   — a blocking `next` (§4.6): the activation occupies its thread in
//     the item/terminal/cancel race until the provider emits. Faulting the
//     provider instead terminates that park as `Faulted`, fails the activation,
//     and reverts the prefix — closing the subscription (§9 Part B).
//   Fanin    — `merge` (§1): two sources fanned into one DERIVED stream owned by
//     the subscription, so multi-source teardown rides the one bracket the
//     subscribe registers.

component Consumer {
  let pool = effect Pool.open("orders", 2) undo pool.close()
  let src = effect Stream.source() undo src.close()
  let sub = subscribe src undo sub.close()
}

component Parked {
  let src = effect Stream.source() undo src.close()
  let sub = subscribe src undo sub.close()
  await sub.next()
}

component Fanin {
  let a = effect Stream.source() undo a.close()
  let b = effect Stream.source() undo b.close()
  let sub = subscribe merge(a, b) undo sub.close()
  await sub.next()
}
