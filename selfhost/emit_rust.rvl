// The revl backend-IR -> cordis-rs EMITTER, in revl — Path B slice 1 for the
// RUST tier (roadmap item 191). Where selfhost/emit_py.rvl ports the tail of the
// compiler to Python, this file ports it to Rust: it reads the stable
// interchange IR (docs/backend-ir.md) and produces Rust source text, mirroring
// backends/rust/emit.py.
//
// It is one half of a differential BYTE oracle: this file and
// backends/rust/emit.py's `emit()` are two independent implementations of the
// same lowering, forced to produce BYTE-IDENTICAL Rust for every input in the
// covered subset (tests/test_selfhost_emit_rust.py). A divergence needs triage:
// either implementation can be wrong (roadmap item 429).
//
// ============================================================ WHAT IT COVERS
// Every IR the frontend produces is ir_version 3, so the covered slice mirrors
// the reference's v3 path (`_emit_v3` -> `_emit_v3_types` / `_emit_v3_functions`
// -> `_render_expr` / `_v3_stmt`) for a TYPES + FUNCTIONS document with NO
// services, NO components, NO stdlib builtins — the corner of the v3 surface
// that emits, byte-for-byte, with only the module scaffold, the user type items,
// and the free-function bodies:
//
//   * the module scaffold — `_module_header(3)` (the two `//!` banner lines, the
//     `#![allow(..)]`, and the `use std::sync::Arc;` / `use cordis::Value;`);
//   * the v3 TYPED-CORE (slice 2) — `_emit_v3_types` (a record as a
//     `PartialEq`-deriving `pub struct`, a variant as a serde-tagged `pub enum`);
//     record literals (`Struct { f: v, .. }`, with the by-value field clone);
//     ADT construction (`Enum::Case` / `Enum::Case(arg)`, and the built-in
//     Result/Option constructors); `match` over user variants (with the
//     `unreachable!()` fallthrough); user record/variant names in `_rust_type`
//     (`List[Person]` -> `Vec<Person>`); field access (`p.name`); and the
//     `_V3Ctx` type-name inference (`case_adt`/`case_payload`/`record_by_fields`)
//     that seeds `var_types` and picks a record literal's nominal struct;
//   * `_emit_v3_functions` — each module fn as a Rust `fn`, with `_rust_type`
//     for scalar/`List`/`Opt`/`Map`/`Result`/user-type parameter and return
//     types, `pub` visibility, and `todo!()` for an empty body;
//   * `_v3_stmt` for the base statement surface — let/assign (with the
//     `var_types` seeding that drives by-value clone decisions), return,
//     if/while/for, the bare-expr `let _ = ..;`, and assert;
//   * `_render_expr` for the base expression algebra — lit, name, var (incl the
//     `Some`/`None`/`Ok`/`Err` built-in constructors), bin (incl `??`, the
//     bounded `checked_add/sub/mul` for Int/Int32, `/` as the widened f64 true
//     division, `%`, comparisons, `&&`/`||`, and string `+` via `format!`), un,
//     the 2.0 `callee`/`args` call (with `_by_value_arg` argument cloning), the
//     Int->Float / Int32->Int `widen` markers, index, ternary-if, list, maplit,
//     the sync arrow, and non-float `${..}` string interpolation.
//
// ============================================================ WHAT IT DEFERS
// Reported for follow-on rust-emitter slices, deliberately OUT of this slice —
// each is a real reference surface this slice does not reach (its fixtures avoid
// it), NOT an approximation:
//   * the COMPONENT surfaces beyond the effectful/config/req core (item 218 now
//     ports `_emit_component_new` + `_emit_component_auto`: config `<Comp>Config`
//     struct/Default/application + the `_revl_load` typed construction, required
//     services `req`/`Inject::new` gate/`ctx.require`, and method-body
//     `effect`/`undo`/`emit` through `self.ctx.effect`, plus the component-dialect
//     `req`/`config`/`fn` expression kinds and the `target`/`method` call form).
//     Still DEFERRED and REPORTED (each fires a `<<DEFER-*>>` marker): timers /
//     routers (`routes`), `await`/`spawn`, `isolate`/`intercept`/realms, host
//     `let-effect` binds (`Pool`/`Map`/`Job`) and the item-114 host-Map
//     undo-reclone, body-level `effect`/`timer`/`fail`/`if` steps, the `host`/
//     `format` component-dialect kinds, and the non-scalar bridge marshalling
//     (Result/serde/`Vec<Value>`/opaque-`Value`). These stay ENTANGLED with the
//     erasure surface below;
//   * functional record-update `{r | f = e}` — the RUST reference itself RAISES
//     on `record_update` (only python/typescript emit it today), so it is a
//     structural exclusion, not merely un-ported;
//   * `let_pattern` (record/list destructuring) — see the structural note below;
//   * the STDLIB surface — every `builtin`/`len` node and the `_stdlib_helper_traits`
//     / `revl_length` it pulls in (a fixture with any builtin trips `_uses_stdlib`
//     and grows the whole helper-trait block);
//   * the Value/serde ERASURE surface — `_emit_bridge` (the interop RPC proxy),
//     `Pool`/`Map`/`Job` host stubs (`_emit_host_stubs`), and the serde derives;
//   * async coloring (async methods / `await` / `plugin_async`), spawn/instances
//     (`_v3_spawn`/`instance-get`), realms (`isolate`/`intercept`/`routes`),
//     in-file `test`/lifecycle-test emission, and the canonical Float->Str
//     `revl_ftoa` (so `${aFloat}` interpolation is excluded);
//   * of `_emit_v3_externs` (issue 275 ports the section; it used to be MISSING,
//     a silent drop the oracle stayed green over): a `config`-schema extern
//     (item 378 Stage 5's `_revl_extern_config` scaffold) and an extern with no
//     `@rs` body (the reference RAISES) — each takes a loud marker;
//   * rust-specific NUANCES beyond the core — the `impl Fn(..)` lowering of a
//     declared function type and its escaping-position refusal, and the
//     non-ASCII / `\u{..}` reaches of `_string` beyond the ASCII core (the
//     escaper itself is bridged verbatim, but such literals are not in-corpus);
//   * `let_pattern` (record/list destructuring): the list form names a temporary
//     `_revl_list_{indent}_{len(out)}` from the output-buffer length, a walk
//     detail a second implementation cannot track — a structural exclusion.
//
// ------------------------------------------------------ the erased-IR boundary
// Navigation of the IR is PURE revl through stdlib/value.rvl's `value_*` /
// `value_keys` (items 180 / 188), exactly as selfhost/emit_py.rvl does after its
// slice-2 rewrite: every byte of emitter LOGIC (dispatch, formatting, the
// var_types threading, string building) is revl. Only HOST FORMATTING stays
// `@py` — the item-180 "NOT obsoleted" category: `string_lit` (the reference
// `_string` Rust-literal escaper, kin to py's `py_repr`), `num_str` (the
// `f"{value}i64"` / `f"{value}f64"` body, i.e. `str(value)`), `newline` (the one
// genuine U+000A), and `mangle` (the Rust-keyword rename `_mangle`).
use "../stdlib/value.rvl" {
  value_kind, value_is_null, value_field, value_opt,
  value_list, value_at, value_str, value_int, value_bool, value_keys
}
// The list kit (item 194): `list_sort` is the codepoint-lexicographic
// `sorted(...)` the reference uses to canonicalise a record's field set into a
// `record_by_fields` key; `str_lt` is its comparator, reused by the in-file
// tests. Both are byte-fuzz-pinned against Python `sorted()` — no re-hand-roll.
use "../stdlib/list.rvl" { list_sort, str_lt }
// `trim` is Python `str.strip()` for ASCII — the reference `.strip()`s an
// extern's `@rs` body before splicing it. No re-hand-roll (item 194).
use "../stdlib/str.rvl" { trim }

// ------------------------------------------------- host formatting (kept @py)
// `string_lit` is backends/rust/emit.py::_string for a `str` input, verbatim: a
// Rust double-quoted string literal escaped FROM code points (docs/strings.md).
// The list form (`Inject::new([..])`) is components-only, deferred, so the str
// path is all this slice needs.
extern pure fn string_lit(v: Any) -> Str = @py {
    out = ['"']
    for ch in v:
        cp = ord(ch)
        if ch == '"':
            out.append('\\"')
        elif ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif 0x20 <= cp <= 0x7E:
            out.append(ch)
        elif cp >= 0x80 and ch.isprintable():
            out.append(ch)
        else:
            out.append("\\u{%x}" % cp)
    out.append('"')
    return "".join(out)
}
// The literal-body host numeral: `_rust_v3_lit` renders an int as `f"{value}i64"`
// and a float as `f"{value}f64"`, both `str(value)`. Sourced here so the numeral
// text is exactly Python's.
extern pure fn num_str(v: Any) -> Str = @py { return str(v) }
// A real newline — the line SEPARATOR (`"\n".join(out)` in the reference).
extern pure fn newline() -> Str = @py { return chr(10) }
// `_mangle` verbatim: mirror BOTH `_RUST_RESERVED` and `_EMITTER_RESERVED`
// so user identifiers cannot collide with keywords or generated scaffolding.
// INJECTIVE: escape a name iff the name
// or any name reachable from it by dropping trailing `_` is reserved, by
// exactly one `_`, so the whole `kw`/`kw_`/`kw__` ladder shifts up a rung
// (`match` -> `match_`, `match_` -> `match__`) instead of collapsing two
// distinct revl identifiers onto one Rust identifier. A tuple, not a set, keeps
// the host body free of `{}` (the @py raw-brace balancer counts structural
// braces; a set literal would unbalance the block).
extern pure fn mangle(name: Str) -> Str = @py {
    reserved = ("as", "break", "const", "continue", "crate", "else", "enum",
                "extern", "false", "fn", "for", "if", "impl", "in", "let",
                "loop", "match", "mod", "move", "mut", "pub", "ref", "return",
                "self", "Self", "static", "struct", "super", "trait", "true",
                "type", "unsafe", "use", "where", "while", "async", "await",
                "dyn", "ctx", "config", "root", "plugin")
    root = name
    while root:
        if root in reserved:
            return name + "_"
        if not root.endswith("_"):
            break
        root = root[:-1]
    return name
}
// `_snake` verbatim: the component/service name -> the snake-case plugin-fn /
// dispatch-fn name (`Hello` -> `hello`, `EmitRust` -> `emit_rust`). A word
// boundary is an upper following a lower/digit; every char is lowercased. Host
// `str.lower()`/`str.isupper()` is exactly Python's, so it is bridged rather than
// re-derived from code points (the `mangle`/`string_lit` category).
extern pure fn snake(name: Str) -> Str = @py {
    out = []
    for i, ch in enumerate(name):
        if ch.isupper() and i > 0 and (name[i - 1].islower() or name[i - 1].isdigit()):
            out.append("_")
        out.append(ch.lower())
    return "".join(out)
}
// `_camel` verbatim: a provision key -> its PascalCase struct suffix
// (`greeting` -> `Greeting`), splitting on `_` and capitalising each part.
extern pure fn camel(name: Str) -> Str = @py {
    return "".join(part.capitalize() for part in name.split("_"))
}

// `_mname`: the one method rename this tier carries — `drop` collides with
// Rust's `Drop::drop` destructor (`_METHOD_RENAMES = {"drop": "drop_"}`).
// INJECTIVE like `mangle`: a method actually named `drop_` must not land on the
// renamed `drop`, so the `drop`/`drop_`/`drop__` ladder shifts up a rung.
fn mname(n: Str) -> Str {
  var root = n
  while (root.length() > 0) {
    if (root == "drop") { return n.concat("_") }
    if (root.charAt(root.length() - 1) != "_") { return n }
    root = root.slice(0, root.length() - 1)
  }
  return n
}

// ---------------------------------------------------------------- small utils
fn ind(n: Int) -> Str { return "    ".repeat(n) }
fn line(indent: Int, text: Str) -> Str { return ind(indent).concat(text) }
fn node_kind(n: Any) -> Str { return value_str(value_field(n, "kind")) }
fn node_op(n: Any) -> Str { return value_str(value_field(n, "op")) }
fn node_operands(n: Any) -> Str { return value_str(value_field(n, "operands")) }

// Trailing-whitespace trim, mirroring `"\n".join(out).rstrip()` before the final
// newline: the module assembly ends its function list with a blank line, and the
// reference strips it (plus any tab/CR/space) before re-appending one `\n`.
fn rstrip(s: Str) -> Str {
  var i = s.length()
  var go = true
  while (go && i > 0) {
    let c = s.charCodeAt(i - 1)
    if (c == 32 || c == 10 || c == 9 || c == 13) { i = i - 1 } else { go = false }
  }
  return s.slice(0, i)
}

fn strip_spaces(s: Str) -> Str {
  var a = 0
  var b = s.length()
  var go = true
  while (go && a < b) { if (s.charCodeAt(a) == 32) { a = a + 1 } else { go = false } }
  go = true
  while (go && b > a) { if (s.charCodeAt(b - 1) == 32) { b = b - 1 } else { go = false } }
  return s.slice(a, b)
}

// The postfix-safe primaries (`_ATOMIC_KINDS`): a `.method()`/`.field`/`[i]`/
// `.unwrap_or_else(..)` suffix appends without wrapping parens.
fn is_atomic(kind: Str) -> Bool {
  if (kind == "var") { return true }
  if (kind == "name") { return true }
  if (kind == "field") { return true }
  if (kind == "index") { return true }
  if (kind == "call") { return true }
  if (kind == "lit") { return true }
  if (kind == "req") { return true }
  if (kind == "config") { return true }
  return kind == "host"
}

// The `_V3_BIN_OPS` table: revl operator -> Rust operator, "" when unmapped.
fn v3_bin_ops(op: Str) -> Str {
  if (op == "==") { return "==" }
  if (op == "===") { return "==" }
  if (op == "!=") { return "!=" }
  if (op == "!==") { return "!=" }
  if (op == "<") { return "<" }
  if (op == ">") { return ">" }
  if (op == "<=") { return "<=" }
  if (op == ">=") { return ">=" }
  if (op == "+") { return "+" }
  if (op == "-") { return "-" }
  if (op == "*") { return "*" }
  if (op == "/") { return "/" }
  if (op == "%") { return "%" }
  if (op == "&&") { return "&&" }
  if (op == "||") { return "||" }
  // Int32 bitwise operators (item 366, docs/arithmetic.md). `& | ^` are native
  // on i32 and never trap. The shifts are rendered specially (render_bin) to
  // mask the count to 0..31, since rust panics on a shift amount >= 32.
  if (op == "&") { return "&" }
  if (op == "|") { return "|" }
  if (op == "^") { return "^" }
  if (op == "<<") { return "<<" }
  if (op == ">>") { return ">>" }
  return ""
}

fn checked_method(op: Str) -> Str {
  if (op == "+") { return "checked_add" }
  if (op == "-") { return "checked_sub" }
  return "checked_mul"
}

fn is_addsubmul(op: Str) -> Bool { return op == "+" || op == "-" || op == "*" }

fn is_builtin_ctor(name: Str) -> Bool {
  return name == "Some" || name == "None" || name == "Ok" || name == "Err"
}

// ---------------------------------------------------------------- lowering ctx
// The names visible to the expression/statement emitters (`_V3Ctx`, subset): a
// binding's surface type (seeded from params and `let` right-hand sides) drives
// the by-value clone decision and string-`+` detection; a free function's
// declared return type types a `let` bound to its call. The user-type tables
// mirror the reference's `_V3Ctx`:
//   * `ca` (`case_adt`)      — variant case name -> its enum type name; the
//     sentinel `<<AMBIG>>` marks a case name shared by two enums (the reference
//     stores `None` and refuses at use);
//   * `cp` (`case_payload`)  — case name -> `"y"`/`"n"`, whether the case
//     carries a payload (nullary vs one-argument construction);
//   * `rbf` (`record_by_fields`) — the sorted-field KEY of a record -> its
//     struct type name (`<<AMBIG>>` when two records share the exact field set),
//     so a record literal `{ a: .., b: .. }` infers its nominal Rust struct.
// `rn` is the component-capture RENAME map (`_render_expr`'s `rename` param):
// a bind/req/config/param NAME -> the Rust expression it lowers to inside a
// provide-method or effect/undo closure (`pool` -> `self.pool`, `config` ->
// `self.config`, `x` -> `x_undo`). Empty on the pure 2.0 path (item 191's
// slices 1-3), so those emit exactly as before; the effectful component path
// (item 218) sets it per render. Carrying it ON THE CTX — which already threads
// through every `render_*` — means match/interp/list/record subexpressions pick
// up the active rename for free, exactly as the reference's `rename` recursion.
type Ctx = { vt: Map[Str, Str], fr: Map[Str, Str], ca: Map[Str, Str], cp: Map[Str, Str], rbf: Map[Str, Str], rn: Map[Str, Str] }
// The user-type tables, built once from the document's `types` and shared by
// every function's ctx (the reference builds `_V3Ctx` per function-list, reusing
// the same type tables); paired with the type-NAME set for `rust_type`.
type TypeTables = { ca: Map[Str, Str], cp: Map[Str, Str], rbf: Map[Str, Str], tn: Map[Str, Str] }
// A statement-emission result: the lines produced AND the threaded ctx, since
// revl has no shared mutable state and a `let` inside an `if`/`while`/`for` block
// is visible to every later statement (the reference mutates one `ctx` in place).
type Sout = { lines: List[Str], ctx: Ctx }

fn map_get(m: Map[Str, Str], k: Str) -> Str {
  return match m.lookup(k) { Some(v) => v, None => "" }
}
fn set_vt(ctx: Ctx, k: Str, v: Str) -> Ctx {
  return { vt: ctx.vt.set(k, v), fr: ctx.fr, ca: ctx.ca, cp: ctx.cp, rbf: ctx.rbf, rn: ctx.rn }
}
// Swap in a fresh rename map (the component-capture scope for one render).
fn set_rn(ctx: Ctx, rn: Map[Str, Str]) -> Ctx {
  return { vt: ctx.vt, fr: ctx.fr, ca: ctx.ca, cp: ctx.cp, rbf: ctx.rbf, rn: rn }
}
// Swap in a fresh var_types map (a provide-method seeds params/map-bindings).
fn set_vts(ctx: Ctx, vt: Map[Str, Str]) -> Ctx {
  return { vt: vt, fr: ctx.fr, ca: ctx.ca, cp: ctx.cp, rbf: ctx.rbf, rn: ctx.rn }
}
// Whether a `ca`/`rbf` entry names a usable (unique) type; the `<<AMBIG>>`
// sentinel and a missing key both mean "not a byte-exact target here".
fn resolved(name: Str) -> Bool { return name != "" && name != "<<AMBIG>>" }

// `record_by_fields`' key: the field NAMES sorted (Python `tuple(sorted(..))`),
// joined with a `,`. Both the type-decl side (`fields.keys()`) and the record
// literal side (`[k for k, _ in fields]`) reduce to the same key. `list_sort`
// (the list kit) is exactly the codepoint `sorted(..)` the reference uses.
fn sorted_key(names: List[Str]) -> Str { return list_sort(names).join(",") }

// `_V3Ctx`'s type-table construction: fold the document `types` into the case /
// record lookups. Ambiguity (a case name / field set shared by two decls) is
// marked `<<AMBIG>>`, exactly where the reference stores `None`.
fn build_type_tables(types: Any) -> TypeTables {
  var ca: Map[Str, Str] = Map.empty()
  var cp: Map[Str, Str] = Map.empty()
  var rbf: Map[Str, Str] = Map.empty()
  var tn: Map[Str, Str] = Map.empty()
  for (name of value_keys(types)) {
    tn = tn.set(name, "1")
    let spec = value_field(types, name)
    let kind = value_str(value_field(spec, "kind"))
    if (kind == "record") {
      let key = sorted_key(value_keys(value_field(spec, "fields")))
      if (rbf.has(key)) { rbf = rbf.set(key, "<<AMBIG>>") } else { rbf = rbf.set(key, name) }
    }
    if (kind == "variant") {
      for (case of value_list(value_field(spec, "cases"))) {
        let cn = value_str(value_field(case, "name"))
        var pres = "n"
        if (!value_is_null(value_field(case, "payload"))) { pres = "y" }
        cp = cp.set(cn, pres)
        if (ca.has(cn)) { ca = ca.set(cn, "<<AMBIG>>") } else { ca = ca.set(cn, name) }
      }
    }
  }
  return { ca: ca, cp: cp, rbf: rbf, tn: tn }
}

// `_V3Ctx.record_type_for_fields`: a record literal's nominal struct type, from
// its (sorted) field set. Reference RAISES on no-unique-match; here the marker
// keeps the emitter total (no in-corpus literal is ambiguous or unknown).
fn record_type_for_fields(ctx: Ctx, names: List[Str]) -> Str {
  let name = map_get(ctx.rbf, sorted_key(names))
  if (!resolved(name)) { return `<<DEFER-record>>` }
  return mangle(name)
}

// -------------------------------------------------------------------- types
fn is_fn_type(name: Str) -> Bool {
  // A declared function type `(P, ..) -> R` is the one spelling starting with a
  // paren. Its `impl Fn(..)` lowering is DEFERRED; no in-slice type starts with
  // `(`, so this both keeps `_by_value_arg`'s fn-type branch honest and lets
  // `rust_type` flag one out of subset rather than mis-lower it.
  return name.startsWith("(")
}

fn type_map(name: Str) -> Str {
  if (name == "Str") { return "String" }
  if (name == "Int") { return "i64" }
  if (name == "Int32") { return "i32" }
  if (name == "Float") { return "f64" }
  if (name == "Bool") { return "bool" }
  if (name == "Bytes") { return "Vec<u8>" }
  if (name == "Unit") { return "()" }
  return ""
}

// `_split_generic`: split `P1, P2, ..` on top-level commas.
fn split_generic(inner: Str) -> List[Str] {
  var parts = []
  var depth = 0
  var start = 0
  var i = 0
  while (i < inner.length()) {
    let ch = inner.charAt(i)
    if (ch == "[" || ch == "(") { depth = depth + 1 }
    else {
      if (ch == "]" || ch == ")") { depth = depth - 1 }
      else {
        if (ch == "," && depth == 0) {
          parts = parts.push(strip_spaces(inner.slice(start, i)))
          start = i + 1
        }
      }
    }
    i = i + 1
  }
  parts = parts.push(strip_spaces(inner.slice(start, inner.length())))
  return parts
}

// `_rust_type`: scalars, the `List`/`Opt`/`Map`/`Result` generics, a user
// record/variant NAME mapped to its emitted struct/enum name (when in `tnames`,
// exactly the reference's `name in types` branch), and the opaque `Value`
// fallback for an unknown/empty/function type. Branch order matches the
// reference: fn-type, scalar, user type, generic, fallback.
fn rust_type_t(tv: Any, tnames: Map[Str, Str]) -> Str {
  let name = value_str(tv)
  if (name == "") { return "Value" }
  if (is_fn_type(name)) { return "<<DEFER-fn-type>>" }
  let tm = type_map(name)
  if (tm != "") { return tm }
  if (tnames.has(name)) { return mangle(name) }
  if (name.endsWith("]")) {
    let lb = name.indexOf("[")
    if (lb > 0) {
      let head = name.slice(0, lb)
      let inner = name.slice(lb + 1, name.length() - 1)
      if (head == "List") { return `Vec<${rust_type_t(inner, tnames)}>` }
      if (head == "Opt") { return `Option<${rust_type_t(inner, tnames)}>` }
      if (head == "Map") {
        let ps = split_generic(inner)
        return `std::collections::HashMap<${rust_type_t(ps[0], tnames)}, ${rust_type_t(ps[1], tnames)}>`
      }
      if (head == "Result") {
        let ps = split_generic(inner)
        return `Result<${rust_type_t(ps[0], tnames)}, ${rust_type_t(ps[1], tnames)}>`
      }
    }
  }
  return "Value"
}
// The type-name-free spelling, for the scalar/generic surface with no user
// types in scope (the in-file tests and any function-only document).
fn rust_type(tv: Any) -> Str { return rust_type_t(tv, Map.empty()) }

// item 383 (self-host port): a declared function type `(P, ..) -> R` lowers to
// `impl Fn(P, ..) -> R` in the `param`/`return` positions of a free `fn`/`extern`
// (rustc monomorphises it, exactly as a hand-written Rust signature would). This
// mirrors the reference's position-aware `_rust_type`/`_rust_fn_type`: only those
// positions are monomorphisable, so ESCAPING function types (a struct field, an
// `ADT`/`List`/`Opt`/`Map` element, a service-method signature) still have no
// constructible lowering and stay the out-of-subset `<<DEFER-fn-type>>` marker
// `rust_type_t` returns. `.map`/`.filter`/`.reduce` reach this through their
// `list_map`/`list_filter`/`list_reduce` free-function parameters.
//
// `_split_fn_type`: the leading parenthesised group is the (comma-separated)
// parameters; the type after the matching `->` is the return.
fn split_fn_params(name: Str) -> List[Str] {
  var depth = 0
  var i = 0
  while (i < name.length()) {
    let ch = name.charAt(i)
    if (ch == "[" || ch == "(") { depth = depth + 1 }
    else {
      if (ch == "]" || ch == ")") {
        depth = depth - 1
        if (depth == 0) {
          let inner = strip_spaces(name.slice(1, i))
          if (inner == "") { return [] }
          return split_generic(inner)
        }
      }
    }
    i = i + 1
  }
  return []
}
fn split_fn_ret(name: Str) -> Str {
  var depth = 0
  var i = 0
  while (i < name.length()) {
    let ch = name.charAt(i)
    if (ch == "[" || ch == "(") { depth = depth + 1 }
    else {
      if (ch == "]" || ch == ")") {
        depth = depth - 1
        if (depth == 0) {
          let rest = strip_spaces(name.slice(i + 1, name.length()))
          if (rest.startsWith("->")) { return strip_spaces(rest.slice(2, rest.length())) }
          return ""
        }
      }
    }
    i = i + 1
  }
  return ""
}
// `_erase_async`: an `Async[T]` fn-type return has no async-fn machinery on the
// rust tier, so it erases to its concrete `T` (item 92/94) — `(Str) -> Async[Str]`
// lowers `impl Fn(String) -> String`, not `impl Fn(String) -> Value`.
fn erase_async_ret(ret: Str) -> Str {
  let r = strip_spaces(ret)
  if (r.startsWith("Async[") && r.endsWith("]")) {
    return strip_spaces(r.slice(6, r.length() - 1))
  }
  return ret
}
// `_rust_type` at a `param`/`return` position: a function type lowers to
// `impl Fn(..)`; everything else takes the ordinary owned lowering.
fn rust_type_pos(tv: Any, tnames: Map[Str, Str]) -> Str {
  let name = value_str(tv)
  if (is_fn_type(name)) {
    var ps = []
    for (p of split_fn_params(name)) { ps = ps.push(rust_type_t(p, tnames)) }
    return `impl Fn(${ps.join(", ")}) -> ${rust_type_t(erase_async_ret(split_fn_ret(name)), tnames)}`
  }
  return rust_type_t(tv, tnames)
}

// `_rust_v3_lit`: a v3 literal. Strings are owned `String` (revl `Str`).
fn rust_v3_lit(node: Any) -> Str {
  let v = value_field(node, "value")
  let k = value_kind(v)
  if (k == "null") { return "None" }
  if (k == "bool") { if (value_bool(v)) { return "true" } return "false" }
  if (k == "str") { return "String::from(".concat(string_lit(v)).concat(")") }
  if (k == "int") { return num_str(v).concat("i64") }
  if (k == "float") { return num_str(v).concat("f64") }
  return "<<UNSUPPORTED-LIT>>"
}

// --------------------------------------------------- type inference (subset)
// `_v3_is_float`: syntactically-certain Float.
fn v3_is_float(node: Any) -> Bool {
  let k = node_kind(node)
  if (k == "lit") { return value_kind(value_field(node, "value")) == "float" }
  if (k == "bin") { return node_op(node) == "/" || node_operands(node) == "Float" }
  if (k == "un") {
    if (node_op(node) != "-") { return false }
    return v3_is_float(value_field(node, "operand"))
  }
  return false
}

fn ref_name(node: Any) -> Str {
  let k = node_kind(node)
  if (k == "var" || k == "req") { return value_str(value_field(node, "name")) }
  if (k == "name") {
    let idv = value_str(value_field(node, "id"))
    if (idv != "") { return idv }
    return value_str(value_field(node, "name"))
  }
  return ""
}

// `_v3_is_str`: certainly a `Str` (a literal, a template, a Str-typed binding, or
// a `+` over those). Conservative — never guesses.
fn v3_is_str(node: Any, ctx: Ctx) -> Bool {
  let k = node_kind(node)
  if (k == "lit") { return value_kind(value_field(node, "value")) == "str" }
  if (k == "interp") { return true }
  if (k == "name" || k == "var") { return map_get(ctx.vt, ref_name(node)) == "Str" }
  if (k == "bin" && node_op(node) == "+") {
    return v3_is_str(value_field(node, "left"), ctx) || v3_is_str(value_field(node, "right"), ctx)
  }
  return false
}

// `_v3_infer_type`: the surface type of an expression when knowable, else "".
fn v3_infer_type(node: Any, ctx: Ctx) -> Str {
  let k = node_kind(node)
  if (k == "name" || k == "var" || k == "req") { return map_get(ctx.vt, ref_name(node)) }
  if (k == "adt") { return map_get(ctx.ca, value_str(value_field(node, "case"))) }
  if (k == "fn") { return map_get(ctx.fr, value_str(value_field(node, "name"))) }
  if (k == "call" && !value_is_null(value_field(node, "callee"))) {
    let callee = value_field(node, "callee")
    if (node_kind(callee) == "var") {
      let cn = value_str(value_field(callee, "name"))
      if (ctx.ca.has(cn)) { return map_get(ctx.ca, cn) }
      if (ctx.fr.has(cn)) { return map_get(ctx.fr, cn) }
    }
  }
  if (k == "list") { return "List" }
  if (v3_is_str(node, ctx)) { return "Str" }
  if (v3_is_float(node)) { return "Float" }
  return ""
}

// `_v3_borrowed_str_lit`: the bare `&'static str` rendering of a `Str` literal
// node, else "". `rust_v3_lit` renders every `Str` literal as an owned
// `String::from(..)`, which is right for a slot that STORES the string and pure
// waste for one that only READS it (item 437b).
fn borrowed_str_lit(node: Any) -> Str {
  if (node_kind(node) != "lit") { return "" }
  let v = value_field(node, "value")
  if (value_kind(v) != "str") { return "" }
  return string_lit(v)
}

// `_v3_str_eq_borrow`'s guard: may the literal on the OTHER side of this `==`
// be borrowed? Yes unless the emitter positively knows this operand is some
// other surface type. The other operand of a `Str` literal is a `Str` by the
// checker, so the only open question is its rust rendering, and a site spelled
// `X == String::from("lit")` only builds when `X: PartialEq<String>` — on this
// tier `String` or a borrowed `&str`, both of which also carry
// `PartialEq<&str>`. An un-inferable operand is therefore borrowable.
fn eq_operand_borrowable(node: Any, ctx: Ctx) -> Bool {
  let t = v3_infer_type(node, ctx)
  return t == "" || t == "Str"
}

// `_borrow_str_arg`: an argument bound for a `&str` slot. A `Str` LITERAL fills
// the slot as the bare `&'static str` (item 437b); every other string
// expression is borrowed with `&`, parenthesized when it is not atomic. The
// reference also passes a borrowed `&str` PARAM straight through, which has no
// mirror here: this port carries no item-282 borrow analysis, so it never has
// one to pass.
fn borrow_str_arg(arg_node: Any, rendered: Str) -> Str {
  let lit = borrowed_str_lit(arg_node)
  if (lit != "") { return lit }
  if (is_atomic(node_kind(arg_node))) { return `&${rendered}` }
  return `&(${rendered})`
}

// `_v3_mentions_name`: does this node read the binding `name` anywhere inside?
// The in-place self-append turns a value the receiver is rebound over into a
// mutation OF the receiver, so an appended operand that reads the receiver
// (`s = s + s`) would take a shared borrow of a value already borrowed mutably
// (E0502) where the `format!` form built a fresh value and compiled.
fn mentions_name(v: Any, name: Str) -> Bool {
  let k = value_kind(v)
  if (k == "record") {
    let nk = node_kind(v)
    if (nk == "var" || nk == "name" || nk == "req") {
      if (ref_name(v) == name) { return true }
    }
    for (key of value_keys(v)) {
      if (mentions_name(value_field(v, key), name)) { return true }
    }
    return false
  }
  if (k == "list") {
    for (child of value_list(v)) {
      if (mentions_name(child, name)) { return true }
    }
    return false
  }
  return false
}

// `_v3_self_append_plus`: `s = s + p` rewritten in place, or "" (item 437a).
//
// The assign rebinds the receiver over its own value, so the pre-image is
// unreachable after this statement, and the receiver is uniquely owned because
// a second live owner could only come from a move and rustc refuses a
// move-then-reuse (E0382). `format!("{}{}", s, p)` built a whole fresh String
// per iteration, which makes an n-step accumulator loop O(n^2) copies where
// `push_str` is O(n) amortised. Only the APPEND direction qualifies: the target
// must be the LEFT operand, since `s = p + s` is a prepend and `push_str` does
// not express it.
fn self_append_plus(target: Str, recv: Str, valnode: Any, ctx: Ctx) -> Str {
  if (node_op(valnode) != "+") { return "" }
  let ln = value_field(valnode, "left")
  let rn = value_field(valnode, "right")
  if (node_kind(ln) != "var") { return "" }
  if (value_str(value_field(ln, "name")) != target) { return "" }
  // The same test the `+` lowering uses to pick `format!` over the arithmetic
  // path, so this fires on exactly the `+`s that build a String.
  if (!v3_is_str(ln, ctx) && !v3_is_str(rn, ctx)) { return "" }
  if (mentions_name(rn, target)) { return "" }
  return `${recv}.push_str(${borrow_str_arg(rn, render_expr(rn, ctx))});`
}

// `_by_value_arg`: wrap a by-value free-function/constructor argument so the call
// cannot consume a value the caller still needs (E0382). A bare non-Copy variable
// is `.clone()`d; a function-typed one is passed `&`; Copy scalars and fresh
// temporaries pass through.
fn by_value_arg(arg_node: Any, rendered: Str, ctx: Ctx) -> Str {
  let name = ref_name(arg_node)
  if (name == "") { return rendered }
  let ty = map_get(ctx.vt, name)
  if (ty == "") { return rendered }
  if (is_fn_type(ty)) { return "&".concat(rendered) }
  let head = strip_spaces(ty.split("[")[0])
  if (head == "Int" || head == "Bool" || head == "Float") { return rendered }
  return rendered.concat(".clone()")
}

// -------------------------------------------------------------- expressions
// `_V3Ctx.constructor`: a user variant case -> `Enum::Case` / `Enum::Case(arg)`
// (the case name is used RAW, as the reference does — not mangled), else the
// built-in Result/Option constructors. Reuses the same logic the call/adt/var
// paths funnel through.
fn constructor(ctx: Ctx, name: Str, args: List[Str]) -> Str {
  let adt = map_get(ctx.ca, name)
  if (resolved(adt)) {
    if (map_get(ctx.cp, name) == "n") { return `${adt}::${name}` }
    return `${adt}::${name}(${args[0]})`
  }
  if (name == "None") { return "None" }
  if (name == "Some" || name == "Ok" || name == "Err") {
    return `${name}(${args[0]})`
  }
  return `<<DEFER-ctor:${name}>>`
}

// `_V3Ctx.match_pattern`: a match arm's pattern. `_` is the wildcard; a user
// case is `Enum::Case` (raw case), optionally binding `Enum::Case(bind)`; a
// built-in constructor stands alone.
fn match_pattern(ctx: Ctx, arm: Any) -> Str {
  let pattern = value_str(value_field(arm, "pattern"))
  if (pattern == "_") { return "_" }
  let bind = value_str(value_field(arm, "bind"))
  let adt = map_get(ctx.ca, pattern)
  var prefix = ""
  if (resolved(adt)) { prefix = `${adt}::${pattern}` }
  else {
    if (is_builtin_ctor(pattern)) { prefix = pattern }
    else { return `<<DEFER-match:${pattern}>>` }
  }
  if (bind != "") { return `${prefix}(${mangle(bind)})` }
  return prefix
}

fn render_var(node: Any, ctx: Ctx) -> Str {
  let name = value_str(value_field(node, "name"))
  let mangled = mangle(name)
  let adt = map_get(ctx.ca, name)
  if (resolved(adt)) { return `${adt}::${mangled}` }
  if (is_builtin_ctor(name)) { return name }
  return mangled
}

fn render_bin(node: Any, ctx: Ctx) -> Str {
  let op = node_op(node)
  if (op == "??") {
    let ln = value_field(node, "left")
    var left = render_expr(ln, ctx)
    if (!is_atomic(node_kind(ln))) { left = `(${left})` }
    return `${left}.unwrap_or_else(|| ${render_expr(value_field(node, "right"), ctx)})`
  }
  if (op == "+") {
    let lf = value_field(node, "left")
    let rf = value_field(node, "right")
    if (v3_is_str(lf, ctx) || v3_is_str(rf, ctx)) {
      return `format!("{}{}", ${render_expr(lf, ctx)}, ${render_expr(rf, ctx)})`
    }
  }
  let opr = v3_bin_ops(op)
  if (opr == "") { return `<<UNSUPPORTED-BIN:${op}>>` }
  let ln = value_field(node, "left")
  let rn = value_field(node, "right")
  var left = render_expr(ln, ctx)
  var right = render_expr(rn, ctx)
  if (op == "==" || op == "!=") {
    let llit = borrowed_str_lit(ln)
    let rlit = borrowed_str_lit(rn)
    if (rlit != "" && eq_operand_borrowable(ln, ctx)) { right = rlit }
    if (llit != "" && eq_operand_borrowable(rn, ctx)) { left = llit }
  }
  let opnd = node_operands(node)
  if (is_addsubmul(op) && opnd == "Int") {
    return `(${left}).${checked_method(op)}(${right}).expect("revl: Int overflow")`
  }
  if (is_addsubmul(op) && opnd == "Int32") {
    return `(${left}).${checked_method(op)}(${right}).expect("revl: Int32 overflow")`
  }
  if (op == "/" && (opnd == "Int" || opnd == "Int32")) {
    return `((${left}) as f64 / (${right}) as f64)`
  }
  if (op == "<<" || op == ">>") {
    // Int32 shift: mask the count to 0..31 (mod 32) so `<<`/`>>` stay panic-
    // free (rust panics on a shift amount >= 32) and match wasm/JS. `<<` drops
    // the high bits (i32 two's complement); `>>` on the signed i32 is
    // arithmetic (docs/arithmetic.md, item 366).
    return `(${left} ${opr} ((${right}) & 31))`
  }
  return `(${left} ${opr} ${right})`
}

fn render_un(node: Any, ctx: Ctx) -> Str {
  let op = node_op(node)
  let operand = render_expr(value_field(node, "operand"), ctx)
  if (op == "!") { return `(!${operand})` }
  if (op == "~") {
    // Int32 bitwise complement (item 366): rust spells bitwise NOT on an
    // integer as `!` (the same token as logical not on bool). Never traps.
    return `(!${operand})`
  }
  if (op == "-") { return `(-${operand})` }
  return `<<UNSUPPORTED-UN:${op}>>`
}

// The component-form call `target.method(args)` (no `callee`): a service call
// through a `req`, or a receiver-expression method call. Host-Map receivers
// (`get`/`remove` key-borrow, `insert` no-clone) are DEFERRED — the covered
// subset declares no host `Map` binding, so `recv_ty` never starts with `Map[`
// and every argument takes the by-value service-call clone.
fn render_component_call(node: Any, ctx: Ctx) -> Str {
  let target = value_field(node, "target")
  let method = mangle(mname(value_str(value_field(node, "method"))))
  let arg_nodes = value_list(value_field(node, "args"))
  var arg_exprs = []
  for (a of arg_nodes) { arg_exprs = arg_exprs.push(render_expr(a, ctx)) }
  let tkind = node_kind(target)
  var tname = ""
  if (tkind == "req") { tname = value_str(value_field(target, "name")) }
  else { tname = ref_name(target) }
  let recv_ty = map_get(ctx.vt, tname)
  if (recv_ty.startsWith("Map[")) { return `<<DEFER-host-map-call:${method}>>` }
  var bv = []
  var i = 0
  while (i < arg_nodes.length()) {
    bv = bv.push(by_value_arg(arg_nodes[i], arg_exprs[i], ctx))
    i = i + 1
  }
  var recv = ""
  if (tkind == "req") {
    recv = mangle(value_str(value_field(target, "name")))
    if (ctx.rn.has(value_str(value_field(target, "name")))) {
      recv = map_get(ctx.rn, value_str(value_field(target, "name")))
    }
  } else {
    recv = render_expr(target, ctx)
  }
  return `${recv}.${method}(${bv.join(", ")})`
}

fn render_call(node: Any, ctx: Ctx) -> Str {
  let callee_node = value_field(node, "callee")
  if (value_is_null(callee_node)) { return render_component_call(node, ctx) }
  let arg_nodes = value_list(value_field(node, "args"))
  var arg_exprs = []
  for (a of arg_nodes) { arg_exprs = arg_exprs.push(render_expr(a, ctx)) }
  let ckind = node_kind(callee_node)
  if (ckind == "field") { return "<<DEFER-method-call>>" }
  var callee_name = ""
  if (ckind == "var") { callee_name = value_str(value_field(callee_node, "name")) }
  if (callee_name != "" && (is_builtin_ctor(callee_name) || ctx.ca.has(callee_name))) {
    return constructor(ctx, callee_name, arg_exprs)
  }
  var callee = render_expr(callee_node, ctx)
  if (!is_atomic(ckind)) { callee = `(${callee})` }
  var bv = []
  var i = 0
  while (i < arg_nodes.length()) {
    bv = bv.push(by_value_arg(arg_nodes[i], arg_exprs[i], ctx))
    i = i + 1
  }
  return `${callee}(${bv.join(", ")})`
}

fn render_index(node: Any, ctx: Ctx) -> Str {
  let tn = value_field(node, "target")
  var target = render_expr(tn, ctx)
  if (!is_atomic(node_kind(tn))) { target = `(${target})` }
  return `(${target})[(${render_expr(value_field(node, "index"), ctx)}) as usize].clone()`
}

fn render_list(node: Any, ctx: Ctx) -> Str {
  var parts = []
  for (it of value_list(value_field(node, "items"))) { parts = parts.push(render_expr(it, ctx)) }
  return "vec![".concat(parts.join(", ")).concat("]")
}

fn render_arrow(node: Any, ctx: Ctx) -> Str {
  var ps = []
  for (p of value_list(value_field(node, "params"))) { ps = ps.push(mangle(value_str(p))) }
  return `move |${ps.join(", ")}| { ${render_expr(value_field(node, "body"), ctx)} }`
}

// `field`: `target.field`, the target parenthesized only when non-atomic.
fn render_field(node: Any, ctx: Ctx) -> Str {
  let tn = value_field(node, "target")
  var target = render_expr(tn, ctx)
  if (!is_atomic(node_kind(tn))) { target = `(${target})` }
  return `${target}.${mangle(value_str(value_field(node, "name")))}`
}

// `record`: a nominal `Struct { f: v, .. }` literal. Each field value moves into
// the struct, so a reused non-Copy bare variable is `.clone()`d (`_by_value_arg`),
// matching the reference — `{ name: n, .. }` becomes `Person { name: n.clone(), .. }`
// when `n: Str`. The struct name is inferred from the (sorted) field set.
fn render_record(node: Any, ctx: Ctx) -> Str {
  let fields = value_list(value_field(node, "fields"))
  var names = []
  for (f of fields) { names = names.push(value_str(value_at(f, 0))) }
  let tn = record_type_for_fields(ctx, names)
  var body = []
  for (f of fields) {
    let k = value_str(value_at(f, 0))
    let vnode = value_at(f, 1)
    let r = by_value_arg(vnode, render_expr(vnode, ctx), ctx)
    body = body.push(`${mangle(k)}: ${r}`)
  }
  return `${tn} { ${body.join(", ")} }`
}

// `_v3_match_expr`: a `match` as Rust. Arms carry a literal FOUR-space indent
// (not the surrounding statement's pad — the reference builds the arm lines with
// a fixed `    ` prefix and the enclosing `_v3_stmt` only pads the first line);
// an unmatched `_` gets `unreachable!()` unless an arm already wilds.
fn render_match(node: Any, ctx: Ctx) -> Str {
  let scrut = render_expr(value_field(node, "scrutinee"), ctx)
  let arms = value_list(value_field(node, "arms"))
  var lines = [`match ${scrut} {`]
  var hasWild = false
  for (arm of arms) {
    let pat = match_pattern(ctx, arm)
    if (value_str(value_field(arm, "pattern")) == "_") { hasWild = true }
    let body = render_expr(value_field(arm, "body"), ctx)
    lines = lines.push(`    ${pat} => ${body},`)
  }
  if (!hasWild) { lines = lines.push("    _ => unreachable!(),") }
  lines = lines.push("}")
  return lines.join(newline())
}

fn escape_braces(s: Str) -> Str {
  var out = ""
  var i = 0
  while (i < s.length()) {
    let ch = s.charAt(i)
    if (ch == "{") { out = out.concat("{{") }
    else {
      if (ch == "}") { out = out.concat("}}") } else { out = out.concat(ch) }
    }
    i = i + 1
  }
  return out
}

// `_v3_interp`: a `${..}` template as a Rust `format!`. A Float part routes
// through the canonical `revl_ftoa` (DEFERRED — such a part is excluded from the
// corpus, since it also pulls in the `revl_ftoa` helper the scaffold omits).
fn render_interp(node: Any, ctx: Ctx) -> Str {
  var fmt = []
  var args = []
  for (part of value_list(value_field(node, "parts"))) {
    let k = value_str(value_at(part, 0))
    let v = value_at(part, 1)
    if (k == "text") {
      fmt = fmt.push(escape_braces(value_str(v)))
    } else {
      fmt = fmt.push("{}")
      if (v3_is_float(v)) {
        args = args.push(`revl_ftoa(${render_expr(v, ctx)})`)
      } else {
        args = args.push(render_expr(v, ctx))
      }
    }
  }
  let joined = fmt.join("")
  if (args.length() == 0) { return `format!(${string_lit(joined)})` }
  return `format!(${string_lit(joined)}, ${args.join(", ")})`
}

// The kind dispatch, mirroring `_render_expr`'s branch order (post-widen).
fn render_inner(node: Any, ctx: Ctx) -> Str {
  let kind = node_kind(node)
  if (kind == "lit") { return rust_v3_lit(node) }
  if (kind == "name") {
    // A component capture (`self.pool`, `x_undo`) arrives via the rename map
    // already rendered; otherwise it is a plain identifier (`_ident(id)`).
    let idv = value_str(value_field(node, "id"))
    if (ctx.rn.has(idv)) { return map_get(ctx.rn, idv) }
    return mangle(idv)
  }
  if (kind == "var") { return render_var(node, ctx) }
  if (kind == "req") {
    // component dialect: a required capability, possibly a `self.`-capture.
    let orig = value_str(value_field(node, "name"))
    if (ctx.rn.has(orig)) { return map_get(ctx.rn, orig) }
    return mangle(orig)
  }
  if (kind == "config") {
    // component dialect: a config read. Inside a provide-method body the base
    // points at the captured struct field (`self.config`); at plug scope the
    // reconstructed local `config` is in scope, so the base is bare `config`.
    var base = "config"
    if (ctx.rn.has("config")) { base = map_get(ctx.rn, "config") }
    return `${base}.${mangle(value_str(value_field(node, "field")))}.clone()`
  }
  if (kind == "fn") {
    // component dialect: a free-function call `name(..)`, arguments by value.
    let fname = mangle(value_str(value_field(node, "name")))
    let anodes = value_list(value_field(node, "args"))
    var parts = []
    for (a of anodes) { parts = parts.push(by_value_arg(a, render_expr(a, ctx), ctx)) }
    return `${fname}(${parts.join(", ")})`
  }
  if (kind == "adt") {
    var aa = []
    for (a of value_list(value_field(node, "args"))) { aa = aa.push(render_expr(a, ctx)) }
    return constructor(ctx, value_str(value_field(node, "case")), aa)
  }
  if (kind == "bin") { return render_bin(node, ctx) }
  if (kind == "un") { return render_un(node, ctx) }
  if (kind == "call") { return render_call(node, ctx) }
  if (kind == "field") { return render_field(node, ctx) }
  if (kind == "record") { return render_record(node, ctx) }
  if (kind == "match") { return render_match(node, ctx) }
  if (kind == "index") { return render_index(node, ctx) }
  if (kind == "if") {
    return `if ${render_expr(value_field(node, "cond"), ctx)} { ${render_expr(value_field(node, "then"), ctx)} } else { ${render_expr(value_field(node, "else"), ctx)} }`
  }
  if (kind == "list") { return render_list(node, ctx) }
  if (kind == "maplit") { return "std::collections::HashMap::new()" }
  if (kind == "arrow") { return render_arrow(node, ctx) }
  if (kind == "len") {
    let target = render_expr(value_field(node, "target"), ctx)
    return `${target}.revl_length()`
  }
  if (kind == "builtin") { return render_builtin(node, ctx) }
  if (kind == "interp") { return render_interp(node, ctx) }
  return `<<UNSUPPORTED-EXPR:${kind}>>`
}

fn checked_div_expr(method: Str, target: Str, arg: Str) -> Str {
  var ok = "a / b"
  if (method == "checked_div_floor") { ok = "{ let q = a / b; if a % b != 0 && ((a < 0) != (b < 0)) { q - 1 } else { q } }" }
  if (method == "checked_div_euclid") { ok = "a.div_euclid(b)" }
  if (method == "checked_mod") { ok = "a.rem_euclid(b).abs()" }
  return `{ let a = (${target}); let b = (${arg}); if b == 0 { Err::<i64, String>("revl: division by zero".to_string()) } else { Ok::<i64, String>(${ok}) } }`
}

fn render_builtin(node: Any, ctx: Ctx) -> Str {
  let method = value_str(value_field(node, "method"))
  let target_node = value_field(node, "target")
  var target = render_expr(target_node, ctx)
  if (!is_atomic(node_kind(target_node))) { target = `(${target})` }
  let args = value_list(value_field(node, "args"))
  var rendered = []
  for (a of args) { rendered = rendered.push(render_expr(a, ctx)) }
  if (method == "checked_div_trunc" || method == "checked_div_floor" || method == "checked_div_euclid" || method == "checked_mod") {
    return checked_div_expr(method, target, rendered[0])
  }
  if (method == "to_str") { return `(${target}).to_string()` }
  if (method == "length") { return `${target}.revl_length()` }
  return `<<UNSUPPORTED-BUILTIN:${method}>>`
}

// The `widen` coercion markers (docs/arithmetic.md): render the conversion the
// reference makes visible, then dispatch the un-widened node.
fn render_expr(node: Any, ctx: Ctx) -> Str {
  let w = value_str(value_field(node, "widen"))
  if (w == "Float") { return `(${render_inner(node, ctx)} as f64)` }
  if (w == "Int") { return `(${render_inner(node, ctx)} as i64)` }
  return render_inner(node, ctx)
}

// -------------------------------------------------------------- statements
fn emit_stmts(nodes: List[Any], ctx: Ctx, indent: Int) -> Sout {
  var lines = []
  var c = ctx
  for (n of nodes) {
    let r = v3_stmt(n, c, indent)
    lines = lines.concat(r.lines)
    c = r.ctx
  }
  return { lines: lines, ctx: c }
}

// `_v3_stmt`: one fn-body step -> its emitted (indented) lines and threaded ctx.
fn v3_stmt(node: Any, ctx: Ctx, indent: Int) -> Sout {
  let step = value_str(value_field(node, "step"))
  if (step == "let" || step == "assign") {
    let raw = value_str(value_field(node, "name"))
    let nm = mangle(raw)
    let valnode = value_field(node, "value")
    let inferred = v3_infer_type(valnode, ctx)
    let value = render_expr(valnode, ctx)
    var nctx = ctx
    if (inferred != "") { nctx = set_vt(ctx, raw, inferred) }
    var out = []
    if (step == "let") {
      var kw = "let"
      if (value_bool(value_field(node, "mutable"))) { kw = "let mut" }
      out = out.push(line(indent, `${kw} ${nm} = ${value};`))
    } else {
      // item 437(a): a self-appending `assign` (`s = s + p`) becomes an
      // in-place `push_str`. Only an `assign` qualifies -- a `let` introduces a
      // NEW binding, so its RHS receiver is a different value that stays live.
      let ip = self_append_plus(raw, nm, valnode, ctx)
      if (ip != "") { out = out.push(line(indent, ip)) }
      else { out = out.push(line(indent, `${nm} = ${value};`)) }
    }
    return { lines: out, ctx: nctx }
  }
  if (step == "return") {
    let e = value_field(node, "expr")
    var out = []
    if (value_is_null(e)) { out = out.push(line(indent, "return;")) }
    else { out = out.push(line(indent, `return ${render_expr(e, ctx)};`)) }
    return { lines: out, ctx: ctx }
  }
  if (step == "if") {
    var out = [line(indent, `if ${render_expr(value_field(node, "cond"), ctx)} {`)]
    let thenR = emit_stmts(value_list(value_field(node, "then")), ctx, indent + 1)
    out = out.concat(thenR.lines)
    var c = thenR.ctx
    let els = value_list(value_field(node, "else"))
    if (els.length() > 0) {
      out = out.push(line(indent, "} else {"))
      let elseR = emit_stmts(els, c, indent + 1)
      out = out.concat(elseR.lines)
      c = elseR.ctx
    }
    out = out.push(line(indent, "}"))
    return { lines: out, ctx: c }
  }
  if (step == "while") {
    var out = [line(indent, `while ${render_expr(value_field(node, "cond"), ctx)} {`)]
    let bodyR = emit_stmts(value_list(value_field(node, "body")), ctx, indent + 1)
    out = out.concat(bodyR.lines)
    out = out.push(line(indent, "}"))
    return { lines: out, ctx: bodyR.ctx }
  }
  if (step == "for") {
    let bind = mangle(value_str(value_field(node, "bind")))
    var out = [line(indent, `for ${bind} in ${render_expr(value_field(node, "iterable"), ctx)} {`)]
    let bodyR = emit_stmts(value_list(value_field(node, "body")), ctx, indent + 1)
    out = out.concat(bodyR.lines)
    out = out.push(line(indent, "}"))
    return { lines: out, ctx: bodyR.ctx }
  }
  if (step == "expr") {
    return { lines: [line(indent, `let _ = ${render_expr(value_field(node, "expr"), ctx)};`)], ctx: ctx }
  }
  if (step == "assert") {
    return { lines: [line(indent, `assert!(${render_expr(value_field(node, "expr"), ctx)});`)], ctx: ctx }
  }
  // item 379 / 391: bare loop control -> the host keyword (frame-neutral).
  if (step == "break") { return { lines: [line(indent, "break;")], ctx: ctx } }
  if (step == "continue") { return { lines: [line(indent, "continue;")], ctx: ctx } }
  return { lines: [line(indent, `<<UNSUPPORTED-STEP:${step}>>`)], ctx: ctx }
}

// `_emit_v3_functions`: each module fn as a Rust `fn`, blank-line separated. The
// per-fn `var_types` is seeded from the parameter signatures (the reference's
// `ctx.var_types = {p.name: p.type ..}`).
fn emit_v3_functions(functions: List[Any], fr: Map[Str, Str], tables: TypeTables) -> List[Str] {
  var out = []
  for (fnode of functions) {
    let name = mangle(value_str(value_field(fnode, "name")))
    let params = value_list(value_field(fnode, "params"))
    var vt: Map[Str, Str] = Map.empty()
    for (p of params) { vt = vt.set(value_str(value_field(p, "name")), value_str(value_field(p, "type"))) }
    let ctx = { vt: vt, fr: fr, ca: tables.ca, cp: tables.cp, rbf: tables.rbf, rn: Map.empty() }
    var ps = []
    for (p of params) {
      ps = ps.push(`${mangle(value_str(value_field(p, "name")))}: ${rust_type_pos(value_field(p, "type"), tables.tn)}`)
    }
    let returns = rust_type_pos(value_field(fnode, "returns"), tables.tn)
    var vis = ""
    if (value_bool(value_field(fnode, "public"))) { vis = "pub " }
    out = out.push(`${vis}fn ${name}(${ps.join(", ")}) -> ${returns} {`)
    let body = value_list(value_field(fnode, "body"))
    if (body.length() == 0) {
      out = out.push(line(1, "todo!()"))
    } else {
      let r = emit_stmts(body, ctx, 1)
      out = out.concat(r.lines)
    }
    out = out.push("}")
    out = out.push("")
  }
  return out
}

// `_emit_v3_types`: user `type` decls as Rust items. A record is a `pub struct`
// (nominal, so `{a:1} == {a:1}` compiles — the `PartialEq` derive is load-bearing,
// not decoration); a variant is a serde-tagged `pub enum`. Each item is followed
// by a blank line, exactly as the reference does.
fn emit_v3_types(types: Any, tnames: Map[Str, Str]) -> List[Str] {
  var out = []
  for (name of value_keys(types)) {
    let spec = value_field(types, name)
    let kind = value_str(value_field(spec, "kind"))
    let nm = mangle(name)
    if (kind == "record") {
      out = out.push("#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]")
      out = out.push(`pub struct ${nm} {`)
      let fields = value_field(spec, "fields")
      for (field of value_keys(fields)) {
        out = out.push(`    ${mangle(field)}: ${rust_type_t(value_field(fields, field), tnames)},`)
      }
      out = out.push("}")
    } else {
      if (kind == "variant") {
        out = out.push("#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]")
        out = out.push(`#[serde(tag = "$kind", content = "$value")]`)
        out = out.push(`pub enum ${nm} {`)
        for (case of value_list(value_field(spec, "cases"))) {
          let cname = mangle(value_str(value_field(case, "name")))
          let payload = value_field(case, "payload")
          if (value_is_null(payload)) { out = out.push(`    ${cname},`) }
          else { out = out.push(`    ${cname}(${rust_type_t(payload, tnames)}),`) }
        }
        out = out.push("}")
      } else {
        out = out.push(`<<UNSUPPORTED-TYPE:${kind}>>`)
      }
    }
    out = out.push("")
  }
  return out
}

// ==================================================================== externs
// `_emit_v3_externs`: each `extern` as a Rust `fn` carrying its verbatim `@rs`
// body, blank-line separated, in declaration order and BEFORE the free
// functions (the reference's `_emit_v3` section order: types, externs,
// functions). Issue 275: this section used to be missing entirely — the
// self-host emitted a call to `shout(..)` with no `fn shout` anywhere, silently,
// and the byte-agreement oracle stayed GREEN because no corpus fixture declared
// an extern (item 429's trap: an oracle catches DIVERGENCE, not ABSENCE).
//
// Two reference shapes are OUT of this slice and take a LOUD marker rather than
// a guess, so a fixture that reaches one diverges visibly instead of shipping
// wrong Rust: an extern with no `@rs` body (the reference RAISES — a portability
// boundary, not a silent skip), and an extern carrying a `config` schema (item
// 378 Stage 5: the reference prepends the `_revl_extern_config` scaffold and
// binds `_revl_config` as the first body line). The body splice itself is
// LF-only: the reference splits with Python `splitlines()`, which also breaks on
// CR and on the Unicode separators, so a body carrying one of those takes the
// marker too rather than splitting differently.

// Every code point Python `str.splitlines()` breaks on that a plain
// `split("\n")` does not: VT, FF, CR, the three file/group/record separators,
// NEL, and the two Unicode line/paragraph separators.
fn is_extra_linebreak(code: Int) -> Bool {
  if (code >= 11 && code <= 13) { return true }
  if (code >= 28 && code <= 30) { return true }
  if (code == 133) { return true }
  return code == 8232 || code == 8233
}

fn has_extra_linebreak(s: Str) -> Bool {
  let n = s.length()
  var i = 0
  while (i < n) {
    if (is_extra_linebreak(s.charCodeAt(i))) { return true }
    i = i + 1
  }
  return false
}

// The out-of-slice reason for this extern, or "" when it is in-slice.
fn extern_body_defer(ext: Any, body: Str) -> Str {
  if (!value_is_null(value_field(ext, "config"))) { return "config" }
  if (has_extra_linebreak(body)) { return "linebreak" }
  return ""
}

fn emit_v3_externs(externs: List[Any], tnames: Map[Str, Str]) -> List[Str] {
  var out = []
  for (ext of externs) {
    let name = mangle(value_str(value_field(ext, "name")))
    var ps = []
    for (p of value_list(value_field(ext, "params"))) {
      ps = ps.push(`${mangle(value_str(value_field(p, "name")))}: ${rust_type_pos(value_field(p, "type"), tnames)}`)
    }
    let returns = rust_type_pos(value_field(ext, "returns"), tnames)
    let rs_body = value_field(value_field(ext, "bodies"), "rs")
    if (value_is_null(rs_body)) {
      // The reference RAISES here (`extern ... has no @rs body`). This slice has
      // no refusal channel, so the marker stands in — loud, never silent.
      out = out.push(`<<EXTERN-NO-RS-BODY:${name}>>`)
      out = out.push("")
    } else {
      let body = trim(value_str(rs_body))
      let defer = extern_body_defer(ext, body)
      if (defer != "") {
        out = out.push(`<<DEFER-EXTERN-${defer}:${name}>>`)
        out = out.push("")
      } else {
        out = out.push(`fn ${name}(${ps.join(", ")}) -> ${returns} {`)
        if (body == "") {
          out = out.push(line(1, "// (empty @rs body)"))
        } else {
          for (bl of body.split(newline())) { out = out.push(ind(1).concat(bl)) }
        }
        out = out.push("}")
        out = out.push("")
      }
    }
  }
  return out
}

// ============================================================ components/services
// The COMPONENT/SERVICE surface (roadmap item 207): a `service` trait, the
// `_emit_component` SIMPLE provider path (no isolate/intercept/effect), and the
// `_emit_bridge` Value/serde ERASURE block. `_emit_components` fires this the
// moment `ir["services"]`/`ir["components"]` is non-empty — a lone service alone
// forces the whole bridge — so traits + provider + bridge port as ONE unit.
//
// DEFERRED here (each REPORTED, and each fires a `<<DEFER-*>>` marker that keeps
// a byte diff loud rather than silently wrong): the host-object stubs
// (`Map`/`Pool`/`Job`) and every preamble helper (timer/stdlib/float/realm/
// spawn) — none appear in the covered subset, so `_emit_host_stubs` and the
// preamble contribute nothing; the effectful/isolate/intercept component path
// (`_emit_component_new`, effect/undo, config, timers, routers, await/spawn);
// component `config`; required services (`req`/routes/Inject gate); realm
// placements; and the non-scalar bridge marshalling (Result/serde/`Vec<Value>`/
// opaque-`Value` params and returns) beyond the scalar + scalar-`Option` + `()`
// core. A service method whose params/returns stay scalar is fully byte-exact.

// `_emit_service_traits`: each `service` -> a `pub trait S: Send + Sync` with one
// `&self` method per op. Param names are `_ident`ed (mangle); a param/return
// type lowers through `rust_type_t`; a `()` return when the op declares none.
fn emit_service_traits(services: Any, tnames: Map[Str, Str]) -> List[Str] {
  var out = []
  for (sname of value_keys(services)) {
    let srv = value_field(services, sname)
    out = out.push(`pub trait ${sname}: Send + Sync {`)
    let methods = value_field(srv, "methods")
    for (mn of value_keys(methods)) {
      let method = value_field(methods, mn)
      var ps = []
      for (p of value_list(value_field(method, "params"))) {
        ps = ps.push(`${mangle(value_str(value_field(p, "name")))}: ${rust_type_t(value_field(p, "type"), tnames)}`)
      }
      var ret = "()"
      let r = value_field(method, "returns")
      if (!value_is_null(r)) { ret = rust_type_t(r, tnames) }
      if (value_bool(value_field(method, "emission"))) {
        out = out.push("    /// emission: crosses the system boundary (DESIGN.md §3.5)")
      }
      if (value_bool(value_field(method, "idempotent"))) {
        out = out.push("    /// idempotent: safe to re-deliver — the runtime may auto-retry a transient failure (item 44)")
      }
      out = out.push(`    fn ${mn}(&self, ${ps.join(", ")}) -> ${ret};`)
    }
    out = out.push("}")
    out = out.push("")
  }
  return out
}

// `_emit_host_stubs`: DEFERRED. The reference emits `Map`/`Pool`/`Job` stubs and
// an R1 live-resource counter only when the document USES a `host` object (or a
// lifecycle test / timer). The covered subset declares none, so this is [] —
// exactly what the reference returns for a host-object-free document.
fn emit_host_stubs(ir: Any) -> List[Str] { return [] }

// The provide-step methods for a provision `key` (`_provision_methods`): the
// `provide` body step whose `name` matches, else `[]`.
fn provide_methods(body: List[Any], key: Str) -> List[Any] {
  for (s of body) {
    if (value_str(value_field(s, "step")) == "provide" && value_str(value_field(s, "name")) == key) {
      return value_list(value_field(s, "methods"))
    }
  }
  return []
}

// A provision method's declared param type, looked up in the SERVICE signature
// (the provide body carries only names): `_param_type`. Missing -> "Value".
fn service_param_type(svc_method: Any, pname: Str) -> Any {
  for (mp of value_list(value_field(svc_method, "params"))) {
    if (value_str(value_field(mp, "name")) == pname) { return value_field(mp, "type") }
  }
  return "Value"
}

// `_pure_method_statements`: a pure provide-method body, RENAME-aware (item 218).
// A lone `return <expr>` inlines to just the expression; otherwise let/assign/
// return statements join with a space. `ctx.rn` carries the capture scope
// (`config` -> `self.config`, a required key -> `self.<key>`), so the SIMPLE
// path passes an empty `rn` (unchanged from slices 1-3) and the effectful path's
// pure methods pass `_method_scope_rename`. A `let` that shadows an outer capture
// re-points its name at the plain identifier (`rename.pop(name)` in the
// reference), so a later use of the local is not mis-rendered as the capture.
fn pure_method_statements(method: Any, ctx: Ctx) -> Str {
  let steps = value_list(value_field(method, "body"))
  if (steps.length() == 1) {
    let s0 = steps[0]
    if (value_str(value_field(s0, "step")) == "return" && !value_is_null(value_field(s0, "expr"))) {
      return render_expr(value_field(s0, "expr"), ctx)
    }
  }
  var parts = []
  var c = ctx
  for (step of steps) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "let") {
      let nm = value_str(value_field(step, "name"))
      let cshadow = set_rn(c, c.rn.set(nm, mangle(nm)))
      var mut = ""
      if (value_bool(value_field(step, "mutable"))) { mut = "mut " }
      parts = parts.push(`let ${mut}${mangle(nm)} = ${render_expr(value_field(step, "value"), cshadow)};`)
      c = cshadow
    } else {
      if (kind == "assign") {
        parts = parts.push(`${mangle(value_str(value_field(step, "name")))} = ${render_expr(value_field(step, "value"), c)};`)
      } else {
        if (kind == "return") {
          let e = value_field(step, "expr")
          if (value_is_null(e)) { parts = parts.push("return;") }
          else { parts = parts.push(`return ${render_expr(e, c)};`) }
        } else {
          parts = parts.push(`<<DEFER-method-step:${kind}>>`)
        }
      }
    }
  }
  return parts.join(" ")
}

// ------------------------------------------------------------ config (item 218)
// `_binds`: the `let-effect` bind names (host acquisitions). Host bindings
// themselves are DEFERRED; this only reports their names so a component that
// declares one surfaces a `<<DEFER-bind-field>>` marker rather than silently
// dropping a struct field.
fn binds(comp: Any) -> List[Str] {
  var out = []
  for (s of value_list(value_field(comp, "body"))) {
    if (value_str(value_field(s, "step")) == "let-effect") { out = out.push(value_str(value_field(s, "bind"))) }
  }
  return out
}
fn has_config(comp: Any) -> Bool { return value_list(value_field(comp, "config")).length() > 0 }

// `_references_config`: does this IR subtree read component config (a `config`
// expression node)? The generic recursion driver is `value_children`.
fn references_config(node: Any) -> Bool {
  let k = value_kind(node)
  if (k == "record") {
    if (value_str(value_field(node, "kind")) == "config") { return true }
  }
  for (child of value_children(node)) { if (references_config(child)) { return true } }
  return false
}

// `_provision_uses_config`: does provision `key`'s method surface read config?
// Only then does its provide struct capture config (item 218 note).
fn provision_uses_config(comp: Any, key: Str) -> Bool {
  if (!has_config(comp)) { return false }
  for (m of provide_methods(value_list(value_field(comp, "body")), key)) {
    if (references_config(m)) { return true }
  }
  return false
}
fn component_provide_uses_config(comp: Any) -> Bool {
  if (!has_config(comp)) { return false }
  for (key of value_keys(value_field(comp, "provides"))) {
    if (provision_uses_config(comp, key)) { return true }
  }
  return false
}
// The provide-struct field / construction fragments capturing component config.
fn config_struct_field(comp: Any, key: Str) -> List[Str] {
  if (!provision_uses_config(comp, key)) { return [] }
  return [`    config: ${mangle(value_str(value_field(comp, "name")))}Config,`]
}
fn config_ctor_field(comp: Any, key: Str) -> List[Str] {
  if (!provision_uses_config(comp, key)) { return [] }
  return ["config: __revl_provide_config.clone()"]
}
fn emit_provide_config_local(comp: Any, indent: Int) -> List[Str] {
  if (!component_provide_uses_config(comp)) { return [] }
  return [line(indent, "let __revl_provide_config = config.clone();")]
}

// `_default_for_rust_type` / `_config_default_lit`: an IR config default (or a
// type fallback) as a Rust expression.
fn default_for_rust_type(ftype: Str) -> Str {
  if (ftype == "String") { return "String::new()" }
  if (ftype == "i64") { return "0i64" }
  if (ftype == "i32") { return "0i32" }
  if (ftype == "f64") { return "0f64" }
  if (ftype == "bool") { return "false" }
  if (ftype == "Vec<u8>") { return "Vec::new()" }
  if (ftype == "()") { return "()" }
  return "Default::default()"
}
fn config_default_lit(dv: Any, ftype: Str) -> Str {
  let k = value_kind(dv)
  if (k == "null") { return default_for_rust_type(ftype) }
  if (k == "bool") { if (value_bool(dv)) { return "true" } return "false" }
  if (k == "str") { return `String::from(${string_lit(dv)})` }
  if (k == "int") { return `${num_str(dv)}i64` }
  if (k == "float") { return `${num_str(dv)}f64` }
  return "<<UNSUPPORTED-CONFIG-DEFAULT>>"
}
// The `<Comp>Config` type to pass to `plugin_sync` (`()` when configless), and
// the `#[derive(Clone)] struct <Comp>Config { .. }` + `Default` item lines.
fn config_ty(comp: Any) -> Str {
  if (!has_config(comp)) { return "()" }
  return `${mangle(value_str(value_field(comp, "name")))}Config`
}
fn emit_config_struct_lines(comp: Any) -> List[Str] {
  let fields = value_list(value_field(comp, "config"))
  if (fields.length() == 0) { return [] }
  let cname = mangle(value_str(value_field(comp, "name")))
  var out = []
  out = out.push("#[derive(Clone)]")
  out = out.push(`struct ${cname}Config {`)
  for (field of fields) {
    out = out.push(`    ${mangle(value_str(value_field(field, "name")))}: ${rust_type(value_field(field, "type"))},`)
  }
  out = out.push("}")
  out = out.push("")
  out = out.push(`impl Default for ${cname}Config {`)
  out = out.push("    fn default() -> Self {")
  out = out.push("        Self {")
  for (field of fields) {
    let fname = mangle(value_str(value_field(field, "name")))
    let ftype = rust_type(value_field(field, "type"))
    out = out.push(`            ${fname}: ${config_default_lit(value_field(field, "default"), ftype)},`)
  }
  out = out.push("        }")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")
  return out
}
// `_emit_config_application`: reconstruct the plugin config locally from the
// handed `Arc<CompConfig>` fields plus `..Default::default()`.
fn emit_config_application(comp: Any, cty: Str, indent: Int) -> List[Str] {
  if (cty == "()") { return [] }
  let pad = ind(indent)
  var out = [`${pad}let config = ${cty} {`]
  for (field of value_list(value_field(comp, "config"))) {
    let fname = mangle(value_str(value_field(field, "name")))
    out = out.push(`${pad}    ${fname}: config.${fname}.clone(),`)
  }
  out = out.push(`${pad}    ..Default::default()`)
  out = out.push(`${pad}};`)
  return out
}

// ------------------------------------------------- requires / gate (item 218)
// `_rust_inject`: the `Inject` gate over the required keys. Routes are DEFERRED
// (no routed key enters the subset), so every requirement is gated.
fn rust_inject(reqs: List[Str]) -> Str {
  if (reqs.length() == 0) { return "Inject::none()" }
  var parts = []
  for (r of reqs) { parts = parts.push(string_lit(r)) }
  return `Inject::new([${parts.join(", ")}])`
}
// `_emit_req_bindings`: bind each required service through the Inject gate
// (`ctx.require::<Box<dyn S>>("key")?`). Routed keys are DEFERRED.
fn emit_req_bindings(reqs: Any, indent: Int) -> List[Str] {
  let pad = ind(indent)
  var out = []
  for (local of value_keys(reqs)) {
    let svc = value_str(value_field(reqs, local))
    out = out.push(`${pad}let ${local} = ctx.require::<Box<dyn ${svc}>>(${string_lit(local)})?;`)
  }
  return out
}

// -------------------------------------------- effectful method body (item 218)
fn component_has_effectful_methods(comp: Any) -> Bool {
  for (step of value_list(value_field(comp, "body"))) {
    if (value_str(value_field(step, "step")) == "provide") {
      for (method of value_list(value_field(step, "methods"))) {
        for (bs of value_list(value_field(method, "body"))) {
          let k = value_str(value_field(bs, "step"))
          if (k == "effect" || k == "emit") { return true }
        }
      }
    }
  }
  return false
}
fn method_has_effectful_steps(method: Any) -> Bool {
  for (bs of value_list(value_field(method, "body"))) {
    let k = value_str(value_field(bs, "step"))
    if (k == "effect" || k == "emit") { return true }
  }
  return false
}
fn component_uses_await(comp: Any) -> Bool {
  for (step of value_list(value_field(comp, "body"))) {
    if (value_str(value_field(step, "step")) == "await") { return true }
  }
  return false
}
// The capture rename maps: a provide-method reads binds/reqs/config off `self`;
// an undo closure re-reads pre-cloned `<name>_undo` copies.
fn method_scope_rename(comp: Any) -> Map[Str, Str] {
  var rn: Map[Str, Str] = Map.empty()
  for (b of binds(comp)) { rn = rn.set(b, `self.${b}`) }
  for (req of value_keys(value_field(comp, "requires"))) { rn = rn.set(req, `self.${req}`) }
  if (has_config(comp)) { rn = rn.set("config", "self.config") }
  return rn
}
fn method_undo_rename(comp: Any, method: Any) -> Map[Str, Str] {
  var rn: Map[Str, Str] = Map.empty()
  for (b of binds(comp)) { rn = rn.set(b, `${b}_undo`) }
  for (req of value_keys(value_field(comp, "requires"))) { rn = rn.set(req, `${req}_undo`) }
  for (p of value_list(value_field(method, "params"))) { let pn = value_str(p) rn = rn.set(pn, `${pn}_undo`) }
  return rn
}
fn method_undo_clones(comp: Any, method: Any, indent: Int) -> List[Str] {
  let pad = ind(indent)
  var out = []
  for (b of binds(comp)) { out = out.push(`${pad}let ${b}_undo = self.${b}.clone();`) }
  for (req of value_keys(value_field(comp, "requires"))) { out = out.push(`${pad}let ${req}_undo = self.${req}.clone();`) }
  for (p of value_list(value_field(method, "params"))) { let pn = value_str(p) out = out.push(`${pad}let ${pn}_undo = ${pn}.clone();`) }
  return out
}
// `_provide_let_type`: `_v3_infer_type` extended with the one source that only
// exists in a provide body — a required-service method call's declared return
// (`let answer = model.complete(seed)`), so a later by-value use of the local
// clones instead of moving it. "" when no type is certain.
fn provide_let_type(value: Any, ctx: Ctx, comp: Any, services: Any) -> Str {
  let inferred = v3_infer_type(value, ctx)
  if (inferred != "") { return inferred }
  if (node_kind(value) == "call" && value_is_null(value_field(value, "callee"))) {
    let target = value_field(value, "target")
    if (node_kind(target) == "req") {
      let svc = map_get(reqs_map(comp), value_str(value_field(target, "name")))
      if (svc != "" && !value_is_null(value_field(services, svc))) {
        let sm = value_field(value_field(value_field(services, svc), "methods"), value_str(value_field(value, "method")))
        let r = value_field(sm, "returns")
        if (!value_is_null(r)) { return value_str(r) }
      }
    }
  }
  return ""
}
// The `requires` map as Str->Str (key -> service name).
fn reqs_map(comp: Any) -> Map[Str, Str] {
  var m: Map[Str, Str] = Map.empty()
  let rq = value_field(comp, "requires")
  for (k of value_keys(rq)) { m = m.set(k, value_str(value_field(rq, k))) }
  return m
}

// `_method_body_lines`: lower effect/emit/return/let/assign steps in an
// effectful provide-method body. Effect registration is fire-and-forget through
// `self.ctx.effect(..)`. The host-Map reclone (item 114) is DEFERRED — the
// subset declares no host `Map`, so `_undo_reclone_locals` is always empty.
// Returns the lines AND the threaded ctx (its `vt` carries let-inferred types).
fn method_body_lines(comp: Any, method: Any, services: Any, ctx: Ctx, indent: Int) -> Sout {
  let pad = ind(indent)
  let name = value_str(value_field(comp, "name"))
  let mnm = value_str(value_field(method, "name"))
  let scope = method_scope_rename(comp)
  var c = set_rn(ctx, scope)
  var out = []
  var index = 0
  for (step of value_list(value_field(method, "body"))) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "return") {
      let e = value_field(step, "expr")
      if (value_is_null(e)) { out = out.push(`${pad}return;`) }
      else { out = out.push(`${pad}return ${render_expr(e, c)};`) }
    } else {
      if (kind == "effect" || kind == "emit") {
        let undoR = method_undo_rename(comp, method)
        var acqR = scope
        for (p of value_list(value_field(method, "params"))) { let pn = value_str(p) acqR = acqR.set(pn, `${pn}.clone()`) }
        let label = string_lit(`${name}.${mnm}.${kind}.${num_str(index)}`)
        var registers_undo = kind == "effect"
        var undonode: Any = value_field(step, "undo")
        if (kind == "emit") {
          undonode = value_field(step, "compensate")
          if (!value_is_null(undonode)) { registers_undo = true }
        }
        var acqnode = value_field(step, "acquire")
        if (value_is_null(acqnode)) { acqnode = value_field(step, "expr") }
        if (registers_undo) {
          out = out.concat(method_undo_clones(comp, method, indent))
          // host-Map reclone (item 114): DEFERRED — no host Map in subset.
        }
        let acq = render_expr(acqnode, set_rn(c, acqR))
        out = out.push(`${pad}let _ = ${acq};`)
        if (registers_undo) {
          let undox = render_expr(undonode, set_rn(c, undoR))
          out = out.push(`${pad}let _ = self.ctx.effect(${label}, move || { ${undox}; Ok(()) });`)
        }
      } else {
        if (kind == "let" || kind == "assign") {
          let nm = value_str(value_field(step, "name"))
          let inferred = provide_let_type(value_field(step, "value"), c, comp, services)
          if (kind == "let") {
            let cshadow = set_rn(c, c.rn.set(nm, mangle(nm)))
            var mut = ""
            if (value_bool(value_field(step, "mutable"))) { mut = "mut " }
            out = out.push(`${pad}let ${mut}${mangle(nm)} = ${render_expr(value_field(step, "value"), cshadow)};`)
            c = cshadow
          } else {
            out = out.push(`${pad}${mangle(nm)} = ${render_expr(value_field(step, "value"), c)};`)
          }
          if (inferred != "") { c = set_vt(c, nm, inferred) }
        } else {
          out = out.push(`${pad}<<DEFER-method-step:${kind}>>`)
        }
      }
    }
    index = index + 1
  }
  return { lines: out, ctx: c }
}

// The function-return table shared by both component paths (a `let` bound to a
// free-function call is typed by its declared return).
fn fr_map(ir: Any) -> Map[Str, Str] {
  var fr: Map[Str, Str] = Map.empty()
  for (fnode of value_list(value_field(ir, "functions"))) {
    let r = value_field(fnode, "returns")
    if (!value_is_null(r)) { fr = fr.set(value_str(value_field(fnode, "name")), value_str(r)) }
  }
  return fr
}

// One provider struct's impl-methods (shared by the simple + effectful paths).
// `use_mname` selects the `_mname` (`drop`->`drop_`) rename the effectful path
// applies to method names; the simple path names them raw (mirrors the two
// reference sites exactly). `effectful` gives the effectful body renderer +
// the `self.ctx` field capture.
fn emit_provide_methods(comp: Any, services: Any, key: Str, srv: Str, tables: TypeTables, fr: Map[Str, Str], effectful: Bool, use_mname: Bool) -> List[Str] {
  let body = value_list(value_field(comp, "body"))
  let svc_methods = value_field(value_field(services, srv), "methods")
  var out = []
  for (method of provide_methods(body, key)) {
    let orig = value_str(value_field(method, "name"))
    var mn = mangle(orig)
    if (use_mname) { mn = mangle(mname(orig)) }
    let svc_method = value_field(svc_methods, orig)
    var ps = []
    var vt: Map[Str, Str] = Map.empty()
    for (pn of value_list(value_field(method, "params"))) {
      let pname = value_str(pn)
      let ptype = service_param_type(svc_method, pname)
      ps = ps.push(`${pname}: ${rust_type_t(ptype, tables.tn)}`)
      vt = vt.set(pname, value_str(ptype))
    }
    var ret = "()"
    let r = value_field(svc_method, "returns")
    if (!value_is_null(r)) { ret = rust_type_t(r, tables.tn) }
    let ctx = { vt: vt, fr: fr, ca: tables.ca, cp: tables.cp, rbf: tables.rbf, rn: Map.empty() }
    if (effectful && method_has_effectful_steps(method)) {
      out = out.push(`    fn ${mn}(&self, ${ps.join(", ")}) -> ${ret} {`)
      let bl = method_body_lines(comp, method, services, ctx, 2)
      out = out.concat(bl.lines)
      out = out.push("    }")
    } else {
      let ctxr = set_rn(ctx, method_scope_rename(comp))
      out = out.push(`    fn ${mn}(&self, ${ps.join(", ")}) -> ${ret} { ${pure_method_statements(method, ctxr)} }`)
    }
  }
  return out
}

// The plug-time provide-step construction shared by both paths: `let key_box =
// Box::new(<Struct> { <binds>, <reqs>, <config>, [ctx] }); ctx.provide(..)?;`.
fn emit_provide_construction(comp: Any, step: Any, effectful: Bool, indent: Int) -> List[Str] {
  let pad = ind(indent)
  let name = value_str(value_field(comp, "name"))
  let key = value_str(value_field(step, "name"))
  let svc = value_str(value_field(step, "service"))
  let struct = `${name}${camel(key)}`
  var fields = []
  for (b of binds(comp)) { fields = fields.push(`${mangle(b)}: ${b}.clone()`) }
  for (local of value_keys(value_field(comp, "requires"))) { fields = fields.push(`${local}: ${local}.clone()`) }
  fields = fields.concat(config_ctor_field(comp, key))
  if (effectful) { fields = fields.push("ctx: Arc::new(ctx.clone())") }
  var out = []
  out = out.push(`${pad}let ${key}_box: Box<dyn ${svc}> = Box::new(${struct} { ${fields.join(", ")} });`)
  out = out.push(`${pad}ctx.provide(${string_lit(key)}, ${key}_box)?;`)
  return out
}

// `_emit_component` (the SIMPLE provider path): a component with NO isolate /
// intercept and NO effectful (`effect`/`emit`) method — but it MAY carry config
// and required services (item 218). The provider struct captures each required
// service and the config (when a method reads it); the methods are pure and read
// captures off `self`; the closure applies config, binds each require through
// the Inject gate, and provisions each key. Host binds / routes / body-level
// effect steps are DEFERRED (a `<<DEFER-*>>` marker keeps them loud).
fn emit_component(comp: Any, services: Any, ir: Any) -> List[Str] {
  let name = value_str(value_field(comp, "name"))
  let cname = mangle(name)
  let snk = snake(name)
  let tables = build_type_tables(value_field(ir, "types"))
  let fr = fr_map(ir)
  let provs = value_field(comp, "provides")
  let reqs = value_field(comp, "requires")
  let body = value_list(value_field(comp, "body"))
  let cty = config_ty(comp)
  var out = emit_config_struct_lines(comp)
  for (key of value_keys(provs)) {
    let srv = value_str(value_field(provs, key))
    let struct = `${cname}${camel(key)}`
    out = out.push(`struct ${struct} {`)
    for (b of binds(comp)) { out = out.push(`<<DEFER-bind-field:${b}>>`) }
    for (local of value_keys(reqs)) { out = out.push(`    ${local}: Arc<Box<dyn ${value_str(value_field(reqs, local))}>>,`) }
    out = out.concat(config_struct_field(comp, key))
    out = out.push("}")
    out = out.push(`impl ${srv} for ${struct} {`)
    out = out.concat(emit_provide_methods(comp, services, key, srv, tables, fr, false, false))
    out = out.push("}")
    out = out.push("")
  }
  out = out.push(`pub fn ${snk}() -> cordis::PluginHandle {`)
  out = out.push(`    cordis::plugin_sync::<${cty}, _>(`)
  out = out.push(`        ${string_lit(name)},`)
  out = out.push(`        cordis::${rust_inject(value_keys(reqs))},`)
  out = out.push("        |ctx, config| {")
  out = out.concat(emit_config_application(comp, cty, 3))
  out = out.concat(emit_provide_config_local(comp, 3))
  out = out.concat(emit_req_bindings(reqs, 3))
  for (step of body) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "provide") {
      out = out.concat(emit_provide_construction(comp, step, false, 3))
    } else {
      out = out.push(`<<DEFER-comp-step:${kind}>>`)
    }
  }
  out = out.push("            Ok(cordis::PluginOutput::none())")
  out = out.push("        },")
  out = out.push("    )")
  out = out.push("}")
  out = out.push("")
  return out
}

// `_emit_component_new` (SUBSET): a component whose provide methods carry
// `effect`/`emit` steps (item 218). Adds the `ctx: Arc<cordis::Context>` field
// (so effect registration is fire-and-forget), renders effectful bodies through
// `method_body_lines`, and constructs the provider with `ctx: Arc::new(..)`.
// DEFERRED (each loud): isolate/intercept, routers, await/spawn, host binds,
// and body-level effect/timer steps — none in the covered subset.
fn emit_component_new(comp: Any, services: Any, ir: Any) -> List[Str] {
  let name = value_str(value_field(comp, "name"))
  let cname = mangle(name)
  let snk = snake(name)
  let tables = build_type_tables(value_field(ir, "types"))
  let fr = fr_map(ir)
  let provs = value_field(comp, "provides")
  let reqs = value_field(comp, "requires")
  let body = value_list(value_field(comp, "body"))
  let cty = config_ty(comp)
  var out = emit_config_struct_lines(comp)
  if (value_keys(value_field(comp, "isolate")).length() > 0) { out = out.push(`<<DEFER-isolate:${name}>>`) }
  if (value_keys(value_field(comp, "intercept")).length() > 0) { out = out.push(`<<DEFER-intercept:${name}>>`) }
  if (component_uses_await(comp)) { out = out.push(`<<DEFER-await:${name}>>`) }
  for (key of value_keys(provs)) {
    let srv = value_str(value_field(provs, key))
    let struct = `${cname}${camel(key)}`
    out = out.push(`struct ${struct} {`)
    for (b of binds(comp)) { out = out.push(`<<DEFER-bind-field:${b}>>`) }
    for (local of value_keys(reqs)) { out = out.push(`    ${local}: Arc<Box<dyn ${value_str(value_field(reqs, local))}>>,`) }
    out = out.concat(config_struct_field(comp, key))
    out = out.push("    ctx: Arc<cordis::Context>,")
    out = out.push("}")
    out = out.push(`impl ${srv} for ${struct} {`)
    out = out.concat(emit_provide_methods(comp, services, key, srv, tables, fr, true, true))
    out = out.push("}")
    out = out.push("")
  }
  out = out.push(`pub fn ${snk}() -> cordis::PluginHandle {`)
  out = out.push(`    cordis::plugin_sync::<${cty}, _>(`)
  out = out.push(`        ${string_lit(name)},`)
  out = out.push(`        cordis::${rust_inject(value_keys(reqs))},`)
  out = out.push("        |ctx, config| {")
  out = out.concat(emit_config_application(comp, cty, 3))
  out = out.concat(emit_provide_config_local(comp, 3))
  out = out.concat(emit_req_bindings(reqs, 3))
  for (step of body) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "provide") {
      out = out.concat(emit_provide_construction(comp, step, true, 3))
    } else {
      out = out.push(`<<DEFER-comp-step:${kind}>>`)
    }
  }
  out = out.push("            Ok(cordis::PluginOutput::none())")
  out = out.push("        },")
  out = out.push("    )")
  out = out.push("}")
  out = out.push("")
  return out
}

// `_emit_component_auto`: a component with NO isolate/intercept and NO effectful
// method routes to the simple `_emit_component`; anything else routes to
// `_emit_component_new`.
fn emit_component_auto(comp: Any, services: Any, ir: Any) -> List[Str] {
  let iso = value_keys(value_field(comp, "isolate")).length() > 0
  let itc = value_keys(value_field(comp, "intercept")).length() > 0
  if (!iso && !itc && !component_has_effectful_methods(comp)) {
    return emit_component(comp, services, ir)
  }
  return emit_component_new(comp, services, ir)
}

// ---------------------------------------------------------------- the bridge
// The scalar bridge marshalling helpers (`_bridge_arg_ser`/`_arg_extract`/
// `_ret_deser`/`_ret_ser`), SUBSET: the `String`/`i64`/`f64`/`bool` scalars, the
// scalar-`Option` return table, and `()`. Result/serde/`Vec<Value>`/opaque-Value
// marshalling is DEFERRED — a `<<DEFER-*>>` / `<<NONE>>` marker keeps it loud.
fn bridge_arg_ser(name: Str, rtype: Str) -> Str {
  if (rtype == "String" || rtype == "i64" || rtype == "f64" || rtype == "bool") {
    return `serde_json::json!(${name})`
  }
  return `<<DEFER-bridge-arg-ser:${rtype}>>`
}
fn bridge_arg_extract(index: Int, rtype: Str) -> Str {
  let i = num_str(index)
  if (rtype == "String") { return `args[${i}].as_str().unwrap_or("").to_string()` }
  if (rtype == "i64") { return `args[${i}].as_i64().unwrap_or(0)` }
  if (rtype == "f64") { return `args[${i}].as_f64().unwrap_or(0.0)` }
  if (rtype == "bool") { return `args[${i}].as_bool().unwrap_or(false)` }
  return "<<NONE>>"
}
fn bridge_ret_deser(value: Str, rtype: Str) -> Str {
  if (rtype == "i64") { return `${value}.as_i64().unwrap_or(0)` }
  if (rtype == "String") { return `${value}.as_str().unwrap_or("").to_string()` }
  if (rtype == "bool") { return `${value}.as_bool().unwrap_or(false)` }
  if (rtype == "f64") { return `${value}.as_f64().unwrap_or(0.0)` }
  if (rtype == "()") { return `{ let _ = ${value}; }` }
  if (rtype == "Option<String>") { return `${value}.as_str().map(|s| s.to_string())` }
  if (rtype == "Option<i64>") { return `${value}.as_i64()` }
  if (rtype == "Option<bool>") { return `${value}.as_bool()` }
  return "<<NONE>>"
}
fn is_scalar_option(rtype: Str) -> Bool {
  return rtype == "Option<String>" || rtype == "Option<i64>" || rtype == "Option<bool>" || rtype == "Option<f64>"
}
fn bridge_ret_ser(call: Str, rtype: Str) -> Str {
  if (rtype == "i64" || rtype == "String" || rtype == "bool" || rtype == "f64" || is_scalar_option(rtype)) {
    return `serde_json::json!(${call})`
  }
  if (rtype == "()") { return `{ ${call}; serde_json::Value::Null }` }
  return `<<DEFER-bridge-ret-ser:${rtype}>>`
}

// The fixed `_revl_rpc` preamble — the Unix-socket JSON-RPC proxy the bridge
// opens with. A literal block; `\"`/`\\` escape the embedded quotes and the
// `'\n'` push (item 183 lets both work in a plain single-line string).
fn bridge_rpc_preamble() -> List[Str] {
  var o = []
  o = o.push("// ---- interop bridge (generated; docs/interop-bridge.md) ----")
  o = o.push("use std::io::{BufRead, Write};")
  o = o.push("use std::os::unix::net::UnixStream;")
  o = o.push("")
  o = o.push("fn _revl_rpc(socket: &str, key: &str, method: &str, args: Vec<serde_json::Value>) -> serde_json::Value {")
  o = o.push("    let request = serde_json::json!({ \"key\": key, \"method\": method, \"args\": args });")
  o = o.push("    let mut stream = None;")
  o = o.push("    for _ in 0..200 {")
  o = o.push("        match UnixStream::connect(socket) {")
  o = o.push("            Ok(s) => { stream = Some(s); break; }")
  o = o.push("            Err(_) => std::thread::sleep(std::time::Duration::from_millis(50)),")
  o = o.push("        }")
  o = o.push("    }")
  o = o.push("    let stream = stream.expect(\"bridge connect (provider never came up)\");")
  o = o.push("    let mut writer = stream.try_clone().expect(\"clone stream\");")
  o = o.push("    let mut line = serde_json::to_string(&request).unwrap();")
  o = o.push("    line.push('\\n');")
  o = o.push("    writer.write_all(line.as_bytes()).expect(\"write request\");")
  o = o.push("    let mut reader = std::io::BufReader::new(stream);")
  o = o.push("    let mut response = String::new();")
  o = o.push("    reader.read_line(&mut response).expect(\"read reply\");")
  o = o.push("    let reply: serde_json::Value = serde_json::from_str(&response).expect(\"parse reply\");")
  o = o.push("    if !reply[\"ok\"].as_bool().unwrap_or(false) {")
  o = o.push("        panic!(\"bridge remote error: {}\", reply[\"error\"]);")
  o = o.push("    }")
  o = o.push("    reply[\"value\"].clone()")
  o = o.push("}")
  o = o.push("")
  return o
}

// `_emit_bridge`: [] unless the document declares a `service` (a lone service is
// enough — that entanglement is why traits+bridge port together). Emits the RPC
// preamble, a consumer proxy + provider dispatch per service, and the fixed
// key/service/plugin/isolate/load routing tables over the provided keys.
fn emit_bridge(ir: Any) -> List[Str] {
  let services = value_field(ir, "services")
  if (value_keys(services).length() == 0) { return [] }
  let components = value_list(value_field(ir, "components"))
  let tables = build_type_tables(value_field(ir, "types"))
  let tnames = tables.tn
  // provided: key -> service, over every comp's provisions (subset: no
  // duplicate keys across components — that dedup is deferred).
  var pkeys = []
  var psvcs = []
  for (comp of components) {
    let provs = value_field(comp, "provides")
    for (key of value_keys(provs)) {
      pkeys = pkeys.push(key)
      psvcs = psvcs.push(value_str(value_field(provs, key)))
    }
  }
  var out = bridge_rpc_preamble()

  for (sname of value_keys(services)) {
    let srv = value_field(services, sname)
    let methods = value_field(srv, "methods")
    // consumer-side proxy
    out = out.push(`pub struct ${sname}Proxy { pub socket: String, pub key: String }`)
    out = out.push(`impl ${sname} for ${sname}Proxy {`)
    for (mn of value_keys(methods)) {
      let method = value_field(methods, mn)
      let params = value_list(value_field(method, "params"))
      var plist = []
      var argv = []
      for (p of params) {
        let pname = value_str(value_field(p, "name"))
        let pty = rust_type_t(value_field(p, "type"), tnames)
        plist = plist.push(`${pname}: ${pty}`)
        argv = argv.push(bridge_arg_ser(pname, pty))
      }
      var ret = "()"
      let r = value_field(method, "returns")
      if (!value_is_null(r)) { ret = rust_type_t(r, tnames) }
      let deser = bridge_ret_deser("_v", ret)
      out = out.push(`    fn ${mname(mn)}(&self, ${plist.join(", ")}) -> ${ret} {`)
      if (deser == "<<NONE>>") {
        out = out.push(`        panic!("bridge proxy: unsupported return type for ${sname}.${mn}");`)
      } else {
        out = out.push(`        let _v = _revl_rpc(&self.socket, &self.key, "${mn}", vec![${argv.join(", ")}]);`)
        out = out.push(`        ${deser}`)
      }
      out = out.push("    }")
    }
    out = out.push("}")
    // provider-side dispatch
    out = out.push(`fn _revl_dispatch_${snake(sname)}(svc: &dyn ${sname}, method: &str, args: &[serde_json::Value]) -> serde_json::Value {`)
    out = out.push("    match method {")
    for (mn of value_keys(methods)) {
      let method = value_field(methods, mn)
      let params = value_list(value_field(method, "params"))
      var ret = "()"
      let r = value_field(method, "returns")
      if (!value_is_null(r)) { ret = rust_type_t(r, tnames) }
      var extracts = []
      var idx = 0
      var any_none = false
      for (p of params) {
        let e = bridge_arg_extract(idx, rust_type_t(value_field(p, "type"), tnames))
        if (e == "<<NONE>>") { any_none = true }
        extracts = extracts.push(e)
        idx = idx + 1
      }
      if (any_none) {
        out = out.push(`        "${mn}" => serde_json::Value::Null, // unmarshalled param type`)
      } else {
        out = out.push(`        "${mn}" => ${bridge_ret_ser(`svc.${mname(mn)}(${extracts.join(", ")})`, ret)},`)
      }
    }
    out = out.push("        _ => serde_json::Value::Null,")
    out = out.push("    }")
    out = out.push("}")
    out = out.push("")
  }

  // key -> service name (over provided keys)
  out = out.push("pub fn _revl_service_of(key: &str) -> Option<&'static str> {")
  out = out.push("    match key {")
  var pi = 0
  while (pi < pkeys.length()) {
    out = out.push(`        "${pkeys[pi]}" => Some("${psvcs[pi]}"),`)
    pi = pi + 1
  }
  out = out.push("        _ => None,")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")

  // consumer: a plugin that provs `key` via the right proxy
  out = out.push("pub fn _revl_proxy_plugin(key: &str, service: &str, socket: String) -> Option<cordis::PluginHandle> {")
  out = out.push("    let key_string = key.to_string();")
  out = out.push("    match service {")
  for (sname of value_keys(services)) {
    out = out.push(`        "${sname}" => Some(cordis::plugin_sync::<(), _>(`)
    out = out.push(`            "${sname}Proxy",`)
    out = out.push("            cordis::Inject::none(),")
    out = out.push("            move |ctx, _config| {")
    out = out.push(`                let proxy: Box<dyn ${sname}> = Box::new(${sname}Proxy { socket: socket.clone(), key: key_string.clone() });`)
    out = out.push("                ctx.provide(key_string.as_str(), proxy)?;")
    out = out.push("                Ok(cordis::PluginOutput::none())")
    out = out.push("            },")
    out = out.push("        )),")
  }
  out = out.push("        _ => None,")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")

  // provider/probe: require a locally-provided key and dispatch to it
  out = out.push("pub fn _revl_invoke(ctx: &cordis::Context, key: &str, method: &str, args: &[serde_json::Value]) -> serde_json::Value {")
  out = out.push("    match key {")
  pi = 0
  while (pi < pkeys.length()) {
    let key = pkeys[pi]
    let srv = psvcs[pi]
    out = out.push(`        "${key}" => match ctx.require::<Box<dyn ${srv}>>("${key}") {`)
    out = out.push(`            Ok(svc) => _revl_dispatch_${snake(srv)}(&**svc, method, args),`)
    out = out.push("            Err(_) => serde_json::Value::Null,")
    out = out.push("        },")
    pi = pi + 1
  }
  out = out.push("        _ => serde_json::Value::Null,")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")

  // comp name -> plugin handle
  out = out.push("pub fn plugin_by_name(name: &str) -> Option<cordis::PluginHandle> {")
  out = out.push("    match name {")
  for (comp of components) {
    let snk = snake(value_str(value_field(comp, "name")))
    out = out.push(`        "${snk}" => Some(${snk}()),`)
  }
  out = out.push("        _ => None,")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")

  // comp name -> realm-isolated context (subset: no comp isolates, so
  // only the `_ => ctx.clone()` arm; isolate placements are DEFERRED).
  out = out.push("pub fn _revl_isolate_ctx(ctx: &cordis::Context, name: &str) -> cordis::Context {")
  out = out.push("    match name {")
  for (comp of components) {
    let iso = value_field(comp, "isolate")
    if (value_keys(iso).length() > 0) {
      out = out.push(`<<DEFER-isolate:${value_str(value_field(comp, "name"))}>>`)
    }
  }
  out = out.push("        _ => ctx.clone(),")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")

  // comp name -> loaded Fiber (subset: unit config only; typed `<Comp>Config`
  // construction from the placement spec is DEFERRED).
  out = out.push("pub fn _revl_load(ctx: &cordis::Context, name: &str, config: &serde_json::Value) -> Option<cordis::Fiber> {")
  out = out.push("    match name {")
  for (comp of components) {
    let pascal = value_str(value_field(comp, "name"))
    let snk = snake(pascal)
    let fields = value_list(value_field(comp, "config"))
    out = out.push(`        "${snk}" => {`)
    out = out.push(`            let ctx = _revl_isolate_ctx(ctx, "${snk}");`)
    if (fields.length() > 0) {
      // Typed `<Comp>Config` construction from the placement spec, each field
      // read out of the JSON with the right scalar accessor and defaulted.
      out = out.push(`            let _c = config.get("${pascal}").cloned().unwrap_or(serde_json::Value::Null);`)
      out = out.push(`            Some(ctx.plugin(${snk}(), ${pascal}Config {`)
      for (field of fields) {
        let fname = mangle(value_str(value_field(field, "name")))
        let ftype = rust_type(value_field(field, "type"))
        let dflt = config_default_lit(value_field(field, "default"), ftype)
        if (ftype == "String") {
          out = out.push(`                ${fname}: _c.get("${fname}").and_then(|v| v.as_str()).map(|s| s.to_string()).unwrap_or_else(|| ${dflt}),`)
        } else {
          if (ftype == "i64") {
            out = out.push(`                ${fname}: _c.get("${fname}").and_then(|v| v.as_i64()).unwrap_or(${dflt}),`)
          } else {
            if (ftype == "f64") {
              out = out.push(`                ${fname}: _c.get("${fname}").and_then(|v| v.as_f64()).unwrap_or(${dflt}),`)
            } else {
              if (ftype == "bool") {
                out = out.push(`                ${fname}: _c.get("${fname}").and_then(|v| v.as_bool()).unwrap_or(${dflt}),`)
              } else {
                out = out.push(`                ${fname}: ${dflt},`)
              }
            }
          }
        }
      }
      out = out.push("            }))")
    } else {
      out = out.push(`            Some(ctx.plugin(${snk}(), ()))`)
    }
    out = out.push("        },")
  }
  out = out.push("        _ => None,")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")
  return out
}

// `_module_header(version)`: the banner, the lint allowances, and the crate
// uses. Mirrors the reference `_module_header`: a components-ONLY document lowers
// to `ir_version 1`, whose banner names version 1 and carries the SHORT allow
// line; `ir_version 2` (realms) and `ir_version 3` (types/functions) share the
// wider allow set. Only the header depends on the version; the covered
// service/comp body is byte-identical across versions (item 217 front-door).
fn module_header(version: Int) -> List[Str] {
  var o = []
  o = o.push(`//! Generated by the revl cordis-rs backend (ir_version ${version}): do not edit.`)
  o = o.push("//! Target: cordis-rs 0.3.x (docs.rs/cordis-rs).")
  if (version == 1) {
    o = o.push("#![allow(dead_code, unused_variables)]")
  } else {
    o = o.push("#![allow(dead_code, unused_variables, unused_mut, unused_imports, unused_parens, unreachable_patterns)]")
  }
  o = o.push("")
  o = o.push("use std::sync::Arc;")
  o = o.push("use cordis::Value;")
  o = o.push("")
  return o
}

fn stdlib_helpers() -> List[Str] {
  return [
    "trait RevlStrOps {", "    fn revl_length(&self) -> i64;", "    fn revl_slice(&self, a: i64, b: i64) -> String;", "    fn revl_index_of(&self, needle: &str) -> i64;", "    fn revl_concat(&self, other: &str) -> String;", "    fn revl_split(&self, sep: &str) -> Vec<String>;", "    fn revl_repeat(&self, n: i64) -> String;", "    fn revl_starts_with(&self, prefix: &str) -> bool;", "    fn revl_ends_with(&self, suffix: &str) -> bool;", "}",
    "impl RevlStrOps for str {", "    fn revl_length(&self) -> i64 { self.chars().count() as i64 }", "    fn revl_slice(&self, a: i64, b: i64) -> String {", "        self.chars().skip(a.max(0) as usize).take((b - a).max(0) as usize).collect()", "    }", "    fn revl_index_of(&self, needle: &str) -> i64 {", "        match self.find(needle) {", "            Some(b) => self[..b].chars().count() as i64,", "            None => -1,", "        }", "    }", "    fn revl_concat(&self, other: &str) -> String { format!(\"{}{}\", self, other) }", "    fn revl_split(&self, sep: &str) -> Vec<String> {", "        if sep.is_empty() {", "            self.chars().map(|c| c.to_string()).collect()", "        } else {", "            self.split(sep).map(|s| s.to_string()).collect()", "        }", "    }", "    fn revl_repeat(&self, n: i64) -> String { self.repeat(n.max(0) as usize) }", "    fn revl_starts_with(&self, prefix: &str) -> bool { self.starts_with(prefix) }", "    fn revl_ends_with(&self, suffix: &str) -> bool { self.ends_with(suffix) }", "}",
    "trait RevlStrListOps {", "    fn revl_join(&self, sep: &str) -> String;", "}", "impl RevlStrListOps for Vec<String> {", "    fn revl_join(&self, sep: &str) -> String { self.join(sep) }", "}",
    "trait RevlListOps<T> {", "    fn revl_length(&self) -> i64;", "    fn revl_slice(&self, a: i64, b: i64) -> Vec<T>;", "    fn revl_index_of(&self, needle: &T) -> i64;", "    fn revl_concat(&self, other: &Vec<T>) -> Vec<T>;", "    fn revl_push(&self, item: T) -> Vec<T>;", "}",
    "impl<T: Clone + PartialEq> RevlListOps<T> for Vec<T> {", "    fn revl_length(&self) -> i64 { self.len() as i64 }", "    fn revl_slice(&self, a: i64, b: i64) -> Vec<T> {", "        // JS slice semantics: out-of-range bounds clamp, never panic.", "        let len = self.len();", "        let a2 = (a.max(0) as usize).min(len);", "        let b2 = (b.max(0) as usize).min(len).max(a2);", "        self[a2..b2].to_vec()", "    }",     "    fn revl_index_of(&self, needle: &T) -> i64 {", "        self.iter().position(|x| x == needle).map(|i| i as i64).unwrap_or(-1)", "    }", "    fn revl_concat(&self, other: &Vec<T>) -> Vec<T> {", "        let mut _v = self.clone(); _v.extend(other.iter().cloned()); _v", "    }", "    fn revl_push(&self, item: T) -> Vec<T> {", "        let mut _v = self.clone(); _v.push(item); _v", "    }", "}",
  ]
}

fn contains_stdlib(v: Any) -> Bool {
  if (value_is_null(v)) { return false }
  if (node_kind(v) == "builtin" || node_kind(v) == "len") { return true }
  for (k of value_keys(v)) {
    if (contains_stdlib(value_field(v, k))) { return true }
  }
  for (x of value_list(v)) {
    if (contains_stdlib(x)) { return true }
  }
  return false
}

// The document assembly for a TYPES + FUNCTIONS v3 document (`_emit_v3`, subset):
// the module header, then the user `type` items, then the free functions —
// joined with newlines, right-stripped, and closed with a single trailing
// newline, in the reference's section order (types, externs, functions). In-file
// `test`/lifecycle-test emission is still DEFERRED — the covered corpus declares
// none, so the reference's `_emit_v3_tests` contributes nothing.
// Named `emit_rust_src` (not a bare `emit_src`) so the self-host pipeline can
// `use` emit_rust.rvl BESIDE emit_py.rvl in one composition: private decls no
// longer leak (item 228), but the merge still flattens both modules' PUBLIC decls
// by bare name, so the two emitter entrypoints must differ (roadmap item 230 —
// enables the fully-native `compile.rvl`).
pub fn emit_rust_src(ir: Any) -> Str {
  let types = value_field(ir, "types")
  let tables = build_type_tables(types)
  let functions = value_list(value_field(ir, "functions"))
  let externs = value_list(value_field(ir, "externs"))
  var fr: Map[Str, Str] = Map.empty()
  var fnames: Map[Str, Str] = Map.empty()
  for (fnode of functions) {
    let fname = value_str(value_field(fnode, "name"))
    fnames = fnames.set(fname, "1")
    let r = value_field(fnode, "returns")
    if (!value_is_null(r)) { fr = fr.set(fname, value_str(r)) }
  }
  // `_V3Ctx.fn_returns` seeds from the free functions AND then `setdefault`s the
  // externs: an extern's DECLARED return types a `let` bound to a call on it, so
  // a later by-value use knows to clone (issue 275 — without this the self-host
  // emitted `tag(p)` where the reference emits `tag(p.clone())`, an E0382 away
  // from the reference's own output). `setdefault`, so a free function of the
  // same name wins — including one whose declared return is absent.
  for (ext of externs) {
    let ename = value_str(value_field(ext, "name"))
    if (map_get(fnames, ename) == "") {
      let er = value_field(ext, "returns")
      if (!value_is_null(er)) { fr = fr.set(ename, value_str(er)) }
    }
  }
  // item 217: the reference dispatches on `ir_version` (`_emit_v1`/`_emit_v2`/
  // `_emit_v3`); across those paths only the module header differs for the
  // covered service/comp surface, so the front-door is a versioned header over
  // the shared body. A components-only document lowers to v1, a realm-only one
  // to v2, everything else here to v3.
  let ver = value_int(value_opt(ir, "ir_version") ?? 3)
  var out = module_header(ver)
  if (value_keys(types).length() > 0) { out = out.concat(emit_v3_types(types, tables.tn)) }
  if (externs.length() > 0) { out = out.concat(emit_v3_externs(externs, tables.tn)) }
  if (functions.length() > 0) { out = out.concat(emit_v3_functions(functions, fr, tables)) }
  if (contains_stdlib(functions) || contains_stdlib(types) || contains_stdlib(externs)) {
    out = out.concat(stdlib_helpers())
  }
  // `_emit_components`, run unconditionally in `_emit_v3` (after the
  // types/externs/functions and the DEFERRED tests sections). Empty when the document
  // declares no service/comp — so a types+functions-only document is
  // unchanged — and byte-exact for the covered service/comp subset:
  // service traits, host stubs (empty here), each comp (simple path), then
  // the `_emit_bridge` erasure block.
  let services = value_field(ir, "services")
  out = out.concat(emit_service_traits(services, tables.tn))
  out = out.concat(emit_host_stubs(ir))
  for (comp of value_list(value_field(ir, "components"))) {
    out = out.concat(emit_component_auto(comp, services, ir))
  }
  out = out.concat(emit_bridge(ir))
  return rstrip(out.join(newline())).concat(newline())
}

// ---------------------------------------------------------------- in-file tests
test "rust_type covers the scalar and generic surface" {
  assert rust_type("Int") == "i64"
  assert rust_type("Str") == "String"
  assert rust_type("Bool") == "bool"
  assert rust_type("List[Int]") == "Vec<i64>"
  assert rust_type("Opt[Str]") == "Option<String>"
  assert rust_type("Map[Str, Int]") == "std::collections::HashMap<String, i64>"
}

test "bin-op table maps the longest revl ops" {
  assert v3_bin_ops("===") == "=="
  assert v3_bin_ops("!==") == "!="
  assert v3_bin_ops("&&") == "&&"
  assert v3_bin_ops("||") == "||"
  assert checked_method("+") == "checked_add"
  assert checked_method("*") == "checked_mul"
}

test "rust indentation is four spaces per level" {
  assert ind(0) == ""
  assert ind(2) == "        "
  assert line(1, "x") == "    x"
}

test "the Rust rename is injective" {
  assert mangle("match") == "match_"
  assert mangle("impl") == "impl_"
  assert mangle("value") == "value"
  // `match` and the equally legal revl identifier `match_` must not both land
  // on `match_`: the ladder shifts up a rung instead of collapsing.
  assert mangle("match_") == "match__"
  assert mangle("match__") == "match___"
  // the same for the one method rename this tier carries
  assert mname("drop") == "drop_"
  assert mname("drop_") == "drop__"
  assert mname("run") == "run"
  // a name with no reserved root is verbatim, trailing underscores and all
  assert mangle("value_") == "value_"
}

test "sorted_key sorts field names by code point" {
  assert sorted_key(["b", "a", "c"]) == "a,b,c"
  assert sorted_key(["name", "age"]) == "age,name"
  assert sorted_key(["x"]) == "x"
  assert str_lt("age", "name")
  assert !str_lt("name", "name")
}

test "rust_type maps user type names and their generics" {
  var tn: Map[Str, Str] = Map.empty()
  tn = tn.set("Person", "1")
  assert rust_type_t("Person", tn) == "Person"
  assert rust_type_t("List[Person]", tn) == "Vec<Person>"
  assert rust_type_t("Opt[Person]", tn) == "Option<Person>"
  assert rust_type_t("Unknown", tn) == "Value"
  assert rust_type_t("Int", tn) == "i64"
}

test "constructor lowers user variants and built-ins" {
  var ca: Map[Str, Str] = Map.empty()
  var cp: Map[Str, Str] = Map.empty()
  ca = ca.set("Node", "Tree")
  cp = cp.set("Node", "y")
  ca = ca.set("Leaf", "Tree")
  cp = cp.set("Leaf", "n")
  let ctx = { vt: Map.empty(), fr: Map.empty(), ca: ca, cp: cp, rbf: Map.empty(), rn: Map.empty() }
  assert constructor(ctx, "Node", ["x"]) == "Tree::Node(x)"
  assert constructor(ctx, "Leaf", []) == "Tree::Leaf"
  assert constructor(ctx, "Some", ["v"]) == "Some(v)"
  assert constructor(ctx, "None", []) == "None"
}

// --------------------------------------------------------------- component wrap
// A trivial provider so the emitted module is a valid plugin (the pure `emit_rust_src`
// above is what the cross-check exercises); mirrors the wrapper the other
// self-host stages carry. `render` avoids the `emit` keyword.
service EmitStream {
  fn render(ir: Any) -> Str
}

component EmitRust provides emitter: EmitStream {
  provide emitter {
    fn render(ir) = emit_rust_src(ir)
  }
}
