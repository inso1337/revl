// The revl backend-IR -> cordis-v4 (TypeScript) EMITTER, in revl — Path B, the
// self-host of the TypeScript tail (roadmap item 190). Where the
// lexer/parser/checker/lower stages port the compiler FRONTEND, this file ports
// the TS tail: it reads the stable interchange IR (docs/backend-ir.md — the JSON
// document every backend consumes) and produces TypeScript source text,
// mirroring backends/typescript/emit.py.
//
// It is one half of a differential BYTE oracle: this file and
// backends/typescript/emit.py's `emit()` are two independent implementations of
// the same lowering, forced to produce BYTE-IDENTICAL TypeScript for every input
// in the covered subset (tests/test_selfhost_emit_ts.py). The reference is ground
// truth; any divergence is a defect in this slice.
//
// ============================================================ WHAT IT COVERS
// The first coherent slice emits, byte-for-byte, the v3 FUNCTION-ONLY document —
// an IR_version-3 document whose only section is module `fn`s (a revl library):
//
//   * the module scaffold — the two generated-header comment lines, the
//     `import type { Context }` line and the `import { host } from '../runtime.ts'`
//     runtime import, and the blank separator;
//   * the conditional helper preludes (`_revl_helpers`) — `revlEq`, `revlI64`,
//     `revlI32`, the named-integer-arithmetic block, the code-point string
//     helpers, `revlShow`, and `revlParseInt` — each gated exactly as the
//     reference gates them (walked over the whole IR);
//   * `_emit_ts_functions` -> `_v3_stmt` -> `_expr` for the base surface —
//     let/assign (const/let), return, if/while/for, expr; and the 2.0 expression
//     algebra: lit, var, bin (incl `??`, structural `==` via revlEq, the bounded
//     `+ - *`, true `/`, truncated `%`), un, call, field, index, len, the stdlib
//     builtins, maplit, sync arrow (incl captures IIFE), match (Opt Some/None and
//     the tagged switch), record, list, record-update, string interpolation, and
//     the optional field/call forms; plus the implicit `Number(...)` / `BigInt(...)`
//     widen markers and the `$revl_match_N` document-wide temp counter.
//
// ============================================================ SLICE 2 (item 204)
// Extends the emitter to the COMPONENT-dialect tail of `_emit_v3`, byte-exact:
//   * service interfaces (`export interface <Service>`) over scalar signatures;
//   * `_context_augmentation` — the committed-view `ctx.<key>` `declare module`
//     block, provisions then requirements, first-occurrence order;
//   * config interfaces (`<Name>Config`, required + defaulted fields);
//   * each component's plugin object — `_component`: inject/provide wiring, the
//     `apply(ctx[, rawConfig])` scaffold + `host.applyConfigDefaults`, and the
//     `ctx.effect(function* () { … })` activation body;
//   * `_component_step` (let-effect/effect/emit+compensate/provide/if/fail) and
//     `_provide_impl` -> `_method_body` (let/assign/return/effect/emit), reusing
//     the single `_expr` — the component-dialect kinds `req`/`config`/`name` and
//     the component-shaped `call` (`target`/`method`) join the 2.0 dispatch.
//
// ============================================================ SLICE 4 (item 219)
// Adds ASYNC COLORING across the component tail, byte-identical:
//   * async service OPERATIONS -> `Promise<T>` signatures (`service_interfaces`);
//   * `async` provide METHODS — `async <op>(…) {` whose body renders in an async
//     context (`provide_impl`/`method_body`);
//   * the item-141 AWAIT-SEED — a req-keyed async-op `call` in an async body is
//     awaited wherever it lands (return / let / a nested ternary arm), gated on
//     `in_async && !in_arrow` and a per-component `ops` membership test;
//   * the ASYNC-GENERATOR body — a component body with an `await` step renders
//     `async apply` + `await ctx.effect(async function* () {` (`component_lines`/
//     `body_is_async`), and the `await` step itself where it lands + the
//     `yield () => {}` iteration boundary (A1).
// The async-colouring state (`in_async`/`in_arrow`/`ops`) is threaded EXPLICITLY
// down the expr tree as an `ACx` — revl has no shared render context — like the
// `$revl_match_N` counter (relates to the state-threading tax, item 195).
//
// ============================================================ SLICE 3 (item 208)
// Extends the emitter to composite SIGNATURE types and four more expr kinds:
//   * COMPOSITE service/provide-method signature types via `ts_type_v1` — the
//     v1 `_ts_type` composite path (List/Opt/Map/Result and the function type),
//     plus the declared-record `known_types` path (`List[Msg]` -> `Msg[]`, which
//     resolves to an emitted `interface Msg`). `known_types` is threaded down
//     from the document's `types`; config-field types stay the scalar-or-`any`
//     map (they never render a composite);
//   * the RECORD half of `_emit_ts_types` — `export interface <Name> { … }` —
//     so a signature carrying a declared record has a real interface to name;
//   * the component-dialect expr kinds `host` (`host.<fn>(…)`), `format` (the
//     v1 `$N` template -> a JS template literal), `fn` (a top-level call), and
//     `adt` (a tagged `{ kind, value }` constructor) join the shared dispatch.
//
// ============================================================ WHAT IT DEFERS
// Reported for follow-on TS-emitter slices, deliberately OUT of these slices:
//   * the canonical ABI;
//   * the component-body `timer` step; and the component-dialect expr kinds
//     `spawn`/`instance-get` (unexercised);
//   * the reference's `Stream.*` TIER-LIMIT refusal (roadmap 419e): the
//     reference `_expr` now refuses a `Stream.*` host builtin, since this tier
//     has no `Stream` runtime primitive and `host.Stream.source()` was a dead
//     emit. Deliberately NOT ported: these emitters have no refusal channel at
//     all (they render bytes over a slice-limited covered surface), and no
//     fixture reaches a `Stream.*` host builtin, so the oracle cannot see it;
//     a port would mean inventing a refusal channel for an unreached shape;
//   * the VARIANT half of `_emit_ts_types` (the `export type … =` union + its
//     constructor functions) — only records are emitted; a variant type would
//     emit a marker and diverge, so no fixture declares one;
//   * in-file `test`/`fault_test`/`lifecycle test` emission; ROUTED requires
//     (`realms(...)` + the `revlRouter` helper, its `realmLabel` import, and the
//     routed-`req` proxy — see SLICE 7); the canonical ABI;
//   * the COMPONENT-dialect async call surface: an async callable reached through
//     the `fn` expr kind, or from an async PROVIDE method (its `async_names` are
//     threaded EMPTY — byte-safe, since no covered component body names an async
//     callable, but a follow-on slice must thread the doc set through to make the
//     component tail faithful to the reference's provide-method awaiting);
//
// ============================================================ SLICE 5 (item 226)
// The MODULE-FN async path, byte-exact:
//   * async externs -> `_emit_ts_externs` (`export async function …: Promise<T>`
//     carrying the verbatim, dedented `@ts` body); sync externs too;
//   * phase-2 async-colored module `fn`s -> `export async function …: Promise<T>`,
//     the body rendered `in_async` (the `ACx` now threads through `v3_stmt`);
//   * a `var`-callee `call` naming an async callable (`async_names` — async
//     externs + colored fns) or an async-value parameter (`async_locals`, the
//     item-92 `(…) -> Async[T]` slot) is awaited (`(await …)`);
//   * the async `match` shape (Opt IIFE + tagged switch, arm-arrows + inner calls
//     awaited) and the async ARROW (`async (…) => …`). Item 435 made both of
//     those colours PER-EXPRESSION rather than per-function: an arm-arrow and
//     the IIFE go `async` only when the RENDERED body carries an `await`
//     (`renders_await`), and an arrow whose body is nothing but the un-awaited
//     emission Promise (`emission_call_node`) sheds its `async` too, since the
//     keyword only added a resolution hop over a Promise already in hand.
//   * `assert` statements and `let_pattern` (destructuring): the reference names
//     an assert temp `$revl_l`/`$revl_r` and renders via `revlShow` — implementable
//     but not exercised by the function corpus, so deferred to keep the slice
//     byte-VERIFIED rather than byte-guessed.
//
// ============================================================ SLICE 7 (item 240)
// The v1/v2 DISPATCH path (`emit()` -> `_emit_v1`), pinned byte-exact with NO
// emitter change. A component-only document with no v3 feature (no declared
// type/fn/extern/test, no `if`/`fail`/setup-effect body step, no
// builtin/adt/spawn/async-op) lowers to ir_version 1; a component carrying ONLY a
// realm placement (`isolate`) or `intercept` metadata lowers to ir_version 2.
// `emit_ts_src` is version-agnostic — it assembles the same shape `_emit_v1` does for
// a component-only doc (header, `_revl_helpers`, service interfaces,
// `_context_augmentation`, each `_component` plugin object) — so its output is
// byte-identical to the reference's v1/v2 emission. This CLOSES item 234's flag
// ("compiles to irv2, which the port doesn't mirror"): the mirror already holds,
// now verified by v1/v2-dispatch corpus fixtures rather than crutched off v3 by a
// trivial top-level `fn`.
//   * STILL DEFERRED — ROUTED requires (item 167): a routed require
//     (`requires <k> in realms(...) strategy(...)`) also lowers to ir_version 2 but
//     additionally needs the `_TS_ROUTER_SRC` runtime literal, the `realmLabel`
//     runtime import, the `inject_keys = requires − routes` gate, the per-key
//     `revlRouter` proxy built in `apply()`, and the routed-`req` read
//     (`_revl_route_<key>`). The router literal embeds backtick templates and
//     `${…}` the revl lexer reserves, so it is kept out to stay byte-VERIFIED; a
//     routed v2 doc must NOT enter the corpus until it lands.
//
// ------------------------------------------------------ the erased-IR boundary
// Navigation reads the IR in PURE revl through stdlib/value.rvl (item 180): the
// `value_*` accessors, no navigation `@py` block. Only HOST FORMATTING stays
// `@py` — `json_dumps` (the reference `_string`/`_literal`/`_int_as_number` call
// Python's `json.dumps`, so bridging it is faithful), `template_text` (the
// template-literal escaper), `newline`, and the trailing-whitespace `py_rstrip`.
// Every byte of emitter LOGIC (kind dispatch, type rendering, indentation,
// string building, the JS-keyword mangle) stays pure revl.
use "../stdlib/value.rvl" {
  value_kind, value_is_null, value_field, value_opt, value_has, value_keys,
  value_list, value_at, value_str, value_int, value_bool, value_children
}
use "../stdlib/list.rvl" { list_contains }

// The blessed threaded-accumulator combinator (item 195, option C): `render_seq`
// threads the `$revl_match_N` counter left-to-right through a run of renders, and
// `Rendered` is the shared `{text, counter}` cell every render here returns.
use "../stdlib/render.rvl" { render_seq, Rendered }

// ------------------------------------------------- host formatting (kept @py)
// The reference emitter renders string/number LITERALS with `json.dumps`; this
// is the item-180 "NOT obsoleted" host-output set (kin to emit_py.rvl's
// `py_repr`). `_string(v)` and the numeric-literal / index-number spellings all
// route through it.
extern pure fn json_dumps(v: Any) -> Str = @py {
    import json
    return json.dumps(v)
}
// The template-literal text escaper (`_template_text`): backslash, backtick, and
// `${` are escaped so literal text embeds safely in a `` `...` `` template.
// Built from `chr()` so the revl `@py` block carries no stray brace/backtick.
extern pure fn template_text(v: Any) -> Str = @py {
    bs = chr(92)
    bt = chr(96)
    dl = chr(36)
    ob = chr(123)
    return v.replace(bs, bs + bs).replace(bt, bs + bt).replace(dl + ob, bs + dl + ob)
}
// A real newline — revl plain strings carry no escapes, so the one genuine
// U+000A the module separator needs is sourced here.
extern pure fn newline() -> Str = @py { return chr(10) }
// `"\n".join(out).rstrip()` — strip trailing whitespace/newlines before the
// single final newline the reference appends.
extern pure fn py_rstrip(s: Str) -> Str = @py { return s.rstrip() }
// `_emit_ts_externs` renders a verbatim `@ts` extern body: `textwrap.dedent`
// after stripping the surrounding blank lines (`.strip("\n")`), then re-indented
// line-by-line. These three host-string helpers reproduce exactly those calls.
extern pure fn py_dedent(s: Str) -> Str = @py {
    import textwrap
    return textwrap.dedent(s)
}
extern pure fn py_strip_nl(s: Str) -> Str = @py { return s.strip(chr(10)) }
extern pure fn py_splitlines(s: Str) -> List[Str] = @py { return s.splitlines() }

// ---------------------------------------------------------------- small utils
fn node_kind(n: Any) -> Str { return value_str(value_field(n, "kind")) }
fn node_op(n: Any) -> Str { return value_str(value_field(n, "op")) }
fn node_operands(n: Any) -> Str { return value_str(value_field(n, "operands")) }
fn node_method(n: Any) -> Str { return value_str(value_field(n, "method")) }

fn ind(n: Int) -> Str { return "  ".repeat(n) }

// A rendered expression is `Rendered = { text: Str, counter: Int }`: its text AND
// the running `$revl_match_N` counter (the reference's `ctx._counter`, threaded
// here since revl has no method state, so the document-wide match-temp numbering
// is otherwise unreproducible). The cell is imported from stdlib/render.rvl (item
// 195) so `render_seq` and every render fn below name the same threaded shape.

// One or more statement lines AND the threaded match counter.
type StmtOut = { lines: List[Str], counter: Int }

// ------------------------------------------------------ async-coloring context
// The reference threads its async-colouring state on the rendering `_Ctx`
// (`in_async`/`in_arrow` and the doc-level `async_ops`); revl has no such shared
// object, so — like the `$revl_match_N` counter — it is threaded EXPLICITLY down
// the expr tree (item 219; relates to the state-threading tax, item 195).
//   * `in_async` — is the body currently rendered an `async` provide method (so
//     it may `await`)? The item-141 await-seed fires only when true.
//   * `in_arrow` — are we INSIDE an arrow body? The await-seed stays OUT of arrow
//     bodies (an async arrow flattens its own Promise), matching the reference.
//   * `ops` — the async service OPERATIONS reachable through THIS component's
//     requirement keys, each as `"<reqKey>#<method>"` (the reference's
//     `async_ops`, pre-resolved through `scope.requires` so `render_call` needs
//     only a membership test). A method name is a bare identifier, so `#` cannot
//     collide.
//   * `async_names` — the doc-level set of async CALLABLE names: async externs
//     and phase-2 async-colored module fns (both stamped `"async": true`). A
//     `var`-callee `call` naming one, in an async body, is awaited (item 80 /
//     docs/design/async-extern.md §5). Mirrors the reference `_Ctx.async_names`,
//     which revl cannot hang off a shared context so it rides the ACx instead.
//   * `async_locals` — the PARAMETERS of the body currently rendered whose
//     declared type is an async function type `(…) -> Async[T]` (item 92): a
//     call through one returns a `Promise` and is awaited like a named callable.
//     Per-body (a local name), so it is re-derived at each module-fn boundary.
type ACx = { in_async: Bool, in_arrow: Bool, ops: List[Str], async_names: List[Str], async_locals: List[Str] }

// The sync, non-component context: the pure fn/test pass and every sync body.
fn sync_acx() -> ACx { return { in_async: false, in_arrow: false, ops: [], async_names: [], async_locals: [] } }

// The `"<reqKey>#<method>"` await-seed key.
fn async_op_key(req_key: Str, method: Str) -> Str {
  return req_key.concat("#").concat(method)
}

// `async_ops` for one component: for each requirement `<key>: <Service>`, every
// async operation the service declares, keyed `"<key>#<op>"`. Mirrors the
// reference's `{(service, method) …}` set resolved through `scope.requires`.
fn async_ops_of(req_map: Any, services: Any) -> List[Str] {
  var ops = []
  for (req_key of value_keys(req_map)) {
    let svc = value_field(services, value_str(value_field(req_map, req_key)))
    if (!value_is_null(svc)) {
      let methods = value_field(svc, "methods")
      for (mname of value_keys(methods)) {
        if (value_bool(value_field(value_field(methods, mname), "async"))) {
          ops = ops.push(async_op_key(req_key, mname))
        }
      }
    }
  }
  return ops
}

// ---------------------------------------------------- JS/TS keyword mangle (A3)
// `_mangle`: rename a valid revl identifier that is a JS/TS reserved word, so
// it emits and RUNS instead of crashing (item 165). A pure function of the name
// — declaration and use sites agree without a table — and INJECTIVE, so two
// distinct revl identifiers never land on one JS identifier. Escape a name iff
// the name or any name reachable from it by dropping trailing `_` is reserved,
// by exactly one `_`: that shifts the whole `kw`/`kw_`/`kw__` ladder up a rung
// (`function` -> `function_`, `function_` -> `function__`) and leaves every
// other name verbatim, so nothing collapses.
fn is_js_reserved(name: Str) -> Bool {
  let words = ["await", "break", "case", "catch", "class", "const", "continue",
    "debugger", "default", "delete", "do", "else", "enum", "export", "extends",
    "false", "finally", "for", "function", "if", "import", "in", "instanceof",
    "let", "new", "null", "return", "static", "super", "switch", "this", "throw",
    "true", "try", "typeof", "var", "void", "while", "with", "yield"]
  for (w of words) {
    if (w == name) { return true }
  }
  return false
}

fn mangle(name: Str) -> Str {
  var root = name
  while (root.length() > 0) {
    if (is_js_reserved(root)) { return name.concat("_") }
    if (root.charAt(root.length() - 1) != "_") { return name }
    root = root.slice(0, root.length() - 1)
  }
  return name
}

// `_ident` on the happy path: validation + emitter-scaffolding rejection are
// deferred (the covered corpus is clean), so this is the A3 rename only.
fn ident(name: Str) -> Str { return mangle(name) }

// ---------------------------------------------------------------- type rendering
// `_ts_v3_type` (docs/syntax-2.0.md §2): the surface type -> TS type map.
fn ts_scalar_type(name: Str) -> Str {
  if (name == "Int") { return "bigint" }
  if (name == "Int32") { return "number" }
  if (name == "Float") { return "number" }
  if (name == "Bool") { return "boolean" }
  if (name == "Str") { return "string" }
  if (name == "Bytes") { return "Uint8Array" }
  if (name == "Unit") { return "void" }
  if (name == "Any") { return "any" }
  if (name == "Never") { return "never" }
  return ""
}

fn last_index(s: Str, ch: Str) -> Int {
  var i = s.length() - 1
  while (i >= 0) {
    if (s.charAt(i) == ch) { return i }
    i -= 1
  }
  return -1
}

// `_split_v3_types`: split a type-arg list on the top-level commas only.
fn split_type_args(inner: Str) -> List[Str] {
  var parts = []
  var depth = 0
  var current = ""
  var i = 0
  let n = inner.length()
  while (i < n) {
    let ch = inner.charAt(i)
    if (ch == "[" || ch == "(") {
      depth += 1
      current = current.concat(ch)
    } else {
      if (ch == "]" || ch == ")") {
        depth -= 1
        current = current.concat(ch)
      } else {
        if (ch == "," && depth == 0) {
          parts = parts.push(py_strip(current))
          current = ""
        } else {
          current = current.concat(ch)
        }
      }
    }
    i += 1
  }
  if (current != "") { parts = parts.push(py_strip(current)) }
  return parts
}

extern pure fn py_strip(s: Str) -> Str = @py { return s.strip() }

// `_split_fn_type`: a function type `(A, B) -> C` -> its param list + return, or
// the empty marker (return "") when the name is not a function type. Returns the
// return-type string; params are recovered by the caller from the same scan.
fn fn_type_arrow_index(name: Str) -> Int {
  // The index just past the `)` that closes the leading `(`, iff the rest starts
  // with `->`; -1 otherwise. -2 means "starts with ( but is not a fn type".
  if (name.charAt(0) != "(") { return -1 }
  var depth = 0
  var i = 0
  let n = name.length()
  while (i < n) {
    let ch = name.charAt(i)
    if (ch == "[" || ch == "(") { depth += 1 }
    if (ch == "]" || ch == ")") {
      depth -= 1
      if (depth == 0) {
        let rest = py_strip(name.slice(i + 1, n))
        if (rest.slice(0, 2) == "->") { return i }
        return -2
      }
    }
    i += 1
  }
  return -2
}

// `_is_async_fn_type`: true for a function type whose declared return is
// `Async[…]` — the item-92 spelling that colors a first-class callback
// parameter, making a call through it an awaited async local. Extracts the
// return slot exactly as `ts_type` does (the same `arrow + 3` offset), so the
// detection stays in lockstep with the type the parameter renders to.
fn is_async_fn_type(name: Str) -> Bool {
  let arrow = fn_type_arrow_index(name)
  if (arrow < 0) { return false }
  let rest = py_strip(name.slice(arrow + 1, name.length()))
  let returns = py_strip(rest.slice(2, rest.length()))
  return returns.slice(0, 6) == "Async["
}

fn ts_type(name: Str) -> Str {
  if (name == "") { return "unknown" }
  let mapped = ts_scalar_type(name)
  if (mapped != "") { return mapped }
  let arrow = fn_type_arrow_index(name)
  if (arrow >= 0) {
    let n = name.length()
    let inner = py_strip(name.slice(1, arrow))
    // The return slot is everything past the `)`, stripped of the `->` and the
    // whitespace the surface form (`(Str) -> Async[Str]`) carries around it —
    // the same extraction `ts_type_v1` and the reference `_split_fn_type` do. A
    // naive fixed `+3` offset assumes `)->` with no space and mis-slices the
    // spaced form (`> Async[…]`), so it uses the strip-`->`-strip form instead.
    let rest0 = py_strip(name.slice(arrow + 1, n))
    let returns = py_strip(rest0.slice(2, rest0.length()))
    var params = []
    if (inner != "") { params = split_type_args(inner) }
    var rendered = []
    var idx = 0
    for (p of params) {
      rendered = rendered.push(`a${idx}: ${ts_type(p)}`)
      idx += 1
    }
    return `((${rendered.join(", ")}) => ${ts_type(returns)})`
  }
  let bi = name.indexOf("[")
  if (bi >= 0) {
    let base = name.slice(0, bi)
    let inner = name.slice(bi + 1, last_index(name, "]"))
    let args = split_type_args(inner)
    if (base == "Opt") { return ts_type(args[0]).concat(" | undefined") }
    if (base == "List") { return ts_type(args[0]).concat("[]") }
    if (base == "Map") { return `Map<${ts_type(args[0])}, ${ts_type(args[1])}>` }
    if (base == "Result") {
      return `{ kind: "Ok"; value: ${ts_type(args[0])} } | { kind: "Err"; value: ${ts_type(args[1])} }`
    }
    if (base == "Async") { return `Promise<${ts_type(args[0])}>` }
    var us = []
    for (a of args) { us = us.push("unknown") }
    return base.concat("<").concat(us.join(", ")).concat(">")
  }
  return ident(name)
}

// A return-type slot: `None` -> "void", else the surface type.
fn ts_return_type(v: Any) -> Str {
  if (value_is_null(v)) { return "void" }
  return ts_type(value_str(v))
}

// The `_TS_V3_BIN_OPS` map: revl op -> JS op ("" for none).
fn ts_bin_op(op: Str) -> Str {
  if (op == "==") { return "===" }
  if (op == "===") { return "===" }
  if (op == "!=") { return "!==" }
  if (op == "!==") { return "!==" }
  if (op == "<") { return "<" }
  if (op == ">") { return ">" }
  if (op == "<=") { return "<=" }
  if (op == ">=") { return ">=" }
  if (op == "+") { return "+" }
  if (op == "-") { return "-" }
  if (op == "*") { return "*" }
  if (op == "/") { return "/" }
  if (op == "%") { return "%" }
  if (op == "&&") { return "&&" }
  if (op == "||") { return "||" }
  // Int32 bitwise operators (item 366, docs/arithmetic.md). Int32 is a JS
  // `number`, and JS's `& | ^ << >>` coerce to a signed 32-bit int, mask a
  // shift count to its low 5 bits (mod 32), and return a signed i32 `number` —
  // exactly the Int32 semantics, so no `revlI32` re-wrap is needed. `>>` is the
  // arithmetic (sign-propagating) shift (`>>>` would be logical).
  if (op == "&") { return "&" }
  if (op == "|") { return "|" }
  if (op == "^") { return "^" }
  if (op == "<<") { return "<<" }
  if (op == ">>") { return ">>" }
  return ""
}

fn is_equality_op(op: Str) -> Bool {
  return op == "==" || op == "===" || op == "!=" || op == "!=="
}

fn is_addsubmul(op: Str) -> Bool {
  return op == "+" || op == "-" || op == "*"
}

fn is_v3_atomic(node: Any) -> Bool {
  let k = node_kind(node)
  return k == "var" || k == "field" || k == "index" || k == "call" || k == "lit"
}

// `_is_float_expr`: syntactically-certain `number`.
fn is_float_expr(node: Any) -> Bool {
  let k = node_kind(node)
  if (k == "lit") { return value_kind(value_field(node, "value")) == "float" }
  if (k == "bin") { return node_op(node) == "/" || node_operands(node) == "Float" }
  if (k == "un") {
    if (node_op(node) != "-") { return false }
    return is_float_expr(value_field(node, "operand"))
  }
  return false
}

// -------------------------------------------------------------- expressions
// `_int_as_number`: an Int-typed expression rendered as the JS `number` an
// index/count API needs. A literal Int drops its `n`; anything else is `Number(…)`.
fn int_as_number(node: Any, counter: Int, acx: ACx) -> Rendered {
  if (node_kind(node) == "lit") {
    let v = value_field(node, "value")
    if (value_kind(v) == "int") { return { text: `${value_int(v)}`, counter: counter } }
  }
  let r = expr(node, counter, acx)
  return { text: `Number(${r.text})`, counter: r.counter }
}

// `_float_operand`: render so the result is a JS `number` (an Int that widened
// into a Float position goes through `Number(…)`).
fn float_operand(node: Any, counter: Int, acx: ACx) -> Rendered {
  if (node_kind(node) == "lit") {
    let v = value_field(node, "value")
    let vk = value_kind(v)
    if (vk == "int" || vk == "float") { return { text: json_dumps(v), counter: counter } }
  }
  let r = expr(node, counter, acx)
  if (is_float_expr(node)) { return r }
  return { text: `Number(${r.text})`, counter: r.counter }
}

// Render a call/field/index/builtin TARGET, parenthesised unless atomic.
fn paren_target(node: Any, counter: Int, acx: ACx) -> Rendered {
  let r = expr(node, counter, acx)
  if (is_v3_atomic(node)) { return r }
  return { text: `(${r.text})`, counter: r.counter }
}

fn commajoin(nodes: List[Any], counter: Int, acx: ACx) -> Rendered {
  // `render_seq` threads the counter through `expr` over each node in order
  // (item 195); the hand-rolled seed/loop/hand-back is now the combinator's.
  let r = render_seq(nodes, counter, (e, c) => expr(e, c, acx))
  return { text: r.texts.join(", "), counter: r.counter }
}

// `_v3_var`: a bare name. None -> undefined, the Some/Ok/Err constructors ->
// identity lambda, host roots -> host.<name>, otherwise the mangled name.
fn render_var(node: Any) -> Str {
  let nm = value_str(value_field(node, "name"))
  if (nm == "None") { return "undefined" }
  if (nm == "Some" || nm == "Ok" || nm == "Err") { return "((value) => value)" }
  if (nm == "Pool" || nm == "Map" || nm == "Job") { return "host.".concat(nm) }
  return ident(nm)
}

// `_literal`: null/bool are keywords, an Int literal is a BigInt literal (`123n`),
// a Float/Str literal renders through `json.dumps`. `literal_of` renders a RAW
// value (a config default, item-204 slice 2); `render_lit` reads the `value`
// field off a `lit` node.
fn literal_of(v: Any) -> Str {
  let vk = value_kind(v)
  if (vk == "null") { return "null" }
  if (vk == "bool") {
    if (value_bool(v)) { return "true" }
    return "false"
  }
  if (vk == "int") { return `${value_int(v)}n` }
  return json_dumps(v)
}

fn render_lit(node: Any) -> Str {
  return literal_of(value_field(node, "value"))
}

// `_ts_builtin`: the stdlib surface (docs/stdlib-2.0.md) as idiomatic TS. `args`
// are the pre-rendered argument texts; `arg_nodes`/`counter` are threaded so the
// `repeat` count can re-render through `_int_as_number`.
fn render_builtin(method: Str, target: Str, args: List[Str], arg_nodes: List[Any], recv: Str, counter: Int, acx: ACx) -> Rendered {
  if (method == "length") { return { text: `revlLen(${target})`, counter: counter } }
  if (method == "push") { return { text: `[...${target}, ${args[0]}]`, counter: counter } }
  if (method == "slice") { return { text: `revlSlice(${target}, ${args[0]}, ${args[1]})`, counter: counter } }
  if (method == "charAt") { return { text: `revlCharAt(${target}, ${args[0]})`, counter: counter } }
  if (method == "charCodeAt") { return { text: `revlCharCodeAt(${target}, ${args[0]})`, counter: counter } }
  if (method == "div_trunc") { return { text: `revlDivTrunc(${target}, ${args[0]})`, counter: counter } }
  if (method == "div_floor") { return { text: `revlDivFloor(${target}, ${args[0]})`, counter: counter } }
  if (method == "div_euclid") { return { text: `revlDivEuclid(${target}, ${args[0]})`, counter: counter } }
  if (method == "mod") { return { text: `revlMod(${target}, ${args[0]})`, counter: counter } }
  if (method == "checked_div_trunc") { return { text: `revlCheckedDivTrunc(${target}, ${args[0]})`, counter: counter } }
  if (method == "checked_div_floor") { return { text: `revlCheckedDivFloor(${target}, ${args[0]})`, counter: counter } }
  if (method == "checked_div_euclid") { return { text: `revlCheckedDivEuclid(${target}, ${args[0]})`, counter: counter } }
  if (method == "checked_mod") { return { text: `revlCheckedMod(${target}, ${args[0]})`, counter: counter } }
  if (method == "to_int") {
    if (recv == "Str") { return { text: `revlParseInt(${target})`, counter: counter } }
    return { text: `BigInt(${target})`, counter: counter }
  }
  if (method == "to_int32") { return { text: `revlI32(Number(${target}))`, counter: counter } }
  if (method == "concat") { return { text: `${target}.concat(${args[0]})`, counter: counter } }
  if (method == "indexOf") { return { text: `revlIndexOf(${target}, ${args[0]})`, counter: counter } }
  if (method == "split") { return { text: `${target}.split(${args[0]})`, counter: counter } }
  if (method == "join") { return { text: `${target}.join(${args[0]})`, counter: counter } }
  if (method == "repeat") {
    let r = int_as_number(arg_nodes[0], counter, acx)
    return { text: `${target}.repeat(${r.text})`, counter: r.counter }
  }
  if (method == "startsWith") { return { text: `${target}.startsWith(${args[0]})`, counter: counter } }
  if (method == "endsWith") { return { text: `${target}.endsWith(${args[0]})`, counter: counter } }
  if (method == "set") {
    return { text: `(() => { const c = new Map(${target}); c.set(${args[0]}, ${args[1]}); return c })()`, counter: counter }
  }
  if (method == "lookup") { return { text: `${target}.get(${args[0]})`, counter: counter } }
  if (method == "has") { return { text: `${target}.has(${args[0]})`, counter: counter } }
  if (method == "size") { return { text: `BigInt(${target}.size)`, counter: counter } }
  if (method == "keys") {
    return { text: `[...${target}.keys()].sort((a, b) => { const A = Array.from(a), B = Array.from(b); for (let i = 0; i < Math.min(A.length, B.length); i++) { if (A[i] !== B[i]) return A[i] < B[i] ? -1 : 1 } return A.length - B.length })`, counter: counter }
  }
  if (method == "remove") {
    return { text: `(() => { const c = new Map(${target}); c.delete(${args[0]}); return c })()`, counter: counter }
  }
  if (method == "to_str") { return { text: `${target}.toString()`, counter: counter } }
  return { text: `<<UNSUPPORTED-BUILTIN:${method}>>`, counter: counter }
}

// `_int_as_number`-guarded builtin arg positions (`_TS_INT_ARG_BUILTINS`).
fn optcall_arg_is_int(method: Str, index: Int) -> Bool {
  if (method == "slice") { return index == 0 || index == 1 }
  if (method == "charAt") { return index == 0 }
  if (method == "charCodeAt") { return index == 0 }
  if (method == "repeat") { return index == 0 }
  return false
}

fn optcall_result_is_int(method: Str) -> Bool {
  return method == "length" || method == "indexOf" || method == "charCodeAt"
}

// `_renders_await`: does a RENDERED fragment carry an `await` operator? Item
// 435(a)/(b) makes the async colour follow the rendered text instead of the
// enclosing function, and this is the whole predicate. The reference tests the
// literal `"await "` rather than a word-boundary regex for exactly this
// reason: every `await` either emitter writes is followed by a space, and
// this port has no regex engine. It errs only towards KEEPING `async` (a
// stray `await ` inside a string literal, or one inside a nested async arrow
// that flattens its own Promise), which is the pre-435 shape.
fn renders_await(text: Str) -> Bool { return text.indexOf("await ") >= 0 }

// `_v3_emission_call_node`: is this node a call to an ASYNC service operation
// through a `req`? That is the one expression either emitter renders as a
// bare, un-awaited Promise. `render_call`'s await-seed is suppressed inside an
// arrow (`in_async && !in_arrow`). Item 435(b) needs to tell it apart from a
// body that evaluates to a plain value, because dropping `async` from an arrow
// is only type-preserving when the body already IS the Promise the arrow was
// going to return. The reference resolves `scope.requires[name]` against its
// doc-level `async_ops`; here `acx.ops` is that set already pre-resolved to
// `"<reqKey>#<op>"` keys, so the membership test is the same question.
fn emission_call_node(node: Any, acx: ACx) -> Bool {
  if (node_kind(node) != "call") { return false }
  if (!value_has(node, "target")) { return false }
  let target = value_field(node, "target")
  if (node_kind(target) != "req") { return false }
  let key = async_op_key(value_str(value_field(target, "name")), value_str(value_field(node, "method")))
  return list_contains(acx.ops, key)
}

// `_v3_match_expr`: the match lowering. Opt (Some/None) discriminates on
// `undefined`; a tagged ADT switches on `.kind`.
//
// Item 435(a): the async colour is per-EXPRESSION, not per-function.
// `acx.in_async` is true for the whole body of an async-coloured fn, so
// colouring by it alone wrapped a match whose every arm is a bound variable or
// a literal in a Promise that was allocated, resolved and awaited around a
// value already in hand (measured at 2 excess microtask turns and 4 excess
// Promise allocations per evaluation). A binding arm-arrow is now `async` only
// when THAT arm's rendered body carries an `await`, and the IIFE only when the
// assembled body does; `pre`/`post_tail` follow the same decision. In a sync
// body they all collapse to `""`, leaving the slice-1..4 output byte-identical.
//
// `colour_by_text` is false inside an ARROW, where the unconditional colour
// stays: the await-seed is deliberately suppressed there (`in_async &&
// !in_arrow` in `render_call`), so an arm body can be an un-awaited Promise
// with no `await` in its text and the arm arrow's own `async`/`await` pair is
// what resolves it. Mirrors the reference exactly.
fn match_expr(node: Any, counter: Int, acx: ACx) -> Rendered {
  let c0 = counter + 1
  let tmp = `$revl_match_${c0}`
  let sr = expr(value_field(node, "scrutinee"), c0, acx)
  var c = sr.counter
  let arms = value_list(value_field(node, "arms"))
  var is_opt = false
  for (arm of arms) {
    let p = value_str(value_field(arm, "pattern"))
    if (p == "Some" || p == "None") { is_opt = true }
  }
  let colour_by_text = acx.in_async && !acx.in_arrow
  var lines = []
  if (is_opt) {
    var wildcard = ""
    var has_wild = false
    for (arm of arms) {
      let pattern = value_str(value_field(arm, "pattern"))
      let br = expr(value_field(arm, "body"), c, acx)
      c = br.counter
      let body = br.text
      if (pattern == "_") {
        wildcard = `  return (${body})`
        has_wild = true
      } else {
        if (pattern == "None") {
          lines = lines.push(`  if (${tmp} === undefined) return (${body})`)
        } else {
          let bind = value_str(value_field(arm, "bind"))
          if (bind != "") {
            let b = ident(bind)
            if (arm_is_async(body, acx, colour_by_text)) {
              lines = lines.push(`  if (${tmp} !== undefined) return (await (async (${b}) => (${body}))(${tmp}))`)
            } else {
              lines = lines.push(`  if (${tmp} !== undefined) return ((${b}) => (${body}))(${tmp})`)
            }
          } else {
            lines = lines.push(`  if (${tmp} !== undefined) return (${body})`)
          }
        }
      }
    }
    if (has_wild) { lines = lines.push(wildcard) }
    else { lines = lines.push(`  throw new TypeError("non-exhaustive match")`) }
    return { text: wrap_match(lines, tmp, sr.text, acx, colour_by_text), counter: c }
  }
  lines = lines.push(`  switch (${tmp}.kind) {`)
  var wildcard = ""
  var has_wild = false
  for (arm of arms) {
    let pattern = value_str(value_field(arm, "pattern"))
    let br = expr(value_field(arm, "body"), c, acx)
    c = br.counter
    let body = br.text
    if (pattern == "_") {
      wildcard = `      return (${body})`
      has_wild = true
    } else {
      let cs = ident(pattern)
      lines = lines.push(`    case ${json_dumps(cs)}:`)
      let bind = value_str(value_field(arm, "bind"))
      if (bind != "") {
        let b = ident(bind)
        if (arm_is_async(body, acx, colour_by_text)) {
          lines = lines.push(`      return (await (async (${b}) => (${body}))(${tmp}.value))`)
        } else {
          lines = lines.push(`      return ((${b}) => (${body}))(${tmp}.value)`)
        }
      } else {
        lines = lines.push(`      return (${body})`)
      }
    }
  }
  if (has_wild) {
    lines = lines.push(`    default:`)
    lines = lines.push(wildcard)
  } else {
    lines = lines.push(`    default:`)
    lines = lines.push(`      throw new TypeError("non-exhaustive match")`)
  }
  lines = lines.push(`  }`)
  return { text: wrap_match(lines, tmp, sr.text, acx, colour_by_text), counter: c }
}

// One binding arm-arrow's colour (item 435(a)): async only when the arm's own
// rendered body carries an `await`, except inside an arrow where the colour
// stays unconditional.
fn arm_is_async(body: Str, acx: ACx, colour_by_text: Bool) -> Bool {
  if (!acx.in_async) { return false }
  return !colour_by_text || renders_await(body)
}

// The IIFE around the assembled arm lines. `(await ( <fn> )( <scrut> ))` when
// async: the await wraps the whole INVOCATION, not the function object. Else
// the plain `( <fn> )( <scrut> )`.
fn wrap_match(lines: List[Str], tmp: Str, scrutinee: Str, acx: ACx, colour_by_text: Bool) -> Str {
  var outer = false
  if (acx.in_async) { outer = !colour_by_text || renders_await(lines.join(newline())) }
  var a = ""
  var pre = "("
  var post_tail = ""
  if (outer) {
    a = "async "
    pre = "(await ("
    post_tail = ")"
  }
  var out = [`${pre}${a}(${tmp}) => {`]
  for (l of lines) { out = out.push(l) }
  out = out.push(`})(${scrutinee})${post_tail}`)
  return out.join(newline())
}

// `_expr`'s `bin` branch.
fn render_bin(node: Any, counter: Int, acx: ACx) -> Rendered {
  let op = node_op(node)
  if (op == "??") {
    let l = expr(value_field(node, "left"), counter, acx)
    let r = expr(value_field(node, "right"), l.counter, acx)
    return { text: `(${l.text} ?? ${r.text})`, counter: r.counter }
  }
  if (is_equality_op(op)) {
    let l = expr(value_field(node, "left"), counter, acx)
    let r = expr(value_field(node, "right"), l.counter, acx)
    let call = `revlEq(${l.text}, ${r.text})`
    if (op == "==" || op == "===") { return { text: call, counter: r.counter } }
    return { text: `(!${call})`, counter: r.counter }
  }
  let jop = ts_bin_op(op)
  let opnd = node_operands(node)
  if (op == "/") {
    let l = float_operand(value_field(node, "left"), counter, acx)
    let r = float_operand(value_field(node, "right"), l.counter, acx)
    return { text: `(${l.text} / ${r.text})`, counter: r.counter }
  }
  if (opnd == "Float") {
    let l = float_operand(value_field(node, "left"), counter, acx)
    let r = float_operand(value_field(node, "right"), l.counter, acx)
    return { text: `(${l.text} ${jop} ${r.text})`, counter: r.counter }
  }
  let l = expr(value_field(node, "left"), counter, acx)
  let r = expr(value_field(node, "right"), l.counter, acx)
  if (is_addsubmul(op) && opnd == "Int") {
    return { text: `revlI64(${l.text} ${jop} ${r.text})`, counter: r.counter }
  }
  if (is_addsubmul(op) && opnd == "Int32") {
    return { text: `revlI32(${l.text} ${jop} ${r.text})`, counter: r.counter }
  }
  return { text: `(${l.text} ${jop} ${r.text})`, counter: r.counter }
}

fn render_un(node: Any, counter: Int, acx: ACx) -> Rendered {
  let r = expr(value_field(node, "operand"), counter, acx)
  let op = node_op(node)
  if (op == "!") { return { text: `(!${r.text})`, counter: r.counter } }
  if (op == "~") {
    // Int32 bitwise complement (item 366): JS `~` returns a signed i32
    // `number`, so it needs no re-wrap and never traps.
    return { text: `(~${r.text})`, counter: r.counter }
  }
  if (op == "-") {
    let opnd = node_operands(node)
    if (opnd == "Int") { return { text: `revlI64(-${r.text})`, counter: r.counter } }
    if (opnd == "Int32") { return { text: `revlI32(-${r.text})`, counter: r.counter } }
    return { text: `(-${r.text})`, counter: r.counter }
  }
  return { text: `<<UNSUPPORTED-UN:${op}>>`, counter: r.counter }
}

fn render_record(fields: List[Any], counter: Int, acx: ACx) -> Rendered {
  var parts = []
  var c = counter
  for (p of fields) {
    let vr = expr(value_at(p, 1), c, acx)
    c = vr.counter
    parts = parts.push(`${ident(value_str(value_at(p, 0)))}: ${vr.text}`)
  }
  return { text: "{".concat(parts.join(", ")).concat("}"), counter: c }
}

fn render_record_update(node: Any, counter: Int, acx: ACx) -> Rendered {
  let base = expr(value_field(node, "base"), counter, acx)
  var c = base.counter
  var parts = []
  for (u of value_list(value_field(node, "updates"))) {
    let vr = expr(value_at(u, 1), c, acx)
    c = vr.counter
    parts = parts.push(`${ident(value_str(value_at(u, 0)))}: ${vr.text}`)
  }
  let overrides = parts.join(", ")
  if (overrides == "") {
    return { text: "{ ...".concat(base.text).concat(" }"), counter: c }
  }
  return { text: "{ ...".concat(base.text).concat(", ").concat(overrides).concat(" }"), counter: c }
}

fn render_list(items: List[Any], counter: Int, acx: ACx) -> Rendered {
  let r = commajoin(items, counter, acx)
  return { text: "[".concat(r.text).concat("]"), counter: r.counter }
}

fn render_arrow(node: Any, counter: Int, acx: ACx) -> Rendered {
  let names = value_list(value_field(node, "params"))
  let declared = value_list(value_field(node, "param_types"))
  var parts = []
  var i = 0
  for (p of names) {
    var t = "any"
    if (i < declared.length()) {
      let dt = declared[i]
      if (value_kind(dt) == "str") {
        let ds = value_str(dt)
        if (ds != "Any" && ds != "Never") { t = ts_type(ds) }
      }
    }
    parts = parts.push(`${ident(value_str(p))}: ${t}`)
    i += 1
  }
  let params = parts.join(", ")
  var is_async = value_bool(value_field(node, "async"))
  // An arrow body renders in its OWN async context: `in_async` = the arrow's
  // color (NOT the enclosing body's — inheriting it would let an `await` land in
  // a sync arrow, a tsc error), and `in_arrow` becomes true so the await-seed
  // stays out of the arrow (its Promise flattens). `async_names`/`async_locals`
  // are inherited (the reference's `with_scope` leaves them untouched), so an
  // async callable invoked inside an async arrow is still awaited.
  let body_acx = { in_async: is_async, in_arrow: true, ops: acx.ops, async_names: acx.async_names, async_locals: acx.async_locals }
  let br = expr(value_field(node, "body"), counter, body_acx)
  // Item 435(b): the `async` followed the DECLARED type, so `(msgs) =>
  // model.complete(msgs)` rendered `async (msgs: any) =>
  // (ctx.model.complete(msgs))`, a resolution hop over a Promise the body
  // already returns (2 excess microtask turns and 2 excess Promise allocations
  // per operation call). Drop the keyword when the body renders no `await` AND
  // the body IS that un-awaited emission Promise: `async (p) => e` and `(p) =>
  // e` then carry the identical TS type `(p) => Promise<T>`, so the arrow stays
  // assignable wherever it was. Any other body keeps `async`, because an arrow
  // over a plain value would return `T` where the slot's type says `Promise<T>`.
  if (is_async && !renders_await(br.text) && emission_call_node(value_field(node, "body"), body_acx)) {
    is_async = false
  }
  var prefix = ""
  if (is_async) { prefix = "async " }
  let captures = value_list(value_field(node, "captures"))
  if (captures.length() > 0) {
    var bound = []
    var argn = []
    for (cn of captures) {
      let cm = ident(value_str(cn))
      bound = bound.push(`${cm}: any`)
      argn = argn.push(cm)
    }
    let text = `((${bound.join(", ")}) => (${prefix}(${params}) => (${br.text})))(${argn.join(", ")})`
    return { text: text, counter: br.counter }
  }
  return { text: `(${prefix}(${params}) => (${br.text}))`, counter: br.counter }
}

fn render_interp(parts: List[Any], counter: Int, acx: ACx) -> Rendered {
  var segs = ["`"]
  var c = counter
  for (p of parts) {
    let k = value_str(value_at(p, 0))
    let v = value_at(p, 1)
    if (k == "text") {
      segs = segs.push(template_text(v))
    } else {
      let r = expr(v, c, acx)
      c = r.counter
      segs = segs.push("${".concat(r.text).concat("}"))
    }
  }
  segs = segs.push("`")
  return { text: segs.join(""), counter: c }
}

fn is_digit(ch: Str) -> Bool {
  if (ch.length() == 0) { return false }
  let x = ch.charCodeAt(0)
  return x >= 48 && x <= 57
}

// `int(match.group(1))` — a run of ASCII digits to its Int value.
fn parse_index(s: Str) -> Int {
  var acc = 0
  var i = 0
  while (i < s.length()) {
    acc = acc * 10 + (s.charCodeAt(i) - 48)
    i += 1
  }
  return acc
}

// `_expr`'s `format` branch: scan the template for `re.finditer(r"\$\$|\$(\d+)")`
// matches (left to right, non-overlapping, `$$` tried before `$N`), escaping the
// literal runs between them with `template_text` and splicing each placeholder's
// pre-rendered arg into a `${…}` slot. A lone `$` before a non-`$`/non-digit is
// left as literal text — exactly what the regex leaves unmatched.
fn render_format(node: Any, counter: Int, acx: ACx) -> Rendered {
  let template = value_str(value_field(node, "template"))
  var argtexts = []
  var c = counter
  for (a of value_list(value_field(node, "args"))) {
    let r = expr(a, c, acx)
    argtexts = argtexts.push(r.text)
    c = r.counter
  }
  var out = []
  var pos = 0
  var i = 0
  let n = template.length()
  while (i < n) {
    var matched = false
    if (template.charAt(i) == "$") {
      if (i + 1 < n && template.charAt(i + 1) == "$") {
        out = out.push(template_text(template.slice(pos, i)))
        out = out.push("$")
        pos = i + 2
        i = i + 2
        matched = true
      } else {
        var j = i + 1
        while (j < n && is_digit(template.charAt(j))) { j += 1 }
        if (j > i + 1) {
          out = out.push(template_text(template.slice(pos, i)))
          let index = parse_index(template.slice(i + 1, j))
          out = out.push("${".concat(argtexts[index]).concat("}"))
          pos = j
          i = j
          matched = true
        }
      }
    }
    if (!matched) { i += 1 }
  }
  out = out.push(template_text(template.slice(pos, n)))
  return { text: "`".concat(out.join("")).concat("`"), counter: c }
}

// The component-dialect atomic set (`_ATOMIC_KINDS`) — a component `call`
// target is parenthesised UNLESS its kind is one of these (distinct from the
// 2.0 `is_v3_atomic` set: `req`/`config`/`name`/`host` are atomic here).
fn is_component_atomic(node: Any) -> Bool {
  let k = node_kind(node)
  return k == "name" || k == "config" || k == "req" || k == "call"
    || k == "host" || k == "instance-get"
}

fn render_call(node: Any, counter: Int, acx: ACx) -> Rendered {
  // `call` exists in BOTH dialects with different shapes (the reference's one
  // renderer dispatches on SHAPE, never on kind): the component form carries a
  // `target`/`method` (a method call on a service — `ctx.<key>.<op>(…)`), the
  // 2.0 form a `callee`/`args`.
  if (value_has(node, "target")) {
    let target = value_field(node, "target")
    let tr = expr(target, counter, acx)
    var t = tr.text
    if (!is_component_atomic(target)) { t = `(${t})` }
    let method = ident(value_str(value_field(node, "method")))
    let ar = commajoin(value_list(value_field(node, "args")), tr.counter, acx)
    let rendered = `${t}.${method}(${ar.text})`
    // item 141 await-seed: an async service op reached through a req key returns
    // a Promise on this tier. Await it wherever it lands in an async body —
    // return, let value, or a NESTED position (a ternary arm, a template) — so
    // no Promise leaks un-awaited. `in_async` gates it to async provide methods;
    // `!in_arrow` keeps it out of arrow bodies (their Promise flattens). Keyed
    // on the RAW method name (the async_ops set holds raw names; a reserved op
    // name would be `_ident`-mangled at the call and is out of the slice).
    if (acx.in_async && !acx.in_arrow && node_kind(target) == "req") {
      let key = async_op_key(value_str(value_field(target, "name")), value_str(value_field(node, "method")))
      if (list_contains(acx.ops, key)) {
        return { text: `(await ${rendered})`, counter: ar.counter }
      }
    }
    return { text: rendered, counter: ar.counter }
  }
  let callee_node = value_field(node, "callee")
  let cr = expr(callee_node, counter, acx)
  var callee = cr.text
  if (!is_v3_atomic(callee_node)) { callee = `(${callee})` }
  let ar = commajoin(value_list(value_field(node, "args")), cr.counter, acx)
  let call = `${callee}(${ar.text})`
  // The 2.0 var-callee async path (item 80 / docs/design/async-extern.md §5): a
  // `var`-callee naming an async extern (`async_names`) or an async-value
  // parameter (`async_locals`) returns a Promise, so it is awaited — parenthesized
  // so it stays atomic in a larger expression (`f(x) + 1` -> `(await f(x)) + 1`).
  // Keyed on the RAW callee name (the sets hold raw names), mirroring the
  // reference. The frontend admits such a call only in an async body, so the
  // await is gated on `in_async`; a sync body never renders one.
  if (node_kind(callee_node) == "var" && acx.in_async) {
    let cname = value_str(value_field(callee_node, "name"))
    if (list_contains(acx.async_names, cname) || list_contains(acx.async_locals, cname)) {
      return { text: `(await ${call})`, counter: ar.counter }
    }
  }
  return { text: call, counter: ar.counter }
}

fn render_builtin_node(node: Any, counter: Int, acx: ACx) -> Rendered {
  let tr = paren_target(value_field(node, "target"), counter, acx)
  var c = tr.counter
  let arg_nodes = value_list(value_field(node, "args"))
  var argtexts = []
  for (a of arg_nodes) {
    let r = expr(a, c, acx)
    argtexts = argtexts.push(r.text)
    c = r.counter
  }
  return render_builtin(node_method(node), tr.text, argtexts, arg_nodes, value_str(value_field(node, "recv")), c, acx)
}

fn render_optcall(node: Any, counter: Int, acx: ACx) -> Rendered {
  let tr = paren_target(value_field(node, "target"), counter, acx)
  var c = tr.counter
  let method = value_str(value_field(node, "method"))
  let arg_nodes = value_list(value_field(node, "args"))
  var argtexts = []
  var idx = 0
  for (a of arg_nodes) {
    if (optcall_arg_is_int(method, idx)) {
      let r = int_as_number(a, c, acx)
      argtexts = argtexts.push(r.text)
      c = r.counter
    } else {
      let r = expr(a, c, acx)
      argtexts = argtexts.push(r.text)
      c = r.counter
    }
    idx += 1
  }
  let call = `${tr.text}?.${ident(method)}(${argtexts.join(", ")})`
  if (optcall_result_is_int(method)) {
    return { text: `((v: number | undefined) => v === undefined ? undefined : BigInt(v))(${call})`, counter: c }
  }
  return { text: call, counter: c }
}

// The kind dispatch (post-widen), mirroring `_expr`'s branch order for the 2.0
// dialect; the component-only kinds refuse (no component scope in this slice).
fn expr_inner(node: Any, counter: Int, acx: ACx) -> Rendered {
  let kind = node_kind(node)
  if (kind == "lit") { return { text: render_lit(node), counter: counter } }
  if (kind == "var") { return { text: render_var(node), counter: counter } }
  if (kind == "record") { return render_record(value_list(value_field(node, "fields")), counter, acx) }
  if (kind == "record_update") { return render_record_update(node, counter, acx) }
  if (kind == "list") { return render_list(value_list(value_field(node, "items")), counter, acx) }
  if (kind == "maplit") { return { text: "new Map()", counter: counter } }
  if (kind == "call") { return render_call(node, counter, acx) }
  if (kind == "bin") { return render_bin(node, counter, acx) }
  if (kind == "un") { return render_un(node, counter, acx) }
  if (kind == "field") {
    let tr = paren_target(value_field(node, "target"), counter, acx)
    return { text: `${tr.text}.${ident(value_str(value_field(node, "name")))}`, counter: tr.counter }
  }
  if (kind == "index") {
    let tr = paren_target(value_field(node, "target"), counter, acx)
    let ir = int_as_number(value_field(node, "index"), tr.counter, acx)
    return { text: `${tr.text}[${ir.text}]`, counter: ir.counter }
  }
  if (kind == "len") {
    let tr = paren_target(value_field(node, "target"), counter, acx)
    return { text: `revlLen(${tr.text})`, counter: tr.counter }
  }
  if (kind == "builtin") { return render_builtin_node(node, counter, acx) }
  if (kind == "if") {
    let cr = expr(value_field(node, "cond"), counter, acx)
    let tr = expr(value_field(node, "then"), cr.counter, acx)
    let er = expr(value_field(node, "else"), tr.counter, acx)
    return { text: `(${cr.text} ? ${tr.text} : ${er.text})`, counter: er.counter }
  }
  if (kind == "arrow") { return render_arrow(node, counter, acx) }
  if (kind == "match") { return match_expr(node, counter, acx) }
  if (kind == "interp") { return render_interp(value_list(value_field(node, "parts")), counter, acx) }
  if (kind == "optfield") {
    let tr = paren_target(value_field(node, "target"), counter, acx)
    return { text: `${tr.text}?.${ident(value_str(value_field(node, "name")))}`, counter: tr.counter }
  }
  if (kind == "optcall") { return render_optcall(node, counter, acx) }
  // ---- component (v1) dialect scalar kinds (slice 2) ----
  // The reference validates each against the component `_Scope` (locals /
  // config_fields / requires); validation is deferred here exactly as `ident`
  // defers emitter-scaffolding rejection — the covered corpus is clean — so
  // these render the happy-path text only. `host`/`format`/`fn`/`adt` join below
  // (slice 3); the routed-`req` proxy stays deferred.
  if (kind == "name") {
    return { text: ident(value_str(value_field(node, "id"))), counter: counter }
  }
  if (kind == "config") {
    return { text: "config.".concat(ident(value_str(value_field(node, "field")))), counter: counter }
  }
  if (kind == "req") {
    // Committed-view access: resolved through the fiber's snapshot (R3).
    return { text: "ctx.".concat(ident(value_str(value_field(node, "name")))), counter: counter }
  }
  // ---- slice-3 expr kinds ----
  // `fn` (`_fn_call`): a call to a top-level `fn`/`extern`, the component
  // dialect's spelling of what a 2.0 body writes as a `var`-callee `call`.
  // Validation (declared? async?) is deferred like `ident`; async awaiting is
  // deferred entirely (slice 3 defers async coloring).
  if (kind == "fn") {
    let fname = ident(value_str(value_field(node, "name")))
    let ar = commajoin(value_list(value_field(node, "args")), counter, acx)
    return { text: `${fname}(${ar.text})`, counter: ar.counter }
  }
  // `adt`: a tagged ADT value (Result / user variant), `{ kind: "Ok", value: x }`
  // or `{ kind: "Missing" }`. Opt's Some/None is NOT tagged (rendered by `var`).
  if (kind == "adt") {
    let cs = json_dumps(value_str(value_field(node, "case")))
    let args = value_list(value_field(node, "args"))
    if (args.length() > 0) {
      let r = expr(args[0], counter, acx)
      return { text: `{ kind: ${cs}, value: ${r.text} }`, counter: r.counter }
    }
    return { text: `{ kind: ${cs} }`, counter: counter }
  }
  // `host`: a host builtin acquisition (`Pool.open`/`Job.run`/…). The dotted
  // `fn` path is host-validated upstream (IDENT_RE); rendered verbatim, NOT
  // mangled.
  if (kind == "host") {
    let hfn = value_str(value_field(node, "fn"))
    let ar = commajoin(value_list(value_field(node, "args")), counter, acx)
    return { text: `host.${hfn}(${ar.text})`, counter: ar.counter }
  }
  // `format` (v1/A4): the component-dialect string interpolation, spelled with
  // `$N` placeholders and `$$` escapes over a template — lowered to a JS
  // template literal, the v1 twin of the 2.0 `interp`.
  if (kind == "format") { return render_format(node, counter, acx) }
  // `spawn` (docs/design-v2-instances.md): an acquisition that plugs the target
  // component as a child fiber, each provided key isolated into its own fresh
  // LOCAL realm — `spawn(ctx, Worker, {config}, [realms])` returns a disposable
  // handle whose `undo` tears the child fiber down. `component` is emitted
  // VERBATIM (a module-level plugin binding, not a mangled ident); `config` is a
  // key->expr map; `realms` a static string list.
  if (kind == "spawn") {
    let target = value_str(value_field(node, "component"))
    let cfg = value_field(node, "config")
    var cfg_parts = []
    var c = counter
    for (k of value_keys(cfg)) {
      let r = expr(value_field(cfg, k), c, acx)
      cfg_parts = cfg_parts.push(`${json_dumps(k)}: ${r.text}`)
      c = r.counter
    }
    var realm_parts = []
    for (rl of value_list(value_field(node, "realms"))) {
      realm_parts = realm_parts.push(json_dumps(value_str(rl)))
    }
    return { text: `spawn(ctx, ${target}, {${cfg_parts.join(", ")}}, [${realm_parts.join(", ")}])`, counter: c }
  }
  // `instance-get` (docs/design-v2-instances.md): `s.<key>` reads a provision
  // back off a spawn handle — `<target>.get("<key>")`, resolving the key through
  // the instance's own private local realm. `service` is frozen inline on the
  // node but needs no emission (cordis exposes the provision by key).
  if (kind == "instance-get") {
    let r = expr(value_field(node, "target"), counter, acx)
    let key = value_str(value_field(node, "key"))
    return { text: `${r.text}.get(${json_dumps(key)})`, counter: r.counter }
  }
  return { text: `<<UNSUPPORTED-EXPR:${kind}>>`, counter: counter }
}

// The implicit widen markers (docs/arithmetic.md): Int -> Float is `Number(…)`,
// Int32 -> Int is `BigInt(…)`, then dispatch the un-widened node. `acx` carries
// the async-colouring context (item 219) down to the await-seed in `render_call`.
fn expr(node: Any, counter: Int, acx: ACx) -> Rendered {
  let w = value_str(value_field(node, "widen"))
  if (w == "Float") {
    let r = expr_inner(node, counter, acx)
    return { text: `Number(${r.text})`, counter: r.counter }
  }
  if (w == "Int") {
    let r = expr_inner(node, counter, acx)
    return { text: `BigInt(${r.text})`, counter: r.counter }
  }
  return expr_inner(node, counter, acx)
}

// ------------------------------------- the self-rebind (unique) lowering
// `_ts_inplace_write` / `_ts_inplace_stmt`, roadmap item 435 (d) on item 445's
// frontend marker.
//
// `xs = xs.push(e)` renders `[...xs, e]` — the correct rendering of a
// PERSISTENT write, and a quadratic for the loop idiom, where the receiver is
// dead the instant the assignment lands. The proof that the copy is
// unobservable is an aliasing question about the SOURCE, so it is not here: it
// runs once in the frontend (`src/revl/ownership.py`) and rides the IR.
//
//   `assign` step, `"unique": true` — the binding owns its object outright at
//                                     this write, so the in-place call is the
//                                     faithful lowering.
//
// Absence means "not proven", which keeps the spread, which is always correct.
// `"unique": "copy"` is NOT honoured on this tier: its `unique_birth` shape is
// `"List"` or `"Map"`, and `"Map"` covers both a revl `Map` (a JS `Map` here)
// and a record update (a plain object here), so the birth copy the marker is
// conditional on has no single spelling. `value_bool` answers `false` for the
// string `"copy"`, which is exactly the test this needs.
fn is_inplace_write(node: Any) -> Bool {
  if (value_str(value_field(node, "step")) != "assign") { return false }
  if (!value_bool(value_field(node, "unique"))) { return false }
  let value = value_field(node, "value")
  if (node_kind(value) == "record_update") { return true }
  if (node_kind(value) != "builtin") { return false }
  let m = value_str(value_field(value, "method"))
  let n = value_list(value_field(value, "args")).length()
  if (m == "push") { return n == 1 }
  if (m == "set") { return n == 2 }
  if (m == "remove") { return n == 1 }
  return false
}

// the in-place statement replacing a proven-unique persistent copy; operand
// evaluation order matches the copying form it replaces
fn inplace_stmt(name: Str, value: Any, counter: Int, acx: ACx) -> Rendered {
  if (node_kind(value) == "record_update") {
    // `Object.assign` builds the whole override object BEFORE writing any of
    // it, so a swap stays simultaneous exactly as the `{ ...p, .. }` spread was
    var c = counter
    var parts = []
    for (u of value_list(value_field(value, "updates"))) {
      let vr = expr(value_at(u, 1), c, acx)
      c = vr.counter
      parts = parts.push(`${ident(value_str(value_at(u, 0)))}: ${vr.text}`)
    }
    return { text: `Object.assign(${name}, { ${parts.join(", ")} })`, counter: c }
  }
  let args = value_list(value_field(value, "args"))
  let method = value_str(value_field(value, "method"))
  let a0 = expr(args[0], counter, acx)
  if (method == "push") { return { text: `${name}.push(${a0.text})`, counter: a0.counter } }
  if (method == "set") {
    let a1 = expr(args[1], a0.counter, acx)
    return { text: `${name}.set(${a0.text}, ${a1.text})`, counter: a1.counter }
  }
  // `Map.remove` is TOTAL (an absent key is not an error) and `Map.delete`
  // answers a discarded boolean rather than throwing, so it is exact.
  return { text: `${name}.delete(${a0.text})`, counter: a0.counter }
}

// -------------------------------------------------------------- statements
// `_v3_stmt` (test_mode = false): one fn-body step -> its emitted lines.
fn v3_stmt(node: Any, indent: Int, counter: Int, acx: ACx) -> StmtOut {
  let step = value_str(value_field(node, "step"))
  let pad = ind(indent)
  // The async-colouring context flows in from `emit_functions`: `sync_acx()` for
  // a plain fn, or an `in_async` context for a phase-2 async-colored fn, so a
  // call to an async callable inside the body (return / let / branch) is awaited.
  let a = acx
  if (step == "let") {
    let r = expr(value_field(node, "value"), counter, a)
    var kw = "const"
    if (value_bool(value_field(node, "mutable"))) { kw = "let" }
    return { lines: [`${pad}${kw} ${ident(value_str(value_field(node, "name")))} = ${r.text}`], counter: r.counter }
  }
  if (step == "assign") {
    let nm = ident(value_str(value_field(node, "name")))
    if (is_inplace_write(node)) {
      let w = inplace_stmt(nm, value_field(node, "value"), counter, a)
      return { lines: [`${pad}${w.text}`], counter: w.counter }
    }
    let r = expr(value_field(node, "value"), counter, a)
    return { lines: [`${pad}${nm} = ${r.text}`], counter: r.counter }
  }
  if (step == "return") {
    let e = value_field(node, "expr")
    if (value_is_null(e)) { return { lines: [`${pad}return`], counter: counter } }
    let r = expr(e, counter, a)
    return { lines: [`${pad}return ${r.text}`], counter: r.counter }
  }
  if (step == "if") {
    let cr = expr(value_field(node, "cond"), counter, a)
    var out = [`${pad}if (${cr.text}) {`]
    var c = cr.counter
    for (s of value_list(value_field(node, "then"))) {
      let r = v3_stmt(s, indent + 1, c, acx)
      out = out.concat(r.lines)
      c = r.counter
    }
    let els = value_list(value_field(node, "else"))
    if (els.length() > 0) {
      out = out.push(`${pad}} else {`)
      for (s of els) {
        let r = v3_stmt(s, indent + 1, c, acx)
        out = out.concat(r.lines)
        c = r.counter
      }
    }
    out = out.push(`${pad}}`)
    return { lines: out, counter: c }
  }
  if (step == "while") {
    let cr = expr(value_field(node, "cond"), counter, a)
    var out = [`${pad}while (${cr.text}) {`]
    var c = cr.counter
    for (s of value_list(value_field(node, "body"))) {
      let r = v3_stmt(s, indent + 1, c, acx)
      out = out.concat(r.lines)
      c = r.counter
    }
    out = out.push(`${pad}}`)
    return { lines: out, counter: c }
  }
  if (step == "for") {
    let ir = expr(value_field(node, "iterable"), counter, a)
    let bind = ident(value_str(value_field(node, "bind")))
    var out = [`${pad}for (const ${bind} of ${ir.text}) {`]
    var c = ir.counter
    for (s of value_list(value_field(node, "body"))) {
      let r = v3_stmt(s, indent + 1, c, acx)
      out = out.concat(r.lines)
      c = r.counter
    }
    out = out.push(`${pad}}`)
    return { lines: out, counter: c }
  }
  if (step == "expr") {
    let r = expr(value_field(node, "expr"), counter, a)
    return { lines: [`${pad}${r.text}`], counter: r.counter }
  }
  // item 379 / 391: bare loop control -> the host keyword (frame-neutral).
  if (step == "break") { return { lines: [`${pad}break`], counter: counter } }
  if (step == "continue") { return { lines: [`${pad}continue`], counter: counter } }
  return { lines: [`${pad}<<UNSUPPORTED-STEP:${step}>>`], counter: counter }
}

// `_emit_ts_functions`: each module fn as an exported TS `function`,
// blank-line separated. The `$revl_match_N` counter threads across the whole
// document (one `_Ctx` counter in the reference).
fn emit_functions(functions: List[Any], async_names: List[Str]) -> List[Str] {
  var out = []
  var c = 0
  for (fnode of functions) {
    let name = ident(value_str(value_field(fnode, "name")))
    var parts = []
    // A parameter typed `(…) -> Async[T]` is an async value local (item 92): a
    // call through it returns a Promise and is awaited in the body. Collect
    // those names as the body's `async_locals`, keyed RAW to match the
    // var-callee comparison.
    var locals = []
    for (p of value_list(value_field(fnode, "params"))) {
      let ptype = value_str(value_field(p, "type"))
      parts = parts.push(`${ident(value_str(value_field(p, "name")))}: ${ts_type(ptype)}`)
      if (is_async_fn_type(ptype)) { locals = locals.push(value_str(value_field(p, "name"))) }
    }
    let params = parts.join(", ")
    let returns = ts_return_type(value_field(fnode, "returns"))
    // A phase-2 async-colored fn (docs/design/async-extern.md §3) emits as
    // `export async function …: Promise<T>`, its body rendered in an async
    // context so every call to an async callable is awaited. The color was
    // decided by the frontend fixed point and stamped on the IR entry; the
    // emitter only reads `.async`, mirroring the extern signature form.
    var body_acx = sync_acx()
    if (value_bool(value_field(fnode, "async"))) {
      body_acx = { in_async: true, in_arrow: false, ops: [], async_names: async_names, async_locals: locals }
      out = out.push(`export async function ${name}(${params}): Promise<${returns}> {`)
    } else {
      out = out.push(`export function ${name}(${params}): ${returns} {`)
    }
    let body = value_list(value_field(fnode, "body"))
    if (body.length() == 0) {
      out = out.push("  // (empty body)")
    } else {
      for (s of body) {
        let r = v3_stmt(s, 2, c, body_acx)
        out = out.concat(r.lines)
        c = r.counter
      }
    }
    out = out.push("}")
    out = out.push("")
  }
  return out
}

// `_emit_ts_externs`: each `extern fn` as an exported TS `function` carrying its
// verbatim `@ts` body (dedented, each line re-indented two spaces). An `async`
// extern (item 80) emits `export async function …: Promise<T>` — its body may
// `await`, and every admitted call site awaits it (see `render_call`). A missing
// `@ts` body is refused, matching the reference; VARIANT/non-ts externs are not
// in the covered corpus.
fn emit_externs(externs: List[Any]) -> List[Str] {
  var out = []
  for (ext of externs) {
    let name = ident(value_str(value_field(ext, "name")))
    var parts = []
    var args = []
    for (p of value_list(value_field(ext, "params"))) {
      parts = parts.push(`${ident(value_str(value_field(p, "name")))}: ${ts_type(value_str(value_field(p, "type")))}`)
      args = args.push(ident(value_str(value_field(p, "name"))))
    }
    let params = parts.join(", ")
    let arg_list = args.join(", ")
    let returns = ts_return_type(value_field(ext, "returns"))
    let bodies = value_field(ext, "bodies")
    // item 421 F6 (ported per item 429(d), the ts end): an extern whose DECLARED
    // return was `Secret[T]` is the ORIGIN — where a confidential value enters
    // the value world, the case a receiver-end marking misses (`let t = emit
    // mint(); effect store.insert(t, v)`). `taint.py` strips the qualifier
    // before lowering, so `secret_return` is the only surviving record of it.
    // The verbatim `@ts` body owns its own `return` statements, so it moves into
    // an INNER function and the exported name becomes a one-line marking
    // wrapper — every call site is covered without the body being rewritten.
    // Absent unless the author declared it, so every other module stays
    // byte-identical.
    let secret_return = value_bool(value_field(ext, "secret_return"))
    var impl = name
    var export_kw = "export "
    if (secret_return) {
      impl = "_revl_secret_".concat(name)
      export_kw = ""
    }
    if (!value_has(bodies, "ts")) {
      out = out.push(`<<EXTERN-NO-TS-BODY:${name}>>`)
    } else {
      if (value_bool(value_field(ext, "async"))) {
        if (secret_return) {
          out = out.push(`export async function ${name}(${params}): Promise<${returns}> {`)
          out = out.push(`  return host.secretResult(await ${impl}(${arg_list}))`)
          out = out.push("}")
          out = out.push("")
        }
        out = out.push(`${export_kw}async function ${impl}(${params}): Promise<${returns}> {`)
      } else {
        if (secret_return) {
          out = out.push(`export function ${name}(${params}): ${returns} {`)
          out = out.push(`  return host.secretResult(${impl}(${arg_list}))`)
          out = out.push("}")
          out = out.push("")
        }
        out = out.push(`${export_kw}function ${impl}(${params}): ${returns} {`)
      }
      let body = py_dedent(py_strip_nl(value_str(value_field(bodies, "ts"))))
      if (body == "") {
        out = out.push("  // (empty @ts body)")
      } else {
        for (line of py_splitlines(body)) {
          out = out.push("  ".concat(line))
        }
      }
      out = out.push("}")
    }
    out = out.push("")
  }
  return out
}

// `_emit_ts_types` — the v3 TYPE declarations. RECORDS only in this slice
// (`export interface <Name> { <field>: <ts_type> }`), each block trailed by a
// blank line, so a service signature carrying that record (`List[Msg]` ->
// `Msg[]`) resolves to a real interface. VARIANT emission (the `export type … =`
// union + its constructor functions) is DEFERRED — a variant type would emit the
// marker below and diverge, so no fixture declares one.
fn emit_ts_types(types: Any) -> List[Str] {
  var out = []
  for (name of value_keys(types)) {
    let spec = value_field(types, name)
    let nm = ident(name)
    if (value_str(value_field(spec, "kind")) == "record") {
      out = out.push(`export interface ${nm} {`)
      let fields = value_field(spec, "fields")
      for (fname of value_keys(fields)) {
        out = out.push(`  ${ident(fname)}: ${ts_type(value_str(value_field(fields, fname)))}`)
      }
      out = out.push("}")
    } else {
      out = out.push(`<<UNSUPPORTED-TYPE:${nm}>>`)
    }
    out = out.push("")
  }
  return out
}

// ============================================================ components (s2)
// The component-dialect tail of `_emit_v3`: service interfaces, the committed
// -view context augmentation, config interfaces, and each component's plugin
// object (inject/provide wiring, the `apply(ctx[, rawConfig])` scaffold, and the
// `ctx.effect(function* () { … })` activation body). Byte-identical to
// backends/typescript/emit.py for the covered subset.
//
// Slice 3 (item 208) adds the COMPOSITE signature types (List/Opt/Map/Result/
// fn-type + the declared-record `known_types` path in `ts_type_v1`).
// The v1/v2 `_emit_v1` dispatch is COVERED byte-exact (slice 7, item 240) —
// `emit_ts_src` is version-agnostic, so a component-only v1/v2 doc emits identically.
// STILL DEFERRED (a divergence, not a bug, if fed one — excluded from the
// corpus): ROUTED requires (`realms(...)` + the router + `realmLabel` + the
// routed-`req` proxy), the canonical ABI, and the component-body `timer` step.

// `TYPE_MAP` for a CONFIG field (`_config_interface`): the six scalar names, and
// — unlike the service renderer — an unknown name falls back to `any`.
fn config_ts_type(name: Str) -> Str {
  if (name == "Str") { return "string" }
  if (name == "Int") { return "bigint" }
  if (name == "Int32") { return "number" }
  if (name == "Bool") { return "boolean" }
  if (name == "Float") { return "number" }
  if (name == "Bytes") { return "Uint8Array" }
  return "any"
}

// The v1 `TYPE_MAP` (`_ts_type`): the six scalar names, "" on a miss. Distinct
// from `ts_scalar_type` (the v3 map, which also maps Unit/Any/Never).
fn type_map(name: Str) -> Str {
  if (name == "Str") { return "string" }
  if (name == "Int") { return "bigint" }
  if (name == "Int32") { return "number" }
  if (name == "Bool") { return "boolean" }
  if (name == "Float") { return "number" }
  if (name == "Bytes") { return "Uint8Array" }
  return ""
}

// `[A-Za-z0-9_]` — the `\w` character class the v1 generic regex head matches.
fn is_word_ch(ch: Str) -> Bool {
  if (ch.length() == 0) { return false }
  let x = ch.charCodeAt(0)
  if (x >= 65 && x <= 90) { return true }
  if (x >= 97 && x <= 122) { return true }
  if (x >= 48 && x <= 57) { return true }
  return x == 95
}

// A non-empty run of word chars — the `^(\w+)` the generic regex requires for a
// composite head (`List`/`Opt`/`Map`/`Result`), so a dotted or spaced name
// falls through to the `known_types`/`unknown` tail exactly as `re.match` fails.
fn is_word(s: Str) -> Bool {
  if (s.length() == 0) { return false }
  var i = 0
  while (i < s.length()) {
    if (!is_word_ch(s.charAt(i))) { return false }
    i += 1
  }
  return true
}

// The reference's `inner.split(',')` for a `Map`/`Result` arg list — a NAIVE
// split on EVERY comma (NOT the top-level `split_type_args`); `_ts_type` reads
// only `[0]`/`[1]` and strips each. Faithful including the pathological nesting.
fn naive_split(s: Str) -> List[Str] {
  var parts = []
  var current = ""
  var i = 0
  let n = s.length()
  while (i < n) {
    let ch = s.charAt(i)
    if (ch == ",") {
      parts = parts.push(current)
      current = ""
    } else {
      current = current.concat(ch)
    }
    i += 1
  }
  parts = parts.push(current)
  return parts
}

// `_ts_type` (v1/A6) — the renderer for service-interface and provide-method
// signatures, threading `known_types` (the document's declared record/ADT
// names). Distinct from the v3 `ts_type`: the v1 `TYPE_MAP` excludes
// Unit/Any/Never and has no `Async` branch; `Map`/`Result` args split NAIVELY;
// a bare DECLARED name routes through the v3 renderer (`ts_type`, byte-identical
// to `_ts_v3_type` — it renders `Msg` as `Msg` so the signature lines up with
// the emitted `interface Msg`); any other unknown name is opaque -> `unknown`.
fn ts_type_v1(name: Str, known_types: List[Str]) -> Str {
  if (name == "") { return "unknown" }
  let m = type_map(name)
  if (m != "") { return m }
  let stripped = py_strip(name)
  let arrow = fn_type_arrow_index(stripped)
  if (arrow >= 0) {
    let sn = stripped.length()
    let inner = py_strip(stripped.slice(1, arrow))
    // `_split_fn_type`: lstrip past the `)`, then drop the `->` and strip — so a
    // spaced arrow (`) -> Bool`, as the IR spells it) recovers `Bool`, not `>`.
    let rest = py_strip(stripped.slice(arrow + 1, sn))
    let returns = py_strip(rest.slice(2, rest.length()))
    var params = []
    if (inner != "") { params = split_type_args(inner) }
    var rendered = []
    var idx = 0
    for (p of params) {
      rendered = rendered.push(`a${idx}: ${ts_type_v1(p, known_types)}`)
      idx += 1
    }
    return `((${rendered.join(", ")}) => ${ts_type_v1(returns, known_types)})`
  }
  let bi = name.indexOf("[")
  let n = name.length()
  if (bi > 0 && is_word(name.slice(0, bi)) && name.charAt(n - 1) == "]") {
    let head = name.slice(0, bi)
    let inner = name.slice(bi + 1, n - 1)
    if (inner != "") {
      if (head == "List") { return ts_type_v1(inner, known_types).concat("[]") }
      if (head == "Opt") { return ts_type_v1(inner, known_types).concat(" | undefined") }
      if (head == "Map") {
        let parts = naive_split(inner)
        return `Map<${ts_type_v1(py_strip(parts[0]), known_types)}, ${ts_type_v1(py_strip(parts[1]), known_types)}>`
      }
      if (head == "Result") {
        let parts = naive_split(inner)
        return `{ kind: "Ok"; value: ${ts_type_v1(py_strip(parts[0]), known_types)} } | { kind: "Err"; value: ${ts_type_v1(py_strip(parts[1]), known_types)} }`
      }
    }
  }
  if (list_contains(known_types, name)) { return ts_type(name) }
  return "unknown"
}

// A method's return slot: absent -> "void", else the v1 surface type.
fn ts_return_type_v1(v: Any, known_types: List[Str]) -> Str {
  if (value_is_null(v)) { return "void" }
  return ts_type_v1(value_str(v), known_types)
}

// `_method_body`: steps inside a provide-method body. An `async` provide method
// (services 2.0 §5) renders its body with `in_async` set (via `acx`), so the
// item-141 await-seed fires on a req-keyed async-op call, and an explicit
// `await` step lands (A1). A sync method's `acx` is `sync_acx()`.
fn method_body(steps: List[Any], level: Int, counter: Int, acx: ACx) -> StmtOut {
  let pad = ind(level)
  var out = []
  var c = counter
  for (step of steps) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "let") {
      let r = expr(value_field(step, "value"), c, acx)
      c = r.counter
      var kw = "const"
      if (value_bool(value_field(step, "mutable"))) { kw = "let" }
      out = out.push(`${pad}${kw} ${ident(value_str(value_field(step, "name")))} = ${r.text}`)
    } else {
      if (kind == "assign") {
        let r = expr(value_field(step, "value"), c, acx)
        c = r.counter
        out = out.push(`${pad}${ident(value_str(value_field(step, "name")))} = ${r.text}`)
      } else {
        if (kind == "return") {
          let e = value_field(step, "expr")
          if (value_is_null(e)) {
            out = out.push(`${pad}return`)
          } else {
            let r = expr(e, c, acx)
            c = r.counter
            out = out.push(`${pad}return ${r.text}`)
          }
        } else {
          if (kind == "await") {
            // A1: an in-flight window inside an async method (a request awaiting
            // a host async value or an instance disposal). The awaited expr is a
            // non-req value here, so the await-seed adds nothing over the step's
            // own `await` (a req async-op call would double-await — out of slice).
            let r = expr(value_field(step, "expr"), c, acx)
            c = r.counter
            out = out.push(`${pad}await ${r.text}`)
          } else {
          if (kind == "effect" || kind == "let-effect") {
            var bind = ""
            var has_bind = false
            if (kind == "let-effect") {
              bind = ident(value_str(value_field(step, "bind")))
              has_bind = true
              out = out.push(`${pad}let ${bind}: any`)
            }
            let ar = expr(value_field(step, "acquire"), c, acx)
            let ur = expr(value_field(step, "undo"), ar.counter, acx)
            c = ur.counter
            out = out.push(`${pad}ctx.effect(() => {`)
            if (has_bind) {
              out = out.push(`${pad}  ${bind} = ${ar.text}`)
            } else {
              out = out.push(`${pad}  ${ar.text}`)
            }
            out = out.push(`${pad}  return () => ${ur.text}`)
            out = out.push(`${pad}})`)
          } else {
            if (kind == "emit") {
              let er = expr(value_field(step, "expr"), c, acx)
              c = er.counter
              let comp = value_field(step, "compensate")
              if (value_is_null(comp)) {
                out = out.push(`${pad}${er.text}`)
              } else {
                let cr = expr(comp, c, acx)
                c = cr.counter
                out = out.push(`${pad}ctx.effect(() => {`)
                out = out.push(`${pad}  ${er.text}`)
                out = out.push(`${pad}  return () => ${cr.text}`)
                out = out.push(`${pad}})`)
              }
            } else {
              out = out.push(`${pad}<<UNSUPPORTED-METHOD-STEP:${kind}>>`)
            }
          }
          }
        }
      }
    }
  }
  return { lines: out, counter: c }
}

// `_provide_impl`: the provided service object's methods. The impl param NAMES
// bind the body; the param TYPES come from the service declaration (arity must
// agree). An operation the service declares `async` lowers to an `async` method
// whose body renders in an async context (the await-seed's `ops`, item 219).
fn provide_impl(step: Any, services: Any, ops: List[Str], known_types: List[Str], level: Int, counter: Int) -> StmtOut {
  let pad = ind(level)
  let svc_name = value_str(value_field(step, "service"))
  let declared = value_field(value_field(services, svc_name), "methods")
  var out = []
  var c = counter
  for (method of value_list(value_field(step, "methods"))) {
    let name = ident(value_str(value_field(method, "name")))
    let spec = value_field(declared, value_str(value_field(method, "name")))
    let spec_params = value_list(value_field(spec, "params"))
    let param_names = value_list(value_field(method, "params"))
    var sig_parts = []
    // item 421 F6 (ported per item 429(d), the ts end): the SURFACE names of
    // this method's params that its SERVICE declares `Secret[T]`. `taint.py`
    // strips the qualifier before lowering, so the service spec's
    // `params[i].secret` stamp is the only surviving record that the position is
    // confidential. A method's param names are its own and may differ from the
    // declared ones (only the arity must agree), so the stamp is read BY INDEX
    // off the declaration while the name comes from the method — which is why
    // this needs the `services` table threaded down, and why the method node
    // alone could never see it.
    var secret_params = []
    var i = 0
    for (pn of param_names) {
      let pspec = value_at(spec_params, i)
      let ptype = ts_type_v1(value_str(value_field(pspec, "type")), known_types)
      sig_parts = sig_parts.push(`${ident(value_str(pn))}: ${ptype}`)
      if (value_bool(value_field(pspec, "secret"))) {
        secret_params = secret_params.push(ident(value_str(pn)))
      }
      i += 1
    }
    // services 2.0 §5: the async flag lives on the SERVICE declaration (the
    // single source of truth for the operation's shape).
    let is_async = value_bool(value_field(spec, "async"))
    var prefix = ""
    var body_acx = sync_acx()
    if (is_async) {
      prefix = "async "
      body_acx = { in_async: true, in_arrow: false, ops: ops, async_names: [], async_locals: [] }
    }
    out = out.push(`${pad}${prefix}${name}(${sig_parts.join(", ")}) {`)
    // A param the service declared `Secret[T]` is a declared DISCLOSURE
    // RECEIVER. Registering the value at the head of the receiver is what lets
    // `runtime.record` scrub it out of the host trace when the body goes on to
    // use it as a `Map` key, a `pool.query` sql, or a stream item. Emitted ONLY
    // for a method that actually declares one, so every other module stays
    // byte-identical.
    if (secret_params.length() > 0) {
      out = out.push(`${pad}  host.markSecret(${secret_params.join(", ")})`)
    }
    let br = method_body(value_list(value_field(method, "body")), level + 1, c, body_acx)
    out = out.concat(br.lines)
    c = br.counter
    out = out.push(`${pad}},`)
  }
  return { lines: out, counter: c }
}

// `_crossing_key_name`: a plain compile-time STRING name for a call target —
// `Crossing.key` is typed `string` (a capability/service key an operator reads),
// never the runtime value. Falls back to `'?'` (a crossing key is diagnostic,
// not load-bearing).
fn crossing_key_name(target: Any) -> Str {
  let k = node_kind(target)
  if (k == "req") { let nm = value_field(target, "name"); if (value_is_null(nm) || value_str(nm) == "") { return "?" } return value_str(nm) }
  if (k == "name") { let nm = value_field(target, "id"); if (value_is_null(nm) || value_str(nm) == "") { return "?" } return value_str(nm) }
  if (k == "var") { let nm = value_field(target, "name"); if (value_is_null(nm) || value_str(nm) == "") { return "?" } return value_str(nm) }
  return "?"
}

// `_component_step`: one activation-body step. Recursive (`if` branches hold
// body steps). The activation body renders with `in_async` OFF (the reference's
// `_component_body` scopes on `doc_ctx`, whose `in_async` is false): an `await`
// step supplies its own `await`, so no await-seed is needed here. `timer` is
// deferred. `ops` is passed through to the provide-method bodies. `comp_name` is
// this component's RAW name (for a compensation entry's `site`); `frame_var` is
// the emitted `Frame` local (`$revl_frame`, "" when the component needs none) —
// a compensation entry registers through it (item 243 Slice 2b).
fn component_step(step: Any, services: Any, ops: List[Str], known_types: List[Str], comp_name: Str, frame_var: Str, level: Int, counter: Int) -> StmtOut {
  let pad = ind(level)
  let a = sync_acx()
  let kind = value_str(value_field(step, "step"))
  if (kind == "let-effect" || kind == "effect") {
    let ar = expr(value_field(step, "acquire"), counter, a)
    var out = []
    if (kind == "let-effect") {
      let bind = ident(value_str(value_field(step, "bind")))
      out = out.push(`${pad}const ${bind} = ${ar.text}`)
    } else {
      out = out.push(`${pad}${ar.text}`)
    }
    let ur = expr(value_field(step, "undo"), ar.counter, a)
    // Phase-1 continue-and-record (docs/design/teardown-contract.md): a bracket
    // inverse routes through `Frame.bracket`, which CATCHES a raise and records
    // a contract-grade `bracket-fault` instead of letting it break cordis'
    // sequential disposal chain and starve every earlier-registered
    // (later-disposed) inverse. A bare `yield () => <undo>` does not catch, so
    // an emitted program had the hole even though runtime.ts's `Frame.bracket`
    // was already correct and unit-tested. Mirrors `_bracket_yield` in the
    // reference emitter, byte-for-byte.
    let b_method = acquire_method_name(value_field(step, "acquire"))
    var b_key = b_method
    if (kind == "let-effect") { b_key = value_str(value_field(step, "bind")) }
    let b_site = `${comp_name}.body:${b_key}`
    let b_undo = call_method_name(value_field(step, "undo"))
    let b_crossing = `{ key: ${json_dumps(b_key)}, method: ${json_dumps(b_method)}, args: [], site: ${json_dumps(b_site)} }`
    out = out.push(`${pad}yield ${frame_var}.bracket(${b_crossing}, ${json_dumps(b_undo)}, () => ${ur.text})`)
    return { lines: out, counter: ur.counter }
  }
  if (kind == "await") {
    // v1/A1: the await lands (inertia), then the `yield` closes the iteration so
    // a divert during the await skips every later step. This is what colors the
    // whole body an async generator (see `component_lines`).
    let er = expr(value_field(step, "expr"), counter, a)
    var out = [`${pad}await ${er.text}`]
    out = out.push(`${pad}yield () => {}  // iteration boundary (A1)`)
    return { lines: out, counter: er.counter }
  }
  if (kind == "emit") {
    let er = expr(value_field(step, "expr"), counter, a)
    var out = [`${pad}${er.text}`]
    let comp = value_field(step, "compensate")
    if (value_is_null(comp)) { return { lines: out, counter: er.counter } }
    // item 247/243 Slice 2b: a compensation entry — audit-facing, best-effort,
    // ABORT-ONLY, Phase 2. Args are bound to temps HERE, at registration (the
    // contract's "no data hazard"): a deferred Phase-2 closure never re-reads a
    // variable a later step might reassign. The crossing's `args` is captured
    // once, from those same `const` temps, and the replayed call is rebuilt from
    // them (no double evaluation).
    var c = er.counter + 1
    let n = c
    let site = `${comp_name}.body#${n}`
    let target = value_field(comp, "target")
    let method_f = value_field(comp, "method")
    if (!value_is_null(target) && !value_is_null(method_f)) {
      // a recognised component `target.method(args)` call.
      let method = value_str(method_f)
      let tr = expr(target, c, a)
      c = tr.counter
      let target_tmp = `$revl_comp${n}_key`
      out = out.push(`${pad}const ${target_tmp} = ${tr.text}`)
      var temps = []
      var i = 0
      for (arg of value_list(value_field(comp, "args"))) {
        let ar = expr(arg, c, a)
        c = ar.counter
        let tmp = `$revl_comp${n}_arg${i}`
        out = out.push(`${pad}const ${tmp} = ${ar.text}`)
        temps = temps.push(tmp)
        i += 1
      }
      let args_joined = temps.join(", ")
      let run_ts = `${target_tmp}.${ident(method)}(${args_joined})`
      let crossing = `{ key: ${json_dumps(crossing_key_name(target))}, method: ${json_dumps(method)}, args: [${args_joined}], site: ${json_dumps(site)} }`
      out = out.push(`${pad}yield ${frame_var}.compensation(${crossing}, ${json_dumps(method)}, [${args_joined}], () => ${run_ts})`)
      return { lines: out, counter: c }
    }
    let comp_kind = node_kind(comp)
    if (comp_kind == "fn" || comp_kind == "host") {
      // a bare `fn` or `host` builtin call: no separate target.
      var name = ""
      if (comp_kind == "fn") { name = value_str(value_field(comp, "name")) }
      else { name = value_str(value_field(comp, "fn")) }
      var temps = []
      var i = 0
      for (arg of value_list(value_field(comp, "args"))) {
        let ar = expr(arg, c, a)
        c = ar.counter
        let tmp = `$revl_comp${n}_arg${i}`
        out = out.push(`${pad}const ${tmp} = ${ar.text}`)
        temps = temps.push(tmp)
        i += 1
      }
      let args_joined = temps.join(", ")
      var run_ts = `${ident(name)}(${args_joined})`
      if (comp_kind == "host") { run_ts = `host.${name}(${args_joined})` }
      let crossing = `{ key: ${json_dumps(name)}, method: ${json_dumps(name)}, args: [${args_joined}], site: ${json_dumps(site)} }`
      out = out.push(`${pad}yield ${frame_var}.compensation(${crossing}, ${json_dumps(name)}, [${args_joined}], () => ${run_ts})`)
      return { lines: out, counter: c }
    }
    // unrecognised compensate shape: eagerly snapshot its value now
    // (registration time) rather than close over a live binding.
    let snap = `$revl_comp${n}`
    let cr = expr(comp, c, a)
    c = cr.counter
    out = out.push(`${pad}const ${snap} = ${cr.text}`)
    let crossing = `{ key: ${json_dumps(comp_name)}, method: ${json_dumps("compensate")}, args: [], site: ${json_dumps(site)} }`
    out = out.push(`${pad}yield ${frame_var}.compensation(${crossing}, ${json_dumps("compensate")}, [], () => ${snap})`)
    return { lines: out, counter: c }
  }
  if (kind == "provide") {
    let name = value_str(value_field(step, "name"))
    var out = [`${pad}yield ctx.provide(${json_dumps(name)}, {`]
    let pr = provide_impl(step, services, ops, known_types, level + 1, counter)
    out = out.concat(pr.lines)
    out = out.push(`${pad}} satisfies ${ident(value_str(value_field(step, "service")))})`)
    return { lines: out, counter: pr.counter }
  }
  if (kind == "if") {
    let cr = expr(value_field(step, "cond"), counter, a)
    var out = [`${pad}if (${cr.text}) {`]
    var c = cr.counter
    for (s of value_list(value_field(step, "then"))) {
      let r = component_step(s, services, ops, known_types, comp_name, frame_var, level + 1, c)
      out = out.concat(r.lines)
      c = r.counter
    }
    let els = value_list(value_field(step, "else"))
    if (els.length() > 0) {
      out = out.push(`${pad}} else {`)
      for (s of els) {
        let r = component_step(s, services, ops, known_types, comp_name, frame_var, level + 1, c)
        out = out.concat(r.lines)
        c = r.counter
      }
    }
    out = out.push(`${pad}}`)
    return { lines: out, counter: c }
  }
  if (kind == "fail") {
    let mr = expr(value_field(step, "message"), counter, a)
    return { lines: [`${pad}throw new Error(${mr.text})`], counter: mr.counter }
  }
  return { lines: [`${pad}<<UNSUPPORTED-STEP:${kind}>>`], counter: counter }
}

// The activation body is an async generator when any TOP-LEVEL step is an
// `await` (v1/A1) — mirrors the reference's `any(step == "await" …)`.
// `is_async` (item 131): a body containing an `await` step (or an async-flagged
// `effect`/`let-effect`/`emit` — an awaited acquisition or emission) compiles to
// an async generator whose awaited acquisitions land on LATER microtask turns,
// AFTER a synchronous `apply` would already have returned. Such a body colors
// `apply` `async` and `await`s its `ctx.effect(...)` so the fiber reaches ACTIVE
// only once the acquisition has landed. A timer step is excluded: its async flag
// colors its OWN runtime-awaited firing (item 170), not the activation body.
fn body_is_async(steps: List[Any]) -> Bool {
  for (step of steps) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "await") { return true }
    if ((kind == "effect" || kind == "let-effect" || kind == "emit") && value_bool(value_field(step, "async"))) { return true }
  }
  return false
}

// `_config_interface`: the `export interface <Name>Config { … }` block, or [].
fn config_interface(comp: Any) -> List[Str] {
  let fields = value_list(value_field(comp, "config"))
  if (fields.length() == 0) { return [] }
  let raw_name = value_str(value_field(comp, "name"))
  var out = [`export interface ${raw_name}Config {`]
  for (field of fields) {
    let fname = ident(value_str(value_field(field, "name")))
    let ty = config_ts_type(value_str(value_field(field, "type")))
    let dflt = value_field(field, "default")
    if (value_is_null(dflt)) {
      out = out.push(`  ${fname}: ${ty}`)
    } else {
      out = out.push(`  /** default: ${json_dumps(dflt)} */`)
      out = out.push(`  ${fname}?: ${ty}`)
    }
  }
  out = out.push("}")
  return out
}

// `_component`: one component's config interface + plugin object.
fn component_lines(comp: Any, services: Any, known_types: List[Str], counter: Int) -> StmtOut {
  let name = ident(value_str(value_field(comp, "name")))
  var out = config_interface(comp)
  out = out.push(`export const ${name} = {`)
  out = out.push(`  name: ${json_dumps(name)},`)
  // inject: the requirement keys (routed keys are deferred, so all of them).
  // With any `intercept` present the plugin switches from the array form to the
  // dict form — `{key: intercept.get(key) …}` — the non-null values copied into
  // the fiber context's intercept chain, `null` marking a required-but-not-
  // intercepted key. json.dumps of that dict equals a piecewise build (`, `
  // between entries, `": "` after each key), so the JSON stays pure revl.
  let req_keys = value_keys(value_field(comp, "requires"))
  let icept = value_field(comp, "intercept")
  if (value_keys(icept).length() > 0) {
    var inj_parts = []
    for (k of req_keys) {
      inj_parts = inj_parts.push(`${json_dumps(k)}: ${json_dumps(value_field(icept, k))}`)
    }
    out = out.push(`  inject: {${inj_parts.join(", ")}},`)
  } else {
    var inject_parts = []
    for (k of req_keys) {
      inject_parts = inject_parts.push(json_dumps(k))
    }
    out = out.push(`  inject: [${inject_parts.join(", ")}],`)
  }
  let provide_keys = value_keys(value_field(comp, "provides"))
  if (provide_keys.length() > 0) {
    var pk = []
    for (k of provide_keys) { pk = pk.push(json_dumps(k)) }
    out = out.push(`  provide: [${pk.join(", ")}],`)
  }
  // item 131: an async body colors `apply` `async` (and `await`s its
  // `ctx.effect` below) so the fiber reaches ACTIVE only after the awaited
  // acquisition lands. A sync body keeps the bare `apply`, byte-identical.
  let body = value_list(value_field(comp, "body"))
  let is_async = body_is_async(body)
  var apply_kw = "apply"
  if (is_async) { apply_kw = "async apply" }
  let fields = value_list(value_field(comp, "config"))
  if (fields.length() > 0) {
    out = out.push(`  ${apply_kw}(ctx: Context, rawConfig: ${name}Config) {`)
    var spec_parts = []
    for (field of fields) {
      let fname = value_str(value_field(field, "name"))
      let dflt = value_field(field, "default")
      // item 256 Slice 3 / 421 F6 (ported per item 429(d), the ts end): a field
      // declared `Secret[T]` is stamped so the runtime keeps its value out of
      // the `<Component>.config` trace line while still handing the real value
      // to the component. Emitted only when the author declared one, so every
      // other module stays byte-identical.
      var mark = ""
      if (value_bool(value_field(field, "secret"))) { mark = ", secret: true" }
      if (value_is_null(dflt)) {
        spec_parts = spec_parts.push(`${fname}: { required: true${mark} }`)
      } else {
        spec_parts = spec_parts.push(`${fname}: { default: ${literal_of(dflt)}${mark} }`)
      }
    }
    out = out.push(`    const config = host.applyConfigDefaults(${json_dumps(name)}, rawConfig, { ${spec_parts.join(", ")} }) as Required<${name}Config>`)
  } else {
    out = out.push(`  ${apply_kw}(ctx: Context) {`)
  }
  // item 243 Slice 2b: the activation's teardown accumulator, built ONLY when
  // this component registers a compensation entry (`_needs_frame`). A
  // bracket-only component emits no `Frame`, no `begin`/`drain` sentinel —
  // byte-identical to before this slice. `frame_var` is threaded to
  // `component_step`, where a compensation registers through it; "" otherwise.
  let raw_name = value_str(value_field(comp, "name"))
  let needs_frame = component_needs_frame(comp)
  var frame_var = ""
  if (needs_frame || component_has_bracket(comp)) {
    frame_var = "$revl_frame"
    out = out.push(`    const ${frame_var} = new Frame(ctx, ${json_dumps(name)})`)
  }
  // One generator per body (LIFO teardown). An async body compiles to an async
  // generator (v1/A1) and its `ctx.effect(...)` is `await`ed inside the `async
  // apply` (item 131): the wrapper is a thenable, so awaiting it makes `apply`
  // return a real Promise that cordis' `_execute` chains onto, so `fiber.await()`
  // resolves only after the awaited acquisition has landed. A sync body's
  // generator runs to completion synchronously, so its `ctx.effect(...)` stays a
  // bare, non-awaited statement, byte-identical for every prior program. `ops` =
  // the async operations reachable through this component's requirement keys,
  // threaded to the provide-method await-seed.
  var gen = "function*"
  if (is_async) { gen = "async function*" }
  var effect_stmt = ""
  if (is_async) { effect_stmt = "await " }
  out = out.push(`    ${effect_stmt}ctx.effect(${gen} () {`)
  // Slice 2b: two sentinel yields bracket the ordinary steps when a `Frame` is
  // built. `begin` yielded FIRST -> disposed LAST (LIFO): the Phase-2 post-unwind
  // hook on abort. `drain` yielded LAST -> disposed FIRST: the commit signal every
  // earlier entry reads at its own disposal time.
  if (needs_frame) { out = out.push(`      yield ${frame_var}.begin`) }
  let ops = async_ops_of(value_field(comp, "requires"), services)
  var c = counter
  for (step of body) {
    let r = component_step(step, services, ops, known_types, raw_name, frame_var, 3, c)
    out = out.concat(r.lines)
    c = r.counter
  }
  if (needs_frame) { out = out.push(`      yield ${frame_var}.drain`) }
  out = out.push(`    }, ${json_dumps(name.concat(".body"))})`)
  out = out.push("  },")
  // v2: realm placements — `isolate: {key: realm, …},` applied by runtime.plug()
  // BEFORE ctx.plugin (the fiber's context chain is fixed at plugin time). The
  // metadata is plain JSON (static string labels), so json.dumps renders it.
  let iso = value_field(comp, "isolate")
  if (value_keys(iso).length() > 0) {
    out = out.push(`  isolate: ${json_dumps(iso)},`)
  }
  out = out.push("}")
  return { lines: out, counter: c }
}

// The service-interface block for the whole document (`_emit_v3`'s service loop):
// one `export interface <Service> { … }` per declared service, in declaration
// order. An `async` operation returns a `Promise<…>` on this tier (services
// 2.0 §5).
fn service_interfaces(services: Any, known_types: List[Str]) -> List[Str] {
  var out = []
  for (sname of value_keys(services)) {
    let svc = value_field(services, sname)
    out = out.push(`export interface ${sname} {`)
    let methods = value_field(svc, "methods")
    for (mname of value_keys(methods)) {
      let method = value_field(methods, mname)
      var sig_parts = []
      for (p of value_list(value_field(method, "params"))) {
        sig_parts = sig_parts.push(`${ident(value_str(value_field(p, "name")))}: ${ts_type_v1(value_str(value_field(p, "type")), known_types)}`)
      }
      var returns = ts_return_type_v1(value_field(method, "returns"), known_types)
      if (value_bool(value_field(method, "async"))) { returns = `Promise<${returns}>` }
      if (value_bool(value_field(method, "emission"))) {
        out = out.push("  /** emission — crosses the system boundary (DESIGN.md §3.5) */")
      }
      if (value_bool(value_field(method, "idempotent"))) {
        out = out.push("  /** idempotent — safe to re-deliver; the runtime may auto-retry a transient failure (item 44) */")
      }
      out = out.push(`  ${mname}(${sig_parts.join(", ")}): ${returns}`)
    }
    out = out.push("}")
    out = out.push("")
  }
  return out
}

// `_context_augmentation`: typed committed-view access `ctx.<key>` for every key
// the document touches — PROVISIONS first (component order), then REQUIREMENTS —
// each in first-occurrence order. Identical interface members merge, so a key
// repeated across components is emitted once.
fn context_augmentation(components: List[Any]) -> List[Str] {
  var keys = []
  var svcs = []
  for (comp of components) {
    for (k of value_keys(value_field(comp, "provides"))) {
      if (!list_contains(keys, k)) {
        keys = keys.push(k)
        svcs = svcs.push(value_str(value_field(value_field(comp, "provides"), k)))
      }
    }
  }
  for (comp of components) {
    for (k of value_keys(value_field(comp, "requires"))) {
      if (!list_contains(keys, k)) {
        keys = keys.push(k)
        svcs = svcs.push(value_str(value_field(value_field(comp, "requires"), k)))
      }
    }
  }
  if (keys.length() == 0) { return [] }
  var out = ["declare module 'cordis' {", "  interface Context {"]
  var i = 0
  for (k of keys) {
    out = out.push(`    ${k}: ${svcs[i]}`)
    i += 1
  }
  out = out.push("  }")
  out = out.push("}")
  out = out.push("")
  return out
}

// The component tail of the document (`_emit_v3` after the pure passes): service
// interfaces, the context augmentation, then each component. Threads a FRESH
// match counter (the reference's `doc_ctx`, distinct from the function pass).
fn emit_component_tail(ir: Any) -> List[Str] {
  var out = []
  // `known_types` = the document's declared record/ADT names (`frozenset(types)`
  // in `_emit_v3`): the set `_ts_type` renders a bare name by, so a service
  // signature carrying `List[Msg]` lines up with the emitted `interface Msg`.
  let known_types = value_keys(value_field(ir, "types"))
  out = out.concat(service_interfaces(value_field(ir, "services"), known_types))
  let components = value_list(value_field(ir, "components"))
  out = out.concat(context_augmentation(components))
  var c = 0
  for (comp of components) {
    let r = component_lines(comp, value_field(ir, "services"), known_types, c)
    out = out.concat(r.lines)
    out = out.push("")
    c = r.counter
  }
  return out
}

// --------------------------------------------------- conditional helpers
// The reference `_revl_*` helper constants, verbatim, each built as one
// multi-line string (a single `out` element followed by "").
fn revl_eq_helper() -> Str {
  var o = []
  o = o.push("function revlEq(a: unknown, b: unknown): boolean {")
  o = o.push("  if (a === b) return true")
  o = o.push("  if (typeof a !== 'object' || typeof b !== 'object' || a === null || b === null) {")
  o = o.push("    return false")
  o = o.push("  }")
  o = o.push("  const arrA = Array.isArray(a), arrB = Array.isArray(b)")
  o = o.push("  if (arrA !== arrB) return false")
  o = o.push("  if (arrA && arrB) {")
  o = o.push("    const xs = a as unknown[], ys = b as unknown[]")
  o = o.push("    return xs.length === ys.length && xs.every((x, i) => revlEq(x, ys[i]))")
  o = o.push("  }")
  o = o.push("  if (a instanceof Map && b instanceof Map) {")
  o = o.push("    // revl equality is structural and order-independent (syntax-2.0 §3.4);")
  o = o.push("    // for maps that means same key set, equal value under every key.")
  o = o.push("    if (a.size !== b.size) return false")
  o = o.push("    for (const [k, v] of a.entries()) {")
  o = o.push("      if (!b.has(k) || !revlEq(v, b.get(k))) return false")
  o = o.push("    }")
  o = o.push("    return true")
  o = o.push("  }")
  o = o.push("  const ka = Object.keys(a as object), kb = Object.keys(b as object)")
  o = o.push("  if (ka.length !== kb.length) return false")
  o = o.push("  return ka.every((k) => Object.prototype.hasOwnProperty.call(b, k)")
  o = o.push("    && revlEq((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]))")
  o = o.push("}")
  return o.join(newline())
}

fn revl_show_helper() -> Str {
  var o = []
  o = o.push("function revlShow(v: unknown): string {")
  o = o.push("  if (typeof v === 'bigint') return v.toString()")
  o = o.push("  if (typeof v === 'number') return String(v)")
  o = o.push(`  if (Array.isArray(v)) return '[' + v.map(revlShow).join(', ') + ']'`)
  o = o.push("  if (v !== null && typeof v === 'object') {")
  o = o.push("    const o = v as Record<string, unknown>")
  o = o.push(`    return '{' + Object.keys(o).map((k) => JSON.stringify(k) + ': ' + revlShow(o[k])).join(', ') + '}'`)
  o = o.push("  }")
  o = o.push("  return JSON.stringify(v) ?? String(v)")
  o = o.push("}")
  return o.join(newline())
}

fn revl_i64_helper() -> Str {
  var o = []
  o = o.push("const REVL_I64_MIN = -(2n ** 63n)")
  o = o.push("const REVL_I64_MAX = 2n ** 63n - 1n")
  o = o.push("function revlI64(v: bigint): bigint {")
  o = o.push("  if (v < REVL_I64_MIN || v > REVL_I64_MAX) throw new RangeError('revl: Int overflow')")
  o = o.push("  return v")
  o = o.push("}")
  return o.join(newline())
}

fn revl_i32_helper() -> Str {
  var o = []
  o = o.push("const REVL_I32_MIN = -(2 ** 31)")
  o = o.push("const REVL_I32_MAX = 2 ** 31 - 1")
  o = o.push("function revlI32(v: number): number {")
  o = o.push("  if (v < REVL_I32_MIN || v > REVL_I32_MAX) throw new RangeError('revl: Int32 overflow')")
  o = o.push("  return v")
  o = o.push("}")
  return o.join(newline())
}

fn revl_int_arith_helper() -> Str {
  var o = []
  o = o.push("function revlNonZero(b: bigint): bigint {")
  o = o.push("  if (b === 0n) throw new Error('revl: division by zero')")
  o = o.push("  return b")
  o = o.push("}")
  o = o.push("function revlDivTrunc(a: bigint, b: bigint): bigint {")
  o = o.push("  return revlI64(a / revlNonZero(b))")
  o = o.push("}")
  o = o.push("function revlDivFloor(a: bigint, b: bigint): bigint {")
  o = o.push("  const d = revlNonZero(b)")
  o = o.push("  const q = a / d")
  o = o.push("  return a % d !== 0n && (a < 0n) !== (d < 0n) ? revlI64(q - 1n) : revlI64(q)")
  o = o.push("}")
  o = o.push("function revlDivEuclid(a: bigint, b: bigint): bigint {")
  o = o.push("  const d = revlNonZero(b)")
  o = o.push("  const q = a / d")
  o = o.push("  if (a % d >= 0n) return revlI64(q)")
  o = o.push("  return d > 0n ? revlI64(q - 1n) : revlI64(q + 1n)")
  o = o.push("}")
  o = o.push("function revlMod(a: bigint, b: bigint): bigint {")
  o = o.push("  const m = revlNonZero(b) < 0n ? -b : b")
  o = o.push("  return ((a % m) + m) % m")
  o = o.push("}")
  o = o.push("// The total forms (docs/arithmetic.md): the same quotient as the faulting")
  o = o.push("// helpers, but a zero divisor yields Err(reason) instead of throwing — `fail`")
  o = o.push("// is refused in a pure fn, so the error travels as a value. The shape is the")
  o = o.push("// one the `adt` node renders for a built-in Result: `{ kind, value }`.")
  o = o.push(`function revlCheckedDivTrunc(a: bigint, b: bigint): { kind: "Ok"; value: bigint } | { kind: "Err"; value: string } {`)
  o = o.push(`  if (b === 0n) return { kind: "Err", value: 'revl: division by zero' }`)
  o = o.push(`  if (a === REVL_I64_MIN && b === -1n) return { kind: "Err", value: 'revl: Int overflow' }`)
  o = o.push(`  return { kind: "Ok", value: revlI64(a / b) }`)
  o = o.push("}")
  o = o.push(`function revlCheckedDivFloor(a: bigint, b: bigint): { kind: "Ok"; value: bigint } | { kind: "Err"; value: string } {`)
  o = o.push(`  if (b === 0n) return { kind: "Err", value: 'revl: division by zero' }`)
  o = o.push(`  if (a === REVL_I64_MIN && b === -1n) return { kind: "Err", value: 'revl: Int overflow' }`)
  o = o.push("  const q = a / b")
  o = o.push("  return a % b !== 0n && (a < 0n) !== (b < 0n)")
  o = o.push(`    ? { kind: "Ok", value: revlI64(q - 1n) }`)
  o = o.push(`    : { kind: "Ok", value: revlI64(q) }`)
  o = o.push("}")
  o = o.push(`function revlCheckedDivEuclid(a: bigint, b: bigint): { kind: "Ok"; value: bigint } | { kind: "Err"; value: string } {`)
  o = o.push(`  if (b === 0n) return { kind: "Err", value: 'revl: division by zero' }`)
  o = o.push(`  if (a === REVL_I64_MIN && b === -1n) return { kind: "Err", value: 'revl: Int overflow' }`)
  o = o.push("  const q = a / b")
  o = o.push(`  if (a % b >= 0n) return { kind: "Ok", value: revlI64(q) }`)
  o = o.push(`  return b > 0n ? { kind: "Ok", value: revlI64(q - 1n) } : { kind: "Ok", value: revlI64(q + 1n) }`)
  o = o.push("}")
  o = o.push(`function revlCheckedMod(a: bigint, b: bigint): { kind: "Ok"; value: bigint } | { kind: "Err"; value: string } {`)
  o = o.push(`  if (b === 0n) return { kind: "Err", value: 'revl: division by zero' }`)
  o = o.push("  const m = b < 0n ? -b : b")
  o = o.push(`  return { kind: "Ok", value: ((a % m) + m) % m }`)
  o = o.push("}")
  return o.join(newline())
}

fn revl_str_helper() -> Str {
  var o = []
  // The code-point decode is memoised in two slots (item 435(c)): every helper
  // here measures or indexes `Array.from(s)`, so decoding per call made an
  // index scan quadratic. Mirrors `_REVL_STR_HELPER` in
  // backends/typescript/emit.py byte for byte; `revlIndexOf` deliberately
  // keeps its own `Array.from` over a per-call substring.
  o = o.push("let revlCpsK0: string | undefined")
  o = o.push("let revlCpsV0: string[] = []")
  o = o.push("let revlCpsK1: string | undefined")
  o = o.push("let revlCpsV1: string[] = []")
  o = o.push("function revlCps(s: string): string[] {")
  o = o.push("  if (s === revlCpsK0) return revlCpsV0")
  o = o.push("  if (s === revlCpsK1) {")
  o = o.push("    const k = revlCpsK1, v = revlCpsV1")
  o = o.push("    revlCpsK1 = revlCpsK0; revlCpsV1 = revlCpsV0")
  o = o.push("    revlCpsK0 = k; revlCpsV0 = v")
  o = o.push("    return v")
  o = o.push("  }")
  o = o.push("  const v = Array.from(s)")
  o = o.push("  revlCpsK1 = revlCpsK0; revlCpsV1 = revlCpsV0")
  o = o.push("  revlCpsK0 = s; revlCpsV0 = v")
  o = o.push("  return v")
  o = o.push("}")
  o = o.push(`function revlLen(x: string | ArrayLike<unknown>): bigint {`)
  o = o.push(`  return BigInt(typeof x === "string" ? revlCps(x).length : x.length)`)
  o = o.push("}")
  o = o.push(`function revlSlice(x: string, a: bigint, b: bigint): string`)
  o = o.push(`function revlSlice(x: Uint8Array, a: bigint, b: bigint): Uint8Array`)
  o = o.push(`function revlSlice<T>(x: T[], a: bigint, b: bigint): T[]`)
  o = o.push(`function revlSlice(x: unknown, a: bigint, b: bigint): string | Uint8Array | unknown[]`)
  o = o.push(`function revlSlice(x: unknown, a: bigint, b: bigint): string | Uint8Array | unknown[] {`)
  o = o.push("  const i = Number(a), j = Number(b)")
  o = o.push(`  return typeof x === "string"`)
  o = o.push(`    ? revlCps(x).slice(i, j).join("")`)
  o = o.push(`    : (x as string | Uint8Array | unknown[]).slice(i, j)`)
  o = o.push("}")
  o = o.push("function revlCharAt(s: string, i: bigint): string {")
  o = o.push("  const c = revlCps(s)[Number(i)]")
  o = o.push(`  return c === undefined ? "" : c`)
  o = o.push("}")
  o = o.push("function revlCharCodeAt(s: string, i: bigint): bigint {")
  o = o.push("  const c = revlCps(s)[Number(i)]")
  o = o.push("  return BigInt(c === undefined ? NaN : (c.codePointAt(0) as number))")
  o = o.push("}")
  o = o.push(`function revlIndexOf(x: string | unknown[], v: unknown): bigint {`)
  o = o.push(`  if (typeof x === "string") {`)
  o = o.push("    const at = x.indexOf(v as string)")
  o = o.push("    return BigInt(at < 0 ? -1 : Array.from(x.slice(0, at)).length)")
  o = o.push("  }")
  o = o.push("  return BigInt(x.indexOf(v))")
  o = o.push("}")
  return o.join(newline())
}

fn revl_parse_int_helper() -> Str {
  var o = []
  o = o.push("function revlParseInt(s: string): bigint | undefined {")
  o = o.push(`  if (!/^-?\d+$/.test(s)) return undefined`)
  o = o.push("  const n = BigInt(s)")
  o = o.push("  if (n < -9223372036854775808n || n > 9223372036854775807n) return undefined")
  o = o.push("  return n")
  o = o.push("}")
  return o.join(newline())
}

// ---------------------------------------------------- IR-wide `_uses_*` gates
// `_uses_spawn`: true iff any COMPONENT body carries a `spawn` acquisition node,
// so the module imports the `spawn` runtime helper (docs/design-v2-instances.md
// phase 2). Walks only `ir.components` (mirroring the reference), so a
// non-spawning document skips the import and stays byte-identical.
fn uses_spawn(n: Any) -> Bool {
  if (node_kind(n) == "spawn") { return true }
  for (c of value_children(n)) {
    if (uses_spawn(c)) { return true }
  }
  return false
}

// `_needs_frame` (item 243 Slice 2b, docs/design/teardown-contract.md): true iff
// this component's activation body registers a compensation entry (`emit …
// compensate …`), the entry kind that needs the `Frame` two-phase teardown
// apparatus. Walks `if` branches (the only nesting an activation-body step
// reaches here); a `timer` body is emission-only, so it never contributes. A
// component using only plain brackets emits with NO `Frame`, byte-identical to
// before this slice. (The witnessed/transactional entry kind is Slice-2b too but
// no covered document declares a witnessed extern, so it is out of this port —
// see item 324; a re-enabled witnessed fixture would extend this walk.)
fn body_needs_frame(steps: List[Any]) -> Bool {
  for (step of steps) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "emit" && !value_is_null(value_field(step, "compensate"))) { return true }
    if (kind == "if") {
      if (body_needs_frame(value_list(value_field(step, "then")))) { return true }
      if (body_needs_frame(value_list(value_field(step, "else")))) { return true }
    }
  }
  return false
}

fn component_needs_frame(comp: Any) -> Bool {
  return body_needs_frame(value_list(value_field(comp, "body")))
}

// `_has_bracket`: true iff this component's activation body yields at least one
// BRACKET disposer. Such a component needs a `Frame` too — not for the
// `begin`/`drain` sentinels (`needs_frame` still governs those, so teardown
// SEMANTICS are unchanged), but purely as the accumulator `Frame.bracket`
// records a Phase-1 `bracket-fault` into (docs/design/teardown-contract.md).
fn body_has_bracket(steps: List[Any]) -> Bool {
  for (step of steps) {
    let kind = value_str(value_field(step, "step"))
    if (kind == "let-effect" || kind == "effect") { return true }
    if (kind == "if") {
      if (body_has_bracket(value_list(value_field(step, "then")))) { return true }
      if (body_has_bracket(value_list(value_field(step, "else")))) { return true }
    }
  }
  return false
}

fn component_has_bracket(comp: Any) -> Bool {
  return body_has_bracket(value_list(value_field(comp, "body")))
}

// `_uses_bracket_frame`: document-level gate for the import line — true iff any
// component yields a bracket disposer, so the module needs `Frame`.
fn uses_bracket_frame(ir: Any) -> Bool {
  for (comp of value_list(value_field(ir, "components"))) {
    if (component_has_bracket(comp)) { return true }
  }
  return false
}

// `_call_method_name`: best-effort callee name for a `Frame.bracket` crossing /
// `undoMethod`, from any call shape a component body uses. Never fails — falls
// back to a generic label.
fn call_method_name(node: Any) -> Str {
  let m = value_field(node, "method")
  if (!value_is_null(m)) {
    let s = value_str(m)
    if (s == "") { return "undo" }
    return s
  }
  let k = node_kind(node)
  if (k == "fn") {
    let nm = value_field(node, "name")
    if (value_is_null(nm) || value_str(nm) == "") { return "undo" }
    return value_str(nm)
  }
  if (k == "host") {
    let hf = value_field(node, "fn")
    if (value_is_null(hf) || value_str(hf) == "") { return "undo" }
    return value_str(hf)
  }
  if (k == "call") {
    let callee = value_field(node, "callee")
    if (node_kind(callee) == "var") {
      let cn = value_field(callee, "name")
      if (value_is_null(cn) || value_str(cn) == "") { return "undo" }
      return value_str(cn)
    }
  }
  return "undo"
}

// `_acquire_method_name`: the name of the ACQUISITION half of a bracket
// crossing. Separate from `call_method_name` because that one also serves the
// `undo` slot, where "undo" is the right fallback. Here it is not: a residue
// record names the crossing an operator checks by hand, and `Frame.referentOf`
// renders `method` as `<key>.<method>()`, so a fabricated name sends them after
// a method that does not exist. A `spawn` acquisition carries no
// `method`/`name`/`fn` and reached the generic fallback, rendering `w1.undo()`;
// it is named for the `spawn(ctx, Worker, ...)` call that performs it.
fn acquire_method_name(node: Any) -> Str {
  if (node_kind(node) == "spawn") { return "spawn" }
  return call_method_name(node)
}

// `_uses_frame`: document-level gate for the import line — true iff any component
// registers a compensation entry.
fn uses_frame(ir: Any) -> Bool {
  for (comp of value_list(value_field(ir, "components"))) {
    if (component_needs_frame(comp)) { return true }
  }
  return false
}

// `_runtime_imports`: the `import { … } from '../runtime.ts'` line. `Frame`/
// `record` are added when a component registers a compensation entry (item 243
// Slice 2b); `spawn` when a spawn node is present. (routed-require `realmLabel`
// and the lifecycle-test drivers are deferred — no covered document exercises
// them. A routed require would need `realmLabel` here, hence it stays out.)
fn runtime_imports(ir: Any) -> Str {
  var names = ["host"]
  if (uses_frame(ir)) { names = names.push("Frame"); names = names.push("record") }
  else {
    // a bracket-only document imports `Frame` alone: its brackets record a
    // Phase-1 `bracket-fault` into one, but nothing here reaches a
    // witnessed/compensating extern's `@ts` body, so `record` stays out.
    if (uses_bracket_frame(ir)) { names = names.push("Frame") }
  }
  if (uses_spawn(value_field(ir, "components"))) { names = names.push("spawn") }
  return `import { ${names.join(", ")} } from '../runtime.ts'`
}

fn uses_equality(n: Any) -> Bool {
  if (node_kind(n) == "bin" && is_equality_op(node_op(n))) { return true }
  for (c of value_children(n)) {
    if (uses_equality(c)) { return true }
  }
  return false
}

fn uses_assert(n: Any) -> Bool {
  if (value_str(value_field(n, "step")) == "assert") { return true }
  for (c of value_children(n)) {
    if (uses_assert(c)) { return true }
  }
  return false
}

fn uses_bounded_int(n: Any) -> Bool {
  let k = node_kind(n)
  if (k == "bin" && is_addsubmul(node_op(n)) && node_operands(n) == "Int") { return true }
  if (k == "un" && node_op(n) == "-" && node_operands(n) == "Int") { return true }
  for (c of value_children(n)) {
    if (uses_bounded_int(c)) { return true }
  }
  return false
}

fn uses_bounded_int32(n: Any) -> Bool {
  let k = node_kind(n)
  if (k == "bin" && is_addsubmul(node_op(n)) && node_operands(n) == "Int32") { return true }
  if (k == "un" && node_op(n) == "-" && node_operands(n) == "Int32") { return true }
  if (k == "builtin" && node_method(n) == "to_int32") { return true }
  for (c of value_children(n)) {
    if (uses_bounded_int32(c)) { return true }
  }
  return false
}

fn is_int_arith_method(m: Str) -> Bool {
  if (m == "div_trunc" || m == "div_floor" || m == "div_euclid" || m == "mod") { return true }
  return m == "checked_div_trunc" || m == "checked_div_floor" || m == "checked_div_euclid" || m == "checked_mod"
}

fn uses_int_arith(n: Any) -> Bool {
  if (is_int_arith_method(node_method(n))) { return true }
  for (c of value_children(n)) {
    if (uses_int_arith(c)) { return true }
  }
  return false
}

fn is_str_method(m: Str) -> Bool {
  return m == "length" || m == "slice" || m == "charAt" || m == "charCodeAt" || m == "indexOf"
}

fn uses_str_methods(n: Any) -> Bool {
  if (node_kind(n) == "len") { return true }
  if (node_kind(n) == "builtin" && is_str_method(node_method(n))) { return true }
  for (c of value_children(n)) {
    if (uses_str_methods(c)) { return true }
  }
  return false
}

fn uses_parse_int(n: Any) -> Bool {
  if (node_kind(n) == "builtin" && node_method(n) == "to_int" && value_str(value_field(n, "recv")) == "Str") {
    return true
  }
  for (c of value_children(n)) {
    if (uses_parse_int(c)) { return true }
  }
  return false
}

// `_revl_helpers`: the helper functions this document actually needs, in
// dependency order (revlI64 before the named integer operations that call it).
fn revl_helpers(ir: Any) -> List[Str] {
  var out = []
  if (uses_equality(ir)) { out = out.push(revl_eq_helper()); out = out.push("") }
  if (uses_assert(ir)) { out = out.push(revl_show_helper()); out = out.push("") }
  if (uses_bounded_int(ir) || uses_int_arith(ir)) { out = out.push(revl_i64_helper()); out = out.push("") }
  if (uses_bounded_int32(ir)) { out = out.push(revl_i32_helper()); out = out.push("") }
  if (uses_int_arith(ir)) { out = out.push(revl_int_arith_helper()); out = out.push("") }
  if (uses_str_methods(ir)) { out = out.push(revl_str_helper()); out = out.push("") }
  if (uses_parse_int(ir)) { out = out.push(revl_parse_int_helper()); out = out.push("") }
  return out
}

// The document assembly. Mirrors `emit()` -> `_emit_v3` for a function/component
// document; being version-AGNOSTIC, it also mirrors `emit()` -> `_emit_v1` for a
// v1/v2 component-only document byte-for-byte (slice 7, item 240) — the header,
// helpers, service interfaces, context augmentation, and per-component plugin
// object are the exact subset `_emit_v1` emits. (The v1/v2 dispatch has no
// declared type/extern/fn/test, so those branches below emit nothing for it.)
pub fn emit_ts_src(ir: Any) -> Str {
  var out = []
  out = out.push("// Generated by revl backends/typescript/emit.py — do not edit.")
  out = out.push("// Target runtime: cordis v4 (https://github.com/cordiverse/cordis).")
  out = out.push("import type { Context } from 'cordis'")
  out = out.push(runtime_imports(ir))
  out = out.push("")
  out = out.concat(revl_helpers(ir))
  // Slice 3: v3 TYPE declarations (records) come right after the helpers, before
  // the functions — a service/config signature may render a declared record by
  // name, so its `interface` must precede the interface that references it.
  let types = value_field(ir, "types")
  if (value_keys(types).length() > 0) { out = out.concat(emit_ts_types(types)) }
  // The doc-level async-callable set (`_Ctx.async_names`): async externs and
  // phase-2 async-colored module fns. Threaded into every fn body so a
  // `var`-callee naming one is awaited (item 80). Built from RAW names (the
  // var-callee comparison is on the raw callee name).
  let functions = value_list(value_field(ir, "functions"))
  let externs = value_list(value_field(ir, "externs"))
  var async_names = []
  for (ext of externs) {
    if (value_bool(value_field(ext, "async"))) { async_names = async_names.push(value_str(value_field(ext, "name"))) }
  }
  for (fnode of functions) {
    if (value_bool(value_field(fnode, "async"))) { async_names = async_names.push(value_str(value_field(fnode, "name"))) }
  }
  // Externs emit before functions (mirroring `_emit_v3`) so a colored fn's
  // awaited callee is already declared above it.
  if (externs.length() > 0) { out = out.concat(emit_externs(externs)) }
  if (functions.length() > 0) { out = out.concat(emit_functions(functions, async_names)) }
  // Slice 2: the component-dialect tail (service interfaces, context
  // augmentation, components). Emits nothing for a function-only document, so
  // the slice-1 corpus stays byte-identical.
  let components = value_list(value_field(ir, "components"))
  let services = value_field(ir, "services")
  if (components.length() > 0 || value_keys(services).length() > 0) {
    out = out.concat(emit_component_tail(ir))
  }
  return py_rstrip(out.join(newline())).concat(newline())
}

// ---------------------------------------------------------------- in-file tests
test "the type map renders the scalar and generic surface" {
  assert ts_type("Int") == "bigint"
  assert ts_type("Int32") == "number"
  assert ts_type("List[Int]") == "bigint[]"
  assert ts_type("Opt[Str]") == "string | undefined"
  assert ts_type("Map[Str, Int]") == "Map<string, bigint>"
}

test "the v1 type map renders composite and declared-record signatures" {
  // the six scalars, the composites, the naive-split Map/Result, the fn type,
  // and the declared-record `known_types` path (`Msg` -> `Msg`, else `unknown`)
  assert ts_type_v1("Int", []) == "bigint"
  assert ts_type_v1("List[Int]", []) == "bigint[]"
  assert ts_type_v1("Opt[Str]", []) == "string | undefined"
  assert ts_type_v1("Map[Str, Int]", []) == "Map<string, bigint>"
  assert ts_type_v1("Result[Int, Str]", []) == expected_result_type()
  assert ts_type_v1("(Int, Str) -> Bool", []) == "((a0: bigint, a1: string) => boolean)"
  assert ts_type_v1("List[Msg]", ["Msg"]) == "Msg[]"
  assert ts_type_v1("Row", []) == "unknown"
}

fn expected_result_type() -> Str {
  return `{ kind: "Ok"; value: bigint } | { kind: "Err"; value: string }`
}

test "the slice-3 expr kinds render fn and adt" {
  // `host`/`format` end-to-end byte-checks live in the corpus (their template /
  // `$N` literals cannot be spelled in an in-file string — the lexer reserves
  // the legacy `$N`/`${` forms — so they are verified through component_exprs).
  assert expr({ kind: "fn", name: "tag", args: [{ kind: "lit", value: 1 }] }, 0, sync_acx()).text
    == "tag(1n)"
  assert expr({ kind: "adt", case: "Ok", args: [{ kind: "lit", value: 1 }] }, 0, sync_acx()).text
    == expected_ok_adt()
  assert expr({ kind: "adt", case: "Missing", args: [] }, 0, sync_acx()).text == expected_missing_adt()
}

test "the await-seed awaits a req-keyed async op only in an async, non-arrow body" {
  // `<key>.<op>(args)` on a required async service (item 141). The seed's four
  // gates: in an async provide method it awaits; a sync body, an arrow body, and
  // an op absent from `ops` all leave the Promise un-awaited (byte-for-byte the
  // reference's `_expr` component-`call` branch).
  let call = { kind: "call", target: { kind: "req", name: "store" }, method: "get",
               args: [{ kind: "name", id: "k" }] }
  let ops = [async_op_key("store", "get")]
  assert expr(call, 0, { in_async: true, in_arrow: false, ops: ops, async_names: [], async_locals: [] }).text
    == "(await ctx.store.get(k))"
  assert expr(call, 0, sync_acx()).text == "ctx.store.get(k)"
  assert expr(call, 0, { in_async: true, in_arrow: true, ops: ops, async_names: [], async_locals: [] }).text
    == "ctx.store.get(k)"
  assert expr(call, 0, { in_async: true, in_arrow: false, ops: [], async_names: [], async_locals: [] }).text
    == "ctx.store.get(k)"
}

test "the slice-6 instance-get expr kind reads a provision off a handle" {
  // `w.counter` -> `w.get("counter")` (docs/design-v2-instances.md). `spawn`'s
  // own byte-check lives in the corpus: its node carries `component`/`config`
  // keys the lexer reserves, so it cannot be spelled as an in-file record.
  assert expr({ kind: "instance-get", target: { kind: "name", id: "w" }, key: "counter" },
              0, sync_acx()).text
    == expected_instance_get()
}

fn expected_instance_get() -> Str { return `w.get("counter")` }

fn expected_ok_adt() -> Str { return `{ kind: "Ok", value: 1n }` }
fn expected_missing_adt() -> Str { return `{ kind: "Missing" }` }

test "the JS-keyword mangle appends underscores" {
  assert mangle("class") == "class_"
  assert mangle("new") == "new_"
  assert mangle("total") == "total"
}

test "the JS-keyword mangle is injective" {
  // `class` and the equally legal revl identifier `class_` must not both land
  // on `class_`: the ladder shifts up a rung instead of collapsing.
  assert mangle("class_") == "class__"
  assert mangle("class__") == "class___"
  assert mangle("new_") == "new__"
  // a name with no reserved root is verbatim, trailing underscores and all
  assert mangle("total_") == "total_"
  assert mangle("classic") == "classic"
}

test "the binary-operator map lowers to JS operators" {
  assert ts_bin_op("==") == "==="
  assert ts_bin_op("!=") == "!=="
  assert ts_bin_op("&&") == "&&"
  assert ts_bin_op("%") == "%"
}

test "literals render as bigint / keyword / string forms" {
  assert render_lit({ kind: "lit", value: 3 }) == "3n"
  assert indentation_is_two_spaces()
}

fn indentation_is_two_spaces() -> Bool {
  return ind(0) == "" && ind(2) == "    "
}

// --------------------------------------------------------------- component wrap
// A trivial provider so the emitted module is a valid plugin (the pure
// `emit_ts_src` above is what the cross-check exercises); mirrors the wrapper the
// other self-host stages carry. `render` avoids the `emit` keyword.
service EmitStream {
  fn render(ir: Any) -> Str
}

component EmitTs provides emitter: EmitStream {
  provide emitter {
    fn render(ir) = emit_ts_src(ir)
  }
}
