// The revl lexer, in revl (syntax-2.0 §11 — the self-hosting exit
// criterion's first stage). Pure stratum + the stdlib surface only.
//
// Token parity is with src/revl/lexer.py, canonicalized as
// { kind, text, line } records (ints render as their digits; template
// parts serialize as "t:<text>" / "v:<name>" joined by "|"; the template
// token's line is the END line, matching the reference lexer). Host
// bodies (@backend { ... }) are not yet lexed — none of the corpus needs
// them.
//
// revl plain strings carry no escapes, so unprintable characters are
// matched by code point: 9 tab, 10 newline, 13 CR, 32 space, 34 quote,
// 36 dollar, 96 backtick. Lookahead uses slice (clamping), never a
// bare charAt past the end.

pub type Token = { kind: Str, text: Str, line: Int }
type Step = { i: Int, line: Int, tok: Token }
type Scan = { j: Int, out: Str, nl: Int }

service TokenStream {
  fn lex(source: Str) -> List[Token]
}

fn code0(c: Str) -> Int {
  if (c == "") { return 0 - 1 }
  return c.charCodeAt(0)
}

// The per-character classification predicates. These ran on the hot path
// (once per source byte in the identifier/number scan loops), and each
// previously cost a revl-fn call plus a `code0`/`charCodeAt` round-trip and
// a code-point range compare. They now defer to the native single-char ASCII
// classification builtins (item 233, docs/stdlib-2.0.md §Str.is_alnum), which
// the py tier lowers to an inline comparison — same tokens, less per-byte tax.
// The builtins are letters/digits only, so the lexer's `_`-in-identifiers rule
// stays explicit here, and `is_space` re-excludes newline (the main loop tracks
// lines separately) while `is_ws` — newline included — is exactly the builtin.
fn is_digit(c: Str) -> Bool {
  return c.is_digit()
}

fn is_alpha(c: Str) -> Bool {
  if (c == "_") { return true }
  return c.is_alpha()
}

fn is_alnum(c: Str) -> Bool {
  if (c == "_") { return true }
  return c.is_alnum()
}

fn is_space(c: Str) -> Bool {
  if (code0(c) == 10) { return false }
  return c.is_space()
}

fn keywords() -> List[Str] {
  return ["service", "component", "requires", "provides", "config", "let",
    "effect", "undo", "emit", "emission", "provide", "fn", "return",
    "true", "false", "null",
    "isolate", "intercept", "realm", "in", "with",
    "handoff",
    "spawn",
    "every", "after",
    "type", "use", "pub", "var", "while", "for", "of", "if", "else",
    "match", "test", "assert", "async", "as", "fail",
    "hole",
    "extern", "acquire", "pure", "compensate", "await", "verified", "commutative",
    "idempotent"]
}

fn ops3() -> List[Str] { return ["===", "!=="] }

fn ops2() -> List[Str] {
  return ["=>", "?.", "??", "<=", ">=", "==", "!=", "&&", "||", "->"]
}

fn singles() -> Str { return "{}()[],:=.+-*/%<>!?;|@" }

// Longest-match operator at position i; "" when none.
fn op_at(source: Str, i: Int) -> Str {
  let three = source.slice(i, i + 3)
  if (ops3().indexOf(three) != 0 - 1) { return three }
  let two = source.slice(i, i + 2)
  if (ops2().indexOf(two) != 0 - 1) { return two }
  return ""
}

// Scan an identifier/keyword tail: chars satisfying is_alnum.
fn scan_word(source: Str, i: Int) -> Scan {
  var j = i
  let n = source.length()
  // Hot loop: use the classification builtin directly (no is_alnum fn call
  // per byte). `||` short-circuits, so the `_` charAt only runs on the run's
  // terminating non-alnum char — one charAt per identifier byte in practice.
  while (j < n && (source.charAt(j).is_alnum() || source.charAt(j) == "_")) { j += 1 }
  let jj = j
  return { j: jj, out: source.slice(i, jj), nl: 0 }
}

fn scan_digits(source: Str, i: Int) -> Scan {
  var j = i
  let n = source.length()
  // Hot loop: the is_digit builtin is exactly the lexer's digit set, so the
  // per-byte revl-fn call drops out.
  while (j < n && source.charAt(j).is_digit()) { j += 1 }
  let jj = j
  return { j: jj, out: source.slice(i, jj), nl: 0 }
}

// Plain string body after the opening quote; out is the text, j is the
// index AFTER the closing quote. Unterminated / newline -> j = -1.
fn scan_string(source: Str, i: Int) -> Scan {
  var j = i
  let n = source.length()
  var out = ""
  while (j < n) {
    // j < n holds, so the code point at j exists: fetch it directly (item 276)
    // rather than allocating a 1-char Str via charAt to feed code0. `c` is
    // still needed for the out.concat below.
    let c = source.charAt(j)
    let cc = source.codepoint_at(j)
    if (cc == 34) {
      let jj = j
      let text = out
      return { j: jj + 1, out: text, nl: 0 }
    }
    if (cc == 10) {
      let text2 = out
      return { j: 0 - 1, out: text2, nl: 0 }
    }
    if (cc != 34 && cc != 10) {
      out = out.concat(c)
      j += 1
    }
  }
  let text3 = out
  return { j: 0 - 1, out: text3, nl: 0 }
}

// Three consecutive `"` (code point 34) at j. The `"""` delimiter cannot be
// written as a plain literal (no escapes) nor a triple literal (it would
// close), so it is matched by code point, like the rest of this file.
fn is_triple_at(source: Str, j: Int) -> Bool {
  if (code0(source.slice(j, j + 1)) != 34) { return false }
  if (code0(source.slice(j + 1, j + 2)) != 34) { return false }
  return code0(source.slice(j + 2, j + 3)) == 34
}

// Triple-quoted verbatim string body after the opening `"""` (i is the
// index just past it). The body is literal characters up to the next
// `"""` — no escapes, no `${}` interpolation; a lone `"` or `""` inside is
// ordinary text. A single newline right after the opener is stripped so a
// literal opening on its own line has no leading blank line, and `""""""`
// is the empty string. out is the text, j is the index AFTER the closing
// `"""`, nl counts newlines consumed (the stripped leading one included) so
// the caller can advance the line counter. Unterminated -> j = -1.
fn scan_triple(source: Str, i: Int) -> Scan {
  var j = i
  let n = source.length()
  var out = ""
  var nl = 0
  // Strip a single leading newline right after the opening delimiter.
  if (code0(source.slice(j, j + 1)) == 10) {
    nl += 1
    j += 1
  }
  while (j < n) {
    if (is_triple_at(source, j)) {
      let jj = j
      let text = out
      let lines = nl
      return { j: jj + 3, out: text, nl: lines }
    }
    // j < n holds here (loop guard); read the code point directly (item 276).
    let c = source.charAt(j)
    if (source.codepoint_at(j) == 10) { nl += 1 }
    out = out.concat(c)
    j += 1
  }
  let lines2 = nl
  return { j: 0 - 1, out: "", nl: lines2 }
}

// Template parts are flattened into one Str (a token carries no richer
// shape), joined by "|" — so a part whose own text contains "|" would be
// unrecoverable. `${a || b}` is ordinary revl, and a differential fuzz
// against the reference parser hit it about once in 400 expressions.
// Escape "%" as "%%" and "|" as "%p"; the decoder scans left to right, so
// "%%p" reads back as "%p" and not as "|".
fn esc(s: Str) -> Str {
  return s.split("%").join("%%").split("|").join("%p")
}

// Whitespace including newline (is_space deliberately excludes it, since
// the main loop tracks lines). Used to trim an interpolation body, which
// the reference lexer does with str.strip().
fn is_ws(c: Str) -> Bool {
  return c.is_space()
}

fn trim(s: Str) -> Str {
  var a = 0
  var b = s.length()
  while (a < b && is_ws(s.slice(a, a + 1))) { a += 1 }
  while (b > a && is_ws(s.slice(b - 1, b))) { b -= 1 }
  let aa = a
  let bb = b
  return s.slice(aa, bb)
}

// The balanced-brace body of a `${` interpolation, starting at i (the
// char after `{`). Returns j = index OF the closing `}`, out = the raw
// source between the braces, nl = newlines consumed. j = -1 if unbalanced.
// Raw capture is what the reference lexer does: the parser re-parses the
// body as a full expression, so `${a + b}` and `${r.count}` are legal.
fn scan_interp(source: Str, i: Int) -> Scan {
  var j = i
  let n = source.length()
  var depth = 1
  var nl = 0
  while (j < n) {
    // The code point at j is all this scan needs (no concat), so read it
    // directly (item 276) — no 1-char Str allocated per byte.
    let cc = source.codepoint_at(j)
    if (cc == 123) { depth += 1 }
    if (cc == 125) {
      depth -= 1
      if (depth == 0) {
        let jj = j
        let lines = nl
        return { j: jj, out: source.slice(i, jj), nl: lines }
      }
    }
    if (cc == 10) { nl += 1 }
    j += 1
  }
  let lines2 = nl
  return { j: 0 - 1, out: "", nl: lines2 }
}

// Template body after the opening backtick. Parts serialize as
// "t:<text>" / "v:<name>" joined by "|"; nl counts newlines consumed so
// the caller reports the END line (reference-lexer parity).
fn scan_template(source: Str, i: Int) -> Scan {
  var j = i
  let n = source.length()
  var parts = []
  var buf = ""
  var nl = 0
  while (j < n) {
    // j < n holds; read the code point directly (item 276). `c` is still
    // needed for the buf.concat in the default (literal-text) branch below.
    let c = source.charAt(j)
    let cc = source.codepoint_at(j)
    if (cc == 96) {
      if (buf != "") { parts = parts.push("t:".concat(esc(buf))) }
      let jj = j
      let done = parts
      let lines = nl
      return { j: jj + 1, out: done.join("|"), nl: lines }
    }
    if (cc != 96) {
      var handled = false
      if (cc == 36 && source.slice(j + 1, j + 2) == "{") {
        let inner = scan_interp(source, j + 2)
        if (inner.j == 0 - 1) {
          let lines2 = nl + inner.nl
          return { j: 0 - 1, out: "", nl: lines2 }
        }
        let body = trim(inner.out)
        if (body == "") {
          let lines3 = nl + inner.nl
          return { j: 0 - 1, out: "", nl: lines3 }
        }
        if (buf != "") { parts = parts.push("t:".concat(esc(buf))) }
        buf = ""
        parts = parts.push("v:".concat(esc(body)))
        nl += inner.nl
        j = inner.j + 1
        handled = true
      }
      if (!handled) {
        if (cc == 10) { nl += 1 }
        buf = buf.concat(c)
        j += 1
      }
    }
  }
  let lines = nl
  return { j: 0 - 1, out: "", nl: lines }
}

// Skip a // comment: index of the next newline (or n).
fn scan_comment(source: Str, i: Int) -> Scan {
  var j = i
  let n = source.length()
  while (j < n && source.codepoint_at(j) != 10) { j += 1 }
  let jj = j
  return { j: jj, out: "", nl: 0 }
}

// Count newlines (code point 10) in s — the host-block line advance.
fn count_nl(s: Str) -> Int {
  var c = 0
  var i = 0
  let n = s.length()
  while (i < n) {
    if (s.codepoint_at(i) == 10) { c += 1 }
    i += 1
  }
  return c
}

// The `@backend { <verbatim, brace-balanced> }` host body (reference lexer's
// `hostbody`): k is the opening `{`. Returns j = index just past the closing
// `}`, out = the verbatim body between the braces. j = -1 unterminated.
// Depth counting only: a host body whose host STRING or COMMENT carries a `}`
// (e.g. `@py { s = "}" }`) is the reference matcher's trivia-aware case and is
// not exercised by the covered corpus. The whole `@backend { … }` becomes ONE
// token — the body is host text, not revl, so it is never tokenized as revl.
fn scan_host_body(source: Str, k: Int) -> Scan {
  var j = k + 1
  let n = source.length()
  var depth = 1
  while (j < n) {
    let cc = source.codepoint_at(j)
    if (cc == 123) { depth += 1 }
    if (cc == 125) {
      depth -= 1
      if (depth == 0) {
        let jj = j
        return { j: jj + 1, out: source.slice(k + 1, jj), nl: 0 }
      }
    }
    j += 1
  }
  return { j: 0 - 1, out: "", nl: 0 }
}

// One lexing step at (i, line): the next state and at most one token
// (kind "" means this step produced no token).
fn step(source: Str, i: Int, line: Int) -> Step {
  let none = { kind: "", text: "", line: line }
  // step is only called with i < source.length() (the lex_src loop guard), so
  // the code point at i exists: read it directly (item 276). `c` is still used
  // as the token text / classifier receiver in the branches below.
  let c = source.charAt(i)
  let cc = source.codepoint_at(i)
  if (cc == 10) { return { i: i + 1, line: line + 1, tok: none } }
  // c is not newline here (the cc == 10 case returned), so the classifier
  // builtin is exactly is_space(c) — call it directly, skipping the fn call.
  if (c.is_space()) { return { i: i + 1, line: line, tok: none } }
  if (source.slice(i, i + 2) == "//") {
    let sc = scan_comment(source, i)
    return { i: sc.j, line: line, tok: none }
  }
  let op = op_at(source, i)
  if (op != "") {
    let kind = op == "->" ? "arrow" : op
    return { i: i + op.length(), line: line,
             tok: { kind: kind, text: op, line: line } }
  }
  if (cc == 34) {
    // `"""` takes precedence over a single `"` (reference lexer order): a
    // verbatim, possibly multi-line string. The token's line is the OPENING
    // line, while the next state advances past every newline consumed.
    if (is_triple_at(source, i)) {
      let ts = scan_triple(source, i + 3)
      if (ts.j == 0 - 1) {
        return { i: source.length(), line: line,
                 tok: { kind: "error", text: "unterminated triple string", line: line } }
      }
      return { i: ts.j, line: line + ts.nl,
               tok: { kind: "string", text: ts.out, line: line } }
    }
    let ss = scan_string(source, i + 1)
    if (ss.j == 0 - 1) {
      return { i: source.length(), line: line,
               tok: { kind: "error", text: "unterminated string", line: line } }
    }
    return { i: ss.j, line: line, tok: { kind: "string", text: ss.out, line: line } }
  }
  if (cc == 96) {
    let st = scan_template(source, i + 1)
    if (st.j == 0 - 1) {
      return { i: source.length(), line: line,
               tok: { kind: "error", text: "bad template", line: line } }
    }
    return { i: st.j, line: line + st.nl,
             tok: { kind: "template", text: st.out, line: line + st.nl } }
  }
  if (is_alpha(c)) {
    let sw = scan_word(source, i)
    let kind2 = keywords().indexOf(sw.out) != 0 - 1 ? "kw" : "ident"
    return { i: sw.j, line: line, tok: { kind: kind2, text: sw.out, line: line } }
  }
  if (is_digit(c)) {
    let sd = scan_digits(source, i)
    // A float needs a fraction or an exponent. `.` only starts one when a
    // digit follows, so `7.div_trunc(2)` stays an Int and a method call;
    // `1e` is an Int beside an ident, not an error.
    var j = sd.j
    var isf = false
    if (source.slice(j, j + 1) == "." && is_digit(source.slice(j + 1, j + 2))) {
      let frac = scan_digits(source, j + 1)
      j = frac.j
      isf = true
    }
    let e = source.slice(j, j + 1)
    if (e == "e" || e == "E") {
      var k = j + 1
      let sign = source.slice(k, k + 1)
      if (sign == "+" || sign == "-") { k += 1 }
      if (is_digit(source.slice(k, k + 1))) {
        let ex = scan_digits(source, k)
        j = ex.j
        isf = true
      }
    }
    let jj = j
    let kind3 = isf ? "float" : "int"
    return { i: jj, line: line, tok: { kind: kind3, text: source.slice(i, jj), line: line } }
  }
  if (cc == 64) {
    // `@backend { ... }` host body -> a single `hostbody` token (reference
    // lexer parity). The token text encodes `<backend>{<verbatim body>`; the
    // backend name is `[A-Za-z0-9_]+` (never a `{`), so the first `{` splits
    // it from the body. A bare `@` (not followed by an identifier) is the
    // ordinary `@` operator.
    let nxt = source.slice(i + 1, i + 2)
    if (nxt != "" && is_alpha(nxt)) {
      let n1 = source.length()
      var jb = i + 1
      while (jb < n1 && (source.charAt(jb).is_alnum() || source.charAt(jb) == "_")) { jb += 1 }
      let backend = source.slice(i + 1, jb)
      var kb = jb
      while (kb < n1 && source.codepoint_at(kb) != 10 && source.charAt(kb).is_space()) { kb += 1 }
      // whitespace before `{` may include a newline
      while (kb < n1 && source.codepoint_at(kb) == 10) { kb += 1 }
      if (kb < n1 && source.charAt(kb) == "{") {
        let hb = scan_host_body(source, kb)
        if (hb.j == 0 - 1) {
          return { i: source.length(), line: line,
                   tok: { kind: "error", text: "unterminated host body", line: line } }
        }
        let nl = count_nl(source.slice(i, hb.j))
        return { i: hb.j, line: line + nl,
                 tok: { kind: "hostbody", text: backend.concat("{").concat(hb.out), line: line } }
      }
    }
    return { i: i + 1, line: line, tok: { kind: "@", text: "@", line: line } }
  }
  if (singles().indexOf(c) != 0 - 1) {
    return { i: i + 1, line: line, tok: { kind: c, text: c, line: line } }
  }
  return { i: i + 1, line: line,
           tok: { kind: "error", text: c, line: line } }
}

pub fn lex_src(source: Str) -> List[Token] {
  var out = []
  var i = 0
  var line = 1
  let n = source.length()
  while (i < n) {
    let s = step(source, i, line)
    if (s.tok.kind != "") { out = out.push(s.tok) }
    i = s.i
    line = s.line
  }
  let ll = line
  out = out.push({ kind: "eof", text: "", line: ll })
  return out
}

test "lexes a component header" {
  let toks = lex_src("component C requires kv: Kv {}")
  assert toks[0].kind == "kw"
  assert toks[0].text == "component"
  assert toks[1].kind == "ident"
  assert toks[4].kind == ":"
  assert toks.length() == 9
}

test "operators lex longest-first" {
  let toks = lex_src("a === b -> c")
  assert toks[1].kind == "==="
  assert toks[3].kind == "arrow"
}

test "template parts serialize" {
  let toks = lex_src("`hi ${name}!`")
  assert toks[0].kind == "template"
  assert toks[0].text == "t:hi |v:name|t:!"
}

component Lexer provides tokens: TokenStream {
  provide tokens {
    fn lex(source) = lex_src(source)
  }
}
