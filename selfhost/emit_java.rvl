// The revl backend-IR -> cordis4j EMITTER, in revl — Path B for the JAVA tier.
// Where selfhost/emit_py.rvl ports the tail of the compiler to Python and
// selfhost/emit_rust.rvl to Rust, this file ports it to Java: it reads the stable
// interchange IR (docs/backend-ir.md) and produces Java source text, mirroring
// backends/java/emit.py.
//
// It is one half of a differential BYTE oracle: this file and
// backends/java/emit.py's `emit()` are two independent implementations of the
// same lowering, forced to produce BYTE-IDENTICAL Java for every input in the
// covered subset (tests/test_selfhost_emit_java.py). The reference is ground
// truth; any divergence is a defect in this slice.
//
// ============================================================ WHAT IT COVERS
// Every IR the frontend produces is ir_version 3, so the covered slice mirrors
// the reference's v3 path (`_emit_v3` -> `_emit_v3_types` /
// `_emit_service_interfaces_v3` / `_emit_v3_functions` / `_emit_component` ->
// `_expr` / `_v3_stmt`) for a document with NO externs, NO tests, NO stdlib
// builtins, NO built-in Result, and only SIMPLE (pure-provider) components — the
// v3 typed-core PLUS the smallest byte-exact component/service unit:
//
//   * SLICE 1 (item 199) — the module scaffold (the two banner comments, the
//     `package revl;`, the five unconditional `import io.cordis4j.core.*;` lines,
//     and the `public final class Components { private Components() {} }`
//     wrapper); `_emit_v3_functions` (each module fn a `public static` method,
//     `_java_v3_type` for scalar / `List` / `Opt` / `Map` / `Result` types,
//     keyword renaming, `// (empty body)`); `_v3_stmt` (let/assign, return,
//     if/while/for, bare-expr, assert); and the base `_expr` algebra (lit, name,
//     var incl `None`->`Optional.empty()`, bin incl `??`/`==`/exact-arith/`/`/
//     comparisons/`&&`, un incl `Math.negateExact`, the 2.0 call and the `fn`
//     call with `Some`/`None`, the widen markers, field, index, ternary, list,
//     the empty `maplit`, and non-float `${..}` interpolation).
//
//   * SLICE 2 (item 210 — THIS slice) the v3 TYPED-CORE:
//       - `_emit_v3_types` — a user `record` type as a `public static final class`
//         (public final fields + a canonical ctor), a `variant` type as a
//         `public sealed interface … permits …` with one `final class … implements`
//         per case (nullary or single-`value` payload);
//       - the `_V3Ctx` type-table inference — `case_owners` (a case name -> its
//         sealed interface), each case's has-payload flag, `record_by_fields` (a
//         record's field-SET -> its nominal class), and each variant's full case
//         set (drives `_covers_variant`);
//       - ADT construction — the `adt` node AND a `call`/`var` whose callee names
//         a user case, both `new Owner.Case(args)`; the `_adt_binding_type` `let`
//         (`final Owner o = …`, restoring the interface type the frontend gave);
//       - record LITERALS — `new Type(args)` with the argument order taken from
//         the type's DECLARED field order (values rendered in literal order);
//       - `match` over user variants — a pattern `switch` with the reference's
//         document-wide `__revl_case_N` / `__revl_ignored_N` temp numbering
//         (threaded here as an Int counter — revl has no method state — since the
//         numbering is otherwise unreproducible), the bound-arm `.value` unpack,
//         the `_covers_variant` omission of the `default` throw for a total match;
//         and the built-in Opt `Some`/`None` match (`.map(..).orElseGet(..)`);
//       - user type NAMES wherever `_java_v3_type` meets one (`_ident`/`_mangle`).
//
// ============================================================ WHAT IT DEFERS
// Reported for follow-on java-emitter slices, deliberately OUT of this slice —
// each is a real reference surface this slice does not reach (its fixtures avoid
// it), NOT an approximation. Where a covered fixture could plausibly reach one, a
// loud `<<DEFER-*>>` marker keeps a byte diff from silently passing (item 207):
//   * the MODERN component path (`_emit_component_modern`) — isolate/intercept,
//     effectful method bodies, and any `if`/`fail`/`await`/`return`/`setup` body
//     step (the `Context.EffectScope fx` provider shape). A component outside the
//     `component_simple_ok` predicate routes to `<<DEFER-component-nonsimple:N>>`;
//   * component `config` (the parameterised `<Comp>Plugin` ctor +
//     `_config_default_lit`) — a config-carrying component stays LEGACY but is
//     deferred here; required-service routing (`req`/the `ctx.get` locals +
//     provider fields); `let-effect`/`effect`/`emit` teardown steps; async/spawn/
//     realms; and the `await`->AsyncPlugin / `fail`->CordisException import
//     widening (`_core_imports`);
//   * the HOST Map/generics surface — `_emit_host_stubs`' `HashMap<String,V>` with
//     per-site value inference (`_map_value_expr_type`) is component-bind territory
//     (deferred with them). The plain v3 `maplit` (`new java.util.HashMap<>()`)
//     and the `Map[K,V]` TYPE lowering ARE covered;
//   * the STDLIB surface — every `builtin`/`len` node and `_emit_stdlib_helpers`
//     / `revlLength`;
//   * the built-in Result surface — `Ok`/`Err` construction and `match`, the
//     sealed `RevlResult` (`_emit_result_type`), and `_emit_checked_div_helpers`;
//   * functional record-update `{r | f = e}` — the JAVA reference itself RAISES on
//     `record_update` (only python/typescript emit it), a structural exclusion;
//   * async coloring (await/join), spawn/instances (`_v3_spawn`/`instance-get`),
//     externs (`_emit_v3_externs`), in-file `test`/lifecycle-test emission, and
//     the canonical Float->Str `revlFtoa` (so `${aFloat}` interpolation is
//     excluded, since it also pulls in the `_emit_ftoa_helper` block);
//   * java-specific NUANCES — the `_reject_fn_type` refusal of a declared function
//     type, local `let`-bound arrows and their `_inline_arrow` beta-reduction, and
//     `let_pattern` (its temp name is `__revl_destructure_{id(node)}`, a host
//     identity no port reproduces).
//
// ------------------------------------------------------ the erased-IR boundary
// Navigation of the IR is PURE revl through stdlib/value.rvl's `value_*` (items
// 180 / 188), stdlib/str.rvl's `trim`/`split_top`, and stdlib/list.rvl's
// `list_contains`/`list_sort`/`list_dedup` — exactly as the other Path B emitters
// do: every byte of emitter LOGIC (dispatch, formatting, the string building) is
// revl. Only HOST FORMATTING stays `@py` — the item-180 "NOT obsoleted" category:
// `json_dumps` (the reference `_string`/`_lit` call Python's `json.dumps`, so
// bridging it is faithful) and `num_str` (`str(value)`). `newline` and
// `mangle`/`_fn_name` are PURE revl (a backtick newline and a `list_contains`
// scan), no `@py` needed.
use "../stdlib/value.rvl" {
  value_kind, value_is_null, value_field, value_keys,
  value_list, value_at, value_str, value_bool
}
use "../stdlib/str.rvl" { trim, split_top, last_index_of, rstrip }
use "../stdlib/list.rvl" { list_contains, list_sort, list_dedup }

// ------------------------------------------------- host formatting (kept @py)
// The reference renders string literals with `json.dumps` (`_string`), and a
// str-literal `_lit` is `json.dumps(value)`. Bridged verbatim — the ASCII and
// escape behaviour is Python's, exactly as the reference's.
extern pure fn json_dumps(v: Any) -> Str = @py {
    import json
    return json.dumps(v)
}
// The literal-body host numeral: `_lit` renders an int as `f"{value}L"` and a
// float as `f"{value}d"`, both `str(value)`. Sourced here so the numeral text is
// exactly Python's.
extern pure fn num_str(v: Any) -> Str = @py { return str(v) }
// `_camel` verbatim (item 207 bridges the identical body for rust): a provision
// key -> its PascalCase struct suffix, `"".join(part.capitalize() for part in
// name.split("_"))`. The java reference `_camel` IS this python byte-for-byte, so
// bridging it is faithful host FORMATTING (the item-180 "NOT obsoleted" category,
// like `json_dumps`/`num_str`), not compiler logic left in @py.
extern pure fn camel(name: Str) -> Str = @py {
    return "".join(part.capitalize() for part in name.split("_"))
}

// A real newline (U+000A) as the line SEPARATOR (`"\n".join(out)` in the
// reference). PURE revl: revl `"..."` carries no escapes, but a backtick
// template CAN hold a literal newline byte, lowering as a one-char string
// literal on every tier (see stdlib/str.rvl `nl`).
fn newline() -> Str {
  return `
`
}

// ---------------------------------------------------------------- small utils
fn ind(n: Int) -> Str { return "    ".repeat(n) }
fn node_kind(n: Any) -> Str { return value_str(value_field(n, "kind")) }
fn node_op(n: Any) -> Str { return value_str(value_field(n, "op")) }
fn node_operands(n: Any) -> Str { return value_str(value_field(n, "operands")) }

// The module tail `"\n".join(out).rstrip() + "\n"` uses stdlib/str.rvl's
// `rstrip` (ASCII-whitespace trailing strip — the only trailing bytes here are
// blank lines and the join's `\n`, so it matches Python's `.rstrip()`).

// -------------------------------------------------- keyword-collision renames
// `_JAVA_RESERVED`: a valid revl identifier that is a Java keyword is renamed by
// appending `_` until free (`_mangle`), so declaration and use sites agree
// without a table. A List + `list_contains` keeps this PURE revl.
fn java_reserved() -> List[Str] {
  return ["abstract", "assert", "boolean", "break", "byte", "case", "catch",
          "char", "class", "const", "continue", "default", "do", "double",
          "else", "enum", "extends", "final", "finally", "float", "for", "goto",
          "if", "implements", "import", "instanceof", "int", "interface", "long",
          "native", "new", "package", "private", "protected", "public", "return",
          "short", "static", "strictfp", "super", "switch", "synchronized",
          "this", "throw", "throws", "transient", "try", "void", "volatile",
          "while", "var", "record", "yield"]
}
// `_EMITTER_RESERVED`: `_fn_name` also renames a callable colliding with these.
fn emitter_reserved() -> List[Str] { return ["ctx", "config", "root"] }

// `_mangle` (== `_ident`'s rename for a binding/param/name/type).
fn mangle(name: Str) -> Str {
  var n = name
  while (list_contains(java_reserved(), n)) { n = n.concat("_") }
  return n
}
// `_fn_name`: a top-level callable colliding with a Java keyword OR the emitter's
// scaffolding names is renamed the same way.
fn fn_name(name: Str) -> Str {
  var n = name
  while (list_contains(java_reserved(), n) || list_contains(emitter_reserved(), n)) {
    n = n.concat("_")
  }
  return n
}

// The postfix-safe primaries (`_V3_POSTFIX_SAFE_KINDS`): a `.method()` suffix
// appends without wrapping parens.
fn is_postfix_safe(kind: Str) -> Bool {
  if (kind == "var") { return true }
  if (kind == "field") { return true }
  if (kind == "index") { return true }
  if (kind == "call") { return true }
  if (kind == "lit") { return true }
  if (kind == "name") { return true }
  if (kind == "req") { return true }
  if (kind == "config") { return true }
  if (kind == "host") { return true }
  return kind == "fn"
}
// `_V3_ATOMIC_KINDS`: a target renders as a Java primary, so `.field`/`.get(..)`
// appends without parens.
fn is_atomic(kind: Str) -> Bool {
  if (kind == "var") { return true }
  if (kind == "field") { return true }
  if (kind == "index") { return true }
  if (kind == "call") { return true }
  return kind == "lit"
}

// The `_JAVA_V3_BIN_OPS` table: revl operator -> Java operator, "" when unmapped.
fn java_bin_ops(op: Str) -> Str {
  if (op == "<") { return "<" }
  if (op == ">") { return ">" }
  if (op == "<=") { return "<=" }
  if (op == ">=") { return ">=" }
  if (op == "+") { return "+" }
  if (op == "-") { return "-" }
  if (op == "*") { return "*" }
  if (op == "/") { return "/" }
  if (op == "%") { return "%" }
  if (op == "&&") { return "&&" }
  if (op == "||") { return "||" }
  return ""
}
fn exact_method(op: Str) -> Str {
  if (op == "+") { return "addExact" }
  if (op == "-") { return "subtractExact" }
  return "multiplyExact"
}
fn is_addsubmul(op: Str) -> Bool { return op == "+" || op == "-" || op == "*" }
fn is_int_operand(opnd: Str) -> Bool { return opnd == "Int" || opnd == "Int32" }

// ---------------------------------------------------------------- lowering ctx
// The names and type layouts visible to the expression emitters (`_V3Ctx`,
// subset). The user-type tables mirror the reference's `_V3Ctx` construction:
//   * `fns`    — top-level callable names, so a `var`/`call` callee that names a
//                function resolves through `_fn_name`;
//   * `ca`     — `case_owners`: a variant case name -> its sealed interface name
//                (`<<AMBIG>>` when two decls share a case name, exactly where the
//                reference stores `None`);
//   * `cp`     — each case's has-payload flag ("y"/"n");
//   * `rbf`    — `record_by_fields`: a record's field-SET key -> its class name;
//   * `vcases` — a variant name -> the sorted-joined KEY of its full case set,
//                for `_covers_variant`;
//   * `rfields`— a record name -> its DECLARED field names, comma-joined, so a
//                record literal orders its ctor arguments by declaration order.
// The counter (`_V3Ctx._match_counter`) is NOT here: revl records are immutable,
// so it is threaded separately as an Int through every renderer.
// `rn` is the component-capture RENAME map (`_expr`'s `rename` param, item 225):
// a bind/req NAME -> the Java expression it lowers to inside a modern provide-
// method body (`sink` -> `this.sink`). Empty on the pure v3 path (slices 1-3) and
// the legacy simple-provider path, so those emit exactly as before; the modern
// component path (`emit_component_modern`) swaps in a fresh map per render.
// Carrying it ON THE CTX — which already threads through every `render_*` — lets
// a `req`/`name` nested inside a call/interp subexpression pick up the active
// rename for free, mirroring the reference's `rename` recursion.
type Ctx = {
  fns: Map[Str, Bool], ca: Map[Str, Str], cp: Map[Str, Str],
  rbf: Map[Str, Str], vcases: Map[Str, Str], rfields: Map[Str, Str],
  rn: Map[Str, Str]
}
// A rendered expression: its text AND the running match-temp counter.
type Rendered = { text: Str, counter: Int }
// One or more statement lines AND the threaded match counter.
type Sout = { lines: List[Str], counter: Int }

fn map_get(m: Map[Str, Str], k: Str) -> Str {
  return match m.lookup(k) { Some(v) => v, None => "" }
}
fn has_fn(ctx: Ctx, name: Str) -> Bool {
  return match ctx.fns.lookup(name) { Some(v) => v, None => false }
}
// A resolved (unique, non-ambiguous) lookup — an empty string OR the `<<AMBIG>>`
// sentinel both mean "not a byte-exact target here".
fn resolved(name: Str) -> Bool { return name != "" && name != "<<AMBIG>>" }
// The field/case-set KEY: the names sorted (Python `set(..)`/`sorted(..)`),
// joined with a `,`. `list_sort` is the codepoint sort the reference uses.
fn sorted_key(names: List[Str]) -> Str { return list_sort(names).join(",") }

// `_V3Ctx.record_type_for_fields`: a record literal's nominal class, from its
// field SET. Reference RAISES on no-unique-match; here the sentinel keeps the
// emitter total (no in-corpus literal is ambiguous or unknown).
fn record_type_for_fields(ctx: Ctx, names: List[Str]) -> Str {
  return map_get(ctx.rbf, sorted_key(names))
}

// `_covers_variant`: do these arm patterns name EVERY case of one sealed ADT? If
// so the reference omits the `default -> throw` arm (a total pattern switch is
// complete to javac). One owner, and its full case set present.
fn covers_variant(ctx: Ctx, patterns: List[Str]) -> Bool {
  let ps = list_dedup(patterns)
  var owner = ""
  for (p of ps) {
    let o = map_get(ctx.ca, p)
    if (!resolved(o)) { return false }
    if (owner == "") { owner = o } else { if (owner != o) { return false } }
  }
  if (owner == "") { return false }
  return sorted_key(ps) == map_get(ctx.vcases, owner)
}

// -------------------------------------------------------------------- types
// `_split_v3_types`: split `A, B` on top-level commas (bridged to str.split_top).
// `_java_v3_type`: IR v3 surface type -> Java type. `boxed` picks the reference-
// wrapper form for a type-ARGUMENT position (only long/double/boolean box in the
// v3 table — `int`/`String`/etc. pass through, matching the reference's inline
// dict, which is intentionally narrower than the v1/v2 `_BOXED`).
fn box(java_type: Str, boxed: Bool) -> Str {
  if (!boxed) { return java_type }
  if (java_type == "long") { return "java.lang.Long" }
  if (java_type == "double") { return "java.lang.Double" }
  if (java_type == "boolean") { return "java.lang.Boolean" }
  return java_type
}
fn type_map(name: Str) -> Str {
  if (name == "Str") { return "String" }
  if (name == "Int") { return "long" }
  if (name == "Int32") { return "int" }
  if (name == "Float") { return "double" }
  if (name == "Bool") { return "boolean" }
  if (name == "Bytes") { return "byte[]" }
  if (name == "Unit") { return "void" }
  return ""
}
fn java_v3_type(tv: Any, boxed: Bool) -> Str {
  if (value_is_null(tv)) { return "void" }
  let raw = value_str(tv)
  if (raw == "Unit") { return "void" }
  let name = trim(raw)
  if (name == "") { return "Object" }
  let tm = type_map(name)
  if (tm != "") { return box(tm, boxed) }
  if (name.indexOf("[") >= 0) {
    let lb = name.indexOf("[")
    let base = name.slice(0, lb)
    let inner = name.slice(lb + 1, last_index_of(name, "]"))
    let args = split_top(inner, ",")
    if (base == "List" && args.length() > 0) {
      return `java.util.List<${java_v3_type(args[0], true)}>`
    }
    if (base == "Opt" && args.length() > 0) {
      return `java.util.Optional<${java_v3_type(args[0], true)}>`
    }
    if (base == "Map" && args.length() == 2) {
      return `java.util.Map<${java_v3_type(args[0], true)}, ${java_v3_type(args[1], true)}>`
    }
    if (base == "Result" && args.length() == 2) {
      return `RevlResult<${java_v3_type(args[0], true)}, ${java_v3_type(args[1], true)}>`
    }
    var objs = []
    for (a of args) { objs = objs.push("Object") }
    return `${base}<${objs.join(", ")}>`
  }
  // A user type name (`_ident`) — mapped to its emitted class/interface name.
  return mangle(name)
}

// `_lit`: a v3 literal.
fn java_lit(node: Any) -> Str {
  let v = value_field(node, "value")
  let k = value_kind(v)
  if (k == "null") { return "null" }
  if (k == "bool") { if (value_bool(v)) { return "true" } return "false" }
  if (k == "str") { return json_dumps(v) }
  if (k == "int") { return num_str(v).concat("L") }
  if (k == "float") { return num_str(v).concat("d") }
  return "<<UNSUPPORTED-LIT>>"
}

// `_is_float_expr`: node-local proof of a Float (drives the `${..}` Float path).
fn is_float_expr(node: Any) -> Bool {
  let k = node_kind(node)
  if (k == "lit") { return value_kind(value_field(node, "value")) == "float" }
  if (k == "bin") { return node_op(node) == "/" || node_operands(node) == "Float" }
  if (k == "un") {
    if (node_op(node) != "-") { return false }
    return is_float_expr(value_field(node, "operand"))
  }
  return false
}

fn is_builtin_ctor(name: Str) -> Bool {
  return name == "Some" || name == "None" || name == "Ok" || name == "Err"
}

// -------------------------------------------------------------- expressions
fn render_var(node: Any, ctx: Ctx) -> Str {
  let name = value_str(value_field(node, "name"))
  if (has_fn(ctx, name)) { return fn_name(name) }
  let m = mangle(name)
  if (name == "None") { return "java.util.Optional.empty()" }
  return m
}

fn render_bin(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let op = node_op(node)
  if (op == "??") {
    let ln = value_field(node, "left")
    let lr = render_expr(ln, ctx, counter)
    var left = lr.text
    if (!is_postfix_safe(node_kind(ln))) { left = `(${left})` }
    let rr = render_expr(value_field(node, "right"), ctx, lr.counter)
    return { text: `${left}.orElseGet(() -> ${rr.text})`, counter: rr.counter }
  }
  let lr = render_expr(value_field(node, "left"), ctx, counter)
  let rr = render_expr(value_field(node, "right"), ctx, lr.counter)
  let left = lr.text
  let right = rr.text
  let c = rr.counter
  if (op == "==" || op == "===") { return { text: `java.util.Objects.equals(${left}, ${right})`, counter: c } }
  if (op == "!=" || op == "!==") { return { text: `!java.util.Objects.equals(${left}, ${right})`, counter: c } }
  let opnd = node_operands(node)
  if (is_addsubmul(op) && is_int_operand(opnd)) {
    return { text: `Math.${exact_method(op)}(${left}, ${right})`, counter: c }
  }
  let opr = java_bin_ops(op)
  if (opr == "") { return { text: `<<UNSUPPORTED-BIN:${op}>>`, counter: c } }
  return { text: `(${left} ${opr} ${right})`, counter: c }
}

fn render_un(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let op = node_op(node)
  let r = render_expr(value_field(node, "operand"), ctx, counter)
  if (op == "!") { return { text: `(!${r.text})`, counter: r.counter } }
  if (op == "-") {
    if (is_int_operand(node_operands(node))) { return { text: `Math.negateExact(${r.text})`, counter: r.counter } }
    return { text: `(-${r.text})`, counter: r.counter }
  }
  return { text: `<<UNSUPPORTED-UN:${op}>>`, counter: r.counter }
}

fn render_field(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let tn = value_field(node, "target")
  let tr = render_expr(tn, ctx, counter)
  var target = tr.text
  if (!is_atomic(node_kind(tn))) { target = `(${target})` }
  return { text: `${target}.${mangle(value_str(value_field(node, "name")))}`, counter: tr.counter }
}

fn render_index(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let tn = value_field(node, "target")
  let tr = render_expr(tn, ctx, counter)
  var target = tr.text
  if (!is_atomic(node_kind(tn))) { target = `(${target})` }
  let ir = render_expr(value_field(node, "index"), ctx, tr.counter)
  return { text: `${target}.get((int)(${ir.text}))`, counter: ir.counter }
}

fn render_list(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  var parts = []
  var c = counter
  for (it of value_list(value_field(node, "items"))) {
    let r = render_expr(it, ctx, c)
    parts = parts.push(r.text)
    c = r.counter
  }
  return { text: "java.util.List.of(".concat(parts.join(", ")).concat(")"), counter: c }
}

// `adt`: a user variant construction (`new Owner.Case(args)`), used for both the
// `adt` node and a `call`/`var` callee naming a case. The case name is used RAW
// (only the owner interface is mangled), exactly as the reference does. Built-in
// Ok/Err (the sealed RevlResult) are DEFERRED.
fn render_adt(case: Str, args: List[Str], ctx: Ctx) -> Str {
  let owner = map_get(ctx.ca, case)
  if (resolved(owner)) { return `new ${mangle(owner)}.${case}(${args.join(", ")})` }
  if (case == "Ok" || case == "Err") { return `<<DEFER-result-ctor:${case}>>` }
  return `<<UNSUPPORTED-ADT:${case}>>`
}

// `_v3_call`: the 2.0 `callee`/`args` form. Arrow callees (beta-reduced by the
// reference) are DEFERRED; a method-call callee lowers as a real invocation.
fn render_call(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let callee = value_field(node, "callee")
  let arg_nodes = value_list(value_field(node, "args"))
  var args = []
  var c = counter
  for (a of arg_nodes) {
    let r = render_expr(a, ctx, c)
    args = args.push(r.text)
    c = r.counter
  }
  // The component dialect (item 225) keeps the v1 call shape `{target, method}`
  // (a required-service/host call) instead of a `callee` field access. The
  // reference emits `<recv>.<method>(<args>)` with NO parenthesisation of the
  // receiver (unlike the v3 field-callee branch below).
  if (value_is_null(callee)) {
    let tn = value_field(node, "target")
    let tr = render_expr(tn, ctx, c)
    return { text: `${tr.text}.${mangle(value_str(value_field(node, "method")))}(${args.join(", ")})`, counter: tr.counter }
  }
  let ck = node_kind(callee)
  if (ck == "var") {
    let name = value_str(value_field(callee, "name"))
    if (has_fn(ctx, name)) { return { text: `${fn_name(name)}(${args.join(", ")})`, counter: c } }
    if (resolved(map_get(ctx.ca, name))) { return { text: render_adt(name, args, ctx), counter: c } }
    if (name == "Some") { return { text: `java.util.Optional.of(${args[0]})`, counter: c } }
    if (name == "None") { return { text: "java.util.Optional.empty()", counter: c } }
    if (name == "Ok" || name == "Err") { return { text: `<<DEFER-result-ctor:${name}>>`, counter: c } }
    return { text: `${name}(${args.join(", ")})`, counter: c }
  }
  if (ck == "field") {
    let tn = value_field(callee, "target")
    let tr = render_expr(tn, ctx, c)
    var target = tr.text
    if (!is_atomic(node_kind(tn))) { target = `(${target})` }
    return { text: `${target}.${mangle(value_str(value_field(callee, "name")))}(${args.join(", ")})`, counter: tr.counter }
  }
  let cr = render_expr(callee, ctx, c)
  return { text: `${cr.text}.apply(${args.join(", ")})`, counter: cr.counter }
}

// `record`: a nominal `new Type(args)` literal. The struct name is inferred from
// the (field-SET) `record_by_fields`; the ctor arguments are ordered by the
// type's DECLARED field order (`rfields`), while the VALUES are rendered in
// literal order (so the match counter advances in literal order).
fn render_record(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let fields = value_list(value_field(node, "fields"))
  var names = []
  for (f of fields) { names = names.push(value_str(value_at(f, 0))) }
  let tn = record_type_for_fields(ctx, names)
  var by: Map[Str, Str] = Map.empty()
  var c = counter
  for (f of fields) {
    let k = value_str(value_at(f, 0))
    let r = render_expr(value_at(f, 1), ctx, c)
    by = by.set(k, r.text)
    c = r.counter
  }
  var out_args = []
  for (fname of split_top(map_get(ctx.rfields, tn), ",")) {
    out_args = out_args.push(map_get(by, fname))
  }
  return { text: `new ${mangle(tn)}(${out_args.join(", ")})`, counter: c }
}

// `interp`: a `${..}` template as Java string `+` concatenation. A Float part
// routes through the canonical `revlFtoa` (DEFERRED — such a part is excluded
// from the corpus, since it also pulls in the `_emit_ftoa_helper` block).
fn render_interp(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  var segs = []
  var c = counter
  for (part of value_list(value_field(node, "parts"))) {
    let k = value_str(value_at(part, 0))
    let v = value_at(part, 1)
    if (k == "text") {
      segs = segs.push(json_dumps(v))
    } else {
      let r = render_expr(v, ctx, c)
      c = r.counter
      if (is_float_expr(v)) {
        segs = segs.push(`revlFtoa(${r.text})`)
      } else {
        segs = segs.push(`String.valueOf(${r.text})`)
      }
    }
  }
  if (segs.length() == 0) { return { text: json_dumps(""), counter: c } }
  return { text: segs.join(" + "), counter: c }
}

// `_v3_match_expr`: a `match`. The built-in Opt (`Some`/`None`, when NOT shadowed
// by a user variant) discriminates via `.map(..).orElseGet(..)`; a user variant
// lowers to a pattern `switch` carrying the document-wide `__revl_case_N` /
// `__revl_ignored_N` temp numbering. The arm lines carry a fixed indent (the
// enclosing statement only pads the first line). Built-in Result (`Ok`/`Err`) is
// DEFERRED.
fn opt_arm_body(arms: List[Any], want: Str, ctx: Ctx, counter: Int) -> Rendered {
  for (arm of arms) {
    if (value_str(value_field(arm, "pattern")) == want) {
      return render_expr(value_field(arm, "body"), ctx, counter)
    }
  }
  for (arm of arms) {
    if (value_str(value_field(arm, "pattern")) == "_") {
      return render_expr(value_field(arm, "body"), ctx, counter)
    }
  }
  return { text: "", counter: counter }
}
fn has_optional_arms(arms: List[Any], ctx: Ctx) -> Bool {
  for (arm of arms) {
    let p = value_str(value_field(arm, "pattern"))
    if ((p == "Some" || p == "None") && !resolved(map_get(ctx.ca, p))) { return true }
  }
  return false
}
fn opt_bind(arms: List[Any]) -> Str {
  for (arm of arms) {
    if (value_str(value_field(arm, "pattern")) == "Some") {
      let b = value_str(value_field(arm, "bind"))
      if (b != "") { return mangle(b) }
    }
  }
  return "__revl_v"
}
fn match_expr(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let sr = render_expr(value_field(node, "scrutinee"), ctx, counter)
  let arms = value_list(value_field(node, "arms"))
  var c = sr.counter
  if (has_optional_arms(arms, ctx)) {
    let some_bind = opt_bind(arms)
    let some_body = opt_arm_body(arms, "Some", ctx, c)
    let none_body = opt_arm_body(arms, "None", ctx, some_body.counter)
    return {
      text: `(${sr.text}).map(${some_bind} -> (${some_body.text})).orElseGet(() -> (${none_body.text}))`,
      counter: none_body.counter
    }
  }
  var lines = [`switch (${sr.text}) {`]
  var wildcard = ""
  var has_wild = false
  var patterns = []
  for (arm of arms) {
    let pattern = value_str(value_field(arm, "pattern"))
    let br = render_expr(value_field(arm, "body"), ctx, c)
    c = br.counter
    if (pattern == "_") {
      wildcard = `            default -> { yield (${br.text}); }`
      has_wild = true
    } else {
      patterns = patterns.push(pattern)
      let case_m = mangle(pattern)
      let owner = map_get(ctx.ca, pattern)
      var qualified = case_m
      if (resolved(owner)) { qualified = `${mangle(owner)}.${case_m}` }
      let bind = value_str(value_field(arm, "bind"))
      if (bind != "") {
        c = c + 1
        let case_var = `__revl_case_${c}`
        lines = lines.push(`            case ${qualified} ${case_var} -> {`)
        lines = lines.push(`                final var ${mangle(bind)} = ${case_var}.value;`)
        lines = lines.push(`                yield (${br.text});`)
        lines = lines.push(`            }`)
      } else {
        c = c + 1
        let ignored = `__revl_ignored_${c}`
        lines = lines.push(`            case ${qualified} ${ignored} -> {`)
        lines = lines.push(`                yield (${br.text});`)
        lines = lines.push(`            }`)
      }
    }
  }
  if (has_wild) {
    lines = lines.push(wildcard)
  } else {
    if (!covers_variant(ctx, patterns)) {
      lines = lines.push(`            default -> { throw new IllegalArgumentException("non-exhaustive match"); }`)
    }
  }
  lines = lines.push(`        }`)
  return { text: lines.join(newline()), counter: c }
}

// The kind dispatch, mirroring `_expr`'s branch order (post-widen).
fn render_inner(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let kind = node_kind(node)
  if (kind == "lit") { return { text: java_lit(node), counter: counter } }
  if (kind == "var") { return { text: render_var(node, ctx), counter: counter } }
  if (kind == "name") {
    // A modern component capture (`this.sink`) arrives via the rename map;
    // otherwise a bare `name` is a plain identifier (`_ident` = `mangle`).
    let idv = value_str(value_field(node, "id"))
    if (ctx.rn.has(idv)) { return { text: map_get(ctx.rn, idv), counter: counter } }
    return { text: mangle(idv), counter: counter }
  }
  // component dialect (item 225): a required-service reference — `this.sink` inside
  // a provide-method body (via the rename map), else the bare requirement local.
  if (kind == "req") {
    let orig = value_str(value_field(node, "name"))
    if (ctx.rn.has(orig)) { return { text: map_get(ctx.rn, orig), counter: counter } }
    return { text: mangle(orig), counter: counter }
  }
  // component dialect (item 225): a `config` field read is a bare identifier
  // (`_ident(field)`), matching the reference's `_expr` config branch.
  if (kind == "config") {
    return { text: mangle(value_str(value_field(node, "field"))), counter: counter }
  }
  if (kind == "adt") {
    var args = []
    var c = counter
    for (a of value_list(value_field(node, "args"))) {
      let r = render_expr(a, ctx, c)
      args = args.push(r.text)
      c = r.counter
    }
    return { text: render_adt(value_str(value_field(node, "case")), args, ctx), counter: c }
  }
  if (kind == "call") { return render_call(node, ctx, counter) }
  if (kind == "fn") {
    var args = []
    var c = counter
    for (a of value_list(value_field(node, "args"))) {
      let r = render_expr(a, ctx, c)
      args = args.push(r.text)
      c = r.counter
    }
    return { text: `${fn_name(value_str(value_field(node, "name")))}(${args.join(", ")})`, counter: c }
  }
  if (kind == "bin") { return render_bin(node, ctx, counter) }
  if (kind == "un") { return render_un(node, ctx, counter) }
  if (kind == "field") { return render_field(node, ctx, counter) }
  if (kind == "index") { return render_index(node, ctx, counter) }
  if (kind == "record") { return render_record(node, ctx, counter) }
  if (kind == "match") { return match_expr(node, ctx, counter) }
  if (kind == "if") {
    let cr = render_expr(value_field(node, "cond"), ctx, counter)
    let tr = render_expr(value_field(node, "then"), ctx, cr.counter)
    let er = render_expr(value_field(node, "else"), ctx, tr.counter)
    return { text: `(${cr.text} ? ${tr.text} : ${er.text})`, counter: er.counter }
  }
  if (kind == "list") { return render_list(node, ctx, counter) }
  if (kind == "maplit") { return { text: "new java.util.HashMap<>()", counter: counter } }
  if (kind == "interp") { return render_interp(node, ctx, counter) }
  return { text: `<<UNSUPPORTED-EXPR:${kind}>>`, counter: counter }
}

// The `widen` coercion markers (docs/arithmetic.md): render the conversion the
// reference makes explicit, then dispatch the un-widened node.
fn render_expr(node: Any, ctx: Ctx, counter: Int) -> Rendered {
  let w = value_str(value_field(node, "widen"))
  if (w == "Float") {
    let r = render_inner(node, ctx, counter)
    return { text: `((double) (${r.text}))`, counter: r.counter }
  }
  if (w == "Int") {
    let r = render_inner(node, ctx, counter)
    return { text: `((long) (${r.text}))`, counter: r.counter }
  }
  return render_inner(node, ctx, counter)
}

// -------------------------------------------------------------- statements
// `_let_keyword`: an empty list literal declares as raw `java.util.List` (keeps
// erasure in play); an ADT-construction binding declares as its sealed interface
// (`final Owner o`, restoring the type the frontend gave the expression); else
// the `var` / `final var` inference.
fn let_keyword(node: Any, ctx: Ctx) -> Str {
  let value = value_field(node, "value")
  if (node_kind(value) == "list" && value_list(value_field(value, "items")).length() == 0) {
    return "java.util.List"
  }
  if (node_kind(value) == "adt") {
    let owner = map_get(ctx.ca, value_str(value_field(value, "case")))
    if (resolved(owner)) {
      if (value_bool(value_field(node, "mutable"))) { return mangle(owner) }
      return `final ${mangle(owner)}`
    }
  }
  if (value_bool(value_field(node, "mutable"))) { return "var" }
  return "final var"
}

fn emit_stmts(nodes: List[Any], ctx: Ctx, indent: Int, counter: Int) -> Sout {
  var lines = []
  var c = counter
  for (n of nodes) {
    let r = v3_stmt(n, ctx, indent, c)
    lines = lines.concat(r.lines)
    c = r.counter
  }
  return { lines: lines, counter: c }
}

// `_v3_stmt`: one fn-body step -> its emitted (indented) lines.
fn v3_stmt(node: Any, ctx: Ctx, indent: Int, counter: Int) -> Sout {
  let pad = ind(indent)
  let step = value_str(value_field(node, "step"))
  if (step == "let" || step == "assign") {
    let nm = mangle(value_str(value_field(node, "name")))
    let r = render_expr(value_field(node, "value"), ctx, counter)
    if (step == "let") {
      return { lines: [pad.concat(`${let_keyword(node, ctx)} ${nm} = ${r.text};`)], counter: r.counter }
    }
    return { lines: [pad.concat(`${nm} = ${r.text};`)], counter: r.counter }
  }
  if (step == "return") {
    let e = value_field(node, "expr")
    if (value_is_null(e)) { return { lines: [pad.concat("return;")], counter: counter } }
    let r = render_expr(e, ctx, counter)
    return { lines: [pad.concat(`return ${r.text};`)], counter: r.counter }
  }
  if (step == "if") {
    let cr = render_expr(value_field(node, "cond"), ctx, counter)
    var out = [pad.concat(`if (${cr.text}) {`)]
    let tr = emit_stmts(value_list(value_field(node, "then")), ctx, indent + 1, cr.counter)
    out = out.concat(tr.lines)
    var c = tr.counter
    let els = value_list(value_field(node, "else"))
    if (els.length() > 0) {
      out = out.push(pad.concat("} else {"))
      let er = emit_stmts(els, ctx, indent + 1, c)
      out = out.concat(er.lines)
      c = er.counter
    }
    out = out.push(pad.concat("}"))
    return { lines: out, counter: c }
  }
  if (step == "while") {
    let cr = render_expr(value_field(node, "cond"), ctx, counter)
    var out = [pad.concat(`while (${cr.text}) {`)]
    let br = emit_stmts(value_list(value_field(node, "body")), ctx, indent + 1, cr.counter)
    out = out.concat(br.lines)
    out = out.push(pad.concat("}"))
    return { lines: out, counter: br.counter }
  }
  if (step == "for") {
    let ir = render_expr(value_field(node, "iterable"), ctx, counter)
    let bind = mangle(value_str(value_field(node, "bind")))
    var out = [pad.concat(`for (var ${bind} : ${ir.text}) {`)]
    let br = emit_stmts(value_list(value_field(node, "body")), ctx, indent + 1, ir.counter)
    out = out.concat(br.lines)
    out = out.push(pad.concat("}"))
    return { lines: out, counter: br.counter }
  }
  if (step == "expr") {
    let r = render_expr(value_field(node, "expr"), ctx, counter)
    return { lines: [pad.concat(`${r.text};`)], counter: r.counter }
  }
  if (step == "assert") {
    let r = render_expr(value_field(node, "expr"), ctx, counter)
    return { lines: [pad.concat(`if (!(${r.text})) throw new AssertionError("assertion failed");`)], counter: r.counter }
  }
  return { lines: [pad.concat(`<<UNSUPPORTED-STEP:${step}>>`)], counter: counter }
}

// -------------------------------------------------------------- type decls
// `_emit_v3_types`: a user `record` type as a `public static final class` (public
// final fields + a canonical ctor), a `variant` type as a `public sealed
// interface … permits …` with one `final class … implements` per case.
fn emit_v3_types(types: Any) -> List[Str] {
  var out = []
  for (name of value_keys(types)) {
    let mn = mangle(name)
    let spec = value_field(types, name)
    let kind = value_str(value_field(spec, "kind"))
    if (kind == "record") {
      out = out.push(`public static final class ${mn} {`)
      let fields = value_field(spec, "fields")
      let fnames = value_keys(fields)
      for (f of fnames) {
        out = out.push(`    public final ${java_v3_type(value_field(fields, f), false)} ${mangle(f)};`)
      }
      var params = []
      for (f of fnames) {
        params = params.push(`${java_v3_type(value_field(fields, f), false)} ${mangle(f)}`)
      }
      out = out.push(`    public ${mn}(${params.join(", ")}) {`)
      for (f of fnames) {
        out = out.push(`        this.${mangle(f)} = ${mangle(f)};`)
      }
      out = out.push("    }")
      out = out.push("}")
    } else {
      let cases = value_list(value_field(spec, "cases"))
      var permits = []
      for (case of cases) {
        permits = permits.push(`${mn}.${mangle(value_str(value_field(case, "name")))}`)
      }
      out = out.push(`public sealed interface ${mn} permits ${permits.join(", ")} {`)
      for (case of cases) {
        let cname = mangle(value_str(value_field(case, "name")))
        let payload = value_field(case, "payload")
        if (value_is_null(payload)) {
          out = out.push(`    final class ${cname} implements ${mn} {`)
          out = out.push(`        public ${cname}() {}`)
          out = out.push("    }")
        } else {
          let ptype = java_v3_type(payload, false)
          out = out.push(`    final class ${cname} implements ${mn} {`)
          out = out.push(`        public final ${ptype} value;`)
          out = out.push(`        public ${cname}(${ptype} value) { this.value = value; }`)
          out = out.push("    }")
        }
      }
      out = out.push("}")
    }
    out = out.push("")
  }
  return out
}

// `_emit_v3_functions`: each module fn as a `public static` method. The match
// counter threads across the whole document (one `_V3Ctx` counter in the
// reference, NOT reset per function).
fn emit_v3_functions(functions: List[Any], ctx: Ctx) -> List[Str] {
  var lines = []
  var c = 0
  for (fnode of functions) {
    let name = fn_name(value_str(value_field(fnode, "name")))
    var ps = []
    for (p of value_list(value_field(fnode, "params"))) {
      ps = ps.push(`${java_v3_type(value_field(p, "type"), false)} ${mangle(value_str(value_field(p, "name")))}`)
    }
    let ret = java_v3_type(value_field(fnode, "returns"), false)
    lines = lines.push(`public static ${ret} ${name}(${ps.join(", ")}) {`)
    let body = value_list(value_field(fnode, "body"))
    if (body.length() == 0) {
      lines = lines.push("    // (empty body)")
    } else {
      let r = emit_stmts(body, ctx, 1, c)
      lines = lines.concat(r.lines)
      c = r.counter
    }
    lines = lines.push("}")
    lines = lines.push("")
  }
  return lines
}

// `_core_imports` for a function/typed-core doc (no component await/fail step):
// the five unconditional names, sorted.
fn core_imports() -> List[Str] {
  return ["import io.cordis4j.core.Context;",
          "import io.cordis4j.core.Disposable;",
          "import io.cordis4j.core.Disposables;",
          "import io.cordis4j.core.Plugin;",
          "import io.cordis4j.core.ServiceKey;"]
}

// `_V3Ctx`'s type-table construction: fold the document `types` into the case /
// record lookups. Ambiguity (a case name / field set shared by two decls) is
// marked `<<AMBIG>>`, exactly where the reference stores `None`.
fn build_ctx(ir: Any) -> Ctx {
  var fns: Map[Str, Bool] = Map.empty()
  for (fnode of value_list(value_field(ir, "functions"))) {
    fns = fns.set(value_str(value_field(fnode, "name")), true)
  }
  var ca: Map[Str, Str] = Map.empty()
  var cp: Map[Str, Str] = Map.empty()
  var rbf: Map[Str, Str] = Map.empty()
  var vcases: Map[Str, Str] = Map.empty()
  var rfields: Map[Str, Str] = Map.empty()
  let types = value_field(ir, "types")
  for (name of value_keys(types)) {
    let spec = value_field(types, name)
    let kind = value_str(value_field(spec, "kind"))
    if (kind == "record") {
      let fnames = value_keys(value_field(spec, "fields"))
      let key = sorted_key(fnames)
      if (resolved(map_get(rbf, key)) || map_get(rbf, key) == "<<AMBIG>>") {
        rbf = rbf.set(key, "<<AMBIG>>")
      } else {
        rbf = rbf.set(key, name)
      }
      rfields = rfields.set(name, fnames.join(","))
    }
    if (kind == "variant") {
      var cnames = []
      for (case of value_list(value_field(spec, "cases"))) {
        let cn = value_str(value_field(case, "name"))
        cnames = cnames.push(cn)
        var pres = "n"
        if (!value_is_null(value_field(case, "payload"))) { pres = "y" }
        cp = cp.set(cn, pres)
        if (resolved(map_get(ca, cn)) || map_get(ca, cn) == "<<AMBIG>>") {
          ca = ca.set(cn, "<<AMBIG>>")
        } else {
          ca = ca.set(cn, name)
        }
      }
      vcases = vcases.set(name, sorted_key(cnames))
    }
  }
  return { fns: fns, ca: ca, cp: cp, rbf: rbf, vcases: vcases, rfields: rfields, rn: Map.empty() }
}

// Swap in a fresh rename map (the component-capture scope for one render); the
// modern provide-method path threads `{req -> this.req, bind -> this.bind}`.
fn set_rn(ctx: Ctx, rn: Map[Str, Str]) -> Ctx {
  return { fns: ctx.fns, ca: ctx.ca, cp: ctx.cp, rbf: ctx.rbf, vcases: ctx.vcases, rfields: ctx.rfields, rn: rn }
}

// ============================================================ components/services
// SLICE 3 (item 216 — THIS slice) the SIMPLE component/service unit. The java
// reference emits components as ONE entangled block; item 210 deferred it whole.
// This slice ports the smallest byte-exact corner of it — a `service` interface
// plus the LEGACY simple-provider path of `_emit_component` (the branch taken when
// `_component_needs_modern` is False): a pure provider whose methods are a lone
// `return <lit|name>` (or an empty void body), NO requires, NO config, NO
// isolate/intercept, and body steps that are all `provide`.
//
// Everything richer is DEFERRED, each behind a loud `<<DEFER-*>>` marker so a byte
// diff can never silently pass on an unported form (item 207's discipline):
//   * the MODERN `_emit_component_modern` path — isolate/intercept, effectful
//     method bodies, and any `if`/`fail`/`await`/`return` or `setup` body step
//     (the `Context.EffectScope fx` provider shape). Detected conservatively:
//     anything outside the simple predicate below routes to a
//     `<<DEFER-component-nonsimple:NAME>>` marker;
//   * component `config` (the `<Comp>Plugin(params)` ctor + `_config_default_lit`
//     application) — a config-carrying component stays LEGACY but is deferred here;
//   * required-service routing (`req`/the `ctx.get(..)` locals + provider fields),
//     host-object binds and their `_emit_host_stubs` `HashMap<String,V>` per-site
//     `_map_value_expr_type` inference, `let-effect`/`effect`/`emit` teardown
//     steps, async/spawn/realms, and the `<Comp>` await->AsyncPlugin / fail->
//     CordisException import widening.
// The provider METHOD body reuses the v1 `_expr` surface for the two kinds the
// simple unit forces — `lit` (`_lit`) and `name` (a bound param, `_ident`) — and
// marks any other kind `<<DEFER-method-expr:KIND>>`.

// `_emit_service_interfaces_v3`: each `service` -> a `public interface S` with one
// method per op (param names `_ident`ed/mangled, a `void` return when the op
// declares none). The v3 variant carries NO idempotent/emission doc comments (that
// is the v1 `_emit_service_interfaces`).
fn emit_service_interfaces_v3(services: Any) -> List[Str] {
  var out = []
  for (sname of value_keys(services)) {
    let srv = value_field(services, sname)
    out = out.push(`public interface ${sname} {`)
    let methods = value_field(srv, "methods")
    for (mname of value_keys(methods)) {
      let method = value_field(methods, mname)
      var params = []
      for (p of value_list(value_field(method, "params"))) {
        params = params.push(`${java_v3_type(value_field(p, "type"), false)} ${mangle(value_str(value_field(p, "name")))}`)
      }
      var ret = "void"
      let r = value_field(method, "returns")
      if (!value_is_null(r)) { ret = java_v3_type(r, false) }
      out = out.push(`    ${ret} ${mname}(${params.join(", ")});`)
    }
    out = out.push("}")
    out = out.push("")
  }
  return out
}

// The v1 method-body expression surface for the simple provider path: only the
// two kinds a pure `return` forces (`lit`/`name`), every other kind DEFERRED. The
// simple unit carries no binds/reqs, so the reference's `rename` map is empty and
// a `name` is just `_ident` (mangle). A user-case `name` cannot occur here (the
// method returns a scalar), so no ADT/ctx lookup is needed.
fn v1_method_expr(node: Any) -> Str {
  let k = node_kind(node)
  if (k == "lit") { return java_lit(node) }
  if (k == "name") { return mangle(value_str(value_field(node, "id"))) }
  return `<<DEFER-method-expr:${k}>>`
}

// `_method_body` (SUBSET): a single `return <expr>` inlines to `return <expr>;`
// (or `<expr>;` for a void op run for effect); a void op with a bare `return`
// gives `return;`; ANY other shape (empty body, multi-step, effectful) gives the
// reference's `throw new UnsupportedOperationException("effectful method body");`.
// A bare `return` in a value-returning op is a reference ERROR (deferred marker).
fn method_body(method: Any, ret_is_void: Bool) -> Str {
  let steps = value_list(value_field(method, "body"))
  if (steps.length() == 1) {
    let s0 = steps[0]
    if (value_str(value_field(s0, "step")) == "return") {
      let e = value_field(s0, "expr")
      if (value_is_null(e)) {
        if (!ret_is_void) { return "<<DEFER-bare-return-nonvoid>>" }
        return "return;"
      }
      let value = v1_method_expr(e)
      if (ret_is_void) { return value.concat(";") }
      return `return ${value};`
    }
  }
  return `throw new UnsupportedOperationException("effectful method body");`
}

// The provide-step methods for a provision `key` (`_provision_methods`): the
// `provide` body step whose `name` matches, else `[]`.
fn provide_methods(body: List[Any], key: Str) -> List[Any] {
  for (s of body) {
    if (value_str(value_field(s, "step")) == "provide" && value_str(value_field(s, "name")) == key) {
      return value_list(value_field(s, "methods"))
    }
  }
  return []
}

// A provision method's declared param type, looked up in the SERVICE signature
// (the provide body carries only names): `_param_type`. Missing -> "Object".
fn service_param_type(svc_method: Any, pname: Str) -> Any {
  for (mp of value_list(value_field(svc_method, "params"))) {
    if (value_str(value_field(mp, "name")) == pname) { return value_field(mp, "type") }
  }
  return "Object"
}

// A nullable map/list is "empty" when absent (a component with no requires/isolate
// simply omits the key) OR present-but-empty.
fn map_nonempty(v: Any) -> Bool {
  if (value_is_null(v)) { return false }
  return value_keys(v).length() > 0
}
fn list_nonempty(v: Any) -> Bool {
  if (value_is_null(v)) { return false }
  return value_list(v).length() > 0
}

// The SIMPLE-path predicate: a component this slice emits byte-exactly via the
// legacy `_emit_component`. STRICTLY a subset of `not _component_needs_modern`
// (config/requires/isolate/intercept absent, every step a `provide`, every method
// empty or a lone `return <lit|name>`), so anything it admits the reference emits
// via the legacy path with a lit/name body — and anything it rejects gets a loud
// `<<DEFER-component-nonsimple:NAME>>` rather than a wrong-shaped emission.
fn method_simple_ok(method: Any) -> Bool {
  let steps = value_list(value_field(method, "body"))
  if (steps.length() == 0) { return true }
  if (steps.length() != 1) { return false }
  let s0 = steps[0]
  if (value_str(value_field(s0, "step")) != "return") { return false }
  let e = value_field(s0, "expr")
  if (value_is_null(e)) { return false }
  let k = node_kind(e)
  return k == "lit" || k == "name"
}
fn component_simple_ok(comp: Any) -> Bool {
  if (list_nonempty(value_field(comp, "config"))) { return false }
  if (map_nonempty(value_field(comp, "requires"))) { return false }
  if (map_nonempty(value_field(comp, "isolate"))) { return false }
  if (map_nonempty(value_field(comp, "intercept"))) { return false }
  for (step of value_list(value_field(comp, "body"))) {
    if (value_str(value_field(step, "step")) != "provide") { return false }
    for (method of value_list(value_field(step, "methods"))) {
      if (!method_simple_ok(method)) { return false }
    }
  }
  return true
}

// ==================================================== MODERN component (item 225)
// The modern component path (`_emit_component_modern`) — SLICE 3 subset: the
// config / required-service-routing / effectful-method-body corner, byte-exact.
// A component is emitted here when it needs the modern path AND falls inside the
// supported subset (`modern_supported` && `needs_modern_subset`); anything else
// routes to `<<DEFER-component-nonsimple>>`. DEFERRED (slice 4+, each a loud
// marker or a structural DEFER): isolate/intercept realms, async/await/spawn
// (AsyncPlugin / CordisException import widening), timers, routers, `let-effect`
// host binds and their `_emit_host_stubs` `HashMap<String,V>` per-site inference,
// body-level `effect`/`emit`/`if`/`fail`/`setup` activation steps, and method-body
// `let`/`assign`/arrow bindings.

// `_zero_java_value`: the default field value for a config field with no explicit
// default (mirrors the reference's zero-value table).
fn zero_java_value(t: Str) -> Str {
  if (t == "long") { return "0L" }
  if (t == "int") { return "0" }
  if (t == "double") { return "0.0d" }
  if (t == "boolean") { return "false" }
  return "null"
}

// `_lit`: a RAW config-default value (not a node) -> its Java literal. The
// reference `_lit` renders through `json.dumps` (str) / `f"{v}L"` (int) /
// `f"{v}d"` (float); bool/null are keyword literals.
fn lit_value(v: Any) -> Str {
  let k = value_kind(v)
  if (k == "null") { return "null" }
  if (k == "bool") { if (value_bool(v)) { return "true" } return "false" }
  if (k == "str") { return json_dumps(v) }
  if (k == "int") { return num_str(v).concat("L") }
  if (k == "float") { return num_str(v).concat("d") }
  return "<<UNSUPPORTED-LIT>>"
}

// `_config_default_lit`: an explicit IR default (`_lit`), else the type's zero.
fn config_default_lit(field: Any) -> Str {
  let d = value_field(field, "default")
  if (!value_is_null(d)) { return lit_value(d) }
  return zero_java_value(java_v3_type(value_field(field, "type"), false))
}

// `_emit_plugin_ctors`: a parameterised ctor (only when there are config fields,
// each assigned `this.f = f`) followed by the no-arg ctor (each field defaulted).
fn emit_plugin_ctors(cname: Str, fields: List[Any]) -> List[Str] {
  var lines = []
  if (fields.length() > 0) {
    var params = []
    for (f of fields) {
      params = params.push(`${java_v3_type(value_field(f, "type"), false)} ${mangle(value_str(value_field(f, "name")))}`)
    }
    lines = lines.push(`    public ${cname}Plugin(${params.join(", ")}) {`)
    for (f of fields) {
      let fname = mangle(value_str(value_field(f, "name")))
      lines = lines.push(`        this.${fname} = ${fname};`)
    }
    lines = lines.push("    }")
  }
  lines = lines.push(`    public ${cname}Plugin() {`)
  for (f of fields) {
    let fname = mangle(value_str(value_field(f, "name")))
    lines = lines.push(`        this.${fname} = ${config_default_lit(f)};`)
  }
  lines = lines.push("    }")
  return lines
}

// The v1 expression kinds (`_V1_EXPR_KINDS`): a return expr built only from these
// (and no v3 `callee` call) needs no modern lowering.
fn is_v1_expr_kind(k: Str) -> Bool {
  return k == "name" || k == "lit" || k == "config" || k == "host" || k == "req" || k == "call" || k == "format"
}
// `_contains_expr`: does a node use any non-v1 expression kind (or a v3
// `callee`-form call)? Drives `_component_needs_modern`'s method-return test.
fn contains_expr(node: Any) -> Bool {
  let vk = value_kind(node)
  if (vk == "record") {
    let kind = value_str(value_field(node, "kind"))
    if (kind == "call" && !value_is_null(value_field(node, "callee"))) { return true }
    if (!is_v1_expr_kind(kind)) { return true }
    for (k of value_keys(node)) {
      if (contains_expr(value_field(node, k))) { return true }
    }
    return false
  }
  if (vk == "list") {
    for (item of value_list(node)) {
      if (contains_expr(item)) { return true }
    }
    return false
  }
  return false
}

// `modern_supported`: the SLICE-3 subset gate. A component is emitted modern only
// when it has NO isolate/intercept, EVERY body step is a `provide` (no let-effect
// host binds, no body-level effect/emit/if/fail/setup), and every provide-method
// step is a `return`/`effect`/`emit` (no let/assign/provide/await). Everything
// else routes to a loud DEFER rather than a wrong-shaped emission.
fn modern_supported(comp: Any) -> Bool {
  if (map_nonempty(value_field(comp, "isolate"))) { return false }
  if (map_nonempty(value_field(comp, "intercept"))) { return false }
  for (step of value_list(value_field(comp, "body"))) {
    if (value_str(value_field(step, "step")) != "provide") { return false }
    for (method of value_list(value_field(step, "methods"))) {
      for (mstmt of value_list(value_field(method, "body"))) {
        let ms = value_str(value_field(mstmt, "step"))
        if (ms != "return" && ms != "effect" && ms != "emit") { return false }
      }
    }
  }
  return true
}
// `_component_needs_modern` (reduced to the all-`provide` subset `modern_supported`
// admits): a provide-method with any non-`return` step, or a `return` whose expr
// escapes the v1 surface, forces the modern path. (A config-only / req-only
// component whose methods are all pure `return <lit|name>` stays LEGACY — the
// reference emits it non-modern — so it is NOT admitted here.)
fn needs_modern_subset(comp: Any) -> Bool {
  for (step of value_list(value_field(comp, "body"))) {
    for (method of value_list(value_field(step, "methods"))) {
      for (mstmt of value_list(value_field(method, "body"))) {
        if (value_str(value_field(mstmt, "step")) != "return") { return true }
        if (contains_expr(value_field(mstmt, "expr"))) { return true }
      }
    }
  }
  return false
}

// `_method_body_lines` (SUBSET): the effectful provide-method body. `return`
// (`return <e>;`, or `<e>; return;` in a void op, or a bare `return;`), `effect`
// (`<acquire>;` then `fx.track(Disposables.of(() -> <undo>))`) and `emit`
// (`<expr>;` plus an optional `compensate` track). `ctx` carries the
// this.<req>/this.<bind> rename map (`set_rn`). The match counter threads through.
fn method_body_lines(method: Any, ret_is_void: Bool, ctx: Ctx, counter: Int) -> Sout {
  var lines = []
  var c = counter
  for (mstmt of value_list(value_field(method, "body"))) {
    let step = value_str(value_field(mstmt, "step"))
    if (step == "return") {
      let e = value_field(mstmt, "expr")
      if (value_is_null(e)) {
        lines = lines.push("return;")
      } else {
        if (ret_is_void) {
          let r = render_expr(e, ctx, c)
          lines = lines.push(r.text.concat(";"))
          lines = lines.push("return;")
          c = r.counter
        } else {
          let r = render_expr(e, ctx, c)
          lines = lines.push(`return ${r.text};`)
          c = r.counter
        }
      }
    } else {
      if (step == "effect") {
        let ra = render_expr(value_field(mstmt, "acquire"), ctx, c)
        lines = lines.push(ra.text.concat(";"))
        let ru = render_expr(value_field(mstmt, "undo"), ctx, ra.counter)
        lines = lines.push(`fx.track(Disposables.of(() -> ${ru.text}));`)
        c = ru.counter
      } else {
        if (step == "emit") {
          let re = render_expr(value_field(mstmt, "expr"), ctx, c)
          lines = lines.push(re.text.concat(";"))
          c = re.counter
          let comp = value_field(mstmt, "compensate")
          if (!value_is_null(comp)) {
            let rc = render_expr(comp, ctx, c)
            lines = lines.push(`fx.track(Disposables.of(() -> ${rc.text}));`)
            c = rc.counter
          }
        }
      }
    }
  }
  return { lines: lines, counter: c }
}

// `_emit_component_modern` (SLICE-3 subset): per provision a provider `public
// static final class <Comp><Camel(key)> implements <Svc>` carrying `ctx`/`fx` and
// one field per requirement (ctor + effectful method bodies), then the
// `<Comp>Plugin` (config fields + `_emit_plugin_ctors`, and the `apply` that opens
// the `Context.EffectScope`, resolves each requirement via `ctx.get(..)`, and
// registers every provision under the A8 self-revert try/catch, returning `fx`).
fn emit_component_modern(comp: Any, services: Any, base_ctx: Ctx) -> List[Str] {
  let name = value_str(value_field(comp, "name"))
  let cname = mangle(name)
  let reqs_m = value_field(comp, "requires")
  let provs_m = value_field(comp, "provides")
  let config_fields = value_list(value_field(comp, "config"))
  let body = value_list(value_field(comp, "body"))
  var req_locals = []
  if (!value_is_null(reqs_m)) { req_locals = value_keys(reqs_m) }
  // The provide-method capture rename: each requirement is a `this.<local>` field.
  var rn: Map[Str, Str] = Map.empty()
  for (local of req_locals) { rn = rn.set(local, `this.${local}`) }
  let mctx = set_rn(base_ctx, rn)
  var out = []
  var counter = 0
  for (key of value_keys(provs_m)) {
    let srv = value_str(value_field(provs_m, key))
    let struct = `${cname}${camel(key)}`
    out = out.push(`public static final class ${struct} implements ${srv} {`)
    out = out.push("    private final Context ctx;")
    out = out.push("    private final Context.EffectScope fx;")
    for (local of req_locals) {
      out = out.push(`    private final ${value_str(value_field(reqs_m, local))} ${local};`)
    }
    var cparams = ["Context ctx", "Context.EffectScope fx"]
    for (local of req_locals) {
      cparams = cparams.push(`${value_str(value_field(reqs_m, local))} ${local}`)
    }
    out = out.push(`    ${struct}(${cparams.join(", ")}) {`)
    out = out.push("        this.ctx = ctx;")
    out = out.push("        this.fx = fx;")
    for (local of req_locals) {
      out = out.push(`        this.${local} = ${local};`)
    }
    out = out.push("    }")
    let svc_methods = value_field(value_field(services, srv), "methods")
    for (method of provide_methods(body, key)) {
      let mn = value_str(value_field(method, "name"))
      let mnm = mangle(mn)
      let svc_method = value_field(svc_methods, mnm)
      var params = []
      for (pn of value_list(value_field(method, "params"))) {
        let pname = value_str(pn)
        params = params.push(`${java_v3_type(service_param_type(svc_method, pname), false)} ${pname}`)
      }
      var ret_is_void = true
      var ret = "void"
      let r = value_field(svc_method, "returns")
      if (!value_is_null(r)) { ret = java_v3_type(r, false) ret_is_void = false }
      out = out.push(`    public ${ret} ${mnm}(${params.join(", ")}) {`)
      let sb = method_body_lines(method, ret_is_void, mctx, counter)
      counter = sb.counter
      for (l of sb.lines) { out = out.push(`        ${l}`) }
      out = out.push("    }")
    }
    out = out.push("}")
    out = out.push("")
  }
  out = out.push(`public static final class ${cname}Plugin implements Plugin {`)
  for (f of config_fields) {
    out = out.push(`    private final ${java_v3_type(value_field(f, "type"), false)} ${mangle(value_str(value_field(f, "name")))};`)
  }
  out = out.concat(emit_plugin_ctors(cname, config_fields))
  out = out.push("    @Override")
  out = out.push("    public Disposable apply(Context ctx) {")
  out = out.push("        Context.EffectScope fx = ctx.effect();")
  for (local of req_locals) {
    let srvn = value_str(value_field(reqs_m, local))
    out = out.push(`        ${srvn} ${local} = ctx.get(${srvn}.class);`)
  }
  out = out.push("        try {")
  for (step of body) {
    let key = value_str(value_field(step, "name"))
    let srv = value_str(value_field(step, "service"))
    let struct = `${cname}${camel(key)}`
    var cargs = ["ctx", "fx"]
    for (local of req_locals) { cargs = cargs.push(local) }
    out = out.push(`            fx.track(ctx.provide(ServiceKey.of(${srv}.class), new ${struct}(${cargs.join(", ")})));`)
  }
  out = out.push("            return fx;")
  out = out.push("        } catch (RuntimeException | Error failure) {")
  out = out.push("            fx.dispose();")
  out = out.push("            throw failure;")
  out = out.push("        }")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")
  return out
}

// `_emit_component` (SIMPLE legacy path only): a provider `public static final
// class <Comp><Camel(key)> implements <Svc>` per provision (an empty ctor, one
// inline method per op), then the `<Comp>Plugin` whose `apply` registers each
// provision (`ctx.provide(ServiceKey.of(<Svc>.class), new <struct>())`) onto a
// LIFO undo list (`_emit_plugin_ctors` no-config form + the A8 self-revert catch).
// A non-simple component takes the modern path when supported (item 225), else a
// loud DEFER marker.
fn emit_component(comp: Any, services: Any, ctx: Ctx) -> List[Str] {
  let name = value_str(value_field(comp, "name"))
  if (!component_simple_ok(comp)) {
    if (modern_supported(comp) && needs_modern_subset(comp)) {
      return emit_component_modern(comp, services, ctx)
    }
    return [`<<DEFER-component-nonsimple:${name}>>`]
  }
  let cname = mangle(name)
  let provs = value_field(comp, "provides")
  let body = value_list(value_field(comp, "body"))
  var out = []
  for (key of value_keys(provs)) {
    let srv = value_str(value_field(provs, key))
    let struct = `${cname}${camel(key)}`
    out = out.push(`public static final class ${struct} implements ${srv} {`)
    out = out.push(`    ${struct}() {`)
    out = out.push("    }")
    let svc_methods = value_field(value_field(services, srv), "methods")
    for (method of provide_methods(body, key)) {
      let mn = value_str(value_field(method, "name"))
      let svc_method = value_field(svc_methods, mn)
      var params = []
      for (pn of value_list(value_field(method, "params"))) {
        let pname = value_str(pn)
        params = params.push(`${java_v3_type(service_param_type(svc_method, pname), false)} ${pname}`)
      }
      var ret_is_void = true
      var ret = "void"
      let r = value_field(svc_method, "returns")
      if (!value_is_null(r)) { ret = java_v3_type(r, false) ret_is_void = false }
      out = out.push(`    public ${ret} ${mangle(mn)}(${params.join(", ")}) { ${method_body(method, ret_is_void)} }`)
    }
    out = out.push("}")
    out = out.push("")
  }
  out = out.push(`public static final class ${cname}Plugin implements Plugin {`)
  out = out.push(`    public ${cname}Plugin() {`)
  out = out.push("    }")
  out = out.push("    @Override")
  out = out.push("    public Disposable apply(Context ctx) {")
  out = out.push("        java.util.ArrayList<Disposable> undos = new java.util.ArrayList<>();")
  out = out.push("        try {")
  for (step of body) {
    let key = value_str(value_field(step, "name"))
    let srv = value_str(value_field(step, "service"))
    let struct = `${cname}${camel(key)}`
    out = out.push(`            undos.add(ctx.provide(ServiceKey.of(${srv}.class), new ${struct}()));`)
  }
  out = out.push("            java.util.Collections.reverse(undos);")
  out = out.push("            return Disposables.composite(undos.toArray(new Disposable[0]));")
  out = out.push("        } catch (RuntimeException | Error failure) {")
  out = out.push("            for (int i = undos.size() - 1; i >= 0; i--) {")
  out = out.push("                undos.get(i).dispose();")
  out = out.push("            }")
  out = out.push("            throw failure;")
  out = out.push("        }")
  out = out.push("    }")
  out = out.push("}")
  out = out.push("")
  return out
}

// The document assembly for a typed-core v3 document (`_emit_v3`, subset): the
// two banner comments, the package, the core imports, the `Components` wrapper,
// then the user `type` decls and the free functions — each line 4-space indented
// into the class — joined with newlines, right-stripped, closed with a single
// trailing newline. Components/services/externs/tests/Result/stdlib are DEFERRED;
// the covered corpus declares none, so every gated block contributes nothing.
pub fn emit_src(ir: Any) -> Str {
  let ctx = build_ctx(ir)
  let types = value_field(ir, "types")
  let functions = value_list(value_field(ir, "functions"))
  var out = []
  out = out.push("// Generated by the revl cordis4j backend (ir_version 3) — do not edit.")
  out = out.push("// Target: cordis4j (github.com/1na-ko/cordis4j).")
  out = out.push("package revl;")
  out = out.push("")
  out = out.concat(core_imports())
  out = out.push("")
  out = out.push("public final class Components {")
  out = out.push("    private Components() {}")
  out = out.push("")
  if (value_keys(types).length() > 0) {
    for (l of emit_v3_types(types)) {
      if (l == "") { out = out.push("") } else { out = out.push("    ".concat(l)) }
    }
  }
  // Service interfaces follow the type decls, mirroring `_emit_v3`'s block order
  // (result-type / types / services / host-stubs / ... / functions / components).
  // Host stubs, stdlib, ftoa, checked-div, externs, tests and spawn are all
  // DEFERRED and contribute nothing for the covered corpus.
  let services = value_field(ir, "services")
  if (!value_is_null(services) && value_keys(services).length() > 0) {
    for (l of emit_service_interfaces_v3(services)) {
      if (l == "") { out = out.push("") } else { out = out.push("    ".concat(l)) }
    }
  }
  if (functions.length() > 0) {
    for (l of emit_v3_functions(functions, ctx)) {
      if (l == "") { out = out.push("") } else { out = out.push("    ".concat(l)) }
    }
  }
  // Components close the class body (after the free functions), each provider +
  // plugin block 4-space indented into `Components`.
  let components = value_field(ir, "components")
  if (!value_is_null(components)) {
    for (comp of value_list(components)) {
      for (l of emit_component(comp, services, ctx)) {
        if (l == "") { out = out.push("") } else { out = out.push("    ".concat(l)) }
      }
    }
  }
  out = out.push("}")
  return rstrip(out.join(newline())).concat(newline())
}

// ---------------------------------------------------------------- in-file tests
test "java_v3_type covers the scalar and generic surface" {
  assert java_v3_type("Int", false) == "long"
  assert java_v3_type("Str", false) == "String"
  assert java_v3_type("Bool", false) == "boolean"
  assert java_v3_type("List[Int]", false) == "java.util.List<java.lang.Long>"
  assert java_v3_type("Opt[Str]", false) == "java.util.Optional<String>"
  assert java_v3_type("Map[Str, Int]", false) == "java.util.Map<String, java.lang.Long>"
}

test "bin-op table and exact-method map the arithmetic surface" {
  assert java_bin_ops("<=") == "<="
  assert java_bin_ops("/") == "/"
  assert java_bin_ops("&&") == "&&"
  assert exact_method("+") == "addExact"
  assert exact_method("-") == "subtractExact"
  assert exact_method("*") == "multiplyExact"
}

test "keyword-colliding identifiers are renamed by appending underscore" {
  assert mangle("new") == "new_"
  assert mangle("class") == "class_"
  assert mangle("value") == "value"
  assert fn_name("double") == "double_"
  assert fn_name("config") == "config_"
  assert fn_name("add") == "add"
}

test "the field-set key canonicalises regardless of order" {
  assert sorted_key(["y", "x"]) == "x,y"
  assert sorted_key(["x", "y"]) == "x,y"
  assert resolved("Outcome") == true
  assert resolved("<<AMBIG>>") == false
  assert resolved("") == false
}

test "camel maps a provision key to its PascalCase struct suffix" {
  assert camel("greeting") == "Greeting"
  assert camel("count") == "Count"
}

// --------------------------------------------------------------- component wrap
// A trivial provider so the emitted module is a valid plugin (the pure `emit_src`
// above is what the cross-check exercises); mirrors the wrapper the other
// self-host stages carry. `render` avoids the `emit` keyword.
service EmitStream {
  fn render(ir: Any) -> Str
}

component EmitJava provides emitter: EmitStream {
  provide emitter {
    fn render(ir) = emit_src(ir)
  }
}
