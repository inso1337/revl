// The revl backend-IR -> cordis-go EMITTER, in revl — Path B slice 1 for the
// GO tier (roadmap item 198). Where selfhost/emit_py.rvl ports the tail of the
// compiler to Python and selfhost/emit_rust.rvl to Rust, this file ports it to
// Go: it reads the stable interchange IR (docs/backend-ir.md) and produces Go
// source text, mirroring backends/go/emit.py's PURE typed-core path
// (`_emit_v3_go`).
//
// It is one half of a differential BYTE oracle: this file and
// backends/go/emit.py's `emit()` are two independent implementations of the
// same lowering, forced to produce BYTE-IDENTICAL Go for every input in the
// covered subset (tests/test_selfhost_emit_go.py). The reference is ground
// truth; any divergence is a defect in this slice.
//
// ============================================================ WHAT IT COVERS
// Every IR the frontend produces is ir_version 3, and a document with only
// module functions and NO components routes through the reference's PURE
// typed-core path (`emit()` -> `_emit_v3_go` -> `_emit_v3_go_functions` ->
// `_go_v3_stmt` / `_go_v3_expr`) — ordinary Go, no stc-go runtime. The covered
// corner is a FUNCTION-ONLY document with NO services, NO user types, NO
// stdlib builtins:
//
//   * the module scaffold — the two `// Code generated …` banner lines, the
//     `package emitted`, the conditional `import ( … )` block (only `"fmt"`
//     and `"strconv"` reach it in-slice, from an interpolation; which of the
//     two depends on the operand types, see `render_interp`), and the conditional
//     runtime PREAMBLES the pure path prepends when a feature is used:
//     `revlDiv` (true division), the `revlAdd`/`revlSub`/`revlMul` Int-overflow
//     trap trio, and the `revlAddI32`/`revlSubI32`/`revlMulI32`/`revlToI32`
//     Int32 trap block. Which preambles appear is a deterministic function of
//     the IR, computed here by a structural pass (`collect_flags`) that mirrors
//     the flags the reference sets while rendering.
//   * `_emit_v3_go_functions` — each module fn as a Go `func`, with `go_type`
//     for scalar / `List` / `Opt` / `Map` / `Result` / function parameter and
//     return types, and an empty (Unit) return rendered as no result.
//   * `_go_v3_stmt` for the base statement surface — let (with the int64/float64
//     `var name T = …` pin and the `_ = name` keep-alive), assign, return,
//     if/else, while, for (the `for _, x := range …` form with its `_ = x`),
//     the bare-expr `_ = …`, and assert (`if !(…) { t.Fatalf(…) }`).
//   * the v3 TYPED-CORE (item 209) — user `type` decls (`_emit_v3_go_types`): a
//     record as a Go `struct` with EXPORTED, `json:"<source>"`-tagged fields
//     (item 390 — so a record marshals through `encoding/json`), a variant as a
//     sealed interface (`isX()` seal) plus one struct
//     per case; record literals (`Struct{f: v, ..}`) and field access (`r.f`);
//     ADT construction (nullary `<Variant><Case>{}` / payload `{Value: arg}`);
//     `match` over user variants as a Go type switch IIFE; user record/variant
//     names in `go_type` (`List`/`Opt`/`Map`/`Result` of a user type); and the
//     `_V3GoCtx` record/variant inference (`ca`/`cp`/`rbf`/`rf`) that seeds
//     `var_types`, picks a record literal's nominal struct, and types a `let`
//     bound to a field access. Functional record-update stays deferred (below).
//   * `_go_v3_expr` for the base expression algebra — lit, name/var, bin (the
//     trapping Int/Int32 `+ - *`, `/` as `revlDiv(float64(..), float64(..))`,
//     `%`, comparisons, `&&`/`||`, native scalar `==`/`!=`, and string `+` as
//     Go `+`), un (`!`, and the `revlSub(0, x)` Int negate), the free-function
//     call, index, list literal, the sync arrow (with untyped-param recovery),
//     the `widen` Float/Int markers, and non-float `${..}` interpolation as a
//     `+` chain over the inferred operand types (`fmt.Sprintf` only as the
//     untyped fallback, item 434 (f)).
//   * `_emit_v3_go_externs` — an extern as a Go `func` carrying its verbatim,
//     leading-tab-spliced `@go` body (types, then externs, then the free
//     functions), and the extern return types the `let` inference reads
//     (`ctx.extern_ret`). It carries the DECLARED `Secret[T]` marking below,
//     which is why it is in-slice at all; three reference shapes stay out and
//     take a loud marker (see `emit_externs`): a missing `@go` body, a `config`
//     schema, and a `//revl:import` hoist.
//
// ==================================== DECLARED Secret[T] (item 421 F6 / 429(d))
// The ORIGIN end of a declared marking — an extern whose declared return was
// `Secret[T]` — emits `revlSecretResult(revlSecret_<name>(..))` around the
// verbatim body, exactly as the reference does. Ported per item 429(d), corpus
// first (`tests/fixtures/emit_go_corpus/secrets.rvl`) and red before the port,
// so the oracle is known to reach the logic rather than to agree around it.
// The RECEIVER end (`revlMarkSecret` at the head of a provide method whose
// service declares the parameter) and the `hostRecord` scrub funnel live in the
// live stc-go COMPONENT world, which this slice does not emit at all; they are
// covered by the first deferral below, not by a separate gap.
//
// NOT closed by this port: the self-host FRONTEND does not produce the stamp.
// `src/revl/taint.py` is what strips the `Secret[...]` qualifier and sets
// `externs[i].secret_return`, and nothing in selfhost/{lexer,parser,checker,
// lower}.rvl mirrors it — so driven by the native `lower_to_ir` this emitter
// sees `returns: "Secret[Str]"` with no stamp and renders the qualifier as a
// TYPE NAME instead of marking the value. The oracle above cannot see that: it
// feeds this emitter the REFERENCE IR. Fixing the emitter fixes the emitter;
// only the frontend port fixes the program.
//
// ============================================================ WHAT IT DEFERS
// Reported for follow-on go-emitter slices, deliberately OUT of this slice —
// each is a real reference surface this slice does not reach (its fixtures
// avoid it), NOT an approximation:
//   * the go LIVE-COMPONENT world is v1/v2 (the stc-go runtime path in
//     `emit()`); a component with no top-level decls routes there, NOT to the
//     pure typed-core path this slice mirrors. Components / services / the
//     effect-undo world / `provide`/`req`/`config` / timers / spawn / realms /
//     the interop bridge (`_emit_go_bridge`) / placement — all deferred.
//   * functional record-update (`{r | f = e}`, `record_update`) — the go
//     reference itself RAISES on it (only python/typescript emit it today; see
//     docs/records.md §6, "lift it into a helper fn instead"), so it is a
//     structural deferral, not an approximation. (The rest of the v3 TYPED-CORE
//     — user `type` decls, record literals, ADT construction and `match` over
//     user variants, and the record/variant inference in `_V3GoCtx` — is now
//     COVERED, item 209; see the typed-core bullet under WHAT IT COVERS.)
//   * the built-in Opt / Result / Map surface — the `??` coalesce, the
//     `Some`/`None`/`Ok`/`Err` constructors, `Map.empty()` (`maplit`), optional
//     chaining (`optfield`/`optcall`), and the `_V3_OPT_PREAMBLE` /
//     `_V3_RESULT_PREAMBLE` / `_V3_MAP_PREAMBLE` blocks they pull in. Their TYPE
//     lowering (`RevlOpt[..]` / `RevlResult[..]` / `map[..]..`) is implemented in
//     `go_type` for completeness, but a fixture that spells `Opt[`/`Result[` or
//     a map literal/method trips a preamble this slice does not emit, so those
//     are excluded (a Map-typed passthru with no literal/method is in-corpus —
//     it needs no preamble).
//   * the STDLIB surface — every `builtin`/`len` node and the
//     `_V3_STDLIB_PREAMBLE` it pulls in; the total division forms
//     (`div_floor`/`div_euclid`/`mod` and the `checked_*` Result forms) and
//     their `revlDivFloor`/… helpers; `Str.to_int` (`revlParseInt`).
//   * structural equality over NON-scalars (`revlEq` / the `reflect` import) and
//     the canonical Float->Str `revlFtoa` in interpolation (so a Float part is
//     excluded — a Float part would pull the ftoa helper the scaffold omits).
//   * the parts of `_emit_v3_go_externs` listed above (a `config` schema and
//     its `_revl_config` bind, the `//revl:import` hoist into the module import
//     block, and the reference's raise on a missing `@go` body), in-file
//     `test` emission, async coloring / lifecycle, and the astral reaches of
//     `_go_string` beyond the ASCII/BMP core (the escaper is bridged verbatim,
//     but such literals are not in-corpus).
//
// ------------------------------------------------------ the erased-IR boundary
// Navigation of the IR is PURE revl through stdlib/value.rvl's `value_*`
// accessors (item 180/188) and stdlib/str.rvl's `split_top`/`rstrip`/`trim`
// (item 193), exactly as selfhost/emit_py.rvl / emit_rust.rvl do: every byte of
// emitter LOGIC (flag collection, dispatch, formatting, the var_types threading,
// string building) is revl. Only genuine HOST FORMATTING stays `@py`: the
// `tab`/`newline` char emitters (kin to rust's `newline()`), `num_str`
// (`str(value)`), `float_lit` (the `float64({v!r})` body), and `go_string` (the
// reference `_go_string` Go-literal escaper, kin to py's `py_repr`).
use "../stdlib/value.rvl" {
  value_kind, value_is_null, value_field,
  value_list, value_at, value_str, value_int, value_bool, value_keys
}
use "../stdlib/str.rvl" { split_top, rstrip, trim, str_tab }
// The list kit (item 194): `list_sort` is the codepoint-lexicographic `sorted(..)`
// the reference uses to canonicalise a record's field set into a `record_by_fields`
// key — no re-hand-roll (byte-fuzz-pinned against Python `sorted()`).
use "../stdlib/list.rvl" { list_sort }

// ------------------------------------------------- host formatting (kept @py)
// A single tab / newline byte — the one genuine U+0009 / U+000A. Go indents with
// tabs and the module is `"\n".join(out)`; both are char output, the item-180
// "NOT obsoleted" category (rust's emitter bridges `newline()` the same way).
extern pure fn tab() -> Str = @py { return chr(9) }
extern pure fn newline() -> Str = @py { return chr(10) }
// The literal-body host numerals: `_go_v3_lit` renders an int as `str(value)`.
extern pure fn num_str(v: Any) -> Str = @py { return str(v) }
// A Float literal: `_go_v3_lit` renders it as `float64({value!r})` — Python's
// repr of the float, so the numeral text is exactly the reference's.
extern pure fn float_lit(v: Any) -> Str = @py { return "float64(%r)" % v }
// `_go_string` verbatim: a Go double-quoted string literal escaped FROM code
// points (docs/strings.md) — printable ASCII/BMP verbatim, a `\uXXXX` (4 hex)
// for a BMP non-ASCII scalar and `\UXXXXXXXX` (8 hex) for an astral one. A
// tuple-free body keeps the @py raw-brace balancer happy.
extern pure fn go_string(v: Any) -> Str = @py {
    s = str(v)
    out = ['"']
    for ch in s:
        cp = ord(ch)
        if ch == '"':
            out.append('\\"')
        elif ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif 0x20 <= cp <= 0x7E:
            out.append(ch)
        elif cp <= 0xFFFF:
            out.append("\\u%04x" % cp)
        else:
            out.append("\\U%08x" % cp)
    out.append('"')
    return "".join(out)
}

// ---------------------------------------------------------------- small utils
fn ind(n: Int) -> Str { return tab().repeat(n) }
fn line(indent: Int, text: Str) -> Str { return ind(indent).concat(text) }
fn node_kind(n: Any) -> Str { return value_str(value_field(n, "kind")) }
fn node_op(n: Any) -> Str { return value_str(value_field(n, "op")) }
fn node_operands(n: Any) -> Str { return value_str(value_field(n, "operands")) }
fn node_step(n: Any) -> Str { return value_str(value_field(n, "step")) }

// `_v3_ident`: rename a Go reserved word so a valid revl identifier that is a
// Go keyword still emits (mirrors `_v3_ident`; the fixtures use `use_add`,
// itself not reserved, so this is exercised only defensively). The rename is
// INJECTIVE: escape a name iff the name or any name reachable from it by
// dropping trailing `_` is reserved, by exactly one `_`, so the whole
// `kw`/`kw_`/`kw__` ladder shifts up a rung (`func` -> `func_`, `func_` ->
// `func__`) instead of collapsing two distinct revl identifiers onto one.
fn v3_ident(name: Str) -> Str {
  var root = name
  while (root.length() > 0) {
    if (is_go_reserved(root)) { return name.concat("_") }
    if (root.charAt(root.length() - 1) != "_") { return name }
    root = root.slice(0, root.length() - 1)
  }
  return name
}

fn is_go_reserved(name: Str) -> Bool {
  if (name == "break" || name == "case" || name == "chan" || name == "const") { return true }
  if (name == "continue" || name == "default" || name == "defer" || name == "else") { return true }
  if (name == "fallthrough" || name == "for" || name == "func" || name == "go") { return true }
  if (name == "goto" || name == "if" || name == "import" || name == "interface") { return true }
  if (name == "map" || name == "package" || name == "range" || name == "return") { return true }
  if (name == "select" || name == "struct" || name == "switch" || name == "type") { return true }
  if (name == "var" || name == "nil" || name == "true" || name == "false" || name == "iota") { return true }
  return false
}

// `_camel` verbatim (item 390): snake_or_lower / `-` -> UpperCamel, keeping the
// tail of each part as-is. This is the reference `_camel` byte-for-byte
// (`p[:1].upper() + p[1:]`, NOT `.capitalize()`, which would lowercase the tail
// and diverge on a lowerCamel field name).
extern pure fn camel(name: Str) -> Str = @py {
    return "".join(p[:1].upper() + p[1:] for p in str(name).replace("-", "_").split("_") if p)
}

// `_v3_field_ident`: a record struct field name, EXPORTED (UpperCamel) on every
// path (item 390) so `encoding/json` marshals it — an unexported field made
// `json_stringify(record)` return `{}` on go. Paired with `json_tag` below,
// which pins the wire key to the source field name. Used at EVERY field site
// (struct decl, literal construction, field read) so records round-trip.
fn v3_field_ident(field: Str) -> Str { return camel(field) }

// The struct tag ``json:"<field>"`` (a backtick-delimited Go raw string). Built
// with double-quoted literals because a template `..` cannot embed a backtick.
fn json_tag(field: Str) -> Str { return "`json:\"".concat(field).concat("\"`") }

// `_V3_GO_ATOMIC`: a postfix-safe primary appends `.field`/`[i]`/`(…)` without a
// wrapping paren.
fn is_atomic(kind: Str) -> Bool {
  if (kind == "var") { return true }
  if (kind == "name") { return true }
  if (kind == "lit") { return true }
  if (kind == "call") { return true }
  if (kind == "field") { return true }
  if (kind == "index") { return true }
  return kind == "builtin"
}

// `_V3_GO_BIN_OPS`: revl operator -> Go operator, "" when unmapped.
fn go_bin_op(op: Str) -> Str {
  if (op == "==") { return "==" }
  if (op == "===") { return "==" }
  if (op == "!=") { return "!=" }
  if (op == "!==") { return "!=" }
  if (op == "<") { return "<" }
  if (op == ">") { return ">" }
  if (op == "<=") { return "<=" }
  if (op == ">=") { return ">=" }
  if (op == "+") { return "+" }
  if (op == "-") { return "-" }
  if (op == "*") { return "*" }
  if (op == "/") { return "/" }
  if (op == "%") { return "%" }
  if (op == "&&") { return "&&" }
  if (op == "||") { return "||" }
  // Int32 bitwise operators (item 366, docs/arithmetic.md). `& | ^` are native
  // on int32. The shifts are rendered specially (render_bin): Go does not mask
  // the shift count and panics on a negative signed one, so the count is taken
  // as `uint32(n) & 31` to match the spec's mod-32 rule and wasm/JS.
  if (op == "&") { return "&" }
  if (op == "|") { return "|" }
  if (op == "^") { return "^" }
  if (op == "<<") { return "<<" }
  if (op == ">>") { return ">>" }
  return ""
}

fn is_eq_op(op: Str) -> Bool { return op == "==" || op == "===" || op == "!=" || op == "!==" }
fn is_addsubmul(op: Str) -> Bool { return op == "+" || op == "-" || op == "*" }
fn is_scalar(t: Str) -> Bool {
  return t == "Int" || t == "Int32" || t == "Float" || t == "Str" || t == "Bool"
}

// ---------------------------------------------------------------- lowering ctx
// `_V3GoCtx` (subset): a binding's surface type (seeded from params, updated on
// `let`/`for`) types a `let`'s `var T =` pin, the scalar-`==` split, and the
// Str `+` / Float-interp routing; a free function's declared return type types a
// `let` bound to its call, and `rt` is the enclosing fn's return (the `expected`
// pin a `return` threads onto a list literal). The user-type tables mirror the
// reference's `_V3GoCtx`:
//   * `ca` (`case_adt`)     — variant case name -> its sealed-interface type name
//     (the `<<AMBIG>>` sentinel marks a case shared by two variants, where the
//     reference stores `None` and refuses at use);
//   * `cp` (`case_payload`) — case name -> its payload SURFACE type ("" for a
//     nullary case, where the reference stores `None`), so a construction picks
//     `TreeLeaf{}` vs `TreeNode{Value: ..}` and a bound match arm types `_m.Value`;
//   * `rbf` (`record_by_fields`) — the sorted-field KEY of a record -> its struct
//     type name (`<<AMBIG>>` when two records share the exact field set), so a
//     record literal `{ a: .., b: .. }` infers its nominal Go struct;
//   * `rf` (record fields) — `"<Type>.<field>"` -> the field's surface type, so a
//     field access `r.f` infers its type (the `var z int64 =` let pin).
type Ctx = {
  vt: Map[Str, Str], fr: Map[Str, Str], er: Map[Str, Str],
  signatures: List[Any],
  ca: Map[Str, Str], cp: Map[Str, Str], rbf: Map[Str, Str], rf: Map[Str, Str],
  rt: Str, builders: Map[Str, Str], builder_seq: Int,
  reserved: Map[Str, Str], strings_alias: Str
}
// The user-type tables, built once from the document's `types` and shared by
// every function's ctx (the reference builds one `_V3GoCtx` for the function list,
// reusing the same type tables).
type TypeTables = { ca: Map[Str, Str], cp: Map[Str, Str], rbf: Map[Str, Str], rf: Map[Str, Str] }
// A statement-emission result: the lines produced AND the threaded ctx, since
// revl has no shared mutable state and a `let` inside an `if`/`while`/`for` block
// is visible to every later statement (the reference mutates one `ctx`).
type Sout = { lines: List[Str], ctx: Ctx }
type Fout = { lines: List[Str], uses_strings: Bool }

fn map_get(m: Map[Str, Str], k: Str) -> Str {
  return match m.lookup(k) { Some(v) => v, None => "" }
}
fn set_vt(ctx: Ctx, k: Str, v: Str) -> Ctx {
  return {
    vt: ctx.vt.set(k, v), fr: ctx.fr, er: ctx.er,
    signatures: ctx.signatures,
    ca: ctx.ca, cp: ctx.cp, rbf: ctx.rbf, rf: ctx.rf, rt: ctx.rt,
    builders: ctx.builders, builder_seq: ctx.builder_seq,
    reserved: ctx.reserved, strings_alias: ctx.strings_alias
  }
}

fn collect_reserved(node: Any, reserved: Map[Str, Str]) -> Map[Str, Str] {
  var out = reserved
  if (value_kind(node) == "record") {
    let name = value_field(node, "name")
    let bind = value_field(node, "bind")
    if (value_kind(name) == "str" && value_str(name) != "") {
      out = out.set(v3_ident(value_str(name)), "1")
    }
    if (value_kind(bind) == "str" && value_str(bind) != "") {
      out = out.set(v3_ident(value_str(bind)), "1")
    }
  }
  for (child of value_children(node)) { out = collect_reserved(child, out) }
  return out
}

fn fresh_ident(base: Str, reserved: Map[Str, Str]) -> Str {
  var candidate = base
  var suffix = 0
  while (map_get(reserved, candidate) != "") {
    candidate = `${base}${suffix}`
    suffix = suffix + 1
  }
  return candidate
}
// Whether a `ca`/`rbf` entry names a usable (unique) type; the `<<AMBIG>>`
// sentinel and a missing key both mean "not a byte-exact target here".
fn resolved(name: Str) -> Bool { return name != "" && name != "<<AMBIG>>" }

// `record_by_fields`' key: the field NAMES sorted (Python `tuple(sorted(..))`),
// joined with a `,`. Both the type-decl side (`fields.keys()`) and the record
// literal side (`[k for k, _ in fields]`) reduce to the same key.
fn sorted_key(names: List[Str]) -> Str { return list_sort(names).join(",") }

// `_V3GoCtx`'s type-table construction: fold the document `types` into the case /
// record lookups. Ambiguity (a case name / field set shared by two decls) is
// marked `<<AMBIG>>`, exactly where the reference stores `None`.
fn build_type_tables(types: Any) -> TypeTables {
  var ca: Map[Str, Str] = Map.empty()
  var cp: Map[Str, Str] = Map.empty()
  var rbf: Map[Str, Str] = Map.empty()
  var rf: Map[Str, Str] = Map.empty()
  for (name of value_keys(types)) {
    let spec = value_field(types, name)
    let kind = value_str(value_field(spec, "kind"))
    if (kind == "record") {
      let fields = value_field(spec, "fields")
      let names = value_keys(fields)
      let key = sorted_key(names)
      if (rbf.has(key)) { rbf = rbf.set(key, "<<AMBIG>>") } else { rbf = rbf.set(key, name) }
      for (field of names) {
        rf = rf.set(`${name}.${field}`, value_str(value_field(fields, field)))
      }
    }
    if (kind == "variant") {
      for (case of value_list(value_field(spec, "cases"))) {
        let cn = value_str(value_field(case, "name"))
        let payload = value_field(case, "payload")
        if (value_is_null(payload)) { cp = cp.set(cn, "") } else { cp = cp.set(cn, value_str(payload)) }
        if (ca.has(cn)) { ca = ca.set(cn, "<<AMBIG>>") } else { ca = ca.set(cn, name) }
      }
    }
  }
  return { ca: ca, cp: cp, rbf: rbf, rf: rf }
}

// `_V3GoCtx.record_type_for_fields`: a record literal's nominal struct type, from
// its (sorted) field set. Reference RAISES on no-unique-match; here the marker
// keeps the emitter total (no in-corpus literal is ambiguous or unknown).
fn record_type_for_fields(ctx: Ctx, names: List[Str]) -> Str {
  let name = map_get(ctx.rbf, sorted_key(names))
  if (!resolved(name)) { return "<<DEFER-record>>" }
  return v3_ident(name)
}

// -------------------------------------------------------------------- types
fn split_fn_type(name: Str) -> List[Str] {
  // `(A, B) -> C` -> ["A", "B", "C"] with the RETURN last (always non-empty for
  // a function type); `[]` when `name` is not a function type. The top-level
  // `->` splits params (a parenthesised list) from the return.
  let arrow = top_arrow(name)
  if (arrow < 0) { return [] }
  let params_src = trim_str(name.slice(0, arrow))
  let returns = trim_str(name.slice(arrow + 2, name.length()))
  if (!(params_src.startsWith("(") && params_src.endsWith(")"))) { return [] }
  let inner = trim_str(params_src.slice(1, params_src.length() - 1))
  var parts = []
  if (inner != "") { parts = split_top(inner, ",") }
  parts = parts.push(returns)
  return parts
}

fn trim_str(s: Str) -> Str {
  var a = 0
  var b = s.length()
  var go = true
  while (go && a < b) { if (s.charCodeAt(a) == 32) { a = a + 1 } else { go = false } }
  go = true
  while (go && b > a) { if (s.charCodeAt(b - 1) == 32) { b = b - 1 } else { go = false } }
  return s.slice(a, b)
}

// The index of the top-level `->` (depth 0 over `[]`/`()`), or -1.
fn top_arrow(name: Str) -> Int {
  var depth = 0
  var i = 0
  let n = name.length()
  while (i < n - 1) {
    let ch = name.charAt(i)
    if (ch == "[" || ch == "(") { depth = depth + 1 }
    else {
      if (ch == "]" || ch == ")") { depth = depth - 1 }
      else {
        if (ch == "-" && name.charAt(i + 1) == ">" && depth == 0) { return i }
      }
    }
    i = i + 1
  }
  return 0 - 1
}

fn erase_async(ret: Str) -> Str {
  let r = trim_str(ret)
  if (r.startsWith("Async[") && r.endsWith("]")) {
    return trim_str(r.slice(6, r.length() - 1))
  }
  return ret
}

fn prim_go(t: Str) -> Str {
  if (t == "Int") { return "int64" }
  if (t == "Int32") { return "int32" }
  if (t == "Str") { return "string" }
  if (t == "Bool") { return "bool" }
  if (t == "Float") { return "float64" }
  if (t == "Bytes") { return "[]byte" }
  return ""
}

// `_go_v3_type`: a surface type -> its Go spelling. "" for None/""/Unit.
fn go_type(tv: Any) -> Str {
  let raw = value_str(tv)
  if (raw == "" || raw == "Unit") { return "" }
  let t = trim_str(raw)
  let pg = prim_go(t)
  if (pg != "") { return pg }
  if (t == "Any") { return "any" }
  let ft = split_fn_type(t)
  if (ft.length() > 0) {
    let np = ft.length()
    var ps = []
    var i = 0
    while (i < np - 1) { ps = ps.push(go_type(ft[i])); i = i + 1 }
    let ret = go_type(erase_async(ft[np - 1]))
    let head = "func(".concat(ps.join(", ")).concat(") ").concat(ret)
    return rstrip(head)
  }
  if (t.endsWith("]") && contains_ch(t, "[")) {
    let lb = t.indexOf("[")
    let head = t.slice(0, lb)
    let inner = t.slice(lb + 1, t.length() - 1)
    if (head == "List") { return "[]".concat(go_type(inner)) }
    if (head == "Opt") { return `RevlOpt[${go_type(inner)}]` }
    if (head == "Result") {
      let ps = split_top(inner, ",")
      return `RevlResult[${go_type(ps[0])}, ${go_type(ps[1])}]`
    }
    if (head == "Map") {
      let ps = split_top(inner, ",")
      return `map[${go_type(ps[0])}]${go_type(ps[1])}`
    }
  }
  return v3_ident(t)
}

fn contains_ch(s: Str, ch: Str) -> Bool { return s.indexOf(ch) >= 0 }

// `_go_v3_lit`: a v3 literal.
fn go_v3_lit(node: Any) -> Str {
  let v = value_field(node, "value")
  let k = value_kind(v)
  if (k == "bool") { if (value_bool(v)) { return "true" } return "false" }
  if (k == "null") { return "nil" }
  if (k == "str") { return go_string(v) }
  if (k == "int") { return num_str(v) }
  if (k == "float") { return float_lit(v) }
  return "<<UNSUPPORTED-LIT>>"
}

// --------------------------------------------------- type inference (subset)
fn ref_name(node: Any) -> Str {
  let nm = value_str(value_field(node, "name"))
  if (nm != "") { return nm }
  return value_str(value_field(node, "id"))
}

// `_go_v3_infer_type`: the surface type of an expression when knowable, else "".
fn infer_type(node: Any, ctx: Ctx) -> Str {
  if (value_kind(node) != "record") { return "" }
  let w = value_str(value_field(node, "widen"))
  if (w == "Float") { return "Float" }
  if (w == "Int") { return "Int" }
  let k = node_kind(node)
  if (k == "lit") {
    let vk = value_kind(value_field(node, "value"))
    if (vk == "bool") { return "Bool" }
    if (vk == "int") { return "Int" }
    if (vk == "float") { return "Float" }
    if (vk == "str") { return "Str" }
    return ""
  }
  if (k == "var" || k == "name") { return map_get(ctx.vt, ref_name(node)) }
  if (k == "interp") { return "Str" }
  if (k == "list") {
    let pin = value_str(value_field(node, "expected"))
    if (pin.startsWith("List[") && pin.endsWith("]")) { return pin }
    let items = value_list(value_field(node, "items"))
    if (items.length() > 0) {
      let elem = infer_type(items[0], ctx)
      if (elem != "") { return `List[${elem}]` }
    }
    return ""
  }
  if (k == "index") {
    let tt = infer_type(value_field(node, "target"), ctx)
    if (tt.startsWith("List[") && tt.endsWith("]")) { return tt.slice(5, tt.length() - 1) }
    return ""
  }
  if (k == "call") {
    let callee = value_field(node, "callee")
    if (node_kind(callee) == "var") {
      let nm = value_str(value_field(callee, "name"))
      let fr = map_get(ctx.fr, nm)
      if (fr != "") { return fr }
      return map_get(ctx.er, nm)
    }
    return ""
  }
  if (k == "bin") {
    let op = node_op(node)
    if (is_eq_op(op) || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||") { return "Bool" }
    if (node_operands(node) == "Int32" && is_addsubmul(op)) { return "Int32" }
    if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") { return "Int32" }
    if (node_operands(node) == "Float" && is_addsubmul(op)) { return "Float" }
    if (op == "+") {
      let lt = infer_type(value_field(node, "left"), ctx)
      let rt = infer_type(value_field(node, "right"), ctx)
      if (lt == "Str" || rt == "Str") { return "Str" }
      if (lt != "") { return lt }
      return rt
    }
    if (op == "/") { return "Float" }
    if (op == "-" || op == "*" || op == "%") {
      if (node_operands(node) == "Float") { return "Float" }
      return "Int"
    }
    return ""
  }
  if (k == "un") {
    if (node_op(node) == "!") { return "Bool" }
    return infer_type(value_field(node, "operand"), ctx)
  }
  if (k == "if") {
    let t = infer_type(value_field(node, "then"), ctx)
    if (t != "") { return t }
    return infer_type(value_field(node, "else"), ctx)
  }
  if (k == "field") {
    // A record field access `r.f`: infer the receiver's record type, then read
    // the field's declared surface type from the `rf` table (a non-record
    // receiver, or an unknown field, misses and yields "").
    let tt = infer_type(value_field(node, "target"), ctx)
    return map_get(ctx.rf, `${tt}.${value_str(value_field(node, "name"))}`)
  }
  if (k == "record") {
    var names = []
    for (f of value_list(value_field(node, "fields"))) { names = names.push(value_str(value_at(f, 0))) }
    let tn = record_type_for_fields(ctx, names)
    if (tn == "<<DEFER-record>>") { return "" }
    return tn
  }
  if (k == "adt") {
    let a = map_get(ctx.ca, value_str(value_field(node, "case")))
    if (resolved(a)) { return a }
    return ""
  }
  return ""
}

// -------------------------------------------------------------- expressions
// `_infer_arrow_param`: recover an untyped lambda parameter's type from its
// first use as a binary operand in the body (pre-order DFS), or "".
fn arrow_param_hint(node: Any, name: Str, ctx: Ctx) -> Str {
  if (value_kind(node) != "record") { return "" }
  if (node_kind(node) == "bin") {
    let l = value_field(node, "left")
    let r = value_field(node, "right")
    if (is_ref_named(l, name)) {
      let o = infer_type(r, ctx)
      if (o != "") { return o }
    }
    if (is_ref_named(r, name)) {
      let o = infer_type(l, ctx)
      if (o != "") { return o }
    }
  }
  for (c of value_children(node)) {
    let h = arrow_param_hint(c, name, ctx)
    if (h != "") { return h }
  }
  return ""
}

fn is_ref_named(node: Any, name: Str) -> Bool {
  let k = node_kind(node)
  if (k != "var" && k != "name") { return false }
  return ref_name(node) == name
}

fn is_builtin_ctor(name: Str) -> Bool {
  return name == "Some" || name == "None" || name == "Ok" || name == "Err"
}

fn render_bin(node: Any, ctx: Ctx) -> Str {
  let op = node_op(node)
  if (op == "??") { return "<<DEFER-coalesce>>" }
  let goop = go_bin_op(op)
  if (goop == "") { return `<<UNSUPPORTED-BIN:${op}>>` }
  var left = render_expr(value_field(node, "left"), ctx, "")
  var right = render_expr(value_field(node, "right"), ctx, "")
  let opnd = node_operands(node)
  if (opnd == "Float") {
    let lt = infer_type(value_field(node, "left"), ctx)
    let rt = infer_type(value_field(node, "right"), ctx)
    if (lt == "Int" || lt == "Int32") { left = `float64(${left})` }
    if (rt == "Int" || rt == "Int32") { right = `float64(${right})` }
  }
  if (is_eq_op(op)) {
    let lt = infer_type(value_field(node, "left"), ctx)
    let rt = infer_type(value_field(node, "right"), ctx)
    if (!(is_scalar(lt) && is_scalar(rt))) { return "<<DEFER-reflect-eq>>" }
  }
  if (is_addsubmul(op) && opnd == "Int") {
    var h = "revlMul"
    if (op == "+") { h = "revlAdd" }
    if (op == "-") { h = "revlSub" }
    return `${h}(${left}, ${right})`
  }
  if (is_addsubmul(op) && opnd == "Int32") {
    var h = "revlMulI32"
    if (op == "+") { h = "revlAddI32" }
    if (op == "-") { h = "revlSubI32" }
    return `${h}(${left}, ${right})`
  }
  if (op == "/") {
    if (opnd == "Int" || opnd == "Int32") {
      return `revlDiv(float64(${left}), float64(${right}))`
    }
    return `revlDiv(${left}, ${right})`
  }
  if (op == "<<" || op == ">>") {
    // Int32 shift: mask the count to 0..31 as an unsigned value, because Go
    // neither masks the count nor accepts a negative signed one. `<<` drops the
    // high bits (int32 two's complement); `>>` on the signed int32 is
    // arithmetic (docs/arithmetic.md, item 366).
    return `(${left} ${goop} (uint32(${right}) & 31))`
  }
  return `(${left} ${goop} ${right})`
}

fn render_un(node: Any, ctx: Ctx) -> Str {
  let op = node_op(node)
  let operand = render_expr(value_field(node, "operand"), ctx, "")
  if (op == "!") { return `(!${operand})` }
  if (op == "~") {
    // Int32 bitwise complement (item 366): Go spells bitwise NOT as unary `^`.
    return `(^${operand})`
  }
  if (op == "-") {
    let opnd = node_operands(node)
    if (opnd == "Int") { return `revlSub(0, ${operand})` }
    if (opnd == "Int32") { return `revlSubI32(0, ${operand})` }
    return `(-${operand})`
  }
  return `<<UNSUPPORTED-UN:${op}>>`
}

fn render_call(node: Any, ctx: Ctx) -> Str {
  let callee = value_field(node, "callee")
  if (value_is_null(callee)) { return "<<DEFER-component-call>>" }
  let cn = value_str(value_field(callee, "name"))
  var param_types = []
  if (node_kind(callee) == "var") {
    if (resolved(map_get(ctx.ca, cn))) { param_types = [map_get(ctx.cp, cn)] }
    else {
      for (sig of ctx.signatures) {
        if (value_str(value_field(sig, "name")) == cn) {
          for (p of value_list(value_field(sig, "params"))) {
            param_types = param_types.push(value_str(value_field(p, "type")))
          }
        }
      }
    }
  }
  var args = []
  var i = 0
  for (a of value_list(value_field(node, "args"))) {
    var expected = ""
    if (i < param_types.length()) { expected = param_types[i] }
    args = args.push(render_expr(a, ctx, expected))
    i = i + 1
  }
  if (node_kind(callee) == "var") {
    // A constructor arriving as `call(callee=var Case, ..)`: a user variant is
    // constructed here; a built-in Opt/Result ctor is DEFERRED (its preambles).
    if (resolved(map_get(ctx.ca, cn))) { return render_construct(ctx, cn, args) }
    if (is_builtin_ctor(cn)) { return "<<DEFER-ctor>>" }
  }
  let csrc = render_expr(callee, ctx, "")
  return `${csrc}(${args.join(", ")})`
}

fn render_index(node: Any, ctx: Ctx) -> Str {
  let tn = value_field(node, "target")
  var target = render_expr(tn, ctx, "")
  if (!is_atomic(node_kind(tn))) { target = `(${target})` }
  return `${target}[${render_expr(value_field(node, "index"), ctx, "")}]`
}

fn render_list(node: Any, ctx: Ctx, expected: Str) -> Str {
  var elem = ""
  let pin = expected == "" ? value_str(value_field(node, "expected")) : expected
  if (pin.startsWith("List[") && pin.endsWith("]")) {
    elem = pin.slice(5, pin.length() - 1)
  }
  let items = value_list(value_field(node, "items"))
  if (elem == "" && items.length() > 0) { elem = infer_type(items[0], ctx) }
  var goelem = "any"
  if (elem != "") { goelem = go_type(elem) }
  var parts = []
  for (it of items) { parts = parts.push(render_expr(it, ctx, elem)) }
  return `[]${goelem}{${parts.join(", ")}}`
}

fn render_arrow(node: Any, ctx: Ctx) -> Str {
  let names = value_list(value_field(node, "params"))
  let ptypes = value_list(value_field(node, "param_types"))
  var declared = []
  var i = 0
  while (i < names.length()) {
    var d = ""
    if (i < ptypes.length()) { d = value_str(ptypes[i]) }
    if (d == "") { d = arrow_param_hint(value_field(node, "body"), value_str(names[i]), ctx) }
    declared = declared.push(d)
    i = i + 1
  }
  // Bind inferred param types so the body renders/infers against them.
  var bodyctx = ctx
  i = 0
  while (i < names.length()) {
    if (declared[i] != "") { bodyctx = set_vt(bodyctx, value_str(names[i]), declared[i]) }
    i = i + 1
  }
  var ps = []
  i = 0
  while (i < names.length()) {
    var gt = go_type(declared[i])
    if (gt == "") { gt = "any" }
    ps = ps.push(`${v3_ident(value_str(names[i]))} ${gt}`)
    i = i + 1
  }
  let body = render_expr(value_field(node, "body"), bodyctx, "")
  let bodyt = go_type(infer_type(value_field(node, "body"), bodyctx))
  var ret = ""
  if (bodyt != "") { ret = " ".concat(bodyt) }
  return `func(${ps.join(", ")})${ret} { return ${body} }`
}

// `_go_v3_interp`: a `${..}` template, rendered from the operand types the
// emitter already knows (roadmap item 434 (f)). `fmt.Sprintf` with `%v` takes
// `...any`, so every operand is boxed: `${a}/${b}` over two `Str` measured 3
// allocs / 48 B where the SAME emitter's `a + "/" + b` measured 1 / 16. Where
// every part's type is known each renders to a `string`-typed piece and the
// template is a `+` chain: one allocation for the result and no boxing;
// `fmt.Sprintf` with `%v` stays as the fallback for a part whose type could
// not be inferred. A Float part routes through the canonical `revlFtoa`
// (DEFERRED: such a part is excluded from the corpus, since it pulls in the
// `revlFtoa` helper the scaffold omits).
fn render_interp(node: Any, ctx: Ctx) -> Str {
  var fmt = []
  var args = []
  var pieces = []
  var typed = true
  for (part of value_list(value_field(node, "parts"))) {
    let k = value_str(value_at(part, 0))
    let v = value_at(part, 1)
    if (k == "text") {
      fmt = fmt.push(double_pct(value_str(v)))
      pieces = pieces.push(go_string(value_str(v)))
    } else {
      let vt = infer_type(v, ctx)
      let rendered = render_expr(v, ctx, "")
      if (vt == "Float") {
        fmt = fmt.push("%s")
        args = args.push(`revlFtoa(${rendered})`)
        pieces = pieces.push(`revlFtoa(${rendered})`)
      } else {
        fmt = fmt.push("%v")
        args = args.push(rendered)
        if (vt == "Str") {
          pieces = pieces.push(rendered)
        } else if (vt == "Int") {
          pieces = pieces.push(`strconv.FormatInt(${rendered}, 10)`)
        } else if (vt == "Int32") {
          pieces = pieces.push(`strconv.FormatInt(int64(${rendered}), 10)`)
        } else if (vt == "Bool") {
          pieces = pieces.push(`strconv.FormatBool(${rendered})`)
        } else {
          typed = false
        }
      }
    }
  }
  let joined = fmt.join("")
  if (args.length() == 0) { return go_string(joined) }
  if (typed) {
    if (pieces.length() == 1) { return pieces[0] }
    return `(${pieces.join(" + ")})`
  }
  return `fmt.Sprintf(${go_string(joined)}, ${args.join(", ")})`
}

// Double every `%` in interpolation text (Go verb escaping).
fn double_pct(s: Str) -> Str {
  var out = ""
  var i = 0
  while (i < s.length()) {
    let ch = s.charAt(i)
    if (ch == "%") { out = out.concat("%%") } else { out = out.concat(ch) }
    i = i + 1
  }
  return out
}

// `_go_v3_construct` (user-variant subset): an ADT construction from a case name
// and rendered args. A user variant is `<Variant><Case>{}` (nullary) or
// `<Variant><Case>{Value: arg}` (payload) — the variant name is `_v3_ident`ed and
// the case name is used RAW, exactly as the reference. The built-in Opt/Result
// constructors (`Some`/`None`/`Ok`/`Err`) pull the Opt/Result preambles this
// slice omits, so they are DEFERRED.
fn render_construct(ctx: Ctx, case: Str, args: List[Str]) -> Str {
  let adt = map_get(ctx.ca, case)
  if (resolved(adt)) {
    let struct = `${v3_ident(adt)}${case}`
    if (map_get(ctx.cp, case) == "") { return `${struct}{}` }
    return `${struct}{Value: ${args[0]}}`
  }
  return `<<DEFER-ctor:${case}>>`
}

// `_go_v3_expr` field branch: a record field access. A non-atomic receiver is
// parenthesised so the `.field` selector binds correctly; the field name is the
// EXPORTED spelling (`_v3_field_ident` = `_camel`, item 390) — the same spelling
// the struct decl and literal use, so the read resolves the exported field.
fn render_field(node: Any, ctx: Ctx) -> Str {
  let tn = value_field(node, "target")
  var target = render_expr(tn, ctx, "")
  if (!is_atomic(node_kind(tn))) { target = `(${target})` }
  return `${target}.${v3_field_ident(value_str(value_field(node, "name")))}`
}

// `_go_v3_expr` record branch: a nominal `Struct{f: v, ..}` literal. Go copies by
// value, so there is no clone (unlike the rust tier); the struct name is inferred
// from the (sorted) field set. Declared field types pin empty nested collections.
fn render_record(node: Any, ctx: Ctx) -> Str {
  let fields = value_list(value_field(node, "fields"))
  var names = []
  for (f of fields) { names = names.push(value_str(value_at(f, 0))) }
  let tn = record_type_for_fields(ctx, names)
  let raw_type = map_get(ctx.rbf, sorted_key(names))
  var body = []
  for (f of fields) {
    let k = value_str(value_at(f, 0))
    let vnode = value_at(f, 1)
    body = body.push(`${v3_field_ident(k)}: ${render_expr(vnode, ctx, map_get(ctx.rf, `${raw_type}.${k}`))}`)
  }
  return `${tn}{${body.join(", ")}}`
}

// `_go_v3_match`: a `match` over a user variant as a Go type switch wrapped in an
// IIFE (`func() T { switch _m := scrut.(type) { .. } }()`). The switch/case/body
// lines carry a LITERAL one/two-tab indent (the reference builds them with a
// fixed `\t` prefix; the enclosing `_go_v3_stmt` pads only the first `func()`
// line). A bound arm reads `_m.Value` and types the bind from its case payload; an
// unmatched `_` gets the non-exhaustive panic unless an arm already wilds. The
// built-in Opt/Result match surface pulls the deferred preambles, so it is
// DEFERRED (an `Opt[`/`Result[` scrutinee is out of corpus).
fn render_match(node: Any, ctx: Ctx, expected: Str) -> Str {
  let scrut_node = value_field(node, "scrutinee")
  let scrutinee = render_expr(scrut_node, ctx, "")
  let st = infer_type(scrut_node, ctx)
  let arms = value_list(value_field(node, "arms"))
  if ((st.startsWith("Opt[") && st.endsWith("]")) || (st.startsWith("Result[") && st.endsWith("]"))) {
    return "<<DEFER-match-builtin>>"
  }
  var exp_t = ""
  if (expected != "") { exp_t = go_type(expected) }
  if (exp_t == "") {
    var i = 0
    while (i < arms.length() && exp_t == "") {
      exp_t = go_type(infer_type(value_field(arms[i], "body"), ctx))
      i = i + 1
    }
  }
  if (exp_t == "") { exp_t = "any" }
  var lines = [`func() ${exp_t} {`]
  lines = lines.push(line(1, `switch _m := ${scrutinee}.(type) {`))
  var hasWild = false
  for (arm of arms) {
    let pattern = value_str(value_field(arm, "pattern"))
    if (pattern == "_") {
      hasWild = true
      lines = lines.push(line(1, "default:"))
      lines = lines.push(line(2, "_ = _m"))
      lines = lines.push(line(2, `return ${render_expr(value_field(arm, "body"), ctx, expected)}`))
    } else {
      var adt = st
      if (!resolved(adt)) { adt = map_get(ctx.ca, pattern) }
      lines = lines.push(line(1, `case ${v3_ident(adt)}${pattern}:`))
      let bindn = value_field(arm, "bind")
      var armctx = ctx
      if (!value_is_null(bindn) && value_str(bindn) != "") {
        let bind = value_str(bindn)
        armctx = set_vt(ctx, bind, map_get(ctx.cp, pattern))
        lines = lines.push(line(2, `${v3_ident(bind)} := _m.Value`))
        // a payload bound but never read in the arm body is a Go
        // `declared and not used` build error; pin it so an unused
        // payload compiles (roadmap item 304)
        lines = lines.push(line(2, `_ = ${v3_ident(bind)}`))
      } else {
        lines = lines.push(line(2, "_ = _m"))
      }
      lines = lines.push(line(2, `return ${render_expr(value_field(arm, "body"), armctx, expected)}`))
    }
  }
  if (!hasWild) {
    lines = lines.push(line(1, "default:"))
    lines = lines.push(line(2, "_ = _m"))
    lines = lines.push(line(2, `panic("unreachable: non-exhaustive match")`))
  }
  lines = lines.push(line(1, "}"))
  lines = lines.push("}()")
  return lines.join(newline())
}

// The kind dispatch, mirroring `_go_v3_expr`'s branch order (post-widen).
fn render_inner(node: Any, ctx: Ctx, expected: Str) -> Str {
  let kind = node_kind(node)
  if (kind == "lit") { return go_v3_lit(node) }
  if (kind == "var" || kind == "name") { return v3_ident(ref_name(node)) }
  if (kind == "adt") {
    let case = value_str(value_field(node, "case"))
    let payload = map_get(ctx.cp, case)
    var aa = []
    for (a of value_list(value_field(node, "args"))) { aa = aa.push(render_expr(a, ctx, payload)) }
    return render_construct(ctx, case, aa)
  }
  if (kind == "bin") { return render_bin(node, ctx) }
  if (kind == "un") { return render_un(node, ctx) }
  if (kind == "call") { return render_call(node, ctx) }
  if (kind == "field") { return render_field(node, ctx) }
  if (kind == "index") { return render_index(node, ctx) }
  if (kind == "record") { return render_record(node, ctx) }
  if (kind == "match") { return render_match(node, ctx, expected) }
  if (kind == "list") { return render_list(node, ctx, expected) }
  if (kind == "arrow") { return render_arrow(node, ctx) }
  if (kind == "if") {
    var expt = ""
    if (expected != "") { expt = go_type(expected) }
    else { expt = go_type(infer_type(value_field(node, "then"), ctx)) }
    if (expt == "") { expt = "any" }
    let cond = render_expr(value_field(node, "cond"), ctx, "")
    let then = render_expr(value_field(node, "then"), ctx, expected)
    let els = render_expr(value_field(node, "else"), ctx, expected)
    return `func() ${expt} { if ${cond} { return ${then} }; return ${els} }()`
  }
  if (kind == "interp") { return render_interp(node, ctx) }
  return `<<UNSUPPORTED-EXPR:${kind}>>`
}

// The `widen` coercion markers (docs/arithmetic.md): render the conversion the
// reference makes visible, then dispatch the un-widened node.
fn render_expr(node: Any, ctx: Ctx, expected: Str) -> Str {
  let w = value_str(value_field(node, "widen"))
  if (w == "Float") { return `float64(${render_inner(node, ctx, expected)})` }
  if (w == "Int") { return `int64(${render_inner(node, ctx, expected)})` }
  return render_inner(node, ctx, expected)
}

// -------------------------------------------------------------- statements
fn emit_stmts(nodes: List[Any], ctx: Ctx, indent: Int) -> Sout {
  var lines = []
  var c = ctx
  for (n of nodes) {
    let r = v3_stmt(n, c, indent)
    lines = lines.concat(r.lines)
    c = r.ctx
  }
  return { lines: lines, ctx: c }
}

// `_go_v3_stmt`: one fn-body step -> its emitted (indented) lines and threaded
// ctx. `t` is the assert receiver — the reference uses "t" in a fn body (there
// is no such binding in scope, but the byte-check holds it to the reference).
// Only the leftmost self-reference is permitted: all appended pieces, loop
// conditions and nested statements must remain independent of the accumulator.
fn concat_pieces(node: Any, name: Str) -> List[Any] {
  if (node_kind(node) == "bin" && node_op(node) == "+" &&
      node_operands(node) != "Int" && node_operands(node) != "Int32" &&
      node_operands(node) != "Float") {
    let left = value_field(node, "left")
    let right = value_field(node, "right")
    if (node_kind(left) == "var" && value_str(value_field(left, "name")) == name) { return [right] }
    let pieces = concat_pieces(left, name)
    if (pieces.length() > 0) { return pieces.push(right) }
  }
  if (node_kind(node) == "builtin" && value_str(value_field(node, "method")) == "concat") {
    let args = value_list(value_field(node, "args"))
    if (args.length() == 1) {
      let target = value_field(node, "target")
      if (node_kind(target) == "var" && value_str(value_field(target, "name")) == name) { return args }
      let pieces = concat_pieces(target, name)
      if (pieces.length() > 0) { return pieces.concat(args) }
    }
  }
  return []
}

fn builder_candidates(node: Any, ctx: Ctx) -> List[Str] {
  var names = []
  let name = value_str(value_field(node, "name"))
  if (value_str(value_field(node, "step")) == "assign" && map_get(ctx.vt, name) == "Str" &&
      concat_pieces(value_field(node, "value"), name).length() > 0) { names = names.push(name) }
  for (child of value_children(node)) { names = names.concat(builder_candidates(child, ctx)) }
  return names
}

fn builder_safe(node: Any, name: Str) -> Bool {
  let step = value_str(value_field(node, "step"))
  if (step == "return") { return false }
  if (node_kind(node) == "var" && value_str(value_field(node, "name")) == name) { return false }
  if ((step == "let" || step == "assign") && value_str(value_field(node, "name")) == name) {
    if (step == "let") { return false }
    let pieces = concat_pieces(value_field(node, "value"), name)
    if (pieces.length() == 0) { return false }
    for (piece of pieces) { if (!builder_safe(piece, name)) { return false } }
    return true
  }
  for (child of value_children(node)) { if (!builder_safe(child, name)) { return false } }
  return true
}

fn with_builders(ctx: Ctx, builders: Map[Str, Str], seq: Int) -> Ctx {
  return {
    vt: ctx.vt, fr: ctx.fr, er: ctx.er, signatures: ctx.signatures,
    ca: ctx.ca, cp: ctx.cp, rbf: ctx.rbf, rf: ctx.rf, rt: ctx.rt,
    builders: builders, builder_seq: seq,
    reserved: ctx.reserved, strings_alias: ctx.strings_alias
  }
}

fn open_builders(node: Any, ctx: Ctx, indent: Int) -> Sout {
  var c = ctx
  var out = []
  for (name of builder_candidates(value_field(node, "body"), ctx)) {
    if (map_get(c.builders, name) == "" && builder_safe(node, name)) {
      var seq = c.builder_seq
      var builder = `_revlSB${seq}`
      while (map_get(c.reserved, builder) != "") {
        seq = seq + 1
        builder = `_revlSB${seq}`
      }
      out = out.push(line(indent, `var ${builder} ${c.strings_alias}.Builder`))
      out = out.push(line(indent, `${builder}.WriteString(${v3_ident(name)})`))
      c = with_builders(c, c.builders.set(name, builder), seq + 1)
    }
  }
  return { lines: out, ctx: c }
}

fn close_builders(before: Ctx, current: Ctx, indent: Int) -> Sout {
  var out = []
  var seq = before.builder_seq
  while (seq < current.builder_seq) {
    let builder = `_revlSB${seq}`
    for (name of current.builders.keys()) {
      if (map_get(current.builders, name) == builder) {
        out = out.push(line(indent, `${v3_ident(name)} = ${builder}.String()`))
      }
    }
    seq = seq + 1
  }
  return { lines: out, ctx: with_builders(current, before.builders, current.builder_seq) }
}

fn v3_stmt(node: Any, ctx: Ctx, indent: Int) -> Sout {
  let step = node_step(node)
  if (step == "let") {
    let raw = value_str(value_field(node, "name"))
    let nm = v3_ident(raw)
    let valnode = value_field(node, "value")
    let inferred = infer_type(valnode, ctx)
    var nctx = ctx
    if (inferred != "") { nctx = set_vt(ctx, raw, inferred) }
    let value = render_expr(valnode, ctx, inferred)
    var got = ""
    if (inferred != "") { got = go_type(inferred) }
    var out = []
    var variant = false
    for (case of ctx.ca.keys()) {
      if (resolved(inferred) && map_get(ctx.ca, case) == inferred) { variant = true }
    }
    if (got == "int64" || got == "float64" || variant) {
      out = out.push(line(indent, `var ${nm} ${got} = ${value}`))
    } else {
      out = out.push(line(indent, `${nm} := ${value}`))
    }
    out = out.push(line(indent, `_ = ${nm}`))
    return { lines: out, ctx: nctx }
  }
  if (step == "assign") {
    let raw = value_str(value_field(node, "name"))
    let nm = v3_ident(raw)
    let builder = map_get(ctx.builders, raw)
    if (builder != "") {
      let pieces = concat_pieces(value_field(node, "value"), raw)
      if (pieces.length() > 0) {
        var out = []
        for (piece of pieces) { out = out.push(line(indent, `${builder}.WriteString(${render_expr(piece, ctx, "")})`)) }
        return { lines: out, ctx: ctx }
      }
    }
    let value = render_expr(value_field(node, "value"), ctx, map_get(ctx.vt, raw))
    return { lines: [line(indent, `${nm} = ${value}`)], ctx: ctx }
  }
  if (step == "return") {
    let e = value_field(node, "expr")
    if (value_is_null(e)) { return { lines: [line(indent, "return")], ctx: ctx } }
    return { lines: [line(indent, `return ${render_expr(e, ctx, ctx.rt)}`)], ctx: ctx }
  }
  if (step == "if") {
    var out = [line(indent, `if ${render_expr(value_field(node, "cond"), ctx, "")} {`)]
    let thenR = emit_stmts(value_list(value_field(node, "then")), ctx, indent + 1)
    out = out.concat(thenR.lines)
    var c = thenR.ctx
    let els = value_list(value_field(node, "else"))
    if (els.length() > 0) {
      out = out.push(line(indent, "} else {"))
      let elseR = emit_stmts(els, c, indent + 1)
      out = out.concat(elseR.lines)
      c = elseR.ctx
    }
    out = out.push(line(indent, "}"))
    return { lines: out, ctx: c }
  }
  if (step == "while") {
    let opened = open_builders(node, ctx, indent)
    var out = opened.lines.push(line(indent, `for ${render_expr(value_field(node, "cond"), opened.ctx, "")} {`))
    let bodyR = emit_stmts(value_list(value_field(node, "body")), opened.ctx, indent + 1)
    out = out.concat(bodyR.lines)
    out = out.push(line(indent, "}"))
    let closed = close_builders(ctx, bodyR.ctx, indent)
    return { lines: out.concat(closed.lines), ctx: closed.ctx }
  }
  if (step == "for") {
    let raw = value_str(value_field(node, "bind"))
    let bind = v3_ident(raw)
    let itnode = value_field(node, "iterable")
    let itt = infer_type(itnode, ctx)
    var fctx = ctx
    if (itt.startsWith("List[") && itt.endsWith("]")) {
      fctx = set_vt(ctx, raw, itt.slice(5, itt.length() - 1))
    }
    let opened = open_builders(node, fctx, indent)
    var out = opened.lines.push(line(indent, `for _, ${bind} := range ${render_expr(itnode, opened.ctx, "")} {`))
    out = out.push(line(indent + 1, `_ = ${bind}`))
    let bodyR = emit_stmts(value_list(value_field(node, "body")), opened.ctx, indent + 1)
    out = out.concat(bodyR.lines)
    out = out.push(line(indent, "}"))
    let closed = close_builders(fctx, bodyR.ctx, indent)
    return { lines: out.concat(closed.lines), ctx: closed.ctx }
  }
  if (step == "expr") {
    return { lines: [line(indent, `_ = ${render_expr(value_field(node, "expr"), ctx, "")}`)], ctx: ctx }
  }
  if (step == "assert") {
    let expr = render_expr(value_field(node, "expr"), ctx, "")
    var out = [line(indent, `if !(${expr}) {`)]
    out = out.push(line(indent + 1, `t.Fatalf("assertion failed: %s", ${go_string(expr)})`))
    out = out.push(line(indent, "}"))
    return { lines: out, ctx: ctx }
  }
  // item 379 / 391: bare loop control -> the host keyword (frame-neutral).
  if (step == "break") { return { lines: [line(indent, "break")], ctx: ctx } }
  if (step == "continue") { return { lines: [line(indent, "continue")], ctx: ctx } }
  return { lines: [line(indent, `<<UNSUPPORTED-STEP:${step}>>`)], ctx: ctx }
}

// `_emit_v3_go_types`: user `type` decls as Go items. A record is a `struct`
// whose fields are EXPORTED + json-tagged (item 390: `_v3_field_ident` = camel,
// plus `json:"<source>"` — `encoding/json` ignores unexported fields, so this is
// what makes `json_stringify(record)` non-empty and byte-identical to py/ts); a
// variant is a sealed interface (`isX()` seal) plus one struct per case (nullary
// `struct{}`, payload `struct { Value T }`) with the seal method. Each decl is
// followed by a blank line, exactly as the reference does.
fn emit_v3_types(types: Any) -> List[Str] {
  var out = []
  for (name of value_keys(types)) {
    let spec = value_field(types, name)
    let kind = value_str(value_field(spec, "kind"))
    let gname = v3_ident(name)
    if (kind == "record") {
      out = out.push(`type ${gname} struct {`)
      let fields = value_field(spec, "fields")
      for (field of value_keys(fields)) {
        out = out.push(line(1, `${v3_field_ident(field)} ${go_type(value_field(fields, field))} ${json_tag(field)}`))
      }
      out = out.push("}")
      out = out.push("")
    } else {
      if (kind == "variant") {
        let marker = `is${gname}`
        out = out.push(`// ${gname} is a sealed sum type (revl ADT); ${marker}() seals it.`)
        out = out.push(`type ${gname} interface { ${marker}() }`)
        for (case of value_list(value_field(spec, "cases"))) {
          let cname = value_str(value_field(case, "name"))
          let cstruct = `${gname}${cname}`
          let payload = value_field(case, "payload")
          if (value_is_null(payload)) { out = out.push(`type ${cstruct} struct{}`) }
          else { out = out.push(`type ${cstruct} struct { Value ${go_type(payload)} }`) }
          out = out.push(`func (${cstruct}) ${marker}() {}`)
        }
        out = out.push("")
      } else {
        out = out.push(`<<UNSUPPORTED-TYPE:${kind}>>`)
      }
    }
  }
  return out
}

// `_emit_v3_go_externs`: each extern as a Go `func` carrying its verbatim `@go`
// body, blank-line separated, in declaration order and BEFORE the free functions.
//
// item 421 F6 (ported per item 429(d)): an extern whose DECLARED return was
// `Secret[T]` is the ORIGIN end of a declared marking — where a confidential
// value enters the value world. `taint.py` strips the `Secret[...]` qualifier
// before lowering, so `secret_return` is the only surviving record of it. The
// verbatim `@go` body owns its own `return` statements, so it moves into an
// inner `revlSecret_<name>` and the DECLARED name becomes a one-line
// `revlSecretResult(..)` wrapper: every call site is covered without the body
// being rewritten. Emitted only for an extern that carries the stamp, so every
// other extern is byte-identical to the plain form.
//
// Three reference shapes are OUT of this slice and emit a loud marker rather
// than a guess, so a fixture that reaches one diverges visibly instead of
// shipping wrong Go: an extern with no `@go` body (the reference RAISES — a
// portability boundary), an extern carrying a `config` schema (the reference
// prepends the config scaffold and binds `_revl_config` as the first body line),
// and a body carrying a `//revl:import` directive (hoisted to the module import
// block, which is assembled in `emit_src` above these lines). The body splice
// itself is LF-only: the reference splits with Python `splitlines()`, which also
// breaks on CR and on the Unicode separators, so a body carrying one of those
// takes the marker too rather than splitting differently.
// Every code point Python `str.splitlines()` breaks on that a plain
// `split("\n")` does not: VT, FF, CR, the three file/group/record separators,
// NEL, and the two Unicode line/paragraph separators.
fn is_extra_linebreak(code: Int) -> Bool {
  if (code >= 11 && code <= 13) { return true }
  if (code >= 28 && code <= 30) { return true }
  if (code == 133) { return true }
  return code == 8232 || code == 8233
}

fn has_extra_linebreak(s: Str) -> Bool {
  let n = s.length()
  var i = 0
  while (i < n) {
    if (is_extra_linebreak(s.charCodeAt(i))) { return true }
    i = i + 1
  }
  return false
}

fn extern_body_defer(ext: Any, body: Str) -> Str {
  if (!value_is_null(value_field(ext, "config"))) { return "config" }
  if (body.indexOf("//revl:import") >= 0) { return "import" }
  if (has_extra_linebreak(body)) { return "linebreak" }
  return ""
}

fn emit_externs(externs: List[Any]) -> List[Str] {
  var out = []
  for (ext of externs) {
    let raw_name = value_str(value_field(ext, "name"))
    var name = v3_ident(raw_name)
    var ps = []
    var args = []
    for (p of value_list(value_field(ext, "params"))) {
      let pname = v3_ident(value_str(value_field(p, "name")))
      ps = ps.push(`${pname} ${go_type(value_field(p, "type"))}`)
      args = args.push(pname)
    }
    let params = ps.join(", ")
    let arg_list = args.join(", ")
    let ret = go_type(value_field(ext, "returns"))
    var sigret = ""
    if (ret != "") { sigret = " ".concat(ret) }
    let bodies = value_field(ext, "bodies")
    let go_body = value_field(bodies, "go")
    if (value_is_null(go_body)) {
      out = out.push(`<<EXTERN-NO-GO-BODY:${name}>>`)
      out = out.push("")
    } else {
      let body = trim(value_str(go_body))
      let defer = extern_body_defer(ext, body)
      if (defer != "") {
        out = out.push(`<<DEFER-EXTERN-${defer}:${name}>>`)
        out = out.push("")
      } else {
        // The wrapper needs a result to hand back, so a `Unit` extern takes no
        // marking (the reference gates on `ret` too).
        if (value_bool(value_field(ext, "secret_return")) && ret != "") {
          out = out.push(`func ${name}(${params})${sigret} {`)
          out = out.push(line(1, `return revlSecretResult(revlSecret_${name}(${arg_list}))`))
          out = out.push("}")
          out = out.push("")
          name = "revlSecret_".concat(name)
        }
        out = out.push(`func ${name}(${params})${sigret} {`)
        if (body == "") {
          out = out.push(line(1, "// (empty extern body)"))
        } else {
          for (bl of body.split(newline())) { out = out.push(tab().concat(rstrip(bl))) }
        }
        out = out.push("}")
        out = out.push("")
      }
    }
  }
  return out
}

// `_emit_v3_go_functions`: each module fn as a Go `func`, blank-line separated.
fn emit_functions(functions: List[Any], fr: Map[Str, Str], er: Map[Str, Str], t: TypeTables, signatures: List[Any], strings_alias: Str) -> Fout {
  var out = []
  var uses_strings = false
  for (fnode of functions) {
    let name = v3_ident(value_str(value_field(fnode, "name")))
    let params = value_list(value_field(fnode, "params"))
    var vt: Map[Str, Str] = Map.empty()
    for (p of params) { vt = vt.set(value_str(value_field(p, "name")), value_str(value_field(p, "type"))) }
    let rt = value_str(value_field(fnode, "returns"))
    let reserved = collect_reserved(fnode, Map.empty())
    let ctx = { vt: vt, fr: fr, er: er, signatures: signatures, ca: t.ca, cp: t.cp, rbf: t.rbf, rf: t.rf, rt: rt, builders: Map.empty(), builder_seq: 0, reserved: reserved, strings_alias: strings_alias }
    var ps = []
    for (p of params) {
      ps = ps.push(`${v3_ident(value_str(value_field(p, "name")))} ${go_type(value_field(p, "type"))}`)
    }
    let ret = go_type(value_field(fnode, "returns"))
    var sigret = ""
    if (ret != "") { sigret = " ".concat(ret) }
    out = out.push(`func ${name}(${ps.join(", ")})${sigret} {`)
    let r = emit_stmts(value_list(value_field(fnode, "body")), ctx, 1)
    if (r.ctx.builder_seq > 0) { uses_strings = true }
    out = out.concat(r.lines)
    out = out.push("}")
    out = out.push("")
  }
  return { lines: out, uses_strings: uses_strings }
}

// ------------------------------------------------------------- feature flags
// Which runtime preambles the pure path prepends is a deterministic function of
// the IR: the reference sets each flag while RENDERING a node, and every node in
// a function body (arrow bodies included) is rendered, so a structural pass over
// the IR sees exactly the same set. `_go_string`-escaping and type spellings set
// no flag; only these do, in-slice. The `fmt`/`strconv` IMPORT flags are NOT
// here: since item 434 (f) an interpolation picks between them from the operand
// types it infers as it renders, so `emit_src` reads them off the rendered
// lines instead of re-deriving that inference structurally.
type Flags = { fdiv: Bool, ovf: Bool, ovf32: Bool }

fn flags_or(a: Flags, b: Flags) -> Flags {
  return { fdiv: a.fdiv || b.fdiv, ovf: a.ovf || b.ovf, ovf32: a.ovf32 || b.ovf32 }
}

fn flag_walk(node: Any, acc: Flags) -> Flags {
  var f = acc
  if (value_kind(node) == "record") {
    let k = node_kind(node)
    if (k == "bin") {
      let op = node_op(node)
      let opnd = node_operands(node)
      if (op == "/") { f = { fdiv: true, ovf: f.ovf, ovf32: f.ovf32 } }
      if (is_addsubmul(op) && opnd == "Int") { f = { fdiv: f.fdiv, ovf: true, ovf32: f.ovf32 } }
      if (is_addsubmul(op) && opnd == "Int32") { f = { fdiv: f.fdiv, ovf: f.ovf, ovf32: true } }
    }
    if (k == "un" && node_op(node) == "-") {
      let opnd = node_operands(node)
      if (opnd == "Int") { f = { fdiv: f.fdiv, ovf: true, ovf32: f.ovf32 } }
      if (opnd == "Int32") { f = { fdiv: f.fdiv, ovf: f.ovf, ovf32: true } }
    }
  }
  for (c of value_children(node)) { f = flag_walk(c, f) }
  return f
}

fn collect_flags(functions: List[Any]) -> Flags {
  var f = { fdiv: false, ovf: false, ovf32: false }
  for (fnode of functions) { f = flag_walk(fnode, f) }
  return f
}

// ------------------------------------------------------------- runtime preambles
// The trapping Int arithmetic trio (docs/arithmetic.md): Go has no checked
// arithmetic, so the helpers detect overflow. Built line-by-line to match the
// reference's `out.append(...)` sequence byte-for-byte.
fn overflow_preamble() -> List[Str] {
  var o = []
  o = o.push("func revlAdd(a, b int64) int64 {")
  o = o.push(line(1, "s := a + b"))
  o = o.push(line(1, "if (a > 0 && b > 0 && s < 0) || (a < 0 && b < 0 && s >= 0) {"))
  o = o.push(line(2, `panic("revl: Int overflow")`))
  o = o.push(line(1, "}"))
  o = o.push(line(1, "return s"))
  o = o.push("}")
  o = o.push("")
  o = o.push("func revlSub(a, b int64) int64 {")
  o = o.push(line(1, "d := a - b"))
  o = o.push(line(1, "if (b < 0 && d < a) || (b > 0 && d > a) {"))
  o = o.push(line(2, `panic("revl: Int overflow")`))
  o = o.push(line(1, "}"))
  o = o.push(line(1, "return d"))
  o = o.push("}")
  o = o.push("")
  o = o.push("func revlMul(a, b int64) int64 {")
  o = o.push(line(1, "if a == 0 || b == 0 {"))
  o = o.push(line(2, "return 0"))
  o = o.push(line(1, "}"))
  o = o.push(line(1, "p := a * b"))
  o = o.push(line(1, "if p/b != a {"))
  o = o.push(line(2, `panic("revl: Int overflow")`))
  o = o.push(line(1, "}"))
  o = o.push(line(1, "return p"))
  o = o.push("}")
  o = o.push("")
  return o
}

// The Int32 trap block: each op is computed in int64 and range-checked before
// narrowing (Go's int32 wraps). Mirrors the reference append sequence.
fn overflow32_preamble() -> List[Str] {
  var o = []
  o = o.push("func revlAddI32(a, b int32) int32 { return revlToI32(int64(a) + int64(b)) }")
  o = o.push("func revlSubI32(a, b int32) int32 { return revlToI32(int64(a) - int64(b)) }")
  o = o.push("func revlMulI32(a, b int32) int32 { return revlToI32(int64(a) * int64(b)) }")
  o = o.push("func revlToI32(v int64) int32 {")
  o = o.push(line(1, "if v < -2147483648 || v > 2147483647 {"))
  o = o.push(line(2, `panic("revl: Int32 overflow")`))
  o = o.push(line(1, "}"))
  o = o.push(line(1, "return int32(v)"))
  o = o.push("}")
  o = o.push("")
  return o
}

// The document assembly for a FUNCTION-ONLY v3 document (`_emit_v3_go`, subset):
// the banner + package, the conditional import block, the feature preambles in
// the reference's fixed order (revlDiv, then the overflow trio, then the Int32
// block), then the free functions — joined, right-stripped, one trailing `\n`.
pub fn emit_src(ir: Any) -> Str {
  let types = value_field(ir, "types")
  let tables = build_type_tables(types)
  let functions = value_list(value_field(ir, "functions"))
  var fr: Map[Str, Str] = Map.empty()
  var er: Map[Str, Str] = Map.empty()
  for (fnode of functions) {
    let r = value_field(fnode, "returns")
    if (!value_is_null(r)) { fr = fr.set(value_str(value_field(fnode, "name")), value_str(r)) }
  }
  // `ctx.extern_ret` on the reference: an extern's declared return is the
  // callee type a `let` binding infers from, exactly as a module fn's is.
  let externs = value_list(value_field(ir, "externs"))
  for (enode of externs) {
    let er_ret = value_field(enode, "returns")
    if (!value_is_null(er_ret)) { er = er.set(value_str(value_field(enode, "name")), value_str(er_ret)) }
  }
  let flags = collect_flags(functions)
  // The reference renders every body BEFORE assembling the import block, so a
  // flag a lowering only sets while rendering has settled by then. The `fmt`
  // and `strconv` imports are exactly that: which one an interpolation needs
  // depends on the operand types `render_interp` infers as it renders (item
  // 434 (f)), so read them off the rendered lines rather than re-deriving the
  // inference in the structural `collect_flags` pass.
  var module_reserved = collect_reserved(types, Map.empty())
  module_reserved = collect_reserved(functions, module_reserved)
  module_reserved = collect_reserved(externs, module_reserved)
  var strings_alias = "strings"
  if (map_get(module_reserved, strings_alias) != "") {
    strings_alias = fresh_ident("_revlStrings", module_reserved)
  }
  let emitted_functions = emit_functions(functions, fr, er, tables, functions.concat(externs), strings_alias)
  let fnlines = emitted_functions.lines
  let rendered = fnlines.join(newline())
  let uses_fmt = rendered.indexOf("fmt.Sprintf(") >= 0
  let uses_strconv = rendered.indexOf("strconv.Format") >= 0
  let uses_strings = emitted_functions.uses_strings

  var out = []
  out = out.push("// Code generated by backends/go/emit.py — DO NOT EDIT.")
  out = out.push("// revl -> cordis-go (ir_version 3, pure typed-core tier): ordinary Go.")
  out = out.push("package emitted")
  out = out.push("")

  if (uses_fmt || uses_strconv || uses_strings) {
    out = out.push("import (")
    // `sorted(set(imports))` on the reference: "fmt" sorts before "strconv".
    if (uses_fmt) { out = out.push(line(1, `"fmt"`)) }
    if (uses_strconv) { out = out.push(line(1, `"strconv"`)) }
    if (uses_strings) {
      if (strings_alias == "strings") { out = out.push(line(1, `"strings"`)) }
      else { out = out.push(line(1, `${strings_alias} "strings"`)) }
    }
    out = out.push(")")
    out = out.push("")
  }
  if (flags.fdiv) {
    out = out.push("func revlDiv(a, b float64) float64 { return a / b }")
    out = out.push("")
  }
  if (flags.ovf) { out = out.concat(overflow_preamble()) }
  if (flags.ovf32) { out = out.concat(overflow32_preamble()) }

  // The reference's section order: user `type` items precede the free functions
  // (both after the header + feature preambles).
  if (value_keys(types).length() > 0) { out = out.concat(emit_v3_types(types)) }
  // The reference's section order: types, then externs, then the free functions.
  if (externs.length() > 0) { out = out.concat(emit_externs(externs)) }
  out = out.concat(fnlines)
  return rstrip(out.join(newline())).concat(newline())
}

// ---------------------------------------------------------------- in-file tests
test "go_type covers the scalar and generic surface" {
  assert go_type("Int") == "int64"
  assert go_type("Str") == "string"
  assert go_type("Bool") == "bool"
  assert go_type("List[Int]") == "[]int64"
  assert go_type("Map[Str, Int]") == "map[string]int64"
  assert go_type("Opt[Str]") == "RevlOpt[string]"
}

test "bin-op table maps the longest revl ops" {
  assert go_bin_op("===") == "=="
  assert go_bin_op("!==") == "!="
  assert go_bin_op("&&") == "&&"
  assert go_bin_op("||") == "||"
  assert is_addsubmul("+")
  assert is_scalar("Int")
}

test "indentation is one tab per level" {
  assert ind(0) == ""
  assert ind(2).length() == 2
  assert line(0, "x") == "x"
  assert is_go_reserved("type")
  assert v3_ident("type") == "type_"
  // injective: `type` and the equally legal revl identifier `type_` must not
  // both land on `type_`, so the ladder shifts up a rung
  assert v3_ident("type_") == "type__"
  assert v3_ident("type__") == "type___"
  assert v3_ident("use_add") == "use_add"
  assert v3_ident("total_") == "total_"
}

test "sorted_key canonicalises a record's field set by code point" {
  assert sorted_key(["y", "x"]) == "x,y"
  assert sorted_key(["label", "at"]) == "at,label"
  assert sorted_key(["x"]) == "x"
}

fn typed_ctx() -> Ctx {
  var ca: Map[Str, Str] = Map.empty()
  var cp: Map[Str, Str] = Map.empty()
  var rbf: Map[Str, Str] = Map.empty()
  ca = ca.set("Leaf", "Tree")
  cp = cp.set("Leaf", "")
  ca = ca.set("Node", "Tree")
  cp = cp.set("Node", "Int")
  rbf = rbf.set("x,y", "Point")
  return {
    vt: Map.empty(), fr: Map.empty(), er: Map.empty(),
    ca: ca, cp: cp, rbf: rbf, rf: Map.empty(), rt: "", signatures: [],
    builders: Map.empty(), builder_seq: 0,
    reserved: Map.empty(), strings_alias: "strings"
  }
}

test "render_construct lowers user variants (nullary + payload)" {
  let ctx = typed_ctx()
  assert render_construct(ctx, "Leaf", []) == "TreeLeaf{}"
  assert render_construct(ctx, "Node", ["v"]) == "TreeNode{Value: v}"
  // a built-in Opt/Result ctor is deferred (pulls the omitted preambles)
  assert render_construct(ctx, "Some", ["v"]) == "<<DEFER-ctor:Some>>"
}

test "record_type_for_fields infers a nominal struct from its field set" {
  let ctx = typed_ctx()
  assert record_type_for_fields(ctx, ["x", "y"]) == "Point"
  assert record_type_for_fields(ctx, ["y", "x"]) == "Point"
  assert record_type_for_fields(ctx, ["q"]) == "<<DEFER-record>>"
}

test "a declared Secret[T] extern return wraps its verbatim body" {
  // item 421 F6 / 429(d). The stamped extern splits into an exported one-line
  // `revlSecretResult` wrapper and the inner `revlSecret_<name>` holding the
  // verbatim body; an unstamped one is the plain single function. The
  // end-to-end byte check lives in the corpus.
  let plain = emit_externs([{ name: "tag", params: [], returns: "Str",
                              bodies: { go: `return "n"` } }])
  assert plain.join("|") == `func tag() string {|${str_tab()}return "n"|}|`
  let marked = emit_externs([{ name: "mint", params: [], returns: "Str",
                               secret_return: true, bodies: { go: `return "s"` } }])
  assert marked[0] == "func mint() string {"
  assert marked[1] == str_tab().concat("return revlSecretResult(revlSecret_mint())")
  assert marked[4] == "func revlSecret_mint() string {"
}

test "a body Python splitlines would break differently takes a marker" {
  // `split(newline())` and `splitlines()` agree only on LF; VT/FF/CR, the
  // file/group/record separators, NEL and U+2028/U+2029 all break the second.
  assert has_extra_linebreak(str_tab().concat("ok")) == false
  assert is_extra_linebreak(10) == false
  assert is_extra_linebreak(11) && is_extra_linebreak(12) && is_extra_linebreak(13)
  assert is_extra_linebreak(8232) && is_extra_linebreak(133)
}

test "go_type passes user record/variant names through" {
  assert go_type("Point") == "Point"
  assert go_type("List[Point]") == "[]Point"
  assert go_type("Opt[Point]") == "RevlOpt[Point]"
}

// --------------------------------------------------------------- component wrap
// A trivial provider so the emitted module is a valid plugin (the pure
// `emit_src` above is what the cross-check exercises); mirrors the wrapper the
// other self-host stages carry. `render` avoids the `emit` keyword.
service EmitStream {
  fn render(ir: Any) -> Str
}

component EmitGo provides emitter: EmitStream {
  provide emitter {
    fn render(ir) = emit_src(ir)
  }
}
