// THE CAPSTONE — the integrated, FULLY-NATIVE `revl_compile`, in revl (roadmap
// item 230, extending 224). Where the lexer/parser/checker/lower stages each port
// ONE compiler pass and the emit_* stages port the tail, THIS file is the driver
// that composes the self-host stages into ONE co-compiled revl pipeline: it runs
// the native FRONTEND over source, PRODUCES the native interchange IR, and hands
// that IR to the native EMITTER — target source built by revl, from source, in a
// single in-file composition with NO reference anywhere in the chain (for the
// function surface; see WHAT IS NATIVE for the exact boundary).
//
// ============================================================ THE PIPELINE
//   source ──▶ admit_src (lower.rvl)          the native FRONTEND admission gate:
//                                             lexer.rvl → parser.rvl → the checker
//                                             → the lowering ADMISSION gate. "" ad-
//                                             mits; "<TAG>|<message>" refuses. The
//                                             one revl promise — a program the
//                                             checker rejects cannot be compiled —
//                                             is enforced HERE, before any emitter.
//          ──▶ lower_to_ir (lower.rvl)        the native IR PRODUCER (item 232):
//                                             source → the emittable interchange IR
//                                             (JSON), byte-exact vs the reference
//                                             lowering for the module-FUNCTION +
//                                             TYPE surface, and emitter-ready.
//          ──▶ json_parse (stdlib/json.rvl)   the JSON text → the `Any` value the
//                                             emitters navigate (stdlib/value.rvl).
//          ──▶ emit_py_src / emit_rust_src /   the native EMITTER, dispatched on
//              emit_ts_src                    tier: IR → target source, byte-exact
//              (emit_py.rvl / emit_rust.rvl / vs the reference emitter.
//               emit_ts.rvl)
//
// The WHOLE chain lex→parse→check→lower→emit is native revl, co-compiled into one
// artifact: `compile.rvl` `use`s lower.rvl (which `use`s lexer+parser), emit_py.rvl,
// emit_rust.rvl AND emit_ts.rvl in ONE composition. This is what items 228 + 230
// unlocked — 228 stopped a `use`d module's PRIVATE decls from leaking (so the four
// stages' private `Ctx`/`node_kind`/… no longer collide), and 230 gave the emitter
// entrypoints DISTINCT public names (`emit_py_src` / `emit_rust_src`, and now
// `emit_ts_src`) so the merge, which flattens public decls by bare name, no longer
// sees a duplicate `emit_src`. Item 146 gap 2 wires the ts tier the same way: the
// rename is the whole cost of admitting a tier, since the three surviving emitters
// (go/java/wasm) still export a bare `emit_src` and so still cannot co-compile.
// Both former SEAMs (224's header: the reference IR in the middle; the stages not
// co-compiling) are now CLOSED for the function surface.
//
// ============================================================ WHAT IS NATIVE
// FULLY NATIVE — no reference in the chain — for the module-FUNCTION + TYPE
// surface: every module `fn` (its full typed-expression body) and every user
// `type` (record/variant). `compile_to(source, "py")` over this surface equals the
// reference `revl compile --backend py` BYTE-FOR-BYTE, produced entirely in revl
// (lower_to_ir + emit_py_src, both native); same for rust where the rust emitter
// covers the form. Proven in tests/test_selfhost_compile.py.
//
// FULLY NATIVE too — the typed COMPONENT + extern surface (item 262). Items 242 +
// 241 made the native IR producer COMPLETE: the full typed component/method body
// (effect/undo, emit/compensate sagas, if+fail guards, timers, config reads,
// provide-method bodies) and the verbatim `@backend` extern bodies now lower byte-
// exact, and each tier's native emitter covers the form. So `compile_to` over a
// component program equals the reference compile BYTE-FOR-BYTE for both tiers, end
// to end in revl — the services/types/externs/functions sections carry through
// json_parse into the native emitter with no reference anywhere. That was the last
// seam; the covered surface is now entirely self-compiled.
//
// ALSO NATIVE — the ts tier (roadmap item 146, gap 2). `emit_ts.rvl` is renamed to
// `emit_ts_src` and dispatched here, so `compile_to(source, "ts")` runs the same
// fully-native chain and equals `revl compile --backend ts` BYTE-FOR-BYTE over the
// fifteen emit_ts corpus documents listed in tests/test_selfhost_compile.py — eight
// function documents and seven component ones, the ir_version-1 dispatch included.
// The ts emitter is byte-exact on ALL 34 of its own corpus documents, but that
// oracle feeds it the REFERENCE IR; the remaining nineteen are held out here
// because the NATIVE `lower_to_ir` — not the emitter — does not yet reproduce them:
//   * ASYNC is not carried at all (an async extern/fn lowers without its `async`
//     stamp, so the native emit says `export function f(): T` where the reference
//     says `export async function f(): Promise<T>`);
//   * the realm/`intercept` metadata and the `spawn`/`Frame`/`record` runtime-import
//     gates are not reproduced.
// Those are lower.rvl gaps shared by every tier, not ts ones.
//
// NOT NATIVE, ON ANY TIER — the declared `Secret[T]` marking (found while wiring ts;
// see tests/test_selfhost_compile.py's strict-xfail pin for the full write-up).
// `src/revl/taint.py` strips the qualifier and sets the three stamps every backend
// redacts from; the self-host frontend has no counterpart (zero occurrences of
// "secret" in lexer/parser/checker/lower.rvl). So a program declaring `Secret[T]`
// compiles natively to a module MISSING its whole marking on py and on ts alike,
// even though both native EMITTERS were ported and are byte-exact on their own
// `secrets.rvl` corpus document when fed the reference IR. Pre-existing, not
// ts-specific, and stated here rather than left to be rediscovered.
//
// Ground truth is the reference; on the covered surface any divergence is a defect
// in a stage.

// One line: the self-host program grammar reads a `use` by its first line.
use "./lower.rvl" { admit_src, admit_ambient, lower_to_ir, lower_to_ir_refs, parse_prog, parse_refusal }
use "./lexer.rvl" { Token, lex_src }
use "./emit_py.rvl" { emit_py_src }
use "./emit_rust.rvl" { emit_rust_src }
use "./emit_ts.rvl" { emit_ts_src }
use "./emit_go.rvl" { emit_go_src }
use "./emit_java.rvl" { emit_java_src }
use "./emit_wasm.rvl" { emit_wasm_src }
use "../stdlib/json.rvl" { json_parse }
use "../stdlib/str.rvl" { str_newline, str_tab }

// The tiers whose self-host emitter is byte-exact against its reference on this
// surface AND whose entrypoint has a distinct public name, so it can co-compile
// here. As of this slice that is ALL SIX: the three remaining bare `emit_src`
// entrypoints (go/java/wasm) were renamed to `emit_go_src`/`emit_java_src`/
// `emit_wasm_src`, which was the whole cost of admitting a tier. An unknown tier
// is still reported, never silently waved through as if the pipeline covered it.
fn supported_tier(tier: Str) -> Bool {
  if ((tier == "py") || (tier == "rust")) { return true }
  if ((tier == "ts") || (tier == "go")) { return true }
  return (tier == "java") || (tier == "wasm")
}

// The native FRONTEND admission gate: the cordis verdict over the source, run
// entirely in revl (lower.rvl's `admit_src` drives lexer.rvl, parser.rvl, the
// checker and the lowering admission). "" admits; "<TAG>|<message>" refuses.
pub fn admit(source: Str) -> Str {
  return admit_src(source)
}

// The integrated, FULLY-NATIVE driver — the capstone entry point. For a supported,
// admitted program it runs the WHOLE native chain in this one co-compiled file and
// returns the TARGET SOURCE:
//   * an unsupported tier   -> "UNKNOWN_TIER|<tier>";
//   * a program the native  -> "REFUSED|<TAG>|<message>" (the native gate's own
//     gate refuses              verdict; the IR producer and emitter never run —
//                               a rejected program cannot be compiled, the one
//                               revl promise, enforced natively);
//   * a `use` the native    -> "REFUSED|LINK|<message>" (`compile_to_at` only,
//     link cannot reproduce     issue #2181: the producer has run, the emitter
//                               never does, so no source that differs from the
//                               reference is returned);
//   * an admitted program   -> the emitted target source, built end to end in revl:
//                               lower_to_ir(source) → json_parse → emit_<tier>_src.
//                               NO reference is in this chain. Byte-exact with the
//                               reference compile for the function + type surface AND
//                               the component + extern surface (item 262; see WHAT IS
//                               NATIVE).
// A control verdict ("UNKNOWN_TIER|"/"REFUSED|") never collides with target source:
// the emitted py source begins `"""Generated by the revl cordis-py backend …`, the
// rust source `//! Generated by the revl cordis-rs backend …`, and the ts source

// The native EMITTER tail, factored out so the standalone and the against-a-
// manifest drivers share ONE dispatch: interchange IR → target source for the
// tier. Callers admit FIRST (a rejected program cannot be compiled); this runs
// only on an admitted program.
fn emit_ir(ir: Any, tier: Str) -> Str {
  if (tier == "py") { return emit_py_src(ir) }
  if (tier == "ts") { return emit_ts_src(ir) }
  if (tier == "go") { return emit_go_src(ir) }
  if (tier == "java") { return emit_java_src(ir) }
  if (tier == "wasm") { return emit_wasm_src(ir) }
  return emit_rust_src(ir)
}

// ================================================= dropped-shape refusal tail
// Issue #2446. An emitter with no channel to raise still says which shape it
// cannot render, with a `<<UNSUPPORTED-...>>` marker. For the markers below the
// marker is not a missing DETAIL: the emitter answers without the component, or
// without the whole live tier's body: a successful result whose bytes differ
// from the reference and from which a caller cannot tell that code was
// dropped. The self-host rule allows a loud NAMED refusal there, so the driver
// turns exactly those markers into `REFUSED|UNSUPPORTED|...` and the caller
// never sees a partial program as success.
//
// Only whole-shape drops are listed. A marker that names one deferred SECTION
// beside emitted code (a test driver, a host stub, a namespaced key) keeps its
// in-bytes marker: that is the convention `tools/selfhost_differential_survey.py`
// reads as a port refusal, and the emitted program is otherwise the reference's.
// `<<UNSUPPORTED-COMPONENT:parallel-emit>>` is one such SECTION marker (the py
// porter's fan-out statement), not a dropped component, so it is excluded by
// its payload. The chosen marker is the EARLIEST in the output, which is the
// first shape the emitter could not render.
fn marker_from(out: Str, p: Str, from: Int) -> Int {
  let rest = out.slice(from, out.length())
  let k = rest.indexOf(p)
  return k < 0 ? 0 - 1 : from + k
}

fn dropped_shape_marker(out: Str) -> Str {
  var best = ""
  var bestat = 0 - 1
  for (p of ["<<UNSUPPORTED-LIVE-TIER:", "<<UNSUPPORTED-COMPONENT:",
             "<<UNSUPPORTED-component-nonsimple:"]) {
    var at = marker_from(out, p, 0)
    while (at >= 0) {
      let rest = out.slice(at, out.length())
      let close = rest.indexOf(">>")
      let mark = close < 0 ? p : rest.slice(0, close + 2)
      if ((mark != "<<UNSUPPORTED-COMPONENT:parallel-emit>>")
          && ((bestat < 0) || (at < bestat))) {
        best = mark
        bestat = at
      }
      at = marker_from(out, p, at + 1)
    }
  }
  return best
}

fn dropped_shape_refusal(out: Str, tier: Str) -> Str {
  let mark = dropped_shape_marker(out)
  if (mark == "") { return "" }
  return "UNSUPPORTED|".concat(mark)
    .concat(" is not supported by the self-host compiler on `").concat(tier)
    .concat("`: the emitter drops that component (or the document's live ")
    .concat("tier) and would return a program that differs from the reference's.")
}

// ============================================================ use resolution
// Issue #2093. The driver above resolved no `use`: it handed `lower_to_ir` the
// ONE document text it was given, so a document that imports a component from a
// SIBLING module — `src/revl/truc/components/cli.rvl`'s
// `use "assembler.rvl" { Assembler }` / `use "shipper.rvl" { Shipper }` — lowered
// without those modules' service rows. The reference composes the FILE SET and
// carries each DIRECT import's row into the document's `services` table; the
// native chain carried only the document's own. That is a HARNESS/API limitation,
// not a `lower.rvl` one: the IR producer is handed one string and cannot know a
// module set exists. So the driver grows a PATH — `compile_to_at(source, tier,
// path)` resolves the document's `use` targets through `module_path` and
// `read_module_text` (the first host crossing: a READ, no accounted mutation,
// the boundary `stdlib/auth.rvl`'s `host_validate` draws) and APPENDS each
// imported name's service row, in declaration order, after the document's own.
// `compile_to` keeps its exact two-argument behavior: with no document path there
// is nothing to resolve a relative `use` against, so it is the identity on the IR.
//
// Issue #2181. Service rows were half of it. The reference's `compile_files`
// also merges every module whose PURE declarations the document imports (a
// `pub fn`, `type` or `extern` named in a `use` list, transitively), and appends
// each such module's WHOLE `extern` section to the merged program, so
// `use "stdlib/json.rvl" { json_parse, json_stringify }` carries `json_try_parse`
// too. `ul_link_externs` does the same after the service rows are in.

// The FIRST host crossing of this driver: find, then read, the module a `use`
// names. `base` is the importing document's path ("" when the caller had none),
// `target` the literal `use` target. Resolution follows the reference loader
// (`compiler.py::resolve_use`): the target relative to the importing document's
// directory, then each search-path entry in order, `REVL_IMPORT_PATH` and then
// the parent of the toolchain's `stdlib/`, which is how `cli.rvl`'s sibling
// imports and a fixture's `stdlib/json.rvl` resolve. The first candidate that
// exists wins. Issue #2363: nothing walks up through the document's ancestors,
// since the reference never does and a module found that way is one it refuses
// as "cannot find imported module". The answer is the module's ABSOLUTE path
// (the reference loader's module key, `os.path.abspath`, so two spellings of
// one module are one module and the closure below sorts exactly as
// `compile_files` does), or "" when nothing is there. `ad_used_modules_refusal`
// refuses such a `use` by the reference's message before anything is linked.
extern pure fn module_path(base: Str, target: Str) -> Str = @py {
    import os
    if base == "" or target == "":
        return ""
    roots = [os.path.dirname(os.path.abspath(base))]
    for entry in os.environ.get("REVL_IMPORT_PATH", "").split(os.pathsep):
        entry = entry.strip()
        if entry:
            roots.append(entry)
    try:
        from revl._paths import stdlib_root
        roots.append(str(stdlib_root().parent))
    except ImportError:
        pass
    for root in roots:
        cand = os.path.join(root, target)
        if os.path.exists(cand):
            return os.path.abspath(cand)
    return ""
}

// The text of the module `module_path` resolved, or "" for the "" path.
extern pure fn read_module_text(path: Str) -> Str = @py {
    if path == "":
        return ""
    with open(path, "r", encoding="utf-8") as fh:
        return fh.read()
}

// Issue #2089: the SECOND host crossing, and the reason the first one cannot
// double for it. An extern's `= @backend ref SYM from "PATH"` arm lowers to the
// IR's `refs` — `{symbol, path, sha256[, root]}` — and NONE of those three
// values is in the text: `path` is the target's path relative to the root it
// jails to, `sha256` is a digest of the target's BYTES, and `root` says whether
// that root is the install origin or the composition's own tree. The reference
// resolves all three in `src/revl/hostref.py::resolve_refs`, off the declaring
// document's realpath and the install origin. So the driver probes the host once
// per ref and hands the producer the result on a wire
// (`lower.rvl::lower_to_ir_refs`), rather than letting a producer that reads only
// tokens guess at values it cannot see.
//
// The answer is `SHA256 | ROOT-KIND | ROOT-RELATIVE-PATH`, or ""
// when the ref cannot be resolved (no such file, or a target outside the jail —
// the reference REFUSES that program outright, `_resolve_ref_disk`'s
// `_outside_root_hint`; the driver's covered surface has no refusal channel for
// it, so the arm is dropped and the divergence is stated here instead of being
// emitted as a broken import path).
//
// The JAIL mirrors `compiler.py::_origin_install_root`'s two arms:
//
//   * the document's realpath is contained in the toolchain's `stdlib/` — the
//     install-origin arm — so the jail is that stdlib's PARENT (the checkout
//     root, or `site-packages/revl` in a wheel) and the kind is `"stdlib"`. The
//     stdlib is recognised by a member module (`stdlib/fs.rvl`) and not by the
//     directory's NAME: the repo has two other directories called `stdlib`
//     (`backends/go/v3/stdlib`, `docs/census-artifact/cases/stdlib`) and neither
//     is one.
//   * otherwise the USER-origin arm: the jail is the document's own directory
//     and there is no kind — item 396 option B, where `root_dirs` is the root
//     compile files' directories, and the driver's one root file is this
//     document.
//
// What is NOT mirrored is the item-319 search-path record (arm 1 of
// `_origin_install_root`): the driver's `use` walk resolves a module by walking
// the document's ancestors, so it has no entry to record. A `REVL_IMPORT_PATH`
// stand-in therefore classifies by containment, like a stdlib module reached
// relatively — the arm `_origin_install_root` documents as equivalent.
extern pure fn ref_probe(base: Str, refpath: Str) -> Str = @py {
    import hashlib
    import os
    if base == "" or refpath == "":
        return ""
    docdir = os.path.realpath(os.path.dirname(os.path.abspath(base)))
    real = os.path.realpath(os.path.join(docdir, refpath))
    if not os.path.isfile(real):
        return ""
    jail = ""
    kind = ""
    probe = docdir
    for _ in range(0, 16):
        if os.path.basename(probe) == "stdlib" and os.path.isfile(
                os.path.join(probe, "fs.rvl")):
            jail = os.path.dirname(probe)
            kind = "stdlib"
            break
        parent = os.path.dirname(probe)
        if parent == probe:
            break
        probe = parent
    if jail == "":
        jail = docdir
    rel = os.path.relpath(real, jail)
    if rel == os.pardir or rel.startswith(os.pardir + os.sep):
        return ""
    if os.path.isabs(rel):
        return ""
    with open(real, "rb") as fh:
        digest = hashlib.sha256(fh.read()).hexdigest()
    return digest + "|" + kind + "|" + rel.replace(os.sep, "/")
}

// Index of `sub` in `s` at or after `start`, or -1. (The base `Str.indexOf`
// takes no start offset, so the scans below carry their own.)
fn ul_find(s: Str, sub: Str, start: Int) -> Int {
  let n = s.length()
  let m = sub.length()
  var i = start
  if (i < 0) { i = 0 }
  if (m == 0) { return i }
  while (i + m <= n) {
    if (s.slice(i, i + m) == sub) { return i }
    i += 1
  }
  return 0 - 1
}

// `revl` string literals carry no `\n` escape (a `"\n"` is backslash + `n`, the
// lexer's no-escape semantics), so whitespace is recognised by code point and
// the newline comes from `stdlib/str.rvl`'s `str_newline()`. The set is
// Python's `str.isspace`, which is what the reference lexer skips between
// tokens and between an `@backend` name and its `{` (issue #2343): VT, FF,
// 0x1c-0x1f, NEL, NBSP and the Unicode spaces, beyond space, tab, LF and CR.
fn ul_is_ws(c: Str) -> Bool {
  if (c == "") { return false }
  let k = c.charCodeAt(0)
  if ((k == 32) || ((k >= 9) && (k <= 13))) { return true }
  if ((k >= 28) && (k <= 31)) { return true }
  if ((k == 133) || (k == 160) || (k == 5760)) { return true }
  if ((k >= 8192) && (k <= 8202)) { return true }
  if ((k == 8232) || (k == 8233) || (k == 8239)) { return true }
  return (k == 8287) || (k == 12288)
}

fn ul_trim(s: Str) -> Str {
  var a = 0
  var b = s.length()
  while ((a < b) && ul_is_ws(s.slice(a, a + 1))) { a += 1 }
  while ((b > a) && ul_is_ws(s.slice(b - 1, b))) { b -= 1 }
  return s.slice(a, b)
}

// Index of the first non-space byte at or after `i` (or `s.length()`).
fn ul_skip_ws(s: Str, i: Int) -> Int {
  var j = i
  let n = s.length()
  while ((j < n) && ul_is_ws(s.slice(j, j + 1))) { j += 1 }
  return j
}

// The end of the line holding `i`: the next newline, or the end of the text.
fn ul_line_end(s: Str, i: Int) -> Int {
  var j = i
  let n = s.length()
  while (j < n) {
    if (s.slice(j, j + 1).charCodeAt(0) == 10) { return j }
    j += 1
  }
  return n
}

// The index of the `"` closing the JSON string whose opening quote is at
// `open_at`, or -1. An escaped quote does not close it.
fn ul_string_end(s: Str, open_at: Int) -> Int {
  var i = open_at + 1
  let n = s.length()
  while (i < n) {
    let ch = s.slice(i, i + 1)
    if (ch == "\\") { i += 2 }
    else {
      if (ch == "\"") { return i }
      i += 1
    }
  }
  return 0 - 1
}

// The index of the `}` or `]` matching the `{` or `[` at `open_at`, or -1.
// String-aware: a bracket inside a JSON string does not count. Both bracket
// kinds share one depth, which is exact for the well-nested JSON the producer
// writes. (A service row holds only method/param/type names, but the matcher
// does not rely on that.)
fn ul_match_close(s: Str, open_at: Int) -> Int {
  var depth = 0
  var i = open_at
  let n = s.length()
  while (i < n) {
    let ch = s.slice(i, i + 1)
    if (ch == "\"") {
      let end = ul_string_end(s, i)
      if (end < 0) { return 0 - 1 }
      i = end
    }
    else {
      if ((ch == "{") || (ch == "[")) { depth += 1 }
      else {
        if ((ch == "}") || (ch == "]")) {
          depth -= 1
          if (depth == 0) { return i }
        }
      }
    }
    i += 1
  }
  return 0 - 1
}

// The index where the value of the TOP-LEVEL key `key` of the JSON object `ir`
// starts, or -1. Only a key at depth 1 counts, so a service row or component
// that carries a key of the same spelling is never mistaken for it.
fn ul_top_key(ir: Str, key: Str) -> Int {
  let want = "\"".concat(key).concat("\"")
  var depth = 0
  var i = 0
  let n = ir.length()
  while (i < n) {
    let ch = ir.slice(i, i + 1)
    if (ch == "\"") {
      let end = ul_string_end(ir, i)
      if (end < 0) { return 0 - 1 }
      if ((depth == 1) && (ir.slice(i, end + 1) == want)) {
        let colon = ul_skip_ws(ir, end + 1)
        if (ir.slice(colon, colon + 1) == ":") { return ul_skip_ws(ir, colon + 1) }
      }
      i = end + 1
    }
    else {
      if ((ch == "{") || (ch == "[")) { depth += 1 }
      else {
        if ((ch == "}") || (ch == "]")) { depth -= 1 }
      }
      i += 1
    }
  }
  return 0 - 1
}

// The index of the `{` opening the top-level `services` object of a native IR
// document, or -1.
fn ul_services_open(ir: Str) -> Int {
  let at = ul_find(ir, "\"services\"", 0)
  if (at < 0) { return 0 - 1 }
  return ul_find(ir, "{", at)
}

// The `{ … }` JSON text of the service row named `name` in `module_ir`, or ""
// when the module declares no such row. The quoted key must be followed by `:`,
// so a service `Cli` does not match a `CliDispatch` key.
fn ul_service_entry(module_ir: Str, name: Str) -> Str {
  let at = ul_services_open(module_ir)
  if (at < 0) { return "" }
  let close = ul_match_close(module_ir, at)
  if (close < 0) { return "" }
  let obj = module_ir.slice(at, close + 1)
  let key = "\"".concat(name).concat("\"")
  var k = ul_find(obj, key, 0)
  while (k >= 0) {
    let nxt = ul_skip_ws(obj, k + key.length())
    if (obj.slice(nxt, nxt + 1) == ":") {
      let b = ul_find(obj, "{", k)
      if (b < 0) { return "" }
      let e = ul_match_close(obj, b)
      if (e < 0) { return "" }
      return obj.slice(b, e + 1)
    }
    k = ul_find(obj, key, k + 1)
  }
  return ""
}

// `ir` with `"name": entry` APPENDED to its top-level `services` object.
// Appending — never prepending — is load-bearing: the reference puts the
// document's own rows first and its imports after, and the emitted bytes follow
// that order.
fn ul_append_service(ir: Str, name: Str, entry: Str) -> Str {
  let at = ul_services_open(ir)
  if (at < 0) { return ir }
  let close = ul_match_close(ir, at)
  if (close < 0) { return ir }
  var sep = ""
  if (close > at + 1) { sep = ", " }
  let ins = sep.concat("\"").concat(name).concat("\": ").concat(entry)
  return ir.slice(0, close).concat(ins).concat(ir.slice(close, ir.length()))
}

// The document's TOP-LEVEL `use "target" { A, B }` imports, flattened as
// `target, name, target, name, …` in declaration order. A `use` counts only at
// column 0 (a leading `//` or indentation makes it a comment or a nested line,
// not a declaration) and only when a `{ … }` list follows on the same line — the
// reference's own shape.
fn ul_use_pairs(source: Str) -> List[Str] {
  var out: List[Str] = []
  var i = ul_find(source, "use ", 0)
  while (i >= 0) {
    if ((i == 0) || (source.slice(i - 1, i).charCodeAt(0) == 10)) {
      let eol = ul_line_end(source, i)
      let q0 = ul_find(source, "\"", i)
      let lb = ul_find(source, "{", i)
      if ((q0 >= 0) && (q0 < eol) && (lb >= 0) && (lb < eol)) {
        let q1 = ul_find(source, "\"", q0 + 1)
        let rb = ul_find(source, "}", lb)
        if ((q1 >= 0) && (q1 < eol) && (rb >= 0)) {
          let target = source.slice(q0 + 1, q1)
          let parts = source.slice(lb + 1, rb).split(",")
          var p = 0
          while (p < parts.length()) {
            let name = ul_trim(parts[p])
            if (name != "") {
              out = out.push(target)
              out = out.push(name)
            }
            p += 1
          }
        }
      }
    }
    i = ul_find(source, "use ", i + 4)
  }
  return out
}

// The document's IR with every imported service row appended: for each top-level
// `use` name in declaration order whose module resolves, lower that module and
// append its row — unless the document already provides that name. Only DIRECT
// imports enter the table, which is exactly what the reference composes.
fn ul_link_uses(ir: Str, source: Str, path: Str) -> Str {
  let pairs = ul_use_pairs(source)
  var out = ir
  var i = 0
  while (i + 1 < pairs.length()) {
    let target = pairs[i]
    let name = pairs[i + 1]
    i += 2
    if (ul_service_entry(out, name) == "") {
      let module_src = read_module_text(module_path(path, target))
      if (module_src != "") {
        let entry = ul_service_entry(lower_to_ir(module_src), name)
        if (entry != "") { out = ul_append_service(out, name, entry) }
      }
    }
  }
  return out
}

// The index of `x` in `xs`, or -1.
fn ul_index(xs: List[Str], x: Str) -> Int {
  var i = 0
  while (i < xs.length()) {
    if (xs[i] == x) { return i }
    i += 1
  }
  return 0 - 1
}

// `xs` holds `x`.
fn ul_has(xs: List[Str], x: Str) -> Bool { return ul_index(xs, x) >= 0 }

// `paths` with `p` inserted in ascending order, unless it is already there.
fn ul_insert_sorted(paths: List[Str], p: Str) -> List[Str] {
  if (ul_has(paths, p)) { return paths }
  var out: List[Str] = []
  var placed = false
  var i = 0
  while (i < paths.length()) {
    if (!placed && (paths[i] > p)) {
      out = out.push(p)
      placed = true
    }
    out = out.push(paths[i])
    i += 1
  }
  if (!placed) { out = out.push(p) }
  return out
}

// The native IR of the module at the resolved path `dep`, with its host refs
// probed against its own path, as the reference resolves a ref off the
// declaring module.
fn ul_module_ir(dep: Str) -> Str {
  let src = read_module_text(dep)
  return lower_to_ir_refs(src, rf_ref_rows(src, dep))
}

// The modules lowered so far, by resolved path, so the closure walk below
// lowers each module once however many names are imported from it.
type UlMods = { paths: List[Str], irs: List[Str] }

// `mods` with every path of the `dep, name` pairs `targets` lowered.
fn ul_lower_all(mods: UlMods, targets: List[Str]) -> UlMods {
  var out = mods
  var i = 0
  while (i + 1 < targets.length()) {
    let dep = targets[i]
    if (!ul_has(out.paths, dep)) {
      out = { paths: out.paths.push(dep), irs: out.irs.push(ul_module_ir(dep)) }
    }
    i += 2
  }
  return out
}

// The IR `mods` holds for `dep` ("" when it holds none).
fn ul_mod_ir(mods: UlMods, dep: Str) -> Str {
  let k = ul_index(mods.paths, dep)
  if (k < 0) { return "" }
  return mods.irs[k]
}

// The `use { … }` imports of the module `source` at `path`, as resolved
// `path, name` pairs in declaration order. An unresolvable target is skipped.
fn ul_use_targets(source: Str, path: Str) -> List[Str] {
  let pairs = ul_use_pairs(source)
  var out: List[Str] = []
  var i = 0
  while (i + 1 < pairs.length()) {
    let dep = module_path(path, pairs[i])
    if (dep != "") {
      out = out.push(dep)
      out = out.push(pairs[i + 1])
    }
    i += 2
  }
  return out
}

// The direct PURE dependencies among the resolved imports `targets`: every
// module one of whose imported names is not one of its services (so a `pub fn`,
// `type` or `extern`), each once and sorted. That is the reference loader's
// `pure_dependencies` set, iterated the way `compile_files` iterates it
// (`sorted(..., key=path)`). A `use` that names only services makes no pure
// dependency, so it carries no extern. `mods` must hold every target.
fn ul_pure_deps(targets: List[Str], mods: UlMods) -> List[Str] {
  var deps: List[Str] = []
  var i = 0
  while (i + 1 < targets.length()) {
    let dep = targets[i]
    if (ul_service_entry(ul_mod_ir(mods, dep), targets[i + 1]) == "") {
      deps = ul_insert_sorted(deps, dep)
    }
    i += 2
  }
  return deps
}

// The resolved path of the first top-level `use "target" as alias` import of
// the module `source` at `path` (a `use` line with no `{ }` list), or "". The
// reference makes the aliased module a pure dependency and merges all of it,
// which this driver does not, so such a module is refused rather than dropped.
fn ul_alias_target(source: Str, path: Str) -> Str {
  var i = ul_find(source, "use ", 0)
  while (i >= 0) {
    if ((i == 0) || (source.slice(i - 1, i).charCodeAt(0) == 10)) {
      let eol = ul_line_end(source, i)
      let q0 = ul_find(source, "\"", i)
      let lb = ul_find(source, "{", i)
      if ((q0 >= 0) && (q0 < eol) && ((lb < 0) || (lb > eol))) {
        let q1 = ul_find(source, "\"", q0 + 1)
        if ((q1 >= 0) && (q1 < eol)) {
          let dep = module_path(path, source.slice(q0 + 1, q1))
          if (dep != "") { return dep }
        }
      }
    }
    i = ul_find(source, "use ", i + 4)
  }
  return ""
}

// The top-level keys of the JSON object `ir`, in order.
fn ul_top_keys(ir: Str) -> List[Str] {
  var out: List[Str] = []
  var depth = 0
  var i = 0
  let n = ir.length()
  while (i < n) {
    let ch = ir.slice(i, i + 1)
    if (ch == "\"") {
      let end = ul_string_end(ir, i)
      if (end < 0) { return out }
      let colon = ul_skip_ws(ir, end + 1)
      if ((depth == 1) && (ir.slice(colon, colon + 1) == ":")) {
        out = out.push(ir.slice(i + 1, end))
      }
      i = end + 1
    }
    else {
      if ((ch == "{") || (ch == "[")) { depth += 1 }
      else {
        if ((ch == "}") || (ch == "]")) { depth -= 1 }
      }
      i += 1
    }
  }
  return out
}

// Whether `source` declares an extern at the top level.
fn ul_declares_extern(source: Str) -> Bool {
  var i = 0
  let n = source.length()
  while (i < n) {
    let eol = ul_line_end(source, i)
    let line = source.slice(i, eol)
    if ((line.slice(0, 7) == "extern ") || (line.slice(0, 11) == "pub extern ")) { return true }
    i = eol + 1
  }
  return false
}

// Whether `c` can begin a declaration keyword: an ASCII letter or `_`.
fn ul_is_word_start(c: Str) -> Bool {
  if (c == "") { return false }
  let k = c.charCodeAt(0)
  return ((k >= 65) && (k <= 90)) || ((k >= 97) && (k <= 122)) || (k == 95)
}

// Whether `line` begins with one of `prefixes`.
fn ul_has_prefix(line: Str, prefixes: List[Str]) -> Bool {
  var i = 0
  while (i < prefixes.length()) {
    let p = prefixes[i]
    if (line.slice(0, p.length()) == p) { return true }
    i += 1
  }
  return false
}

// The first top-level declaration of `source` that is not an extern, a `use`, a
// service or a component, as the start of its line, or "". A declaration starts
// at column 0 with a keyword; a body line, a closing brace, a comment or an
// indented line does not. This reads the TEXT because the native producer writes
// no IR key at all for a declaration it does not lower (a `prop test`, say),
// which the reference would still merge. An extern declaration is skipped
// whole (`ul_extern_decl_end`), so a column-0 line of its host body (issue
// #2308) is not read as a declaration.
fn ul_foreign_decl(source: Str) -> Str {
  let externs = ["extern ", "pub extern "]
  let allowed = ["use ", "service ", "pub service ", "component ", "pub component "]
  var i = 0
  let n = source.length()
  while (i < n) {
    let eol = ul_line_end(source, i)
    let line = source.slice(i, eol)
    if (ul_has_prefix(line, externs)) { i = ul_extern_decl_end(source, i) }
    else {
      if (ul_is_word_start(line.slice(0, 1)) && !ul_has_prefix(line, allowed)) {
        let shown = ul_trim(line)
        if (shown.length() > 40) { return shown.slice(0, 40) }
        return shown
      }
      i = eol + 1
    }
  }
  return ""
}

// The index just past the `"` string opening at `at`, or the end of `s` when it
// is unterminated: the lexer's `skip_dquote`.
fn ul_dquote_end(s: Str, at: Int) -> Int {
  let end = ul_string_end(s, at)
  if (end < 0) { return s.length() }
  return end + 1
}

// The index just past the `@backend { … }` host body whose `@` is at `at`, read
// as the self-host lexer's `scan_host_body` reads it: any `str.isspace` run may
// sit before the `{`, and the body closes on brace depth with a `"` string
// skipped. When no host body starts at `at`, the index just past the `@`. The
// reference lexer also skips `'` strings, triple quotes, block comments and
// backtick spans; a body whose brace sits in one of those is read differently
// here, but then the self-host lexer misreads it the same way, its externs do
// not lower, and `ul_dep_refusal` refuses the module.
fn ul_host_body_end(s: Str, at: Int) -> Int {
  let n = s.length()
  if (!ul_is_word_start(s.slice(at + 1, at + 2))) { return at + 1 }
  var j = at + 2
  while ((j < n) && ul_is_word_char(s.slice(j, j + 1))) { j += 1 }
  while ((j < n) && ul_is_ws(s.slice(j, j + 1))) { j += 1 }
  if (s.slice(j, j + 1) != "{") { return at + 1 }
  var depth = 1
  var k = j + 1
  while (k < n) {
    let ch = s.slice(k, k + 1)
    if (ch == "\"") { k = ul_dquote_end(s, k) }
    else {
      if (ch == "{") { depth += 1 }
      if (ch == "}") {
        depth -= 1
        if (depth == 0) { return k + 1 }
      }
      k += 1
    }
  }
  return n
}

// The start of the first line after the extern declaration whose line starts at
// `at` (or the end of `source`): the declaration runs over its header and every
// `@backend { … }` arm, whose host body may hold column-0 lines of host code,
// and ends at the first newline outside a host body, a string or a comment that
// is followed by a column-0 word, the next declaration.
fn ul_extern_decl_end(source: Str, at: Int) -> Int {
  let n = source.length()
  var i = at
  while (i < n) {
    let ch = source.slice(i, i + 1)
    if (ch == "@") { i = ul_host_body_end(source, i) }
    else {
      if (ch == "\"") { i = ul_dquote_end(source, i) }
      else {
        if (source.slice(i, i + 2) == "//") { i = ul_line_end(source, i) }
        else {
          if ((ch.charCodeAt(0) == 10) && ul_is_word_start(source.slice(i + 1, i + 2))) { return i + 1 }
          i += 1
        }
      }
    }
  }
  return n
}

// Why the pure dependency at `dep` (text `source`, native IR `ir`) cannot be
// linked, as `LINK|<message>`, or "". The reference merges a pure dependency's
// functions, types, secrets, tests and every other declaration list into the
// document; this driver carries only its externs, so any top-level IR section
// beyond `ir_version`, `services`, `components` (neither merged for a pure
// dependency) and `externs` would be dropped, and is refused instead. So is a
// top-level declaration the producer writes no key for (`ul_foreign_decl`), and
// a module whose declared externs did not lower, which would drop them all.
fn ul_dep_refusal(dep: Str, source: Str, ir: Str) -> Str {
  let keys = ul_top_keys(ir)
  var i = 0
  while (i < keys.length()) {
    let k = keys[i]
    if ((k != "ir_version") && (k != "services") && (k != "components") && (k != "externs")) {
      return "LINK|`".concat(dep).concat("` declares `").concat(k)
        .concat("`, which the native link does not carry (only a used module's externs travel)")
    }
    i += 1
  }
  let foreign = ul_foreign_decl(source)
  if (foreign != "") {
    return "LINK|`".concat(dep).concat("` declares `").concat(foreign)
      .concat("`, which the native link does not carry (only a used module's externs travel)")
  }
  if (ul_declares_extern(source) && (ul_array_items(ir, "externs") == "")) {
    return "LINK|the externs of `".concat(dep).concat("` did not lower natively")
  }
  return ""
}

// The pure closure of a document: its modules in link order, their native IR,
// and the refusal ("" for none) that stopped the walk.
type UlClosure = { paths: List[Str], irs: List[Str], refusal: Str }

// Every module whose pure declarations the document at `path` pulls in, in the
// order `compile_files` builds its `included` list: breadth first from the
// document, each module's own pure dependencies in path order, each module once.
// The document itself is not in the list; its own externs are already in its IR.
// The walk stops at the first module it cannot link (`ul_dep_refusal`) or the
// first alias import (`ul_alias_target`), in the document or in a dependency.
fn ul_pure_closure(source: Str, path: Str) -> UlClosure {
  var none: List[Str] = []
  var mods: UlMods = { paths: none, irs: none }
  var included: List[Str] = []
  var irs: List[Str] = []
  var srcs: List[Str] = [source]
  var paths: List[Str] = [path]
  var q = 0
  while (q < paths.length()) {
    let alias = ul_alias_target(srcs[q], paths[q])
    if (alias != "") {
      return { paths: included, irs: irs, refusal: "LINK|`".concat(alias)
        .concat("` is imported by alias, which the native link does not carry") }
    }
    let targets = ul_use_targets(srcs[q], paths[q])
    mods = ul_lower_all(mods, targets)
    let deps = ul_pure_deps(targets, mods)
    var d = 0
    while (d < deps.length()) {
      let dep = deps[d]
      if (!ul_has(included, dep)) {
        let dep_src = read_module_text(dep)
        let dep_ir = ul_mod_ir(mods, dep)
        let why = ul_dep_refusal(dep, dep_src, dep_ir)
        if (why != "") { return { paths: included, irs: irs, refusal: why } }
        included = included.push(dep)
        irs = irs.push(dep_ir)
        paths = paths.push(dep)
        srcs = srcs.push(dep_src)
      }
      d += 1
    }
    q += 1
  }
  return { paths: included, irs: irs, refusal: "" }
}

// The elements of the top-level array `key` of `ir` as JSON text, without the
// brackets, or "" when there is no such array or it is empty.
fn ul_array_items(ir: Str, key: Str) -> Str {
  let at = ul_top_key(ir, key)
  if ((at < 0) || (ir.slice(at, at + 1) != "[")) { return "" }
  let close = ul_match_close(ir, at)
  if (close < 0) { return "" }
  return ul_trim(ir.slice(at + 1, close))
}

// The `name` of every object in the JSON array elements `items`, in order.
fn ul_item_names(items: Str) -> List[Str] {
  var out: List[Str] = []
  var i = 0
  let n = items.length()
  while (i < n) {
    if (items.slice(i, i + 1) == "{") {
      let close = ul_match_close(items, i)
      if (close < 0) { return out }
      let obj = items.slice(i, close + 1)
      let at = ul_top_key(obj, "name")
      if ((at >= 0) && (obj.slice(at, at + 1) == "\"")) {
        let end = ul_string_end(obj, at)
        if (end > at) { out = out.push(obj.slice(at + 1, end)) }
      }
      i = close + 1
    }
    else { i += 1 }
  }
  return out
}

// The index just past the value of the top-level key `key` of `ir`, or -1 when
// there is no such key or its value is not an array or object.
fn ul_value_end(ir: Str, key: Str) -> Int {
  let at = ul_top_key(ir, key)
  if (at < 0) { return 0 - 1 }
  let ch = ir.slice(at, at + 1)
  if ((ch != "[") && (ch != "{")) { return 0 - 1 }
  let close = ul_match_close(ir, at)
  if (close < 0) { return 0 - 1 }
  return close + 1
}

// `ir` with the extern elements `items` APPENDED to its top-level `externs`
// array, after the document's own, as the reference merges the root module
// first. A document that declares no extern has no `externs` key at all; the
// array is then created where `lower_to_ir` writes it: after `functions`, else
// after `types`, else after `components`.
fn ul_append_externs(ir: Str, items: Str) -> Str {
  if (items == "") { return ir }
  let at = ul_top_key(ir, "externs")
  if (at >= 0) {
    if (ir.slice(at, at + 1) != "[") { return ir }
    let close = ul_match_close(ir, at)
    if (close < 0) { return ir }
    var sep = ""
    if (ul_trim(ir.slice(at + 1, close)) != "") { sep = ", " }
    return ir.slice(0, close).concat(sep).concat(items).concat(ir.slice(close, ir.length()))
  }
  var end = ul_value_end(ir, "functions")
  if (end < 0) { end = ul_value_end(ir, "types") }
  if (end < 0) { end = ul_value_end(ir, "components") }
  if (end < 0) { return ir }
  let ins = ", \"externs\": [".concat(items).concat("]")
  return ir.slice(0, end).concat(ins).concat(ir.slice(end, ir.length()))
}

// The first of `names` the IR `ir` already declares as an extern or a
// function, or "".
fn ul_name_clash(ir: Str, names: List[Str]) -> Str {
  let exts = ul_item_names(ul_array_items(ir, "externs"))
  let fns = ul_item_names(ul_array_items(ir, "functions"))
  var i = 0
  while (i < names.length()) {
    if (ul_has(exts, names[i]) || ul_has(fns, names[i])) { return names[i] }
    i += 1
  }
  return ""
}

// A linked IR, or the refusal ("" for none) that stopped the link.
type UlLinked = { ir: Str, refusal: Str }

// The document's IR with the whole extern section of every module in its pure
// closure appended (issue #2181), in closure order, or a `LINK|<message>`
// refusal where the result would differ from the reference's. The reference's
// privacy pass renames a PRIVATE extern whose bare name collides across the
// included modules; this driver does not rename, so a collision is refused
// rather than emitted twice under one name. A dependency carrying anything but
// externs, and an alias import, are refused by `ul_pure_closure`.
fn ul_link_externs(ir: Str, source: Str, path: Str) -> UlLinked {
  let closure = ul_pure_closure(source, path)
  if (closure.refusal != "") { return { ir: ir, refusal: closure.refusal } }
  var out = ir
  var i = 0
  while (i < closure.irs.length()) {
    let items = ul_array_items(closure.irs[i], "externs")
    let clash = ul_name_clash(out, ul_item_names(items))
    if (clash != "") {
      return { ir: ir, refusal: "LINK|extern `".concat(clash).concat("` of `")
        .concat(closure.paths[i])
        .concat("` collides with a declaration of the same name, and the native link does not rename module-private declarations apart") }
    }
    out = ul_append_externs(out, items)
    i += 1
  }
  return { ir: out, refusal: "" }
}

// Issue #2308. A service imported on its own (`use "./lib.rvl" { Store }`) makes
// no pure dependency, so `ul_link_externs` carries nothing from its module. The
// reference still brings the PUBLIC record and variant types the service's
// operations name, closed over the types their fields and cases name (the
// `carried` list of `compile_files`, issue #1899), and appends them to the
// merged `types` table after the document's own. `ul_link_types` does the same.

// Whether `c` can continue an identifier: a word start or an ASCII digit.
fn ul_is_word_char(c: Str) -> Bool {
  if (ul_is_word_start(c)) { return true }
  if (c == "") { return false }
  let k = c.charCodeAt(0)
  return (k >= 48) && (k <= 57)
}

// The identifiers of the type expression `t`, in order: the reference's
// `_TYPE_NAME` scan, `[A-Za-z_][A-Za-z0-9_]*`.
fn ul_type_idents(t: Str) -> List[Str] {
  var out: List[Str] = []
  var i = 0
  let n = t.length()
  while (i < n) {
    if (ul_is_word_start(t.slice(i, i + 1))) {
      var j = i + 1
      while ((j < n) && ul_is_word_char(t.slice(j, j + 1))) { j += 1 }
      out = out.push(t.slice(i, j))
      i = j
    }
    else { i += 1 }
  }
  return out
}

// `xs` with every element of `ys` appended.
fn ul_push_all(xs: List[Str], ys: List[Str]) -> List[Str] {
  var out = xs
  var i = 0
  while (i < ys.length()) {
    out = out.push(ys[i])
    i += 1
  }
  return out
}

// The identifiers of every STRING value of the key `key`, at any depth of the
// JSON text `s`, in order. A `null` value names nothing.
fn ul_key_idents(s: Str, key: Str) -> List[Str] {
  let want = "\"".concat(key).concat("\"")
  var out: List[Str] = []
  var i = 0
  let n = s.length()
  while (i < n) {
    if (s.slice(i, i + 1) == "\"") {
      let end = ul_string_end(s, i)
      if (end < 0) { return out }
      let is_key = s.slice(i, end + 1) == want
      i = end + 1
      let colon = ul_skip_ws(s, i)
      if (is_key && (s.slice(colon, colon + 1) == ":")) {
        let v = ul_skip_ws(s, colon + 1)
        if (s.slice(v, v + 1) == "\"") {
          let ve = ul_string_end(s, v)
          if (ve < 0) { return out }
          out = ul_push_all(out, ul_type_idents(s.slice(v + 1, ve)))
          i = ve + 1
        }
      }
    }
    else { i += 1 }
  }
  return out
}

// The identifiers of every string VALUE (a string after a `:`, never a key) of
// the JSON text `s`, in order: the field types of a record's `fields` object.
fn ul_value_idents(s: Str) -> List[Str] {
  var out: List[Str] = []
  var after_colon = false
  var i = 0
  let n = s.length()
  while (i < n) {
    let ch = s.slice(i, i + 1)
    if (ch == "\"") {
      let end = ul_string_end(s, i)
      if (end < 0) { return out }
      if (after_colon) { out = ul_push_all(out, ul_type_idents(s.slice(i + 1, end))) }
      after_colon = false
      i = end + 1
    }
    else {
      if (ch == ":") { after_colon = true }
      else { if (!ul_is_ws(ch)) { after_colon = false } }
      i += 1
    }
  }
  return out
}

// The JSON value of the top-level key `key` of the object `s` when it is an
// array or object, or "".
fn ul_key_value(s: Str, key: Str) -> Str {
  let end = ul_value_end(s, key)
  if (end < 0) { return "" }
  return s.slice(ul_top_key(s, key), end)
}

// The identifier starting at `at` of `s`, or "" when none starts there.
fn ul_word_at(s: Str, at: Int) -> Str {
  if (!ul_is_word_start(s.slice(at, at + 1))) { return "" }
  var j = at + 1
  while ((j < s.length()) && ul_is_word_char(s.slice(j, j + 1))) { j += 1 }
  return s.slice(at, j)
}

// Issue #2308. The type declarations of a module, read the way the REFERENCE
// lexer reads the text (src/revl/lexer.py), so a brace or a quote inside a
// string, a template, a comment or a host body never shifts what is seen as
// top level. The forms, all at revl level (`lex`, lexer.py:380-492):
//   * `//` to the end of the line; revl has no block comment;
//   * `"""` (checked before `"`) to the next `"""`, verbatim, no escapes
//     (`_lex_triple_string`, lexer.py:686);
//   * `"` and `'` strings, whose only escapes are `\<quote>` and `\\`; a
//     newline or the end of input inside one is an error (`_lex_string`,
//     lexer.py:611);
//   * a backtick template to the next backtick, where `${` opens an
//     interpolation balanced by `_match_brace` under `_REVL_TRIVIA`: `"`
//     escape strings, backtick raw spans and `//` comments (`_lex_template`,
//     lexer.py:769; `_REVL_TRIVIA`, lexer.py:120);
//   * `@backend` then any whitespace then `{`: a host body balanced by
//     `_match_brace` under that backend's `_HOST_TRIVIA`, the C family by
//     default (`_HOST_TRIVIA` and its families, lexer.py:130-158;
//     `_char_literal_end`, `_skip_trivia` and `_match_brace`, lexer.py:161-243).
// Anything the reference would reject (an unterminated string, template or
// host body, an interpolation that is empty or does not lex, a bracket that
// closes below depth 0, an open bracket at the end, or a `type` keyword inside
// brackets) makes the scan fail, and the caller refuses rather than trust the
// list.

// The kind of host trivia `_HOST_TRIVIA` gives the backend `name`: "py", "ts",
// "wasm", or "c" (rust, go, java and every other name).
fn rl_host_kind(name: Str) -> Str {
  if ((name == "py") || (name == "python")) { return "py" }
  if ((name == "ts") || (name == "typescript") || (name == "node") || (name == "js")) { return "ts" }
  if (name == "wasm") { return "wasm" }
  return "c"
}

// How the trivia `kind` ("revl" or a host kind) reads a string opened by `c`:
// "escape", "raw", "char", or "" when `c` opens none (`_Trivia.strings`).
fn rl_string_mode(kind: Str, c: Str) -> Str {
  if (c == "\"") { return "escape" }
  if (c == "'") {
    if ((kind == "py") || (kind == "ts")) { return "escape" }
    if (kind == "c") { return "char" }
    return ""
  }
  if (c == "`") {
    if ((kind == "revl") || (kind == "c") || (kind == "ts")) { return "raw" }
  }
  return ""
}

// `_skip_trivia`'s "escape" mode for the string `c` opening at `i`: a
// backslash skips the next character, and a newline ends the span unconsumed.
// An unterminated span consumes to the end.
fn rl_escape_end(s: Str, i: Int, c: Str) -> Int {
  let n = s.length()
  var j = i + 1
  while (j < n) {
    let ch = s.slice(j, j + 1)
    if (ch == "\\") { j += 2 }
    else {
      if (ch == c) { return j + 1 }
      if (ch.charCodeAt(0) == 10) { return j }
      j += 1
    }
  }
  return n
}

// `_char_literal_end`: the index just past a closed char literal at `i`
// (`'x'`, `'\n'`, `'\u{1F600}'`), or `i` when it does not look like one (a
// Rust lifetime), so the `'` is ordinary text.
fn rl_char_end(s: Str, i: Int) -> Int {
  let n = s.length()
  var j = i + 1
  if ((j >= n) || (s.slice(j, j + 1).charCodeAt(0) == 10)) { return i }
  if (s.slice(j, j + 1) == "\\") {
    j += 2
    while ((j < n) && (s.slice(j, j + 1) != "'") && (s.slice(j, j + 1).charCodeAt(0) != 10)) { j += 1 }
    if ((j < n) && (s.slice(j, j + 1) == "'")) { return j + 1 }
    return i
  }
  if ((s.slice(j, j + 1) != "'") && (s.slice(j + 1, j + 2) == "'")) { return j + 2 }
  return i
}

// The index just past the `opener` span at `i` closed by `closer`, or the end.
fn rl_span_end(s: Str, i: Int, opener: Str, closer: Str) -> Int {
  let e = ul_find(s, closer, i + opener.length())
  if (e < 0) { return s.length() }
  return e + closer.length()
}

// `_skip_trivia` for a Python triple string `triple` at `i`: a backslash
// skips the next character; unterminated consumes to the end.
fn rl_triple_trivia_end(s: Str, i: Int, triple: Str) -> Int {
  let n = s.length()
  var j = i + 3
  while ((j < n) && (s.slice(j, j + 3) != triple)) {
    if (s.slice(j, j + 1) == "\\") { j += 1 }
    j += 1
  }
  if (j < n) { return j + 3 }
  return n
}

// `_skip_trivia` under the trivia `kind`: the index just past the string,
// char literal or comment at `i`, or `i` itself when none starts there.
fn rl_trivia_end(s: Str, i: Int, kind: Str) -> Int {
  let two = s.slice(i, i + 2)
  if (((kind == "c") || (kind == "ts")) && (two == "/*")) { return rl_span_end(s, i, "/*", "*/") }
  if ((kind == "wasm") && (two == "(;")) { return rl_span_end(s, i, "(;", ";)") }
  if ((kind == "revl") && (two == "//")) { return ul_line_end(s, i) }
  let three = s.slice(i, i + 3)
  if ((kind == "py") && ((three == "\"\"\"") || (three == "'''"))) { return rl_triple_trivia_end(s, i, three) }
  let c = s.slice(i, i + 1)
  let mode = rl_string_mode(kind, c)
  if (mode == "char") { return rl_char_end(s, i) }
  if (mode == "raw") { return rl_span_end(s, i, c, c) }
  if (mode == "escape") { return rl_escape_end(s, i, c) }
  return i
}

// `_match_brace`: the index of the `}` matching the `{` at `open_at` under the
// trivia `kind`, or -1 when the input ends first.
fn rl_match_brace(s: Str, open_at: Int, kind: Str) -> Int {
  let n = s.length()
  var depth = 0
  var i = open_at
  while (i < n) {
    let c = s.slice(i, i + 1)
    if (c == "{") {
      depth += 1
      i += 1
    }
    else {
      if (c == "}") {
        depth -= 1
        if (depth == 0) { return i }
        i += 1
      }
      else {
        let j = rl_trivia_end(s, i, kind)
        if (j > i) { i = j } else { i += 1 }
      }
    }
  }
  return 0 - 1
}

// `_lex_string`: the index just past the `quote` string opening at `at`, or -1
// when a newline or the end of input comes first.
fn rl_string_end(s: Str, at: Int, quote: Str) -> Int {
  let n = s.length()
  var i = at + 1
  while (i < n) {
    let c = s.slice(i, i + 1)
    let next = s.slice(i + 1, i + 2)
    if ((c == "\\") && ((next == quote) || (next == "\\"))) { i += 2 }
    else {
      if (c == quote) { return i + 1 }
      if (c.charCodeAt(0) == 10) { return 0 - 1 }
      i += 1
    }
  }
  return 0 - 1
}

// `_lex_template`: the index just past the template opening at `at`, or -1
// when it, or one of its `${...}` interpolations, is unterminated.
fn rl_template_end(s: Str, at: Int) -> Int {
  let n = s.length()
  var i = at + 1
  while (i < n) {
    let c = s.slice(i, i + 1)
    if (c == "`") { return i + 1 }
    if ((c == "$") && (s.slice(i + 1, i + 2) == "{")) {
      let j = rl_match_brace(s, i + 1, "revl")
      if (j < 0) { return 0 - 1 }
      // The parser lexes the captured source again as an expression, so what
      // it would reject there (a `'` string `_match_brace` does not know, or
      // an empty `${}`) fails the scan too.
      let inner = s.slice(i + 2, j)
      if (ul_skip_ws(inner, 0) >= inner.length()) { return 0 - 1 }
      if (!ul_type_scan(inner).ok) { return 0 - 1 }
      i = j + 1
    }
    else { i += 1 }
  }
  return 0 - 1
}

// The host-body arm of `lex`: the index just past the `@backend { ... }` body
// whose `@` is at `at`, `at + 1` when no body follows (an `@` token), or -1
// when the body is unterminated.
fn rl_host_body_end(s: Str, at: Int) -> Int {
  let n = s.length()
  let name = ul_word_at(s, at + 1)
  if (name == "") { return at + 1 }
  var k = at + 1 + name.length()
  while ((k < n) && ul_is_ws(s.slice(k, k + 1))) { k += 1 }
  if (s.slice(k, k + 1) != "{") { return at + 1 }
  let p = rl_match_brace(s, k, rl_host_kind(name))
  if (p < 0) { return 0 - 1 }
  return p + 1
}

// The index just past the comment, string, template or host body that starts
// at `i` of `s` at revl level, `i` itself when none does, or -1 when it is
// unterminated (which the reference rejects).
fn rl_opaque_end(s: Str, i: Int) -> Int {
  if (s.slice(i, i + 2) == "//") { return ul_line_end(s, i) }
  if (s.slice(i, i + 3) == "\"\"\"") {
    let e = ul_find(s, "\"\"\"", i + 3)
    if (e < 0) { return 0 - 1 }
    return e + 3
  }
  let c = s.slice(i, i + 1)
  if ((c == "\"") || (c == "'")) { return rl_string_end(s, i, c) }
  if (c == "`") { return rl_template_end(s, i) }
  if (c == "@") { return rl_host_body_end(s, i) }
  return i
}

// Issue #2359: why `s` does not lex as the reference lexer reads it, or "".
// The self-host lexer balances a host body on `"` strings alone, so a body
// whose `'` string or block comment holds an unmatched brace (`@ts { … /'/g …
// }`) closes where the reference's `_match_brace` does not, and the reference
// reports an unterminated body. Each comment, string, template and host body
// is stepped over as `lex` steps over it, and the first that does not close,
// or a host body the self-host lexer closes elsewhere, is refused on its line.
fn rl_lex_refusal(s: Str) -> Str {
  let n = s.length()
  var i = 0
  var line = 1
  while (i < n) {
    let past = rl_opaque_end(s, i)
    if (past < 0) {
      return "line ".concat(line.to_str())
        .concat(": an unterminated string, template or host body (the reference lexer reads it to the end of the text)")
    }
    // a host body the self-host lexer would close at another brace than the
    // reference does carries other host text, so it is refused, not emitted
    if ((past > i + 1) && (s.slice(i, i + 1) == "@") && (ul_host_body_end(s, i) != past)) {
      return "line ".concat(line.to_str())
        .concat(": a host body whose braces sit in host strings or comments the self-host lexer does not skip")
    }
    let stop = past > i ? past : i + 1
    while (i < stop) {
      if (s.slice(i, i + 1).charCodeAt(0) == 10) { line += 1 }
      i += 1
    }
  }
  return ""
}

// The next token at or after `i`: whitespace and `//` comments skipped.
fn rl_skip_trivia(s: Str, i: Int) -> Int {
  var j = ul_skip_ws(s, i)
  while (s.slice(j, j + 2) == "//") { j = ul_skip_ws(s, ul_line_end(s, j)) }
  return j
}

// After a `pub` ending at `i`: the index of the `type` it declares, past the
// modifiers the reference reads there (parser.py, the `pub` arm of the
// program loop: `verified`, then `commutative`, then `endorse[...]` slots),
// 0 when no `type` follows, or -1 for `pub commutative type`, which the
// reference rejects.
fn rl_pub_type_at(s: Str, i: Int) -> Int {
  var k = rl_skip_trivia(s, i)
  if (ul_word_at(s, k) == "verified") { k = rl_skip_trivia(s, k + 8) }
  var is_comm = false
  if (ul_word_at(s, k) == "commutative") {
    is_comm = true
    k = rl_skip_trivia(s, k + 11)
  }
  while (ul_word_at(s, k) == "endorse") {
    let open_at = rl_skip_trivia(s, k + 7)
    if (s.slice(open_at, open_at + 1) != "[") { return 0 }
    let close_at = ul_find(s, "]", open_at)
    if (close_at < 0) { return 0 }
    k = rl_skip_trivia(s, close_at + 1)
  }
  if (ul_word_at(s, k) != "type") { return 0 }
  if (is_comm) { return 0 - 1 }
  return k
}

// A module's top-level type declarations, every name and the `pub` ones, in
// order, and whether the text was read as the reference reads it (`ok`).
type UlTypeScan = { all: List[Str], pubs: List[Str], ok: Bool }

// The types `source` declares with a TOP-LEVEL `type` or `pub type`: found by
// token, at any column, at bracket depth 0, outside comments, strings,
// templates and host bodies, so an indented declaration or two on one line
// count, and a `type` field of a record or a word of host code does not.
fn ul_type_scan(source: Str) -> UlTypeScan {
  var all: List[Str] = []
  var pubs: List[Str] = []
  var depth = 0
  var i = 0
  let n = source.length()
  while (i < n) {
    let past = rl_opaque_end(source, i)
    if (past < 0) { return { all: all, pubs: pubs, ok: false } }
    if (past > i) { i = past }
    else {
      let ch = source.slice(i, i + 1)
      if (ul_is_word_start(ch)) {
        let w = ul_word_at(source, i)
        i += w.length()
        // `type` is a keyword that only heads a top-level declaration
        // (parser.py `type_decl`), so one inside brackets is a program the
        // reference rejects: fail closed rather than read it as a field.
        if ((depth > 0) && (w == "type")) { return { all: all, pubs: pubs, ok: false } }
        if ((depth == 0) && ((w == "pub") || (w == "type"))) {
          var is_pub = false
          if (w == "pub") {
            let k = rl_pub_type_at(source, i)
            if (k < 0) { return { all: all, pubs: pubs, ok: false } }
            if (k > 0) {
              is_pub = true
              i = k + 4
            }
          }
          if (is_pub || (w == "type")) {
            let name = ul_word_at(source, rl_skip_trivia(source, i))
            if (name != "") {
              all = all.push(name)
              if (is_pub) { pubs = pubs.push(name) }
            }
          }
        }
      }
      else {
        if ((ch == "{") || (ch == "[") || (ch == "(")) { depth += 1 }
        if ((ch == "}") || (ch == "]") || (ch == ")")) {
          depth -= 1
          if (depth < 0) { return { all: all, pubs: pubs, ok: false } }
        }
        i += 1
      }
    }
  }
  return { all: all, pubs: pubs, ok: depth == 0 }
}

// The types an imported service carries, in its module's declaration order, or
// the refusal ("" for none) where the native IR cannot supply one.
type UlCarry = { names: List[Str], refusal: Str }

// The public types of the module (native IR `module_ir`, text `source`, at
// `dep`) that the service row `entry` names in a parameter or return type,
// closed over the types their record fields and variant payloads name, in
// declaration order: `_service_type_closure` of the reference. A public type the
// closure reaches that the native producer did not lower is refused, since the
// reference would carry it.
fn ul_carried_types(dep: Str, module_ir: Str, source: Str, entry: Str) -> UlCarry {
  var none: List[Str] = []
  let table = ul_key_value(module_ir, "types")
  let scan = ul_type_scan(source)
  if (!scan.ok) {
    return { names: none, refusal: "LINK|the type declarations of `".concat(dep)
      .concat("` could not be read the way the reference lexer reads them (an unterminated string, template or host body, or unbalanced brackets)") }
  }
  let pubs = scan.pubs
  // Every type the module declares, public or private, must be in the native
  // table before the closure is read off it: the producer expands a transparent
  // alias (`pub type Al = Cell`, or a private `type Id = Int`) in the service
  // row and in record fields and keeps no entry for it, so a closure walked
  // from the native IR would carry `Cell` where the reference carries `Al`, or
  // print `id: Int` where the reference prints `id: Id`. Which types an
  // expanded alias would have reached cannot be told from the native IR, so a
  // missing declaration is refused even when no operation seems to reach it.
  let decls = scan.all
  var p = 0
  while (p < decls.length()) {
    if (ul_key_value(table, decls[p]) == "") {
      return { names: none, refusal: "LINK|type `".concat(decls[p]).concat("` of `").concat(dep)
        .concat("` did not lower natively, and an imported service of that module may carry it") }
    }
    p += 1
  }
  var pending = ul_push_all(ul_key_idents(entry, "type"), ul_key_idents(entry, "returns"))
  var seen: List[Str] = []
  var q = 0
  while (q < pending.length()) {
    let name = pending[q]
    q += 1
    if (ul_has(pubs, name) && !ul_has(seen, name)) {
      let decl = ul_key_value(table, name)
      if (decl == "") {
        return { names: none, refusal: "LINK|type `".concat(name).concat("` of `").concat(dep)
          .concat("` did not lower natively, and the imported service carries it") }
      }
      seen = seen.push(name)
      pending = ul_push_all(pending, ul_value_idents(ul_key_value(decl, "fields")))
      pending = ul_push_all(pending, ul_key_idents(ul_key_value(decl, "cases"), "payload"))
    }
  }
  var out: List[Str] = []
  let order = ul_top_keys(table)
  var i = 0
  while (i < order.length()) {
    if (ul_has(seen, order[i])) { out = out.push(order[i]) }
    i += 1
  }
  return { names: out, refusal: "" }
}

// `ir` with the `"name": decl` entries `items` APPENDED to its top-level `types`
// object, after the document's own, as `compile_files` merges carried types
// last. A document that declares no type has no `types` key; the object is then
// created where `lower_to_ir` writes it, right after `components`.
fn ul_append_types(ir: Str, items: Str) -> Str {
  if (items == "") { return ir }
  let at = ul_top_key(ir, "types")
  if (at >= 0) {
    if (ir.slice(at, at + 1) != "{") { return ir }
    let close = ul_match_close(ir, at)
    if (close < 0) { return ir }
    var sep = ""
    if (ul_trim(ir.slice(at + 1, close)) != "") { sep = ", " }
    return ir.slice(0, close).concat(sep).concat(items).concat(ir.slice(close, ir.length()))
  }
  let end = ul_value_end(ir, "components")
  if (end < 0) { return ir }
  let ins = ", \"types\": {".concat(items).concat("}")
  return ir.slice(0, end).concat(ins).concat(ir.slice(end, ir.length()))
}

// `ir` with its `ir_version` set to 3. The reference bumps a program to v3 when
// it declares a type or an extern, so an IR that gains one from a link is v3
// whatever the document alone would have been.
fn ul_bump_v3(ir: Str) -> Str {
  let at = ul_top_key(ir, "ir_version")
  if (at < 0) { return ir }
  var end = at
  while ((end < ir.length()) && ul_is_word_char(ir.slice(end, end + 1))) { end += 1 }
  return ir.slice(0, at).concat("3").concat(ir.slice(end, ir.length()))
}

// The types every directly imported service of a document carries, in `use`
// order, each once, with the module it comes from and its native `types`
// entry, or the `LINK|<message>` refusal where the reference's set cannot be
// read off the native IR. Two carried types of one name from two modules are
// refused: the reference refuses them too.
type UlCarriedSet = { names: List[Str], owners: List[Str], decls: List[Str], refusal: Str }

fn ul_carried_set(source: Str, path: Str) -> UlCarriedSet {
  let pairs = ul_use_pairs(source)
  var names: List[Str] = []
  var owners: List[Str] = []
  var decls: List[Str] = []
  var i = 0
  while (i + 1 < pairs.length()) {
    let dep = module_path(path, pairs[i])
    let svc = pairs[i + 1]
    i += 2
    if (dep != "") {
      let module_ir = ul_module_ir(dep)
      let entry = ul_service_entry(module_ir, svc)
      if (entry != "") {
        let carry = ul_carried_types(dep, module_ir, read_module_text(dep), entry)
        if (carry.refusal != "") {
          return { names: names, owners: owners, decls: decls, refusal: carry.refusal }
        }
        let table = ul_key_value(module_ir, "types")
        var c = 0
        while (c < carry.names.length()) {
          let name = carry.names[c]
          let k = ul_index(names, name)
          if (k < 0) {
            names = names.push(name)
            owners = owners.push(dep)
            decls = decls.push(ul_key_value(table, name))
          }
          else {
            if (owners[k] != dep) {
              return { names: names, owners: owners, decls: decls,
                refusal: "LINK|type `".concat(name).concat("` is carried from both `")
                  .concat(owners[k]).concat("` and `").concat(dep).concat("`") }
            }
          }
          c += 1
        }
      }
    }
  }
  return { names: names, owners: owners, decls: decls, refusal: "" }
}

// The document's IR with the types every directly imported service carries
// appended (issue #2308), in `use` order, each type once, or a `LINK|<message>`
// refusal where the result would differ from the reference's. The names in
// `pre` are already in the document's table, lowered from their declaration
// text in the carried order (`ul_with_carried_text`), and are not appended
// again. A document's private type of a carried name is renamed apart before
// lowering (`ul_rename_apart`); one still here is public, or could not be
// renamed, and is refused. A module that is also a pure dependency carries its
// types with the rest of it in the reference, but `ul_dep_refusal` already
// refuses any pure dependency that declares a type, so no such module reaches
// here with one.
fn ul_link_types(ir: Str, source: Str, path: Str, pre: List[Str]) -> UlLinked {
  let set = ul_carried_set(source, path)
  if (set.refusal != "") { return { ir: ir, refusal: set.refusal } }
  if (set.names.length() == 0) { return { ir: ir, refusal: "" } }
  let own = ul_top_keys(ul_key_value(ir, "types"))
  var items = ""
  var d = 0
  while (d < set.names.length()) {
    let name = set.names[d]
    if (!ul_has(pre, name)) {
      if (ul_has(own, name)) {
        return { ir: ir, refusal: "LINK|type `".concat(name).concat("` carried from `")
          .concat(set.owners[d])
          .concat("` collides with the document's own type of the same name, and the native link renames only a private one apart") }
      }
      if (items != "") { items = items.concat(", ") }
      items = items.concat("\"").concat(name).concat("\": ").concat(set.decls[d])
    }
    d += 1
  }
  return { ir: ul_bump_v3(ul_append_types(ir, items)), refusal: "" }
}

// Issue #2374. `s` with every identifier `from` outside comments, strings,
// templates and host bodies replaced by `to`. A longer identifier that holds
// `from` is left alone.
fn ul_rename_word(s: Str, from: Str, to: Str) -> Str {
  var out = ""
  var i = 0
  let n = s.length()
  while (i < n) {
    let past = rl_opaque_end(s, i)
    if (past < 0) { return s }
    if (past > i) {
      out = out.concat(s.slice(i, past))
      i = past
    }
    else {
      var j = i + 1
      if (ul_is_word_char(s.slice(i, i + 1))) {
        while ((j < n) && ul_is_word_char(s.slice(j, j + 1))) { j += 1 }
      }
      let w = s.slice(i, j)
      out = out.concat(w == from ? to : w)
      i = j
    }
  }
  return out
}

// Issue #2374. Whether the private document type `name` can be renamed apart
// by text: the native IR `own` of the document names it only as a type, never
// as a declaration, a case or a record field, so each identifier `name` in the
// text is a reference to that type. The reference's `_rewrite_module` renames
// it in functions, externs, types, events and test bodies, never in a service
// or a component, so a name the document's `services` or `components` spell
// is not renamed either: the link refuses it loudly instead.
fn ul_renamable(own: Str, name: Str) -> Bool {
  let q = "\"".concat(name).concat("\"")
  return (tc_count(own, q.concat(":")) == 1)
    && (tc_count(own, "\"name\": ".concat(q)) == 0)
    && (tc_count(own, "\"case\": ".concat(q)) == 0)
    && (tc_count(own, "[".concat(q).concat(",")) == 0)
    && !ul_has(ul_type_idents(ul_key_value(own, "services")), name)
    && !ul_has(ul_type_idents(ul_key_value(own, "components")), name)
}

// Issue #2374. The document `source` (lowered to `own`) with each private type
// that shares its name with a type an imported service carries renamed to
// `<name>__m0`, as the reference's privacy pass renames it (the root document
// is module 0 of the merged program). A public one, one the document imports
// by name, and one `ul_renamable` does not clear stay as they are; the type
// link then refuses them.
fn ul_rename_apart(source: Str, path: Str, own: Str) -> Str {
  let set = ul_carried_set(source, path)
  if ((set.refusal != "") || (set.names.length() == 0)) { return source }
  let scan = ul_type_scan(source)
  if (!scan.ok) { return source }
  let imported = ul_use_pairs(source)
  var out = source
  var i = 0
  while (i < set.names.length()) {
    let name = set.names[i]
    let to = name.concat("__m0")
    if (ul_has(scan.all, name) && !ul_has(scan.pubs, name) && !ul_has(imported, name)
        && (source.indexOf(to) == 0 - 1) && ul_renamable(own, name)) {
      out = ul_rename_word(out, name, to)
    }
    i += 1
  }
  return out
}

// Issue #2374. `source` with the declaration text of every carried type (in
// the carried order) appended, so the native gate resolves a carried variant's
// cases (`store.put(Dot)`, `Box(1)`) and the producer lowers them as the
// reference does, and the names appended. Nothing is appended (`names` empty)
// unless every carried type has a declaration text (`tc_type_text`) and the
// document neither declares nor imports by name any of them.
type UlCarriedText = { text: Str, names: List[Str] }

fn ul_with_carried_text(source: Str, path: Str) -> UlCarriedText {
  var none: List[Str] = []
  let set = ul_carried_set(source, path)
  if ((set.refusal != "") || (set.names.length() == 0)) { return { text: source, names: none } }
  let scan = ul_type_scan(source)
  if (!scan.ok) { return { text: source, names: none } }
  let imported = ul_use_pairs(source)
  var text = source.concat(str_newline())
  var i = 0
  while (i < set.names.length()) {
    let decl = tc_type_text(set.names[i], set.decls[i])
    if ((decl == "") || ul_has(scan.all, set.names[i]) || ul_has(imported, set.names[i])) {
      return { text: source, names: none }
    }
    text = text.concat(str_newline()).concat(decl).concat(str_newline())
    i += 1
  }
  return { text: text, names: set.names }
}

// Issue #2329. The native gate reads only the document, so a call to an
// operation of an imported service went untyped: `store.put("x")` against a
// `put(id: Int)` declared in the imported module was admitted, and emitted,
// where the reference refuses it at check time. The driver now admits the
// document a second time with the declaration text of every service it imports
// appended, so the gate types those calls the way the reference checker does.
// The module's own type declarations are NOT appended: the gate types a call
// against a built-in parameter type, and a carried record or variant by name,
// without them. A transparent alias never reaches this pass, since the type
// link above refuses a module that declares one (the producer keeps no `types`
// entry for it).

// The index of the `}` closing the brace body opening at `open_at`, scanned the
// way `ul_type_scan` scans (comments, strings, templates and host bodies are
// opaque), or -1 when there is no `{` there or the body does not close.
fn tc_body_close(s: Str, open_at: Int) -> Int {
  if (s.slice(open_at, open_at + 1) != "{") { return 0 - 1 }
  var depth = 0
  var i = open_at
  let n = s.length()
  while (i < n) {
    let past = rl_opaque_end(s, i)
    if (past < 0) { return 0 - 1 }
    if (past > i) { i = past }
    else {
      let ch = s.slice(i, i + 1)
      if ((ch == "{") || (ch == "[") || (ch == "(")) { depth += 1 }
      if ((ch == "}") || (ch == "]") || (ch == ")")) {
        depth -= 1
        if (depth == 0) { return i }
        if (depth < 0) { return 0 - 1 }
      }
      i += 1
    }
  }
  return 0 - 1
}

// The declaration text of the service `name` in the module text `source`, from
// the `service` keyword to the `}` closing its body, found at bracket depth 0 by
// the reference-lexer scan, or "" when the module declares no such service or
// the text cannot be read that way. A leading `pub` adds nothing, and a
// `commutative` constrains only a provider's body, which the native gate does
// not parse in that position, so neither is part of the text.
fn tc_service_text(source: Str, name: Str) -> Str {
  var depth = 0
  var i = 0
  let n = source.length()
  while (i < n) {
    let past = rl_opaque_end(source, i)
    if (past < 0) { return "" }
    if (past > i) { i = past }
    else {
      let ch = source.slice(i, i + 1)
      if (ul_is_word_start(ch)) {
        let w = ul_word_at(source, i)
        if ((depth == 0) && (w == "service")) {
          let k = rl_skip_trivia(source, i + 7)
          if (ul_word_at(source, k) == name) {
            let close = tc_body_close(source, rl_skip_trivia(source, k + name.length()))
            if (close < 0) { return "" }
            return source.slice(i, close + 1)
          }
        }
        i += w.length()
      }
      else {
        if ((ch == "{") || (ch == "[") || (ch == "(")) { depth += 1 }
        if ((ch == "}") || (ch == "]") || (ch == ")")) {
          depth -= 1
          if (depth < 0) { return "" }
        }
        i += 1
      }
    }
  }
  return ""
}

// The first identifier of `text` that is also in `names`, or "".
fn tc_first_shared(text: Str, names: List[Str]) -> Str {
  let words = ul_type_idents(text)
  var i = 0
  while (i < words.length()) {
    if (ul_has(names, words[i])) { return words[i] }
    i += 1
  }
  return ""
}

// The admission text, or the refusal ("" for none) that stopped building it.
type TcText = { text: Str, refusal: Str }

// Issue #2362. The string value of the top-level key `key` of the JSON object
// `obj`, or "" when it is absent or not a string (a `null` payload).
fn tc_str_value(obj: Str, key: Str) -> Str {
  let at = ul_top_key(obj, key)
  if ((at < 0) || (obj.slice(at, at + 1) != "\"")) { return "" }
  let end = ul_string_end(obj, at)
  if (end < 0) { return "" }
  return obj.slice(at + 1, end)
}

// `type <name> = { f: T, ... }` for a record entry of the native `types`
// table, `type <name> = A | B(T)` for a variant one, or "" for a generic type
// or any other kind, which is left out (the gate then reads the name as one
// it cannot resolve, as before).
fn tc_type_text(name: Str, decl: Str) -> Str {
  if (ul_trim(ul_key_value(decl, "params")) != "[]") { return "" }
  let kind = tc_str_value(decl, "kind")
  let head = "type ".concat(name).concat(" = ")
  if (kind == "record") {
    let fields = ul_key_value(decl, "fields")
    let keys = ul_top_keys(fields)
    var body = ""
    var k = 0
    while (k < keys.length()) {
      if (k > 0) { body = body.concat(", ") }
      body = body.concat(keys[k]).concat(": ").concat(tc_str_value(fields, keys[k]))
      k += 1
    }
    return head.concat("{ ").concat(body).concat(" }")
  }
  if (kind != "variant") { return "" }
  let cases = ul_key_value(decl, "cases")
  var out = ""
  var i = 0
  while (i < cases.length()) {
    if (cases.slice(i, i + 1) == "{") {
      let close = ul_match_close(cases, i)
      if (close < 0) { return "" }
      let c = cases.slice(i, close + 1)
      if (out != "") { out = out.concat(" | ") }
      out = out.concat(tc_str_value(c, "name"))
      let payload = tc_str_value(c, "payload")
      if (payload != "") { out = out.concat("(").concat(payload).concat(")") }
      i = close + 1
    }
    else { i += 1 }
  }
  return out == "" ? "" : head.concat(out)
}

// The types the imported service carries, as declarations to append, and the
// names appended so far.
type TcCarried = { text: Str, names: List[Str] }

// Issue #2362. The declaration text of every type the service `name` of the
// module at `dep` carries (`ul_carried_types`, the reference's `carried`
// list) that `seen` does not hold yet, so the gate can resolve a record
// parameter field-wise against a record literal, as the reference does.
fn tc_carried_text(dep: Str, module_src: Str, name: Str, seen: List[Str]) -> TcCarried {
  let module_ir = ul_module_ir(dep)
  let entry = ul_service_entry(module_ir, name)
  if (entry == "") { return { text: "", names: seen } }
  let carry = ul_carried_types(dep, module_ir, module_src, entry)
  let table = ul_key_value(module_ir, "types")
  var names = seen
  var text = ""
  var i = 0
  while (i < carry.names.length()) {
    let t = carry.names[i]
    if (!ul_has(names, t)) {
      let decl = tc_type_text(t, ul_key_value(table, t))
      if (decl != "") {
        names = names.push(t)
        text = text.concat(decl).concat(str_newline())
      }
    }
    i += 1
  }
  return { text: text, names: names }
}

// The document `source` (at `path`, lowered to `own`) with the declaration text
// of every service a top-level `use` names appended, once each, unless the
// document declares that service itself or the module declares none of that
// name (the link then appends no row either). Refused with `LINK|` where the
// appended text would not type the calls as the reference does: a service the
// native IR has a row for but whose text the scan cannot read, and a
// declaration that names a type the document also declares, which the appended
// text would resolve to the document's type where the reference resolves the
// module's.
fn tc_admission_text(source: Str, path: Str, own: Str) -> TcText {
  let pairs = ul_use_pairs(source)
  let doc_types = ul_type_scan(source)
  var done: List[Str] = []
  var typed: List[Str] = []
  var text = source
  var i = 0
  while (i + 1 < pairs.length()) {
    let dep = module_path(path, pairs[i])
    let name = pairs[i + 1]
    i += 2
    if ((dep != "") && !ul_has(done, name) && (ul_service_entry(own, name) == "")) {
      let module_src = read_module_text(dep)
      let decl = tc_service_text(module_src, name)
      if (decl == "") {
        if (ul_service_entry(lower_to_ir(module_src), name) != "") {
          return { text: source, refusal: "LINK|the declaration of service `".concat(name)
            .concat("` in `").concat(dep).concat("` could not be read to type the document's calls to it") }
        }
      }
      else {
        if (!doc_types.ok) {
          return { text: source, refusal: "LINK|the document's type declarations could not be read to type its calls to the imported service `"
            .concat(name).concat("`") }
        }
        let shared = tc_first_shared(decl, doc_types.all)
        if (shared != "") {
          return { text: source, refusal: "LINK|the imported service `".concat(name).concat("` names `")
            .concat(shared).concat("`, which the document also declares as a type, and the native gate would resolve it to the document's") }
        }
        done = done.push(name)
        text = text.concat(str_newline()).concat(str_newline()).concat(decl).concat(str_newline())
        let carried = tc_carried_text(dep, module_src, name, typed)
        typed = carried.names
        text = text.concat(carried.text)
      }
    }
  }
  return { text: text, refusal: "" }
}

// The native gate's verdict on the document's calls to the services it
// imports: "" when it imports none or the gate admits them, else the refusal.
// Issue #2362: a type refusal of the document read alone can be the wrong
// one when it calls an imported service: the reference holds the call to its
// declaration first, while it lowers the value. So a T1 from the document
// alone yields to the import admission's verdict when that refuses too.
fn tc_import_first(source: Str, path: Str, verdict: Str) -> Str {
  if (path == "" || verdict.slice(0, 3) != "T1|" || source.indexOf("use \"") == 0 - 1) {
    return verdict
  }
  let own = lower_to_ir_refs(source, rf_ref_rows(source, path))
  let calls = tc_admit_imports(source, path, own)
  return calls == "" ? verdict : calls
}

fn tc_admit_imports(source: Str, path: Str, own: Str) -> Str {
  if (path == "") { return "" }
  let built = tc_admission_text(source, path, own)
  if (built.refusal != "") { return built.refusal }
  if (built.text == source) { return "" }
  let v = admit_src(built.text)
  if (v != "") { return v }
  return tc_operand_types(own, built.text, path)
}

// Issue #2362: an operator whose operand type only the imported declaration
// gives (`store.put(1) + 1` with `put -> Int`) is lowered here without it, so
// the IR lacks the `operands` the reference writes (the py tier's overflow
// guard). The admission text has the declaration in scope; when it lowers to
// more typed operators than the document alone, the native link would differ,
// so it refuses by name.
fn tc_operand_types(own: Str, text: Str, path: Str) -> Str {
  let full = lower_to_ir_refs(text, rf_ref_rows(text, path))
  if (tc_count(full, "\"operands\":") == tc_count(own, "\"operands\":")) { return "" }
  return "LINK|an operator on an imported service call's result is typed only with "
    .concat("the service in scope; the native link does not retype it (issue #2362)")
}

fn tc_count(s: Str, sub: Str) -> Int {
  var n = 0
  var rest = s
  var at = rest.indexOf(sub)
  while (at != 0 - 1) {
    n += 1
    rest = rest.slice(at + sub.length(), rest.length())
    at = rest.indexOf(sub)
  }
  return n
}

// The identifier starting at `at`, up to the first delimiter. The scans below
// read a name out of a source LINE, where a name is followed by a space, `(`,
// `,`, `:`, `{`, `}`, `"`, `[` or the end of the line.
fn rf_word(s: Str, at: Int) -> Str {
  var j = at
  var out = ""
  let n = s.length()
  while (j < n) {
    let c = s.slice(j, j + 1)
    if (ul_is_ws(c)) { return out }
    if ((c == "(") || (c == ")") || (c == ",") || (c == ":") || (c == "{")
        || (c == "}") || (c == "\"") || (c == "[") || (c == "]")) {
      return out
    }
    out = out.concat(c)
    j += 1
  }
  return out
}

// The host-ref wire for `source` (issue #2089): one row per
// `= @backend ref SYM from "PATH"` arm,
// `NAME | BACKEND | SYMBOL | SHA256 | ROOT | PATH`, in source order — the shape
// `lower.rvl::rw_refs_json` reads. The probe supplies the last three fields
// (`ref_probe`); the scan supplies the first three.
//
// NAME is the ENCLOSING extern's declared name, which is not on the arm's line:
// a ref arm closes its extern's declaration (`… } = @ts ref fsWrite from "…"`),
// so the scan carries the last `extern … fn NAME` it saw and attributes every
// arm after it to that name. Externs are walked in source order, so a name is
// stamped onto the entry the producer emits for it.
//
// No rows when `path` is "" — no document on disk means nothing to resolve a ref
// against, so the driver hands the producer an empty wire and the IR is the
// pre-#2089 one byte for byte.
fn rf_ref_rows(source: Str, path: Str) -> List[Str] {
  var out: List[Str] = []
  if (path == "") { return out }
  var cur = ""
  var i = 0
  let n = source.length()
  while (i < n) {
    let eol = ul_line_end(source, i)
    let line = source.slice(i, eol)
    // A comment line declares nothing; the same discipline `ul_use_pairs`
    // applies to a `use`.
    if (ul_trim(line).slice(0, 2) != "//") {
      let ex = ul_find(line, "extern", 0)
      if (ex >= 0) {
        let fnk = ul_find(line, "fn", ex)
        if (fnk >= 0) { cur = rf_word(line, ul_skip_ws(line, fnk + 2)) }
      }
      let arm = ul_find(line, "= @", 0)
      if ((arm >= 0) && (cur != "")) {
        // `= @backend { … }` (a body) has no ` ref ` and is skipped here; the
        // producer reads the body off the token stream.
        let rk = ul_find(line, " ref ", arm)
        let fk = ul_find(line, " from \"", arm)
        if ((rk >= 0) && (fk >= 0)) {
          let backend = rf_word(line, arm + 3)
          let sym = rf_word(line, rk + 5)
          let q0 = fk + 6
          let q1 = ul_find(line, "\"", q0 + 1)
          if ((backend != "") && (sym != "") && (q1 >= 0)) {
            let probe = ref_probe(path, line.slice(q0 + 1, q1))
            if (probe != "") {
              out = out.push(cur.concat("|").concat(backend).concat("|").concat(sym)
                .concat("|").concat(probe))
            }
          }
        }
      }
    }
    i = eol + 1
  }
  return out
}

// ============================================================ module admission
// Issue #2332. The reference loads every module a document `use`s, at any
// depth, and PARSES it whole before anything is linked (`_Loader.load`,
// src/revl/compiler.py), so a used module that does not parse makes the whole
// compile a parse error. The native link above reads only what it carries out
// of a module (a service row, the externs, the carried types) and so used to
// link a module the reference refuses: a service whose operations are
// separated by `,`, a line of text that is no declaration, or a `where` after
// a record type all emitted code. So every used module is ADMITTED first, its
// whole text read by the self-host front end, and the first one that does not
// read refuses the document with `REFUSED|BAD|<module>: <message>`.
//
// What admission reads, all native:
//   * the lexer's error tokens and every `use` declaration, an import list
//     written over several lines included;
//   * the whole parse stage of the native gate (`lower.rvl::parse_refusal`,
//     issue #2359): the foreign-construct redirects, the nesting limit, the
//     top-level program grammar, every top-level `type` declaration against
//     `parser.py::type_decl`, and the statement-level rules the reference
//     parser raises (`lower.rvl::stmt_parse_scan`).

// The token at `i` of `ts`, or an `eof` token past either end.
fn ad_tok(ts: List[Token], i: Int) -> Token {
  if ((i >= 0) && (i < ts.length())) { return ts[i] }
  return { kind: "eof", text: "", line: 0 }
}

fn ad_kind(ts: List[Token], i: Int, k: Str) -> Bool { return ad_tok(ts, i).kind == k }

// Whether `ts[i]` is the keyword `w`.
fn ad_kw(ts: List[Token], i: Int, w: Str) -> Bool {
  let t = ad_tok(ts, i)
  return (t.kind == "kw") && (t.text == w)
}

// The first lexer error token of `ts`, as a refusal message, or "".
fn ad_lex_refusal(ts: List[Token]) -> Str {
  var i = 0
  while (i < ts.length()) {
    if (ts[i].kind == "error") {
      return "line ".concat(ts[i].line.to_str()).concat(": ").concat(ts[i].text)
    }
    i += 1
  }
  return ""
}

// The index just past the `use` declaration whose keyword is at `i`, or -1
// when it does not read as `parser.py::use_decl` reads it: a non-empty path
// string, then `{` names separated by optional `,` `}`, or `as` and a name.
fn ad_use_end(ts: List[Token], i: Int) -> Int {
  let path = ad_tok(ts, i + 1)
  if ((path.kind != "string") || (path.text == "")) { return 0 - 1 }
  if (ad_kw(ts, i + 2, "as")) {
    if (!ad_kind(ts, i + 3, "ident")) { return 0 - 1 }
    return i + 4
  }
  if (!ad_kind(ts, i + 2, "{")) { return 0 - 1 }
  var j = i + 3
  while (!ad_kind(ts, j, "}")) {
    if (!ad_kind(ts, j, "ident")) { return 0 - 1 }
    j += 1
    if (ad_kind(ts, j, ",")) { j += 1 }
  }
  return j + 1
}

// `source` with the lines `lo` to `hi` (1-based, inclusive) emptied, so the
// line numbers of everything else are kept.
fn ad_blank_lines(source: Str, lo: Int, hi: Int) -> Str {
  let lines = source.split(str_newline())
  var out = ""
  var k = 0
  while (k < lines.length()) {
    if (k > 0) { out = out.concat(str_newline()) }
    if (((k + 1) < lo) || ((k + 1) > hi)) { out = out.concat(lines[k]) }
    k += 1
  }
  return out
}

// Why the module text `source` does not read as the reference reads it, or "".
// `parse_prog` steps over a `use` by its first line, so an import list written
// over several lines is checked here (`ad_use_end`) and its lines emptied
// before the program grammar reads the rest; one that shares a line with
// another declaration is left to `parse_prog`, which then refuses it.
fn ad_module_refusal(source: Str) -> Str {
  let ts = lex_src(source)
  let lexed = ad_lex_refusal(ts)
  if (lexed != "") { return lexed }
  let unread = rl_lex_refusal(source)
  if (unread != "") { return unread }
  var program = source
  var depth = 0
  var i = 0
  while (i < ts.length()) {
    let k = ts[i].kind
    if ((k == "{") || (k == "[") || (k == "(")) { depth += 1 }
    if ((k == "}") || (k == "]") || (k == ")")) { depth -= 1 }
    if ((depth == 0) && (k == "kw") && (ts[i].text == "use")) {
      let end = ad_use_end(ts, i)
      if (end < 0) {
        return "line ".concat(ts[i].line.to_str()).concat(": a `use` declaration does not parse")
      }
      let lo = ts[i].line
      let hi = ad_tok(ts, end - 1).line
      let next_tok = ad_tok(ts, end)
      if ((hi > lo) && (ad_tok(ts, i - 1).line < lo) && ((next_tok.kind == "eof") || (next_tok.line > hi))) {
        program = ad_blank_lines(program, lo, hi)
      }
    }
    i += 1
  }
  // the whole parse stage `admit_src` runs, as its message (issue #2359)
  let why = parse_refusal(program)
  if (why == "") { return "" }
  let bar = why.indexOf("|")
  let msg = bar < 0 ? why : why.slice(bar + 1, why.length())
  let bad = parse_prog(program).bad
  if ((bad == "") || (msg != bad)) { return msg }
  if (bad == "expected { after fn signature") {
    // the fn `parse_prog` refuses is the first top-level one whose header
    // reaches no `{`; only when its body is `= expr` is the program valid
    let f = ad_bodiless_fn(ts)
    if (f >= 0) {
      let at = "line ".concat(ts[f].line.to_str()).concat(": ")
      if (ad_kind(ts, ad_fn_header_end(ts, f), "=")) {
        return at.concat("an expression-bodied fn (`fn f(...) = expr`) is not supported by the self-host compiler")
      }
      return at.concat(bad)
    }
  }
  let line = ad_bad_line(ts, program, bad)
  if (line <= 0) { return bad }
  return "line ".concat(line.to_str()).concat(": ").concat(bad)
}

// The index of the token that ends the header of the `fn` at `i`: the first
// `{` or `=` outside its brackets, or the next declaration keyword.
fn ad_fn_header_end(ts: List[Token], i: Int) -> Int {
  let heads = ["fn", "pub", "component", "service", "type", "extern", "use", "test"]
  var d = 0
  var j = i + 1
  while (j < ts.length()) {
    let kj = ts[j].kind
    if ((d == 0) && ((kj == "{") || (kj == "=") || (kj == "eof"))) { return j }
    if ((d == 0) && (kj == "kw") && ul_has(heads, ts[j].text)) { return j }
    if ((kj == "(") || (kj == "[")) { d += 1 }
    if ((kj == ")") || (kj == "]")) { d -= 1 }
    j += 1
  }
  return j
}

// The first top-level `fn`, extern fns aside, whose header reaches no `{`
// (`ad_fn_header_end`), or -1.
fn ad_bodiless_fn(ts: List[Token]) -> Int {
  var depth = 0
  var i = 0
  while (i < ts.length()) {
    let k = ts[i].kind
    if ((k == "{") || (k == "[") || (k == "(")) { depth += 1 }
    if ((k == "}") || (k == "]") || (k == ")")) { depth -= 1 }
    if ((depth == 0) && ad_kw(ts, i, "fn") && !ad_extern_head(ts, i)
        && !ad_kind(ts, ad_fn_header_end(ts, i), "{")) {
      return i
    }
    i += 1
  }
  return 0 - 1
}

// Whether the `fn` at `i` belongs to an `extern` declaration, whose `= @backend`
// body is no expression body: an `extern` earlier on its line.
fn ad_extern_head(ts: List[Token], i: Int) -> Bool {
  var j = i - 1
  while ((j >= 0) && (ts[j].line == ts[i].line)) {
    if (ad_kw(ts, j, "extern")) { return true }
    j -= 1
  }
  return false
}

// The line `parse_prog`'s refusal `bad` of `program` is about, or 0 when it
// cannot be placed: the first line, among those a top-level token that is no
// keyword starts, whose removal changes the refusal. `parse_prog` reports no
// position, and only such a line can hold a token at the top level that heads
// no declaration.
fn ad_bad_line(ts: List[Token], program: Str, bad: Str) -> Int {
  var depth = 0
  var i = 0
  while (i < ts.length()) {
    let t = ts[i]
    let starts = (i == 0) || (ts[i - 1].line < t.line)
    if ((depth == 0) && starts && (t.kind != "kw") && (t.kind != "eof")) {
      if (parse_prog(ad_blank_lines(program, t.line, t.line)).bad != bad) { return t.line }
    }
    if ((t.kind == "{") || (t.kind == "[") || (t.kind == "(")) { depth += 1 }
    if ((t.kind == "}") || (t.kind == "]") || (t.kind == ")")) { depth -= 1 }
    i += 1
  }
  return 0
}

// The `use` targets of `source` as written, in order: every `use` keyword at
// bracket depth 0 followed by a string, with or without an import list.
fn ad_use_targets(source: Str) -> List[Str] {
  let ts = lex_src(source)
  var out: List[Str] = []
  var depth = 0
  var i = 0
  while (i < ts.length()) {
    let k = ts[i].kind
    if ((k == "{") || (k == "[") || (k == "(")) { depth += 1 }
    if ((k == "}") || (k == "]") || (k == ")")) { depth -= 1 }
    if ((depth == 0) && (k == "kw") && (ts[i].text == "use") && ad_kind(ts, i + 1, "string")) {
      out = out.push(ts[i + 1].text)
    }
    i += 1
  }
  return out
}

// `REFUSED|BAD|<module>: <message>` for the first module, depth first from
// the document `source` at `path` and each module once, whose text does not
// read (`ad_module_refusal`), or "" when every used module reads. The document
// itself was admitted by `admit_src` already. As in the reference loader
// (`compiler.py::resolve_use` and `load`), a target that resolves to nothing
// refuses with "cannot find imported module", and a module reached again
// while it is still being read refuses with "import cycle".
fn ad_used_modules_refusal(source: Str, path: Str) -> Str {
  if (path == "") { return "" }
  // the DFS path from the document, as module keys, with each frame's text
  // and the index of its next `use` target; `done` holds every module read
  var stack: List[Str] = [ad_module_key(path)]
  var texts: List[Str] = [source]
  var next: List[Int] = [0]
  var done: List[Str] = []
  while (stack.length() > 0) {
    let top = stack.length() - 1
    let targets = ad_use_targets(texts[top])
    let t = next[top]
    if (t >= targets.length()) {
      done = done.push(stack[top])
      stack = stack.slice(0, top)
      texts = texts.slice(0, top)
      next = next.slice(0, top)
    } else {
      next = next.slice(0, top).push(t + 1)
      let dep = module_path(stack[top], targets[t])
      if (dep == "") {
        return "REFUSED|BAD|".concat(stack[top]).concat(": cannot find imported module `")
          .concat(targets[t]).concat("`")
      }
      if (ul_has(stack, dep)) {
        return "REFUSED|BAD|".concat(dep).concat(": import cycle: ")
          .concat(stack.slice(ul_index(stack, dep), stack.length()).push(dep).join(" -> "))
      }
      if (!ul_has(done, dep)) {
        let text = read_module_text(dep)
        let why = ad_module_refusal(text)
        if (why != "") { return "REFUSED|BAD|".concat(dep).concat(": ").concat(why) }
        stack = stack.push(dep)
        texts = texts.push(text)
        next = next.push(0)
      }
    }
  }
  return ""
}

// Issue #2363: the top-level names of a module, split the way the reference
// loader splits them. `open` holds every name another module may import: a
// `pub fn`, a `pub type`, a `pub extern` and every `service`, `pub` or not
// (`_LoadedModule.public_fns`, `public_types`, `public_externs`, `services`).
// `fns`, `types` and `externs` hold the names declared without `pub`.
type AdDecls = { open: List[Str], fns: List[Str], types: List[Str], externs: List[Str] }

// `decls` with the name `name` of a declaration of kind `kind` ("fn", "type",
// "extern" or "service") added, open when `public` says so.
fn ad_add_decl(decls: AdDecls, kind: Str, name: Str, public: Bool) -> AdDecls {
  if (public || (kind == "service")) {
    return { open: decls.open.push(name), fns: decls.fns, types: decls.types, externs: decls.externs }
  }
  if (kind == "fn") {
    return { open: decls.open, fns: decls.fns.push(name), types: decls.types, externs: decls.externs }
  }
  if (kind == "type") {
    return { open: decls.open, fns: decls.fns, types: decls.types.push(name), externs: decls.externs }
  }
  return { open: decls.open, fns: decls.fns, types: decls.types, externs: decls.externs.push(name) }
}

// The declarations of the module tokens `ts`. Every head is read at bracket
// depth 0: `pub` marks the next declaration public, `type NAME`, `service NAME`
// and `fn NAME` name one, and `extern ... fn NAME` names an extern (its class,
// `emission[...]` scope and the like sit between `extern` and `fn`). A `fn`
// that is not followed by a name is a function type and names nothing, and
// `fn|async NAME` is named past its colour marker. An `event NAME` names a
// private type, as the reference parser records it. The
// module parsed already (`ad_used_modules_refusal`), so no head is malformed.
fn ad_decls(ts: List[Token]) -> AdDecls {
  var out: AdDecls = { open: [], fns: [], types: [], externs: [] }
  var depth = 0
  var public = false
  var in_extern = false
  var i = 0
  while (i < ts.length()) {
    let k = ts[i].kind
    if ((k == "{") || (k == "[") || (k == "(")) { depth += 1 }
    if ((k == "}") || (k == "]") || (k == ")")) { depth -= 1 }
    if ((depth == 0) && (k == "kw")) {
      let w = ts[i].text
      // `fn|async NAME`: the caller-decided colour marker sits between `fn`
      // and the name (item 388).
      let poly = (ad_tok(ts, i + 1).text == "|") && ad_kw(ts, i + 2, "async")
      let at_name = poly ? i + 3 : i + 1
      let named = ad_kind(ts, at_name, "ident")
      if (w == "fn") {
        if (named) {
          out = ad_add_decl(out, in_extern ? "extern" : "fn", ts[at_name].text, public)
        }
        public = false
        in_extern = false
      }
      if (((w == "type") || (w == "service")) && named) {
        out = ad_add_decl(out, w, ts[i + 1].text, public)
        public = false
      }
      if (w == "extern") { in_extern = true }
      if (w == "pub") { public = true }
      if ((w == "use") || (w == "component") || (w == "test")) {
        public = false
        in_extern = false
      }
    }
    // `event NAME(...)` / `event NAME { ... }` declares a private type.
    if ((depth == 0) && (k == "ident") && (ts[i].text == "event") && ad_kind(ts, i + 1, "ident")
        && (ad_kind(ts, i + 2, "(") || ad_kind(ts, i + 2, "{"))) {
      out = ad_add_decl(out, "type", ts[i + 1].text, false)
    }
    i += 1
  }
  return out
}

// The reference loader's verdict on importing `name` from the module whose
// declarations are `decls` at `dep` (`compiler.py::_import_named`), or "".
fn ad_name_refusal(decls: AdDecls, name: Str, dep: Str) -> Str {
  if (ul_has(decls.open, name)) { return "" }
  let place = "`".concat(dep).concat("`")
  if (ul_has(decls.fns, name) || ul_has(decls.types, name) || ul_has(decls.externs, name)) {
    return "`".concat(name).concat("` is module-private in ").concat(place).concat(" and cannot be imported (G1)")
  }
  return "`".concat(name).concat("` is not a public declaration in ").concat(place)
}

// Why one `use` of the module tokens `ts` at `path` does not import as the
// reference imports it, or "": the `use` at token `i` names a target that
// resolves nowhere, or lists a name its module does not export.
fn ad_use_refusal(ts: List[Token], i: Int, path: Str) -> Str {
  let target = ts[i + 1].text
  let at = "line ".concat(ts[i].line.to_str()).concat(": ")
  let dep = module_path(path, target)
  if (dep == "") {
    return at.concat("cannot find imported module `").concat(target).concat("`")
  }
  if (!ad_kind(ts, i + 2, "{")) { return "" }
  let decls = ad_decls(lex_src(read_module_text(dep)))
  var j = i + 3
  while (ad_kind(ts, j, "ident")) {
    let why = ad_name_refusal(decls, ts[j].text, dep)
    if (why != "") { return at.concat(why) }
    j += 1
    if (ad_kind(ts, j, ",")) { j += 1 }
  }
  return ""
}

// `REFUSED|BAD|<module>: line N: <message>` for the first `use`, breadth first
// from the document `source` at `path` and each module once, that the reference
// loader refuses: a target it cannot find (issue #2363: relative to the
// importer, then on the search path, `module_path`), or an imported name the
// module does not export. "" when every `use` imports. The reference loads
// depth first, so with two such faults in one document it may name the other
// one; it refuses the document either way.
fn ad_imports_refusal(source: Str, path: Str) -> Str {
  if (path == "") { return "" }
  var paths: List[Str] = [path]
  var srcs: List[Str] = [source]
  var q = 0
  while (q < paths.length()) {
    let ts = lex_src(srcs[q])
    var depth = 0
    var i = 0
    while (i < ts.length()) {
      let k = ts[i].kind
      if ((k == "{") || (k == "[") || (k == "(")) { depth += 1 }
      if ((k == "}") || (k == "]") || (k == ")")) { depth -= 1 }
      if ((depth == 0) && ad_kw(ts, i, "use") && ad_kind(ts, i + 1, "string")) {
        let why = ad_use_refusal(ts, i, paths[q])
        if (why != "") { return "REFUSED|BAD|".concat(paths[q]).concat(": ").concat(why) }
        let dep = module_path(paths[q], ts[i + 1].text)
        if (!ul_has(paths, dep)) {
          paths = paths.push(dep)
          srcs = srcs.push(read_module_text(dep))
        }
      }
      i += 1
    }
    q += 1
  }
  return ""
}

// The module key of the document at `path`: its absolute path when it is on
// disk (the key `module_path` gives every module it resolves), else `path`.
fn ad_module_key(path: Str) -> Str {
  let segs = path.split("/")
  let key = module_path(path, segs[segs.length() - 1])
  return key == "" ? path : key
}

// Issue #2374. The admission of the document `source` whose own verdict is
// `verdict`, once `full` (the document with every carried type declaration
// spliced in) is known: the carried names its lowering takes as declaration
// text, and the refusal ("" for none).
//
// `full.text` is the MERGED program the reference admits, and the reference
// admits it in every case, not only when the document read alone draws G1:
//   * a G1 refusal of the document read alone yields when the merged text is
//     admitted (issue #2374: a carried case used in a component body);
//   * an ADMITTED document stays admitted, UNLESS splicing a carried
//     declaration changes a resolution the reference also sees differently
//     (issue #2449: the document declares its own `Dot` and the carried type
//     declares `Dot` too, so the reference's merged case table drops both as
//     ambiguous and a bare `Dot` in a component body resolves to no
//     requirement, a G1 refusal). Adopting the merged verdict is what makes the
//     gate draw the reference's refusal.
// Any other verdict stands, through `tc_import_first`.
type TcCarriedAdmission = { names: List[Str], refusal: Str }

fn tc_carried_admission(source: Str, path: Str, verdict: Str,
                        full: UlCarriedText) -> TcCarriedAdmission {
  var none: List[Str] = []
  if ((path == "") || (full.names.length() == 0)) {
    return { names: none, refusal: tc_import_first(source, path, verdict) }
  }
  let again = admit_src(full.text)
  if ((verdict == "") || (verdict.slice(0, 3) == "G1|")) {
    if (again == "") { return { names: full.names, refusal: "" } }
    return { names: none, refusal: tc_import_first(source, path, again) }
  }
  return { names: none, refusal: tc_import_first(source, path, verdict) }
}

// The path-taking driver — the honest multi-file native compile. Identical to
// `compile_to` except that `path` names the document on disk, so its `use`
// declarations resolve and the imported service rows are spliced into the IR
// before the native emitter runs. `path` may be relative; it is resolved against
// the process working directory, and a `use` target is resolved against the
// document's own directory first. A path that resolves nothing changes nothing.
// Issue #2181: the imported externs are spliced in too, and a document the
// native link cannot reproduce returns "REFUSED|LINK|<message>" (see
// `ul_link_externs`) rather than different source. Issue #2308: so are the
// types an imported service carries (`ul_link_types`).
pub fn compile_to_at(source: Str, tier: Str, path: Str) -> Str {
  if (!supported_tier(tier)) { return "UNKNOWN_TIER|".concat(tier) }
  let verdict = admit_src(source)
  let unlexed = rl_lex_refusal(source)
  if (unlexed != "") { return "REFUSED|BAD|".concat(unlexed) }
  // Issue #2332: every used module reads whole, or nothing is linked.
  let unread = ad_used_modules_refusal(source, path)
  if (unread != "") { return unread }
  // Issue #2363: every `use` resolves, and imports only what its module exports.
  let unimported = ad_imports_refusal(source, path)
  if (unimported != "") { return unimported }
  // FULLY NATIVE from here: native IR producer → use linking → parse → emitter.
  // Issue #2089: the producer also takes the document's host-ref WIRE, so an
  // extern's `refs` survive the native chain and the emitters can see them.
  // Issue #2181: then every pure dependency's extern section.
  // Issue #2374: a private type of the document named like a carried one is
  // renamed apart first, as the reference's privacy pass does.
  let alone = lower_to_ir_refs(source, rf_ref_rows(source, path))
  let named = ul_rename_apart(source, path, alone)
  // Issue #2450: the carried declarations are not only an ADMISSION input. A
  // document the gate admits on its own read can still BUILD a carried variant
  // case (`fn mk() -> Shape { return Dot }`), and the reference's merged
  // program lowers that name as an `adt` because the carried type is in its
  // table. The document read alone has no such case, so the name lowered as a
  // variable and the py tier wrote `return Dot` where the reference writes
  // `return Dot()`. Splice the carried declarations into the lowering text too,
  // always; `ul_link_types` then takes the names as already lowered (`pre`) and
  // does not append them a second time.
  let full = ul_with_carried_text(named, path)
  // Issue #2374 / #2449: and admit what the reference admits, the merged
  // text with every carried declaration spliced in, so a document case that
  // reuses a carried case's name draws the reference's ambiguity refusal.
  let carried = tc_carried_admission(source, path, verdict, full)
  if (carried.refusal != "") { return "REFUSED|".concat(carried.refusal) }
  let pre = carried.names.length() > 0 ? carried.names : full.names
  let lowered = carried.names.length() > 0 ? full.text : named
  let own = lowered == source ? alone : lower_to_ir_refs(lowered, rf_ref_rows(lowered, path))
  let linked = ul_link_externs(ul_link_uses(own, source, path), source, path)
  if (linked.refusal != "") { return "REFUSED|".concat(linked.refusal) }
  // Issue #2308: then the types every imported service carries.
  let typed = ul_link_types(linked.ir, source, path, pre)
  if (typed.refusal != "") { return "REFUSED|".concat(typed.refusal) }
  // Issue #2329: last, the document's calls to an imported service's
  // operations are typed against its declaration. A link refusal above wins,
  // so a type the native link cannot carry is reported as that.
  let calls = tc_admit_imports(named, path, own)
  if (calls != "") { return "REFUSED|".concat(calls) }
  let out = emit_ir(json_parse(typed.ir), tier)
  // Issue #2446: a whole component (or the whole live tier's body) the emitter
  // dropped is a refusal, not a partial program.
  let dropped = dropped_shape_refusal(out, tier)
  if (dropped != "") { return "REFUSED|".concat(dropped) }
  return out
}

pub fn compile_to(source: Str, tier: Str) -> Str {
  // No document path -> no module set to resolve against -> the pre-#2093
  // behavior, byte for byte.
  return compile_to_at(source, tier, "")
}

// ============================================================ manifest parameter
// The load-bearing addition of the "structural frontier" (issue #346): the native
// driver grows a MANIFEST PARAMETER, so the realistic agent shape — admit a
// candidate AGAINST a running composition, the same shape `revl.gate.admit_into`
// (`compile_source(..., manifest=…)`) exercises on py — has an entry point on the
// native tier at all, not just standalone `admit`. `manifest` is the running
// composition's live provision table, serialised as the rows lower.rvl's
// `admit_ambient` reads ("Comp/key/realm;Comp/key/realm;…"); "" is the empty
// manifest, so `admit_into(src, "")` == `admit(src)` exactly.
//
// The admission arm is REAL, not a stub: it is lower.rvl's `admit_ambient`, the
// landed native running-manifest fold (item 186 / issue #86). It recomputes the
// G2 provision-disjointness and multi-realm ROUTE link with the manifest's live
// provisions seeded into the provider table — so a candidate that CONFLICTS with
// what the manifest already holds is refused, and a `realms(...)` route the
// manifest RESOLVES is admitted where the standalone gate would refuse it as
// dangling — byte-identical to `admit_src(manifest_text ++ src)`.
//
// The verdict shape is `admit`'s: "" admits, "<TAG>|<message>" refuses. As with
// `admit`/`admit_src`, "" is "no objection from the layers the native gate runs"
// (composition + guarantee + link over the manifest), NOT a positively typed
// admission — the reference type layer is still out of scope on this tier, so an
// embedder's Verdict keeps `admitted:false` and a "" is fail-closed, never a
// soft "safe to run" (338's ASYMMETRIC clause). What is STILL behind the fold —
// service REPLACEMENT / handoff state override, G3 acyclicity across the manifest
// boundary — is lower.rvl's documented `admit_ambient` frontier, not re-derived
// here (docs/design/186-ambient-admission.md).
pub fn admit_into(source: Str, manifest: Str) -> Str {
  return admit_ambient(source, manifest)
}

// The manifest-aware driver — compile `source` for `tier` AFTER admitting it
// against the running `manifest`. Same fail-closed shape as `compile_to`, with
// the admission arm spanning the manifest:
//   * an unsupported tier   -> "UNKNOWN_TIER|<tier>";
//   * an ambient refusal    -> "REFUSED|<TAG>|<message>" (the emitter never runs —
//                              a program the manifest-aware gate refuses cannot be
//                              compiled, the one revl promise, spanning the
//                              running composition);
//   * an admitted candidate -> the candidate's own target source, emitted through
//                              the SAME native chain `compile_to` runs (lower_to_ir
//                              → json_parse → emit_<tier>_src); the manifest was
//                              the admission context, not extra source to emit.
// `admit_ambient` is a SUPERSET of the standalone gate on the link (it resolves a
// manifest-provided route the standalone gate refuses), so this admits-then-emits
// directly rather than routing back through `compile_to` (whose standalone
// `admit_src` would re-refuse exactly that resolved-by-manifest candidate).
pub fn compile_to_into(source: Str, tier: Str, manifest: Str) -> Str {
  if (!supported_tier(tier)) { return "UNKNOWN_TIER|".concat(tier) }
  let verdict = admit_ambient(source, manifest)
  if (verdict != "") { return "REFUSED|".concat(verdict) }
  let out = emit_ir(json_parse(lower_to_ir(source)), tier)
  // Issue #2446: same dropped-shape rule as `compile_to_at`.
  let dropped = dropped_shape_refusal(out, tier)
  if (dropped != "") { return "REFUSED|".concat(dropped) }
  return out
}

// ============================================================ component wrap
// A trivial provider so the emitted module is a valid plugin (the pure driver
// functions above are what the cross-check exercises); mirrors the wrapper the
// other self-host stages carry.
service CompileStream {
  fn drive(source: Str, tier: Str) -> Str
}

component Compile provides pipeline: CompileStream {
  provide pipeline {
    fn drive(source, tier) = compile_to(source, tier)
  }
}

// ================================================================ tests

test "an unsupported tier is reported, not waved through" {
  assert compile_to("fn id(x: Int) -> Int { return x }", "dotnet") == "UNKNOWN_TIER|dotnet"
  assert supported_tier("py")
  assert supported_tier("rust")
  assert supported_tier("ts")
  assert supported_tier("go")
  assert supported_tier("java")
  assert supported_tier("wasm")
  assert !supported_tier("dotnet")
  assert !supported_tier("")
}

test "a refused program never reaches an emitter (G4), natively" {
  let src = "extern emission fn audit_write(msg: Str) -> Int = @py { return 1 } service Cache { fn put(key: Str) } component C provides cache: Cache { provide cache { fn put(key) { let n = emit audit_write(key) } } }"
  let out = compile_to(src, "py")
  // the native gate's verdict, carrying the guarantee tag — the emitter never ran
  assert out.slice(0, 11) == "REFUSED|G4|"
}

test "an admitted function program compiles fully-native to py source" {
  let out = compile_to("fn id(x: Int) -> Int { return x }", "py")
  // not a control verdict — real target source, straight from the native chain
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 11) != "UNKNOWN_TIER"
  // the cordis-py backend header the native emitter writes
  assert out.slice(0, 42) == `"""Generated by the revl cordis-py backend`
}

test "an admitted function program compiles fully-native to rust source" {
  let out = compile_to("fn id(x: Int) -> Int { return x }", "rust")
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 43) == "//! Generated by the revl cordis-rs backend"
}

test "an admitted function program compiles fully-native to ts source (item 146)" {
  let out = compile_to("fn id(x: Int) -> Int { return x }", "ts")
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 11) != "UNKNOWN_TIER"
  assert out.slice(0, 27) == "// Generated by revl backen"
}

test "admit_into with the empty manifest is exactly the standalone gate (issue #346)" {
  // "" manifest -> admit_into answers the same question `admit` does, verbatim.
  let src = "fn id(x: Int) -> Int { return x }"
  assert admit_into(src, "") == admit(src)
  assert admit_into(src, "") == ""
  // A standalone refusal still surfaces through the manifest entry point.
  let bad = "extern emission fn audit_write(msg: Str) -> Int = @py { return 1 } service Cache { fn put(key: Str) } component C provides cache: Cache { provide cache { fn put(key) { let n = emit audit_write(key) } } }"
  assert admit_into(bad, "").slice(0, 3) == "G4|"
}

test "admit_into refuses a candidate that conflicts with the running manifest (ambient G2, issue #346)" {
  // A candidate providing a key the manifest already holds is an ambient G2
  // conflict — a refusal the STANDALONE gate cannot see, now reachable natively.
  let cand = "service D { fn q(s: Str) -> Int } component NewStore provides db: D { provide db { fn q(s) { let x = s   return 0 } } }"
  assert admit_into(cand, "OldStore/db/") == "G2|provision conflict: key `db` is provided by both OldStore and NewStore (G2)"
  // A DISJOINT manifest key raises no objection: the same candidate admits.
  assert admit_into(cand, "OldCache/cache/") == ""
}

test "compile_to_into is manifest-aware: admit-against-manifest then emit (issue #346)" {
  let cand = "service D { fn q(s: Str) -> Int } component NewStore provides db: D { provide db { fn q(s) { let x = s   return 0 } } }"
  // "" manifest -> the standalone compile, byte-for-byte.
  assert compile_to_into(cand, "py", "") == compile_to(cand, "py")
  // A manifest conflict is refused; the emitter never runs.
  assert compile_to_into(cand, "py", "OldStore/db/").slice(0, 11) == "REFUSED|G2|"
  // Admitted against a disjoint manifest -> real target source, not a verdict.
  let out = compile_to_into(cand, "py", "OldCache/cache/")
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 42) == `"""Generated by the revl cordis-py backend`
  // Unsupported tier is reported first, even with a held manifest.
  assert compile_to_into(cand, "dotnet", "OldCache/cache/") == "UNKNOWN_TIER|dotnet"
}

test "the three tiers wired by this slice emit target source, not a verdict (item 146 gap 2)" {
  let src = "fn id(x: Int) -> Int { return x }"
  let go = compile_to(src, "go")
  assert go.slice(0, 8) != "REFUSED|"
  assert go.slice(0, 11) != "UNKNOWN_TIER"
  assert go.slice(0, 18) == "// Code generated "
  let java = compile_to(src, "java")
  assert java.slice(0, 8) != "REFUSED|"
  assert java.slice(0, 42) == "// Generated by the revl cordis4j backend "
  let wasm = compile_to(src, "wasm")
  assert wasm.slice(0, 8) != "REFUSED|"
  assert wasm.slice(0, 44) == ";; Generated by the revl cordis-wasm backend"
}

test "a refused program never reaches ANY of the six emitters (G4), natively" {
  let src = "extern emission fn audit_write(msg: Str) -> Int = @py { return 1 } service Cache { fn put(key: Str) } component C provides cache: Cache { provide cache { fn put(key) { let n = emit audit_write(key) } } }"
  assert compile_to(src, "go").slice(0, 11) == "REFUSED|G4|"
  assert compile_to(src, "java").slice(0, 11) == "REFUSED|G4|"
  assert compile_to(src, "wasm").slice(0, 11) == "REFUSED|G4|"
}

test "the driver resolves `use` only when it is given a document path (issue #2093)" {
  // With no path there is no module set to resolve against, so the two-argument
  // driver is the identity — `compile_to` is unchanged byte for byte.
  let one = "fn id(x: Int) -> Int { return x }"
  assert compile_to_at(one, "py", "") == compile_to(one, "py")
  // The `use` scanner sees exactly the top-level declarations, in order.
  let nl = str_newline()
  let pairs = ul_use_pairs("use \"a.rvl\" { A, B }".concat(nl).concat("fn f() -> Int { return 1 }").concat(nl))
  assert pairs.length() == 4
  assert pairs[0] == "a.rvl"
  assert pairs[1] == "A"
  assert pairs[2] == "a.rvl"
  assert pairs[3] == "B"
  // A second declaration on a later line is seen too.
  let two = ul_use_pairs("use \"a.rvl\" { A }".concat(nl).concat("use \"b.rvl\" { B }"))
  assert two.length() == 4
  assert two[0] == "a.rvl"
  assert two[2] == "b.rvl"
  // A `use` that is not at column 0 is a comment or an indented line, not a
  // declaration.
  assert ul_use_pairs("// use \"a.rvl\" { A }").length() == 0
  assert ul_use_pairs(" use \"a.rvl\" { A }").length() == 0
  assert ul_use_pairs("fn f() -> Int { return 1 }").length() == 0
  // The brace matcher is string-aware: the `}` inside a string does not close.
  assert ul_match_close("{\"a\": \"}\", \"b\": {}}", 0) == 18
  // A service row is only matched at a KEY position.
  assert ul_service_entry("{\"services\": {}}", "A") == ""
  assert ul_service_entry("{\"services\": {\"CliDispatch\": {\"m\": {}}}}", "Cli") == ""
  assert ul_service_entry("{\"services\": {\"A\": {\"m\": {}}}}", "A") == "{\"m\": {}}"
  // Appending keeps the document's own rows first, and an empty table takes no
  // separator.
  let own = "{\"services\": {\"C\": {\"m\": {}}}}"
  assert ul_append_service(own, "A", "{\"m\": {}}") == "{\"services\": {\"C\": {\"m\": {}}, \"A\": {\"m\": {}}}}"
  assert ul_append_service("{\"services\": {}}", "A", "{\"m\": {}}") == "{\"services\": {\"A\": {\"m\": {}}}}"
}

test "a used module's extern section is appended at the IR's top level (issue #2181)" {
  // Only a depth-1 key is found: the `externs` inside a service row is not it.
  let ir = "{\"services\": {\"S\": {\"externs\": []}}, \"components\": [], \"types\": {}}"
  assert ul_top_key(ir, "externs") == 0 - 1
  assert ul_top_key(ir, "components") == 51
  // The matcher closes an array as well as an object.
  assert ul_match_close("[{\"a\": \"]\"}, []]", 0) == 15
  // No `externs` key: the array is created where the producer writes it,
  // after `functions`, else `types`, else `components`.
  assert ul_append_externs(ir, "{\"name\": \"e\"}") == "{\"services\": {\"S\": {\"externs\": []}}, \"components\": [], \"types\": {}, \"externs\": [{\"name\": \"e\"}]}"
  let fns = "{\"components\": [], \"types\": {}, \"functions\": [], \"tests\": []}"
  assert ul_append_externs(fns, "{}") == "{\"components\": [], \"types\": {}, \"functions\": [], \"externs\": [{}], \"tests\": []}"
  assert ul_append_externs("{\"components\": []}", "{}") == "{\"components\": [], \"externs\": [{}]}"
  // A non-array `externs` value is left alone.
  assert ul_append_externs("{\"externs\": 1, \"x\": []}", "{}") == "{\"externs\": 1, \"x\": []}"
  // An existing array keeps the document's own externs first.
  let own = "{\"components\": [], \"externs\": [{\"name\": \"d\"}]}"
  assert ul_append_externs(own, "{\"name\": \"e\"}") == "{\"components\": [], \"externs\": [{\"name\": \"d\"}, {\"name\": \"e\"}]}"
  assert ul_append_externs(own, "") == own
  assert ul_array_items(own, "externs") == "{\"name\": \"d\"}"
  assert ul_array_items(ir, "externs") == ""
  // Paths are kept sorted and distinct.
  var none: List[Str] = []
  let ps = ul_insert_sorted(ul_insert_sorted(ul_insert_sorted(none, "/z"), "/a"), "/z")
  assert ps.length() == 2
  assert ps[0] == "/a"
  assert ps[1] == "/z"
  // With no document path nothing resolves, so nothing is linked.
  let unlinked = ul_link_externs(own, "use \"stdlib/json.rvl\" { json_parse }", "")
  assert unlinked.ir == own
  assert unlinked.refusal == ""
  // The keys and names the refusals read.
  let keys = ul_top_keys("{\"a\": {\"b\": 1}, \"c\": [\"d\"], \"e\": \"f\"}")
  assert keys.length() == 3
  assert keys[1] == "c"
  let names = ul_item_names("{\"name\": \"x\", \"p\": {\"name\": \"y\"}}, {\"name\": \"z\"}")
  assert names.length() == 2
  assert names[1] == "z"
  // A clash is found against the document's externs and functions alike.
  let doc = "{\"components\": [], \"functions\": [{\"name\": \"f\"}], \"externs\": [{\"name\": \"h\"}]}"
  assert ul_name_clash(doc, ["g", "h"]) == "h"
  assert ul_name_clash(doc, ["f"]) == "f"
  assert ul_name_clash(doc, ["g"]) == ""
  // A dependency is linked only when externs are all it carries, and they lowered.
  let ext_only = "{\"ir_version\": 3, \"services\": {}, \"components\": [], \"externs\": [{\"name\": \"e\"}]}"
  assert ul_dep_refusal("/m.rvl", "pub extern pure fn e() -> Int = @py { return 1 }", ext_only) == ""
  let with_fns = "{\"ir_version\": 3, \"services\": {}, \"components\": [], \"functions\": []}"
  assert ul_dep_refusal("/m.rvl", "pub fn f() -> Int { return 1 }", with_fns).slice(0, 5) == "LINK|"
  let bare = "{\"ir_version\": 3, \"services\": {}, \"components\": []}"
  assert ul_dep_refusal("/m.rvl", "pub extern pure fn e() -> Int = @py { return 1 }", bare).slice(0, 5) == "LINK|"
  assert ul_dep_refusal("/m.rvl", "service S {}", bare) == ""
  // A declaration the producer writes no key for is read off the text.
  let nl = str_newline()
  assert ul_foreign_decl("// c".concat(nl).concat("pub extern pure fn e() -> Int = @py {").concat(nl).concat("    return 1").concat(nl).concat("}")) == ""
  assert ul_foreign_decl("pub extern pure fn e() -> Int = @py { return 1 }".concat(nl).concat("prop test \"p\" {}")) == "prop test \"p\" {}"
  assert ul_dep_refusal("/m.rvl", "prop test \"p\" {}", ext_only).slice(0, 5) == "LINK|"
  // An alias import resolves nothing without a path, and a `{ }` list is not one.
  assert ul_alias_target("use \"a.rvl\" as a", "") == ""
  assert ul_alias_target("use \"a.rvl\" { A }", "") == ""
}

test "an imported service carries the public types it names (issue #2308)" {
  let nl = str_newline()
  // A column-0 host line inside an extern body is not a declaration; one
  // after the body closes is.
  let ext = "pub extern pure fn g(x: Int) -> Int = @py {".concat(nl).concat("return x").concat(nl)
    .concat("} = @ts {").concat(nl).concat("return x").concat(nl).concat("}")
  assert ul_foreign_decl(ext) == ""
  assert ul_foreign_decl(ext.concat(nl).concat("fn f() -> Int { return 1 }")) == "fn f() -> Int { return 1 }"
  // A `{` inside a host string does not open, and a `@` with no body is skipped.
  assert ul_host_body_end("@ts { \"{\" } x", 0) == 11
  assert ul_host_body_end("@py ref s from \"p\"", 0) == 1
  // Identifiers of a type expression, and of a key's string values only.
  let ids = ul_type_idents("Map[Str, List[Row2]]")
  assert ids.length() == 4
  assert ids[3] == "Row2"
  let row = "{\"methods\": {\"put\": {\"params\": [{\"name\": \"type\", \"type\": \"Item\"}], \"returns\": null}}}"
  assert ul_key_idents(row, "type").length() == 1
  assert ul_key_idents(row, "returns").length() == 0
  assert ul_value_idents("{\"Ref\": \"Str\"}")[0] == "Str"
  assert ul_type_scan("type A = { a: Int }".concat(nl).concat("pub type B = A")).pubs.length() == 1
  let tabbed = ul_type_scan("pub".concat(str_tab()).concat("type  T = { a: Int }").concat(nl).concat("pubtype U = {}").concat(nl).concat("pub typeV = {}")).pubs
  assert tabbed.length() == 1
  assert tabbed[0] == "T"
  let both = ul_type_scan("type P = Int".concat(nl).concat("pub type Q = P").concat(nl).concat("typeR = {}")).all
  assert both.length() == 2
  assert both[0] == "P"
  assert both[1] == "Q"
  // By token at any column and depth 0: indented, two on a line, and never a
  // record field, a string or a host body.
  let flat = ul_type_scan("  type A = Int; pub type B = { type: A }".concat(nl)
    .concat("// type C").concat(nl).concat("extern pure fn e() -> Int = @py { type = 1 }")).all
  assert flat.length() == 2
  assert flat[0] == "A"
  assert flat[1] == "B"
  assert ul_type_scan("  pub type B = A; type A = Int").pubs[0] == "B"
  // Every string form the reference lexes hides its braces and quotes.
  let q = "\""
  let sq = ul_type_scan("fn s() -> Str { return '}' }".concat(nl).concat("type Id = Int"))
  assert sq.ok
  assert sq.all[0] == "Id"
  assert ul_type_scan("let a = '".concat(q).concat("{\\\\'").concat(nl).concat("type Id = Int")).all[0] == "Id"
  assert ul_type_scan("let a = ".concat(q).concat(q).concat(q).concat(" ").concat(q).concat(" { ").concat(q).concat(q).concat(q).concat(nl).concat("type Id = Int")).all[0] == "Id"
  assert ul_type_scan("let a = `${ {x: `}`}.x } }`".concat(nl).concat("type Id = Int")).all[0] == "Id"
  assert ul_type_scan("extern fn e() -> Int = @rust { '}' }".concat(nl).concat("type Id = Int")).all[0] == "Id"
  // It fails closed on what the reference rejects or cannot balance.
  assert !ul_type_scan("let a = 'x").ok
  assert !ul_type_scan("let a = `x ${ y").ok
  assert !ul_type_scan("let a = `x ${ f('}') }`").ok
  assert !ul_type_scan("let a = `x ${ }`").ok
  assert !ul_type_scan("type R = { type: Int }").ok
  assert !ul_type_scan("let a = ".concat(q).concat(q).concat(q).concat("x")).ok
  assert !ul_type_scan("fn f() { }}").ok
  assert !ul_type_scan("fn f() { ").ok
  assert !ul_type_scan("extern fn e() -> Int = @py { ").ok
  // The closure is public-only, transitive, and in declaration order.
  let mod_ir = "{\"types\": {\"C\": {\"fields\": {\"x\": \"Int\"}}, \"H\": {\"fields\": {}}, \"T\": {\"cases\": [{\"name\": \"K\", \"payload\": \"C\"}]}, \"R\": {\"fields\": {\"t\": \"T\", \"h\": \"H\"}}}}"
  let mod_src = "pub type C = { x: Int }".concat(nl).concat("type H = {}").concat(nl)
    .concat("pub type T = K(C)").concat(nl).concat("pub type R = { t: T, h: H }")
  let carry = ul_carried_types("/m.rvl", mod_ir, mod_src, "{\"params\": [{\"type\": \"List[R]\"}]}")
  assert carry.refusal == ""
  assert carry.names.length() == 3
  assert carry.names[0] == "C"
  assert carry.names[1] == "T"
  assert carry.names[2] == "R"
  // A public type the producer did not lower is refused, not dropped.
  assert ul_carried_types("/m.rvl", "{}", mod_src, "{\"returns\": \"C\"}").refusal.slice(0, 5) == "LINK|"
  // Types land after the document's own, or right after `components`.
  assert ul_append_types("{\"components\": [], \"functions\": []}", "\"C\": {}") == "{\"components\": [], \"types\": {\"C\": {}}, \"functions\": []}"
  assert ul_append_types("{\"components\": [], \"types\": {\"O\": {}}}", "\"C\": {}") == "{\"components\": [], \"types\": {\"O\": {}, \"C\": {}}}"
  assert ul_bump_v3("{\"ir_version\": 1, \"services\": {}}") == "{\"ir_version\": 3, \"services\": {}}"
  // With no document path nothing resolves, so nothing is carried.
  var no_pre: List[Str] = []
  let unlinked = ul_link_types("{\"components\": []}", "use \"lib.rvl\" { Store }", "", no_pre)
  assert unlinked.ir == "{\"components\": []}"
  assert unlinked.refusal == ""
  // Issue #2374: a rename apart touches whole identifiers outside strings and
  // comments only, and only a name the IR holds as a type alone qualifies.
  assert ul_rename_word("type In = { a: In } // In".concat(nl).concat("let s = \"In\" + Ink"), "In", "In__m0") == "type In__m0 = { a: In__m0 } // In".concat(nl).concat("let s = \"In\" + Ink")
  assert ul_renamable("{\"types\": {\"In\": {}}, \"f\": {\"type\": \"In\"}}", "In")
  assert !ul_renamable("{\"types\": {\"In\": {\"cases\": [{\"name\": \"In\"}]}}}", "In")
  assert !ul_renamable("{\"services\": {\"In\": {}}, \"types\": {\"In\": {}}}", "In")
  assert !ul_renamable("{\"services\": {\"O\": {\"returns\": \"List[In]\"}}, \"types\": {\"In\": {}}}", "In")
  assert !ul_renamable("{\"components\": [{\"type\": \"In\"}], \"types\": {\"In\": {}}}", "In")
}

test "an admitted component program compiles fully-native, both tiers (item 262)" {
  // a service + provider — the native IR producer now carries the component/method
  // body all the way through json_parse into the native emitter, no reference.
  let src = "service Greeter { fn hi(name: Str) -> Str } component Hello provides g: Greeter { provide g { fn hi(name) { return name } } }"
  let py = compile_to(src, "py")
  assert py.slice(0, 8) != "REFUSED|"
  assert py.slice(0, 42) == `"""Generated by the revl cordis-py backend`
  let rs = compile_to(src, "rust")
  assert rs.slice(0, 8) != "REFUSED|"
  assert rs.slice(0, 43) == "//! Generated by the revl cordis-rs backend"
  let ts = compile_to(src, "ts")
  assert ts.slice(0, 8) != "REFUSED|"
  assert ts.slice(0, 27) == "// Generated by revl backen"
}
