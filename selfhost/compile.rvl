// THE CAPSTONE — the integrated, FULLY-NATIVE `revl_compile`, in revl (roadmap
// item 230, extending 224). Where the lexer/parser/checker/lower stages each port
// ONE compiler pass and the emit_* stages port the tail, THIS file is the driver
// that composes the self-host stages into ONE co-compiled revl pipeline: it runs
// the native FRONTEND over source, PRODUCES the native interchange IR, and hands
// that IR to the native EMITTER — target source built by revl, from source, in a
// single in-file composition with NO reference anywhere in the chain (for the
// function surface; see WHAT IS NATIVE for the exact boundary).
//
// ============================================================ THE PIPELINE
//   source ──▶ admit_src (lower.rvl)          the native FRONTEND admission gate:
//                                             lexer.rvl → parser.rvl → the checker
//                                             → the lowering ADMISSION gate. "" ad-
//                                             mits; "<TAG>|<message>" refuses. The
//                                             one revl promise — a program the
//                                             checker rejects cannot be compiled —
//                                             is enforced HERE, before any emitter.
//          ──▶ lower_to_ir (lower.rvl)        the native IR PRODUCER (item 232):
//                                             source → the emittable interchange IR
//                                             (JSON), byte-exact vs the reference
//                                             lowering for the module-FUNCTION +
//                                             TYPE surface, and emitter-ready.
//          ──▶ json_parse (stdlib/json.rvl)   the JSON text → the `Any` value the
//                                             emitters navigate (stdlib/value.rvl).
//          ──▶ emit_py_src / emit_rust_src /   the native EMITTER, dispatched on
//              emit_ts_src                    tier: IR → target source, byte-exact
//              (emit_py.rvl / emit_rust.rvl / vs the reference emitter.
//               emit_ts.rvl)
//
// The WHOLE chain lex→parse→check→lower→emit is native revl, co-compiled into one
// artifact: `compile.rvl` `use`s lower.rvl (which `use`s lexer+parser), emit_py.rvl,
// emit_rust.rvl AND emit_ts.rvl in ONE composition. This is what items 228 + 230
// unlocked — 228 stopped a `use`d module's PRIVATE decls from leaking (so the four
// stages' private `Ctx`/`node_kind`/… no longer collide), and 230 gave the emitter
// entrypoints DISTINCT public names (`emit_py_src` / `emit_rust_src`, and now
// `emit_ts_src`) so the merge, which flattens public decls by bare name, no longer
// sees a duplicate `emit_src`. Item 146 gap 2 wires the ts tier the same way: the
// rename is the whole cost of admitting a tier, since the three surviving emitters
// (go/java/wasm) still export a bare `emit_src` and so still cannot co-compile.
// Both former SEAMs (224's header: the reference IR in the middle; the stages not
// co-compiling) are now CLOSED for the function surface.
//
// ============================================================ WHAT IS NATIVE
// FULLY NATIVE — no reference in the chain — for the module-FUNCTION + TYPE
// surface: every module `fn` (its full typed-expression body) and every user
// `type` (record/variant). `compile_to(source, "py")` over this surface equals the
// reference `revl compile --backend py` BYTE-FOR-BYTE, produced entirely in revl
// (lower_to_ir + emit_py_src, both native); same for rust where the rust emitter
// covers the form. Proven in tests/test_selfhost_compile.py.
//
// FULLY NATIVE too — the typed COMPONENT + extern surface (item 262). Items 242 +
// 241 made the native IR producer COMPLETE: the full typed component/method body
// (effect/undo, emit/compensate sagas, if+fail guards, timers, config reads,
// provide-method bodies) and the verbatim `@backend` extern bodies now lower byte-
// exact, and each tier's native emitter covers the form. So `compile_to` over a
// component program equals the reference compile BYTE-FOR-BYTE for both tiers, end
// to end in revl — the services/types/externs/functions sections carry through
// json_parse into the native emitter with no reference anywhere. That was the last
// seam; the covered surface is now entirely self-compiled.
//
// ALSO NATIVE — the ts tier (roadmap item 146, gap 2). `emit_ts.rvl` is renamed to
// `emit_ts_src` and dispatched here, so `compile_to(source, "ts")` runs the same
// fully-native chain and equals `revl compile --backend ts` BYTE-FOR-BYTE over the
// fifteen emit_ts corpus documents listed in tests/test_selfhost_compile.py — eight
// function documents and seven component ones, the ir_version-1 dispatch included.
// The ts emitter is byte-exact on ALL 34 of its own corpus documents, but that
// oracle feeds it the REFERENCE IR; the remaining nineteen are held out here
// because the NATIVE `lower_to_ir` — not the emitter — does not yet reproduce them:
//   * ASYNC is not carried at all (an async extern/fn lowers without its `async`
//     stamp, so the native emit says `export function f(): T` where the reference
//     says `export async function f(): Promise<T>`);
//   * the realm/`intercept` metadata and the `spawn`/`Frame`/`record` runtime-import
//     gates are not reproduced.
// Those are lower.rvl gaps shared by every tier, not ts ones.
//
// NOT NATIVE, ON ANY TIER — the declared `Secret[T]` marking (found while wiring ts;
// see tests/test_selfhost_compile.py's strict-xfail pin for the full write-up).
// `src/revl/taint.py` strips the qualifier and sets the three stamps every backend
// redacts from; the self-host frontend has no counterpart (zero occurrences of
// "secret" in lexer/parser/checker/lower.rvl). So a program declaring `Secret[T]`
// compiles natively to a module MISSING its whole marking on py and on ts alike,
// even though both native EMITTERS were ported and are byte-exact on their own
// `secrets.rvl` corpus document when fed the reference IR. Pre-existing, not
// ts-specific, and stated here rather than left to be rediscovered.
//
// Ground truth is the reference; on the covered surface any divergence is a defect
// in a stage.

use "./lower.rvl" { admit_src, admit_ambient, lower_to_ir, lower_to_ir_refs }
use "./emit_py.rvl" { emit_py_src }
use "./emit_rust.rvl" { emit_rust_src }
use "./emit_ts.rvl" { emit_ts_src }
use "./emit_go.rvl" { emit_go_src }
use "./emit_java.rvl" { emit_java_src }
use "./emit_wasm.rvl" { emit_wasm_src }
use "../stdlib/json.rvl" { json_parse }
use "../stdlib/str.rvl" { str_newline }

// The tiers whose self-host emitter is byte-exact against its reference on this
// surface AND whose entrypoint has a distinct public name, so it can co-compile
// here. As of this slice that is ALL SIX: the three remaining bare `emit_src`
// entrypoints (go/java/wasm) were renamed to `emit_go_src`/`emit_java_src`/
// `emit_wasm_src`, which was the whole cost of admitting a tier. An unknown tier
// is still reported, never silently waved through as if the pipeline covered it.
fn supported_tier(tier: Str) -> Bool {
  if ((tier == "py") || (tier == "rust")) { return true }
  if ((tier == "ts") || (tier == "go")) { return true }
  return (tier == "java") || (tier == "wasm")
}

// The native FRONTEND admission gate: the cordis verdict over the source, run
// entirely in revl (lower.rvl's `admit_src` drives lexer.rvl, parser.rvl, the
// checker and the lowering admission). "" admits; "<TAG>|<message>" refuses.
pub fn admit(source: Str) -> Str {
  return admit_src(source)
}

// The integrated, FULLY-NATIVE driver — the capstone entry point. For a supported,
// admitted program it runs the WHOLE native chain in this one co-compiled file and
// returns the TARGET SOURCE:
//   * an unsupported tier   -> "UNKNOWN_TIER|<tier>";
//   * a program the native  -> "REFUSED|<TAG>|<message>" (the native gate's own
//     gate refuses              verdict; the IR producer and emitter never run —
//                               a rejected program cannot be compiled, the one
//                               revl promise, enforced natively);
//   * an admitted program   -> the emitted target source, built end to end in revl:
//                               lower_to_ir(source) → json_parse → emit_<tier>_src.
//                               NO reference is in this chain. Byte-exact with the
//                               reference compile for the function + type surface AND
//                               the component + extern surface (item 262; see WHAT IS
//                               NATIVE).
// A control verdict ("UNKNOWN_TIER|"/"REFUSED|") never collides with target source:
// the emitted py source begins `"""Generated by the revl cordis-py backend …`, the
// rust source `//! Generated by the revl cordis-rs backend …`, and the ts source

// The native EMITTER tail, factored out so the standalone and the against-a-
// manifest drivers share ONE dispatch: interchange IR → target source for the
// tier. Callers admit FIRST (a rejected program cannot be compiled); this runs
// only on an admitted program.
fn emit_ir(ir: Any, tier: Str) -> Str {
  if (tier == "py") { return emit_py_src(ir) }
  if (tier == "ts") { return emit_ts_src(ir) }
  if (tier == "go") { return emit_go_src(ir) }
  if (tier == "java") { return emit_java_src(ir) }
  if (tier == "wasm") { return emit_wasm_src(ir) }
  return emit_rust_src(ir)
}

// ============================================================ use resolution
// Issue #2093. The driver above resolved no `use`: it handed `lower_to_ir` the
// ONE document text it was given, so a document that imports a component from a
// SIBLING module — `src/revl/truc/components/cli.rvl`'s
// `use "assembler.rvl" { Assembler }` / `use "shipper.rvl" { Shipper }` — lowered
// without those modules' service rows. The reference composes the FILE SET and
// carries each DIRECT import's row into the document's `services` table; the
// native chain carried only the document's own. That is a HARNESS/API limitation,
// not a `lower.rvl` one: the IR producer is handed one string and cannot know a
// module set exists. So the driver grows a PATH — `compile_to_at(source, tier,
// path)` resolves the document's `use` targets through `read_module` (the first
// host crossing: a READ, no accounted mutation — the boundary `stdlib/auth.rvl`'s
// `host_validate` draws) and APPENDS each imported name's service row, in
// declaration order, after the document's own. `compile_to` keeps its exact
// two-argument behavior: with no document path there is nothing to resolve a
// relative `use` against, so it is the identity on the IR.

// The FIRST host crossing of this driver: read the module a `use` names. `base` is
// the importing document's path ("" when the caller had none), `target` the
// literal `use` target. Resolution follows the reference loader: the target as
// written, relative to the importing document's directory, then the same relative
// path walked up through the document's ancestors — which is how `cli.rvl`'s
// sibling imports and the canary's `stdlib/json.rvl` both resolve. "" when
// nothing is there, so an unresolvable import is skipped rather than fatal.
extern pure fn read_module(base: Str, target: Str) -> Str = @py {
    import os
    if base == "" or target == "":
        return ""
    cur = os.path.dirname(base)
    for _ in range(0, 12):
        cand = os.path.join(cur, target) if cur else target
        if os.path.isfile(cand):
            with open(cand, "r", encoding="utf-8") as fh:
                return fh.read()
        if not cur:
            break
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    return ""
}

// Issue #2089: the SECOND host crossing, and the reason the first one cannot
// double for it. An extern's `= @backend ref SYM from "PATH"` arm lowers to the
// IR's `refs` — `{symbol, path, sha256[, root]}` — and NONE of those three
// values is in the text: `path` is the target's path relative to the root it
// jails to, `sha256` is a digest of the target's BYTES, and `root` says whether
// that root is the install origin or the composition's own tree. The reference
// resolves all three in `src/revl/hostref.py::resolve_refs`, off the declaring
// document's realpath and the install origin. So the driver probes the host once
// per ref and hands the producer the result on a wire
// (`lower.rvl::lower_to_ir_refs`), rather than letting a producer that reads only
// tokens guess at values it cannot see.
//
// The answer is `SHA256 | ROOT-KIND | ROOT-RELATIVE-PATH`, or ""
// when the ref cannot be resolved (no such file, or a target outside the jail —
// the reference REFUSES that program outright, `_resolve_ref_disk`'s
// `_outside_root_hint`; the driver's covered surface has no refusal channel for
// it, so the arm is dropped and the divergence is stated here instead of being
// emitted as a broken import path).
//
// The JAIL mirrors `compiler.py::_origin_install_root`'s two arms:
//
//   * the document's realpath is contained in the toolchain's `stdlib/` — the
//     install-origin arm — so the jail is that stdlib's PARENT (the checkout
//     root, or `site-packages/revl` in a wheel) and the kind is `"stdlib"`. The
//     stdlib is recognised by a member module (`stdlib/fs.rvl`) and not by the
//     directory's NAME: the repo has two other directories called `stdlib`
//     (`backends/go/v3/stdlib`, `docs/census-artifact/cases/stdlib`) and neither
//     is one.
//   * otherwise the USER-origin arm: the jail is the document's own directory
//     and there is no kind — item 396 option B, where `root_dirs` is the root
//     compile files' directories, and the driver's one root file is this
//     document.
//
// What is NOT mirrored is the item-319 search-path record (arm 1 of
// `_origin_install_root`): the driver's `use` walk resolves a module by walking
// the document's ancestors, so it has no entry to record. A `REVL_IMPORT_PATH`
// stand-in therefore classifies by containment, like a stdlib module reached
// relatively — the arm `_origin_install_root` documents as equivalent.
extern pure fn ref_probe(base: Str, refpath: Str) -> Str = @py {
    import hashlib
    import os
    if base == "" or refpath == "":
        return ""
    docdir = os.path.realpath(os.path.dirname(os.path.abspath(base)))
    real = os.path.realpath(os.path.join(docdir, refpath))
    if not os.path.isfile(real):
        return ""
    jail = ""
    kind = ""
    probe = docdir
    for _ in range(0, 16):
        if os.path.basename(probe) == "stdlib" and os.path.isfile(
                os.path.join(probe, "fs.rvl")):
            jail = os.path.dirname(probe)
            kind = "stdlib"
            break
        parent = os.path.dirname(probe)
        if parent == probe:
            break
        probe = parent
    if jail == "":
        jail = docdir
    rel = os.path.relpath(real, jail)
    if rel == os.pardir or rel.startswith(os.pardir + os.sep):
        return ""
    if os.path.isabs(rel):
        return ""
    with open(real, "rb") as fh:
        digest = hashlib.sha256(fh.read()).hexdigest()
    return digest + "|" + kind + "|" + rel.replace(os.sep, "/")
}

// Index of `sub` in `s` at or after `start`, or -1. (The base `Str.indexOf`
// takes no start offset, so the scans below carry their own.)
fn ul_find(s: Str, sub: Str, start: Int) -> Int {
  let n = s.length()
  let m = sub.length()
  var i = start
  if (i < 0) { i = 0 }
  if (m == 0) { return i }
  while (i + m <= n) {
    if (s.slice(i, i + m) == sub) { return i }
    i += 1
  }
  return 0 - 1
}

// `revl` string literals carry no `\n` escape (a `"\n"` is backslash + `n`, the
// lexer's no-escape semantics), so whitespace is recognised by code point and
// the newline comes from `stdlib/str.rvl`'s `str_newline()`.
fn ul_is_ws(c: Str) -> Bool {
  if (c == "") { return false }
  let k = c.charCodeAt(0)
  if (k == 32) { return true }
  if (k == 9) { return true }
  if (k == 10) { return true }
  return k == 13
}

fn ul_trim(s: Str) -> Str {
  var a = 0
  var b = s.length()
  while ((a < b) && ul_is_ws(s.slice(a, a + 1))) { a += 1 }
  while ((b > a) && ul_is_ws(s.slice(b - 1, b))) { b -= 1 }
  return s.slice(a, b)
}

// Index of the first non-space byte at or after `i` (or `s.length()`).
fn ul_skip_ws(s: Str, i: Int) -> Int {
  var j = i
  let n = s.length()
  while ((j < n) && ul_is_ws(s.slice(j, j + 1))) { j += 1 }
  return j
}

// The end of the line holding `i`: the next newline, or the end of the text.
fn ul_line_end(s: Str, i: Int) -> Int {
  var j = i
  let n = s.length()
  while (j < n) {
    if (s.slice(j, j + 1).charCodeAt(0) == 10) { return j }
    j += 1
  }
  return n
}

// The index of the `}` matching the `{` at `open_at`, or -1. String-aware: a
// brace inside a JSON string does not count, and an escaped quote does not close
// one. (A service row holds only method/param/type names, but the matcher does
// not rely on that.)
fn ul_match_brace(s: Str, open_at: Int) -> Int {
  var depth = 0
  var in_str = false
  var esc = false
  var i = open_at
  let n = s.length()
  while (i < n) {
    let ch = s.slice(i, i + 1)
    if (in_str) {
      if (esc) { esc = false }
      else {
        if (ch == "\\") { esc = true }
        else { if (ch == "\"") { in_str = false } }
      }
    }
    else {
      if (ch == "\"") { in_str = true }
      else {
        if (ch == "{") { depth += 1 }
        else {
          if (ch == "}") {
            depth -= 1
            if (depth == 0) { return i }
          }
        }
      }
    }
    i += 1
  }
  return 0 - 1
}

// The index of the `{` opening the top-level `services` object of a native IR
// document, or -1.
fn ul_services_open(ir: Str) -> Int {
  let at = ul_find(ir, "\"services\"", 0)
  if (at < 0) { return 0 - 1 }
  return ul_find(ir, "{", at)
}

// The `{ … }` JSON text of the service row named `name` in `module_ir`, or ""
// when the module declares no such row. The quoted key must be followed by `:`,
// so a service `Cli` does not match a `CliDispatch` key.
fn ul_service_entry(module_ir: Str, name: Str) -> Str {
  let at = ul_services_open(module_ir)
  if (at < 0) { return "" }
  let close = ul_match_brace(module_ir, at)
  if (close < 0) { return "" }
  let obj = module_ir.slice(at, close + 1)
  let key = "\"".concat(name).concat("\"")
  var k = ul_find(obj, key, 0)
  while (k >= 0) {
    let nxt = ul_skip_ws(obj, k + key.length())
    if (obj.slice(nxt, nxt + 1) == ":") {
      let b = ul_find(obj, "{", k)
      if (b < 0) { return "" }
      let e = ul_match_brace(obj, b)
      if (e < 0) { return "" }
      return obj.slice(b, e + 1)
    }
    k = ul_find(obj, key, k + 1)
  }
  return ""
}

// `ir` with `"name": entry` APPENDED to its top-level `services` object.
// Appending — never prepending — is load-bearing: the reference puts the
// document's own rows first and its imports after, and the emitted bytes follow
// that order.
fn ul_append_service(ir: Str, name: Str, entry: Str) -> Str {
  let at = ul_services_open(ir)
  if (at < 0) { return ir }
  let close = ul_match_brace(ir, at)
  if (close < 0) { return ir }
  var sep = ""
  if (close > at + 1) { sep = ", " }
  let ins = sep.concat("\"").concat(name).concat("\": ").concat(entry)
  return ir.slice(0, close).concat(ins).concat(ir.slice(close, ir.length()))
}

// The document's TOP-LEVEL `use "target" { A, B }` imports, flattened as
// `target, name, target, name, …` in declaration order. A `use` counts only at
// column 0 (a leading `//` or indentation makes it a comment or a nested line,
// not a declaration) and only when a `{ … }` list follows on the same line — the
// reference's own shape.
fn ul_use_pairs(source: Str) -> List[Str] {
  var out: List[Str] = []
  var i = ul_find(source, "use ", 0)
  while (i >= 0) {
    if ((i == 0) || (source.slice(i - 1, i).charCodeAt(0) == 10)) {
      let eol = ul_line_end(source, i)
      let q0 = ul_find(source, "\"", i)
      let lb = ul_find(source, "{", i)
      if ((q0 >= 0) && (q0 < eol) && (lb >= 0) && (lb < eol)) {
        let q1 = ul_find(source, "\"", q0 + 1)
        let rb = ul_find(source, "}", lb)
        if ((q1 >= 0) && (q1 < eol) && (rb >= 0)) {
          let target = source.slice(q0 + 1, q1)
          let parts = source.slice(lb + 1, rb).split(",")
          var p = 0
          while (p < parts.length()) {
            let name = ul_trim(parts[p])
            if (name != "") {
              out = out.push(target)
              out = out.push(name)
            }
            p += 1
          }
        }
      }
    }
    i = ul_find(source, "use ", i + 4)
  }
  return out
}

// The document's IR with every imported service row appended: for each top-level
// `use` name in declaration order whose module resolves, lower that module and
// append its row — unless the document already provides that name. Only DIRECT
// imports enter the table, which is exactly what the reference composes.
fn ul_link_uses(ir: Str, source: Str, path: Str) -> Str {
  let pairs = ul_use_pairs(source)
  var out = ir
  var i = 0
  while (i + 1 < pairs.length()) {
    let target = pairs[i]
    let name = pairs[i + 1]
    i += 2
    if (ul_service_entry(out, name) == "") {
      let module_src = read_module(path, target)
      if (module_src != "") {
        let entry = ul_service_entry(lower_to_ir(module_src), name)
        if (entry != "") { out = ul_append_service(out, name, entry) }
      }
    }
  }
  return out
}

// The identifier starting at `at`, up to the first delimiter. The scans below
// read a name out of a source LINE, where a name is followed by a space, `(`,
// `,`, `:`, `{`, `}`, `"`, `[` or the end of the line.
fn rf_word(s: Str, at: Int) -> Str {
  var j = at
  var out = ""
  let n = s.length()
  while (j < n) {
    let c = s.slice(j, j + 1)
    if (ul_is_ws(c)) { return out }
    if ((c == "(") || (c == ")") || (c == ",") || (c == ":") || (c == "{")
        || (c == "}") || (c == "\"") || (c == "[") || (c == "]")) {
      return out
    }
    out = out.concat(c)
    j += 1
  }
  return out
}

// The host-ref wire for `source` (issue #2089): one row per
// `= @backend ref SYM from "PATH"` arm,
// `NAME | BACKEND | SYMBOL | SHA256 | ROOT | PATH`, in source order — the shape
// `lower.rvl::rw_refs_json` reads. The probe supplies the last three fields
// (`ref_probe`); the scan supplies the first three.
//
// NAME is the ENCLOSING extern's declared name, which is not on the arm's line:
// a ref arm closes its extern's declaration (`… } = @ts ref fsWrite from "…"`),
// so the scan carries the last `extern … fn NAME` it saw and attributes every
// arm after it to that name. Externs are walked in source order, so a name is
// stamped onto the entry the producer emits for it.
//
// No rows when `path` is "" — no document on disk means nothing to resolve a ref
// against, so the driver hands the producer an empty wire and the IR is the
// pre-#2089 one byte for byte.
fn rf_ref_rows(source: Str, path: Str) -> List[Str] {
  var out: List[Str] = []
  if (path == "") { return out }
  var cur = ""
  var i = 0
  let n = source.length()
  while (i < n) {
    let eol = ul_line_end(source, i)
    let line = source.slice(i, eol)
    // A comment line declares nothing; the same discipline `ul_use_pairs`
    // applies to a `use`.
    if (ul_trim(line).slice(0, 2) != "//") {
      let ex = ul_find(line, "extern", 0)
      if (ex >= 0) {
        let fnk = ul_find(line, "fn", ex)
        if (fnk >= 0) { cur = rf_word(line, ul_skip_ws(line, fnk + 2)) }
      }
      let arm = ul_find(line, "= @", 0)
      if ((arm >= 0) && (cur != "")) {
        // `= @backend { … }` (a body) has no ` ref ` and is skipped here; the
        // producer reads the body off the token stream.
        let rk = ul_find(line, " ref ", arm)
        let fk = ul_find(line, " from \"", arm)
        if ((rk >= 0) && (fk >= 0)) {
          let backend = rf_word(line, arm + 3)
          let sym = rf_word(line, rk + 5)
          let q0 = fk + 6
          let q1 = ul_find(line, "\"", q0 + 1)
          if ((backend != "") && (sym != "") && (q1 >= 0)) {
            let probe = ref_probe(path, line.slice(q0 + 1, q1))
            if (probe != "") {
              out = out.push(cur.concat("|").concat(backend).concat("|").concat(sym)
                .concat("|").concat(probe))
            }
          }
        }
      }
    }
    i = eol + 1
  }
  return out
}

// The path-taking driver — the honest multi-file native compile. Identical to
// `compile_to` except that `path` names the document on disk, so its `use`
// declarations resolve and the imported service rows are spliced into the IR
// before the native emitter runs. `path` may be relative; it is resolved against
// the process working directory, and a `use` target is resolved against the
// document's own directory first. A path that resolves nothing changes nothing.
pub fn compile_to_at(source: Str, tier: Str, path: Str) -> Str {
  if (!supported_tier(tier)) { return "UNKNOWN_TIER|".concat(tier) }
  let verdict = admit_src(source)
  if (verdict != "") { return "REFUSED|".concat(verdict) }
  // FULLY NATIVE from here: native IR producer → use linking → parse → emitter.
  // Issue #2089: the producer also takes the document's host-ref WIRE, so an
  // extern's `refs` survive the native chain and the emitters can see them.
  let ir = ul_link_uses(lower_to_ir_refs(source, rf_ref_rows(source, path)), source, path)
  return emit_ir(json_parse(ir), tier)
}

pub fn compile_to(source: Str, tier: Str) -> Str {
  // No document path -> no module set to resolve against -> the pre-#2093
  // behavior, byte for byte.
  return compile_to_at(source, tier, "")
}

// ============================================================ manifest parameter
// The load-bearing addition of the "structural frontier" (issue #346): the native
// driver grows a MANIFEST PARAMETER, so the realistic agent shape — admit a
// candidate AGAINST a running composition, the same shape `revl.gate.admit_into`
// (`compile_source(..., manifest=…)`) exercises on py — has an entry point on the
// native tier at all, not just standalone `admit`. `manifest` is the running
// composition's live provision table, serialised as the rows lower.rvl's
// `admit_ambient` reads ("Comp/key/realm;Comp/key/realm;…"); "" is the empty
// manifest, so `admit_into(src, "")` == `admit(src)` exactly.
//
// The admission arm is REAL, not a stub: it is lower.rvl's `admit_ambient`, the
// landed native running-manifest fold (item 186 / issue #86). It recomputes the
// G2 provision-disjointness and multi-realm ROUTE link with the manifest's live
// provisions seeded into the provider table — so a candidate that CONFLICTS with
// what the manifest already holds is refused, and a `realms(...)` route the
// manifest RESOLVES is admitted where the standalone gate would refuse it as
// dangling — byte-identical to `admit_src(manifest_text ++ src)`.
//
// The verdict shape is `admit`'s: "" admits, "<TAG>|<message>" refuses. As with
// `admit`/`admit_src`, "" is "no objection from the layers the native gate runs"
// (composition + guarantee + link over the manifest), NOT a positively typed
// admission — the reference type layer is still out of scope on this tier, so an
// embedder's Verdict keeps `admitted:false` and a "" is fail-closed, never a
// soft "safe to run" (338's ASYMMETRIC clause). What is STILL behind the fold —
// service REPLACEMENT / handoff state override, G3 acyclicity across the manifest
// boundary — is lower.rvl's documented `admit_ambient` frontier, not re-derived
// here (docs/design/186-ambient-admission.md).
pub fn admit_into(source: Str, manifest: Str) -> Str {
  return admit_ambient(source, manifest)
}

// The manifest-aware driver — compile `source` for `tier` AFTER admitting it
// against the running `manifest`. Same fail-closed shape as `compile_to`, with
// the admission arm spanning the manifest:
//   * an unsupported tier   -> "UNKNOWN_TIER|<tier>";
//   * an ambient refusal    -> "REFUSED|<TAG>|<message>" (the emitter never runs —
//                              a program the manifest-aware gate refuses cannot be
//                              compiled, the one revl promise, spanning the
//                              running composition);
//   * an admitted candidate -> the candidate's own target source, emitted through
//                              the SAME native chain `compile_to` runs (lower_to_ir
//                              → json_parse → emit_<tier>_src); the manifest was
//                              the admission context, not extra source to emit.
// `admit_ambient` is a SUPERSET of the standalone gate on the link (it resolves a
// manifest-provided route the standalone gate refuses), so this admits-then-emits
// directly rather than routing back through `compile_to` (whose standalone
// `admit_src` would re-refuse exactly that resolved-by-manifest candidate).
pub fn compile_to_into(source: Str, tier: Str, manifest: Str) -> Str {
  if (!supported_tier(tier)) { return "UNKNOWN_TIER|".concat(tier) }
  let verdict = admit_ambient(source, manifest)
  if (verdict != "") { return "REFUSED|".concat(verdict) }
  return emit_ir(json_parse(lower_to_ir(source)), tier)
}

// ============================================================ component wrap
// A trivial provider so the emitted module is a valid plugin (the pure driver
// functions above are what the cross-check exercises); mirrors the wrapper the
// other self-host stages carry.
service CompileStream {
  fn drive(source: Str, tier: Str) -> Str
}

component Compile provides pipeline: CompileStream {
  provide pipeline {
    fn drive(source, tier) = compile_to(source, tier)
  }
}

// ================================================================ tests

test "an unsupported tier is reported, not waved through" {
  assert compile_to("fn id(x: Int) -> Int { return x }", "dotnet") == "UNKNOWN_TIER|dotnet"
  assert supported_tier("py")
  assert supported_tier("rust")
  assert supported_tier("ts")
  assert supported_tier("go")
  assert supported_tier("java")
  assert supported_tier("wasm")
  assert !supported_tier("dotnet")
  assert !supported_tier("")
}

test "a refused program never reaches an emitter (G4), natively" {
  let src = "extern emission fn audit_write(msg: Str) -> Int = @py { return 1 } service Cache { fn put(key: Str) } component C provides cache: Cache { provide cache { fn put(key) { let n = emit audit_write(key) } } }"
  let out = compile_to(src, "py")
  // the native gate's verdict, carrying the guarantee tag — the emitter never ran
  assert out.slice(0, 11) == "REFUSED|G4|"
}

test "an admitted function program compiles fully-native to py source" {
  let out = compile_to("fn id(x: Int) -> Int { return x }", "py")
  // not a control verdict — real target source, straight from the native chain
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 11) != "UNKNOWN_TIER"
  // the cordis-py backend header the native emitter writes
  assert out.slice(0, 42) == `"""Generated by the revl cordis-py backend`
}

test "an admitted function program compiles fully-native to rust source" {
  let out = compile_to("fn id(x: Int) -> Int { return x }", "rust")
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 43) == "//! Generated by the revl cordis-rs backend"
}

test "an admitted function program compiles fully-native to ts source (item 146)" {
  let out = compile_to("fn id(x: Int) -> Int { return x }", "ts")
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 11) != "UNKNOWN_TIER"
  assert out.slice(0, 27) == "// Generated by revl backen"
}

test "admit_into with the empty manifest is exactly the standalone gate (issue #346)" {
  // "" manifest -> admit_into answers the same question `admit` does, verbatim.
  let src = "fn id(x: Int) -> Int { return x }"
  assert admit_into(src, "") == admit(src)
  assert admit_into(src, "") == ""
  // A standalone refusal still surfaces through the manifest entry point.
  let bad = "extern emission fn audit_write(msg: Str) -> Int = @py { return 1 } service Cache { fn put(key: Str) } component C provides cache: Cache { provide cache { fn put(key) { let n = emit audit_write(key) } } }"
  assert admit_into(bad, "").slice(0, 3) == "G4|"
}

test "admit_into refuses a candidate that conflicts with the running manifest (ambient G2, issue #346)" {
  // A candidate providing a key the manifest already holds is an ambient G2
  // conflict — a refusal the STANDALONE gate cannot see, now reachable natively.
  let cand = "service D { fn q(s: Str) -> Int } component NewStore provides db: D { provide db { fn q(s) { let x = s   return 0 } } }"
  assert admit_into(cand, "OldStore/db/") == "G2|provision conflict: key `db` is provided by both OldStore and NewStore (G2)"
  // A DISJOINT manifest key raises no objection: the same candidate admits.
  assert admit_into(cand, "OldCache/cache/") == ""
}

test "compile_to_into is manifest-aware: admit-against-manifest then emit (issue #346)" {
  let cand = "service D { fn q(s: Str) -> Int } component NewStore provides db: D { provide db { fn q(s) { let x = s   return 0 } } }"
  // "" manifest -> the standalone compile, byte-for-byte.
  assert compile_to_into(cand, "py", "") == compile_to(cand, "py")
  // A manifest conflict is refused; the emitter never runs.
  assert compile_to_into(cand, "py", "OldStore/db/").slice(0, 11) == "REFUSED|G2|"
  // Admitted against a disjoint manifest -> real target source, not a verdict.
  let out = compile_to_into(cand, "py", "OldCache/cache/")
  assert out.slice(0, 8) != "REFUSED|"
  assert out.slice(0, 42) == `"""Generated by the revl cordis-py backend`
  // Unsupported tier is reported first, even with a held manifest.
  assert compile_to_into(cand, "dotnet", "OldCache/cache/") == "UNKNOWN_TIER|dotnet"
}

test "the three tiers wired by this slice emit target source, not a verdict (item 146 gap 2)" {
  let src = "fn id(x: Int) -> Int { return x }"
  let go = compile_to(src, "go")
  assert go.slice(0, 8) != "REFUSED|"
  assert go.slice(0, 11) != "UNKNOWN_TIER"
  assert go.slice(0, 18) == "// Code generated "
  let java = compile_to(src, "java")
  assert java.slice(0, 8) != "REFUSED|"
  assert java.slice(0, 42) == "// Generated by the revl cordis4j backend "
  let wasm = compile_to(src, "wasm")
  assert wasm.slice(0, 8) != "REFUSED|"
  assert wasm.slice(0, 44) == ";; Generated by the revl cordis-wasm backend"
}

test "a refused program never reaches ANY of the six emitters (G4), natively" {
  let src = "extern emission fn audit_write(msg: Str) -> Int = @py { return 1 } service Cache { fn put(key: Str) } component C provides cache: Cache { provide cache { fn put(key) { let n = emit audit_write(key) } } }"
  assert compile_to(src, "go").slice(0, 11) == "REFUSED|G4|"
  assert compile_to(src, "java").slice(0, 11) == "REFUSED|G4|"
  assert compile_to(src, "wasm").slice(0, 11) == "REFUSED|G4|"
}

test "the driver resolves `use` only when it is given a document path (issue #2093)" {
  // With no path there is no module set to resolve against, so the two-argument
  // driver is the identity — `compile_to` is unchanged byte for byte.
  let one = "fn id(x: Int) -> Int { return x }"
  assert compile_to_at(one, "py", "") == compile_to(one, "py")
  // The `use` scanner sees exactly the top-level declarations, in order.
  let nl = str_newline()
  let pairs = ul_use_pairs("use \"a.rvl\" { A, B }".concat(nl).concat("fn f() -> Int { return 1 }").concat(nl))
  assert pairs.length() == 4
  assert pairs[0] == "a.rvl"
  assert pairs[1] == "A"
  assert pairs[2] == "a.rvl"
  assert pairs[3] == "B"
  // A second declaration on a later line is seen too.
  let two = ul_use_pairs("use \"a.rvl\" { A }".concat(nl).concat("use \"b.rvl\" { B }"))
  assert two.length() == 4
  assert two[0] == "a.rvl"
  assert two[2] == "b.rvl"
  // A `use` that is not at column 0 is a comment or an indented line, not a
  // declaration.
  assert ul_use_pairs("// use \"a.rvl\" { A }").length() == 0
  assert ul_use_pairs(" use \"a.rvl\" { A }").length() == 0
  assert ul_use_pairs("fn f() -> Int { return 1 }").length() == 0
  // The brace matcher is string-aware: the `}` inside a string does not close.
  assert ul_match_brace("{\"a\": \"}\", \"b\": {}}", 0) == 18
  // A service row is only matched at a KEY position.
  assert ul_service_entry("{\"services\": {}}", "A") == ""
  assert ul_service_entry("{\"services\": {\"CliDispatch\": {\"m\": {}}}}", "Cli") == ""
  assert ul_service_entry("{\"services\": {\"A\": {\"m\": {}}}}", "A") == "{\"m\": {}}"
  // Appending keeps the document's own rows first, and an empty table takes no
  // separator.
  let own = "{\"services\": {\"C\": {\"m\": {}}}}"
  assert ul_append_service(own, "A", "{\"m\": {}}") == "{\"services\": {\"C\": {\"m\": {}}, \"A\": {\"m\": {}}}}"
  assert ul_append_service("{\"services\": {}}", "A", "{\"m\": {}}") == "{\"services\": {\"A\": {\"m\": {}}}}"
}

test "an admitted component program compiles fully-native, both tiers (item 262)" {
  // a service + provider — the native IR producer now carries the component/method
  // body all the way through json_parse into the native emitter, no reference.
  let src = "service Greeter { fn hi(name: Str) -> Str } component Hello provides g: Greeter { provide g { fn hi(name) { return name } } }"
  let py = compile_to(src, "py")
  assert py.slice(0, 8) != "REFUSED|"
  assert py.slice(0, 42) == `"""Generated by the revl cordis-py backend`
  let rs = compile_to(src, "rust")
  assert rs.slice(0, 8) != "REFUSED|"
  assert rs.slice(0, 43) == "//! Generated by the revl cordis-rs backend"
  let ts = compile_to(src, "ts")
  assert ts.slice(0, 8) != "REFUSED|"
  assert ts.slice(0, 27) == "// Generated by revl backen"
}
