// The revl backend-IR -> cordis-py EMITTER, in revl — Path B slice 1, the
// first proof that revl can emit ITSELF (roadmap items 146 / 174). Where the
// lexer/parser/checker/lower stages port the compiler FRONTEND, this file ports
// the tail: it reads the stable interchange IR (docs/backend-ir.md — the JSON
// document every backend consumes) and produces Python source text, mirroring
// backends/python/emit.py.
//
// It is one half of a differential BYTE oracle: this file and
// backends/python/emit.py's `emit()` are two independent implementations of the
// same lowering, forced to produce BYTE-IDENTICAL Python for every input in the
// covered subset (tests/test_selfhost_emit_py.py). The reference is ground
// truth; any divergence is a defect in this slice.
//
// ============================================================ WHAT IT COVERS
// The first coherent slice emits, byte-for-byte, the FUNCTION-ONLY document —
// an IR with module `fn`s (a revl library) and no components/services:
//
//   * the module scaffold — the generated-header docstring, the always-emitted
//     the empty `SERVICES`/`COMPONENTS` trailers;
//   * the conditional arithmetic preludes — the i64/i32 overflow-trap helpers
//     and the IEEE true-division helper, each gated exactly as the reference
//     gates them (`_uses_bounded_int` / `_uses_bounded_int32` /
//     `_uses_true_division`, walked over the whole IR);
//   * `_emit_functions` -> `_fn_stmt` -> `_expr` for the base surface —
//     let/assign, return, if/while/for, expr, assert; and the expression algebra
//     lit, var, bin (incl `??`, the bounded `+ - *`, `/`, truncated `%`), un,
//     call, field, index, ternary-if, record, list, len, the stdlib builtins,
//     maplit, sync arrow, match, record-update, string interpolation, and the
//     optional field/call forms.
//
// Slice 2 (item 185) added components/services (the `_ComponentEmitter`); slice
// 3 (item 192) adds the MODULE DECLARATION surface — see the slice-3 banner
// below `emit_services_table`: `_emit_types` (record + variant declarations, the
// `_py_type` map, forward-ref quoting), the built-in Result classes, the
// canonical Float->Str `_revl_ftoa` helper, and host roots in fn/test bodies.
// Slice 4 (item 206) adds externs (`_emit_externs`, the verbatim `@py` body via
// stdlib/str.rvl::dedent — item 193), component `config`/`ConfigSchema`, and
// method-body `effect`/saga `emit … compensate` (the `_revl_frame.adopt`
// accumulator + the `_label`/`_effect_N`/`_emit_N` counter).
//
// ============================================================ WHAT IT DEFERS
// Reported for a follow-on slice 5, deliberately OUT of this file:
//   * async coloring (colored fns / async externs' await-seed / awaited call
//     sites), realm placements (`isolate`/`intercept`/`routes`/router),
//     spawn/instances, in-file `test`/`fault_test`/`lifecycle test` emission,
//     `adt` construction (a user-variant constructor call), and the ABI;
//   * method-body `let-effect` — EMITTED (the `_revl_frame.acquire` form) but not
//     yet cross-checked: the surface admits only a `spawn` acquire there, whose
//     `cexpr` lands in slice 5;
//   * `let_pattern` (record/list destructuring): still unimplemented here, but no
//     longer a PERMANENT exclusion — item 179 replaced the reference's
//     `__revl_destructure_{id(node)}` (a nondeterministic Python object id) with a
//     per-`_Lines` monotonic counter in deterministic emission order, so its bytes
//     are now reproducible and a future slice CAN port + cross-check it.
//
// ------------------------------------------------------ the erased-IR boundary
// revl has no dynamic `dict[str, Any]`, and the checker refuses stdlib methods
// on an unpinned `Any` receiver (host-object results carry no type, G8). Slice 1
// bridged that with a bespoke set of `@py` primitive accessors
// (`g`/`gs`/`alist`/`at`/`child_nodes`/…). Item 180 shipped stdlib/value.rvl —
// the NAMED, reusable `Value` bridge that generalises exactly those accessors —
// so this slice reads the IR in PURE revl by `use`-ing them, with NO navigation
// `@py` block of its own (the item-180 obsolescence mapping): `g` ->
// `value_field`, `gs` -> `value_str∘value_field`, `alist` -> `value_list`, `at`
// -> `value_at`, `as_str` -> `value_str`, `is_none` -> `value_is_null`,
// `child_nodes` -> `value_children`, the old `ir_version` ->
// `value_int(value_opt(…) ?? 1)`, and the old `is_py_float` shape test ->
// `value_kind(…) == "float"`. Every byte of emitter LOGIC (dispatch, formatting,
// indentation, string building) stays pure revl.
//
// What is NOT obsoleted, and stays `@py` below, is HOST FORMATTING / char
// output — not IR navigation: `py_repr` (the reference `_expr` itself calls
// Python's `repr()` to render literals, so bridging it is faithful), `newline`
// (the one genuine U+000A), and `mangle` (the Python-keyword rename).
use "../stdlib/value.rvl" {
  value_kind, value_is_null, value_field, value_opt,
  value_list, value_at, value_str, value_int, value_bool, value_children,
  value_keys, value_is_list, value_is_object
}

// ------------------------------------------------- str kit (items 193 / 189)
// Slice 4's `_emit_externs` reproduces the reference's
// `textwrap.dedent(bodies["py"].strip("\n"))`. `stdlib/str.rvl::dedent` (item
// 193) is the verified byte-exact port of `textwrap.dedent`, so the verbatim
// `@py` body is de-indented in PURE revl by `use`-ing it (`splitlines` / the
// `"\n"`-strip stay local below, composed over the base `Str` surface).
//
// str.rvl's private helpers ride into the link with `dedent` (the compiler
// emits an imported module's private fns so its own fns can call them), and a
// linked module cannot define a name another linked module defines. So the four
// string helpers slices 1-3 hand-rolled — `trim`/`lstrip`/`last_index_of`/
// `ident_tokens` — that str.rvl now ships (its header names this exact
// migration) are taken from it here rather than re-declared, and the local
// copies (plus their private `is_alpha_us`/`is_word_ch`) are deleted. This is
// the item-193 duplication cull the module was built for.
use "../stdlib/str.rvl" { trim, lstrip, last_index_of, ident_tokens, dedent }
// The set-shaped list helpers (item 194): `list_contains` replaces the local
// `str_in` membership test, and `list_sort(list_dedup(...))` replaces the
// hand-positioned canonical `sorted(uses)` order in the `from runtime import`
// line — see `emit_py_src`.
use "../stdlib/list.rvl" { list_contains, list_sort, list_dedup }

// ------------------------------------------- NAVIGATION GAP CLOSED (item 188)
// The ONE navigation primitive slices 1-2 could not express in pure revl was an
// enumerator of a record's KEYS in insertion order. A components-and-services
// document keys three of its sections BY NAME as records (`services` = name ->
// service, a component's `requires` = local -> service, `provides` = key ->
// service), and the SERVICES table + the `inject` list must iterate those keys;
// `value_field`/`value_children` reach values, never keys. Slice 2 bridged that
// with a local `@py record_keys` and flagged it for a value.rvl follow-up. Item
// 188 SHIPPED that follow-up — `value_keys` (stdlib/value.rvl), the total
// key-enumeration companion — so slice 3 `use`s it and the last navigation `@py`
// block is GONE: every byte of IR navigation is now pure revl through `value_*`.

// ------------------------------------------------- host formatting (kept @py)
// `py_repr` / `newline` / `mangle` are the item-180 "NOT obsoleted" set — host
// char output and Python-keyword renaming, not IR navigation. `snake` / `pascal`
// join them: identifier CASING is the same category (they mirror the reference's
// pure string helpers `_snake` / `_pascal`, kin to `_mangle`).
extern pure fn py_repr(v: Any) -> Str = @py { return repr(v) }
// A real newline. revl plain strings carry no escapes (`"\n"` is a literal
// backslash-n, which is exactly what the emitted `assert` message wants), so the
// line SEPARATOR is sourced here — the one place a genuine U+000A is needed.
extern pure fn newline() -> Str = @py { return chr(10) }
// The A3 rename (mirrors backends/python/emit.py::_mangle): a valid revl
// identifier that is a Python keyword emits and RUNS instead of crashing.
// A pure function of the name — declaration and use sites agree without a table
// — and INJECTIVE, so two distinct revl identifiers never land on one Python
// identifier. Escape a name iff the name or any name reachable from it by
// dropping trailing `_` is a keyword, by exactly one `_`: that shifts the whole
// `kw`/`kw_`/`kw__` ladder up a rung (`lambda` -> `lambda_`, `lambda_` ->
// `lambda__`) and leaves every other name verbatim, so nothing collapses.
extern pure fn mangle(name: Str) -> Str = @py {
    import keyword
    root = name
    while root:
        if keyword.iskeyword(root) or keyword.issoftkeyword(root):
            return name + "_"
        if not root.endswith("_"):
            break
        root = root[:-1]
    return name
}
// `_snake` / `_pascal` verbatim (backends/python/emit.py): the component's apply
// fn name is `_<snake>_apply`, a provision class is `_<Pascal>`.
extern pure fn snake(name: Str) -> Str = @py {
    import re
    return re.sub(r"(?<=[a-z0-9])(?=[A-Z])", "_", name).lower()
}
extern pure fn pascal(name: Str) -> Str = @py {
    return "".join(part[:1].upper() + part[1:] for part in name.split("_") if part)
}
// `str.upper()` verbatim — the reference names a component's config schema
// `_<snake>.upper()>_CONFIG`; identifier CASING, kin to `snake`/`pascal`.
extern pure fn upper(s: Str) -> Str = @py { return s.upper() }

// ---------------------------------------------------------------- small utils
fn node_kind(n: Any) -> Str { return value_str(value_field(n, "kind")) }
fn node_op(n: Any) -> Str { return value_str(value_field(n, "op")) }
fn node_operands(n: Any) -> Str { return value_str(value_field(n, "operands")) }

fn ind(n: Int) -> Str { return "    ".repeat(n) }

fn line(indent: Int, text: Str) -> Str {
  if (text == "") { return "" }
  return ind(indent).concat(text)
}

fn is_addsubmul(op: Str) -> Bool {
  return op == "+" || op == "-" || op == "*"
}

fn is_div_method(m: Str) -> Bool {
  return m == "div_trunc" || m == "div_floor" || m == "div_euclid"
}

// The reference's `_bounded` (item 436 F5): impose the Int/Int32 bound INLINE.
// `_revl_i64(a + b)` entered a python frame for every bounded `+`/`-`/`*`, and
// the calls nest; the range test is two comparisons against module constants,
// so it inlines and the frame is paid only on the trapping path. One temp name
// serves ANY nesting depth — the walrus sits in a conditional expression's
// condition, which python evaluates before either branch, so an inner operation
// has finished reading `_bi` before an outer one rebinds it.
fn bounded(operation: Str, width: Str) -> Str {
  return `(_bi if _REVL_I${width}_MIN <= (_bi := ${operation}) <= _REVL_I${width}_MAX else _revl_i${width}(_bi))`
}

// The reference's `_field_read` (item 436 F4): `p.x` INLINE, not through a
// `_revl_field` call. Record literals are dicts and ADT payloads are objects, so
// the read dispatches on the receiver's shape — but one `isinstance` needs no
// python frame around it. `rereadable` says the caller already bound the target
// to a name (the `?.` chain has), so no temp is needed.
fn field_read(target: Str, name: Str, rereadable: Bool) -> Str {
  var tmp = "_fv"
  var got = `(_fv := ${target})`
  if (rereadable) {
    tmp = target
    got = target
  }
  return `(${tmp}[${name}] if isinstance(${got}, dict) else getattr(${tmp}, ${name}))`
}

// Is this node the bare `Some` constructor? (item 436 F8)
fn is_some_var(n: Any) -> Bool {
  if (node_kind(n) != "var") { return false }
  return value_str(value_field(n, "name")) == "Some"
}

fn is_cmp_op(op: Str) -> Bool {
  if (op == "==") { return true }
  if (op == "===") { return true }
  if (op == "!=") { return true }
  if (op == "!==") { return true }
  if (op == "<") { return true }
  if (op == ">") { return true }
  if (op == "<=") { return true }
  return op == ">="
}

// The _PY_BIN_OPS table (backends/python/emit.py): revl operator -> Python
// operator. "" for an operator with no plain mapping (handled specially).
fn py_bin_op(op: Str) -> Str {
  if (op == "==") { return "==" }
  if (op == "===") { return "==" }
  if (op == "!=") { return "!=" }
  if (op == "!==") { return "!=" }
  if (op == "<") { return "<" }
  if (op == ">") { return ">" }
  if (op == "<=") { return "<=" }
  if (op == ">=") { return ">=" }
  if (op == "+") { return "+" }
  if (op == "-") { return "-" }
  if (op == "*") { return "*" }
  if (op == "/") { return "/" }
  if (op == "%") { return "%" }
  if (op == "&&") { return "and" }
  if (op == "||") { return "or" }
  return ""
}

// ---------------------------------------------------- IR-wide `_uses_*` gates
// Recursively walk the whole IR (mirrors the reference predicates). child_nodes
// yields a dict's values / a list's elements / nothing for a scalar, so the walk
// terminates at leaves exactly as the Python `any(... .values())` recursion does.
fn uses_bounded_int(n: Any) -> Bool {
  let k = node_kind(n)
  if (k == "bin" && is_addsubmul(node_op(n)) && node_operands(n) == "Int") { return true }
  if (k == "un" && node_op(n) == "-" && node_operands(n) == "Int") { return true }
  if (k == "builtin" && is_div_method(value_str(value_field(n, "method")))) { return true }
  for (c of value_children(n)) {
    if (uses_bounded_int(c)) { return true }
  }
  return false
}

fn uses_bounded_int32(n: Any) -> Bool {
  let k = node_kind(n)
  if (k == "bin" && is_addsubmul(node_op(n)) && node_operands(n) == "Int32") { return true }
  if (k == "un" && node_op(n) == "-" && node_operands(n) == "Int32") { return true }
  if (k == "builtin" && value_str(value_field(n, "method")) == "to_int32") { return true }
  for (c of value_children(n)) {
    if (uses_bounded_int32(c)) { return true }
  }
  return false
}

fn uses_true_division(n: Any) -> Bool {
  if (node_kind(n) == "bin" && node_op(n) == "/") { return true }
  for (c of value_children(n)) {
    if (uses_true_division(c)) { return true }
  }
  return false
}

// `_uses_i32_shl`: left shift is the one bitwise op whose result can leave the
// 32-bit range (a bit op, not a trap), so python re-wraps it through
// `_revl_i32_wrap`; `& | ^ >> ~` all stay in range and need no helper.
// The reference's `_uses_builtin` (item 436 F6): does the IR call this stdlib
// builtin? `?.m(..)` is an `optcall` node, not a `builtin` one, but it goes
// through the very same render table, so it needs the very same helper.
fn uses_builtin_method(n: Any, name: Str) -> Bool {
  let k = node_kind(n)
  if ((k == "builtin" || k == "optcall") && value_str(value_field(n, "method")) == name) {
    return true
  }
  for (c of value_children(n)) {
    if (uses_builtin_method(c, name)) { return true }
  }
  return false
}

// `_uses_opt_to_int`: a `to_int` reached through `?.`, whose node carries no
// receiver type, so the payload-dispatching wrapper is emitted too.
fn uses_opt_to_int(n: Any) -> Bool {
  if (node_kind(n) == "optcall" && value_str(value_field(n, "method")) == "to_int") {
    return true
  }
  for (c of value_children(n)) {
    if (uses_opt_to_int(c)) { return true }
  }
  return false
}

// `_uses_trunc_rem`: a truncated remainder (`%` on Int or Float). Python's own
// `%` floors, so this is the one operator the tier has to build.
fn uses_trunc_rem(n: Any) -> Bool {
  if (node_kind(n) == "bin" && node_op(n) == "%") {
    let opnd = node_operands(n)
    if (opnd == "Int" || opnd == "Float") { return true }
  }
  for (c of value_children(n)) {
    if (uses_trunc_rem(c)) { return true }
  }
  return false
}

fn uses_i32_shl(n: Any) -> Bool {
  if (node_kind(n) == "bin" && node_op(n) == "<<") { return true }
  for (c of value_children(n)) {
    if (uses_i32_shl(c)) { return true }
  }
  return false
}

// -------------------------------------------------------------- expressions
// `_is_float_expr` (backends/python/emit.py): syntactically-certain Float.
fn is_float_expr(node: Any) -> Bool {
  let k = node_kind(node)
  if (k == "lit") { return value_kind(value_field(node, "value")) == "float" }
  if (k == "bin") { return node_op(node) == "/" || node_operands(node) == "Float" }
  if (k == "un") {
    if (node_op(node) != "-") { return false }
    return is_float_expr(value_field(node, "operand"))
  }
  return false
}

fn commajoin(nodes: List[Any]) -> Str {
  var parts = []
  for (e of nodes) { parts = parts.push(expr(e)) }
  return parts.join(", ")
}

// ----------------------------------------------- single-evaluation `??`/`?.`
// The reference's `_opt_height` / `_opt_bind` (item 436 F7): `??`, `?.` and
// `?.()` must evaluate their LEFT OPERAND ONCE, so a non-trivial operand is
// bound with a walrus and the bound name is what the presence test and the
// result both read. The temp is named after the opt-chain HEIGHT of the whole
// node, which is strictly greater than every opt node beneath it: a chain
// nested in an ARGUMENT therefore cannot clobber the one above it, and some
// builtins (`join`, `indexOf`) render the argument before the receiver.
fn opt_height(n: Any) -> Int {
  var inner = 0
  for (c of value_children(n)) {
    let h = opt_height(c)
    if (h > inner) { inner = h }
  }
  let k = node_kind(n)
  if (k == "optfield" || k == "optcall" || (k == "bin" && node_op(n) == "??")) {
    return inner + 1
  }
  return inner
}

// The reference's `_INLINE_TRIVIAL`: a read that is free to repeat and yields
// the same value every time, so it keeps the plain double render.
fn is_trivial_node(n: Any) -> Bool {
  let k = node_kind(n)
  return k == "var" || k == "name" || k == "lit" || k == "config" || k == "maplit"
}

fn opt_temp(node: Any) -> Str {
  return `_ov${opt_height(node).to_str()}`
}

fn opt_binder(node: Any, target: Any, rendered: Str) -> Str {
  if (is_trivial_node(target)) { return `(${rendered})` }
  return `(${opt_temp(node)} := ${rendered})`
}

fn opt_reader(node: Any, target: Any, rendered: Str) -> Str {
  if (is_trivial_node(target)) { return rendered }
  return opt_temp(node)
}

// `_render_builtin`: the stdlib surface rendered as portable Python.
fn render_builtin(method: Str, target: Str, args: List[Str], recv: Str) -> Str {
  if (method == "length") { return `len(${target})` }
  if (method == "push") { return `(${target} + [${args[0]}])` }
  if (method == "slice") { return `${target}[${args[0]}:${args[1]}]` }
  if (method == "charAt") { return `${target}[${args[0]}]` }
  if (method == "charCodeAt") { return `ord(${target}[${args[0]}])` }
  if (method == "concat") { return `(${target} + ${args[0]})` }
  // A preamble helper, not a lambda built and applied at every evaluation
  // (item 436 F6): one frame, no function-object allocation.
  if (method == "indexOf") { return `_revl_index_of(${target}, ${args[0]})` }
  if (method == "split") { return `_revl_split(${target}, ${args[0]})` }
  if (method == "join") { return `${args[0]}.join(${target})` }
  if (method == "repeat") { return `(${target} * ${args[0]})` }
  if (method == "startsWith") { return `${target}.startswith(${args[0]})` }
  if (method == "endsWith") { return `${target}.endswith(${args[0]})` }
  if (method == "set") { return `({**${target}, ${args[0]}: ${args[1]}})` }
  if (method == "lookup") { return `${target}.get(${args[0]})` }
  if (method == "has") { return `(${args[0]} in ${target})` }
  if (method == "size") { return `len(${target})` }
  if (method == "keys") { return `sorted(${target})` }
  if (method == "remove") {
    return "{".concat(`kk: vv for kk, vv in ${target}.items() if kk != ${args[0]}`).concat("}")
  }
  if (method == "div_trunc") {
    return bounded(`_revl_div_trunc(${target}, ${args[0]})`, "64")
  }
  if (method == "div_floor") { return bounded(`${target} // ${args[0]}`, "64") }
  if (method == "div_euclid") {
    return bounded(`_revl_div_euclid(${target}, ${args[0]})`, "64")
  }
  if (method == "mod") { return `(${target} % abs(${args[0]}))` }
  if (method == "to_int") {
    // `recv == "?"` is the reference's `_RECV_VIA_OPT`: reached through `?.`,
    // whose node carries no receiver tag, so the Int32-widen and Str-parse
    // rows are told apart at runtime instead.
    if (recv == "Str" || recv == "?") {
      if (recv == "?") { return `_revl_opt_to_int(${target})` }
      return `_revl_str_to_int(${target})`
    }
    return `(${target})`
  }
  if (method == "to_int32") { return `_revl_i32(${target})` }
  if (method == "to_str") { return `str(${target})` }
  return `<<UNSUPPORTED-BUILTIN:${method}>>`
}

// `_match_expr` one arm: nested conditional inside a one-shot `lambda match: …`.
fn match_branch(arm: Any, rest: Str, has_rest: Bool, head: Str) -> Str {
  let pattern = value_str(value_field(arm, "pattern"))
  var body = expr(value_field(arm, "body"))
  if (pattern == "_") { return body }
  let bind = value_str(value_field(arm, "bind"))
  var cond = ""
  if (pattern == "None") {
    cond = `${head} is None`
  } else {
    if (pattern == "Some") {
      cond = `${head} is not None`
      if (bind != "") { body = `(lambda ${bind}: ${body})(match)` }
    } else {
      if (bind != "") { body = `(lambda ${bind}: ${body})(match.value)` }
      cond = `isinstance(${head}, ${pattern})`
    }
  }
  if (!has_rest) {
    return `(${body} if ${cond} else (_ for _ in ()).throw(TypeError('non-exhaustive match')))`
  }
  return `(${body} if ${cond} else ${rest})`
}

// The scrutinee bind rides the FIRST arm's test rather than a one-shot
// `lambda match: …` (item 436 F3): the lambda was a function object built and a
// frame entered at every evaluation, to bind one name. `match` is a revl
// keyword, so no user binding collides with the walrus target, and a nested
// match inside an arm body may reuse the name — the outer chain has finished
// reading `match` before any body runs. A leading wildcard arm (or no arm at
// all) has no test to carry the bind, so those keep the `(<bind>, <body>)[1]`
// tuple the awaited path uses.
fn match_folds(arms: List[Any]) -> Bool {
  if (arms.length() == 0) { return false }
  return value_str(value_field(arms[0], "pattern")) != "_"
}

fn match_expr(scrutinee: Str, arms: List[Any]) -> Str {
  let folds = match_folds(arms)
  var result = ""
  var has = false
  var i = arms.length() - 1
  while (i >= 0) {
    let arm = arms[i]
    var head = "match"
    if (folds && i == 0) { head = `(match := ${scrutinee})` }
    result = match_branch(arm, result, has, head)
    has = true
    i -= 1
  }
  if (!has) {
    result = "(_ for _ in ()).throw(TypeError('non-exhaustive match'))"
  }
  if (folds) { return result }
  return `((match := ${scrutinee}), ${result})[1]`
}

// `_interp_fstring`: a `${…}` template as a Python string concatenation.
fn interp_fstring(parts: List[Any]) -> Str {
  var pieces = []
  for (p of parts) {
    let k = value_str(value_at(p, 0))
    let v = value_at(p, 1)
    if (k == "text") {
      pieces = pieces.push(py_repr(v))
    } else {
      if (is_float_expr(v)) {
        pieces = pieces.push(`_revl_ftoa(${expr(v)})`)
      } else {
        pieces = pieces.push(`str(${expr(v)})`)
      }
    }
  }
  if (pieces.length() == 0) { return "''" }
  let inner = pieces.join(" + ")
  return "(".concat(inner).concat(")")
}

fn render_record(fields: List[Any]) -> Str {
  var parts = []
  for (p of fields) {
    parts = parts.push(`${py_repr(value_at(p, 0))}: ${expr(value_at(p, 1))}`)
  }
  let inner = parts.join(", ")
  return "{".concat(inner).concat("}")
}

fn render_list(items: List[Any]) -> Str {
  var parts = []
  for (e of items) { parts = parts.push(expr(e)) }
  let inner = parts.join(", ")
  return "[".concat(inner).concat("]")
}

fn render_record_update(base: Str, updates: List[Any]) -> Str {
  var parts = []
  parts = parts.push(`**${base}`)
  for (u of updates) {
    parts = parts.push(`${py_repr(value_at(u, 0))}: ${expr(value_at(u, 1))}`)
  }
  let inner = parts.join(", ")
  return "{".concat(inner).concat("}")
}

fn render_arrow(node: Any) -> Str {
  var ps = []
  for (p of value_list(value_field(node, "params"))) { ps = ps.push(mangle(value_str(p))) }
  for (c of value_list(value_field(node, "captures"))) {
    let cm = mangle(value_str(c))
    ps = ps.push(`${cm}=${cm}`)
  }
  let lp = ps.join(", ")
  return `lambda ${lp}: ${expr(value_field(node, "body"))}`
}

fn render_bin(node: Any) -> Str {
  let op = node_op(node)
  if (op == "??") {
    let left = value_field(node, "left")
    let lhs = expr(left)
    let rhs = expr(value_field(node, "right"))
    if (is_trivial_node(left)) { return `(${rhs} if ${lhs} is None else ${lhs})` }
    // the walrus binds in the presence test, which a conditional expression
    // evaluates FIRST, so the `then` branch reads a value produced once
    let name = opt_temp(node)
    return `(${name} if (${name} := ${lhs}) is not None else ${rhs})`
  }
  let opnd = node_operands(node)
  if (is_addsubmul(op) && opnd == "Int") {
    return bounded(`${expr(value_field(node, "left"))} ${op} ${expr(value_field(node, "right"))}`, "64")
  }
  if (is_addsubmul(op) && opnd == "Int32") {
    return bounded(`${expr(value_field(node, "left"))} ${op} ${expr(value_field(node, "right"))}`, "32")
  }
  if (op == "/") {
    return `_revl_div(${expr(value_field(node, "left"))}, ${expr(value_field(node, "right"))})`
  }
  if (op == "%" && (opnd == "Int" || opnd == "Float")) {
    return `_revl_rem(${expr(value_field(node, "left"))}, ${expr(value_field(node, "right"))})`
  }
  if (op == "&" || op == "|" || op == "^") {
    // Int32 bitwise AND/OR/XOR (item 366): for operands already in i32 range,
    // python's `&`/`|`/`^` produce an in-range result, so no re-wrap is needed.
    return `(${expr(value_field(node, "left"))} ${op} ${expr(value_field(node, "right"))})`
  }
  if (op == ">>") {
    // Arithmetic (sign-extending) right shift; the count is taken mod 32
    // (`& 31`), matching wasm/JS. python `>>` is arithmetic and the magnitude
    // only shrinks, so the result stays in i32 range.
    return `(${expr(value_field(node, "left"))} >> (${expr(value_field(node, "right"))} & 31))`
  }
  if (op == "<<") {
    // Left shift wraps into 32-bit two's complement (a bit op, no trap): the
    // count is taken mod 32 and the result is re-wrapped.
    return `_revl_i32_wrap(${expr(value_field(node, "left"))} << (${expr(value_field(node, "right"))} & 31))`
  }
  let pop = py_bin_op(op)
  return `(${expr(value_field(node, "left"))} ${pop} ${expr(value_field(node, "right"))})`
}

fn render_un(node: Any) -> Str {
  let op = node_op(node)
  if (op == "!") { return `(not ${expr(value_field(node, "operand"))})` }
  if (op == "~") {
    // Int32 bitwise complement (item 366): `~x == -x - 1`, which stays in i32
    // range for any in-range `x`, so no re-wrap is needed.
    return `(~${expr(value_field(node, "operand"))})`
  }
  if (op == "-") {
    let opnd = node_operands(node)
    if (opnd == "Int") { return `_revl_i64(-${expr(value_field(node, "operand"))})` }
    if (opnd == "Int32") { return `_revl_i32(-${expr(value_field(node, "operand"))})` }
    return `(-${expr(value_field(node, "operand"))})`
  }
  return `<<UNSUPPORTED-UN:${op}>>`
}

// The kind dispatch (post-widen), mirroring `_expr`'s branch order.
fn expr_inner(node: Any) -> Str {
  let kind = node_kind(node)
  if (kind == "lit") { return py_repr(value_field(node, "value")) }
  if (kind == "var") {
    let nm = value_str(value_field(node, "name"))
    if (nm == "None") { return "None" }
    if (nm == "Some") { return "(lambda _v: _v)" }
    return mangle(nm)
  }
  if (kind == "bin") { return render_bin(node) }
  if (kind == "un") { return render_un(node) }
  if (kind == "call") {
    // `Some(x)` is the identity on this tier (item 436 F8): rendering the
    // callee would build `(lambda _v: _v)` and apply it to hand back its
    // argument. A BARE `Some` still needs the lambda (the `var` arm above).
    let callee_node = value_field(node, "callee")
    let call_args = value_list(value_field(node, "args"))
    if (is_some_var(callee_node) && call_args.length() == 1) { return expr(call_args[0]) }
    let callee = expr(callee_node)
    let args = commajoin(call_args)
    return `${callee}(${args})`
  }
  if (kind == "field") {
    return field_read(expr(value_field(node, "target")), py_repr(value_field(node, "name")), false)
  }
  if (kind == "index") {
    return `${expr(value_field(node, "target"))}[${expr(value_field(node, "index"))}]`
  }
  if (kind == "if") {
    return `(${expr(value_field(node, "then"))} if ${expr(value_field(node, "cond"))} else ${expr(value_field(node, "else"))})`
  }
  if (kind == "record") { return render_record(value_list(value_field(node, "fields"))) }
  if (kind == "list") { return render_list(value_list(value_field(node, "items"))) }
  if (kind == "len") { return `len(${expr(value_field(node, "target"))})` }
  if (kind == "builtin") {
    var args = []
    for (a of value_list(value_field(node, "args"))) { args = args.push(expr(a)) }
    return render_builtin(value_str(value_field(node, "method")), expr(value_field(node, "target")), args, value_str(value_field(node, "recv")))
  }
  if (kind == "maplit") { return "{}" }
  if (kind == "arrow") { return render_arrow(node) }
  if (kind == "match") {
    return match_expr(expr(value_field(node, "scrutinee")), value_list(value_field(node, "arms")))
  }
  if (kind == "record_update") {
    return render_record_update(expr(value_field(node, "base")), value_list(value_field(node, "updates")))
  }
  if (kind == "interp") { return interp_fstring(value_list(value_field(node, "parts"))) }
  if (kind == "optfield") {
    let tgt = value_field(node, "target")
    let t = expr(tgt)
    return `(None if ${opt_binder(node, tgt, t)} is None else ${field_read(opt_reader(node, tgt, t), py_repr(value_field(node, "name")), true)})`
  }
  if (kind == "optcall") {
    // the method is a STDLIB builtin (the checker types an optcall through
    // `builtin_check`), so it goes through the same table a plain `.m(..)`
    // does. Rendering `payload.m(..)` put a method python values do not
    // have on the receiver.
    let tgt = value_field(node, "target")
    let t = expr(tgt)
    var args = []
    for (a of value_list(value_field(node, "args"))) { args = args.push(expr(a)) }
    let body = render_builtin(value_str(value_field(node, "method")), opt_reader(node, tgt, t), args, "?")
    return `(None if ${opt_binder(node, tgt, t)} is None else ${body})`
  }
  return `<<UNSUPPORTED-EXPR:${kind}>>`
}

// The implicit Int -> Float coercion marker (docs/arithmetic.md): render the
// conversion the reference makes visible, then dispatch the un-widened node.
fn expr(node: Any) -> Str {
  if (value_str(value_field(node, "widen")) == "Float") {
    return `float(${expr_inner(node)})`
  }
  return expr_inner(node)
}

// ------------------------------------------- in-place accumulation (436 F1)
// The reference's `_py_self_rebind` / `_py_escaped_names` / `_py_inplace_locals`
// / `_py_inplace_stmts`. `xs.push(v)` renders `(xs + [v])`, a WHOLE copy of the
// receiver, so `var out = []; for (..) { out = out.push(..) }` is emitted O(n^2)
// where the developer wrote O(n). The rewrite is `out.append(v)` and its whole
// difficulty is proving the copy unobservable: the local must be BORN here
// (a fresh literal, or another name materialised as one defensive copy) and
// must never ESCAPE into a second holder.
fn is_fresh_kind(k: Str) -> Bool {
  return k == "list" || k == "maplit" || k == "record"
}

// the persistent methods with an in-place equivalent, and their arity; -1 for
// anything else. `concat` is absent: its receiver type is not known at this
// node and a python `str` cannot be mutated at all.
fn inplace_arity(method: Str) -> Int {
  if (method == "push") { return 1 }
  if (method == "set") { return 2 }
  if (method == "remove") { return 1 }
  return -1
}

// slots in which a bare `var` is READ but not RETAINED
fn non_retaining_slots(kind: Str) -> List[Str] {
  if (kind == "builtin") { return ["target"] }
  if (kind == "index") { return ["target", "index"] }
  if (kind == "len") { return ["target"] }
  if (kind == "field") { return ["target"] }
  if (kind == "optfield") { return ["target"] }
  if (kind == "optcall") { return ["target"] }
  if (kind == "bin") { return ["left", "right"] }
  if (kind == "un") { return ["operand"] }
  if (kind == "interp") { return ["parts"] }
  if (kind == "record_update") { return ["base"] }
  return []
}

// the `out = out.push(v)` shape: a persistent copy of the target rebound over
// its own receiver
fn self_rebind(name: Str, value: Any) -> Bool {
  let k = node_kind(value)
  if (k == "builtin") {
    let arity = inplace_arity(value_str(value_field(value, "method")))
    if (arity < 0) { return false }
    if (value_list(value_field(value, "args")).length() != arity) { return false }
    let tgt = value_field(value, "target")
    return node_kind(tgt) == "var" && value_str(value_field(tgt, "name")) == name
  }
  if (k == "record_update") {
    if (value_list(value_field(value, "updates")).length() == 0) { return false }
    let base = value_field(value, "base")
    return node_kind(base) == "var" && value_str(value_field(base, "name")) == name
  }
  return false
}

// every name whose object could outlive the expression that reads it, plus
// every name a nested binder shadows
fn escaped_names(node: Any, escapes: Bool) -> List[Str] {
  var found: List[Str] = []
  if (value_is_list(node)) {
    for (item of value_list(node)) { found = found.concat(escaped_names(item, escapes)) }
    return found
  }
  if (!value_is_object(node)) { return found }
  // a `return` ENDS the function: nothing it hands out can be observed
  // changing afterwards
  if (value_str(value_field(node, "step")) == "return") { return found }
  let kind = node_kind(node)
  if (kind == "var") {
    if (escapes) { found = found.push(value_str(value_field(node, "name"))) }
    return found
  }
  if (kind == "arrow") {
    // a lambda captures by default-argument, snapshotting the OBJECT
    for (c of value_list(value_field(node, "captures"))) { found = found.push(value_str(c)) }
    for (p of value_list(value_field(node, "params"))) { found = found.push(value_str(p)) }
  }
  if (kind == "match") {
    for (arm of value_list(value_field(node, "arms"))) {
      let b = value_field(arm, "bind")
      if (!value_is_null(b)) { found = found.push(value_str(b)) }
    }
  }
  // `a ?? b` YIELDS `a`, so that operand IS retained
  let safe = (kind == "bin" && node_op(node) == "??") ? [] : non_retaining_slots(kind)
  for (key of value_keys(node)) {
    found = found.concat(escaped_names(value_field(node, key), !list_contains(safe, key)))
  }
  return found
}

// One walk over the statement tree, tagging each write: `fresh:` / `alias:` a
// birth, `spoil:` a write the rewrite cannot own, `accum:` a self-rebind,
// `push:` a self-rebind that names the List container.
fn scan_locals(steps: List[Any]) -> List[Str] {
  var out: List[Str] = []
  for (node of steps) {
    let step = value_str(value_field(node, "step"))
    let name = value_str(value_field(node, "name"))
    if (step == "let") {
      let k = node_kind(value_field(node, "value"))
      if (is_fresh_kind(k)) { out = out.push(`fresh:${name}`) }
      else if (k == "var") { out = out.push(`alias:${name}`) }
      else { out = out.push(`spoil:${name}`) }
    }
    if (step == "assign") {
      let value = value_field(node, "value")
      if (self_rebind(name, value)) {
        out = out.push(`accum:${name}`)
        if (value_str(value_field(value, "method")) == "push") { out = out.push(`push:${name}`) }
      } else {
        out = out.push(`spoil:${name}`)
      }
    }
    if (step == "for") {
      out = out.push(`spoil:${value_str(value_field(node, "bind"))}`)
      out = out.concat(scan_locals(value_list(value_field(node, "body"))))
    }
    if (step == "while") { out = out.concat(scan_locals(value_list(value_field(node, "body")))) }
    if (step == "if") {
      out = out.concat(scan_locals(value_list(value_field(node, "then"))))
      out = out.concat(scan_locals(value_list(value_field(node, "else"))))
    }
  }
  return out
}

fn tag_count(tags: List[Str], tag: Str) -> Int {
  var n = 0
  for (t of tags) { if (t == tag) { n = n + 1 } }
  return n
}

fn tag_name(t: Str) -> Str { return t.slice(t.indexOf(":") + 1, t.length()) }

// the locals a persistent write may update in place
fn inplace_locals(fnode: Any) -> List[Str] {
  let body = value_field(fnode, "body")
  let tags = scan_locals(value_list(body))
  let escaped = escaped_names(body, true)
  var params: List[Str] = []
  for (p of value_list(value_field(fnode, "params"))) {
    params = params.push(value_str(value_field(p, "name")))
  }
  var out: List[Str] = []
  for (t of tags) {
    if (!t.startsWith("fresh:") && !t.startsWith("alias:")) { continue }
    let nm = tag_name(t)
    if (list_contains(out, nm)) { continue }
    // one python scope per fn, so a second declaration is a rebind
    if (tag_count(tags, `fresh:${nm}`) + tag_count(tags, `alias:${nm}`) > 1) { continue }
    if (tag_count(tags, `accum:${nm}`) == 0) { continue }
    if (tag_count(tags, `spoil:${nm}`) > 0) { continue }
    if (list_contains(params, nm)) { continue }
    if (list_contains(escaped, nm)) { continue }
    out = out.push(nm)
  }
  return out
}

// `name=list` / `name=dict` for each eligible local born off ANOTHER name: it
// takes one defensive copy at birth, where the persistent form took one per
// write. The container is named by the methods that rebind the local.
fn inplace_births(fnode: Any, eligible: List[Str]) -> List[Str] {
  let tags = scan_locals(value_list(value_field(fnode, "body")))
  var out: List[Str] = []
  for (nm of eligible) {
    if (tag_count(tags, `alias:${nm}`) == 0) { continue }
    out = out.push(tag_count(tags, `push:${nm}`) > 0 ? `${nm}=list` : `${nm}=dict`)
  }
  return out
}

fn birth_container(births: List[Str], name: Str) -> Str {
  for (b of births) {
    if (b.startsWith(`${name}=`)) { return b.slice(name.length() + 1, b.length()) }
  }
  return ""
}

// the in-place statements replacing a proven-unique persistent copy; operand
// evaluation order matches the copying form they replace
fn inplace_stmts(name: Str, value: Any) -> List[Str] {
  let recv = mangle(name)
  if (node_kind(value) == "record_update") {
    // `.update(<mapping>)` builds the whole replacement BEFORE writing any of
    // it, so a swap stays simultaneous exactly as the `{**p, ..}` spread was
    var parts = []
    for (u of value_list(value_field(value, "updates"))) {
      parts = parts.push(`${py_repr(value_at(u, 0))}: ${expr(value_at(u, 1))}`)
    }
    return [`${recv}.update({${parts.join(", ")}})`]
  }
  let method = value_str(value_field(value, "method"))
  let args = value_list(value_field(value, "args"))
  if (method == "push") { return [`${recv}.append(${expr(args[0])})`] }
  // `Map.remove` is TOTAL (an absent key is not an error), so `pop` with a
  // default, never `del`
  if (method == "remove") { return [`${recv}.pop(${expr(args[0])}, None)`] }
  // `set`: the spread evaluated receiver, then key, then value; a subscript
  // assignment evaluates the VALUE first, so a key with an observable effect
  // would move. Bind it first when it is not a bare read.
  let key = expr(args[0])
  if (is_trivial_node(args[0])) { return [`${recv}[${key}] = ${expr(args[1])}`] }
  return [`_revl_key = ${key}`, `${recv}[_revl_key] = ${expr(args[1])}`]
}

// -------------------------------------------------------------- statements
// `_emit_assert`: bind each side of a comparison once and report both values.
fn emit_assert(e: Any, indent: Int) -> List[Str] {
  var out = []
  if (node_kind(e) == "bin" && is_cmp_op(node_op(e))) {
    let pop = py_bin_op(node_op(e))
    let left = expr(value_field(e, "left"))
    let right = expr(value_field(e, "right"))
    out = out.push(line(indent, `_revl_lhs = ${left}`))
    out = out.push(line(indent, `_revl_rhs = ${right}`))
    let shown = py_repr(`${left} ${pop} ${right}`)
    out = out.push(line(indent, `assert _revl_lhs ${pop} _revl_rhs, ${shown} + '\n  left  = ' + repr(_revl_lhs) + '\n  right = ' + repr(_revl_rhs)`))
    return out
  }
  out = out.push(line(indent, `assert ${expr(e)}`))
  return out
}

// `_fn_stmt`: one fn-body step -> its emitted lines (already indented).
// `inplace`/`births` are item 436 F1's per-fn analysis, computed once in
// `emit_functions` and threaded down (the reference keeps them in a module
// global for the same reason: `fn_stmt` sees one step, the proof needs the
// whole body).
fn fn_stmt(node: Any, indent: Int, inplace: List[Str], births: List[Str]) -> List[Str] {
  let step = value_str(value_field(node, "step"))
  var out = []
  if (step == "let" || step == "assign") {
    let nm = value_str(value_field(node, "name"))
    let value = value_field(node, "value")
    if (list_contains(inplace, nm)) {
      if (step == "assign" && self_rebind(nm, value)) {
        for (s of inplace_stmts(nm, value)) { out = out.push(line(indent, s)) }
        return out
      }
      let container = step == "let" ? birth_container(births, nm) : ""
      if (container != "") {
        out = out.push(line(indent, `${mangle(nm)} = ${container}(${expr(value)})`))
        return out
      }
    }
    out = out.push(line(indent, `${mangle(nm)} = ${expr(value)}`))
    return out
  }
  if (step == "return") {
    let e = value_field(node, "expr")
    if (value_is_null(e)) {
      out = out.push(line(indent, "return"))
    } else {
      out = out.push(line(indent, `return ${expr(e)}`))
    }
    return out
  }
  if (step == "if") {
    out = out.push(line(indent, `if ${expr(value_field(node, "cond"))}:`))
    for (s of value_list(value_field(node, "then"))) { out = out.concat(fn_stmt(s, indent + 1, inplace, births)) }
    let els = value_list(value_field(node, "else"))
    if (els.length() > 0) {
      out = out.push(line(indent, "else:"))
      for (s of els) { out = out.concat(fn_stmt(s, indent + 1, inplace, births)) }
    }
    return out
  }
  if (step == "while") {
    out = out.push(line(indent, `while ${expr(value_field(node, "cond"))}:`))
    let body = value_list(value_field(node, "body"))
    if (body.length() == 0) {
      out = out.push(line(indent + 1, "pass"))
    } else {
      for (s of body) { out = out.concat(fn_stmt(s, indent + 1, inplace, births)) }
    }
    return out
  }
  if (step == "for") {
    out = out.push(line(indent, `for ${mangle(value_str(value_field(node, "bind")))} in ${expr(value_field(node, "iterable"))}:`))
    let body = value_list(value_field(node, "body"))
    if (body.length() == 0) {
      out = out.push(line(indent + 1, "pass"))
    } else {
      for (s of body) { out = out.concat(fn_stmt(s, indent + 1, inplace, births)) }
    }
    return out
  }
  if (step == "expr") {
    out = out.push(line(indent, expr(value_field(node, "expr"))))
    return out
  }
  if (step == "assert") {
    return emit_assert(value_field(node, "expr"), indent)
  }
  // item 379 / 391: bare loop control -> the host keyword (frame-neutral).
  if (step == "break") {
    out = out.push(line(indent, "break"))
    return out
  }
  if (step == "continue") {
    out = out.push(line(indent, "continue"))
    return out
  }
  out = out.push(line(indent, `<<UNSUPPORTED-STEP:${step}>>`))
  return out
}

fn fn_params(params: List[Any]) -> Str {
  var ps = []
  for (p of params) { ps = ps.push(mangle(value_str(value_field(p, "name")))) }
  return ps.join(", ")
}

// `_emit_functions`: each module fn as a Python `def`, blank-line separated.
fn emit_functions(functions: List[Any]) -> List[Str] {
  var out = []
  for (fnode of functions) {
    let name = mangle(value_str(value_field(fnode, "name")))
    let params = fn_params(value_list(value_field(fnode, "params")))
    out = out.push(`def ${name}(${params}):`)
    let body = value_list(value_field(fnode, "body"))
    if (body.length() == 0) { out = out.push(line(1, "pass")) }
    // item 436 F1: the accumulation locals whose persistent copies are
    // provably unobservable, computed once over the whole body
    let inplace = inplace_locals(fnode)
    let births = inplace_births(fnode, inplace)
    for (s of body) { out = out.concat(fn_stmt(s, 1, inplace, births)) }
    out = out.push("")
  }
  return out
}

// =====================================================================
// Path B slice 4 — externs (`_emit_externs`), byte-exact.
// =====================================================================
// The reference is `def <name>(<params>):` then, for the verbatim `@py`
// body, `textwrap.dedent(bodies["py"].strip("\n")).splitlines()` (one indented
// line each), or `pass` for an empty body. `dedent` is stdlib/str.rvl's verified
// port (item 193); the two host-string steps it composes with — a `"\n"`-only
// strip and `str.splitlines()` — are spelled here over the base `Str` surface.

// `str.strip("\n")`: strip ONLY the newline char (U+000A) from both ends — NOT
// other whitespace (unlike `trim`). The reference strips the leading/trailing
// blank lines a `@py { … }` block carries before it dedents.
fn strip_nl(s: Str) -> Str {
  let n = newline()
  var a = 0
  var b = s.length()
  while (a < b && s.slice(a, a + 1) == n) { a += 1 }
  while (b > a && s.slice(b - 1, b) == n) { b -= 1 }
  return s.slice(a, b)
}

// `str.splitlines()` for a `\n`-separated body (the only line boundary a normal
// `@py` body carries): split on `\n`, but DROP the final empty segment a
// trailing `\n` produces — the one place `splitlines()` differs from
// `split("\n")` (`"a\n".splitlines()` == `["a"]`, not `["a", ""]`). A body
// carrying `\r`/`\v`/`\f`/`\x1c…` line boundaries is out of this slice's scope
// (see the findings note) — real py extern bodies are `\n`-separated.
fn splitlines(s: Str) -> List[Str] {
  let n = newline()
  let parts = s.split(n)
  var drop = false
  if (s.length() > 0 && s.slice(s.length() - 1, s.length()) == n) { drop = true }
  var out = []
  var i = 0
  let m = parts.length()
  while (i < m) {
    if (!(drop && i == m - 1)) { out = out.push(parts[i]) }
    i += 1
  }
  return out
}

// `_emit_externs`: each extern as a Python `def`, its verbatim `@py` body
// dedented + split into indented lines. An async extern's `async def` header is
// reproduced faithfully; the await-seed / awaited call sites it needs are
// DEFERRED to slice 5 (so an async extern is excluded from the cross-check).
fn emit_externs(externs: List[Any]) -> List[Str] {
  var out = []
  for (ext of externs) {
    let name = mangle(value_str(value_field(ext, "name")))
    var ps = []
    for (p of value_list(value_field(ext, "params"))) { ps = ps.push(mangle(value_str(value_field(p, "name")))) }
    var kw = "def"
    if (value_bool(value_field(ext, "async"))) { kw = "async def" }
    // item 421 F6 (ported per item 429(d)): the extern's declared return carried
    // `Secret[T]`, so its result is where a confidential value ENTERS the value
    // world (item 256 §7a). `taint.py` strips the qualifier and leaves
    // `externs[i].secret_return` as the only surviving record of it, so the
    // decorator is emitted from that stamp: one wrapper per declaration rather
    // than one per call site, which is what lets a sink with no positional
    // marking of its own (the host trace an operator console prints) scrub it.
    // Emitted ONLY for a `Secret[T]`-returning extern, so every other module is
    // byte-identical.
    if (value_bool(value_field(ext, "secret_return"))) {
      out = out.push("@".concat(runtime_ref("secret_result")))
    }
    out = out.push(`${kw} ${name}(${ps.join(", ")}):`)
    let body = dedent(strip_nl(value_str(value_field(value_field(ext, "bodies"), "py"))))
    if (body != "") {
      for (ln of splitlines(body)) { out = out.push(line(1, ln)) }
    } else {
      out = out.push(line(1, "pass"))
    }
    out = out.push("")
  }
  return out
}

// --------------------------------------------------- conditional preludes
fn i64_block() -> List[Str] {
  var o = []
  o = o.push("_REVL_I64_MIN = -(2 ** 63)")
  o = o.push("_REVL_I64_MAX = 2 ** 63 - 1")
  o = o.push("")
  o = o.push("def _revl_i64(v):")
  o = o.push(`    """Int is bounded 64-bit and overflow traps. python is arbitrary"""`)
  o = o.push(`    """precision, so the bound is imposed here."""`)
  o = o.push("    if v < _REVL_I64_MIN or v > _REVL_I64_MAX:")
  o = o.push("        raise OverflowError('revl: Int overflow')")
  o = o.push("    return v")
  o = o.push("")
  return o
}

fn i32_block() -> List[Str] {
  var o = []
  o = o.push("_REVL_I32_MIN = -(2 ** 31)")
  o = o.push("_REVL_I32_MAX = 2 ** 31 - 1")
  o = o.push("")
  o = o.push("def _revl_i32(v):")
  o = o.push(`    """Int32 is bounded 32-bit and overflow traps (docs/arithmetic.md)."""`)
  o = o.push("    if v < _REVL_I32_MIN or v > _REVL_I32_MAX:")
  o = o.push("        raise OverflowError('revl: Int32 overflow')")
  o = o.push("    return v")
  o = o.push("")
  return o
}

fn i32_wrap_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_i32_wrap(v):")
  o = o.push("    \"\"\"Wrap an Int32 `<<` result into 32-bit two's complement (docs/arithmetic.md).\"\"\"")
  o = o.push("    v &= 0xFFFFFFFF")
  o = o.push("    return v - 0x100000000 if v & 0x80000000 else v")
  o = o.push("")
  return o
}

// The stdlib lowerings that need more than one expression: a MODULE-LEVEL
// `def`, gated on use, rather than a lambda built and applied at every
// evaluation (item 436 F6). Same shape as `_revl_div` — one frame, no
// function-object allocation.
fn rem_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_rem(a, b):")
  o = o.push(`    """The TRUNCATED remainder: it takes the sign of the DIVIDEND, as in"""`)
  o = o.push("    \"\"\"TypeScript. python's own `%` floors and takes the divisor's sign.\"\"\"")
  o = o.push("    return abs(a) % abs(b) if a >= 0 else -(abs(a) % abs(b))")
  o = o.push("")
  return o
}

fn div_trunc_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_div_trunc(a, b):")
  o = o.push(`    """Division that TRUNCATES toward zero (docs/arithmetic.md)."""`)
  o = o.push("    return (abs(a) // abs(b) if (a < 0) == (b < 0)")
  o = o.push("            else -(abs(a) // abs(b)))")
  o = o.push("")
  return o
}

fn div_euclid_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_div_euclid(a, b):")
  o = o.push(`    """Euclidean division: the remainder is never negative (docs/arithmetic.md)."""`)
  o = o.push("    return a // b if b > 0 else -(a // -b)")
  o = o.push("")
  return o
}

fn index_of_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_index_of(v, n):")
  o = o.push("    \"\"\"First index of `n`, -1 when absent — a Str receiver or a List one.\"\"\"")
  o = o.push("    if isinstance(v, str):")
  o = o.push("        return v.find(n)")
  o = o.push("    return v.index(n) if n in v else -1")
  o = o.push("")
  return o
}

fn split_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_split(v, s):")
  o = o.push(`    """JS-shape split: an empty separator yields 1-char strings (py raises)."""`)
  o = o.push(`    return list(v) if s == "" else v.split(s)`)
  o = o.push("")
  return o
}

fn str_to_int_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_str_to_int(s):")
  o = o.push("    \"\"\"Str.to_int: the ASCII digits with an optional leading `-`, else None.\"\"\"")
  o = o.push(`    if s == "" or s == "-" or not s.isascii():`)
  o = o.push("        return None")
  o = o.push(`    if not (s.isdigit() or (s[0] == "-" and s[1:].isdigit())):`)
  o = o.push("        return None")
  o = o.push("    n = int(s)")
  o = o.push("    return n if -(2**63) <= n <= 2**63 - 1 else None")
  o = o.push("")
  return o
}

fn opt_to_int_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_opt_to_int(v):")
  o = o.push("    \"\"\"`?.to_int()`: the node carries no receiver type, so dispatch on the payload.\"\"\"")
  o = o.push("    return _revl_str_to_int(v) if isinstance(v, str) else v")
  o = o.push("")
  return o
}

fn div_block() -> List[Str] {
  var o = []
  o = o.push("import math as _revl_math")
  o = o.push("")
  o = o.push("def _revl_div(a, b):")
  o = o.push(`    """IEEE 754 true division: python raises where every other tier follows IEEE."""`)
  o = o.push("    if b:")
  o = o.push("        return a / b")
  o = o.push("    if a == 0:")
  o = o.push("        return float('nan')")
  o = o.push("    return (_revl_math.copysign(float('inf'), a)")
  o = o.push("            * _revl_math.copysign(1.0, b))")
  o = o.push("")
  return o
}

fn comp_names(ir: Any) -> Str {
  var ns = []
  for (c of value_list(value_field(ir, "components"))) { ns = ns.push(value_str(value_field(c, "name"))) }
  return ns.join(", ")
}

// =====================================================================
// Path B slice 2 — components & services (mirrors `_ComponentEmitter`).
// =====================================================================
//
// A component/service document adds, over the function-only scaffold: a
// populated SERVICES table, and one `_<snake>_apply` closure + plugin dict per
// component. The component/method body surface is a SECOND expression dispatcher
// (`cexpr`), distinct from the fn-body `expr` above exactly as the reference
// keeps `_ComponentEmitter._expr` distinct from the module `_expr`: it renders
// `req`/`name`/method-`call` and — the load-bearing difference — does NOT
// specialize arithmetic (no `_revl_i64`/`_revl_div`/widen wrapper; a component
// `+` is a plain `(a + b)`). The two therefore cannot be shared.
//
// Slice 4 (item 206) added the `config` cexpr, config (`ConfigSchema`), and the
// method-body `effect`/`let-effect`/compensated-`emit` accumulator (the
// `_revl_frame.adopt`/`.acquire` + `_label`/`_effect_N`/`_emit_N` counter, now
// threaded through provides/methods). STILL DEFERRED to slice 5 (a divergence,
// not a bug, if fed one): async coloring (async methods / await bodies / the
// await-seed), host roots (`Pool`/`Map`/`Job`) in COMPONENT bodies (fn/test
// bodies already covered), realm placements (`isolate`/`intercept`/`routes`/the
// router), spawn/instances, lifecycle TESTS (the `plug`/`set_trace`/`Clock`/
// `asyncio` driver), and the `adt`/`format`/`host`/`spawn`/`instance-get` cexpr
// kinds.

// A body-emission result: the lines produced AND the running timer counter (the
// reference's `self._counter`, threaded here since revl has no method state).
type Emit = { lines: List[Str], counter: Int }

// `_runtime_ref` / `_IMPORT_ALIAS` (the subset): the in-module name a runtime
// import is referenced by.
fn runtime_ref(name: Str) -> Str {
  if (name == "Frame") { return "_revl_Frame" }
  if (name == "ConfigSchema") { return "_revl_ConfigSchema" }
  if (name == "schedule_every") { return "_revl_schedule_every" }
  if (name == "schedule_after") { return "_revl_schedule_after" }
  // item 421 F6 (ported per item 429(d)): the two declared-`Secret[T]` markings
  // the EMITTED program carries.
  if (name == "mark_secret") { return "_revl_mark_secret" }
  if (name == "secret_result") { return "_revl_secret_result" }
  return name
}

// -------------------------------------------- component-body expressions (cexpr)
fn ccommajoin(nodes: List[Any]) -> Str {
  var parts = []
  for (e of nodes) { parts = parts.push(cexpr(e)) }
  return parts.join(", ")
}

fn crecord(fields: List[Any]) -> Str {
  var parts = []
  for (p of fields) { parts = parts.push(`${py_repr(value_at(p, 0))}: ${cexpr(value_at(p, 1))}`) }
  return "{".concat(parts.join(", ")).concat("}")
}

fn clist(items: List[Any]) -> Str {
  var parts = []
  for (e of items) { parts = parts.push(cexpr(e)) }
  return "[".concat(parts.join(", ")).concat("]")
}

fn crecord_update(base: Str, updates: List[Any]) -> Str {
  var parts = []
  parts = parts.push(`**${base}`)
  for (u of updates) { parts = parts.push(`${py_repr(value_at(u, 0))}: ${cexpr(value_at(u, 1))}`) }
  return "{".concat(parts.join(", ")).concat("}")
}

fn carrow(node: Any) -> Str {
  // NOTE: unlike the fn-body arrow, the component arrow appends NO `=capture`
  // params (the reference `_ComponentEmitter._expr` arrow branch omits them).
  var ps = []
  for (p of value_list(value_field(node, "params"))) { ps = ps.push(mangle(value_str(p))) }
  let lp = ps.join(", ")
  return `lambda ${lp}: ${cexpr(value_field(node, "body"))}`
}

// component `bin`: NO arithmetic specialization (the reference difference).
fn cbin(node: Any) -> Str {
  let op = node_op(node)
  if (op == "??") {
    let left = value_field(node, "left")
    let lhs = cexpr(left)
    let rhs = cexpr(value_field(node, "right"))
    if (is_trivial_node(left)) { return `(${rhs} if ${lhs} is None else ${lhs})` }
    let name = opt_temp(node)
    return `(${name} if (${name} := ${lhs}) is not None else ${rhs})`
  }
  let pop = py_bin_op(op)
  return `(${cexpr(value_field(node, "left"))} ${pop} ${cexpr(value_field(node, "right"))})`
}

fn cun(node: Any) -> Str {
  let op = node_op(node)
  if (op == "!") { return `(not ${cexpr(value_field(node, "operand"))})` }
  if (op == "-") { return `(-${cexpr(value_field(node, "operand"))})` }
  return `<<UNSUPPORTED-UN:${op}>>`
}

fn cmatch_branch(arm: Any, rest: Str, has_rest: Bool, head: Str) -> Str {
  let pattern = value_str(value_field(arm, "pattern"))
  var body = cexpr(value_field(arm, "body"))
  if (pattern == "_") { return body }
  let bind = value_str(value_field(arm, "bind"))
  var cond = ""
  if (pattern == "None") {
    cond = `${head} is None`
  } else {
    if (pattern == "Some") {
      cond = `${head} is not None`
      if (bind != "") { body = `(lambda ${bind}: ${body})(match)` }
    } else {
      if (bind != "") { body = `(lambda ${bind}: ${body})(match.value)` }
      cond = `isinstance(${head}, ${pattern})`
    }
  }
  if (!has_rest) {
    return `(${body} if ${cond} else (_ for _ in ()).throw(TypeError('non-exhaustive match')))`
  }
  return `(${body} if ${cond} else ${rest})`
}

fn cmatch(scrutinee: Str, arms: List[Any]) -> Str {
  let folds = match_folds(arms)
  var result = ""
  var has = false
  var i = arms.length() - 1
  while (i >= 0) {
    var head = "match"
    if (folds && i == 0) { head = `(match := ${scrutinee})` }
    result = cmatch_branch(arms[i], result, has, head)
    has = true
    i -= 1
  }
  if (!has) {
    result = "(_ for _ in ()).throw(TypeError('non-exhaustive match'))"
  }
  if (folds) { return result }
  return `((match := ${scrutinee}), ${result})[1]`
}

// The component/method-body expression dispatcher (`_ComponentEmitter._expr`).
fn cexpr(node: Any) -> Str {
  let kind = node_kind(node)
  if (kind == "lit") { return py_repr(value_field(node, "value")) }
  if (kind == "var") {
    let nm = value_str(value_field(node, "name"))
    if (nm == "None") { return "None" }
    if (nm == "Some") { return "(lambda _v: _v)" }
    return mangle(nm)
  }
  if (kind == "name") { return mangle(value_str(value_field(node, "id"))) }
  if (kind == "req") { return "_revl_ctx.".concat(value_str(value_field(node, "name"))) }
  // `config.<field>` (slice 4): a read of the resolved config dict. The field
  // is repr'd RAW (unlike the schema declaration, which mangles it) — mirroring
  // the reference `_expr` config branch exactly.
  if (kind == "config") { return `_revl_config[${py_repr(value_field(node, "field"))}]` }
  if (kind == "call") {
    if (!value_is_null(value_field(node, "target"))) {
      let t = cexpr(value_field(node, "target"))
      let m = value_str(value_field(node, "method"))
      return `${t}.${m}(${ccommajoin(value_list(value_field(node, "args")))})`
    }
    // `Some(x)` is the identity here too (item 436 F8)
    let callee_node = value_field(node, "callee")
    let call_args = value_list(value_field(node, "args"))
    if (is_some_var(callee_node) && call_args.length() == 1) { return cexpr(call_args[0]) }
    let callee = cexpr(callee_node)
    return `${callee}(${ccommajoin(call_args)})`
  }
  if (kind == "field") {
    return field_read(cexpr(value_field(node, "target")), py_repr(value_field(node, "name")), false)
  }
  if (kind == "index") {
    return `${cexpr(value_field(node, "target"))}[${cexpr(value_field(node, "index"))}]`
  }
  if (kind == "bin") { return cbin(node) }
  if (kind == "un") { return cun(node) }
  if (kind == "if") {
    return `(${cexpr(value_field(node, "then"))} if ${cexpr(value_field(node, "cond"))} else ${cexpr(value_field(node, "else"))})`
  }
  if (kind == "record") { return crecord(value_list(value_field(node, "fields"))) }
  if (kind == "record_update") {
    return crecord_update(cexpr(value_field(node, "base")), value_list(value_field(node, "updates")))
  }
  if (kind == "list") { return clist(value_list(value_field(node, "items"))) }
  if (kind == "arrow") { return carrow(node) }
  if (kind == "match") {
    return cmatch(cexpr(value_field(node, "scrutinee")), value_list(value_field(node, "arms")))
  }
  if (kind == "builtin") {
    var args = []
    for (a of value_list(value_field(node, "args"))) { args = args.push(cexpr(a)) }
    return render_builtin(value_str(value_field(node, "method")), cexpr(value_field(node, "target")), args, value_str(value_field(node, "recv")))
  }
  if (kind == "maplit") { return "{}" }
  if (kind == "optfield") {
    let tgt = value_field(node, "target")
    let t = cexpr(tgt)
    return `(None if ${opt_binder(node, tgt, t)} is None else ${field_read(opt_reader(node, tgt, t), py_repr(value_field(node, "name")), true)})`
  }
  if (kind == "optcall") {
    let tgt = value_field(node, "target")
    let t = cexpr(tgt)
    var args = []
    for (a of value_list(value_field(node, "args"))) { args = args.push(cexpr(a)) }
    let body = render_builtin(value_str(value_field(node, "method")), opt_reader(node, tgt, t), args, "?")
    return `(None if ${opt_binder(node, tgt, t)} is None else ${body})`
  }
  if (kind == "fn") {
    return `${mangle(value_str(value_field(node, "name")))}(${ccommajoin(value_list(value_field(node, "args")))})`
  }
  return `<<UNSUPPORTED-CEXPR:${kind}>>`
}

// -------------------------------------------------- component-body statements
// `_setup_step`: a pure setup step inside a block-effect acquisition.
fn setup_step(step: Any, indent: Int) -> List[Str] {
  let kind = value_str(value_field(step, "step"))
  var out = []
  if (kind == "let" || kind == "assign") {
    out = out.push(line(indent, `${mangle(value_str(value_field(step, "name")))} = ${cexpr(value_field(step, "value"))}`))
    return out
  }
  if (kind == "expr") { out = out.push(line(indent, cexpr(value_field(step, "expr")))); return out }
  if (kind == "if") {
    out = out.push(line(indent, `if ${cexpr(value_field(step, "cond"))}:`))
    for (n of value_list(value_field(step, "then"))) { out = out.concat(setup_step(n, indent + 1)) }
    let els = value_list(value_field(step, "else"))
    if (els.length() > 0) {
      out = out.push(line(indent, "else:"))
      for (n of els) { out = out.concat(setup_step(n, indent + 1)) }
    }
    return out
  }
  if (kind == "assert") { out = out.push(line(indent, `assert ${cexpr(value_field(step, "expr"))}`)); return out }
  out = out.push(line(indent, `<<UNSUPPORTED-SETUP:${kind}>>`))
  return out
}

// `_method_step`: one step inside a provide-method body. A method-body EFFECT
// runs per request, so — unlike an activation-body effect (`body_step`, which
// yields the inverse straight into the fiber) — it must JOIN the component's
// accumulator through the Frame: `_revl_frame.adopt(_revl_ctx.effect(<fn>,
// <label>))`. The label is `_label`: `{component}.{provide}.{method}#{counter}`
// off the shared `_counter` (threaded here since revl has no method state), and
// the effect-closure name uses the counter value BEFORE that increment
// (`_effect_N` pairs with `#{N+1}`), exactly as the reference reads then bumps.
// Slice 4 handles the non-async surface: value bindings, `effect`, method
// `let-effect` (the spawn form — its `spawn` acquire cexpr lands in slice 5, so
// it is implemented but not yet cross-checked), saga `emit ... compensate`,
// plain `emit`, and `return`. (`await` stays slice 5.)
fn method_step(step: Any, indent: Int, provide_name: Str, method_name: Str, comp_name: Str, counter: Int) -> Emit {
  let kind = value_str(value_field(step, "step"))
  if (kind == "let" || kind == "assign") {
    var out = [line(indent, `${mangle(value_str(value_field(step, "name")))} = ${cexpr(value_field(step, "value"))}`)]
    return { lines: out, counter: counter }
  }
  if (kind == "effect") {
    let fname = `_effect_${counter}`
    var out = [line(indent, `def ${fname}():`)]
    out = out.push(line(indent + 1, cexpr(value_field(step, "acquire"))))
    out = out.push(line(indent + 1, `yield lambda: ${cexpr(value_field(step, "undo"))}`))
    let c = counter + 1
    let label = `${comp_name}.${provide_name}.${method_name}#${c}`
    out = out.push(line(indent, `_revl_frame.adopt(_revl_ctx.effect(${fname}, ${py_repr(label)}))`))
    return { lines: out, counter: c }
  }
  if (kind == "let-effect") {
    let bind = mangle(value_str(value_field(step, "bind")))
    let acq = cexpr(value_field(step, "acquire"))
    let inv = cexpr(value_field(step, "undo"))
    let c = counter + 1
    let label = `${comp_name}.${provide_name}.${method_name}#${c}`
    var out = [line(indent, `${bind} = _revl_frame.acquire(${py_repr(label)}, lambda: ${acq}, lambda ${bind}: ${inv})`)]
    return { lines: out, counter: c }
  }
  if (kind == "emit") {
    if (!value_is_null(value_field(step, "compensate"))) {
      // item 247 (method-body compensate remainder) (docs/design/teardown-contract.md): a method-body
      // `emit ... compensate ...` is a first-class COMPENSATION on the
      // activation frame (`_revl_frame.compensation_method`), the compensation
      // analog of item 318's method-witnessed wiring — NOT a bare
      // `yield lambda: <offset>` adopted as a sibling effect. A bare adopted
      // disposer is a bracket: it fires the offset on a CLEAN commit (destroying
      // the deliverable), interleaves with proof inverses, and is unguarded.
      // Routing through `compensation_method` makes it abort-only: discharged on
      // commit, drained in Phase 2 after every proof inverse, guarded and
      // residue-collected. Mirrors the reference emit.py's `_method_step`.
      var out = [line(indent, cexpr(value_field(step, "expr")))]
      out = out.push(line(indent, `_revl_frame.compensation_method(lambda: ${cexpr(value_field(step, "compensate"))})`))
      return { lines: out, counter: counter }
    }
    var out = [line(indent, cexpr(value_field(step, "expr")))]
    return { lines: out, counter: counter }
  }
  if (kind == "return") {
    if (value_is_null(value_field(step, "expr"))) { return { lines: [line(indent, "return")], counter: counter } }
    return { lines: [line(indent, `return ${cexpr(value_field(step, "expr"))}`)], counter: counter }
  }
  return { lines: [line(indent, `<<UNSUPPORTED-METHODSTEP:${kind}>>`)], counter: counter }
}

// item 421 F6 (ported per item 429(d)): the SURFACE names of this method's
// params that its SERVICE declares `Secret[T]`. The qualifier itself is stripped
// in `taint.py`, so the service spec's `params[i].secret` stamp is the only
// surviving record that the position is confidential, the same record
// `confidential.SecretIndex` reads in the recorder. A method's param names are
// its own and may differ from the declared ones (only the arity must agree), so
// the stamp is read BY INDEX off the declaration and the name comes from the
// method. `specs` is the service's `methods` record, reached by threading the
// services table down from `emit_py_src`: the method IR node alone cannot see
// this, which is exactly why the self-host was blind to it.
fn method_secret_params(m: Any, specs: Any) -> List[Str] {
  let declared = value_list(value_field(value_field(specs, value_str(value_field(m, "name"))), "params"))
  var out = []
  var i = 0
  for (p of value_list(value_field(m, "params"))) {
    if (i < declared.length() && value_bool(value_field(declared[i], "secret"))) {
      out = out.push(mangle(value_str(p)))
    }
    i += 1
  }
  return out
}

// `_method`: one provide-method as a Python `def` (sync only in this slice),
// threading the shared timer/effect counter across its body steps.
fn method_lines(m: Any, indent: Int, provide_name: Str, comp_name: Str, counter: Int, specs: Any) -> Emit {
  let name = mangle(value_str(value_field(m, "name")))
  var head = `def ${name}(self`
  for (p of value_list(value_field(m, "params"))) { head = head.concat(", ").concat(mangle(value_str(p))) }
  head = head.concat("):")
  var out = []
  out = out.push(line(indent, head))
  // A param the service declared `Secret[T]` is a declared DISCLOSURE RECEIVER.
  // Registering the value at the head of the receiver is what lets the runtime's
  // `_record` scrub it out of the operator console trace when the body goes on
  // to use it as a `Map` key (the shipped `demo/components/user_cache.rvl`
  // idiom), a `pool.query`, or a stream item. Emitted ONLY for a method that
  // actually declares one, so every other emitted module is byte-identical.
  let secret_params = method_secret_params(m, specs)
  if (secret_params.length() > 0) {
    out = out.push(line(indent + 1, `${runtime_ref("mark_secret")}(${secret_params.join(", ")})`))
  }
  let body = value_list(value_field(m, "body"))
  if (body.length() == 0) {
    // the mark is a statement in its own right, so a marked method with an empty
    // body needs no `pass` (mirrors the reference's `if not secret_params`).
    if (secret_params.length() == 0) { out = out.push(line(indent + 1, "pass")) }
    return { lines: out, counter: counter }
  }
  var c = counter
  for (s of body) {
    let se = method_step(s, indent + 1, provide_name, name, comp_name, c)
    out = out.concat(se.lines)
    c = se.counter
  }
  return { lines: out, counter: c }
}

// `_provide`: the provision class, its methods, and the runtime-derived
// revertible provision (yield the disposer, then populate). Threads the counter
// across its methods (a method-body effect shares the component's counter).
fn provide_lines(step: Any, indent: Int, comp_name: Str, counter: Int, services: Any) -> Emit {
  let name = mangle(value_str(value_field(step, "name")))
  let svc = value_str(value_field(step, "service"))
  // item 421 F6: the provided service's method specs, the only place the
  // `Secret[T]` param stamps survive.
  let specs = value_field(value_field(services, svc), "methods")
  let cls = "_".concat(pascal(name))
  var out = []
  out = out.push(line(indent, `class ${cls}:`))
  out = out.push(line(indent + 1, `"""service ${svc}, provided at key "${name}"."""`))
  let methods = value_list(value_field(step, "methods"))
  if (methods.length() == 0) { out = out.push(line(indent + 1, "pass")) }
  var c = counter
  for (m of methods) {
    out = out.push("")
    let me = method_lines(m, indent + 1, name, comp_name, c, specs)
    out = out.concat(me.lines)
    c = me.counter
  }
  out = out.push("")
  out = out.push(line(indent, `yield _revl_ctx.provide(${py_repr(name)})`))
  out = out.push(line(indent, `_revl_ctx.set(${py_repr(name)}, ${cls}())`))
  return { lines: out, counter: c }
}

// `_timer`: a revertible schedule — the firing closure, its handle, and the
// yielded `.cancel()` inverse.
fn timer_emit(step: Any, indent: Int, counter: Int) -> Emit {
  let mode = value_str(value_field(step, "mode"))
  var sched = "schedule_after"
  if (mode == "every") { sched = "schedule_every" }
  let c = counter + 1
  let fname = `_timer_${c}`
  let handle = fname.concat("_h")
  var out = []
  out = out.push(line(indent, `def ${fname}():`))
  let emissions = value_list(value_field(step, "body"))
  if (emissions.length() == 0) { out = out.push(line(indent + 1, "pass")) }
  for (em of emissions) { out = out.push(line(indent + 1, cexpr(value_field(em, "expr")))) }
  let interval = value_int(value_field(step, "interval_ms"))
  out = out.push(line(indent, `${handle} = ${runtime_ref(sched)}(${interval}, ${fname})`))
  out = out.push(line(indent, `yield lambda: ${handle}.cancel()`))
  return { lines: out, counter: c }
}

// `_body_step`: one activation-body step -> its lines (with the reference's
// trailing blank), threading the timer counter.
fn body_step(step: Any, indent: Int, comp_name: Str, counter: Int, services: Any) -> Emit {
  let kind = value_str(value_field(step, "step"))
  if (kind == "let-effect") {
    var out = []
    for (su of value_list(value_field(step, "setup"))) { out = out.concat(setup_step(su, indent)) }
    out = out.push(line(indent, `${mangle(value_str(value_field(step, "bind")))} = ${cexpr(value_field(step, "acquire"))}`))
    out = out.push(line(indent, `yield lambda: ${cexpr(value_field(step, "undo"))}`))
    out = out.push("")
    return { lines: out, counter: counter }
  }
  if (kind == "effect") {
    var out = []
    for (su of value_list(value_field(step, "setup"))) { out = out.concat(setup_step(su, indent)) }
    out = out.push(line(indent, cexpr(value_field(step, "acquire"))))
    out = out.push(line(indent, `yield lambda: ${cexpr(value_field(step, "undo"))}`))
    out = out.push("")
    return { lines: out, counter: counter }
  }
  if (kind == "fail") {
    var out = [line(indent, `raise RuntimeError(${cexpr(value_field(step, "message"))})`)]
    out = out.push("")
    return { lines: out, counter: counter }
  }
  if (kind == "emit") {
    var out = [line(indent, cexpr(value_field(step, "expr")))]
    if (!value_is_null(value_field(step, "compensate"))) {
      // item 247 (docs/design/teardown-contract.md): a compensation is a
      // first-class COMPENSATION entry on the frame's shared per-activation
      // LIFO stack, not a bare disposer — it discharges (never runs) on a
      // clean commit and runs best-effort in PHASE 2 of an abort, only after
      // every proof inverse (bracket + transactional) in this activation has
      // completed. This is the two-phase model, not the old
      // single-interleaved-LIFO ordering (docs/contract-errata.md TCK A5
      // respec, a5a/a5b); it is compensation, not inversion (§6.1).
      out = out.push(line(indent, `yield _revl_frame.compensation(lambda: ${cexpr(value_field(step, "compensate"))})`))
    }
    out = out.push("")
    return { lines: out, counter: counter }
  }
  if (kind == "if") {
    var out = [line(indent, `if ${cexpr(value_field(step, "cond"))}:`)]
    var c = counter
    let te = emit_body_steps(value_list(value_field(step, "then")), indent + 1, comp_name, c, services)
    out = out.concat(te.lines)
    c = te.counter
    let els = value_list(value_field(step, "else"))
    if (els.length() > 0) {
      out = out.push(line(indent, "else:"))
      let ee = emit_body_steps(els, indent + 1, comp_name, c, services)
      out = out.concat(ee.lines)
      c = ee.counter
    }
    out = out.push("")
    return { lines: out, counter: c }
  }
  if (kind == "timer") {
    let e = timer_emit(step, indent, counter)
    var out = e.lines
    out = out.push("")
    return { lines: out, counter: e.counter }
  }
  if (kind == "provide") {
    let pe = provide_lines(step, indent, comp_name, counter, services)
    var out = pe.lines
    out = out.push("")
    return { lines: out, counter: pe.counter }
  }
  var out = [line(indent, `<<UNSUPPORTED-BODYSTEP:${kind}>>`)]
  out = out.push("")
  return { lines: out, counter: counter }
}

fn emit_body_steps(steps: List[Any], indent: Int, comp_name: Str, counter: Int, services: Any) -> Emit {
  var out = []
  var c = counter
  for (s of steps) {
    let e = body_step(s, indent, comp_name, c, services)
    out = out.concat(e.lines)
    c = e.counter
  }
  return { lines: out, counter: c }
}

// Does any timer of `mode` appear in these body steps (walking `if` branches)?
// Drives the conditional `schedule_*` import.
fn body_has_timer(steps: List[Any], mode: Str) -> Bool {
  for (s of steps) {
    let k = value_str(value_field(s, "step"))
    if (k == "timer" && value_str(value_field(s, "mode")) == mode) { return true }
    if (k == "if") {
      if (body_has_timer(value_list(value_field(s, "then")), mode)) { return true }
      if (body_has_timer(value_list(value_field(s, "else")), mode)) { return true }
    }
  }
  return false
}

// item 421 F6: does any provide-method in these body steps (walking `if`
// branches, as `body_has_timer` does) declare a `Secret[T]` param? Gates the
// `mark_secret` import EXACTLY where `method_lines` emits the call, so a
// secret-free document's import line is byte-identical.
fn body_has_secret_param(steps: List[Any], services: Any) -> Bool {
  for (s of steps) {
    let k = value_str(value_field(s, "step"))
    if (k == "provide") {
      let specs = value_field(value_field(services, value_str(value_field(s, "service"))), "methods")
      for (m of value_list(value_field(s, "methods"))) {
        if (method_secret_params(m, specs).length() > 0) { return true }
      }
    }
    if (k == "if") {
      if (body_has_secret_param(value_list(value_field(s, "then")), services)) { return true }
      if (body_has_secret_param(value_list(value_field(s, "else")), services)) { return true }
    }
  }
  return false
}

// One component: the `_<snake>_apply` closure and its plugin dict.
fn component_body(comp: Any, services: Any) -> List[Str] {
  let name = mangle(value_str(value_field(comp, "name")))
  let sn = snake(name)
  var out = []
  // slice 4: the resolved-config schema, emitted BEFORE the apply closure and
  // rehung on the plugin dict below. `_<SNAKE>_CONFIG = _revl_ConfigSchema([…])`
  // — one `(field, type, default)` tuple per declared config field; the runtime
  // validates/resolves it before apply runs. The field name is mangled (as the
  // reference `_ident`s it); type/default are repr'd verbatim.
  let config_fields = value_list(value_field(comp, "config"))
  if (config_fields.length() > 0) {
    out = out.push(`_${upper(sn)}_CONFIG = _revl_ConfigSchema([`)
    for (spec of config_fields) {
      let field = mangle(value_str(value_field(spec, "name")))
      out = out.push(line(1, `(${py_repr(field)}, ${py_repr(value_field(spec, "type"))}, ${py_repr(value_field(spec, "default"))}),`))
    }
    out = out.push("])")
    out = out.push("")
    out = out.push("")
  }
  out = out.push(`def _${sn}_apply(_revl_ctx, _revl_config):`)
  out = out.push(line(1, `_revl_frame = _revl_Frame(_revl_ctx, ${py_repr(name)})`))
  out = out.push("")
  out = out.push(line(1, "def _body():"))
  // item 247 second-pass (F1): `begin` yielded FIRST -> disposed LAST (cordis
  // LIFO), the Phase-2 post-unwind hook at the bottom of the unwind stack, so a
  // post-activation abort's activation-body offsets are drained after Phase 1
  // instead of lost. Mirrors backends/python/emit.py (byte-agreement oracle).
  out = out.push(line(2, "yield _revl_frame.begin"))
  let e = emit_body_steps(value_list(value_field(comp, "body")), 2, name, 0, services)
  out = out.concat(e.lines)
  out = out.push(line(2, "yield _revl_frame.drain"))
  out = out.push("")
  out = out.push(line(1, "_revl_frame.install(_body)"))
  out = out.push("")
  out = out.push("")
  out = out.push(`${name} = {`)
  out = out.push(line(1, `'name': ${py_repr(name)},`))
  var inject = []
  for (k of value_keys(value_field(comp, "requires"))) { inject = inject.push(mangle(k)) }
  out = out.push(line(1, `'inject': ${py_repr(inject)},`))
  out = out.push(line(1, `'apply': _${sn}_apply,`))
  if (config_fields.length() > 0) {
    out = out.push(line(1, `'Config': _${upper(sn)}_CONFIG,`))
  }
  out = out.push("}")
  return out
}

// The SERVICES table, populated (mirrors the `emit()` service-table loop).
fn emit_services_table(services: Any) -> List[Str] {
  var out = []
  out = out.push("SERVICES = {")
  for (sname of value_keys(services)) {
    let svc = value_field(services, sname)
    out = out.push(line(1, `${py_repr(sname)}: {`))
    let methods = value_field(svc, "methods")
    for (mname of value_keys(methods)) {
      let spec = value_field(methods, mname)
      var pnames = []
      for (p of value_list(value_field(spec, "params"))) { pnames = pnames.push(value_str(value_field(p, "name"))) }
      var meta = []
      meta = meta.push(`'params': ${py_repr(pnames)}`)
      meta = meta.push(`'emission': ${py_repr(value_bool(value_field(spec, "emission")))}`)
      out = out.push(line(2, `${py_repr(mname)}: {${meta.join(", ")}},`))
    }
    out = out.push(line(1, "},"))
  }
  out = out.push("}")
  return out
}

// =====================================================================
// Path B slice 3 — the module-level DECLARATION surface (byte-exact).
// =====================================================================
//
// Slices 1-2 emit functions + components/services. Slice 3 adds the four
// remaining NON-async, NON-spawn MODULE declarations, each a `emit()`-gated
// section mirrored byte-for-byte:
//
//   * `_emit_types`  — record (`@dataclass`) and variant (sealed base + one
//     subclass per case) type declarations, including the forward-reference
//     annotation-quoting rule and the `_py_type` surface->python-type map
//     (incl function types -> `Callable[...]`);
//   * built-in Result classes  — `Ok`/`Err`, gated by `_uses_builtin_result`
//     and suppressed per-name when a user variant case shadows it;
//   * `_revl_ftoa`  — the canonical Float->Str interpolation helper, gated by
//     `_uses_float_interp` (a `${…}` over a provably-Float expression);
//   * host roots in fn/test bodies  — a `var` naming `Map`/`Pool`/`Job` pulls
//     the name into the sorted `from runtime import` line (`_find_host_roots`).
//
// LANDED in slice 4 (item 206): externs (`_emit_externs`, the verbatim `@py`
// body via stdlib/str.rvl::dedent + local `splitlines`), component `config`/
// `ConfigSchema`, and method-body `effect`/`let-effect`/compensated-`emit` (the
// `_revl_frame.adopt`/`.acquire` accumulator + `_label` counter). STILL DEFERRED
// to slice 5: in-file `test`/`fault_test`/`lifecycle test` emission, async
// coloring, realm placements, spawn/instances, and the canonical ABI.

// -------------------------------------------------------------- string utils
// `trim` / `lstrip` / `last_index_of` / `ident_tokens` now come from
// stdlib/str.rvl (`use` above, item 193) and `list_contains` from stdlib/list.rvl
// (item 194, replacing the former local `str_in`); only `split_types` (the
// comma-split whose per-part `trim` is now str.rvl's) stays local.

// `_split_types`: comma-split a bracket inner at depth zero, each part stripped.
fn split_types(inner: Str) -> List[Str] {
  var parts = []
  var depth = 0
  var cur = ""
  var i = 0
  let n = inner.length()
  while (i < n) {
    let ch = inner.slice(i, i + 1)
    if (ch == "[" || ch == "(") { depth += 1 }
    else {
      if (ch == "]" || ch == ")") { depth -= 1 }
    }
    if (ch == "," && depth == 0) {
      parts = parts.push(trim(cur))
      cur = ""
    } else {
      cur = cur.concat(ch)
    }
    i += 1
  }
  if (cur != "") { parts = parts.push(trim(cur)) }
  return parts
}

// `_split_fn_type`: `"(Int, Str) -> Bool"` -> params + return, else `ok=false`.
type FnType = { ok: Bool, params: List[Str], ret: Str }
fn split_fn_type(name: Str) -> FnType {
  if (!name.startsWith("(")) { return { ok: false, params: [], ret: "" } }
  var depth = 0
  var i = 0
  let n = name.length()
  while (i < n) {
    let ch = name.slice(i, i + 1)
    if (ch == "[" || ch == "(") { depth += 1 }
    else {
      if (ch == "]" || ch == ")") {
        depth -= 1
        if (depth == 0) {
          let rest = lstrip(name.slice(i + 1, n))
          if (!rest.startsWith("->")) { return { ok: false, params: [], ret: "" } }
          let inner = trim(name.slice(1, i))
          var params: List[Str] = []
          if (inner != "") { params = split_types(inner) }
          let ret = trim(rest.slice(2, rest.length()))
          return { ok: true, params: params, ret: ret }
        }
      }
    }
    i += 1
  }
  return { ok: false, params: [], ret: "" }
}

// `_py_type`: a revl surface type spelling -> its python annotation.
fn py_type(raw: Str) -> Str {
  let name = trim(raw)
  let fnt = split_fn_type(name)
  if (fnt.ok) {
    var ps = []
    for (p of fnt.params) { ps = ps.push(py_type(p)) }
    return `Callable[[${ps.join(", ")}], ${py_type(fnt.ret)}]`
  }
  let bi = name.indexOf("[")
  if (bi >= 0) {
    let base = name.slice(0, bi)
    let close = last_index_of(name, "]")
    let inner = name.slice(bi + 1, close)
    let args = split_types(inner)
    if (base == "Opt") { return `Optional[${py_type(args[0])}]` }
    if (base == "List") { return `list[${py_type(args[0])}]` }
    if (base == "Map") { return `dict[${py_type(args[0])}, ${py_type(args[1])}]` }
    if (base == "Result") { return "Any" }
    var anys = []
    for (a of args) { anys = anys.push("Any") }
    return base.concat("[").concat(anys.join(", ")).concat("]")
  }
  if (name == "Int") { return "int" }
  if (name == "Float") { return "float" }
  if (name == "Bool") { return "bool" }
  if (name == "Str") { return "str" }
  if (name == "Bytes") { return "bytes" }
  if (name == "Unit") { return "None" }
  return name
}

// `_ann`: render a field/payload annotation, quoting a forward reference (a
// mentioned type name not yet emitted) so Python's eager annotation eval holds.
fn type_ann(ftype: Str, all_names: List[Str], emitted: List[Str]) -> Str {
  let rendered = py_type(ftype)
  for (tok of ident_tokens(ftype)) {
    if (list_contains(all_names, tok) && !list_contains(emitted, tok)) { return py_repr(rendered) }
  }
  return rendered
}

// `_emit_types`: each record as an `@dataclass`, each variant as a sealed base
// class plus one value-semantic subclass per case, in declaration order.
fn emit_types(types: Any) -> List[Str] {
  var all_names = []
  for (nm of value_keys(types)) { all_names = all_names.push(mangle(nm)) }
  var emitted = []
  var out = []
  for (nm of value_keys(types)) {
    let name = mangle(nm)
    let spec = value_field(types, nm)
    if (value_str(value_field(spec, "kind")) == "record") {
      out = out.push("@dataclass")
      out = out.push(`class ${name}:`)
      let fields = value_field(spec, "fields")
      let fkeys = value_keys(fields)
      if (fkeys.length() == 0) { out = out.push(line(1, "pass")) }
      for (f of fkeys) {
        let ftype = value_str(value_field(fields, f))
        out = out.push(line(1, `${mangle(f)}: ${type_ann(ftype, all_names, emitted)}`))
      }
      emitted = emitted.push(name)
    } else {
      out = out.push(`class ${name}:`)
      out = out.push(line(1, "__slots__ = ()"))
      emitted = emitted.push(name)
      out = out.push("")
      for (c of value_list(value_field(spec, "cases"))) {
        let cname = mangle(value_str(value_field(c, "name")))
        if (value_is_null(value_field(c, "payload"))) {
          out = out.push(`class ${cname}(${name}):`)
          out = out.push(line(1, "__slots__ = ()"))
          out = out.push(line(1, "def __eq__(self, other):"))
          out = out.push(line(2, `return isinstance(other, ${cname})`))
          out = out.push(line(1, "def __hash__(self):"))
          out = out.push(line(2, `return hash(${py_repr(cname)})`))
        } else {
          out = out.push(`class ${cname}(${name}):`)
          out = out.push(line(1, `__slots__ = ("value",)`))
          out = out.push(line(1, "def __init__(self, value):"))
          out = out.push(line(2, "self.value = value"))
          out = out.push(line(1, "def __eq__(self, other):"))
          out = out.push(line(2, `return isinstance(other, ${cname}) and other.value == self.value`))
          out = out.push(line(1, "def __hash__(self):"))
          out = out.push(line(2, `return hash((${py_repr(cname)}, self.value))`))
        }
        out = out.push("")
      }
    }
    out = out.push("")
  }
  return out
}

// ---------------------------------------------- built-in Result (Ok/Err)
// `_uses_builtin_result`: does the IR construct or match the built-in Result?
// An `adt` typed `Result*`, a `match` arm on Ok/Err, or a checked-division
// builtin (which produces a Result). Recurses over every node exactly as the
// reference `any(walk(v) …)` does.
fn is_checked_div(m: Str) -> Bool {
  return m == "checked_div_trunc" || m == "checked_div_floor"
      || m == "checked_div_euclid" || m == "checked_mod"
}
fn walk_result(n: Any) -> Bool {
  let k = node_kind(n)
  if (k == "adt" && value_str(value_field(n, "type")).startsWith("Result")) { return true }
  if (k == "match") {
    for (arm of value_list(value_field(n, "arms"))) {
      let p = value_str(value_field(arm, "pattern"))
      if (p == "Ok" || p == "Err") { return true }
    }
  }
  if (is_checked_div(value_str(value_field(n, "method")))) { return true }
  for (c of value_children(n)) { if (walk_result(c)) { return true } }
  return false
}
fn uses_builtin_result(ir: Any) -> Bool {
  if (walk_result(value_field(ir, "components"))) { return true }
  if (walk_result(value_field(ir, "functions"))) { return true }
  if (walk_result(value_field(ir, "tests"))) { return true }
  return false
}

// The one Result class, for a builtin name not shadowed by a user variant case.
fn result_class(builtin: Str) -> List[Str] {
  var out = []
  out = out.push(`class ${builtin}:`)
  out = out.push(line(1, `__slots__ = ("value",)`))
  out = out.push(line(1, "def __init__(self, value=None):"))
  out = out.push(line(2, "self.value = value"))
  out = out.push(line(1, "def __eq__(self, other):"))
  out = out.push(line(2, `return isinstance(other, ${builtin}) and other.value == self.value`))
  out = out.push(line(1, "def __hash__(self):"))
  out = out.push(line(2, `return hash((${py_repr(builtin)}, self.value))`))
  out = out.push("")
  return out
}

// The user variant CASE names — the reference suppresses a built-in Result
// class whose name a user ADT case shadows.
fn user_case_names(types: Any) -> List[Str] {
  var names = []
  for (nm of value_keys(types)) {
    let spec = value_field(types, nm)
    if (value_str(value_field(spec, "kind")) == "variant") {
      for (c of value_list(value_field(spec, "cases"))) {
        names = names.push(value_str(value_field(c, "name")))
      }
    }
  }
  return names
}

// -------------------------------------------------- canonical Float -> Str
// `_uses_float_interp`: does any `${…}` template interpolate a provably-Float
// expression? Only then is `_revl_ftoa` emitted (docs/strings.md).
fn uses_float_interp(n: Any) -> Bool {
  if (node_kind(n) == "interp") {
    for (p of value_list(value_field(n, "parts"))) {
      if (value_str(value_at(p, 0)) == "expr" && is_float_expr(value_at(p, 1))) { return true }
    }
  }
  for (c of value_children(n)) { if (uses_float_interp(c)) { return true } }
  return false
}

// `_REVL_FTOA_SRC` verbatim: the ECMAScript Number::toString shortest-round-trip
// form, so `${aFloat}` agrees with every other tier (python's own `str(float)`
// would print `nan`/`0.0`, none of which match).
fn ftoa_block() -> List[Str] {
  var o = []
  o = o.push("def _revl_ftoa(x):")
  o = o.push(`    """Canonical Float -> Str: ECMAScript Number::toString (docs/strings.md)."""`)
  o = o.push("    if x != x:")
  o = o.push(`        return "NaN"`)
  o = o.push(`    if x == float("inf"):`)
  o = o.push(`        return "Infinity"`)
  o = o.push(`    if x == float("-inf"):`)
  o = o.push(`        return "-Infinity"`)
  o = o.push("    if x == 0:")
  o = o.push(`        return "0"`)
  o = o.push(`    sign = "-" if x < 0 else ""`)
  o = o.push("    s = repr(abs(x))")
  o = o.push(`    if "e" in s or "E" in s:`)
  o = o.push(`        mant, _, exp_s = s.replace("E", "e").partition("e")`)
  o = o.push("        exp = int(exp_s)")
  o = o.push("    else:")
  o = o.push("        mant, exp = s, 0")
  o = o.push(`    intpart, _, frac = mant.partition(".")`)
  o = o.push("    digits = intpart + frac")
  o = o.push("    point = len(intpart) + exp")
  o = o.push("    i = 0")
  o = o.push(`    while i < len(digits) - 1 and digits[i] == "0":`)
  o = o.push("        i += 1")
  o = o.push("        point -= 1")
  o = o.push(`    digits = digits[i:].rstrip("0") or "0"`)
  o = o.push(`    if digits == "0":`)
  o = o.push(`        return "0"`)
  o = o.push("    k = len(digits)")
  o = o.push("    n = point")
  o = o.push("    if k <= n <= 21:")
  o = o.push(`        body = digits + "0" * (n - k)`)
  o = o.push("    elif 0 < n <= 21:")
  o = o.push(`        body = digits[:n] + "." + digits[n:]`)
  o = o.push("    elif -6 < n <= 0:")
  o = o.push(`        body = "0." + "0" * (-n) + digits`)
  o = o.push("    else:")
  o = o.push("        e = n - 1")
  o = o.push(`        mantissa = digits if k == 1 else digits[0] + "." + digits[1:]`)
  o = o.push(`        body = mantissa + "e" + ("+" if e >= 0 else "-") + str(abs(e))`)
  o = o.push("    return sign + body")
  o = o.push("")
  return o
}

// ------------------------------------------------------------- host roots
// `_find_host_roots`: a `var` node naming `Map`/`Pool`/`Job` in a fn/test body
// pulls that host builtin into the `from runtime import` line.
fn uses_host_root(n: Any, root: Str) -> Bool {
  if (node_kind(n) == "var" && value_str(value_field(n, "name")) == root) { return true }
  for (c of value_children(n)) { if (uses_host_root(c, root)) { return true } }
  return false
}
fn ir_uses_host_root(ir: Any, root: Str) -> Bool {
  if (uses_host_root(value_field(ir, "functions"), root)) { return true }
  if (uses_host_root(value_field(ir, "tests"), root)) { return true }
  return false
}

// The document assembly, mirroring `emit()` for functions + components/services.
// Named `emit_py_src` (not a bare `emit_src`) so the whole self-host pipeline can
// `use` emit_py.rvl BESIDE emit_rust.rvl in one composition: a `use`d module's
// PRIVATE decls no longer leak (item 228), but the merge still flattens both
// modules' PUBLIC decls by bare name, so the two emitter entrypoints must differ
// (roadmap item 230 — enables the fully-native `compile.rvl`).
pub fn emit_py_src(ir: Any) -> Str {
  var out = []
  let ver = value_int(value_opt(ir, "ir_version") ?? 1)
  out = out.push(`"""Generated by the revl cordis-py backend (ir_version ${ver}) — do not edit.`)
  out = out.push("")
  out = out.push(`Components: ${comp_names(ir)}`)
  out = out.push(`"""`)
  out = out.push("")
  // The `from runtime import …` line (before the arithmetic preludes), rendered
  // in `sorted(uses)` order with the `_revl_` aliases. The `uses` set for this
  // slice: `Frame` iff there is any component; the `schedule_*` a timer needs;
  // and (slice 3) the host roots `Map`/`Pool`/`Job` a fn/test body references.
  // The canonical order is `list_sort(list_dedup(imports))` (stdlib/list.rvl,
  // item 194): the codepoint sort Python `sorted` uses, which puts the
  // capitalised names before the lower-case `schedule_*`. No longer walked as a
  // hand-positioned fixed sequence, so it generalises to an arbitrary import
  // vocabulary. (ConfigSchema / lifecycle drivers are deferred.)
  let components = value_list(value_field(ir, "components"))
  var need_every = false
  var need_after = false
  for (c of components) {
    if (body_has_timer(value_list(value_field(c, "body")), "every")) { need_every = true }
    if (body_has_timer(value_list(value_field(c, "body")), "after")) { need_after = true }
  }
  var need_config = false
  for (c of components) {
    if (value_list(value_field(c, "config")).length() > 0) { need_config = true }
  }
  // item 421 F6 (ported per item 429(d)): the two declared-`Secret[T]` marking
  // imports, each gated on EXACTLY the condition that emits its call, so a
  // secret-free document's import line is unchanged. `secret_result` is gated
  // from the extern list rather than through a component, because the externs
  // are rendered outside any component emitter (the reference gates it in the
  // same place, for the same reason).
  var need_mark_secret = false
  for (c of components) {
    if (body_has_secret_param(value_list(value_field(c, "body")), value_field(ir, "services"))) { need_mark_secret = true }
  }
  var need_secret_result = false
  for (e of value_list(value_field(ir, "externs"))) {
    if (value_bool(value_field(e, "secret_return"))) { need_secret_result = true }
  }
  // Collect the needed imports in any order; `list_sort` fixes the canonical
  // codepoint order below. Each alias-bearing name carries its `_revl_` alias.
  var imports = []
  if (need_config) { imports = imports.push("ConfigSchema as _revl_ConfigSchema") }
  if (components.length() > 0) { imports = imports.push("Frame as _revl_Frame") }
  if (ir_uses_host_root(ir, "Job")) { imports = imports.push("Job") }
  if (ir_uses_host_root(ir, "Map")) { imports = imports.push("Map") }
  if (ir_uses_host_root(ir, "Pool")) { imports = imports.push("Pool") }
  if (need_mark_secret) { imports = imports.push("mark_secret as _revl_mark_secret") }
  if (need_after) { imports = imports.push("schedule_after as _revl_schedule_after") }
  if (need_every) { imports = imports.push("schedule_every as _revl_schedule_every") }
  if (need_secret_result) { imports = imports.push("secret_result as _revl_secret_result") }
  if (imports.length() > 0) {
    let sorted_imports = list_sort(list_dedup(imports))
    out = out.push("from runtime import ".concat(sorted_imports.join(", ")))
    out = out.push("")
  }
  if (uses_bounded_int(ir)) { out = out.concat(i64_block()) }
  if (uses_bounded_int32(ir)) { out = out.concat(i32_block()) }
  if (uses_i32_shl(ir)) { out = out.concat(i32_wrap_block()) }
  if (uses_true_division(ir)) { out = out.concat(div_block()) }
  if (uses_trunc_rem(ir)) { out = out.concat(rem_block()) }
  if (uses_builtin_method(ir, "div_trunc")) { out = out.concat(div_trunc_block()) }
  if (uses_builtin_method(ir, "div_euclid")) { out = out.concat(div_euclid_block()) }
  if (uses_builtin_method(ir, "indexOf")) { out = out.concat(index_of_block()) }
  if (uses_builtin_method(ir, "split")) { out = out.concat(split_block()) }
  if (uses_builtin_method(ir, "to_int")) {
    out = out.concat(str_to_int_block())
    if (uses_opt_to_int(ir)) { out = out.concat(opt_to_int_block()) }
  }
  if (uses_float_interp(ir)) { out = out.concat(ftoa_block()) }
  // Built-in Result classes (gated), each suppressed if a user variant case
  // shadows the name.
  let types = value_field(ir, "types")
  if (uses_builtin_result(ir)) {
    let shadow = user_case_names(types)
    if (!list_contains(shadow, "Ok")) { out = out.concat(result_class("Ok")) }
    if (!list_contains(shadow, "Err")) { out = out.concat(result_class("Err")) }
  }
  // Type declarations (gated): the dataclass/typing imports, then the classes.
  if (value_keys(types).length() > 0) {
    out = out.push("from dataclasses import dataclass")
    out = out.push("from typing import Any, Callable, Optional, Union")
    out = out.push("")
    out = out.concat(emit_types(types))
  }
  let functions = value_list(value_field(ir, "functions"))
  if (functions.length() > 0) { out = out.concat(emit_functions(functions)) }
  // Externs (slice 4): `def <name>(...)` + dedented verbatim body, gated on a
  // non-empty extern list, between the functions and the SERVICES table.
  let externs = value_list(value_field(ir, "externs"))
  if (externs.length() > 0) { out = out.concat(emit_externs(externs)) }
  out = out.concat(emit_services_table(value_field(ir, "services")))
  out = out.push("")
  out = out.push("")
  for (c of components) {
    out = out.concat(component_body(c, value_field(ir, "services")))
    out = out.push("")
    out = out.push("")
  }
  var pairs = []
  for (c of components) {
    let nm = mangle(value_str(value_field(c, "name")))
    pairs = pairs.push(`${py_repr(nm)}: ${nm}`)
  }
  out = out.push("COMPONENTS = {".concat(pairs.join(", ")).concat("}"))
  return out.join(newline()).concat(newline())
}

// ---------------------------------------------------------------- in-file tests
test "operator table maps longest revl ops" {
  assert py_bin_op("===") == "=="
  assert py_bin_op("!==") == "!="
  assert py_bin_op("&&") == "and"
  assert py_bin_op("||") == "or"
}

test "the Python-keyword mangle is injective" {
  assert mangle("lambda") == "lambda_"
  assert mangle("class") == "class_"
  assert mangle("value") == "value"
  // `lambda` and the equally legal revl identifier `lambda_` must not both land
  // on `lambda_`: the ladder shifts up a rung instead of collapsing.
  assert mangle("lambda_") == "lambda__"
  assert mangle("lambda__") == "lambda___"
  // `_` is a soft keyword, so the all-underscore ladder shifts too
  assert mangle("_") == "__"
  assert mangle("__") == "___"
  // a name with no keyword root is verbatim, trailing underscores and all
  assert mangle("value_") == "value_"
  assert mangle("classic") == "classic"
}

test "py indentation is four spaces per level" {
  assert ind(0) == ""
  assert ind(2) == "        "
  assert line(1, "x") == "    x"
  assert line(2, "") == ""
}

test "builtin surface renders portable python" {
  assert render_builtin("length", "xs", ["ignored"], "") == "len(xs)"
  assert render_builtin("concat", "a", ["b"], "") == "(a + b)"
  assert render_builtin("push", "xs", ["e"], "") == "(xs + [e])"
  assert render_builtin("to_str", "n", ["ignored"], "") == "str(n)"
}

test "empty match is the non-exhaustive throw" {
  let empty = []
  assert match_expr("o", empty) == "((match := o), (_ for _ in ()).throw(TypeError('non-exhaustive match')))[1]"
}

test "py_type maps the surface types" {
  assert py_type("Int") == "int"
  assert py_type("List[Str]") == "list[str]"
  assert py_type("Opt[Row]") == "Optional[Row]"
  assert py_type("Map[Int, Row]") == "dict[int, Row]"
  assert py_type("(Int, Str) -> Bool") == "Callable[[int, str], bool]"
  assert py_type("Result[Row, Str]") == "Any"
}

test "ident_tokens finds the type-name mentions" {
  let ts = ident_tokens("Opt[Found]")
  assert ts.length() == 2
  assert ts[0] == "Opt"
  assert ts[1] == "Found"
}

test "split_fn_type recognises a function type" {
  let f = split_fn_type("(Int) -> Str")
  assert f.ok
  assert f.params.length() == 1
  assert f.params[0] == "Int"
  assert f.ret == "Str"
  assert !split_fn_type("List[Int]").ok
}

// --------------------------------------------------------------- slice-4 units
// The newline char is sourced as a backtick literal (as stdlib/str.rvl's `nl`
// does), tier-portable and independent of the `newline()` extern. (Item 182 now
// makes a file's own externs callable from its `test` blocks too, but the
// backtick form needs no extern at all.) `upper` is exercised byte-exactly by
// the services_config corpus fixture.
test "splitlines matches str.splitlines (drops the trailing-newline empty)" {
  let nlc = `
`
  assert splitlines("a".concat(nlc).concat("b")).length() == 2
  assert splitlines("a".concat(nlc)).length() == 1
  assert splitlines("a".concat(nlc).concat(nlc).concat("b")).length() == 3
}

test "strip_nl strips only newline chars, not other whitespace" {
  let nlc = `
`
  assert strip_nl(nlc.concat("x").concat(nlc)) == "x"
  assert strip_nl("  y  ") == "  y  "
}

// --------------------------------------------------------------- component wrap
// A trivial provider so the emitted module is a valid plugin (the pure
// `emit_py_src` above is what the cross-check exercises); mirrors the wrapper the
// other self-host stages carry. `render` avoids the `emit` keyword.
service EmitStream {
  fn render(ir: Any) -> Str
}

component EmitPy provides emitter: EmitStream {
  provide emitter {
    fn render(ir) = emit_py_src(ir)
  }
}
