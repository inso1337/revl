#!/bin/sh
# revl pre-commit: run the checks that have actually broken CI.
#
# Install (once per clone):   git config core.hooksPath tools/hooks
# Skip for one commit:        git commit --no-verify
#
# Kept under ~20s on purpose. A hook people wait a minute for is a hook people
# turn off. Anything slower belongs in CI.
#
# This hook is NOT the full pre-merge gate. Before a change reaches main run
# `make pre-merge` (tools/pre_merge.sh): it also runs the per-backend emit/golden
# suites that live outside `pytest tests/` — the drift that reds CI unnoticed
# (roadmap item 327). This hook deliberately does not run those slow per-backend
# suites; see CONTRIBUTING.md "The pre-merge gate".

set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

# In a git worktree the checkout has no `.venv` of its own — it lives beside
# the main checkout. Resolving the interpreter only against $root made this
# hook print "SKIPPED (no pytest)" for every worktree agent, which is exactly
# where an unverified commit is most likely. Fall back to the primary
# checkout's venv (git-common-dir points at the shared .git).
main_root=$(cd "$(git rev-parse --git-common-dir)/.." 2>/dev/null && pwd || echo "$root")
if [ -x .venv/bin/pytest ]; then
    PYTEST=.venv/bin/pytest
elif [ -x "$main_root/.venv/bin/pytest" ]; then
    PYTEST="$main_root/.venv/bin/pytest"
elif command -v pytest >/dev/null 2>&1; then
    PYTEST=pytest
else
    PYTEST=""
fi

fail=0
step() {
    printf '  %-36s' "$1"
    shift
    if out=$("$@" 2>&1); then
        echo "ok"
    else
        echo "FAILED"
        echo "$out" | tail -25 | sed 's/^/      /'
        fail=1
    fi
}

echo "pre-commit:"

# The frontend suite, which includes tests/test_conformance_validate.py: every
# tier's emitted code is handed to that tier's real compiler. That is the check
# that catches "the emitter did not raise, but its output does not compile".
#
# Run only the tests AFFECTED by the staged change (tools/affected_tests.py),
# not the whole minutes-long `tests/` suite: a docs-only commit selects nothing
# and returns in seconds, a leaf change runs its own tests. The suite grew far
# past this hook's ~20s promise, and a blanket `pytest tests/` on a worktree
# commit is what made agents wait (and made this hook feel like something to
# turn off with --no-verify). This is NOT a bypass: the affected selector is a
# conservative superset that fails SAFE to the full suite for any core, unmapped,
# or structural change, and `make pre-merge` still runs everything at land/CI.
#
# Fail safe twice over: if the selector is unavailable or says FULL, run all of
# `tests/` exactly as before; and a --timeout backstop (when pytest-timeout is
# present) means a single wedged cross-tier test can never hang the commit.
TIMEOUT_ARGS=""
if [ -n "$PYTEST" ] && "$PYTEST" --help 2>/dev/null | grep -q -- '--timeout'; then
    TIMEOUT_ARGS="--timeout=60 --timeout-method=thread"
fi
if [ -n "$PYTEST" ]; then
    SEL=$(python3 tools/affected_tests.py --root "$root" --base HEAD --format machine 2>/dev/null)
    SEL_FULL=$(printf '%s\n' "$SEL" | sed -n 's/^FULL //p')
    if [ -z "$SEL" ] || [ -z "$SEL_FULL" ]; then
        # selector unavailable (no python3, parse error) -> previous behavior
        step "frontend + emitted-code validation" "$PYTEST" tests/ $TIMEOUT_ARGS -q
    elif [ "$SEL_FULL" = "1" ]; then
        step "frontend + emitted-code validation (full)" "$PYTEST" tests/ $TIMEOUT_ARGS -q
    else
        SEL_PYTEST=$(printf '%s\n' "$SEL" | sed -n 's/^PYTEST //p')
        if [ -n "$SEL_PYTEST" ]; then
            n=$(printf '%s' "$SEL_PYTEST" | wc -w | tr -d ' ')
            step "frontend (affected: $n node(s))" "$PYTEST" $SEL_PYTEST $TIMEOUT_ARGS -q
        else
            echo "  frontend                           no affected tests (docs/config-only change)"
        fi
    fi
else
    echo "  frontend                           SKIPPED (no pytest)"
fi

# The TypeScript backend suite runs tsc over emitted code and shells out to the
# emitters. CI was red for hours on a failure only this suite sees.
# vitest must resolve node_modules from the directory it runs in, so unlike
# pytest this cannot fall back to the main checkout: running main's suite
# would test main's sources, not the ones being committed. A worktree without
# node_modules therefore skips — with the fix, because the previous version
# of this check failed instead and blocked every worktree commit outright.
if [ -d backends/typescript/node_modules ]; then
    step "typescript backend (vitest)" sh -c \
        'cd backends/typescript && npx vitest run --silent'
else
    echo "  typescript backend                 SKIPPED (no node_modules here)"
    if [ -d "$main_root/backends/typescript/node_modules" ] && [ "$main_root" != "$root" ]; then
        echo "      to check it: ln -s $main_root/backends/typescript/node_modules backends/typescript/node_modules"
    fi
fi

# Emitters are pure Python and the matrix needs no toolchain, so this always
# runs: it catches a backend that stops emitting a construct entirely.
step "conformance matrix (emit)" python3 tools/conformance.py

if [ "$fail" -ne 0 ]; then
    echo
    echo "pre-commit failed. Fix the above, or commit with --no-verify."
    exit 1
fi

# Say what could not be checked here rather than implying it passed. The rust
# tier resolves cordis-rs from crates.io; where that is unreachable the cargo
# tests skip, and only CI covers them.
if ! python3 - <<'PY' 2>/dev/null
import socket, sys
try:
    socket.create_connection(("static.crates.io", 443), timeout=3).close()
except OSError:
    sys.exit(1)
PY
then
    echo "  note: crates.io unreachable — rust cargo checks are CI-only here."
fi

echo "pre-commit: ok"
