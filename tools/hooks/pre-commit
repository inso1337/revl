#!/bin/sh
# revl pre-commit: run the checks that have actually broken CI.
#
# Install (once per clone):   git config core.hooksPath tools/hooks
# Skip for one commit:        git commit --no-verify
# Which python:               tools/hooks/resolve-python (REVL_HOOK_PYTHON wins)
#
# Kept under ~20s on purpose. A hook people wait a minute for is a hook people
# turn off. Anything slower belongs in CI.
#
# This hook is NOT the full pre-merge gate. Before a change reaches main run
# `make pre-merge` (tools/pre_merge.sh): it also runs the per-backend emit/golden
# suites that live outside `pytest tests/` — the drift that reds CI unnoticed
# (roadmap item 327). This hook deliberately does not run those slow per-backend
# suites; see CONTRIBUTING.md "The pre-merge gate".

set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

# Every python step below runs on ONE interpreter, the committer's:
# REVL_HOOK_PYTHON, else the active virtualenv, else this checkout's .venv, else
# python3 on PATH. tools/hooks/resolve-python picks it and refuses, loudly, an
# interpreter without pytest or one whose own revl is another tree's. A linked
# worktree used to fall back to the PRIMARY checkout's .venv instead: another
# python version, without the committer's cordis-py runtime, and an editable
# revl naming the primary checkout's src/ (issue #1608).
# main_root is only used below to suggest a node_modules link.
main_root=$(cd "$(git rev-parse --git-common-dir)/.." 2>/dev/null && pwd || echo "$root")
PY=$(sh tools/hooks/resolve-python "$root") || exit 1
# `-P -m pytest` (python 3.11+) runs pytest without putting the working
# directory first on sys.path, as the `pytest` script does.

# An interpreter can carry an editable install of revl pointing at another
# checkout's src/ (a plain `.pth` path entry); resolve-python refuses one whose
# revl is another tree's, and this export is the second line of defence.
# tests/conftest.py puts this tree's src/ on sys.path for the pytest process,
# but every python a test or a step starts would still import the installed
# revl and measure a tree other than the one being committed. PYTHONPATH entries come before
# site-packages and before anything a `.pth` appends, so exporting this tree's
# src/ first makes the process and all of its children agree.
# tests/test_child_python_resolves_this_tree.py holds it.
if [ -d "$root/src/revl" ]; then
    PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
fi

fail=0
# Set when a step ran and verified nothing (every test skipped, or none was
# collected). It does not fail the commit, but the final line says so.
unverified=0
step() {
    printf '  %-36s' "$1"
    shift
    if out=$("$@" 2>&1); then
        _unverified=$(printf '%s\n' "$out" | tail -1 | sed -n 's/^UNVERIFIED //p')
        if [ -n "$_unverified" ]; then
            echo "SKIPPED (${_unverified}: nothing verified)"
            unverified=1
        else
            # A pytest step says how many tests passed, so "ok" is never bare.
            _passed=$(pytest_count passed "$out")
            echo "ok${_passed:+ ($_passed passed)}"
        fi
    else
        echo "FAILED"
        echo "$out" | tail -25 | sed 's/^/      /'
        fail=1
    fi
}

# The number of tests of one outcome ($1: passed, skipped) that a `pytest -q`
# run's output ($2) reports, or nothing. Only the summary is read: the LAST
# line that ends the way pytest's summary does (" in 7.60s", optionally
# "(0:01:02)" and a "===" rule). A warning or a test's own output earlier on can
# contain "1 passed", and stderr printed AFTER the summary (a teardown warning,
# an atexit message) can too, so neither the whole output nor its last line is
# trusted. No summary line means no count, which the callers treat as nothing
# verified: UNVERIFIED for an affected selection, a refusal for the core subset.
# "1 xpassed" is not a pass: the outcome word must follow the count directly.
# Colour codes (FORCE_COLOR, PY_COLORS) are stripped first: they sit between
# the count and " in 0.02s" and after it, so the summary would not match.
pytest_count() {
    _esc=$(printf '\033')
    printf '%s\n' "$2" | sed "s/${_esc}\[[0-9;]*m//g" \
        | grep -E ' in [0-9]+(\.[0-9]+)?s( \([0-9:]+\))?( =+)?$' | tail -1 \
        | grep -Eo "(^|[^0-9])[0-9]+ $1" | grep -Eo '[0-9]+' | tail -1
}

# Judge a finished pytest run by what it ran, not only by its exit status
# (issue #2208). pytest exits 5 when the selection collected nothing, and 0
# when every selected test skipped or was deselected. In both cases no test
# checked the change, so neither may read as "ok". Takes the exit status and
# the output; returns 0 only when at least one test passed, and prints why not
# otherwise. The FULL branch below refuses the commit on that answer.
pytest_ran_tests() {
    if [ "$1" -eq 5 ]; then
        echo "pytest collected no tests from the selection: nothing checked this change"
        return 5
    fi
    [ "$1" -eq 0 ] || return "$1"
    _n=$(pytest_count passed "$2")
    if [ "${_n:-0}" -eq 0 ]; then
        echo "pytest passed no test (every selected test skipped or was deselected): nothing checked this change"
        return 5
    fi
}

# Run the affected pytest command line "$@" for `step`. A failure is a failure.
# A run that passed no test (all skipped, or exit 5 for nothing collected) does
# not block the commit: a machine without a backend's toolchain skips that
# backend's tests, and blocking would only teach --no-verify. It ends with an
# `UNVERIFIED <counts>` line instead, which `step` reports as SKIPPED and which
# turns the final line into "ok, but ... verified nothing".
pytest_counted() {
    if _out=$("$@" 2>&1); then _rc=0; else _rc=$?; fi
    printf '%s\n' "$_out"
    if [ "$_rc" -ne 0 ] && [ "$_rc" -ne 5 ]; then
        return "$_rc"
    fi
    _n=$(pytest_count passed "$_out")
    if [ "${_n:-0}" -eq 0 ]; then
        _s=$(pytest_count skipped "$_out")
        echo "UNVERIFIED 0 passed, ${_s:-0} skipped"
    fi
}

# Run "$@" with a wall-clock ceiling, capturing combined output on stdout. Exit
# 124 (the GNU timeout convention) means the ceiling was hit; the whole process
# group is killed first, so a wedged pytest and the children it started cannot
# outlive it. A portable ceiling: macOS has no `timeout`, and the interpreter is
# already resolved.
run_within_budget() {
    _budget=$1
    shift
    "$PY" -c '
import os, signal, subprocess, sys
p = subprocess.Popen(sys.argv[2:], stdout=subprocess.PIPE,
                     stderr=subprocess.STDOUT, start_new_session=True)
try:
    out, _ = p.communicate(timeout=float(sys.argv[1]))
except subprocess.TimeoutExpired:
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except OSError:
        p.kill()
    p.communicate()
    sys.exit(124)
sys.stdout.buffer.write(out)
sys.exit(p.returncode)
' "$_budget" "$@"
}

echo "pre-commit:"

# The frontend suite, which includes tests/test_conformance_validate.py: every
# tier's emitted code is handed to that tier's real compiler. That is the check
# that catches "the emitter did not raise, but its output does not compile".
#
# Run only the tests AFFECTED by the staged change (tools/affected_tests.py),
# not the whole minutes-long `tests/` suite: a docs-only commit selects nothing
# and returns in seconds, a leaf change runs its own tests. The suite grew far
# past this hook's ~20s promise, and a blanket `pytest tests/` on a worktree
# commit is what made agents wait (and made this hook feel like something to
# turn off with --no-verify). This is NOT a bypass: the affected selector is a
# conservative superset that answers FULL for any core, unmapped, or structural
# change; the hook then runs the core subset below and refuses the commit when
# that runs no test, and `make pre-merge` still runs everything at land/CI.
#
# If the selector is unavailable or says FULL, run the core subset below; and a
# --timeout backstop (when pytest-timeout is present) means a single wedged
# cross-tier test can never hang the commit.
TIMEOUT_ARGS=""
if "$PY" -P -m pytest --help 2>/dev/null | grep -q -- '--timeout'; then
    TIMEOUT_ARGS="--timeout=60 --timeout-method=thread"
fi

# A FULL selection does not run the root suite here. That suite takes hours
# on a loaded machine (253 test-minutes, issue #2217; its size is the
# generated suite-size paragraph in CONTRIBUTING.md), so no local ceiling fits it, and an unbounded run is the machine-starvation path issue #2059
# measured (one commit pinned five cores above 90% and drove load to 59 while
# other jobs worked). Running it under a ceiling and calling the timeout a
# skip was worse: the hook then printed "ok" for every checker change after
# running no test at all (issue #2208).
#
# So a FULL selection runs a DEFINED core subset, CORE_TESTS, under the
# wall-clock ceiling FULL_BUDGET. test_frontend and test_doc_examples drive the
# whole frontend pipeline (parse, check, lower, emit); the goldens and the four
# diagnostics files add the checker's negative cases. Together they are about
# 600 tests in about 8s on a loaded machine. The test_formal_*
# rows are left out: they took 4.5 minutes here and need lake, so they could
# never finish inside the ceiling. The step reports the core count and says the
# full suite did not run. If the core subset fails, runs no test, or exceeds
# the ceiling, the commit is refused with the selector's reason, and
# `git commit --no-verify` (with that reason in the message) is the explicit
# way past it. `make pre-merge` still runs everything before land.
# Override with REVL_HOOK_FULL_BUDGET=<seconds> and REVL_HOOK_CORE_TESTS="<paths>".
FULL_BUDGET=${REVL_HOOK_FULL_BUDGET:-60}
CORE_TESTS=${REVL_HOOK_CORE_TESTS:-"tests/test_frontend.py tests/test_doc_examples.py \
tests/test_goldens.py tests/test_multi_error_reporting.py \
tests/test_assert_diagnostics.py tests/test_parser_ergonomics.py \
tests/test_lower_ergonomics.py"}
# A commit that stages nothing (`--allow-empty`, a message-only `--amend`)
# changes no file, so no test can be affected by it. The selector cannot tell
# that case apart: it sees an empty change set, which it must treat as "could
# not read the diff" and answer with the FULL suite, and the FULL suite under
# the per-test timeout above takes over an hour on a loaded machine and
# cannot pass (issue #1449). git can tell it apart, positively: `diff --cached
# --quiet` exits 0 only when the index matches HEAD. Any error is non-zero and
# falls through to the selector and its fail-safe.
NOTHING_STAGED=""
SEL=""
if git diff --cached --quiet 2>/dev/null; then
    NOTHING_STAGED=1
else
    SEL=$("$PY" tools/affected_tests.py --root "$root" --base HEAD --format machine 2>/dev/null)
    # The first staged paths, to name the change a refusal is about.
    STAGED=$(git diff --cached --name-only 2>/dev/null | head -5 | tr '\n' ' ')
fi

# git exported the committing repository into this hook (GIT_DIR and
# GIT_INDEX_FILE in a linked worktree, GIT_INDEX_FILE and GIT_CONFIG_PARAMETERS
# elsewhere). The two git reads above needed them: for `commit -a` and
# `commit <paths>` what is being committed lives in a temporary index only
# GIT_INDEX_FILE names. Nothing below does, and every test fixture that shells out to git would inherit them
# and act on THIS repository instead of its tmp dir: `git init` there set
# core.bare=true in the shared .git/config, `git config user.name t` set the
# shared identity, and `git add` rewrote a worktree's index. Clear git's own list of
# repository-local variables (the set it clears itself before running a command
# in another repository), and the author identity and date git also exports,
# which would otherwise outrank every fixture's own `git config user.name`.
# tests/conftest.py strips the same sets for any pytest run; this covers the
# steps it does not reach.
unset $(git rev-parse --local-env-vars)
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE \
    GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE

# Issue #2216: the hook is a fast lane. A test that is slow by NATURE carries
# `@pytest.mark.slow` and tests/conftest.py deselects it here; plain
# `make pre-merge` and the merge-queue matrix run the slow lane, so it still
# runs before land. This is not a skip: the lane is marked and named.
export REVL_SKIP_SLOW=1

if [ -n "$NOTHING_STAGED" ]; then
    echo "  frontend                           nothing staged (the commit changes no file)"
else
    SEL_FULL=$(printf '%s\n' "$SEL" | sed -n 's/^FULL //p')
    if [ -z "$SEL_FULL" ] || [ "$SEL_FULL" = "1" ]; then
        # The core subset, bounded: see CORE_TESTS and FULL_BUDGET above. A
        # FULL selection is the answer for every core or unmapped path, and a
        # selector that answered nothing at all (it crashed, a parse error)
        # gets the same treatment (issues #2059, #2208).
        SEL_REASON=$(printf '%s\n' "$SEL" | sed -n 's/^REASON //p')
        if [ -z "$SEL_FULL" ]; then
            SEL_LINE="unavailable (${SEL_REASON:-the selector printed nothing})"
        else
            SEL_LINE="FULL ${SEL_REASON:-<no reason given>}"
        fi
        # The label is longer than the 36-column field, so each verdict below
        # carries its own leading space to keep the line readable.
        printf '  %s' "frontend (FULL selection: core subset)"
        if out=$(run_within_budget "$FULL_BUDGET" "$PY" -P -m pytest $CORE_TESTS $TIMEOUT_ARGS -q); then
            rc=0
        else
            rc=$?
        fi
        why=""
        if [ "$rc" -eq 124 ]; then
            echo " FAILED (the core subset exceeded the ${FULL_BUDGET}s budget)"
            fail=1
        elif why=$(pytest_ran_tests "$rc" "$out"); then
            passed=$(pytest_count passed "$out")
            echo " ok (core subset only: ${passed} passed; the full suite did not run)"
        else
            echo " FAILED"
            echo "$out" | tail -25 | sed 's/^/      /'
            [ -z "$why" ] || echo "      $why"
            fail=1
        fi
        echo "      selector: ${SEL_LINE}"
        echo "      staged: ${STAGED:-<unknown>}"
        echo "      core subset: ${CORE_TESTS}"
        if [ "$fail" -ne 0 ]; then
            echo "      the full suite takes hours here, so no test covers this"
            echo "      change locally. Fix the core subset, or commit with"
            echo "      git commit --no-verify  and put the selector line above in the"
            echo "      commit message (\`make pre-merge\` runs everything before land)."
        else
            echo "      \`make pre-merge\` runs the full suite before land."
        fi
    else
        SEL_PYTEST=$(printf '%s\n' "$SEL" | sed -n 's/^PYTEST //p')
        if [ -n "$SEL_PYTEST" ]; then
            n=$(printf '%s' "$SEL_PYTEST" | wc -w | tr -d ' ')
            step "frontend (affected: $n node(s))" pytest_counted "$PY" -P -m pytest $SEL_PYTEST $TIMEOUT_ARGS -q
        else
            echo "  frontend                           no affected tests (docs/config-only change)"
        fi
    fi
fi

# The TypeScript backend suite runs tsc over emitted code and shells out to the
# emitters. CI was red for hours on a failure only this suite sees.
# vitest must resolve node_modules from the directory it runs in, so unlike
# pytest this cannot fall back to the main checkout: running main's suite
# would test main's sources, not the ones being committed. A worktree without
# node_modules therefore skips — with the fix, because the previous version
# of this check failed instead and blocked every worktree commit outright.
if [ -d backends/typescript/node_modules ]; then
    step "typescript backend (vitest)" sh -c \
        'cd backends/typescript && npx vitest run --silent'
else
    echo "  typescript backend                 SKIPPED (no node_modules here)"
    if [ -d "$main_root/backends/typescript/node_modules" ] && [ "$main_root" != "$root" ]; then
        echo "      to check it: ln -s $main_root/backends/typescript/node_modules backends/typescript/node_modules"
    fi
fi

# Emitters are pure Python and the matrix needs no toolchain, so this always
# runs: it catches a backend that stops emitting a construct entirely.
step "conformance matrix (emit)" "$PY" tools/conformance.py

if [ "$fail" -ne 0 ]; then
    echo
    echo "pre-commit failed. Fix the above, or commit with --no-verify."
    exit 1
fi

# Say what could not be checked here rather than implying it passed. The rust
# tier resolves cordis-rs from crates.io; where that is unreachable the cargo
# tests skip, and only CI covers them.
if ! "$PY" - <<'PY' 2>/dev/null
import socket, sys
try:
    socket.create_connection(("static.crates.io", 443), timeout=3).close()
except OSError:
    sys.exit(1)
PY
then
    echo "  note: crates.io unreachable — rust cargo checks are CI-only here."
fi

if [ "$unverified" -ne 0 ]; then
    echo "pre-commit: ok, but the affected tests verified nothing (see SKIPPED above)"
else
    echo "pre-commit: ok"
fi
