    "code": "",
    "kind": "no_objection",
    "message": ""
   },
   "reference": {
    "message": "component `A` acquires through async operation `p.open` but the effect is not awaited; the binding would hold the in-flight value, not the result (A1)",
    "tag": "A1"
   }
  },
  "examples/rejections/a1_async_emit_step_not_awaited.rvl": {
   "bucket": "false-admit/A1",
   "gate": {
    "code": "",
    "kind": "no_objection",
    "message": ""
   },
   "reference": {
    "message": "`emit` step reaches async operation `model.complete` but the emission is not awaited; py would build a coroutine it never awaits (the emission never fires) and ts a floating unordered Promise (A1)",
    "tag": "A1"
   }
  },
