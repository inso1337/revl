// Planner (PURE) — the resolver brain. Resolution order, hash-drift
// detection, candidate marshalling, and every add/assemble/refuse decision
// are pure functions over JSON values: no externs are reachable from here, so
// `revl test` covers the whole brain with no mocks and no emissions. This is
// the component to be proudest of — run `revl audit` on truc and Planner
// carries zero authority while the four rim components carry it all.
//
// Structured values cross the service boundary as Str JSON (docs/design/
// truc-architecture.md §10.2, Str-JSON v1). Inside these pure fns the JSON is
// parsed into declared record types and manipulated with full control flow.

use "../externs.rvl" { json_parse, json_stringify, sha256_hex, host_wiring }

// ---- shapes crossing in ----

// `grant` is the `requires` keys the row's `[trucs]` entry allows, the same
// vocabulary `apply`'s grant uses. A missing entry or a missing key parses as
// [] — fail-closed: a vendored row's reach is bounded to what the operator
// granted it, and an entry that grants nothing admits nothing that requires a
// service (issue #2635).
type Truc      = { name: Str, registry: Str, grant: List[Str] }
type Manifest  = { name: Str, registry: Str, entry: List[Str], trucs: List[Truc] }
// `skip_missing` lets `add` gather the rows that are actually vendored: an
// operator declares the `[trucs]` entry (with its grant) before the first add,
// so at add time a declared sibling may have no vendored file yet. Every other
// verb reads every declared row and refuses a missing one by name.
type Spec      = { entry: List[Str], trucs: List[Str], skip_missing: Bool }
type EntryFile = { path: Str, source: Str }
type Vendored  = { name: Str, path: Str, source: Str }
type Gathered  = { entry: List[EntryFile], vendored: List[Vendored] }
// `grant` rides the ordered row so the admission gate bounds THIS row: the
// rows of one assembly carry different grants, so one shared allowlist would
// let one row borrow another's reach.
type Ordered   = { path: Str, source: Str, name: Str, grant: List[Str] }
type LockRow   = { name: Str, sourceHash: Str }
type LockFile  = { trucs: List[LockRow] }
// `dossier` is absent (None) when the entry does not ship one. The commit plan
// carries its hash either way, so an absent dossier is asserted as absent.
type Entry     = { name: Str, source: Str, manifest: Str, dossier: Opt[Str] }
type IndexRow  = { name: Str, sourceHash: Str }
// `manifest` is the gate's composition manifest, carried on a successful
// verdict. It is modelled here (item 380) so it can be read as a typed record
// field — `v.manifest` — rather than reached out of a re-parsed `Any` (a field
// read off `Any` is now refused by the frontend; the manifest is a nested JSON
// value, hence `Any`).
// `trusted` names the vendored rows whose host code was admitted with the
// untrusted-author profile lifted (--trust-host-code, or a lock record of it).
type Verdict   = { ok: Bool, diagnostic: Str, manifest: Any, trusted: List[Str] }
type Drift     = { ok: Bool, message: Str }

// The wiring of the gate's own composition manifest (admit_all's `manifest`),
// reshaped by the pure host `wiring` shim into keys revl can name (`provides`/
// `requires` are reserved words, so the raw manifest fields cannot be parsed
// into a record directly). `needs` is one row per injected service key with
// the component that needs it; `provided` is every service key still supplied.
// `rm` reads *this* — the gate stays the single source of truth about the
// wiring; the Planner only inspects it for an unmet requirement, and decides.
type Need    = { name: Str, key: Str }
type Wiring  = { provided: List[Str], needs: List[Need] }

// ---- shapes crossing out ----

type Report   = { code: Int, message: Str, sources: Str, commit: Str }
// `admission` is how the gate admitted the row: "profiled", or
// "trusted-host-code" when only --trust-host-code admitted its host code.
// `grant` is the reach bound the row was admitted under: the `requires` keys
// its `[trucs]` entry declared, recorded in truc.lock so the bound `add`
// applied is reviewable and `assemble` re-applies the same one (issue #2635).
// The three hashes are the hashes of the entry text `truc add` read and checked,
// the bytes `commit_add` must find when it vendors them. `component.rvl` is
// also the text the gate admits; `manifest.json`/`dossier.json` are pinned but
// never enter the gate. A file the entry does not ship is carried as "" and
// asserted absent.
type LockAdd  = { name: Str, registry: Str, admission: Str, grant: List[Str],
                  sourceHash: Str, manifestHash: Str, dossierHash: Str }
type Commit   = { lockAdd: LockAdd }
type RmCommit = { name: Str }

// ---- resolution ----

// The registry path the composition resolves against (v1: one local registry).
fn plan_registry_of(mj: Str) -> Str {
  let m: Manifest = json_parse(mj)
  return m.registry
}

// What `read_sources` must gather: the project's own entry files plus every
// vendored truc, in truc.toml order. S1 needs no dependency reordering — the
// gate performs the real compatibility check over the whole set.
fn plan_assemble_spec(mj: Str) -> Str {
  let m: Manifest = json_parse(mj)
  var names: List[Str] = []
  for (t of m.trucs) {
    names = names.push(t.name)
  }
  let fixed = names
  let s: Spec = { entry: m.entry, trucs: fixed, skip_missing: false }
  return json_stringify(s)
}

// What `read_sources` must gather for an `add`: every vendored truc EXCEPT the
// candidate. The candidate is admitted from the fetched entry appended by
// `ordered_with_candidate`, and its `[trucs]` entry may already be declared
// (that is where its grant lives) while nothing is vendored under `trucs/`
// yet — so including it here would ask for a file the add has not written.
// Siblings declared ahead of their own add are skipped for the same reason
// (`skip_missing`): without that, declaring two grants before adding either
// would make each add refuse the other and no order would work.
fn plan_add_spec(mj: Str, name: Str) -> Str {
  let m: Manifest = json_parse(mj)
  var names: List[Str] = []
  for (t of m.trucs) {
    if (t.name != name) {
      names = names.push(t.name)
    }
  }
  let fixed = names
  let s: Spec = { entry: m.entry, trucs: fixed, skip_missing: true }
  return json_stringify(s)
}

// Same gathering spec as `assemble`, but with one truc excluded — the set the
// *remainder* must still admit after a `rm`. `rm` proves the assembly stays
// whole by admitting exactly this (§8.1: the inverse minus the gate, then run
// the admit chain once over what is left).
fn plan_rm_spec(mj: Str, name: Str) -> Str {
  let m: Manifest = json_parse(mj)
  var names: List[Str] = []
  for (t of m.trucs) {
    if (t.name != name) {
      names = names.push(t.name)
    }
  }
  let fixed = names
  let s: Spec = { entry: m.entry, trucs: fixed, skip_missing: false }
  return json_stringify(s)
}

// Is `name` actually a vendored truc in this assembly? A `rm` of something that
// was never added is a refusal (nothing to remove), before any disk touch.
fn manifest_has(mj: Str, name: Str) -> Bool {
  let m: Manifest = json_parse(mj)
  for (t of m.trucs) {
    if (t.name == name) {
      return true
    }
  }
  return false
}

// The `requires` keys a `[trucs]` entry grants one row. A truc the table does
// not name, or names without a `grant`, grants nothing: the bound is
// fail-closed, so a requiring row that arrives without a declaration is
// refused rather than admitted unbounded (issue #2635).
fn grant_of(m: Manifest, name: Str) -> List[Str] {
  for (t of m.trucs) {
    if (t.name == name) {
      return t.grant
    }
  }
  return []
}

// The ordered [{path, source, name, grant}] the gate admits incrementally: the
// project's own entry files first (they set the running composition), then
// every vendored truc in truc.toml order, each carrying its own reach grant. A
// refusal names the first candidate that would not join (G2/G3/G4).
fn plan_ordered_sources(gj: Str, mj: Str) -> Str {
  let g: Gathered = json_parse(gj)
  let m: Manifest = json_parse(mj)
  var out: List[Ordered] = []
  for (e of g.entry) {
    out = out.push({ path: e.path, source: e.source, name: "", grant: [] })
  }
  for (v of g.vendored) {
    out = out.push({ path: v.path, source: v.source, name: v.name,
                     grant: grant_of(m, v.name) })
  }
  let fixed = out
  return json_stringify(fixed)
}

// Same, plus the fetched candidate appended last (a virtual path — it is not
// on disk yet): `add` admits the candidate against the current assembly
// *before* anything is vendored (§8.1). The candidate's grant comes from the
// `[trucs]` entry the operator declared for it; without one it grants nothing.
fn plan_ordered_with_candidate(gj: Str, mj: Str, name: Str, entryJson: Str) -> Str {
  let g: Gathered = json_parse(gj)
  let m: Manifest = json_parse(mj)
  let e: Entry = json_parse(entryJson)
  var out: List[Ordered] = []
  for (ef of g.entry) {
    out = out.push({ path: ef.path, source: ef.source, name: "", grant: [] })
  }
  for (v of g.vendored) {
    out = out.push({ path: v.path, source: v.source, name: v.name,
                     grant: grant_of(m, v.name) })
  }
  let candPath = "/__truc_candidate__/".concat(name).concat("/component.rvl")
  out = out.push({ path: candPath, source: e.source, name: name,
                   grant: grant_of(m, name) })
  let fixed = out
  return json_stringify(fixed)
}

// ---- hash-drift (the tamper check, §4.3) ----

fn lock_hash(rows: List[LockRow], name: Str) -> Str {
  for (r of rows) {
    if (r.name == name) {
      return r.sourceHash
    }
  }
  return ""
}

// Does `name` have a truc.lock row at all? `lock_hash` returns "" both for a
// name with no row and for a row whose pin is blank, so the two cases are told
// apart here to make the refusal say which one happened.
fn lock_has(rows: List[LockRow], name: Str) -> Bool {
  for (r of rows) {
    if (r.name == name) {
      return true
    }
  }
  return false
}

// Recompute sha256 of every vendored component.rvl and compare to the pin.
// A PIN IS REQUIRED, not optional: every truc named in truc.toml must carry a
// truc.lock row with a non-empty `sourceHash`, and a missing row or a blank
// hash refuses exactly like a drifting one. Skipping an unpinned truc would
// make the tamper check opt-out — deleting a lock row (or blanking its hash)
// would swap the vendored bytes for anything at all and still assemble, which
// is the one thing this check exists to stop. `truc add` is what mints a pin
// (it re-verifies the fetched bytes against the registry index row before
// anything is vendored, then commits the row); nothing else may skip it.
// Drift is a refusal, not a warning (registry.verify's regenerate-or-red
// discipline, applied to the vendor dir).
fn plan_drift(lockJson: Str, gj: Str) -> Str {
  let g: Gathered = json_parse(gj)
  var rows: List[LockRow] = []
  if (lockJson != "") {
    let lk: LockFile = json_parse(lockJson)
    rows = lk.trucs
  }
  var ok = true
  var message = ""
  for (v of g.vendored) {
    let pinned = lock_has(rows, v.name)
    let expected = lock_hash(rows, v.name)
    if (!pinned) {
      ok = false
      message = message.concat(`unpinned truc: vendored trucs/${v.name}/component.rvl has no truc.lock row — every truc named in truc.toml must carry a pin (run 'truc add ${v.name}' to pin its bytes)
`)
    } else if (expected == "") {
      ok = false
      message = message.concat(`unpinned truc: the truc.lock row for '${v.name}' carries a blank sourceHash — a pin is required, not optional (run 'truc add ${v.name}' to pin its bytes)
`)
    } else {
      let actual = sha256_hex(v.source)
      if (expected != actual) {
        ok = false
        message = message.concat(`hash drift: vendored trucs/${v.name}/component.rvl (${actual}) does not match its truc.lock pin (${expected})
`)
      }
    }
  }
  let final_ok = ok
  let final_msg = message
  let d: Drift = { ok: final_ok, message: final_msg }
  return json_stringify(d)
}

// ---- reports ----

fn report(code: Int, message: Str, sources: Str, commit: Str) -> Str {
  let r: Report = { code: code, message: message, sources: sources, commit: commit }
  return json_stringify(r)
}

// assemble: hash-verify, then admit; refusal is all-or-nothing (the manifest
// slot is "" so the assembly write is a no-op and the disk is untouched).
fn plan_assemble_report(dj: Str, vj: Str, gj: Str) -> Str {
  let d: Drift = json_parse(dj)
  if (!d.ok) {
    return report(1, "truc: refused — ".concat(d.message), "", "")
  }
  let v: Verdict = json_parse(vj)
  if (!v.ok) {
    return report(1, `truc: refused — a petit bout would not join the assembly:
`.concat(v.diagnostic), "", "")
  }
  let g: Gathered = json_parse(gj)
  let n = g.vendored.length()
  let manifestStr = json_stringify(v.manifest)
  let msg = `truc: assembled ${n.to_str()} petit(s) bout(s) — every one admitted through the gate; wrote build/assembly.json`
  return report(0, msg, manifestStr, "")
}

// The plan the commit executes. The three hashes are computed from the SAME
// `entryJson` the planner checked against the index and read for admission (its
// `component.rvl` is the gate's candidate), so `commit_add` can refuse any
// registry read that no longer matches what was checked, including an entry
// and its index row replaced together. `grant` is the reach the gate admitted
// this candidate under, recorded so the lock shows the bound.
fn build_commit(name: Str, admission: Str, grant: List[Str], sourceHash: Str,
                manifestHash: Str, dossierHash: Str) -> Str {
  let c: Commit = { lockAdd: { name: name, registry: "local", admission: admission,
                               grant: grant, sourceHash: sourceHash,
                               manifestHash: manifestHash,
                               dossierHash: dossierHash } }
  return json_stringify(c)
}

// add: unknown-name / hash-mismatch / admission are all refusals *before*
// anything is vendored (commit "" = nothing written).
fn plan_add_report(mj: Str, rowJson: Str, name: Str, entryJson: Str, vj: Str) -> Str {
  if (rowJson == "") {
    return report(1, `truc: refused — unknown component "${name}" (not in the registry index)`, "", "")
  }
  let m: Manifest = json_parse(mj)
  let granted = grant_of(m, name)
  let row: IndexRow = json_parse(rowJson)
  let e: Entry = json_parse(entryJson)
  let actual = sha256_hex(e.source)
  if (actual != row.sourceHash) {
    return report(1, "truc: refused — registry entry disagrees with its own index (source-hash mismatch)", "", "")
  }
  let manifestHash = sha256_hex(e.manifest)
  let dossierHash = match e.dossier {
    None => "",
    Some(text) => sha256_hex(text)
  }
  let v: Verdict = json_parse(vj)
  if (!v.ok) {
    return report(1, `truc: refused — "${name}" would not join the assembly:
`.concat(v.diagnostic), "", "")
  }
  if (list_has(v.trusted, name)) {
    return report(0, `truc: added "${name}" — admitted with its host code trusted by --trust-host-code, reach bounded by its [trucs] grant, vendored into trucs/, pinned in truc.lock (which records the trust)`, "", build_commit(name, "trusted-host-code", granted, actual, manifestHash, dossierHash))
  }
  return report(0, `truc: added "${name}" — admitted as an untrusted author, reach bounded by its [trucs] grant, vendored into trucs/, pinned in truc.lock`, "", build_commit(name, "profiled", granted, actual, manifestHash, dossierHash))
}

// ---- rm: does the remainder still satisfy every requirement? (§8.1) ----

fn list_has(xs: List[Str], x: Str) -> Bool {
  for (e of xs) {
    if (e == x) {
      return true
    }
  }
  return false
}

// Inspect the gate's own manifest of the *remainder*: every requirement (a
// `needs` row) must be met by some service key still `provided` in the
// assembly. An unmet one is a stranded consumer — the honest reason a `rm` is
// refused (the removed truc was the sole provider of a service something still
// needs). This reads the gate's wiring output, not a truc-invented graph: the
// same source of truth, only reshaped past revl's reserved-word fields.
fn plan_unmet(vj: Str) -> Str {
  let v: Verdict = json_parse(vj)
  let mstr = json_stringify(v.manifest)
  let w: Wiring = json_parse(host_wiring(mstr))
  var ok = true
  var message = ""
  for (n of w.needs) {
    if (!list_has(w.provided, n.key)) {
      ok = false
      message = message.concat(`unmet requirement: ${n.name} requires '${n.key}', which no remaining petit bout provides
`)
    }
  }
  let fok = ok
  let fmsg = message
  let d: Drift = { ok: fok, message: fmsg }
  return json_stringify(d)
}

fn build_rm_commit(name: Str) -> Str {
  let c: RmCommit = { name: name }
  return json_stringify(c)
}

// rm: refuse (disk untouched, commit "") when the name is not vendored, when
// the remainder does not even admit (G2/G3 in what is left), or when removing
// the truc strands a consumer (unmet requirement named). Only a clean remainder
// commits the removal.
fn plan_rm_report(mj: Str, name: Str, vj: Str) -> Str {
  if (!manifest_has(mj, name)) {
    return report(1, `truc: refused — "${name}" is not in the assembly (nothing to remove)`, "", "")
  }
  let v: Verdict = json_parse(vj)
  if (!v.ok) {
    return report(1, `truc: refused — the assembly without "${name}" would not admit:
`.concat(v.diagnostic), "", "")
  }
  let uj = plan_unmet(vj)
  let u: Drift = json_parse(uj)
  if (!u.ok) {
    return report(1, `truc: refused — removing "${name}" strands a consumer:
`.concat(u.message), "", "")
  }
  return report(0, `truc: removed "${name}" — un-vendored from trucs/, dropped from truc.toml and truc.lock; the remaining assembly still admits`, "", build_rm_commit(name))
}

// assemble --check: the same resolve → hash-verify → admit chain as assemble,
// reporting valid/invalid with the why-trace on invalid, but with `sources`
// forced to "" so `write_assembly` is a no-op — a dry-run writes NOTHING.
// `vdj` is the host's manifest/dossier half of the drift check (the same list
// `write_assembly` refuses on), reported here because a dry run never reaches
// `write_assembly` to be refused by it.
fn plan_check_report(dj: Str, vdj: Str, vj: Str, gj: Str) -> Str {
  let d: Drift = json_parse(dj)
  if (!d.ok) {
    return report(1, "truc: invalid — ".concat(d.message), "", "")
  }
  let vd: Drift = json_parse(vdj)
  if (!vd.ok) {
    return report(1, "truc: invalid — ".concat(vd.message), "", "")
  }
  let v: Verdict = json_parse(vj)
  if (!v.ok) {
    return report(1, `truc: invalid — a petit bout would not join the assembly:
`.concat(v.diagnostic), "", "")
  }
  let g: Gathered = json_parse(gj)
  let n = g.vendored.length()
  let msg = `truc: valid — ${n.to_str()} petit(s) bout(s) admit through the gate (--check: nothing written)`
  return report(0, msg, "", "")
}

// ---- report accessors (Str-JSON in, typed value out) ----

fn plan_report_code(rj: Str) -> Int {
  let r: Report = json_parse(rj)
  return r.code
}
fn plan_report_msg(rj: Str) -> Str {
  let r: Report = json_parse(rj)
  return r.message
}
fn plan_report_sources(rj: Str) -> Str {
  let r: Report = json_parse(rj)
  return r.sources
}
fn plan_report_commit(rj: Str) -> Str {
  let r: Report = json_parse(rj)
  return r.commit
}

// ---- the pure service ----

pub service Plan {
  fn registry_of(mj: Str) -> Str
  fn assemble_spec(mj: Str) -> Str
  fn add_spec(mj: Str, name: Str) -> Str
  fn rm_spec(mj: Str, name: Str) -> Str
  fn ordered_sources(gj: Str, mj: Str) -> Str
  fn ordered_with_candidate(gj: Str, mj: Str, name: Str, entryJson: Str) -> Str
  fn drift(lockJson: Str, gj: Str) -> Str
  fn assemble_report(dj: Str, vj: Str, gj: Str) -> Str
  fn check_report(dj: Str, vdj: Str, vj: Str, gj: Str) -> Str
  fn rm_report(mj: Str, name: Str, vj: Str) -> Str
  fn add_report(mj: Str, rowJson: Str, name: Str, entryJson: Str, vj: Str) -> Str
  fn report_code(rj: Str) -> Int
  fn report_msg(rj: Str) -> Str
  fn report_sources(rj: Str) -> Str
  fn report_commit(rj: Str) -> Str
}

component Planner provides plan: Plan {
  provide plan {
    fn registry_of(mj) = plan_registry_of(mj)
    fn assemble_spec(mj) = plan_assemble_spec(mj)
    fn add_spec(mj, name) = plan_add_spec(mj, name)
    fn rm_spec(mj, name) = plan_rm_spec(mj, name)
    fn ordered_sources(gj, mj) = plan_ordered_sources(gj, mj)
    fn ordered_with_candidate(gj, mj, name, entryJson) = plan_ordered_with_candidate(gj, mj, name, entryJson)
    fn drift(lockJson, gj) = plan_drift(lockJson, gj)
    fn assemble_report(dj, vj, gj) = plan_assemble_report(dj, vj, gj)
    fn check_report(dj, vdj, vj, gj) = plan_check_report(dj, vdj, vj, gj)
    fn rm_report(mj, name, vj) = plan_rm_report(mj, name, vj)
    fn add_report(mj, rowJson, name, entryJson, vj) = plan_add_report(mj, rowJson, name, entryJson, vj)
    fn report_code(rj) = plan_report_code(rj)
    fn report_msg(rj) = plan_report_msg(rj)
    fn report_sources(rj) = plan_report_sources(rj)
    fn report_commit(rj) = plan_report_commit(rj)
  }
}
