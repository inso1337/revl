// CliDispatch (core) — argv in, exit code out. The command word is parsed to
// an enum in a pure fn, and the match dispatches to exactly one emission arm
// (conditional emission is expressible only this way — a provide method has
// no `if`). All flow logic and help text live here and in the Planner; the
// Python launcher does only what revl cannot: be a console script.

use "assembler.rvl" { Assembler }
use "shipper.rvl" { Shipper }

type Cmd = Add | Rm | Assemble | AssembleCheck | Ship | Unknown

fn nth(argv: List[Str], i: Int) -> Str {
  if (i < argv.length()) {
    return argv[i]
  }
  return ""
}

fn has_flag(argv: List[Str], flag: Str) -> Bool {
  for (a of argv) {
    if (a == flag) {
      return true
    }
  }
  return false
}

// The verb (argv[0]) plus its flags parse to one enum, so the dispatch below
// selects exactly one emission arm (a provide method cannot itself branch).
// `assemble --check` is a distinct verb: the dry-run that writes nothing.
fn parse_cmd(argv: List[Str]) -> Cmd {
  let s = nth(argv, 0)
  if (s == "add") {
    return Add
  }
  if (s == "rm") {
    return Rm
  }
  if (s == "assemble") {
    if (has_flag(argv, "--check")) {
      return AssembleCheck
    }
    return Assemble
  }
  if (s == "ship") {
    return Ship
  }
  return Unknown
}

pub service Cli {
  emission fn run(argv: List[Str]) -> Int
}

component CliDispatch requires asm: Assembler, ship: Shipper provides cli: Cli {
  provide cli {
    fn run(argv) = match parse_cmd(argv) {
      Add           => emit asm.add(nth(argv, 1)),
      Rm            => emit asm.rm(nth(argv, 1)),
      Assemble      => emit asm.assemble(),
      AssembleCheck => emit asm.assemble_check(),
      Ship          => emit ship.run(".", nth(argv, 1)),
      Unknown       => emit asm.unknown(nth(argv, 0)),
    }
  }
}
