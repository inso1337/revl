// ◐ THIS PAGE — the playground you are using IS this composition.
//
// It boots itself when the page loads: every region below owns its part of
// the page through an `effect ui_mount…(…) undo ui_unmount…(…)` pair, so the
// page exists because activations mounted it — and unbuilds, backwards, when
// they unwind. The graph below the editor is this file, live.
//
// Evolve the page while you stand on it:
//   · hover a node, press ✕ — withdraw one component. Withdraw TabRouter and
//     every view's tab reactively leaves the page (R2/R3); press ▶ to load it
//     back and watch the pane rebuild
//   · withdraw EditorPane — this editor disappears (the ◐ dock, bottom-right,
//     is the way back)
//   · ship v2 of the style: in StyleV1 below, change BOTH v1s to v2 (the
//     component name and the theme it mounts) and press ⇄ Swap — the graph
//     shows StyleV2 replace StyleV1, and the page reskins itself under you
//   · rename a tab label, delete a view — press ⇄ Swap: your edit is
//     re-admitted against the RUNNING page and hot-swapped in
//   · press ■ Unload — the page tears itself down, LIFO, and the residue
//     checks prove nothing was left behind
//
// The DOM is host territory: the externs at the bottom are the page's whole
// boundary — open the G8 audit tab and this UI will enumerate itself.

service Tabs {
  fn active() -> Str
  emission fn select(id: Str)
}

service Editor {
  emission fn source() -> Str
}

service Skin {
  fn name() -> Str
}

// ---------- the page's regions

component EditorPane requires skin: Skin provides ed: Editor {
  let slot = effect ui_mount_region("editor") undo ui_unmount_region("editor")
  provide ed {
    fn source() = emit ui_editor_source()
  }
}

component Toolbar requires ed: Editor {
  let slot = effect ui_mount_region("toolbar") undo ui_unmount_region("toolbar")
}

component StatusBar requires skin: Skin {
  let slot = effect ui_mount_region("status") undo ui_unmount_region("status")
}

component SystemPanel requires skin: Skin {
  let slot = effect ui_mount_region("system") undo ui_unmount_region("system")
}

// The page's look, as a versioned PROVIDER the regions depend on. v1 is the
// teal build; change both v1s to v2 and ⇄ Swap to ship the violet build —
// the graph shows StyleV2 replace StyleV1 at the next generation. The skin
// is load-bearing: withdraw it (✕) and every region that requires it comes
// down with it, reactively (R2/R3) — the ◐ dock brings them all back. Call
// skin.name() below to ask the running page which build it is wearing.
//
// One at a time: the page's data-ui attribute is a single exclusive host
// slot behind ui_theme, so a composition that mounts two Style components
// fails loudly at activation — G2 guards provision KEYS, and a shared host
// resource behind an extern is exactly what the G8 audit exists to surface.
component StyleV1 provides skin: Skin {
  let look = effect ui_theme("v1") undo ui_theme_reset()
  provide skin {
    fn name() = "v1"
  }
}

// ---------- the result tabs

component TabRouter provides tabs: Tabs {
  let current = effect Map.new() undo current.drop()

  provide tabs {
    fn active() = current.get("now") ?? "diagnostics"
    fn select(id) {
      effect current.insert("now", id)
      undo   current.remove("now")
      emit ui_select(id)
    }
  }
}

component DiagnosticsView requires tabs: Tabs {
  let slot = effect ui_mount("diagnostics", "Diagnostics")
             undo   ui_unmount("diagnostics")
}

component AuditView requires tabs: Tabs {
  let slot = effect ui_mount("audit", "G8 audit")
             undo   ui_unmount("audit")
}

component PlanView requires tabs: Tabs {
  let slot = effect ui_mount("plan", "Plan")
             undo   ui_unmount("plan")
}

component IRView requires tabs: Tabs {
  let slot = effect ui_mount("ir", "IR")
             undo   ui_unmount("ir")
}

// ---------- the host boundary (G8) — the only way this page touches the DOM

extern pure fn ui_unmount(id: Str) -> Int
  = @py { import playground_host; return playground_host.unmount(id) }

extern acquire fn ui_mount(id: Str, label: Str) -> Int undo ui_unmount("")
  = @py { import playground_host; return playground_host.mount(id, label) }

extern pure fn ui_unmount_region(id: Str) -> Int
  = @py { import playground_host; return playground_host.unmount_region(id) }

extern acquire fn ui_mount_region(id: Str) -> Int undo ui_unmount_region("")
  = @py { import playground_host; return playground_host.mount_region(id) }

extern pure fn ui_theme_reset() -> Int
  = @py { import playground_host; return playground_host.theme_reset() }

extern acquire fn ui_theme(name: Str) -> Int undo ui_theme_reset()
  = @py { import playground_host; return playground_host.theme(name) }

extern emission fn ui_select(id: Str)
  = @py { import playground_host; playground_host.select(id) }

extern emission fn ui_editor_source() -> Str
  = @py { import playground_host; return playground_host.editor_source() }
