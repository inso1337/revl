// ◐ META — this composition IS the playground you are looking at.
//
// In meta mode the result pane's tabs are not JavaScript: each *View
// component below owns one tab, mounted by an `effect … undo …` pair — so
// unloading a view removes its tab from the page, LIFO, and the no-residue
// proof is visible in the DOM. Tab clicks route through the `tabs` service:
// every click you make shows up in the trace as an audited host crossing.
//
// You are editing the UI you are using. Try it:
//   · rename a label ("Diagnostics" → "Verdicts"), press ⇄ Swap — live
//   · delete the IRView component, press ⇄ Swap — the IR tab is gone
//   · press ■ Unload — the whole pane unbuilds itself, backwards, and the
//     residue checks pass because every mount carried its unmount
//
// The DOM is host territory, so it is reached only through the externs at
// the bottom — open the G8 audit (while it still has a tab…) and the
// playground will enumerate its own boundary surface.

service Tabs {
  fn active() -> Str
  emission fn select(id: Str)
}

component TabRouter provides tabs: Tabs {
  let current = effect Map.new() undo current.drop()

  provide tabs {
    fn active() = current.get("now") ?? "diagnostics"
    fn select(id) {
      effect current.insert("now", id)
      undo   current.remove("now")
      emit ui_select(id)
    }
  }
}

component DiagnosticsView requires tabs: Tabs {
  let slot = effect ui_mount("diagnostics", "Diagnostics")
             undo   ui_unmount("diagnostics")
}

component AuditView requires tabs: Tabs {
  let slot = effect ui_mount("audit", "G8 audit")
             undo   ui_unmount("audit")
}

component PlanView requires tabs: Tabs {
  let slot = effect ui_mount("plan", "Plan")
             undo   ui_unmount("plan")
}

component IRView requires tabs: Tabs {
  let slot = effect ui_mount("ir", "IR")
             undo   ui_unmount("ir")
}

// ---------- the host boundary (G8) — the only way this UI touches the DOM

extern pure fn ui_unmount(id: Str) -> Int
  = @py { import playground_host; return playground_host.unmount(id) }

extern acquire fn ui_mount(id: Str, label: Str) -> Int undo ui_unmount("")
  = @py { import playground_host; return playground_host.mount(id, label) }

extern emission fn ui_select(id: Str)
  = @py { import playground_host; playground_host.select(id) }
