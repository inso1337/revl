r__asset_expr = "asset" (string | template) ;
r__arrow_body = r_pure_expr ;
r__hole_expr = "hole" [ "[" r_type_ "]" ] [ string ] ;
r__match_expr = "match" r_pure_expr "{" ({ r__match_pattern "=>" (r__match_block_arm | r_pure_expr) "," } | { r__match_pattern "=>" (r__match_block_arm | r_pure_expr) "," } r__match_pattern "=>" (r__match_block_arm | r_pure_expr)) "}" ;
r__if_expr = "if" "(" r_pure_expr ")" r__if_branch_expr "else" r__if_branch_expr ;
r__match_pattern = ident | ident "(" ident ")" ;
r__match_block_arm = "{" { r__skip_semis r_fn_stmt } r__skip_semis "}" ;
r__if_branch_expr = "{" r__skip_semis r_pure_expr r__skip_semis "}" ;
(* IDENT: an identifier that is not a keyword; INT, FLOAT, STRING, template and host_body: the lexer's token classes *)
keyword = "acquire" | "after" | "as" | "assert" | "async" | "await" | "break" | "commutative" | "compensate" | "component" | "config" | "continue" | "effect" | "else" | "emission" | "emit" | "every" | "extern" | "fail" | "false" | "fn" | "for" | "handoff" | "hole" | "idempotent" | "if" | "in" | "intercept" | "isolate" | "let" | "match" | "null" | "of" | "provide" | "provides" | "pub" | "pure" | "realm" | "requires" | "return" | "service" | "spawn" | "subscribe" | "test" | "true" | "try" | "type" | "undo" | "use" | "var" | "verified" | "while" | "with" ;
