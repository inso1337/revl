w_witnessed: "witnessed" | WORD NEVER
WORD: /[A-Za-z_][A-Za-z0-9_]*/
NEVER: /[^\s\S]/
INT: /0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*/
STRING: /"""([^"]|"[^"]|""[^"])*"""|"([^"\\\n]|\\[^\n])*"|'([^'\\\n]|\\[^\n])*'/
float: INT "." FRAC | EXPNUM
FRAC: /[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?/
EXPNUM: /[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*/
