ident ::= ident-root
keyword ::= "acquire" | "after" | "as" | "assert" | "async" | "await" | "break" | "commutative" | "compensate" | "component" | "config" | "continue" | "effect" | "else" | "emission" | "emit" | "every" | "extern" | "fail" | "false" | "fn" | "for" | "handoff" | "hole" | "idempotent" | "if" | "in" | "intercept" | "isolate" | "let" | "match" | "null" | "of" | "provide" | "provides" | "pub" | "pure" | "realm" | "requires" | "return" | "service" | "spawn" | "subscribe" | "test" | "true" | "type" | "undo" | "use" | "var" | "verified" | "while" | "with"
int ::= ("0" [xX] [0-9a-fA-F_]+ | "0" [bB] [01_]+ | "0" [oO] [0-7_]+ | [0-9] [0-9_]*)
float ::= ([0-9] [0-9_]* "." [0-9] [0-9_]* ([eE] [+-]? [0-9] [0-9_]*)? | [0-9] [0-9_]* [eE] [+-]? [0-9] [0-9_]*)
string ::= ("\"\"\"" ([^"] | "\"" [^"] | "\"\"" [^"])* "\"\"\"" | "\"" ([^"\\\n] | "\\" [^\n])* "\"" | "'" ([^'\\\n] | "\\" [^\n])* "'")
template ::= "`" ([^`$] | "$" [^{`] | "${" (r-pure-expr-nw | r-pure-expr-nn) ws "}")* "$"? "`"
host-body ::= "@" ("go" | "java" | "rust") [ \t\r\n]* "{" host-inner-0 "}" | "@" ("js" | "node" | "ts" | "typescript") [ \t\r\n]* "{" host-inner-1 "}" | "@" ("py" | "python") [ \t\r\n]* "{" host-inner-2 "}" | "@" ("wasm") [ \t\r\n]* "{" host-inner-3 "}" | "@" ident [ \t\r\n]* "{" host-inner-4 "}"
host-inner-0 ::= ([^{}"'`] | "\"" [^"]* "\"" | "\"" | "'" [^']* "'" | "'" | "`" [^`]* "`" | "`" | "{" host-inner-0 "}")*
host-inner-1 ::= ([^{}"'`] | "\"" [^"]* "\"" | "\"" | "'" [^']* "'" | "'" | "`" [^`]* "`" | "`" | "{" host-inner-1 "}")*
host-inner-2 ::= ([^{}"'] | "\"" [^"]* "\"" | "\"" | "'" [^']* "'" | "'" | "{" host-inner-2 "}")*
host-inner-3 ::= ([^{}"] | "\"" [^"]* "\"" | "\"" | "{" host-inner-3 "}")*
host-inner-4 ::= ([^{}"'`] | "\"" [^"]* "\"" | "\"" | "'" [^']* "'" | "'" | "`" [^`]* "`" | "`" | "{" host-inner-4 "}")*
any-word ::= ident | keyword | int | float
any-other ::= string | template | "!" | "!=" | "!==" | "%" | "&" | "&&" | "(" | ")" | "*" | "+" | "," | "-" | "->" | "." | "/" | ":" | ";" | "<" | "<<" | "<=" | "=" | "==" | "===" | "=>" | ">" | ">=" | ">>" | "?" | "?." | "??" | "@" | "[" | "]" | "^" | "{" | "|" | "||" | "}" | "~"
ws ::= ([ \t\r\n] | "//" [^\n]*)*
ws1 ::= ([ \t\r\n] | "//" [^\n]*)+
wsnl ::= ([ \t\r] | "//" [^\n]*)* "\n" ws
