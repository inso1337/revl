any-other ::= string | template | "!" | "!=" | "!==" | "%" | "&" | "&&" | "(" | ")" | "*" | "+" | "," | "-" | "->" | "." | "/" | ":" | ";" | "<" | "<<" | "<=" | "=" | "==" | "===" | "=>" | ">" | ">=" | ">>" | "?" | "?." | "??" | "@" | "[" | "]" | "^" | "{" | "|" | "||" | "}" | "~"
ws ::= ([ \t\r\n] | "//" [^\n]*)*
ws1 ::= ([ \t\r\n] | "//" [^\n]*)+
