host-inner-0 ::= ([^{}"'`] | "\"" [^"]* "\"" | "\"" | "'" [^']* "'" | "'" | "`" [^`]* "`" | "`" | "{" host-inner-0 "}")*
host-inner-1 ::= ([^{}"'`] | "\"" [^"]* "\"" | "\"" | "'" [^']* "'" | "'" | "`" [^`]* "`" | "`" | "{" host-inner-1 "}")*
