{
  "protocolVersion": "1.0.0",
  "name": "Billing Agent",
  "description": "Answers questions about invoices and payments.",
  "url": "https://billing.internal:8443/a2a",
  "preferredTransport": "JSONRPC",
  "version": "2.4.1",
  "provider": {"organization": "Acme", "url": "https://acme.example"},
  "capabilities": {"streaming": true, "pushNotifications": true, "stateTransitionHistory": false},
  "defaultInputModes": ["text/plain"],
  "defaultOutputModes": ["text/plain"],
  "securitySchemes": {"bearer": {"type": "http", "scheme": "bearer"}},
  "security": [{"bearer": []}],
  "additionalInterfaces": [
    {"url": "https://billing.internal:8443/a2a", "transport": "JSONRPC"},
    {"url": "https://billing.internal:9443", "transport": "GRPC"}
  ],
  "skills": [
    {
      "id": "invoice-lookup",
      "name": "Invoice lookup",
      "description": "Find an invoice by number.",
      "tags": ["billing", "read"],
      "inputModes": ["text/plain"],
      "outputModes": ["text/plain"]
    },
    {
      "id": "issueRefund",
      "name": "Issue refund",
      "description": "Refunds a payment. Irreversible.",
      "tags": ["billing", "write"]
    }
  ]
}
