use "stdlib/wire.rvl" { Wire, Knock }

service Beat {
  emission[wire.take, wire.say, wire.close] fn beat() -> Int
}

component Game requires wire: Wire provides b: Beat {
  provide b {
    fn beat() -> Int {
      let knocks = emit wire.take(512)
      let ok = emit wire.say(1, "hi")
      return 0
    }
  }
}
