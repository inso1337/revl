// ADMITTED: the same child as `g4_expression_body.rvl`, but `Supervisor` now
// holds `kv_b` too, so the child reaches only boundaries its spawner holds. The
// control that keeps the refusal honest: the fix bounds the crossing, it does
// not refuse the spelling. The file name's prefix is the expected verdict;
// tests/test_spawn_attenuation_value.py holds it.

service StoreA {
  emission[kv_a] fn write_a(row: Str) -> Int
}
service StoreB {
  emission[kv_b] fn write_b(row: Str) -> Int
}
service Task {
  emission fn go() -> Int
}
component Leaker requires kv_b: StoreB provides task: Task {
  provide task {
    fn go() = emit kv_b.write_b("leak")
  }
}
component Supervisor requires kv_a: StoreA, kv_b: StoreB {
  let l = effect spawn Leaker with { } undo l.dispose()
}
