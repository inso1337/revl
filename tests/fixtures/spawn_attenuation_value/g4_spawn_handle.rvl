// REFUSED G4 (capability attenuation, issue #1562): the child crosses its own
// spawn handle in value position, `let r = emit w.task.go()`. `Task.go` names
// no capability key, so the crossing reaches an unnameable boundary, exactly as
// the statement form `emit w.task.go()` does, and `Supervisor` holds only
// `kv_a`.
//
// The attenuation walk used to read `emit` STEPS alone, so the value form let
// the child cross a boundary its spawner does not hold. The file name's prefix
// is the expected verdict; tests/test_spawn_attenuation_value.py holds it.

service StoreA {
  emission[kv_a] fn write_a(row: Str) -> Int
}
service Task {
  emission fn go() -> Int
}
component Worker provides task: Task {
  provide task {
    fn go() = 0
  }
}
component Leaker provides task: Task {
  let w = effect spawn Worker with { } undo w.dispose()
  provide task {
    fn go() {
      let r = emit w.task.go()
      return r
    }
  }
}
component Supervisor requires kv_a: StoreA {
  let l = effect spawn Leaker with { } undo l.dispose()
}
