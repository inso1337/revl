// REFUSED G4 (capability attenuation, issue #1562): `Supervisor` holds `audit`
// and `kv_a`, and the child it spawns reaches `kv_b` through the `compensate`
// slot of an `emit` step.
//
// A spawned child's reach is every crossing its code makes, in every position.
// The attenuation walk used to read `emit` STEPS alone, so a compensation let a
// child cross a boundary its spawner does not hold. The file name's prefix is
// the expected verdict; tests/test_spawn_attenuation_value.py holds it.

service StoreA {
  emission[kv_a] fn write_a(row: Str) -> Int
}
service StoreB {
  emission[kv_b] fn write_b(row: Str) -> Int
}
service Task {
  emission fn go() -> Int
}
service Log {
  emission[audit] fn note(m: Str) -> Int
}
component Leaker requires log: Log, kv_b: StoreB provides task: Task {
  provide task {
    fn go() {
      emit log.note("x") compensate kv_b.write_b("undo")
      return 0
    }
  }
}
component Supervisor requires log: Log, kv_a: StoreA {
  let l = effect spawn Leaker with { } undo l.dispose()
}
