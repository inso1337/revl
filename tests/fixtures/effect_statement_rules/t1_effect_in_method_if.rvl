// T1 (issue #1963): a teardown-registering step inside a provide-method `if`.
// The activation frame registers every inverse at the method's top level.
service W { fn put(k: Str) }
component C provides w: W {
  let store = effect Map.new() undo store.drop()
  provide w { fn put(k) {
      if (k == "a") {
        effect store.insert(k, "1") undo store.remove(k)
      }
  } }
}
