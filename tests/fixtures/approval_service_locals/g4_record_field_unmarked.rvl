// REFUSED G4 (marker rule, issue #1509): `r.p.charge(n)` with no `emit`,
// through the record field that holds the provision. This was admitted unmarked
// AND unapproved: an emission crossed the boundary with neither the marker nor
// the approval floor seeing it. The file name's prefix is the expected verdict
// (`g4_` refused, `ok_` admitted); tests/test_approval_service_locals.py holds
// it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      let r = { p: w.pay }
      let x = r.p.charge(n)
      return x
    }
  }
}
