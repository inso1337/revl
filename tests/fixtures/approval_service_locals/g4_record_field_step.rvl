// REFUSED G4 (approval floor, issue #1509): a record field holds the provision,
// `let r = { p: w.pay }`, and `emit r.p.charge(n)` crosses `production.payment`
// with no `with` edge. Before, the marked call was refused as "not declared
// `emission`", because no resolver saw through the field. The file name's
// prefix is the expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_approval_service_locals.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      let r = { p: w.pay }
      emit r.p.charge(n)
      return 0
    }
  }
}
