// REFUSED G4 (marker rule, issue #1509): `t.charge(n)` through the `if`-bound
// provision local, with no `emit`. The marker rule demanded the marker only
// when the receiver was the provision read itself or a plain alias of it, so
// this crossed unmarked as well as unapproved. The file name's prefix is the
// expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_approval_service_locals.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      let t = if (n > 0) { w.pay } else { w.pay }
      let x = t.charge(n)
      return x
    }
  }
}
