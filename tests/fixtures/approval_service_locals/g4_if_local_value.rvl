// REFUSED G4 (approval floor, issue #1509): the same crossing as
// `g4_if_local_step.rvl` in value form, `let x = emit t.charge(n)`. The value
// form has no `with` clause, so an approval-required crossing written this way
// is always refused; the admitted spelling is the step in
// `ok_if_local_step.rvl`. The file name's prefix is the expected verdict (`g4_`
// refused, `ok_` admitted); tests/test_approval_service_locals.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      let t = if (n > 0) { w.pay } else { w.pay }
      let x = emit t.charge(n)
      return x
    }
  }
}
