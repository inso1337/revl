// REFUSED G4 (approval floor): an arrow whose service-typed parameter receives
// the provision, `f(w.pay, n)`, crossing in value form inside its body. Closed
// by PR #1519; pinned with the issue #1509 corpus. The twin is
// `ok_arrow_param_unapplied.rvl`, the same arrow never applied to a provision.
// The file name's prefix is the expected verdict (`g4_` refused, `ok_`
// admitted); tests/test_approval_service_locals.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      let f = (p: Pay, k: Int) => emit p.charge(k)
      let r = f(w.pay, n)
      return r
    }
  }
}
