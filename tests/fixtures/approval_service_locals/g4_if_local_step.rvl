// REFUSED G4 (approval floor, issue #1509): `t` is a local whose value is the
// provision `w.pay`, chosen by an `if`, and `emit t.charge(n)` crosses
// `production.payment`, which an extern declared `requires approval`, with no
// `with` edge.
//
// The marker rule already read `t` as a crossing through its service type; the
// approval floor never resolved a call whose receiver is a local, so this
// crossed with no approval at all. Both rules now read one resolver. The twin
// is `ok_if_local_step.rvl`. The file name's prefix is the expected verdict
// (`g4_` refused, `ok_` admitted); tests/test_approval_service_locals.py holds
// it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      let t = if (n > 0) { w.pay } else { w.pay }
      emit t.charge(n)
      return 0
    }
  }
}
