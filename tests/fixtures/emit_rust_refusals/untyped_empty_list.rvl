// Issue #2911: `let values = []` read by a use that carries no element type
// leaves rustc with `Vec<_>` (E0282). The reference REFUSES this by name; the
// self-host rust port answers it with
// `<<UNSUPPORTED-EMPTY-LIST-TYPE:values>>` and the wasm port with
// `<<UNSUPPORTED-EMPTY-LIST-TYPE>>`.
// It cannot live in tests/fixtures/emit_rust_corpus: there are no reference
// bytes to agree with.
//
// The same rule catches the other shapes #2911 lists (an `==` on two empty
// lists, a `for` iterable, a re-assigned `values = []`, and a read inside an
// `if` block); this document is the smallest one that reaches the refusal.
pub fn length() -> Int {
  let values = []
  let n = values.length()
  return n
}
