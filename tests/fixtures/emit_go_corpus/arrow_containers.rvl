type ArrowRecord = { value: Int }

fn listArrow() -> List[Int] {
  let k = (x) => [x + 1]
  return k(2)
}

fn recordArrow() -> ArrowRecord {
  let k = (x) => { value: x + 1 }
  return k(3)
}

fn nestedArrow() -> List[List[Int]] {
  let k = (x) => [[x + 1]]
  return k(4)
}

fn constantArrow() -> Int {
  let k = (x) => 1
  return k(2)
}

fn reverseArrow() -> Int {
  let k = (x) => 1 + x
  return k(2)
}

fn nestedCallback(g: (List[Int], Int) -> Int, xs: List[Int]) -> Int {
  return g(xs, 1)
}

fn callField() -> Int { return recordArrow().value }
