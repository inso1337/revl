// A provide-method binding of a user variant holds the variant's interface
// type, not the concrete case struct (item 280, the method-body twin): a later
// `match` type-switches on it, and Go rejects a type switch on a concrete
// struct. This is the interface pin in `_emit_method_body`'s let arm.
type Outcome = Found(Int) | Missing

fn tag() -> Str { return "x" }

service Pick { fn pick(n: Int) -> Int }
component P provides pick: Pick {
  provide pick {
    fn pick(n) {
      let o = Missing
      return match o { Missing => 1, Found(v) => v }
    }
  }
}
