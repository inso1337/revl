type strings = { x: Int }
type _revlStrings = { y: Int }

fn reserved(xs: List[Str]) -> Str {
  var out = ""
  let _revlSB0 = "x"
  for (x of xs) { out = out + _revlSB0 }
  return out
}

fn shadowed(xs: List[Str]) -> Str {
  var out = ""
  let strings = "!"
  let _revlStrings = "reserved alias"
  for (x of xs) { out = out + strings }
  return out
}

fn appendSelf(n: Int) -> Str {
  var s = "x"
  var i = 0
  while (i < n) {
    s = s + s
    i = i + 1
  }
  return s
}
