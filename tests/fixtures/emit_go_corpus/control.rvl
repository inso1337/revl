fn loops(n: Int) -> Int {
  var t = 0
  for (i of [1, 2, 3]) { t = t + i }
  while (t < n) { t = t + 1 }
  if (t > n) { return t } else { return n }
}
fn nested(a: Int) -> Int {
  var s = 0
  if (a > 0) {
    let b = a + 1
    s = b
  } else {
    s = 0 - a
  }
  return s
}
fn checks(a: Int, b: Int) -> Int {
  assert a < b
  let z = a
  z
  return z
}

// item 379 / 391 (self-host port): `break`/`continue` in `while` and `for`,
// nested under `if`, with a nested-loop `break` targeting the innermost loop.
fn find_first(xs: List[Int], target: Int) -> Int {
  var idx = 0
  for (x of xs) {
    if (x == target) { break }
    idx += 1
  }
  return idx
}
fn sum_positive(xs: List[Int]) -> Int {
  var total = 0
  for (x of xs) {
    if (x < 0) { break }
    if (x == 0) { continue }
    total += x
  }
  return total
}
fn count_skips(n: Int) -> Int {
  var i = n
  var steps = 0
  while (i > 0) {
    i -= 1
    if (i == 3) { continue }
    steps += 1
  }
  return steps
}
fn first_hit(rows: List[List[Int]], t: Int) -> Int {
  var hits = 0
  for (row of rows) {
    for (v of row) {
      if (v == t) { hits += 1; break }
    }
  }
  return hits
}
