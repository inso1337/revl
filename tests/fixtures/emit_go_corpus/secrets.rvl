// item 421 F6 / item 429(d): the ORIGIN end of a declared `Secret[T]` marking on
// the go tier, and the extern surface that carries it.
//
// `taint.py` strips the `Secret[...]` qualifier before lowering, so an extern's
// `secret_return` stamp is the only surviving record that its result is
// confidential. The verbatim `@go` body owns its own `return` statements, so it
// moves into an inner `revlSecret_<name>` and the declared name becomes a
// one-line `revlSecretResult(..)` wrapper — every call site is covered without
// the body being rewritten. Emitted ONLY for an extern that carries the stamp,
// so `mint_token` differs from `stamp` and `note` in exactly that wrapper.
//
// The RECEIVER end (a provide method whose service declares a `Secret[T]`
// parameter) is NOT here: it lives in the live stc-go component world, which the
// pure typed-core tier this slice mirrors does not emit at all.
//
// Also in-slice here, because the wrapper needs a carrier: a `@go` body spliced
// verbatim (single-line and multi-line, the reference's leading-tab-per-line
// splice), a `Unit` extern (no result in the signature), and an extern the
// module never calls.
extern pure fn mint_token(u: Str) -> Secret[Str]
  = @go { return "token-for-" + u }

extern pure fn stamp(n: Int) -> Str
  = @go {
	if n < 0 {
		return "neg"
	}
	return "n"
}

extern pure fn note(s: Str) -> Unit = @go {
	_ = s
}

fn use_token(u: Str, n: Int) -> Str {
  let t = mint_token(u)
  let s = stamp(n)
  return t + s
}
