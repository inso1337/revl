// A witnessed extern that takes a declared `Secret[Str]` parameter and hands
// back an Ok witness the author did not declare confidential. The frontend
// admits it: the parameter is declared confidential, so the call is not a
// disclosure. The wasm reference REFUSES it by name (issue #1577). In record
// mode this tier writes the Ok witness into the durable WAL verbatim, it has no
// secret registry and no redaction funnel to scrub it, and measured on the live
// runtime the secret's bytes reached the WAL file. Declaring the witness
// `Result[Secret[Str], Str]` emits, framing the placeholder instead.
//
// This is not a byte-agreement case, so it cannot live in the tier's CORPUS.
// The line-coverage gate drives the reference over it here, which is the only
// way
//
//   backends/wasm/emit.py::_refuse_unscrubbed_secret_referent
//
// ever runs. The refusal's text is asserted by
// backends/wasm/test_secret_leaf_sinks_1577.py.
//
// selfhost/emit_wasm.rvl has no counterpart to this refusal: it does not emit
// components.
extern witnessed[t] fn stash(v: Secret[Str]) -> Result[Str, Str]
    undo unstash(result)
    = @wasm { (i32.const 0) }

extern pure fn unstash(v: Str) -> Unit = @wasm { }

extern pure fn token() -> Secret[Str] = @wasm { (i32.const 0) }

component Holder {
  effect stash(token())
}
