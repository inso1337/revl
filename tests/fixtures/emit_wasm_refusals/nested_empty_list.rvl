// Issue #2911: `let xs = [[]]` leaves the inner `vec![]` with no element type
// for rustc to unify with (no sibling item carries one). The wasm reference
// REFUSES it by name too: an empty list literal with no expected `List` type
// has no representation on this tier.
//
// It cannot live in tests/fixtures/emit_wasm_corpus: there are no reference
// bytes to agree with. selfhost/emit_wasm.rvl has no refusal channel, so it
// answers this shape with `<<UNSUPPORTED-EMPTY-LIST-TYPE>>`, and the tier
// oracle pins that text.
pub fn nested() -> Int {
  let xs = [[]]
  return xs.length()
}
