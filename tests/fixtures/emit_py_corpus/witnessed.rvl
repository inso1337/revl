// item 243 (docs/design/243-witnessed-externs.md), added under item 429: the
// `witnessed` extern DECLARATION — the one extern class the py corpus carried
// no instance of at all.
//
// WHAT IT HOLDS BOTH SIDES TO. `_uses_builtin_result` (reference) and
// `uses_builtin_result` (the port) gate the built-in `Ok`/`Err` classes on the
// EXTERN TABLE, not on a surface `match`/`adt`: a witnessed extern's emitted
// call site branches on `Ok` to register the transactional inverse, so the
// classes have to be defined even when nothing in the document names them.
// That clause is the first one both sides test, and until this document existed
// no corpus case reached it — `class=witnessed` was a blind construct and the
// reference's own `return True` under it never executed, so either side could
// have dropped the clause and emitted a module referencing names it never
// defined, with every byte-agreement oracle still green.
//
// The effect sites below additionally exercise transactional registration in
// activation and provide-method bodies, including shared temp numbering across
// multiple sites.
//
// This fixture originally exposed native extern admission/lowering omissions;
// those frontend repairs are maintained separately from the emitter oracle.

type Stash = { path: Str, bak: Str }
type FsError = { code: Str }

// The declared inverse: named, driven by the data witness, and idempotent
// (design rule 5), so a WAL replay of it is a no-op once the file is back.
extern pure fn unstash(w: Stash) -> Unit = @py {
    import os
    if os.path.exists(w['bak']):
        os.replace(w['bak'], w['path'])
    return
}

// The witnessed mutation: rename `path` aside, returning the two paths as its
// data witness. Ok-conditional at the call site — an `Err` touched nothing and
// registers no rollback.
extern witnessed[fs] fn stash(path: Str) -> Result[Stash, FsError] undo idempotent unstash(result) = @py {
    import os
    bak = path + '.bak'
    os.replace(path, bak)
    return Ok({'path': path, 'bak': bak})
}

// A call site for the inverse, so the extern pair is wired into a function the
// way externs.rvl wires its own (the witnessed extern is effect-position only).
fn restore(path: Str, bak: Str) -> Unit {
  return unstash({ path: path, bak: bak })
}

component Stasher {
  effect stash("payload")
  let saved = effect {
    let path = "second"
    stash(path)
  }
}

service Stashing {
  emission fn save(path: Str)
}

component MethodStasher provides stashing: Stashing {
  effect stash("activation")
  provide stashing {
    fn save(path) {
      effect stash(path)
      effect stash(path)
      return
    }
  }
}
