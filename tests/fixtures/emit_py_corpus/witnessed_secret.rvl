// item 421 F6 / item 243: the declared `Secret[T]` on a witnessed INVERSE's
// parameter — the RECEIVING end of the confidentiality `secrets.rvl` spells at
// the producing end.
//
// The compiler strips every `Secret[...]` qualifier and leaves a stamp behind.
// `taint.py` mints `secret_witness` off the inverse's declared parameter and
// `secret_return` only when the extern's OWN return carries a `Secret[...]` in
// its `Ok` arm. The two stamps are separate, and this document is the spelling
// that separates them: the witnessed extern's declared return is ordinary.
//
// WHY THIS DOCUMENT EXISTS. The py tier redacts by VALUE at the recorder,
// where the four WAL tiers substitute a literal positionally off the stamp, so
// this tier has to REGISTER the witness before the frame takes it. Nothing in
// the corpus declared a receiver-position secret, so the two sites that do it —
// the activation-body step and the provide-method step — were emitted by the
// reference and run by no document, and the port emitted neither: added FAILING
// FIRST, the port's output for this program carried no `_revl_mark_secret(...)`
// and no `mark_secret` import at all, so the self-hosted py tier wrote the
// witness verbatim into the WAL. That is a security divergence and not a parity
// nicety, which is why the corpus case and not a ledger entry is the repair.
//
// `revoke` is `pure` and takes the referent as a plain `Str` parameter, so the
// declaration is reachable with no capability of its own; the witnessed extern
// carries the `witnessed[fs]` scope `witnessed.rvl` pins.

extern pure fn revoke(id: Secret[Str]) -> Unit = @py {
    return
}

extern witnessed[fs] fn lease() -> Result[Str, Str]
    undo revoke(result)
    = @py {
        return Ok("lease-1")
    }

service Leasing {
  emission fn touch(p: Str)
}

component Leaser {
  effect lease()
}

component MethodLeaser provides leasing: Leasing {
  provide leasing {
    fn touch(p) {
      effect lease()
    }
  }
}
