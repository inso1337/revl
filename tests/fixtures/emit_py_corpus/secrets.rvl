// item 421 F6 / item 429(d): the two ends of a declared `Secret[T]` marking.
// The ORIGIN end is an extern whose declared return was `Secret[T]`
// (`@_revl_secret_result` above its `def`, and NOT above a plain extern's); the
// RECEIVER end is a provide method whose service declares a parameter
// `Secret[T]` (`_revl_mark_secret(<param>)` at the head of the method, joined
// when several params are declared, and absent from a method that declares
// none). Both ends feed the sorted `from runtime import` line.
//
// The origin extern is `pure`, not the audit's `emission[vault.mint]`, because
// the self-host parser does not accept a scoped capability after `extern` (the
// native admission gate answers `BAD|expected fn after extern`, a separate gap).
// `taint.py` sets `secret_return` off the declared RETURN qualifier alone, so
// the marking under test is exercised either way.
extern pure fn mint_token(u: Str) -> Secret[Str]
  = @py {
      return "token-for-" + u
    }

extern pure fn tag(n: Int) -> Str
= @py {
      return "n" + str(n)
    }

service Vault {
  fn store(token: Secret[Str]) -> Int
  fn pair(a: Secret[Str], n: Int, b: Secret[Str]) -> Int
  fn plain(n: Int) -> Int
  fn touch(token: Secret[Str])
}

component VaultKeeper provides vault: Vault {
  provide vault {
    fn store(token) = 1
    fn pair(a, n, b) = n
    fn plain(n) = n + 1
    fn touch(token) { }
  }
}
