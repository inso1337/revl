// item 243: the receiver-position `Secret[T]` of `witnessed_secret.rvl`, with
// the witnessed extern DECLARED BUT NEVER INVOKED by any component.
//
// WHY THIS DOCUMENT EXISTS. The reference registers the receiver-position
// witness at the emit site (`_witnessed_step` adds `mark_secret` to its import
// set only while writing the registration), so an extern no body reaches pulls
// in no import. The self-hosted port cannot ask that question at its emit site —
// the import line is written before any body is rendered — so it walks the
// bodies instead. A gate keyed on the extern TABLE rather than on an emitted
// step imports `mark_secret` here and the reference does not, which is a byte
// divergence in the other direction. This document is the shape that separates
// the two gates; added FAILING FIRST against the extern-table spelling.
//
// The rest of the document is deliberately ordinary: one service and one
// component whose body reaches no witnessed extern at all.

extern pure fn revoke(id: Secret[Str]) -> Unit = @py {
    return
}

extern witnessed[fs] fn lease() -> Result[Str, Str]
    undo revoke(result)
    = @py {
        return Ok("lease-1")
    }

service Ops {
  emission fn touch(p: Str)
}

component Agent provides ops: Ops {
  provide ops {
    fn touch(p) {
      return
    }
  }
}
