// item 421 F6 / item 256 §7: the declared `Secret[T]` marking in the positions
// where a type CONSTRUCTOR carries it, plus the two declaration surfaces
// `secrets.rvl` does not reach (a module `fn` parameter and a component
// `config` field).
//
// `Secret[T]` is a QUALIFIER, not a type constructor: the frontend strips it
// off every declared type and leaves a flag behind, so the IR reads `"Str"` and
// the marking rides in `secret_return` / `secret_witness` /
// `params[i]["secret"]` / a config field's `secret`. Nesting is the half only a
// RECURSIVE read gets right - a fallible lease has to spell its payload
// `Result[Secret[Str], Str]`, and the bytes crossing there are exactly as
// confidential as `Secret[Str]`'s.
//
// The origin extern is `pure` rather than a scoped `emission[..]` because the
// self-host parser does not accept a scoped capability after `extern` (a
// separate, named gap); the marking is read off the declared RETURN either way.
extern pure fn lease(u: Str) -> Result[Secret[Str], Str]
  = @py {
      return ("ok", "lease-for-" + u)
    }

fn hold(token: Secret[Str], n: Int) -> Int {
  return n
}

service Store {
  fn keep(box: Opt[Secret[Str]]) -> Int
  fn drop(n: Int) -> Int
}

component Keeper provides store: Store {
  config { api_key: Secret[Str], label: Str }

  provide store {
    fn keep(box) = 1
    fn drop(n) = n
  }
}
