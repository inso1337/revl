// Closed, small pure templates, and calls that must preserve evaluation.
fn identity(x: Int) -> Int { return x }
fn twice_inline(x: Int) -> Int { return x + x }
fn guarded(x: Int) -> Int {
  if (x < 0) { return 0 }
  if (x > 10) { return 10 }
  return x
}
fn nested_inline(x: Int) -> Int { return identity(x) + 1 }
fn ignores(x: Int) -> Int { return 7 }
fn conditional_only(x: Int) -> Int { return true ? 2 : x }
fn recursive_inline(x: Int) -> Int { return recursive_inline(x) }
fn pair_inline(x: Int, y: Int) -> Int { return x + y }
fn run_inline(x: Int, next: () -> Int) -> Int {
  let a = identity(next())
  let b = twice_inline(next())
  let c = ignores(next())
  let d = conditional_only(next())
  let e = nested_inline(x)
  let f = guarded(x)
  return a + b + c + d + e + f
}
fn pure_arguments(xs: List[Int]) -> Int {
  let a = twice_inline(xs.length())
  let b = guarded(3)
  return a + b
}
