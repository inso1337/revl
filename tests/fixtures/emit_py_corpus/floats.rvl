// Canonical Float -> Str (slice 3, `_revl_ftoa`): a `${…}` template over a
// provably-Float expression (a `/` division and a float literal) sets the
// `_uses_float_interp` gate, so the ECMAScript-shortest-round-trip helper is
// emitted and the interpolation renders each float through `_revl_ftoa`.
fn fmt(a: Float, b: Float) -> Str {
  return `ratio ${a / b} end ${2.5}`
}

// The two operands the node's own shape cannot classify. `a` is a Float that
// arrives through a parameter and `flag` is a Bool: python's `str()` renders
// them `3.0`/`1e-07` and `True`, none of which is what any other tier prints,
// so both read the `interp_type` the frontend records instead.
fn tagged(a: Float, flag: Bool) -> Str {
  return `value ${a} flag ${flag}`
}
