// ADMITTED: `model_helper_no_block.rvl` with role `tool` reaching `[*]`, which
// the component holds. The file name's prefix is the expected verdict (`model_`
// refused under G-MODEL-PLACE, `ok_` admitted);
// tests/test_model_reach_crossing.py holds it.

model role tool on_device reaches [*]

extern emission[model.tool] fn run_tool(p: Str) -> Str = @py { return p }
fn ask(p: Str) -> Str { return run_tool(p) }
service Answer { emission fn classify(text: Str) -> Str }

component Classifier provides out: Answer {
  provide out { fn classify(text) = emit ask(text) }
}
