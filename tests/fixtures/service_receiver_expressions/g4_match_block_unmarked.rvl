// REFUSED G4 (marker rule, issue #1729): the receiver is a `match` written in place
// whose `Some` arm is a statement block ending in `w.pay`, and `.charge(n)` is
// called on it with no `emit`. The reference gave the block arm's `do` value no
// type, so the match had none and the crossing was admitted unmarked.
// The file name's prefix is the expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_service_receiver_expressions.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      let o = Some(n)
      let x = (match o {
        Some(v) => {
          let z = v
          w.pay
        },
        None => w.pay
      }).charge(n)
      return x
    }
  }
}
