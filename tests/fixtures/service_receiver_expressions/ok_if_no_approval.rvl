// ADMITTED: the `if` receiver marked, in a program where no extern declares
// `requires approval`. The floor is inert, so this pins that the fix reads the
// crossing and does not refuse the spelling. The file name's prefix is the
// expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_service_receiver_expressions.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      emit (if (n > 0) { w.pay } else { w.pay }).charge(n)
      return 0
    }
  }
}
