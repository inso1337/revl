// ADMITTED (provider upper bound, issue #1508): `Till.go` is declared
// `emission[production.payment]`, and its implementation crosses through an
// `if` written in place holding the provision, marked and approved. The
// crossing is read at the op's declared scope, `production.payment`, which the
// bound covers. Until issue #1508 it was read as a host emission over the
// unnameable boundary and refused. The file name's prefix is the expected
// verdict (`g4_` refused, `ok_` admitted);
// tests/test_service_receiver_expressions.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay { emission[production.payment] fn charge(cents: Int) -> Int }
service Till { emission[production.payment] fn go(n: Int) -> Int }

component Worker provides pay: Pay {
  provide pay { fn charge(cents) = 1 }
}

component Register provides till: Till {
  let a = await approval[production.payment] { reason: "pay" }
  provide till {
    fn go(n: Int) {
      let w = effect spawn Worker with { } undo w.dispose()
      emit (if (n > 0) { w.pay } else { w.pay }).charge(n) with a
      return 0
    }
  }
}
