// a Map receiver keeps the lenient reading: `Map` is the one value head a host
// handle shares its name with, so its static type cannot rule a method out
service Math { fn go(n: Int) -> Int }
component C provides math: Math {
  provide math {
    fn go(n) {
      let m: Map[Str, Int] = Map.empty()
      return m.frob()
    }
  }
}
