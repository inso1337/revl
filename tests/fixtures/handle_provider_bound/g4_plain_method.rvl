// REFUSED G4 (provider upper bound, issue #1508): `Sup.run` is declared plain,
// and its implementation reaches `Task.go`. The file name's prefix is the
// expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_handle_provider_bound_1508.py holds it.

service Task { emission[net] fn go() -> Int }
service Sup {  fn run() -> Int }

component Worker provides task: Task {
  provide task { fn go() = 0 }
}

component Supervisor provides sup: Sup {
  provide sup {
    fn run() {
      let w = effect spawn Worker with { } undo w.dispose()
      emit w.task.go()
      return 0
    }
  }
}
