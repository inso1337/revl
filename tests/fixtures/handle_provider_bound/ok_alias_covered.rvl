// ADMITTED (provider upper bound, issue #1508): the crossing through an alias
// of the provision, `let t = w.task`, under a covering bound. The file name's
// prefix is the expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_handle_provider_bound_1508.py holds it.

service Task { emission[net] fn go() -> Int }
service Sup { emission[net] fn run() -> Int }

component Worker provides task: Task {
  provide task { fn go() = 0 }
}

component Supervisor provides sup: Sup {
  provide sup {
    fn run() {
      let w = effect spawn Worker with { } undo w.dispose()
      let t = w.task
      emit t.go()
      return 0
    }
  }
}
