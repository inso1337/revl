// REFUSED G4 (provider upper bound, issue #1508): the value form under
// `emission[db]`. Before, the value form was not read by the bound at all and
// this was admitted. The file name's prefix is the expected verdict (`g4_`
// refused, `ok_` admitted); tests/test_handle_provider_bound_1508.py holds it.

service Task { emission[net] fn go() -> Int }
service Sup { emission[db] fn run() -> Int }

component Worker provides task: Task {
  provide task { fn go() = 0 }
}

component Supervisor provides sup: Sup {
  provide sup {
    fn run() {
      let w = effect spawn Worker with { } undo w.dispose()
      let r = emit w.task.go()
      return r
    }
  }
}
