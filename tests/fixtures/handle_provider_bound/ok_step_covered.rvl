// ADMITTED (provider upper bound, issue #1508): `Sup.run` is declared
// `emission[net]` and crosses `Task.go`, declared `emission[net]`, off a spawn
// handle. The crossing is read at the op's declared scope, a fact the spawned
// `Worker` is held to by its own provider bound, and `net` fits. Refused before
// as an unnameable host boundary. The file name's prefix is the expected
// verdict (`g4_` refused, `ok_` admitted);
// tests/test_handle_provider_bound_1508.py holds it.

service Task { emission[net] fn go() -> Int }
service Sup { emission[net] fn run() -> Int }

component Worker provides task: Task {
  provide task { fn go() = 0 }
}

component Supervisor provides sup: Sup {
  provide sup {
    fn run() {
      let w = effect spawn Worker with { } undo w.dispose()
      emit w.task.go()
      return 0
    }
  }
}
