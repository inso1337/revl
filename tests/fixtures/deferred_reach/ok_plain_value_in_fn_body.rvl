// ADMITTED: an ordinary pure extern passed as a function value in a fn body.
// Only a `deferred` extern is refused as a value. The file name's prefix is the
// expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_gate_deferred_reach_1688.py holds it.

extern emission deferred fn deliver(sink: Str, msg: Str) = @py { return }
extern pure fn note(a: Str, b: Str) -> Unit = @py { return }
fn apply(f: (Str, Str) -> Unit, a: Str, b: Str) -> Unit { return f(a, b) }
fn run(a: Str, b: Str) -> Unit {
  return apply(note, a, b)
}
service Ops { emission fn enqueue(sink: Str, msg: Str) }
component Agent provides ops: Ops {
  provide ops {
    fn enqueue(sink, msg) { emit deliver(sink, msg) }
  }
}
