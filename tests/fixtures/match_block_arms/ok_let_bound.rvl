// ADMITTED (issue #1699): a block arm bound by `let x = match ...`, its tail on the
// next line. The gate refused G1, "`z` is not a declared requirement", reading the
// tail line as a statement of the method.
// The file name's prefix is the expected verdict (`ok_` admitted, `g1_`/`g4_` refused
// under that tag); tests/test_gate_match_block_arms_1699.py holds it.

service S { fn go(n: Int) -> Int }
component C provides s: S {
  provide s {
    fn go(n: Int) {
      let o = Some(n)
      let x = match o { Some(v) => { let z = v + 1
 z }, None => 0 }
      return x
    }
  }
}
