// ADMITTED (issue #1699): an arm binds a name the method already bound, for the
// same reason as ok_rebind_inside_arm.
// The file name's prefix is the expected verdict (`ok_` admitted, `g1_`/`g4_` refused
// under that tag); tests/test_gate_match_block_arms_1699.py holds it.

service S { fn go(n: Int) -> Int }
component C provides s: S {
  provide s {
    fn go(n: Int) {
      let z = n
      let o = Some(n)
      let x = match o {
        Some(v) => {
          let z = v + 1
          z
        },
        None => z
      }
      return x
    }
  }
}
