fn indexed(value: Any) -> Any { return value["function"] }
fn list_equal() -> Bool {
  assert [1, 2] == [1, 2]
  assert [1, 2] != [1, 3]
  return true
}
type Pair = { left: Int, right: Int }
fn record_equal() -> Bool {
  let a: Pair = { left: 1, right: 2 }
  let b: Pair = { left: 1, right: 2 }
  let c: Pair = { left: 1, right: 3 }
  assert a == b
  assert a != c
  return true
}
service LengthReader { fn size() -> Int }
component LengthProvider provides reader: LengthReader {
  config { label: Str = "text" }
  provide reader { fn size() = config.label.length }
}
