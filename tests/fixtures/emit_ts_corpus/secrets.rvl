// item 421 F6 / item 429(d), the ts end: the three sites at which a declared
// `Secret[T]` survives into the emitted TypeScript.
//
//   * the ORIGIN — an extern whose declared return was `Secret[T]`. The verbatim
//     `@ts` body owns its own `return`, so it moves into `_revl_secret_<name>`
//     (NOT exported) and the exported name becomes a one-line
//     `host.secretResult(...)` wrapper. Both the sync and the ASYNC form are here
//     (the async one wraps `host.secretResult(await …)` and returns
//     `Promise<T>`), and a plain extern beside them keeps the bare
//     `export function <name>` form, which is what pins that the wrapper is
//     emitted from the stamp and not for every extern.
//   * the RECEIVER — a provide method whose service declares a parameter
//     `Secret[T]`: `host.markSecret(<param>)` at the head of the method, the
//     params joined when several are declared, and ABSENT from a method that
//     declares none. The impl's param names deliberately differ from the
//     declared ones (`tok` for `token`) so the by-index read of the service
//     stamp is exercised rather than a name match.
//   * the CONFIG field — a `config` field declared `Secret[T]` carries
//     `, secret: true` in its `host.applyConfigDefaults` spec, on the required
//     form and on the defaulted form, with the undeclared field beside them
//     unstamped.
//
// The sync origin extern is `pure`, not `emission[vault.mint]`, for the same
// reason tests/fixtures/emit_py_corpus/secrets.rvl gives: the self-host parser
// does not accept a scoped capability after `extern`. `taint.py` sets
// `secret_return` off the declared RETURN qualifier alone, so the marking under
// test is exercised either way. The async one has to be `emission` — a `pure`
// extern cannot be `async` ("a suspension is observable") — but UNSCOPED, so the
// self-host parser still reads it.
extern pure fn mint_token(u: Str) -> Secret[Str]
  = @ts {
      return "token-for-" + u
    }

extern emission async fn refresh_token(u: Str) -> Secret[Str]
  = @ts {
      return "refreshed-for-" + u
    }

extern pure fn tag(n: Int) -> Str
  = @ts {
      return "n" + String(n)
    }

service Vault {
  fn store(token: Secret[Str]) -> Int
  fn pair(a: Secret[Str], n: Int, b: Secret[Str]) -> Int
  fn plain(n: Int) -> Int
}

component VaultKeeper provides vault: Vault {
  config { api_key: Secret[Str], region: Str = "eu", retries: Int = 2 }

  provide vault {
    fn store(tok) = 1
    fn pair(a, n, b) = n
    fn plain(n) = n + 1
  }
}
