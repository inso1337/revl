// issue #2303: a primitive or `Any` type argument is spelled as a Java
// reference type, and a generic record declares and applies its parameters.
type Bx[T] = { v: T }
type Pair[A, B] = { first: A, second: B }
fn ints(xs: List[Int32]) -> List[Int32] { return xs }
fn anys(xs: List[Any]) -> List[Any] { return xs }
fn table(d: Map[Str, Int32]) -> Map[Str, Int32] { return d }
fn maybe(x: Opt[Int32]) -> Opt[Int32] { return x }
fn boxes(bs: List[Bx[Int]]) -> List[Bx[Int]] { return bs }
fn by_name(m: Map[Str, Bx[Str]]) -> Map[Str, Bx[Str]] { return m }
fn pair(p: Pair[Str, Int]) -> Int { return p.second }
// issue #2325: `Unit` as a type argument is `java.lang.Void`, a `Result[..]`
// in a signature alone emits `RevlResult`, a `Set[..]` is `java.util.Set` and
// a `Stream[..]` widens to `Object`.
type Held = { done: Result[Unit, Str], tags: Set[Str] }
fn units(xs: List[Unit]) -> List[Unit] { return xs }
fn results(rs: List[Result[Int, Str]]) -> List[Result[Int, Str]] { return rs }
fn settle(r: Result[Unit, Str]) -> Result[Unit, Str] { return r }
fn tags(s: Set[Int]) -> Set[Int] { return s }
fn feed(s: Stream[Int]) -> Stream[Int] { return s }
// A generic variant declares its type parameters on the interface and on
// every case, so a signature applies them (issue #2325).
type Box[T] = Full(T) | Empty
type Either[L, R] = Left(L) | Right(R) | Neither
fn keep(b: Box[Int]) -> Box[Int] { return b }
fn eithers(es: List[Either[Str, Int]]) -> List[Either[Str, Int]] { return es }
// A `match` over a built-in Result switches over the sealed `RevlResult` and
// casts each bound payload to the arm's type.
fn settled(r: Result[Int, Str]) -> Int {
  return match r {
    Ok(v) => v,
    Err(_) => 0,
  }
}
fn reason(r: Result[Int, Str]) -> Str {
  return match r {
    Err(e) => e,
    _ => "ok",
  }
}
// A `match` over a generic variant applies the selector's type arguments to
// each case pattern, so a bound payload is `Long`, not `Object` (issue
// #2325). A parameter and a call to a top-level fn carry them; a `let` local
// keeps the raw pattern. No case is built here: the self-host checker refuses
// `Full(n)` for `Box[Int]` (issue #2472).
fn bumped(b: Box[Int]) -> Int {
  return match b {
    Full(v) => v + 1,
    Empty => 0,
  }
}
fn doubled(e: Either[Str, Int]) -> Int {
  return match e {
    Right(n) => n * 2,
    _ => 0,
  }
}
fn called(b: Box[Int]) -> Int {
  return match keep(b) {
    Full(v) => v - 1,
    Empty => 0,
  }
}
fn local(b: Box[Int]) -> Int {
  let c = keep(b)
  return match c {
    Full(_) => 1,
    Empty => 0,
  }
}
