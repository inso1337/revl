// ADMITTED: a record read for its data, `r.k + n`, beside the function field.
// Only a CALL through a record is refused. The file name's prefix is the
// expected verdict (`t1_` refused, the family the census tags T1; `ok_`
// admitted); tests/test_record_field_call_1547.py holds it.

extern pure fn twice(n: Int) -> Int = @py { return n * 2 }
service S { fn go(n: Int) -> Int }

component C provides s: S {
  provide s {
    fn go(n: Int) {
      let r = { f: twice, k: 1 }
      return r.k + n
    }
  }
}
