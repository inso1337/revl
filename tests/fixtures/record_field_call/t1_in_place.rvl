// REFUSED (issue #1547): a record literal read in place, `{ f: twice }.f(n)`.
// The file name's prefix is the expected verdict (`t1_` refused, the family the
// census tags T1; `ok_` admitted); tests/test_record_field_call_1547.py holds
// it.

extern pure fn twice(n: Int) -> Int = @py { return n * 2 }
service S { fn go(n: Int) -> Int }

component C provides s: S {
  provide s {
    fn go(n: Int) {
      return { f: twice }.f(n)
    }
  }
}
