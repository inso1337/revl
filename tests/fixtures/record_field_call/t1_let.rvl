// REFUSED (issue #1547): `r.f(n)` with `r` a record whose field `f` holds a
// function, called in a provide method. Records carry data, not methods; a `fn`
// body refuses this, and the component lowering now refuses it with the same
// message. Before, it compiled and the py tier crashed with `AttributeError:
// 'dict' object has no attribute 'f'`. The file name's prefix is the expected
// verdict (`t1_` refused, the family the census tags T1; `ok_` admitted);
// tests/test_record_field_call_1547.py holds it.

extern pure fn twice(n: Int) -> Int = @py { return n * 2 }
service S { fn go(n: Int) -> Int }

component C provides s: S {
  provide s {
    fn go(n: Int) {
      let r = { f: twice }
      let u = r.f(n)
      return u
    }
  }
}
