// ADMITTED: the field read off a record written in place, bound and then
// called, `let g = { f: twice }.f`. The file name's prefix is the expected
// verdict (`t1_` refused, the family the census tags T1; `ok_` admitted);
// tests/test_record_field_call_1547.py holds it.

extern pure fn twice(n: Int) -> Int = @py { return n * 2 }
service S { fn go(n: Int) -> Int }

component C provides s: S {
  provide s {
    fn go(n: Int) {
      let g = { f: twice }.f
      return g(n)
    }
  }
}
