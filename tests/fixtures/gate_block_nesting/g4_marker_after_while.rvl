// REFUSED G4 (marker): `db.put` is an emission crossed without `emit`.
//
// A provide-method `while` over several lines. The crossing is written AFTER
// the block, so the reader has to find the block's closing brace by nesting
// depth to reach it.
//
// One document per rule and block form, so the gate/reference census measures
// each (tools/gate_reference_census.py). The file name's prefix is the
// expected verdict; tests/test_gate_reference_census.py holds it.

service Db { emission fn put(k: Str) -> Int  emission fn del(k: Str) -> Int  fn get(k: Str) -> Int }
service K { emission fn f(k: Str) -> Int }
component C requires db: Db provides k: K {
  provide k {
    fn f(k) {
      var n = 0
      while (n < 2) {
        n = n + 1
      }
      effect db.put(k) undo db.del(k)
      return 0
    }
  }
}
