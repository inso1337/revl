// REFUSED G4 (marker, issue #1437): the host extern `zz_write` is an emission
// crossed without `emit`.
//
// A provide-method `for` over several lines. The crossing is written AFTER
// the block.
//
// One document per rule and block form, so the gate/reference census measures
// each (tools/gate_reference_census.py). The file name's prefix is the
// expected verdict; tests/test_gate_reference_census.py holds it.

extern emission[net] fn zz_write(t: Str) -> Int = @py { return 1 }
extern pure fn zz_undo(t: Str) -> Int = @py { return 1 }
service K { emission[net] fn f(k: Str) -> Int }
component C provides k: K {
  provide k {
    fn f(k) {
      for (x of [1]) {
        let z = x
      }
      let q = zz_write(k)
      return 0
    }
  }
}
