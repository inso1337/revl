// issue #2495: a generic call inside a provide method. The component dialect
// spells a call as a `fn` node rather than a `call`, which issue #2558 taught
// the emitter to type the way it already typed the `call` node: the callee's
// type parameters bound from the arguments, so this `+` over two of them renders
// as `format!`, not as the arithmetic `(a + b)` that `String + String` made
// E0308. The smallest component that reaches it: one function, one service, one
// pure provider with a block body.
// `comp_provide_generic_add.rvl` is the wider document over the same seam; this
// one stays exactly as issue #2495 left it, so the #2558 change is measured
// against bytes already recorded rather than bytes it picked itself.
fn id[T](x: T) -> T { return x }

service Greeter {
  fn greet(who: Str) -> Str
}

component Hello provides greeting: Greeter {
  provide greeting {
    fn greet(who) {
      return id("s") + id(who)
    }
  }
}
