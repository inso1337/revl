// Rust corpus witness for finite Float literals, unary/binary float arithmetic,
// mixed Int/Float widening, and public function visibility.
fn float_ops(a: Float, n: Int) -> Float {
  let x = 1.5 + a
  let y = n + 0.5
  return -x * y
}

pub fn public_float() -> Float { return 2.25 }
fn accept_float(x: Float) -> Float { return x }
fn explicit_widen() -> Float { return accept_float(3) }
fn accept_int(x: Int) -> Int { return x }
fn explicit_int_widen(x: Int32) -> Int { return accept_int(x) }
