// docs/arithmetic.md's total arithmetic forms, READ: the Result is bound by a
// `let` whose type is inferred from the call, then matched. The signature never
// names `Result`, so the call alone has to pull the built-in Result in. Not on
// the wasm tier, which defers tagged reads.
fn sum_or(a: Int, b: Int, fallback: Int) -> Int {
  let r = a.checked_add(b)
  return match r { Ok(v) => v, Err(e) => fallback }
}

fn product_or(a: Int, b: Int, fallback: Int) -> Int {
  return match a.checked_mul(b) { Ok(v) => v, Err(e) => fallback }
}
