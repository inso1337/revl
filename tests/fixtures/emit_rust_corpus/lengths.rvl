fn property_lengths(s: Str, xs: List[Int]) -> Int {
  return s.length + xs.length
}

pub fn lengths_report(xs: List[Int]) -> Int {
  return property_lengths("é", xs)
}

fn tok_at(ts: List[Int], i: Int) -> Int {
  if (i >= 0 && i < ts.length()) { return ts[i] }
  return 0
}

fn scan_sum(ts: List[Int], i: Int) -> Int {
  if (i >= ts.length()) { return 0 }
  return tok_at(ts, i) + scan_sum(ts, i + 1)
}

pub fn scan_all(ts: List[Int]) -> Int {
  return scan_sum(ts, 0)
}

pub fn probe_literal() -> Int {
  return tok_at([5, 6, 7], 0)
}

fn scalar_text(n: Int) -> Str {
  return n.to_str()
}
