// REFUSED G4 (approval floor, issue #1682): `emit p.charge(n)` crosses
// `production.payment`, which an extern declared `requires approval`, with no
// `with` edge. The file name's prefix is the expected verdict (`g4_` refused,
// `ok_` admitted); tests/test_service_typed_params.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay {
  emission[production.payment] fn charge(cents: Int) -> Int
  fn status() -> Int
}
service Till { emission fn go(p: Pay, n: Int) -> Int }

component Register provides till: Till {
  provide till {
    fn go(p, n) {
      emit p.charge(n)
      return 0
    }
  }
}
