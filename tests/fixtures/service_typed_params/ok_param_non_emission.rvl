// ADMITTED: `p.status()` through the parameter, a plain operation of `Pay`. Not
// a crossing, so no marker and no edge. The file name's prefix is the expected
// verdict (`g4_` refused, `ok_` admitted); tests/test_service_typed_params.py
// holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay {
  emission[production.payment] fn charge(cents: Int) -> Int
  fn status() -> Int
}
service Till { emission fn go(p: Pay, n: Int) -> Int }

component Register provides till: Till {
  provide till {
    fn go(p, n) {
      let x = p.status()
      return x
    }
  }
}
