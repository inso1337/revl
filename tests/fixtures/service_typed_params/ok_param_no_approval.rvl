// ADMITTED: the marked crossing through the parameter in a program where no
// extern declares `requires approval`, under a bare `emission` bound. Pins that
// the rule reads the crossing and does not refuse the spelling. The file name's
// prefix is the expected verdict (`g4_` refused, `ok_` admitted);
// tests/test_service_typed_params.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int = @py { return 1 }
service Pay {
  emission[production.payment] fn charge(cents: Int) -> Int
  fn status() -> Int
}
service Till { emission fn go(p: Pay, n: Int) -> Int }

component Register provides till: Till {
  provide till {
    fn go(p, n) {
      emit p.charge(n)
      return 0
    }
  }
}
