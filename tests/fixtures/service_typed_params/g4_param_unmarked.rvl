// REFUSED G4 (marker rule, issue #1682): `p` is the method's own parameter of
// service type `Pay`, and `p.charge(n)` crosses `Pay.charge`, an `emission`,
// with no `emit`. A call through a service-typed parameter is a crossing of
// that service's declared scopes, judged in the method. Admitted before by
// every rule. The file name's prefix is the expected verdict (`g4_` refused,
// `ok_` admitted); tests/test_service_typed_params.py holds it.

extern emission[production.payment] fn charge(cents: Int) -> Int requires approval = @py { return 1 }
service Pay {
  emission[production.payment] fn charge(cents: Int) -> Int
  fn status() -> Int
}
service Till { emission fn go(p: Pay, n: Int) -> Int }

component Register provides till: Till {
  provide till {
    fn go(p, n) {
      let x = p.charge(n)
      return x
    }
  }
}
