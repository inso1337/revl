// Issue #1954: the ts emitter's bound-secret seam (item 256), the document
// `tests/test_selfhost_emit_ts.py` registers as `../bound_secret_corpus/
// bound_secrets.rvl`.
//
// It reaches what no document in `tests/fixtures/emit_ts_corpus/` can: an
// extern bound to a capability by `secret NAME for CAP`, so the emitter emits
// `_REVL_SECRET_NAMES`, the `_REVL_SECRETS` map and the fail-loud
// `_revlSecret` helper, and each bound extern body opens with
// `const NAME = _revlSecret("NAME");`. Three externs cover the three arms at
// once: `send` is bound and sync, `pull` is bound and async, and `ping` is
// secret-free beside them — so the seam is emitted (some extern binds) while a
// body with no binding stays byte-identical to its unbound form.
//
// It lives here, outside every census directory (`examples`, `tests/fixtures`,
// `selfhost`, `stdlib`, `demo`, `tck`, `backends`, `dogfood`), because the
// native front end cannot read `secret NAME for CAP` yet: the self-host lexer
// has no `secret` keyword and `selfhost/lower.rvl` carries no `secrets` rows
// (issue #2012). A `.rvl` under a census directory would therefore enter
// `tools/gate_reference_census.py` as a NEW `false-reject` divergence against
// an empty baseline, which `tests/test_gate_reference_census.py` reads as a
// regression. `LOWER_GAP_DOCS["ts"]` in `tests/test_selfhost_compile.py` names
// this document as the native-chain gap, and #2012 is what closes it.

secret api_key for net.send
secret bearer for net.pull

extern emission[net.send] fn send(m: Str) -> Int
  = @py { return len(m) + len(api_key) }
  = @ts { return BigInt(m.length + api_key.length); }

extern emission[net.pull] async fn pull(u: Str) -> Str
  = @py { return u + bearer }
  = @ts { return await Promise.resolve(u + bearer); }

extern emission[net.ping] fn ping(u: Str) -> Str
  = @py { return u }
  = @ts { return u; }

fn drive(u: Str) -> Str {
  let n = send(u)
  let p = pull(u)
  return p
}
