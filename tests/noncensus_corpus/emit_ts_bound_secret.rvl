// Issue #1954 (item 256, the ts end): the capability-bound secret surface —
// `secret NAME for CAP`, read from the `@ts` body of an emission extern that
// serves CAP.
//
// This is a DIFFERENT feature from the declared `Secret[T]` in
// `tests/fixtures/emit_ts_corpus/secrets.rvl` (item 421 F6 / item 429(d)):
// that one stamps a RETURN qualifier and is redacted at the boundary, whereas
// item 256 binds a NAME to a CAPABILITY. The emitter's whole job here is to
// inject the seam the run driver fills at plug — the `_REVL_SECRET_NAMES` /
// `_REVL_SECRETS` / `_revlSecret(name)` scaffold, and one
// `const NAME = _revlSecret("NAME");` as the FIRST local of every bound extern
// body, sync and async alike.
//
// Two names are bound to the one capability on purpose. The scaffold's name
// list is emitted once per module while the bind is per body, so a document
// binding a single name cannot tell a correct per-extern read from a
// module-level one; and `send_async` beside `send` pins that the async body
// carries the same first local the sync one does.
//
// `ping` binds nothing, which pins the other direction: the seam belongs to
// the bodies that serve CAP, not to every extern in the document.
//
// This document lives OUTSIDE every corpus directory the census walks
// (`tests/noncensus_corpus/`, which is in no `CORPUS_DIRS` entry) for a
// recorded reason. The native chain cannot read `secret` at all — the lexer
// has no keyword, the parser no node, `selfhost/lower.rvl` no port — so the
// gate refuses this document with `BAD|unexpected token at top level` and it
// would otherwise have to enter `tools/gate_reference_census_baseline.json` as
// a standing `false-reject` waiver. The gap is recorded instead in
// `LOWER_GAP_DOCS["ts"]`, which names the document rather than skipping it, and
// tracked as issue #2012. The EMITTER half holds in its strongest form: fed the
// reference IR, `selfhost/emit_ts.rvl` reproduces this document byte for byte,
// which is what `tests/test_selfhost_emit_ts.py` asserts.
secret api_key for net.send
secret audit_key for net.send

extern emission[net.send] fn send(m: Str) -> Int
  = @ts {
      return BigInt(m.length + api_key.length + audit_key.length)
    }

extern emission[net.send] async fn send_async(m: Str) -> Int
  = @ts {
      return BigInt(m.length + api_key.length + audit_key.length)
    }

extern pure fn ping(m: Str) -> Str
  = @ts {
      return m
    }
