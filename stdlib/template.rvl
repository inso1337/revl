// The revl stdlib TEMPLATE module (roadmap item 459, issue #722).
//
// ------------------------------------------------------------------- why
// Item 459 wants first-class frontend assets: an asset lives as a FILE, a revl
// source REFERENCES it, and the toolchain stops carrying markup in string
// literals. Once a template is a file with insertion sites rather than a
// concatenated string, the page it produces is data crossing into markup, and
// the crossing has to be escaped for the CONTEXT the data lands in. There is no
// single correct escape function: the same bytes are safe inside a text node and
// a `</script>` breakout inside a script element. stdlib/escape.rvl (also item
// 459) names the three per-context escapers but leaves the CALLER to know which
// one applies at each site, and that is exactly the decision a rendered
// template must not leave to a human reading 200 lines of markup.
//
// This module is the consumer that closes that loop. A template writes the
// context of every insertion SITE, next to the site:
//
//   <script type="module" src="{{uri:src}}"></script>
//   <h1>{{html:title}}</h1>
//   <script>boot("{{script:token}}");</script>
//
// so the escaper is chosen BY THE HOLE, from the surrounding markup, once, at
// the site where the context is visible, instead of by whoever builds the value
// (who cannot see the site). A value is then bound to a hole by NAME, and the
// module refuses to render a template whose holes are unbound, whose bindings
// are ambiguous, or whose hole names an escaper that does not exist. There is
// deliberately NO raw/no-escape insertion syntax: a hole is always escaped for
// its declared context, so "forget to escape" is not expressible. A site that
// needs bytes in the document must say which context it is in.
//
// Like stdlib/escape.rvl, stdlib/str.rvl and stdlib/render.rvl the module is
// PURE revl (built on the base Str/Int surface plus those three escapers, no
// `@py`), so it runs on every backend the day it lands. The py tier is executed
// here.
//
// ------------------------------------------------------------ what is NOT here
// Deliberately out of scope for this stage, and named so the gap is not
// mistaken for done (see docs/design/459-frontend-asset-integration.md):
//   * reading the template FROM DISK. The template arrives as a `Str` (an
//     embedded default, or, in a later stage, the text a resolved asset
//     reference loads). Nothing here touches the filesystem or the toolchain.
//   * control flow and autoescaping inheritance (`{{if}}`, `{{for}}`, blocks,
//     includes, layout inheritance, a per-directory default context). Every
//     hole is explicit and flat.
//   * HTML parsing. Context is INTENT, written by the template author (`html` /
//     `script` / `uri`), not inferred from markup. The module never tries to
//     find where an attribute or a script element ends.
//   * source positions in BYTES. A hole's `start`/`end` and every `Pos` this
//     module reports count CODEPOINTS, the same unit `length`/`slice`/
//     `charCodeAt` use, so `tpl.slice(hole.start, hole.end)` is exactly the
//     hole text on every tier. A reader who assumes bytes and writes
//     `tpl.encode()[start:end]` silently mis-slices every template with a
//     non-ASCII character before a hole.
//
// --------------------------------------------------------------- the surface
// `scan` finds the holes, `escape_for` is the context -> escaper table applied
// to one value, and `render` is scan plus bind plus escape. `Hole` and
// `Binding` are typed handles: a caller cannot pass a bare string where a bound
// value is expected, and a hole name is validated as an identifier, so an
// expression, a filter or a directive cannot be smuggled through the slot.
//
// `render_mapped` is `render` plus the INSERTION-SITE MAP (design note 459
// F2): where every span of the output came from in the template, as 0-based
// line/column, and `source_map` writes that as a Source Map v3 document. This
// is what `Hole.start`/`Hole.end` were recorded for. `render` is `render_mapped`
// with the map dropped rather than a second renderer, so the two doors cannot
// answer different text for one template.
//
// Checked in tests/test_template_stdlib.py and, for the map,
// tests/test_template_source_map_459.py.

use "stdlib/escape.rvl" { escape_html, escape_js, escape_uri }

// ---------------------------------------------------------------- the types

// One insertion site in a template. `context` names the escaping context the
// site declared; `start`/`end` are the offsets of the whole `{{context:name}}`
// hole in the template, which is what a source map would need to point back at
// the original site.
pub type Hole = { name: Str, context: Str, start: Int, end: Int }

// A value bound to a hole by name. The pair is the typed handle: the name is
// matched against `Hole.name`, and the value never carries its own escaping
// decision.
pub type Binding = { name: Str, value: Str }

// Why a template could not be rendered. `code` is a stable token a caller can
// branch on; `message` is the human half and names the offending hole.
pub type TemplateError = { code: Str, message: Str }

// ------------------------------------------------------------- error building

fn err(code: Str, message: Str) -> TemplateError {
  return { code: code, message: message }
}

fn bad_hole(body: Str, at: Int, why: Str) -> TemplateError {
  var m = "template hole `{{"
  m = m.concat(body)
  m = m.concat("}}` at offset ")
  m = m.concat(at.to_str())
  m = m.concat(" ")
  m = m.concat(why)
  return err("malformed-hole", m)
}

fn bad_context(context: Str, at: Int) -> TemplateError {
  var m = "insertion context `"
  m = m.concat(context)
  m = m.concat("` at offset ")
  m = m.concat(at.to_str())
  m = m.concat(" is not a known context; a hole names the context it lands in")
  m = m.concat(" (one of html, script, uri) so the right escaper is chosen")
  return err("unknown-context", m)
}

// --------------------------------------------------------------- the contexts

// The closed set of contexts, in the order they are usually reached for. A
// caller iterating this gets the same list the scanner validates against.
pub fn contexts() -> List[Str] {
  return ["html", "script", "uri"]
}

// Is `context` one this module can escape for? Pure membership over `contexts`.
pub fn context_ok(context: Str) -> Bool {
  if (context == "html") { return true }
  if (context == "script") { return true }
  return context == "uri"
}

// The escaper for a context the caller has ALREADY validated. Private: the
// public door is `escape_for`, and its refusal is what keeps an unknown context
// from reaching a default. The fall-through is html (the text/quoted-attribute
// context), which is the safe reading of "somewhere in the document body".
fn escape_known(context: Str, value: Str) -> Str {
  if (context == "script") { return escape_js(value) }
  if (context == "uri") { return escape_uri(value) }
  return escape_html(value)
}

// Escape `value` for `context`, refusing a context this module does not know.
// This is the whole "the rule is chosen by the insertion context" rule in one
// place: an unknown or misspelled context is an `Err`, never a silent
// fall-through to some other escaper.
pub fn escape_for(context: Str, value: Str) -> Result[Str, TemplateError] {
  if (!context_ok(context)) { return Err(bad_context(context, 0)) }
  return Ok(escape_known(context, value))
}

// ------------------------------------------------------------- name validity

fn is_name_head(code: Int) -> Bool {
  if (code >= 65 && code <= 90) { return true }   // A-Z
  if (code >= 97 && code <= 122) { return true }  // a-z
  return code == 95                               // _
}

fn is_name_char(code: Int) -> Bool {
  if (is_name_head(code)) { return true }
  if (code >= 48 && code <= 57) { return true }   // 0-9
  return code == 46                               // . (dotted paths)
}

// A hole name is an identifier (letters, digits, `_`, `.`, not starting with a
// digit). Anything else, a space, a quote, a `|`, a `(`, a `&`, is refused, so
// the slot can only ever name a bound value. That is what makes filters,
// expressions and raw-insertion sigils inexpressible rather than merely
// undetected.
fn name_ok(name: Str) -> Bool {
  if (name.length() == 0) { return false }
  if (!is_name_head(name.charCodeAt(0))) { return false }
  var i = 1
  let n = name.length()
  while (i < n) {
    if (!is_name_char(name.charCodeAt(i))) { return false }
    i += 1
  }
  return true
}

// ------------------------------------------------------------------ scanning

fn is_brace(code: Int) -> Bool { return code == 123 }
fn is_close_brace(code: Int) -> Bool { return code == 125 }
fn is_colon(code: Int) -> Bool { return code == 58 }

// Offset of the `}}` that closes a hole opened at `from`, or a negative value
// when the template ends first.
fn hole_close(tpl: Str, from: Int) -> Int {
  var i = from
  let n = tpl.length()
  while (i + 1 < n) {
    if (is_close_brace(tpl.charCodeAt(i)) && is_close_brace(tpl.charCodeAt(i + 1))) {
      return i
    }
    i += 1
  }
  return 0 - 1
}

// Offset of the `:` separating context from name inside a hole body, or a
// negative value when the body has none (a filter, a directive, a bare name,
// a raw-insertion sigil: all refused by the caller).
fn hole_colon(body: Str) -> Int {
  var i = 0
  let n = body.length()
  while (i < n) {
    if (is_colon(body.charCodeAt(i))) { return i }
    i += 1
  }
  return 0 - 1
}

// Every insertion hole in `tpl`, left to right, or the first reason the
// template is not well formed. A `{{` with no `}}`, a hole body with no
// `context:name` separator, an unknown context and a non-identifier name are
// all `Err`: scanning is where a template that could not be rendered safely is
// rejected, before any value is bound to it.
pub fn scan(tpl: Str) -> Result[List[Hole], TemplateError] {
  var holes: List[Hole] = []
  var i = 0
  let n = tpl.length()
  while (i < n) {
    if (is_brace(tpl.charCodeAt(i)) && i + 1 < n && is_brace(tpl.charCodeAt(i + 1))) {
      let close = hole_close(tpl, i + 2)
      if (close < 0) {
        var um = "template has an unterminated `{{` at offset "
        um = um.concat(i.to_str())
        um = um.concat(" with no closing `}}`")
        return Err(err("malformed-hole", um))
      }
      let body = tpl.slice(i + 2, close)
      let sep = hole_colon(body)
      if (sep < 0) {
        var w = "has no `context:name` separator; a hole names the context"
        w = w.concat(" it lands in, and there is no raw form")
        return Err(bad_hole(body, i, w))
      }
      let context = body.slice(0, sep)
      let name = body.slice(sep + 1, body.length())
      if (!context_ok(context)) { return Err(bad_context(context, i)) }
      if (!name_ok(name)) {
        var w2 = "does not name a bindable value after the `:`; a hole takes"
        w2 = w2.concat(" an identifier, not an expression, a filter or a sigil")
        return Err(bad_hole(body, i, w2))
      }
      holes = holes.push({ name: name, context: context, start: i, end: close + 2 })
      i = close + 2
    } else {
      i += 1
    }
  }
  return Ok(holes)
}

// ------------------------------------------------------------- binding lookup

fn has_binding(values: List[Binding], name: Str) -> Bool {
  for (b of values) {
    if (b.name == name) { return true }
  }
  return false
}

fn binding_of(values: List[Binding], name: Str) -> Str {
  for (b of values) {
    if (b.name == name) { return b.value }
  }
  return ""
}

fn list_has(xs: List[Str], x: Str) -> Bool {
  for (s of xs) {
    if (s == x) { return true }
  }
  return false
}

// The first name bound twice, or "" when every name is bound once. A value set
// with a repeated name is ambiguous (which binding wins would depend on scan
// order), so `render` refuses it instead of picking one.
fn duplicate_name(values: List[Binding]) -> Str {
  var seen: List[Str] = []
  for (b of values) {
    if (list_has(seen, b.name)) { return b.name }
    seen = seen.push(b.name)
  }
  return ""
}


// ------------------------------------------------------- source positions (F2)
//
// Stage 1 recorded `Hole.start`/`Hole.end` so that "a later stage can map
// generated output back to [the site]". This is that stage (design note 459
// **F2**). It is a DIFFERENT claim from a bundler's source map: Vite's
// `build.sourcemap` maps a bundle back to the frontend sources it was built
// from, which says nothing about where in a TEMPLATE a rendered byte came
// from. What is missing, and what this section supplies, is the map from a
// position in the RENDERED OUTPUT back to the insertion site that produced it.
//
// Units. `Pos.line` and `Pos.column` are both 0-BASED, which is the Source Map
// v3 unit, not the 1-based line an editor shows: the numbers here are fed to a
// map, and converting on the way in would mean converting back on the way out.
// A column counts CODEPOINTS, the same unit `length`/`slice`/`charCodeAt` and
// `Hole.start`/`Hole.end` use. Source Map v3 specifies UTF-16 code units, so
// the two agree for every character in the BMP and diverge only for an astral
// character (above U+FFFF) BEFORE a mapping on the same line.
//
// Line breaks are U+000A only. A bare U+000D is an ordinary character and does
// not start a line, which is what `String.split("\n")` and every source-map
// generator do; in a CRLF template the CR is the last COLUMN of the line.

// A 0-based line and column. See the unit note above.
pub type Pos = { line: Int, column: Int }

// One mapped span of rendered output. `generated` is where the span starts in
// the rendered text and `original` is the template position it came from.
// `kind` is `"text"` for template text copied through unchanged (in which case
// `name` and `context` are "") and `"value"` for an escaped value inserted at a
// hole, whose `original` is the position of the hole's `{{`.
//
// A span that crosses a generated line break is recorded once PER GENERATED
// LINE, because a source map addresses a line and a column and cannot describe
// a span that spills over the end of one. So every generated line that has any
// character carries a segment at column 0.
pub type Segment = { kind: Str, name: Str, context: Str, generated: Pos, original: Pos }

// A render plus its map. `template` is the template the render was made FROM,
// carried so that `source_map` cannot be handed a different one than the
// segments were computed against, and so the emitted map can inline the
// original. `text` is exactly what `render` returns.
pub type Rendered = { template: Str, text: Str, segments: List[Segment] }

// The 0-based line/column of codepoint `offset` in `tpl`, refusing an offset
// outside it. `offset == tpl.length()` is IN range: it is the position one past
// the last character, which is where `Hole.end` of a trailing hole points. The
// refusal is a refusal and not a clamp: silently answering the last position
// for an offset that is not in the template would turn a caller's arithmetic
// bug into a map that points confidently at the wrong place.
pub fn position_at(tpl: Str, offset: Int) -> Result[Pos, TemplateError] {
  let n = tpl.length()
  if (offset < 0 || offset > n) {
    var m = "offset "
    m = m.concat(offset.to_str())
    m = m.concat(" is outside the template, which is ")
    m = m.concat(n.to_str())
    m = m.concat(" codepoints long; a position is 0..length inclusive")
    return Err(err("offset-out-of-range", m))
  }
  return Ok(position_of(tpl, offset))
}

// The unchecked half of `position_at`. Private: every internal caller passes an
// offset `scan` produced, which is in range by construction, and the public
// door is the one that refuses.
fn position_of(tpl: Str, offset: Int) -> Pos {
  var line = 0
  var column = 0
  var i = 0
  while (i < offset) {
    if (tpl.charCodeAt(i) == 10) {
      line += 1
      column = 0
    } else {
      column += 1
    }
    i += 1
  }
  return { line: line, column: column }
}

// ----------------------------------------------------------------- rendering

// The render in progress: the output so far, the segments so far, and the
// generated line/column the NEXT emitted character lands on. It is one record
// rather than four mutable locals so that the copied-text emitter can be
// written once and used both between holes and for the tail.
type Cursor = { out: Str, segs: List[Segment], line: Int, column: Int }

// Copy `tpl[from, to)` through unchanged and record it. Because the text is
// copied verbatim, a generated line break inside it is a template line break at
// the same place, so the original position after the k-th break is k lines
// below where the span started, at column 0.
fn emit_text(cur: Cursor, tpl: Str, from: Int, to: Int) -> Cursor {
  if (to <= from) { return cur }
  let at = position_of(tpl, from)
  var segs = cur.segs.push({ kind: "text", name: "", context: "",
                             generated: { line: cur.line, column: cur.column },
                             original: at })
  var line = cur.line
  var column = cur.column
  var oline = at.line
  var i = from
  while (i < to) {
    if (tpl.charCodeAt(i) == 10) {
      line += 1
      column = 0
      oline += 1
      // a break on the LAST character opens no generated line of its own; the
      // next span starts that line and records its own segment there.
      if (i + 1 < to) {
        segs = segs.push({ kind: "text", name: "", context: "",
                           generated: { line: line, column: 0 },
                           original: { line: oline, column: 0 } })
      }
    } else {
      column += 1
    }
    i += 1
  }
  return { out: cur.out.concat(tpl.slice(from, to)), segs: segs,
           line: line, column: column }
}

// Insert the already-escaped `value` for hole `h`, whose `{{` is at `at`. Every
// generated line the value covers maps to the SAME insertion site: the value is
// one crossing, and a line break inside it is a line break in the DATA, which
// has no position in the template.
fn emit_value(cur: Cursor, value: Str, h: Hole, at: Pos) -> Cursor {
  var segs = cur.segs.push({ kind: "value", name: h.name, context: h.context,
                             generated: { line: cur.line, column: cur.column },
                             original: at })
  var line = cur.line
  var column = cur.column
  var i = 0
  let n = value.length()
  while (i < n) {
    if (value.charCodeAt(i) == 10) {
      line += 1
      column = 0
      if (i + 1 < n) {
        segs = segs.push({ kind: "value", name: h.name, context: h.context,
                           generated: { line: line, column: 0 },
                           original: at })
      }
    } else {
      column += 1
    }
    i += 1
  }
  return { out: cur.out.concat(value), segs: segs, line: line, column: column }
}

fn render_holes(tpl: Str, holes: List[Hole], values: List[Binding]) -> Result[Rendered, TemplateError] {
  var cur: Cursor = { out: "", segs: [], line: 0, column: 0 }
  var pos = 0
  for (h of holes) {
    if (!has_binding(values, h.name)) {
      var um = "template hole `{{"
      um = um.concat(h.context)
      um = um.concat(":")
      um = um.concat(h.name)
      um = um.concat("}}` at offset ")
      um = um.concat(h.start.to_str())
      um = um.concat(" has no bound value; a hole is bound explicitly, there")
      um = um.concat(" is no empty default")
      return Err(err("unknown-binding", um))
    }
    cur = emit_text(cur, tpl, pos, h.start)
    cur = emit_value(cur, escape_known(h.context, binding_of(values, h.name)),
                     h, position_of(tpl, h.start))
    pos = h.end
  }
  cur = emit_text(cur, tpl, pos, tpl.length())
  return Ok({ template: tpl, text: cur.out, segments: cur.segs })
}

// Render `tpl` with `values` AND map the result back to the template: the
// rendered text, plus one segment per generated line per span saying which
// template position that line started from and, for an inserted value, which
// hole it came from. Refusals are exactly `render`'s, in the same order.
pub fn render_mapped(tpl: Str, values: List[Binding]) -> Result[Rendered, TemplateError] {
  let dup = duplicate_name(values)
  if (dup != "") {
    var dm = "value `"
    dm = dm.concat(dup)
    dm = dm.concat("` is bound more than once; a repeated name is ambiguous, so")
    dm = dm.concat(" bind it once")
    return Err(err("duplicate-binding", dm))
  }
  return match scan(tpl) {
    Ok(found) => render_holes(tpl, found, values),
    Err(e) => Err(e),
  }
}

// Render `tpl` with `values`, escaping every inserted value for the context its
// hole declared. Refusals, in order: a duplicate binding name, then any hole
// `scan` rejects, then a hole with no bound value. The template text between
// holes is copied through unchanged.
//
// This is `render_mapped` with the map dropped, rather than a second renderer,
// so the mapped and unmapped doors cannot answer different text for one
// template.
pub fn render(tpl: Str, values: List[Binding]) -> Result[Str, TemplateError] {
  return match render_mapped(tpl, values) {
    Ok(r) => Ok(r.text),
    Err(e) => Err(e),
  }
}

// Render a template whose holes all take the same single value. Convenience for
// the one-slot case (a bootstrap payload injected next to an entry, a URL built
// from one request field); `render` is the general door.
pub fn render_one(tpl: Str, name: Str, value: Str) -> Result[Str, TemplateError] {
  var one: List[Binding] = []
  one = one.push({ name: name, value: value })
  return render(tpl, one)
}

// ------------------------------------------------------------- the source map
//
// Source Map v3: a JSON object whose `mappings` field is a run of `;`-separated
// generated LINES, each a run of `,`-separated segments, each segment a run of
// base64 VLQ fields. The fields are
//   [generated column, source index, original line, original column, name index]
// and every one of them is a DELTA from the previous segment's value for the
// same field. The generated column resets at each line; the other four carry
// across lines. A 4-field segment names no symbol; the 5th field is the index
// into `names`.

// The base64 alphabet, in index order, as a literal rather than arithmetic over
// `charCodeAt` ranges: there is nothing to get subtly wrong in a table.
fn base64_alphabet() -> Str {
  return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

// Signed base64 VLQ. The sign is the LOW bit and the value is shifted up one;
// each digit carries 5 bits with bit 6 (value 32) set when another digit
// follows. revl has no bitwise operators, so the shift and the mask are spelled
// with `div_floor`/`mod` exactly as `stdlib/escape.rvl`'s UTF-8 encoder is.
fn vlq(value: Int) -> Str {
  var rest = value * 2
  if (value < 0) { rest = (0 - value) * 2 + 1 }
  var out = ""
  var more = true
  let alphabet = base64_alphabet()
  while (more) {
    var digit = rest.mod(32)
    rest = rest.div_floor(32)
    if (rest > 0) {
      digit = digit + 32
    } else {
      more = false
    }
    out = out.concat(alphabet.slice(digit, digit + 1))
  }
  return out
}

// Index of `name` in `names`, or a negative value when it is absent.
fn name_index(names: List[Str], name: Str) -> Int {
  var i = 0
  for (s of names) {
    if (s == name) { return i }
    i += 1
  }
  return 0 - 1
}

// The `names` array: every hole name a value segment carries, deduplicated,
// in first-appearance order. Private: `segments` already answers "which holes
// did this render insert", and a second public door onto the same list is a
// second thing to keep in step.
fn mapped_names(segments: List[Segment]) -> List[Str] {
  var names: List[Str] = []
  for (s of segments) {
    if (s.kind == "value" && name_index(names, s.name) < 0) {
      names = names.push(s.name)
    }
  }
  return names
}

// The `mappings` field for `segments`. The segments arrive in generated order,
// which is the order `render_mapped` records them in.
fn mappings_of(segments: List[Segment], names: List[Str]) -> Str {
  var out = ""
  var gline = 0
  var gcolumn = 0
  var oline = 0
  var ocolumn = 0
  var nindex = 0
  var first_on_line = true
  for (s of segments) {
    while (gline < s.generated.line) {
      out = out.concat(";")
      gline += 1
      gcolumn = 0
      first_on_line = true
    }
    if (!first_on_line) { out = out.concat(",") }
    first_on_line = false
    out = out.concat(vlq(s.generated.column - gcolumn))
    gcolumn = s.generated.column
    // one source, so its index is 0 and the delta is always 0.
    out = out.concat(vlq(0))
    out = out.concat(vlq(s.original.line - oline))
    oline = s.original.line
    out = out.concat(vlq(s.original.column - ocolumn))
    ocolumn = s.original.column
    if (s.kind == "value") {
      let ni = name_index(names, s.name)
      out = out.concat(vlq(ni - nindex))
      nindex = ni
    }
  }
  return out
}

// A Source Map v3 document for `rendered`, as JSON. `source` is the name the
// template is known by (the path of the asset it was loaded from, or any label
// when it has no path) and `generated_file` names the output the map describes.
//
// The template text is inlined as `sourcesContent`, and that is not an
// optimisation: this module never reads a template from disk, so `source` may
// well name nothing a devtools client can fetch. A map whose only source cannot
// be loaded shows the consumer an empty pane.
//
// The JSON strings are escaped with `escape_js`, the module's existing script
// escaper, rather than a second escaper written here: its output is already a
// valid JSON string body (it escapes `\`, `"`, the C0 controls and U+2028/9),
// and the three extra characters it encodes, `< > &`, are the ones that would
// otherwise let an inlined template break out of a `<script>` element carrying
// the map. `mappings` needs no escaping: base64, `,` and `;` only.
pub fn source_map(rendered: Rendered, source: Str, generated_file: Str) -> Str {
  let names = mapped_names(rendered.segments)
  var out = "{\"version\":3,\"file\":\""
  out = out.concat(escape_js(generated_file))
  out = out.concat("\",\"sources\":[\"")
  out = out.concat(escape_js(source))
  out = out.concat("\"],\"sourcesContent\":[\"")
  out = out.concat(escape_js(rendered.template))
  out = out.concat("\"],\"names\":[")
  var first = true
  for (nm of names) {
    if (!first) { out = out.concat(",") }
    first = false
    out = out.concat("\"")
    out = out.concat(escape_js(nm))
    out = out.concat("\"")
  }
  out = out.concat("],\"mappings\":\"")
  out = out.concat(mappings_of(rendered.segments, names))
  out = out.concat("\"}")
  return out
}
