// The revl stdlib JSON module (FR-3, docs/stdlib-json.md).
//
// Real tool calls carry structured args (DSH tools take JSON); before this
// module the harness's mock wire protocol had to be flattened to
// `TOOL_CALL name arg1 arg2` and parsed by hand. These externs give a
// component the JSON story the harness needs, scoped to the value types
// revl already carries (Str/Int/Bool/Float/List/Opt/records): `parse` turns
// a Str into a revl value (`Any` — the wildcard the type algebra uses for
// values whose static type only the runtime knows), `stringify` turns one
// back into a Str, and `try_parse` is the TOTAL (never-raising) parse that
// returns a `Result[Any, Str]` so a JSONL stream can be walked tolerantly in
// pure revl (item 362) — see `json_try_parse` below.
//
// Each tier's implementation is the `@<backend>` body beside the signature
// (the extern-body mechanism, docs/syntax-2.0.md §extern). Import with a
// named `use`:
//
//     use "stdlib/json.rvl" { json_parse, json_stringify }
//
// Tier status (see docs/stdlib-json.md for the full table and the path to
// the remaining tiers):
//   * py — `json.loads` / `json.dumps`; executed by the test suite.
//   * ts — a number-preserving parse (a JSON integer literal decodes to a JS
//     `bigint` = revl `Int`, a float to a JS `number` = revl `Float`, item 311)
//     / `JSON.stringify` with a bigint replacer (item 281); emitted by the test
//     suite. Both directions keep full i64 precision, matching the py tier.
//   * rs — `Any` erases to `cordis::Value`; the @rs body boxes a parsed
//     `serde_json::Value` into it and recovers it to re-encode (serde_json
//     is already pinned in the emitted crate). A structured document
//     survives `stringify∘parse`; a parsed value flowing into a typed
//     binding for field access is still the erased-Value boundary, so the
//     harness reads it back through this round-trip, not `tc.name` (item 140).
//   * java — where a provider's Jackson/Gson plugs in; no JDK JSON API, so
//     none until a provider is on the `javac` classpath.
//   * go — `Any` erases to Go's `any`; the @go body reaches `encoding/json`
//     through a `//revl:import encoding/json` directive the emitter hoists
//     into the module's import block (item 140).
//   * wasm — the substrate value model (Int/Bool/Str/List) cannot hold
//     Float/Map/records, so a JSON value has no representation there.
//
// The `Any` return is what makes `parse` usable: it flows into any typed
// position (`let tc: ToolCall = json_parse(s)`), which is how a harness
// recovers a record of tool args from a wire string.

pub extern pure fn json_parse(s: Str) -> Any
  = @py { import json; return json.loads(s) }
  = @ts {
    // The builtin JSON.parse decodes every JSON number to a JS number (f64),
    // so an integer past 2^53 comes back rounded - a silent precision loss on
    // the ts tier that the py tier (json.loads to a Python int) does not have
    // (item 311). A JSON.parse reviver cannot recover it: the reviver is handed
    // the already-rounded number. So this is a number-preserving recursive
    // descent parse that decodes a JSON INTEGER literal (no dot, no exponent)
    // to a JS bigint - revl Int, full i64 precision - and a JSON float (a
    // literal carrying a dot, e, or E) to a JS number - revl Float - matching
    // the py tier. Strings, arrays, objects, true, false and null decode as
    // JSON defines. A bigint round-trips back to a bare JSON number through
    // json_stringify's replacer, so parse and stringify agree with py both ways.
    let i = 0;
    const n = s.length;
    function ws(): void {
      while (i < n) {
        const c = s.charCodeAt(i);
        if (c === 32 || c === 9 || c === 10 || c === 13) i++; else break;
      }
    }
    function fail(m: string): never {
      throw new SyntaxError("json_parse: " + m + " at index " + i);
    }
    function digits(): void {
      while (i < n) { const c = s.charCodeAt(i); if (c >= 48 && c <= 57) i++; else break; }
    }
    function num(): number | bigint {
      const start = i;
      if (s[i] === "-") i++;
      digits();
      let float = false;
      if (s[i] === ".") { float = true; i++; digits(); }
      if (s[i] === "e" || s[i] === "E") { float = true; i++; if (s[i] === "+" || s[i] === "-") i++; digits(); }
      const tok = s.slice(start, i);
      return float ? Number(tok) : BigInt(tok);
    }
    function str(): string {
      i++;
      let out = "";
      while (i < n) {
        const c = s[i++];
        if (c === "\"") return out;
        if (c === "\\") {
          const e = s[i++];
          if (e === "\"" || e === "\\" || e === "/") out += e;
          else if (e === "b") out += "\b";
          else if (e === "f") out += "\f";
          else if (e === "n") out += "\n";
          else if (e === "r") out += "\r";
          else if (e === "t") out += "\t";
          else if (e === "u") { out += String.fromCharCode(parseInt(s.slice(i, i + 4), 16)); i += 4; }
          else fail("invalid escape");
        } else out += c;
      }
      return fail("unterminated string");
    }
    function value(): any {
      ws();
      const c = s[i];
      if (c === "{") {
        i++; ws();
        const o: { [k: string]: any } = {};
        if (s[i] === "}") { i++; return o; }
        for (;;) {
          ws();
          if (s[i] !== "\"") fail("expected a string key");
          const k = str(); ws();
          if (s[i] !== ":") fail("expected a colon");
          i++;
          o[k] = value(); ws();
          if (s[i] === ",") { i++; continue; }
          if (s[i] === "}") { i++; return o; }
          fail("expected a comma or closing brace");
        }
      }
      if (c === "[") {
        i++; ws();
        const a: any[] = [];
        if (s[i] === "]") { i++; return a; }
        for (;;) {
          a.push(value()); ws();
          if (s[i] === ",") { i++; continue; }
          if (s[i] === "]") { i++; return a; }
          fail("expected a comma or closing bracket");
        }
      }
      if (c === "\"") return str();
      if (c === "t") { if (s.slice(i, i + 4) === "true") { i += 4; return true; } return fail("invalid literal"); }
      if (c === "f") { if (s.slice(i, i + 5) === "false") { i += 5; return false; } return fail("invalid literal"); }
      if (c === "n") { if (s.slice(i, i + 4) === "null") { i += 4; return null; } return fail("invalid literal"); }
      if (c === "-" || (c >= "0" && c <= "9")) return num();
      return fail("unexpected token");
    }
    const result = value();
    ws();
    if (i < n) fail("unexpected trailing content");
    return result;
  }
  = @rs { Value::new(serde_json::from_str::<serde_json::Value>(&s).unwrap_or(serde_json::Value::Null)) }
  = @go {
    //revl:import encoding/json
    var v any
    _ = json.Unmarshal([]byte(s), &v)
    return v
  }

pub extern pure fn json_stringify(v: Any) -> Str
  = @py { import json; return json.dumps(v) }
  = @ts {
    // `Int` maps to JS `bigint` (TYPE_MAP), which `JSON.stringify` refuses
    // ("Do not know how to serialize a BigInt"). A replacer parks each bigint
    // behind a quoted sentinel carrying its exact decimal digits, then the
    // quotes are stripped so those digits land as a BARE JSON number - full
    // i64 precision (a plain Number() cast would lose it past 2^53), matching
    // the py tier `json.dumps`. With no bigint present the fast path returns
    // the builtin result unchanged.
    const marks: string[] = [];
    const wire = JSON.stringify(v, (_k, x) => typeof x === "bigint" ? "@@revlBigInt:" + (marks.push(x.toString()) - 1) + "@@" : x);
    return marks.length === 0 ? wire : wire.replace(/"@@revlBigInt:(\d+)@@"/g, (_m, i) => marks[Number(i)]);
  }
  = @rs { v.downcast::<serde_json::Value>().map(|j| serde_json::to_string(&*j).unwrap_or_default()).unwrap_or_default() }
  = @go {
    //revl:import encoding/json
    b, _ := json.Marshal(v)
    return string(b)
  }

// A TOTAL (never-raising) parse: the same decode as `json_parse`, but the
// parse error is returned as the `Err` channel of a `Result[Any, Str]`
// instead of raised (item 362). `Ok(v)` carries the identical value a
// successful `json_parse(s)` produces — this body *calls* `json_parse`, so
// the success path is byte-for-byte the raising parse; only the failure path
// is new. revl has no try/catch (docs/syntax-2.0.md §3.2: "failure is
// `Result` in pure code"), so this is what lets a component walk a JSONL
// stream tolerantly IN REVL — `match json_try_parse(line) { Ok(v) => …,
// Err(_) => skip }` — with no classified host extern for the parse itself:
//
//     use "stdlib/json.rvl" { json_try_parse }
//     match json_try_parse(line) {
//       Ok(rec) => keep(rec.field),   // typed access off the parsed record
//       Err(_)  => skip,              // a malformed line is skipped, not fatal
//     }
//
// Tiers: py and ts — the two tiers where `json_parse` RAISES on invalid input
// and so need the tolerant wrapper. The rs and go `json_parse` bodies are
// already total (they decode a bad document to `null` rather than raising), so
// a distinct tolerant primitive would carry no information there; a tier
// without a body refuses honestly if `json_try_parse` is used on it.
pub extern pure fn json_try_parse(s: Str) -> Result[Any, Str]
  = @py {
    try:
        return Ok(json_parse(s))
    except Exception as e:
        return Err(str(e))
  }
  = @ts {
    // json_parse throws a SyntaxError on invalid input; catch it and route the
    // message into the Err channel. The Ok value is exactly json_parse's, so
    // the success path is byte-identical to the raising parse.
    try {
      return { kind: "Ok", value: json_parse(s) };
    } catch (e) {
      return { kind: "Err", value: e instanceof Error ? e.message : String(e) };
    }
  }
