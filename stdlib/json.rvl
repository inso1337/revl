// The revl stdlib JSON module (FR-3, docs/stdlib-json.md).
//
// Real tool calls carry structured args (DSH tools take JSON); before this
// module the harness's mock wire protocol had to be flattened to
// `TOOL_CALL name arg1 arg2` and parsed by hand. These externs give a
// component the JSON story the harness needs, scoped to the value types
// revl already carries (Str/Int/Bool/Float/List/Opt/records): `parse` turns
// a Str into a revl value (`Any` — the wildcard the type algebra uses for
// values whose static type only the runtime knows), `stringify` turns one
// back into a Str, and `try_parse` is the TOTAL (never-raising) parse that
// returns a `Result[Any, Str]` so a JSONL stream can be walked tolerantly in
// pure revl (item 362) — see `json_try_parse` below.
//
// Each tier's implementation is the `@<backend>` body beside the signature
// (the extern-body mechanism, docs/syntax-2.0.md §extern). Import with a
// named `use`:
//
//     use "stdlib/json.rvl" { json_parse, json_stringify }
//
// Tier status (see docs/stdlib-json.md for the full table and the path to
// the remaining tiers):
//   * py — `json.loads` / `json.dumps(…, separators=(",",":"),
//     ensure_ascii=False)` for the canonical compact form; executed by the
//     test suite.
//   * ts — a number-preserving parse (a JSON integer literal decodes to a JS
//     `bigint` = revl `Int`, a float to a JS `number` = revl `Float`, item 311)
//     / `JSON.stringify` with a bigint replacer (item 281); emitted by the test
//     suite. Both directions keep full i64 precision, matching the py tier.
//   * rs — `Any` erases to `cordis::Value`; the @rs body boxes a parsed
//     `serde_json::Value` into it and recovers it to re-encode (serde_json
//     is already pinned in the emitted crate). A structured document
//     survives `stringify∘parse`; a parsed value flowing into a typed
//     binding for field access is still the erased-Value boundary, so the
//     harness reads it back through this round-trip, not `tc.name` (item 140).
//   * java — where a provider's Jackson/Gson plugs in; no JDK JSON API, so
//     none until a provider is on the `javac` classpath.
//   * go — `Any` erases to Go's `any`; the @go body reaches `encoding/json`
//     through `//revl:import` directives the emitter hoists into the module's
//     import block (item 140). json_stringify encodes with
//     `SetEscapeHTML(false)` for the canonical form (item 385); see the go
//     record caveat below.
//   * wasm — the substrate value model (Int/Bool/Str/List) cannot hold
//     Float/Map/records, so a JSON value has no representation there.
//
// The `Any` return is what makes `parse` usable: it flows into any typed
// position (`let tc: ToolCall = json_parse(s)`), which is how a harness
// recovers a record of tool args from a wire string.
//
// ── CANONICAL FORM: json_stringify is byte-identical across tiers (item 385) ──
//
// json_stringify is a `pure` fn, so revl's cross-tier determinism guarantee
// (docs/syntax-2.0.md §3.4: "no backend can diverge") requires the SAME BYTES
// on every tier for the same value. It once did not: py emitted
// `{"k": "v", "n": 1}` (Python's default `json.dumps` inserts `", "`/`": "`)
// where ts/go emitted the compact `{"k":"v","n":1}`. Each tier was
// self-consistent, so both tiers' tests passed — the drift only bit CROSS-TIER
// (hashing a record, byte-comparing a ledger, a cassette transcript, a
// signature over emitted JSON). The stated contract now, enforced by
// tests/test_json_cross_tier_bytes.py (py + ts + go against one expected):
//
//   * COMPACT — no space after `:` or `,`  (ts `JSON.stringify` default; go;
//     py `separators=(",", ":")`).
//   * NON-ASCII stays RAW UTF-8  (py `ensure_ascii=False`; ts; go). `<`, `>`,
//     `&` also stay raw (go's default `json.Marshal` HTML-escapes them, so the
//     @go body uses an Encoder with `SetEscapeHTML(false)`).
//   * KEY ORDER is record-declaration / insertion order (py dict, ts object).
//   * booleans/null spelled `true`/`false`/`null`; ints exact incl. > 2^53.
//   * FLOATS: values that share a decimal form across Python and JS (e.g. 1.5,
//     -0.25) are byte-identical; a WHOLE-NUMBER float (1.0 vs 1), -0.0, or an
//     extreme-exponent float can still format differently between the two
//     runtimes — canonicalize integral quantities as `Int`, not `Float`.
//   * A NON-FINITE Float (inf/-inf/nan) is REFUSED, never encoded (item 481).
//     It is a reachable VALUE, not exotic input — `/` is IEEE true division on
//     every tier (docs/arithmetic.md), so `1.0/0.0` is inf, and the py
//     emitter's `_revl_div` manufactures exactly that so py matches the rest.
//     It has no JSON spelling (RFC 8259 §6 has no NaN/Infinity token), and the
//     tiers disagreed four ways: py's default `allow_nan=True` emitted the
//     bare tokens `Infinity`/`NaN` (INVALID JSON), ts `JSON.stringify`
//     silently substituted `null`, rs mapped it to `null` via
//     `serde_json::Value::from`, and go discarded `Encoder.Encode`'s error and
//     returned the EMPTY STRING — a signature over nothing. All four now
//     refuse (py `allow_nan=False`; the ts replacer throws; the @go body
//     panics on `Encode`'s error; the rust emitter boxes a Float through
//     `serde_json::Number::from_f64`, which is `None` for a non-finite input,
//     instead of the silent `From<f64>` mapping). This is the same policy the
//     frontend already applies to a non-finite Float LITERAL (item 312) — the
//     literal was refused while the runtime-computed value was not, which is
//     why the divergence survived. On the PARSE side the same constants are
//     refused and only py needed changing: serde_json and Go's encoding/json
//     are strict, and the @ts parser has no `N`/`I` production, so py's
//     `json.loads` (`parse_constant` unset by default, so `json_parse("NaN")`
//     returned a float) was the sole exception; its body now passes a
//     `parse_constant` that raises.
//   * GO RECORD CAVEAT — a SEPARATE, deeper defect that this @go body cannot
//     fix: a revl record lowers to a Go struct whose fields are UNEXPORTED
//     (lowercase) with no `json:` tags, so `encoding/json` drops them and a
//     record stringifies to `{}` on go. go is canonical for scalars, strings
//     and lists; the record `{}` behavior is pinned by
//     test_go_record_is_the_known_separate_defect until the go emitter is
//     taught to export + tag record fields (its own roadmap item).

pub extern pure fn json_parse(s: Str) -> Any
  = @py {
    # RFC 8259 section 6 has no `NaN`/`Infinity`/`-Infinity` token, and every
    # other tier's decoder is strict: `serde_json::from_str` and Go's
    # `encoding/json` both reject them, and this file's @ts parser never
    # admits them (no `N`/`I` production). Python's `json` is the sole
    # exception — `parse_constant` is unset by default, so `json.loads("NaN")`
    # returns a float where the other tiers return a decode error. A `pure`
    # fn must not diverge per tier (docs/syntax-2.0.md §3.4), so refuse the
    # constants here rather than accept a document three tiers reject.
    import json
    def _revl_reject_constant(name):
        raise ValueError("json_parse: " + name +
                         " is not valid JSON (RFC 8259 section 6)")
    return json.loads(s, parse_constant=_revl_reject_constant)
  }
  = @ts {
    // The builtin JSON.parse decodes every JSON number to a JS number (f64),
    // so an integer past 2^53 comes back rounded - a silent precision loss on
    // the ts tier that the py tier (json.loads to a Python int) does not have
    // (item 311). A JSON.parse reviver cannot recover it: the reviver is handed
    // the already-rounded number. So this is a number-preserving recursive
    // descent parse that decodes a JSON INTEGER literal (no dot, no exponent)
    // to a JS bigint - revl Int, full i64 precision - and a JSON float (a
    // literal carrying a dot, e, or E) to a JS number - revl Float - matching
    // the py tier. Strings, arrays, objects, true, false and null decode as
    // JSON defines. A bigint round-trips back to a bare JSON number through
    // json_stringify's replacer, so parse and stringify agree with py both ways.
    let i = 0;
    const n = s.length;
    function ws(): void {
      while (i < n) {
        const c = s.charCodeAt(i);
        if (c === 32 || c === 9 || c === 10 || c === 13) i++; else break;
      }
    }
    function fail(m: string): never {
      throw new SyntaxError("json_parse: " + m + " at index " + i);
    }
    function digits(): void {
      while (i < n) { const c = s.charCodeAt(i); if (c >= 48 && c <= 57) i++; else break; }
    }
    function num(): number | bigint {
      const start = i;
      if (s[i] === "-") i++;
      digits();
      let float = false;
      if (s[i] === ".") { float = true; i++; digits(); }
      if (s[i] === "e" || s[i] === "E") { float = true; i++; if (s[i] === "+" || s[i] === "-") i++; digits(); }
      const tok = s.slice(start, i);
      return float ? Number(tok) : BigInt(tok);
    }
    function str(): string {
      i++;
      let out = "";
      while (i < n) {
        const c = s[i++];
        if (c === "\"") return out;
        if (c === "\\") {
          const e = s[i++];
          if (e === "\"" || e === "\\" || e === "/") out += e;
          else if (e === "b") out += "\b";
          else if (e === "f") out += "\f";
          else if (e === "n") out += "\n";
          else if (e === "r") out += "\r";
          else if (e === "t") out += "\t";
          else if (e === "u") { out += String.fromCharCode(parseInt(s.slice(i, i + 4), 16)); i += 4; }
          else fail("invalid escape");
        } else out += c;
      }
      return fail("unterminated string");
    }
    function value(): any {
      ws();
      const c = s[i];
      if (c === "{") {
        i++; ws();
        const o: { [k: string]: any } = {};
        if (s[i] === "}") { i++; return o; }
        for (;;) {
          ws();
          if (s[i] !== "\"") fail("expected a string key");
          const k = str(); ws();
          if (s[i] !== ":") fail("expected a colon");
          i++;
          const kv = value(); ws();
          // A JSON key of "__proto__" must land as OWN DATA, not invoke the
          // Object.prototype setter — a plain `o[k] = kv` there would set the
          // parsed object's PROTOTYPE (prototype pollution, sibling of #319).
          // `defineProperty` stores it as an ordinary own property, so it reads
          // back as data (the own property shadows the inherited accessor),
          // matching the py tier where `json.loads` keeps "__proto__" a normal
          // dict key. "constructor"/"prototype" assigned with `o[k]=` are
          // harmless own properties (they shadow, they do not mutate
          // Object.prototype); the READ side (stdlib/value.rvl) reads OWN keys
          // only, so an inherited "constructor"/"toString" is never mistaken
          // for a field the document carries.
          if (k === "__proto__") {
            Object.defineProperty(o, k, { value: kv, writable: true, enumerable: true, configurable: true });
          } else {
            o[k] = kv;
          }
          if (s[i] === ",") { i++; continue; }
          if (s[i] === "}") { i++; return o; }
          fail("expected a comma or closing brace");
        }
      }
      if (c === "[") {
        i++; ws();
        const a: any[] = [];
        if (s[i] === "]") { i++; return a; }
        for (;;) {
          a.push(value()); ws();
          if (s[i] === ",") { i++; continue; }
          if (s[i] === "]") { i++; return a; }
          fail("expected a comma or closing bracket");
        }
      }
      if (c === "\"") return str();
      if (c === "t") { if (s.slice(i, i + 4) === "true") { i += 4; return true; } return fail("invalid literal"); }
      if (c === "f") { if (s.slice(i, i + 5) === "false") { i += 5; return false; } return fail("invalid literal"); }
      if (c === "n") { if (s.slice(i, i + 4) === "null") { i += 4; return null; } return fail("invalid literal"); }
      if (c === "-" || (c >= "0" && c <= "9")) return num();
      return fail("unexpected token");
    }
    const result = value();
    ws();
    if (i < n) fail("unexpected trailing content");
    return result;
  }
  = @rs { Value::new(serde_json::from_str::<serde_json::Value>(&s).unwrap_or(serde_json::Value::Null)) }
  = @go {
    //revl:import encoding/json
    var v any
    _ = json.Unmarshal([]byte(s), &v)
    return v
  }

pub extern pure fn json_stringify(v: Any) -> Str
  = @py {
    # CANONICAL FORM (item 385): compact separators (no space after ':' or
    # ',') + ensure_ascii=False (non-ASCII stays raw UTF-8). The py default
    # json.dumps(v) inserts ', '/': ' and escapes non-ASCII, both of which
    # diverge from ts/go byte-for-byte. See the canonical-form contract in
    # this file's header. (Comments here are '#': a @py body is real Python.)
    # allow_nan=False (item 481): a non-finite Float is a reachable VALUE, not
    # a throw — `/` is IEEE true division, so `1.0/0.0` is `inf` on every tier
    # (docs/arithmetic.md; the py emitter's `_revl_div` manufactures it
    # precisely so py matches the others). It has no JSON spelling: py's
    # default allow_nan=True emits the bare tokens `Infinity`/`NaN`, which are
    # INVALID JSON (RFC 8259 section 6) and which no other tier produces. The
    # frontend already refuses a non-finite Float LITERAL (item 312); refuse
    # the runtime-computed one here too, instead of emitting a document that
    # only a lenient parser accepts and no other tier would have emitted.
    import json
    return json.dumps(v, separators=(",", ":"), ensure_ascii=False,
                      allow_nan=False)
  }
  = @ts {
    // `Int` maps to JS `bigint` (TYPE_MAP), which `JSON.stringify` refuses
    // ("Do not know how to serialize a BigInt"). A replacer parks each bigint
    // behind a quoted sentinel carrying its exact decimal digits, then the
    // quotes are stripped so those digits land as a BARE JSON number - full
    // i64 precision (a plain Number() cast would lose it past 2^53), matching
    // the py tier `json.dumps`. With no bigint present the fast path returns
    // the builtin result unchanged.
    const marks: string[] = [];
    const wire = JSON.stringify(v, (_k, x) => {
      // JSON.stringify maps a non-finite number to `null` — a SILENT
      // substitution of a different value, not a refusal. A non-finite Float
      // is reachable (`/` is IEEE true division: `1.0/0.0` is `inf` on every
      // tier, docs/arithmetic.md) and has no JSON spelling (RFC 8259 section
      // 6). Refuse, matching the py @py body's `allow_nan=False` and the
      // frontend's existing refusal of a non-finite Float literal (item 312).
      if (typeof x === "number" && !Number.isFinite(x)) {
        throw new TypeError("json_stringify: a non-finite Float has no JSON representation (RFC 8259 section 6)");
      }
      return typeof x === "bigint" ? "@@revlBigInt:" + (marks.push(x.toString()) - 1) + "@@" : x;
    });
    return marks.length === 0 ? wire : wire.replace(/"@@revlBigInt:(\d+)@@"/g, (_m, i) => marks[Number(i)]);
  }
  = @rs { v.downcast::<serde_json::Value>().map(|j| serde_json::to_string(&*j).unwrap_or_default()).unwrap_or_default() }
  = @go {
    //revl:import encoding/json
    //revl:import bytes
    // CANONICAL FORM (item 385): compact, and — unlike the default
    // `json.Marshal`, which HTML-escapes `<`, `>`, `&` to `<>&`
    // — `SetEscapeHTML(false)` so those bytes stay raw, matching py
    // (`ensure_ascii=False`) and ts (`JSON.stringify`). `Encoder.Encode`
    // appends a trailing '\n'; trim it so the bytes match the other tiers.
    // (Go map keys marshal in ascending byte order; a scalar/list/string
    // value is byte-identical to py/ts. See the canonical-form contract in
    // this file's header for the go record caveat.)
    var buf bytes.Buffer
    enc := json.NewEncoder(&buf)
    enc.SetEscapeHTML(false)
    // item 481: `Encode` REFUSES a non-finite Float ("unsupported value:
    // +Inf") — `encoding/json` is strict JSON. Discarding that error returned
    // the empty string, so a `pure` fn handed an `inf` produced bytes no
    // other tier produced (py emitted invalid JSON, ts/rs emitted `null`).
    // Refuse loudly instead: a non-finite Float is reachable (`/` is IEEE
    // true division, docs/arithmetic.md) and has no JSON spelling.
    if err := enc.Encode(v); err != nil {
        panic("json_stringify: " + err.Error())
    }
    return string(bytes.TrimRight(buf.Bytes(), "\n"))
  }

// A TOTAL (never-raising) parse: the same decode as `json_parse`, but the
// parse error is returned as the `Err` channel of a `Result[Any, Str]`
// instead of raised (item 362). `Ok(v)` carries the identical value a
// successful `json_parse(s)` produces — this body *calls* `json_parse`, so
// the success path is byte-for-byte the raising parse; only the failure path
// is new. revl has no try/catch (docs/syntax-2.0.md §3.2: "failure is
// `Result` in pure code"), so this is what lets a component walk a JSONL
// stream tolerantly IN REVL — `match json_try_parse(line) { Ok(v) => …,
// Err(_) => skip }` — with no classified host extern for the parse itself:
//
//     use "stdlib/json.rvl" { json_try_parse }
//     match json_try_parse(line) {
//       Ok(rec) => keep(rec.field),   // typed access off the parsed record
//       Err(_)  => skip,              // a malformed line is skipped, not fatal
//     }
//
// Tiers: py and ts — the two tiers where `json_parse` RAISES on invalid input
// and so need the tolerant wrapper. The rs and go `json_parse` bodies are
// already total (they decode a bad document to `null` rather than raising), so
// a distinct tolerant primitive would carry no information there; a tier
// without a body refuses honestly if `json_try_parse` is used on it.
pub extern pure fn json_try_parse(s: Str) -> Result[Any, Str]
  = @py {
    try:
        return Ok(json_parse(s))
    except Exception as e:
        return Err(str(e))
  }
  = @ts {
    // json_parse throws a SyntaxError on invalid input; catch it and route the
    // message into the Err channel. The Ok value is exactly json_parse's, so
    // the success path is byte-identical to the raising parse.
    try {
      return { kind: "Ok", value: json_parse(s) };
    } catch (e) {
      return { kind: "Err", value: e instanceof Error ? e.message : String(e) };
    }
  }
  = @rs {
    // `Result[Any, Str]` is native `Result<Value, String>`. The Ok payload is
    // the same boxed `serde_json::Value` json_parse produces; the decode error
    // is stringified into the Err channel instead of collapsed to Null.
    match serde_json::from_str::<serde_json::Value>(&s) {
        Ok(j) => Ok(Value::new(j)),
        Err(e) => Err(e.to_string()),
    }
  }
  = @go {
    //revl:import encoding/json
    // `Result[Any, Str]` lowers to the two-value struct `RevlResult[any,
    // string]` (item 434 (d)): `Ok` discriminates, `OkV` carries the Ok payload
    // and `ErrV` the Err payload. A decode error routes into the Err channel
    // rather than being swallowed to nil as json_parse's @go body does.
    var v any
    if err := json.Unmarshal([]byte(s), &v); err != nil {
        return RevlResult[any, string]{ErrV: err.Error()}
    }
    return RevlResult[any, string]{OkV: v, Ok: true}
  }
