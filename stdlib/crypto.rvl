// The revl stdlib CRYPTO module — a classified crypto PRIMITIVE kit.
// Roadmap item 272 (lighthouse-workload finding), the item-244 pattern
// (docs/stdlib-fs.rvl-style classified-extern module), effect classification
// per docs/design/243-witnessed-externs.md. Module doc docs/stdlib-2.0.md.
//
// ---------------------------------------------------------------- what this is
// Three independent components in the lighthouse workload hand-rolled the SAME
// crypto inside `@py`/`@ts` extern bodies within one wave — a constant-time
// string compare (a token gate), an HMAC-SHA256 encrypt-then-MAC construction
// (a settings store), and two HMAC webhook-signature schemes (inbound
// verification). Three witnesses, all security-load-bearing, none sharing code.
// This module is that shared kit, ONCE — a PRIMITIVE kit, deliberately NOT a
// framework. It ships the four irreducible operations those sites re-derived
// and stops there; it does not ship an AEAD, a KDF, a key type, a nonce
// manager, or a "secure envelope" object. A site composes the primitives it
// needs (encrypt-then-MAC is `hmac_sha256` over the ciphertext + a `ct_equal`
// on verify), exactly as the hand-rolled sites already did — only now over one
// audited implementation instead of three.
//
// ------------------------------------------------------------ the four
//   sha256(data)        -> Str   hex SHA-256 of the UTF-8 bytes of `data`
//   hmac_sha256(key, d) -> Str   hex HMAC-SHA256 (RFC 2104) over UTF-8 bytes
//   ct_equal(a, b)      -> Bool  constant-time equality of two strings
//   random_token(n)     -> Str   2n hex chars from n cryptographic random bytes
//
// `sha256` / `hmac_sha256` / `ct_equal` are `pure`: same inputs, same output,
// no observable effect, no entropy, nothing to release or revert. (docs/
// syntax-2.0.md already types the canonical `extern pure fn sha256`.)
// `random_token` is NOT pure — its classification is a design decision, below.
//
// ---------------------------------------------- random_token: why `emission`
// An entropy draw is not `pure` (two calls with the same argument return
// different values — the defining non-property of a pure function). The item
// framed the choice as `acquire`-with-a-trivial-undo vs a dedicated honest
// reading. It is classified `emission`, and here is the same rigor 244 spent on
// its clonefile-preimage decision:
//
//   * `acquire` (bracket / RAII) models a resource you HOLD and must RELEASE:
//     its declared `undo` replays on BOTH clean unload AND abort (docs/design/
//     243-witnessed-externs.md, the acquire column). A token draw holds
//     nothing — there is no handle, no lease, no lock, no descriptor. The only
//     `undo` one could write is a no-op, and a no-op undo is a LIE in the shape
//     of a contract: it tells the teardown accumulator "this effect was cleanly
//     reverted on unload" when nothing was reverted and nothing needed to be,
//     and it pays for a disposer entry on every single draw. That is precisely
//     the dishonesty fs.rvl's caveats warn against ("reversal does not undo
//     OBSERVATION"), except here there is not even a byte to pretend to restore.
//   * `witnessed` (244's answer for an fs write) is earned by a SNAPSHOT: a
//     preimage makes the inverse REAL, so the mutation is revertible by
//     construction. The analogous question here — "can we snapshot / invert an
//     entropy draw?" — answers NO by construction: there is no preimage of an
//     unpredictable draw, and no inverse can un-observe a secret that has been
//     minted into the world and possibly already used. Where 244 could earn
//     `witnessed`, `random_token` cannot; claiming it would be claiming 244's
//     reversibility with none of 244's snapshot behind it.
//   * `emission` is the honest fourth reading: a non-revertible, capability-
//     accounted boundary crossing. A draw READS external entropy (the host
//     CSPRNG), advancing non-recoverable CSPRNG state and producing a fresh
//     secret — an observable side effect that cannot be taken back. Emission is
//     also the correct POLICY reading: token minting is security-load-bearing
//     and SHOULD be visible to the item-33 policy gate / audit accounting
//     (counted, rate-limitable), which emission gives for free — its capability
//     is its own name (`caps(extern emission fn e) = { e }`, docs/capabilities.md)
//     — and which a `pure` or a fake-`acquire` draw would hide.
//
// So: `extern emission fn random_token`. It admits cleanly (an emission extern
// needs no `undo`/`compensate`), and a plain `fn`/`test`/provider that draws a
// token carries the `random_token` capability outward, honestly.
//
// ------------------------------------------------------------ honest caveats
// * These are PRIMITIVES, not a protocol. `hmac_sha256` is a MAC, not a
//   password hash (no work factor) and not a KDF — do not stretch a password
//   with it. Encrypt-then-MAC needs a CIPHER this kit does not ship; the kit
//   supplies the MAC half and the `ct_equal` verify, not the confidentiality.
// * `ct_equal` is constant-time in its COMPARISON: it always scans the full
//   width and folds every byte difference, so it leaks neither the first
//   differing position nor (via early exit) the match. It does compare over
//   UTF-8 byte length, so it does not hide the LENGTH of its inputs — MAC tags
//   are fixed-width, so for the intended use (comparing two hex digests) that
//   is not a leak. It is a host-language constant-time effort (`hmac.
//   compare_digest` on py; a full-width fold on ts), not a hardware guarantee.
// * `sha256` / `hmac_sha256` hash the UTF-8 encoding of the input string; both
//   tiers encode identically (Python `str.encode("utf-8")` == JS `TextEncoder`),
//   so the hex digests agree across py and ts (proven in tests/test_crypto_stdlib.py).
//
// ----------------------------------------------------------------- tier status
// py + ts are the exit bar (item 272); other tiers land as they come.
//   * py  — hashlib / hmac / secrets (the reference); executed by the test suite.
//   * ts  — a self-contained pure-JS SHA-256 core (no host import, exactly as
//           stdlib/json.rvl ships a pure-JS parser), `globalThis.crypto.
//           getRandomValues` for the entropy draw (a WHATWG global, synchronous,
//           no import). Verified against Node's own `crypto` and RFC 4231.
//   * rs / go / java / wasm — DEFERRED. Each adds its `@<backend>` body here
//           against that tier's hashing facility.
//
// Import with a named `use`:
//
//     use "stdlib/crypto.rvl" { sha256, hmac_sha256, ct_equal, random_token }

// ------------------------------------------------------------------ sha256
// Hex-encoded SHA-256 of the UTF-8 bytes of `data`. Lower-case hex, 64 chars.
// Pure: a hash is a total function of its input, with no effect and no entropy.
pub extern pure fn sha256(data: Str) -> Str
  = @py {
    import hashlib
    return hashlib.sha256(data.encode("utf-8")).hexdigest()
  }
  = @ts {
    // A self-contained pure-JS SHA-256 (no host import), on the UTF-8 bytes of
    // `data`. TextEncoder is a WHATWG global on every ts host. Verified against
    // node:crypto and the NIST vectors sha256("") / sha256("abc").
    const K = new Uint32Array([
      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
      0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
      0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
      0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
      0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]);
    const bytes = new TextEncoder().encode(data);
    const bitLen = bytes.length * 8;
    const withOne = bytes.length + 1;
    const total = withOne + ((56 - (withOne % 64) + 64) % 64) + 8;
    const msg = new Uint8Array(total);
    msg.set(bytes);
    msg[bytes.length] = 0x80;
    const hi = Math.floor(bitLen / 0x100000000);
    const lo = bitLen >>> 0;
    msg[total - 8] = (hi >>> 24) & 0xff; msg[total - 7] = (hi >>> 16) & 0xff;
    msg[total - 6] = (hi >>> 8) & 0xff;  msg[total - 5] = hi & 0xff;
    msg[total - 4] = (lo >>> 24) & 0xff; msg[total - 3] = (lo >>> 16) & 0xff;
    msg[total - 2] = (lo >>> 8) & 0xff;  msg[total - 1] = lo & 0xff;
    let h0 = 0x6a09e667, h1 = 0xbb67ae85, h2 = 0x3c6ef372, h3 = 0xa54ff53a;
    let h4 = 0x510e527f, h5 = 0x9b05688c, h6 = 0x1f83d9ab, h7 = 0x5be0cd19;
    const w = new Uint32Array(64);
    const rotr = (x: number, n: number) => (x >>> n) | (x << (32 - n));
    for (let off = 0; off < total; off += 64) {
      for (let i = 0; i < 16; i++) {
        w[i] = ((msg[off + i * 4] << 24) | (msg[off + i * 4 + 1] << 16) |
                (msg[off + i * 4 + 2] << 8) | (msg[off + i * 4 + 3])) >>> 0;
      }
      for (let i = 16; i < 64; i++) {
        const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
        const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
      }
      let a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, h = h7;
      for (let i = 0; i < 64; i++) {
        const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        const ch = (e & f) ^ (~e & g);
        const t1 = (h + S1 + ch + K[i] + w[i]) >>> 0;
        const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const t2 = (S0 + maj) >>> 0;
        h = g; g = f; f = e; e = (d + t1) >>> 0; d = c; c = b; b = a; a = (t1 + t2) >>> 0;
      }
      h0 = (h0 + a) >>> 0; h1 = (h1 + b) >>> 0; h2 = (h2 + c) >>> 0; h3 = (h3 + d) >>> 0;
      h4 = (h4 + e) >>> 0; h5 = (h5 + f) >>> 0; h6 = (h6 + g) >>> 0; h7 = (h7 + h) >>> 0;
    }
    const words = [h0, h1, h2, h3, h4, h5, h6, h7];
    let hex = "";
    for (const x of words) hex += (x >>> 0).toString(16).padStart(8, "0");
    return hex;
  }

// ---------------------------------------------------------------- hmac_sha256
// Hex-encoded HMAC-SHA256 (RFC 2104) with `key` over `data`, both UTF-8. The
// MAC the webhook-signature and encrypt-then-MAC sites hand-rolled three ways.
// Pure: deterministic in (key, data), no effect, no entropy.
pub extern pure fn hmac_sha256(key: Str, data: Str) -> Str
  = @py {
    import hashlib, hmac
    return hmac.new(key.encode("utf-8"), data.encode("utf-8"), hashlib.sha256).hexdigest()
  }
  = @ts {
    // HMAC-SHA256 over a self-contained BYTE-level SHA-256 core: the pad and
    // message are concatenated as raw bytes (never round-tripped through a
    // string, which would re-encode pad bytes >= 0x80 as multibyte UTF-8 and
    // corrupt the MAC). Verified against node:crypto and RFC 4231 test case 2.
    const K = new Uint32Array([
      0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
      0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
      0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
      0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
      0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
      0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
      0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
      0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]);
    const rotr = (x: number, n: number) => (x >>> n) | (x << (32 - n));
    const core = (bytes: Uint8Array): Uint8Array => {
      const bitLen = bytes.length * 8;
      const withOne = bytes.length + 1;
      const total = withOne + ((56 - (withOne % 64) + 64) % 64) + 8;
      const msg = new Uint8Array(total);
      msg.set(bytes);
      msg[bytes.length] = 0x80;
      const hi = Math.floor(bitLen / 0x100000000);
      const lo = bitLen >>> 0;
      msg[total - 8] = (hi >>> 24) & 0xff; msg[total - 7] = (hi >>> 16) & 0xff;
      msg[total - 6] = (hi >>> 8) & 0xff;  msg[total - 5] = hi & 0xff;
      msg[total - 4] = (lo >>> 24) & 0xff; msg[total - 3] = (lo >>> 16) & 0xff;
      msg[total - 2] = (lo >>> 8) & 0xff;  msg[total - 1] = lo & 0xff;
      let h0 = 0x6a09e667, h1 = 0xbb67ae85, h2 = 0x3c6ef372, h3 = 0xa54ff53a;
      let h4 = 0x510e527f, h5 = 0x9b05688c, h6 = 0x1f83d9ab, h7 = 0x5be0cd19;
      const w = new Uint32Array(64);
      for (let off = 0; off < total; off += 64) {
        for (let i = 0; i < 16; i++) {
          w[i] = ((msg[off + i * 4] << 24) | (msg[off + i * 4 + 1] << 16) |
                  (msg[off + i * 4 + 2] << 8) | (msg[off + i * 4 + 3])) >>> 0;
        }
        for (let i = 16; i < 64; i++) {
          const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
          const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
          w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
        }
        let a = h0, b = h1, c = h2, d = h3, e = h4, f = h5, g = h6, h = h7;
        for (let i = 0; i < 64; i++) {
          const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
          const ch = (e & f) ^ (~e & g);
          const t1 = (h + S1 + ch + K[i] + w[i]) >>> 0;
          const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
          const maj = (a & b) ^ (a & c) ^ (b & c);
          const t2 = (S0 + maj) >>> 0;
          h = g; g = f; f = e; e = (d + t1) >>> 0; d = c; c = b; b = a; a = (t1 + t2) >>> 0;
        }
        h0 = (h0 + a) >>> 0; h1 = (h1 + b) >>> 0; h2 = (h2 + c) >>> 0; h3 = (h3 + d) >>> 0;
        h4 = (h4 + e) >>> 0; h5 = (h5 + f) >>> 0; h6 = (h6 + g) >>> 0; h7 = (h7 + h) >>> 0;
      }
      const out = new Uint8Array(32);
      const words = [h0, h1, h2, h3, h4, h5, h6, h7];
      for (let i = 0; i < 8; i++) {
        out[i * 4] = (words[i] >>> 24) & 0xff; out[i * 4 + 1] = (words[i] >>> 16) & 0xff;
        out[i * 4 + 2] = (words[i] >>> 8) & 0xff; out[i * 4 + 3] = words[i] & 0xff;
      }
      return out;
    };
    const enc = new TextEncoder();
    let k = enc.encode(key);
    if (k.length > 64) k = core(k);          // long keys are hashed to 32 bytes
    const dataBytes = enc.encode(data);
    const ipad = new Uint8Array(64 + dataBytes.length);
    const opad = new Uint8Array(64 + 32);
    for (let i = 0; i < 64; i++) {
      const kb = i < k.length ? k[i] : 0;
      ipad[i] = kb ^ 0x36;
      opad[i] = kb ^ 0x5c;
    }
    ipad.set(dataBytes, 64);
    opad.set(core(ipad), 64);
    const digest = core(opad);
    let hex = "";
    for (const x of digest) hex += x.toString(16).padStart(2, "0");
    return hex;
  }

// ------------------------------------------------------------------ ct_equal
// Constant-time equality of two strings — the token-gate compare, once. Always
// scans the full width and folds every byte difference, so it leaks neither the
// first differing position nor the match via an early exit. Compares over UTF-8
// bytes (see the length caveat in the header).
pub extern pure fn ct_equal(a: Str, b: Str) -> Bool
  = @py {
    import hmac
    return hmac.compare_digest(a.encode("utf-8"), b.encode("utf-8"))
  }
  = @ts {
    // Full-width fold: `diff` accumulates the length mismatch and every byte
    // XOR, and is inspected once at the end — no data-dependent branch or
    // early return.
    const enc = new TextEncoder();
    const ab = enc.encode(a), bb = enc.encode(b);
    let diff = ab.length ^ bb.length;
    const n = Math.max(ab.length, bb.length);
    for (let i = 0; i < n; i++) {
      diff |= (i < ab.length ? ab[i] : 0) ^ (i < bb.length ? bb[i] : 0);
    }
    return diff === 0;
  }

// -------------------------------------------------------------- random_token
// `n` cryptographic random bytes as 2n lower-case hex chars (Python
// `secrets.token_hex(n)`). `emission` — an entropy draw is a non-revertible
// boundary crossing that reads the host CSPRNG (see the header's classification
// rationale). `n == 0` yields `""`.
pub extern emission fn random_token(n: Int) -> Str
  = @py {
    import secrets
    return secrets.token_hex(n)
  }
  = @ts {
    // getRandomValues is a synchronous WHATWG global (browser + modern Node),
    // so the draw needs no host import and no `await`.
    const buf = new Uint8Array(n);
    globalThis.crypto.getRandomValues(buf);
    let hex = "";
    for (const x of buf) hex += x.toString(16).padStart(2, "0");
    return hex;
  }
