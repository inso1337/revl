// The revl stdlib VALUE module (roadmap item 180, docs/stdlib-value.md).
//
// `Value` is the erased-dynamic type: the runtime union of every
// host-representable shape a revl program can hold — record, list, scalar
// (Str/Int/Float/Bool), or null. It is the NAMED, reusable generalisation of
// the `Any` boundary stdlib/json.rvl already documents: `json_parse` hands back
// an `Any` whose static type only the runtime knows, and before this module the
// only way to WALK that value in revl was to re-declare a private set of `@py`
// primitive accessors (`g`/`gs`/`alist`/`at`/`child_nodes`/…, as
// selfhost/emit_py.rvl did). Every IR-consuming self-host stage — each Path B
// emitter — re-derived that same bridge. This module IS that bridge, once,
// typed, and reusable: a self-hosted emitter that walks the backend-IR document
// (docs/backend-ir.md) does it in PURE revl by `use`-ing these accessors, with
// no `@py` block of its own.
//
// ------------------------------------------------------------------- totality
// Every accessor is TOTAL: a shape mismatch never crashes. It returns a typed
// default (`""`, `0`, `false`, `[]`, a null `Value`) or an `Opt` `None`, so a
// walk over an untrusted / partially-shaped document cannot fault. This is the
// property that makes the type safe to hand a checker-opaque value: the erased
// value flowed in without proof of shape, and the accessors read it back
// without assuming any.
//
// -------------------------------------------------------------- checker support
// The checker (src/revl/typecheck.py) reserves `Value` as a builtin type and
// makes it compatible with every type in BOTH directions at value-flow
// positions: a concrete Str/Int/List/record flows INTO a `Value` argument
// (boxed to the host's dynamic representation), and a `Value` result flows OUT
// into any typed position. That is what lets `value_str(value_field(node,
// "op"))` type-check without pinning the whole IR as an ADT and without the G8
// "stdlib method on a value of unknown type" refusal.
//
// ----------------------------------------------------------------- tier status
// Each accessor is a `pub extern pure fn` with per-tier `@<backend>` bodies,
// exactly like stdlib/json.rvl. `Value` erases to each host's dynamic
// representation:
//   * py  — the native object graph (dict / list / bool / int / float / str /
//            None); executed by the test suite (tests/test_value_stdlib.py).
//   * ts  — the JS value model (`any`/`unknown`): a record is a plain object, a
//            list a JS array, an Int a `bigint`, a Float a `number`.
//   * rs  — `Value` erases to `cordis::Value` (an `Arc<dyn Any>`), and the boxed
//            concrete type is a `serde_json::Value`, EXACTLY as stdlib/json.rvl
//            already boxes (`json_parse` hands back a `cordis::Value` wrapping a
//            `serde_json::Value`; these accessors walk it and re-box each child
//            the same way). The item 391 / #106 native-tier port toward
//            `compile_to` rust (#98 Stage 4): a self-hosted emitter that reads a
//            json_parse'd backend-IR document now walks it in PURE revl when
//            COMPILED TO RUST, not just to py. `value_keys` / `value_children`
//            over a RECORD read the host map in insertion order, which serde_json
//            preserves only with its `preserve_order` feature — the crate that
//            compiles a `Value`-walking self-host must enable it, the identical
//            requirement stdlib/json.rvl's `json_stringify` canonical key order
//            already imposes (see each body's note). Verified byte-for-byte
//            against the @py outputs in an isolation cargo crate over records,
//            lists, nested shapes, every scalar, and mismatched receivers.
//   * go / java / wasm — DEFERRED to a follow-up. Each needs its `@<backend>`
//            bodies added here against that tier's dynamic value (go `any` with
//            type switches; java a provider's JSON tree; wasm has no
//            Float/Map/record substrate, so — as with json.rvl — a full `Value`
//            has no representation there).
//
// Import with a named `use`:
//
//     use "stdlib/value.rvl" { value_kind, value_field, value_str, value_list }

// ---------------------------------------------------------------- shape tag
// The dynamic discriminant: "record" | "list" | "str" | "int" | "float" |
// "bool" | "null". Total — every host value answers exactly one tag.
pub extern pure fn value_kind(v: Value) -> Str =
  @py {
    if isinstance(v, dict): return "record"
    if isinstance(v, (list, tuple)): return "list"
    if isinstance(v, bool): return "bool"
    if isinstance(v, int): return "int"
    if isinstance(v, float): return "float"
    if isinstance(v, str): return "str"
    return "null"
  }
  = @ts {
    // The ts value model (json.rvl): a revl Int is a JS `bigint`, a Float a JS
    // `number`, a record a plain object, a list a JS array. `null`/`undefined`
    // are both the null tag. Array is checked before the generic object tag.
    if (v === null || v === undefined) return "null";
    if (Array.isArray(v)) return "list";
    if (typeof v === "boolean") return "bool";
    if (typeof v === "bigint") return "int";
    if (typeof v === "number") return "float";
    if (typeof v === "string") return "str";
    if (typeof v === "object") return "record";
    return "null";
  }
  = @rs {
    // The discriminant is the boxed `serde_json::Value`'s variant. serde_json
    // keeps `Bool` a distinct variant, so — unlike the @py body, where `bool`
    // is an `int` subclass and MUST be tested first — no ordering is needed;
    // an integer JSON number is `is_i64`/`is_u64`, a float is neither. A box
    // that is not a `serde_json::Value`, or a `Null`, reads back "null".
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Object(_) => String::from("record"),
            serde_json::Value::Array(_) => String::from("list"),
            serde_json::Value::Bool(_) => String::from("bool"),
            serde_json::Value::Number(n) => {
                if n.is_i64() || n.is_u64() { String::from("int") } else { String::from("float") }
            }
            serde_json::Value::String(_) => String::from("str"),
            serde_json::Value::Null => String::from("null"),
        },
        Err(_) => String::from("null"),
    }
  }

pub extern pure fn value_is_null(v: Value) -> Bool =
  @py { return v is None }
  = @ts { return v === null || v === undefined; }
  = @rs {
    match v.downcast::<serde_json::Value>() {
        Ok(j) => matches!(&*j, serde_json::Value::Null),
        Err(_) => true,
    }
  }

// ------------------------------------------------------- shape discrimination
// The is-object / is-list / is-scalar trio (roadmap item 380). A tolerant JSON
// walk begins by asking the SHAPE of an erased value before it binds anything —
// the harness's tolerant decoders all open with `isinstance(d, dict)`, which
// was inexpressible in-language until now. These are the total, in-language
// spelling of that guard: pure revl over `value_kind`, so they inherit every
// tier that carries `value_kind` (py + ts today) with no per-tier body, and a
// non-matching or null receiver simply reads back `false` rather than faulting.
// Pair `value_is_object` with the total `value_opt` (lookup) / `value_has`
// (has) pair below to read a field only once the shape is known to carry one.
//   * `value_is_object` — a record (a JSON object).
//   * `value_is_list`   — a list (a JSON array).
//   * `value_is_scalar` — a leaf: str, int, float, or bool. NULL is none of the
//     three (it answers all three `false`); test it with `value_is_null`.
pub fn value_is_object(v: Value) -> Bool { return value_kind(v) == "record" }
pub fn value_is_list(v: Value) -> Bool { return value_kind(v) == "list" }
pub fn value_is_scalar(v: Value) -> Bool {
  let k = value_kind(v)
  return k == "str" || k == "int" || k == "float" || k == "bool"
}

// ---------------------------------------------------------------- record access
// A record field as a `Value`. Total: a missing key or a non-record receiver
// yields a null `Value`, so a chain `value_field(value_field(n, "a"), "b")`
// never faults on a shape that lacks the path.
pub extern pure fn value_field(v: Value, name: Str) -> Value =
  @py {
    return v.get(name) if isinstance(v, dict) else None
  }
  = @ts {
    if (v !== null && typeof v === "object" && !Array.isArray(v) && (name in v)) {
      return (v as Record<string, unknown>)[name];
    }
    return null;
  }
  = @rs {
    // A record field as a fresh boxed child; a missing key, or a non-record
    // receiver, boxes `Null`. `serde_json::Value::get(&str)` indexes objects
    // only (an array or scalar receiver yields None), mirroring the @py
    // `isinstance(v, dict)` guard. The child is re-boxed as a `cordis::Value`
    // wrapping a `serde_json::Value`, so a chained walk stays total.
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match j.get(name.as_str()) {
            Some(child) => Value::new(child.clone()),
            None => Value::new(serde_json::Value::Null),
        },
        Err(_) => Value::new(serde_json::Value::Null),
    }
  }

// The same lookup as an `Opt`: `None` for a missing key, a null value, or a
// non-record receiver; otherwise `Some(child)`. Use it where "absent" and
// "present-but-null" must be told apart, or to supply a non-default fallback
// with `??`.
pub extern pure fn value_opt(v: Value, name: Str) -> Opt[Value] =
  @py {
    if isinstance(v, dict):
        return v.get(name)
    return None
  }
  = @ts {
    // Opt is `value | undefined` on the ts tier (json.rvl); an absent key,
    // a present-null value, and a non-record receiver all read back as the
    // Opt's `None` (`undefined`), matching the @py `v.get(name)`.
    if (v !== null && typeof v === "object" && !Array.isArray(v)) {
      const r = (v as Record<string, unknown>)[name];
      return (r === null || r === undefined) ? undefined : r;
    }
    return undefined;
  }
  = @rs {
    // `Opt[Value]` lowers to `Option<cordis::Value>`. `None` for a missing key,
    // a present-null value, or a non-record receiver — matching the @py
    // `v.get(name)`, which returns Python `None` in every one of those cases;
    // otherwise `Some` of the boxed child.
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match j.get(name.as_str()) {
            Some(child) if !child.is_null() => Some(Value::new(child.clone())),
            _ => None,
        },
        Err(_) => None,
    }
  }

// The `dict.get(k, default)` analog (roadmap item 368): read a field if present,
// else the CALLER's default — the total field read that is the missing sibling
// of item 362's total parse. `value_field` already reads with a fixed null-Value
// default and `value_str`/`value_int` exit with a fixed typed default; this is
// the read whose fallback the caller chooses (`value_field_or(o, "url", cfg_url)`
// rather than only `""`). Total: an absent key, a present-null value, or a
// non-record receiver yields `default`, NEVER a raise — on py AND ts identically,
// because it is PURE revl over `value_opt` (no new primitive): a typed field read
// `o.url` on a parsed body lacking `url` faults (a KeyError on py, a silent
// `undefined` on ts); this reads it back tolerantly in-language, so a partial or
// optional-field wire body no longer needs a classified tolerant-read extern.
pub fn value_field_or(v: Value, name: Str, default: Value) -> Value {
    return value_opt(v, name) ?? default
}

// Whether a record carries a key with a non-null value.
pub extern pure fn value_has(v: Value, name: Str) -> Bool =
  @py {
    return isinstance(v, dict) and v.get(name) is not None
  }
  = @ts {
    if (v !== null && typeof v === "object" && !Array.isArray(v)) {
      const r = (v as Record<string, unknown>)[name];
      return r !== null && r !== undefined;
    }
    return false;
  }
  = @rs {
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match j.get(name.as_str()) {
            Some(child) => !child.is_null(),
            None => false,
        },
        Err(_) => false,
    }
  }

// A record's field NAMES, in the host dict's INSERTION order — the order the
// document was built/parsed in, which for the backend-IR records `services` /
// `requires` / `provides` is the order an emitter must walk (the SERVICES
// table, the `inject` list). The KEY-enumeration companion to the value-side
// accessors above: `value_field`/`value_children`/`value_at` reach a record's
// VALUES but never its KEYS, so before this a self-hosted emitter bridged the
// gap with its own private `@py` `record_keys` (selfhost/emit_py.rvl, item 185)
// — every Path B emitter would re-derive it. Pair it with `value_field` for the
// value: `for k in value_keys(v): … value_field(v, k) …` walks a keyed record
// in PURE revl. Total: a non-record receiver (list, scalar, null) yields `[]`,
// never crashes. Ordering contract: exactly `list(d.keys())` on the erased
// host dict — Python dicts preserve insertion order, so keys come back in the
// order they were inserted (NOT sorted; a caller that wants a canonical order
// sorts the result itself).
pub extern pure fn value_keys(v: Value) -> List[Str] =
  @py {
    return list(v.keys()) if isinstance(v, dict) else []
  }
  = @ts {
    return (v !== null && typeof v === "object" && !Array.isArray(v))
      ? Object.keys(v) : [];
  }
  = @rs {
    // Field names in the host map's INSERTION order — exactly `list(d.keys())`
    // on the @py side. serde_json preserves insertion order ONLY with its
    // `preserve_order` feature (backed by an IndexMap); the crate that compiles
    // a `Value`-walking self-host must enable it — the identical requirement
    // stdlib/json.rvl's `json_stringify` already imposes for its canonical key
    // order. A non-record receiver (list, scalar, null) yields `[]`.
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Object(m) => m.keys().cloned().collect(),
            _ => Vec::new(),
        },
        Err(_) => Vec::new(),
    }
  }

// ---------------------------------------------------------------- list access
// The elements of a list, each a `Value`. Total: a non-list receiver yields `[]`.
pub extern pure fn value_list(v: Value) -> List[Value] =
  @py {
    return list(v) if isinstance(v, (list, tuple)) else []
  }
  = @ts {
    return Array.isArray(v) ? [...v] : [];
  }
  = @rs {
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Array(a) => a.iter().map(|e| Value::new(e.clone())).collect(),
            _ => Vec::new(),
        },
        Err(_) => Vec::new(),
    }
  }

// One list element by index as a `Value`. Total: an out-of-range index or a
// non-list receiver yields a null `Value`.
pub extern pure fn value_at(v: Value, i: Int) -> Value =
  @py {
    if isinstance(v, (list, tuple)) and 0 <= i < len(v):
        return v[i]
    return None
  }
  = @ts {
    // `i` is a revl Int == JS bigint; the array index must be a number.
    const idx = Number(i);
    return (Array.isArray(v) && idx >= 0 && idx < v.length) ? v[idx] : null;
  }
  = @rs {
    // `i` is a revl Int == i64; index a list only, and only in range, else a
    // boxed `Null` (matching the @py out-of-range / non-list default).
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Array(a) if i >= 0 && (i as usize) < a.len() => {
                Value::new(a[i as usize].clone())
            }
            _ => Value::new(serde_json::Value::Null),
        },
        Err(_) => Value::new(serde_json::Value::Null),
    }
  }

// The children of a container — a record's values or a list's elements, `[]`
// for a scalar. The generic recursion driver: a whole-document walk that
// terminates at leaves (this is `child_nodes` in selfhost/emit_py.rvl).
pub extern pure fn value_children(v: Value) -> List[Value] =
  @py {
    if isinstance(v, dict):
        return list(v.values())
    if isinstance(v, (list, tuple)):
        return list(v)
    return []
  }
  = @ts {
    if (Array.isArray(v)) return [...v];
    if (v !== null && typeof v === "object") return Object.values(v);
    return [];
  }
  = @rs {
    // A record's values (in insertion order — same `preserve_order` requirement
    // noted on `value_keys`) or a list's elements; `[]` for a scalar or null.
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Object(m) => m.values().map(|e| Value::new(e.clone())).collect(),
            serde_json::Value::Array(a) => a.iter().map(|e| Value::new(e.clone())).collect(),
            _ => Vec::new(),
        },
        Err(_) => Vec::new(),
    }
  }

// The number of elements (list), fields (record), or characters (str); `0` for
// a scalar or null. Total.
pub extern pure fn value_len(v: Value) -> Int =
  @py {
    if isinstance(v, (list, tuple, dict, str)):
        return len(v)
    return 0
  }
  = @ts {
    // returns a revl Int == JS bigint
    if (typeof v === "string" || Array.isArray(v)) return BigInt(v.length);
    if (v !== null && typeof v === "object") return BigInt(Object.keys(v).length);
    return 0n;
  }
  = @rs {
    // elements (list), fields (record), or CHARACTERS (str: Unicode scalar
    // values via `chars().count()`, matching Python `len(str)` — code points,
    // not UTF-8 bytes); 0 for a scalar/null. Returns a revl Int == i64.
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Array(a) => a.len() as i64,
            serde_json::Value::Object(m) => m.len() as i64,
            serde_json::Value::String(s) => s.chars().count() as i64,
            _ => 0,
        },
        Err(_) => 0,
    }
  }

// ---------------------------------------------------------------- scalar exits
// The checked exits back to concrete types. Each coerces its own shape and
// returns a typed default on any mismatch — never a crash.
pub extern pure fn value_str(v: Value) -> Str =
  @py { return v if isinstance(v, str) else "" }
  = @ts { return typeof v === "string" ? v : ""; }
  = @rs {
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::String(s) => s.clone(),
            _ => String::new(),
        },
        Err(_) => String::new(),
    }
  }
pub extern pure fn value_int(v: Value) -> Int =
  @py { return v if isinstance(v, int) and not isinstance(v, bool) else 0 }
  = @ts {
    // a revl Int is a JS bigint (json.rvl); a bool is never one, so no guard
    return typeof v === "bigint" ? v : 0n;
  }
  = @rs {
    // a revl Int == i64; a JSON integer reads back, everything else (a float,
    // a bool — a distinct serde_json variant, so no bool guard is needed — a
    // string, a container, null, or a non-serde_json box) yields 0. A float
    // like `3.0` is a `Number` but `as_i64()` is None, so it too yields 0,
    // matching the @py `isinstance(v, int)` (a Python float is not an int).
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Number(n) => n.as_i64().unwrap_or(0),
            _ => 0,
        },
        Err(_) => 0,
    }
  }
pub extern pure fn value_bool(v: Value) -> Bool =
  @py { return v if isinstance(v, bool) else False }
  = @ts { return typeof v === "boolean" ? v : false; }
  = @rs {
    match v.downcast::<serde_json::Value>() {
        Ok(j) => match &*j {
            serde_json::Value::Bool(b) => *b,
            _ => false,
        },
        Err(_) => false,
    }
  }
