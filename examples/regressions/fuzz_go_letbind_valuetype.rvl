// Regression (roadmap item 320): a bound `let x = effect <non-host call>` whose
// acquisition returns a VALUE type must be declared by that value type, not as
// `*T`. Before the fix the go bracket codegen always emitted a bound
// acquisition local (and its provide-impl struct field) as `var x *T`, so a
// non-host acquisition returning a value — a plain fn or service-method call —
// failed to compile (`cannot use openHandle() (int64) as *int64`).
//
// Here `openHandle` is an `extern pure fn ... -> Int`: the acquisition is a
// plain fn call kind, NOT a host object or a spawn handle, so `handle` binds
// the returned Int by VALUE. The provide method reads it back, and the
// lifecycle test proves the whole thing loads, serves the value, and reverts.
//
// `openHandle` is `pure`, not `acquire`: item 308 R0 requires an `acquire`
// return to be a nominal opaque handle type (never a bare `Int`), and this
// regression is specifically about a VALUE-typed (`Int`) bracket acquisition.
// A plain-fn (`pure`) acquisition is exactly the "plain fn call returning a
// value type" case the property under test names, so the go value-vs-pointer
// bracket decision is guarded unchanged while satisfying R0.

service Probe {
  fn ping() -> Int
}

extern pure fn closeHandle(h: Int) -> Unit
  = @py { return None }
  = @go {
	return
    }

extern pure fn openHandle() -> Int
  = @py { return 7 }
  = @go {
	return 7
    }

component ValueBracket provides probe: Probe {
  // `handle` binds a VALUE (Int), not a host pointer — item 320.
  let handle = effect openHandle() undo closeHandle(handle)

  provide probe {
    fn ping() = handle
  }
}

lifecycle test "value-typed bracket acquisition loads, serves, and reverts" {
  load ValueBracket
  let v = call probe.ping()
  assert v == 7
  unload ValueBracket
  assert no_residue
}
