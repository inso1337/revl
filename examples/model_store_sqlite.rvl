// The SECOND driver behind examples/model_store.rvl's driver-independent store:
// a real sqlite backing for the SAME `Store` service, so the memory -> sqlite
// swap is a COMPOSITION-TIME CHOICE. Roadmap item 465 (issue #752), design
// docs/design/527-database-persistence-alignment.md.
//
// 527's remaining exit criterion, made concrete: "a driver swap (memory to
// sqlite) requiring no change to model or query code, and an injected-fault
// write reverting residue-free on the new driver." Minato's own shape (drivers
// are separate packages behind ONE API — `memory`, `sqlite`, `postgres` — and
// the app picks one at composition time without touching model or query code):
//
//   * the declared MODEL below (`type Note`, `type Draft`) and the `Store`
//     service surface are BYTE-IDENTICAL to examples/model_store.rvl's. The
//     model never learns which driver stands behind it;
//   * the QUERY CODE in the lifecycle tests — `call store.create(...)`,
//     `call store.get(...)`, `call store.list()` and their assertions — is
//     identical to model_store.rvl's, verbatim. Only the `load` target names a
//     different component (`SqliteStore` vs `MemoryStore`); that IS the swap;
//   * no raw SQL lives in the model or the query code. The SQL is confined to
//     the sqlite driver's `@py` extern bodies — exactly where Minato keeps it,
//     inside the `sqlite` driver package, never in the model.
//
// The driver is backed by a REAL embedded sqlite database (Python's stdlib
// `sqlite3`, an `:memory:` connection) held as an `acquire`d host resource for
// the component's activation. No new host binding is required: the connection
// is opened, its schema created, and closed on teardown through ordinary `@py`
// externs, the same mechanism stdlib/fs.rvl's witnessed externs use.
//
// VALUES are always BOUND parameters (`?` + a tuple); a value never becomes
// statement text. IDENTIFIERS (table and column names) cannot be bound, so the
// driver validates every identifier it names against the DECLARED model before
// it builds the schema from them: an identifier outside the declaration, or
// one that is not a plain SQL name, is refused at open rather than
// interpolated (see `sq_open`).
//
// Every persistence MUTATION is still lowered as a revertible `effect` whose
// inverse is the EXACT CRUD counterpart: `create` (an INSERT) undoes to DELETE;
// `update` (an overwrite) restores the value the row held BEFORE the write;
// `delete` (a DELETE) re-inserts the row it removed. A row written, edited or
// removed during activation therefore reverts in LIFO order on teardown or
// ABORT — residue-free, on the new driver. The `abort` lifecycle tests below
// inject a fault after each kind of write and assert the composition reverts
// with nothing left behind; the file-backed teeth test in the suite observes
// that the inverses actually ran, not merely that teardown reported clean.

// The declared model: one row type, keyed by a store-assigned `id`. Identical
// to examples/model_store.rvl — the model does not change across the swap.
type Note = { id: Str, body: Str }

// What a caller supplies to `create`: the row WITHOUT its key. The store owns
// key assignment (Minato `autoInc`), so the caller never invents an id.
type Draft = { body: Str }

// The persistence service: typed CRUD verbs, no SQL. Identical surface to
// examples/model_store.rvl's `Store`, so consumer query code is unchanged when
// the driver behind it is swapped from memory to sqlite.
service Store {
  fn get(id: Str) -> Opt[Note]
  fn list() -> List[Note]
  emission[store] fn create(draft: Draft) -> Str
  emission[store] fn update(id: Str, draft: Draft) -> Opt[Note]
  emission[store] fn delete(id: Str) -> Opt[Note]
}

// ---------------------------------------------------------------- the driver

// The sqlite driver's host boundary. Every SQL string lives HERE, inside the
// driver's `@py` bodies (Minato keeps SQL inside its `sqlite` driver package,
// never in the model). `sq_open` is an `acquire` extern: it validates the
// declared identifiers, opens the embedded database and returns the live
// connection handle, whose site-declared inverse closes it, so the resource is
// released on teardown.
extern acquire fn sq_open() -> Conn undo sq_close(result) = @py {
    import re
    import sqlite3

    # A bound parameter protects a VALUE. An identifier (a table or column
    # name) cannot be bound, so a driver must validate it against the DECLARED
    # model before it can reach statement text. The declaration below is this
    # driver's model: table `notes` with columns `id`/`body` (the `type Note`
    # fields) and the `seq` table `create` draws keys from. An identifier
    # outside that declaration, or one that is not a plain SQL name, is refused
    # here rather than interpolated.
    declared = {"notes": ("id", "body"), "seq": ("n",)}
    plain = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")

    def ident(name):
        if not plain.match(name):
            raise ValueError("refused table or column identifier: " + repr(name))
        return name

    for table, columns in declared.items():
        for name in (table,) + tuple(columns):
            ident(name)

    conn = sqlite3.connect(":memory:")
    conn.execute("CREATE TABLE " + ident("notes") + " ("
                 + ident("id") + " TEXT PRIMARY KEY, "
                 + ident("body") + " TEXT)")
    conn.execute("CREATE TABLE " + ident("seq") + " ("
                 + ident("n") + " INTEGER PRIMARY KEY AUTOINCREMENT)")
    conn.commit()
    return conn
}

extern pure fn sq_close(conn: Conn) -> Unit = @py {
    conn.close()
    return
}

// Mint the next primary key from a monotonic sqlite sequence (Minato autoInc):
// an AUTOINCREMENT column only ever grows, so an id is never reused even after
// its row is deleted. The tick is deliberately NOT a revertible effect: a
// file-backed store must keep its sequence across activations so a key is never
// reused, while the `:memory:` example still starts at 0 because the connection
// closes. (The memory driver's sequence is activation state and drops with it.)
extern pure fn sq_next_id(conn: Conn) -> Str = @py {
    cur = conn.execute("INSERT INTO seq DEFAULT VALUES")
    conn.commit()
    return "note-" + str(cur.lastrowid - 1)
}

// A typed point read: the row for `id`, or `None`. `Opt[Note]` crosses the host
// boundary as the value itself (Some) or `None`.
extern pure fn sq_get(conn: Conn, id: Str) -> Opt[Note] = @py {
    row = conn.execute("SELECT id, body FROM notes WHERE id = ?", (id,)).fetchone()
    if row is None:
        return None
    return {"id": row[0], "body": row[1]}
}

// The driver-owned listing: a real `SELECT` answers the same `list` verb the
// memory driver folds by hand. Ascending by `id` keeps the order deterministic.
extern pure fn sq_list(conn: Conn) -> List[Note] = @py {
    rows = conn.execute("SELECT id, body FROM notes ORDER BY id").fetchall()
    return [{"id": r[0], "body": r[1]} for r in rows]
}

// The row write and its natural inverse. `sq_insert` is the INSERT; `sq_remove`
// is the DELETE the `create` effect declares as its `undo`.
extern pure fn sq_insert(conn: Conn, id: Str, body: Str) -> Unit = @py {
    conn.execute("INSERT INTO notes (id, body) VALUES (?, ?)", (id, body))
    conn.commit()
    return
}

extern pure fn sq_remove(conn: Conn, id: Str) -> Unit = @py {
    conn.execute("DELETE FROM notes WHERE id = ?", (id,))
    conn.commit()
    return
}

// The typed UPDATE: one row, by key, with the new body. The changed value is a
// BOUND parameter; the statement text carries only the declared identifiers.
extern pure fn sq_update(conn: Conn, id: Str, body: Str) -> Unit = @py {
    conn.execute("UPDATE notes SET body = ? WHERE id = ?", (body, id))
    conn.commit()
    return
}

// Restore a row EXACTLY (insert, or overwrite the row already there): the
// inverse of `update` (put the previous body back) and of `delete` (put the
// removed row back). Its value is bound, never interpolated.
extern pure fn sq_restore(conn: Conn, id: Str, body: Str) -> Unit = @py {
    conn.execute("INSERT OR REPLACE INTO notes (id, body) VALUES (?, ?)", (id, body))
    conn.commit()
    return
}

// The typed DELETE: one row, by key. Its inverse is `sq_restore`, with the
// value the read observed before the delete.
extern pure fn sq_delete(conn: Conn, id: Str) -> Unit = @py {
    conn.execute("DELETE FROM notes WHERE id = ?", (id,))
    conn.commit()
    return
}

// The sqlite driver. It provides the SAME `Store` service `MemoryStore` does,
// so the swap touches neither the model nor consumer query code. The embedded
// connection is acquired for the component's life and closed on teardown.
component SqliteStore provides store: Store {
  let db = effect sq_open() undo sq_close(db)

  provide store {
    fn get(id) = sq_get(db, id)

    fn list() = sq_list(db)

    // The mutation, lowered as a revertible effect: the store MINTS the key
    // from the monotonic sequence, INSERTs the row, and on abort/teardown
    // DELETEs it. `create`'s derived inverse is `remove` — the Minato-natural
    // counterpart — so the write reverts residue-free, and the returned key is
    // the store's, never the caller's. This is the same revertible-effect shape
    // examples/model_store.rvl's memory driver uses; only the backing differs.
    fn create(draft) {
      let id = sq_next_id(db)
      effect sq_insert(db, id, draft.body)
      undo sq_remove(db, id)
      return id
    }

    // UPDATE is an overwrite, so its inverse is the value the row held BEFORE
    // the write, put back by another plain UPDATE (never `sq_remove`, which
    // would drop a row that existed, and never `INSERT OR REPLACE`, which is
    // delete+insert). A missing key is a typed no-op: `None` in, `None` out,
    // and no effect registered.
    fn update(id, draft) {
      let cur = sq_get(db, id)
      if (cur == None) {
        return None
      }
      let old = match cur {
        Some(v) => v,
        None => { id: id, body: "" },
      }
      effect sq_update(db, id, draft.body)
      undo   sq_update(db, id, old.body)
      return Some({ id: id, body: draft.body })
    }

    // DELETE removes the row and carries its prior value as the inverse, so a
    // row removed during activation is re-inserted in LIFO order on
    // teardown/abort. A missing key is a typed no-op and registers no effect.
    fn delete(id) {
      let cur = sq_get(db, id)
      if (cur == None) {
        return None
      }
      let old = match cur {
        Some(v) => v,
        None => { id: id, body: "" },
      }
      effect sq_delete(db, id)
      undo   sq_restore(db, id, old.body)
      return cur
    }
  }
}

// ---------------------------------------------------------------- lifecycle

// The first five assertions below have query bodies IDENTICAL to
// examples/model_store.rvl's; only the `load`/`unload` target changed. That is
// the whole memory -> sqlite swap: the model and the query code do not move.

lifecycle test "a created row is readable under its store-assigned key, and reverts residue-free" {
  load SqliteStore
  let id = call store.create({ body: "first" })
  assert id == "note-0"
  let hit = call store.get(id)
  assert hit == Some({ id: "note-0", body: "first" })
  unload SqliteStore
  assert no_residue
}

lifecycle test "list returns every created row, and keys are never reused" {
  load SqliteStore
  let a = call store.create({ body: "alpha" })
  let b = call store.create({ body: "beta" })
  assert a == "note-0"
  assert b == "note-1"
  let all = call store.list()
  assert all == [{ id: "note-0", body: "alpha" }, { id: "note-1", body: "beta" }]
  unload SqliteStore
  assert no_residue
}

lifecycle test "a reloaded store starts empty" {
  load SqliteStore
  call store.create({ body: "gone" })
  unload SqliteStore
  load SqliteStore
  let stale = call store.get("note-0")
  assert stale == None
  let empty = call store.list()
  assert empty == []
  unload SqliteStore
  assert no_residue
}

lifecycle test "update overwrites the row and delete removes it, and both revert residue-free" {
  load SqliteStore
  let id = call store.create({ body: "first" })
  let edited = call store.update(id, { body: "second" })
  assert edited == Some({ id: "note-0", body: "second" })
  let hit = call store.get(id)
  assert hit == Some({ id: "note-0", body: "second" })
  let removed = call store.delete(id)
  assert removed == Some({ id: "note-0", body: "second" })
  let gone = call store.get(id)
  assert gone == None
  unload SqliteStore
  assert no_residue
}

lifecycle test "update and delete of an absent key are typed no-ops" {
  load SqliteStore
  let edited = call store.update("note-0", { body: "x" })
  assert edited == None
  let removed = call store.delete("note-0")
  assert removed == None
  let all = call store.list()
  assert all == []
  unload SqliteStore
  assert no_residue
}

// The injected fault after each kind of write: a create, an overwrite and a
// delete each register their inverse before the ABORT, so teardown replays
// them LIFO and the composition reverts residue-free on the sqlite driver. The
// same recovery story the memory driver gives, now over a real embedded store.
lifecycle test "an aborted write reverts residue-free on the sqlite driver" {
  load SqliteStore
  call store.create({ body: "doomed" })
  abort
  assert no_residue
}

lifecycle test "an aborted update reverts residue-free on the sqlite driver" {
  load SqliteStore
  let id = call store.create({ body: "first" })
  call store.update(id, { body: "second" })
  abort
  assert no_residue
}

lifecycle test "an aborted delete reverts residue-free on the sqlite driver" {
  load SqliteStore
  let id = call store.create({ body: "kept" })
  call store.delete(id)
  abort
  assert no_residue
}
