// The negative case: `assert no_residue` catching a real leak.
//
// `LeakyDatabase` is accepted by the whole front end, and its bracket is
// sound: the pool's `undo` is `pool.close()`. What leaks is the test: it loads
// the composition and never unloads it, so the provision is still installed
// (R4) and the pool is still open (R1) when `assert no_residue` runs. Nothing
// static can see that; only the lifecycle assertion can.
//
// Until issue #1859 this file leaked through its `undo` instead (it ran
// `pool.query("SELECT 1")` rather than closing the pool). That spelling no
// longer compiles: a host acquisition's `undo` must be its family's release on
// the bound handle, so a wrong host inverse is refused before it can run.
//
// This file is *expected to fail*:
//
//   revl test examples/lifecycle_leak.rvl        # exits 1
//
// tests/test_lifecycle_exec.py asserts that it does.

service Database {
  fn query(sql: Str) -> List[Row]
  emission[db] fn execute(sql: Str) -> Int
}

component LeakyDatabase provides leaky: Database {
  config { url: Str }

  let pool = effect Pool.open(config.url, 4)
             undo   pool.close()

  provide leaky {
    fn query(sql)   = pool.query(sql)
    fn execute(sql) = pool.execute(sql)
  }
}

lifecycle test "a composition left loaded leaves residue" {
  load LeakyDatabase with { url: "postgres://primary:5432/app" }
  call leaky.query("SELECT 1")
  assert no_residue
}
