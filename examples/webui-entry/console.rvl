// webui-entry — the canonical shape for a revl frontend behind a typed boundary
// (roadmap item 459, issue #722; design docs/design/526-webui-asset-alignment.md
// and docs/design/530-webui-entry-surface.md).
//
// THE ANTI-PATTERN THIS REPLACES. The legacy console is ~4,800 lines of
// HTML/CSS/JS carried inside revl source strings, with browser tooling
// extracting the scripts back out. There are no source maps to an original, the
// frontend cannot be type-checked or bundled by normal tooling, and the set of
// server methods the page can call is not stated anywhere.
//
// THE SHAPE. A revl component contributes a frontend by naming EXTERNAL asset
// files and handing them to Cordis WebUI (`ctx.webui.addEntry`, studied in
// design note 526). The binding is one small, real TypeScript module
// (`webui_host.ts`) reached through the reviewed host-ref door
// (`= @ts ref ... from "..."`, item 396/410) — the same door stdlib/fs.rvl uses
// to reach backends/typescript/revl_fs_ts.ts. No JavaScript lives in a revl
// string; the emitted artifact IMPORTS the shim from its file (the ref is
// content-hash-pinned in the IR), and the frontend entry itself
// (`frontend/entry.client.ts`) is a normal Vite/Vue source with source maps.
//
// This is the ENABLING SLICE, not the full close. Two pieces stay architect- or
// app-gated and are recorded in design note 530: making the ambient `ctx.webui`
// binding a first-class declared coeffect (so the entry's RPC surface is an
// enumerable typed contract, not an untyped `data: T`), and the exemplary
// frontend itself, which is item 462's deliverable.
//
// Copy this file the way router.rvl is copied: rename the component, point the
// paths at your own Vite project's dev source, built manifest, and routes.

// The webui contribution boundary. `dev_source` and `prod_manifest` are PATHS to
// external asset files; `routes` are the client route patterns. The body is a
// reference to a real host module, never an inline JS body.
extern emission fn webui_add_entry(
  dev_source: Str,
  prod_manifest: Str,
  routes: List[Str],
) -> Str
    = @ts ref webuiAddEntry from "./webui_host.ts"

// The console component. At activation it registers its frontend entry with
// WebUI, naming external files only. A real console additionally `requires` its
// domain services and publishes reactive state; that typed server-to-client
// contract is design note 530.
component ConsoleUI {
  emit webui_add_entry(
    "./frontend/entry.client.ts",       // dev-mode source (a Vite/Vue module)
    "./dist/.vite/manifest.json",       // built Vite manifest for production
    ["/console"],                       // client route patterns this entry owns
  )
}
