// The exemplary revl web application (roadmap item 462, issue #725, design
// docs/design/525-exemplary-web-app.md). TWO halves, per 525:
//
// * the BORING HALF (slice 1) — a typed notes CRUD service written the obvious
//   way over the `route` clause, the HTTP contract and the model store; and
// * the DIFFERENTIATED HALF (slice 3, below) — ONE hot-swappable, effect-
//   governed service (a pluggable ranking/scoring component) that is proposed,
//   admitted (or refused with retained ownership), swapped in, and on an
//   injected fault reverts residue-free. Its lifecycle states are made
//   OBSERVABLE through the documented service lifecycle contract (item 460,
//   docs/lifecycle-contract.md): serving / cancel-requested vs cancel-completed
//   / owned-after-failure / recovery-resume. This is 525's claim that the
//   complexity is reserved for the guarantees revl uniquely provides.
//
// 525's first claim, made concrete: ORDINARY web development is boring. A small
// typed task/notes CRUD service, written the obvious way over the primitives
// that already exist — nothing here is a differentiator, and nothing here is a
// workaround:
//
//   * typed routes via the `route <method> "<path>"` clause (item 457, PR for
//     #720) over the first-class HTTP contract in stdlib/http.rvl (item 456,
//     #745). One declaration per endpoint; routing, request validation and
//     response serialization are DERIVED from it (docs/design/457-endpoint-one-
//     definition.md), not hand-rolled;
//   * persistence via the model-store pattern (examples/model_store.rvl, item
//     465 / #767): typed CRUD over a declared row type, every mutation a
//     revertible `effect` whose derived inverse is the natural CRUD counterpart,
//     so a row written during activation reverts residue-free on teardown;
//   * status and outcome read through the typed HTTP contract — `Result[T,
//     ApiError]` maps to the wire status by its TYPE (item 456), never from body
//     prose.
//
// 525 discipline (acceptance bar 2): ZERO routing sentinels (`""`/`"::empty::"`)
// and ZERO emitter workarounds in this source. Every place one would have been
// needed is a gap FILED against 456–461, not absorbed here. The authorization
// step (a `Bearer`/`Principal` handshake) is item 457 Slice 2 and the
// differentiated hot-swap half is a later slice of 462; neither is in this file.

use "stdlib/http.rvl" { ApiError, not_found_error }

// ---------------------------------------------------------------- the model

// One declared row type. Query and mutation are typed against it, so a field the
// model does not declare is a front-end type error, not a runtime surprise.
type Note    = { id: Str, title: Str, body: Str }

// The create payload: what a client supplies. The server owns the `id`, so it is
// absent here — a `NewNote` cannot carry one.
type NewNote = { title: Str, body: Str }

// ---------------------------------------------------------------- persistence

// The persistence service, shaped like examples/model_store.rvl: typed CRUD
// verbs over the declared row, no SQL. `get`/`all`/`size` are pure reads;
// `create` is an `emission` (a witnessed mutation) whose provider carries the
// inverse.
service NoteStore {
  fn get(id: Str) -> Opt[Note]
  fn all() -> List[Note]
  fn size() -> Int
  emission fn create(row: Note)
}

// The memory driver. Any other driver (sqlite, postgres) would provide this same
// `NoteStore`, so neither the model nor the HTTP handlers change when the driver
// is swapped (model_store.rvl's composition-time-choice point).
component MemoryStore provides store: NoteStore {
  let rows = effect Map.new() undo rows.drop()

  provide store {
    fn get(id) = rows.get(id)

    fn size() = rows.size()

    // List every row. The host Map exposes `keys()` (ascending canonical order)
    // and `get`, so listing the VALUES is the obvious keys-then-get fold — the
    // same shape stdlib/list.rvl builds lists with. See the filed-gap note in
    // docs/design/525-webapp-slice1-gaps.md (§1): a first-class `values()` verb
    // would make this a one-liner, but its ABSENCE forces no sentinel and no
    // workaround, so the app absorbs the fold rather than papering a hole.
    fn all() {
      var out = []
      for (k of rows.keys()) {
        out = out.push(rows.get(k))
      }
      return out
    }

    // The mutation, lowered as a revertible effect: insert the row, and on
    // abort/teardown remove it. `create`'s derived inverse is `remove` — the
    // model-store-natural counterpart — so the write reverts residue-free.
    fn create(row) {
      effect rows.insert(row.id, row)
      undo   rows.remove(row.id)
    }
  }
}

// ---------------------------------------------------------------- pure helpers

// Take at most `n` rows. A plain pure list fold (the boring, obvious form),
// applied to the optional `limit` query parameter. Kept pure and out of the
// effect stratum so the handler's persistence reads stay the only effects.
fn take(xs: List[Note], n: Int) -> List[Note] {
  var out = []
  var i = 0
  for (x of xs) {
    if (i < n) { out = out.push(x) }
    i = i + 1
  }
  return out
}

// ---------------------------------------------------------------- the endpoints

// One `service` declaration is the whole endpoint surface. Each `route` clause
// names the method and path template; the compiler derives the router, the
// per-parameter request validation and the response serialization from the
// typed signature (item 457). No route carries auth vocabulary — authorization
// is a separate, explicit step (457 Slice 2), and these operations are public
// because their handlers reach no principal-taking service.
service NotesApi {
  route get "/notes/{id}"
  fn get_note(id: Str) -> Result[Note, ApiError]

  route get "/notes"
  fn list_notes(limit: Opt[Int]) -> Result[List[Note], ApiError]

  route post "/notes"
  emission fn create_note(note: NewNote) -> Result[Note, ApiError]
}

// The HTTP component wires the endpoints to the store. Status and outcome come
// from the return TYPE: an `Ok` is 200 (a `Note`/`List[Note]` in the canonical
// encoding), an `Err(ApiError)` is `e.status` with `{code, message}` — no prose.
component NotesHttp requires store: NoteStore provides notes_api: NotesApi {
  provide notes_api {
    // A miss is a typed 404 through `ApiError`, distinct from the routing-level
    // `NotHandled` the router answers for an unmatched path.
    fn get_note(id) {
      return match store.get(id) {
        Some(n) => Ok(n),
        None    => Err(not_found_error("no note with that id")),
      }
    }

    // `limit` absent is the whole list; present, it bounds the result. The bad
    // non-integer `limit` never reaches here — the derived validator rejects it
    // with a 400 naming the field before the handler runs.
    fn list_notes(limit) {
      return match limit {
        Some(n) => Ok(take(store.all(), n)),
        None    => Ok(store.all()),
      }
    }

    // The server owns the id; the client supplied only a `NewNote`. Minting it
    // from the store's row count keeps the id server-side and the payload typed.
    // The `create` emission is revertible in the store, so a faulted activation
    // leaves no row behind.
    fn create_note(note) {
      let id  = "note-" + store.size().to_str()
      let row = { id: id, title: note.title, body: note.body }
      emit store.create(row)
      return Ok(row)
    }
  }
}

// ------------------------------------------- the DIFFERENTIATED half (slice 3)

// 525's second claim: the complexity is reserved for the guarantee revl uniquely
// provides — a live-reconfigurable, effect-governed service that is hot-swapped
// through admission, with VISIBLE admission, cancellation and residue-free
// recovery. One such service, kept small, is enough (525 non-goal: "one clean
// pass over each guarantee beats breadth").
//
// The service: a pluggable RANKING/SCORING component for the notes. It records
// engagement signals (a note is "bumped" when viewed) into effect-created state,
// and SCORES a note from those signals under a strategy. The scoring strategy is
// what gets HOT-SWAPPED at runtime: a `recency` build (each signal weighs 1) is
// replaced by a `weighted` build (each weighs 3) WITHOUT losing the recorded
// signals — the state crosses the swap because the component declares a
// `handoff` (item 53), and admission REFUSES any successor whose declared state
// shape cannot hold the running one rather than silently dropping it.
//
// This is deliberately NOT wired behind the CRUD HTTP surface: its lifecycle is
// observed through the service lifecycle contract's own surface (`Session.state`
// fiber states + `providedKeys`, `teardown_disposition`, the recovery verdict),
// which is exactly where item 460 makes admission / cancellation / recovery
// observable. The full proposed -> admitted -> refused -> cancelled -> owned ->
// resumed walk is driven on the real cordis-py runtime through `Session.swap`
// in tests/test_app_hotswap_725.py (525 acceptance bar 4).
service Ranker {
  fn strategy() -> Str         // which scoring build is live (proves the swap)
  fn signals() -> Int          // how many engagement signals are recorded
  fn score(id: Str) -> Int     // the note's score under the live strategy
  fn bump(id: Str)             // record one engagement signal for a note
}

// The baseline build: `recency`, each signal weighs 1. The engagement log is
// effect-created state under an `undo`, so every recorded signal reverts in LIFO
// order on teardown — residue-free — and `handoff ranking` declares the SHAPE
// that state carries across a hot-swap. A successor build (the `weighted` one in
// the swap test) declares the same shape and inherits the log warm; a successor
// whose shape differs is refused at admission, the running build left serving.
component TrendingRanker provides ranking: Ranker {
  handoff ranking: Map[Str, Str]           // the state contract for the swap
  let log = effect Map.new() undo log.drop() // the engagement log itself

  provide ranking {
    fn strategy() = "recency"

    fn signals() = log.size()

    // One engagement signal is one log row: a unique key (the running count)
    // mapped to the note id it credits. The insert is a revertible effect whose
    // derived inverse is `remove`, the model-store-natural counterpart, so a
    // signal recorded during activation reverts residue-free on teardown/divert.
    fn bump(id) {
      let k = `sig-${log.size()}`
      effect log.insert(k, id)
      undo   log.remove(k)
    }

    // Score = the count of signals crediting this id, times the strategy weight.
    // The `recency` build weighs each signal 1. The keys-then-get fold is the
    // same boring shape `NoteStore.all` uses (see §2 of the slice-1 gaps note);
    // no sentinel, no workaround.
    fn score(id) {
      var n = 0
      for (k of log.keys()) {
        let hit = match log.get(k) { Some(v) => v == id, None => false }
        if (hit) { n = n + 1 }
      }
      return n
    }
  }
}

// ------------------------------------------------- the FRONTEND (slice, item 459)

// 525's boring half also owns the UI, and 525 is explicit about its shape: "a UI
// built from external assets + a TS frontend behind a typed boundary (item 459)",
// NOT HTML/CSS/JS carried inside revl strings (the ~4,800-line console this whole
// milestone replaces). The webui coeffect (#772, design docs/design/526 and 530)
// is the boundary: an AMBIENT WebUI service the host runtime provides as
// `ctx.webui`, declared here as a first-class coeffect (`requires webui: WebUI`)
// and reached through `webui.add_entry`, which names EXTERNAL asset files only.
//
// The frontend itself is a normal Vite/Vue project under `examples/app/frontend/`
// with source maps to its own originals; this file names it by PATH and contains
// no JavaScript. The frontend consumes the notes app's TYPED ROUTES through the
// client `revl export client --lang ts --service NotesApi` derives from the
// `NotesApi` declaration above (item 457 artifact 5) — one declaration is both
// the server's router and the browser's typed call surface.
//
// The typed reactive-state / RPC `data` channel Cordis WebUI also offers (526,
// design note 530 Decision B) is NOT expressible from revl yet: `add_entry` has
// no `data` parameter, so the coeffect publishes an empty reactive surface and
// the shared state/RPC contract is authored on the TS side rather than PROJECTED
// from the service declaration. That is a filed gap against 459/457 (see
// docs/design/525-webapp-slice4-frontend.md §G3), not a workaround absorbed here:
// the frontend drives all note state through the typed REST routes, the landed
// typed contract, and the gap is what a `revl export client --face webui` slice
// (457 S4) closes.

// The ambient WebUI service the host provides as `ctx.webui`. `add_entry` names
// external asset files and returns a stable entry handle; it is an `emission`
// because registering a frontend is an outward effect on the host (the shape a
// `revl import cordis` of `@cordisjs/plugin-webui` recovers, design note 526).
service WebUI {
  emission fn add_entry(
    dev_source: Str,
    prod_manifest: Str,
    routes: List[Str],
  ) -> Str
}

// The notes console component. It declares the first-class coeffect on the
// ambient WebUI service and, at activation, registers the app's Vite/Vue frontend
// by naming external files only — the dev-mode source, the built Vite manifest,
// and the client route the entry owns. The binding is the declared coeffect, so
// `revl audit` reports the `webui` requirement (G1) and the `webui.add_entry`
// emission (the trusted host boundary, G8) on this component's surface; there is
// no `globalThis` bridge and no inline JS.
component NotesConsole requires webui: WebUI {
  emit webui.add_entry(
    "./frontend/entry.client.ts",            // dev-mode Vite/Vue source
    "./frontend/dist/.vite/manifest.json",   // built Vite manifest for production
    ["/notes"],                              // client route this entry owns
  )
}

// ---------------------------------------------------------------- lifecycle

// End-to-end on the real runtime: load the store then the HTTP component (the
// `requires` edge resolves provider-first), drive the endpoints through their
// provision keys, and assert the store persisted and reverts residue-free.
// Runs under `revl test` on the cordis-py runtime (tests/test_app_notes_725.py
// gates it on the runtime being installed), the same harness model_store.rvl
// uses.
lifecycle test "create then get returns the stored note" {
  load MemoryStore
  load NotesHttp
  let created = call notes_api.create_note({ title: "first", body: "hello" })
  assert created == Ok({ id: "note-0", title: "first", body: "hello" })
  let got = call notes_api.get_note("note-0")
  assert got == Ok({ id: "note-0", title: "first", body: "hello" })
  unload NotesHttp
  unload MemoryStore
  assert no_residue
}

// The differentiated half's baseline, on the real runtime: the ranker serves,
// records engagement, scores under its live strategy, and reverts residue-free
// on teardown. The hot-SWAP legs (admission, refusal, cancellation, recovery)
// need `Session.swap` and live in tests/test_app_hotswap_725.py; a lifecycle
// test cannot drive a swap, so this proves only the serving + residue-free
// teardown a swap depends on.
lifecycle test "ranker records engagement, scores by strategy, reverts residue-free" {
  load TrendingRanker
  let live = call ranking.strategy()
  assert live == "recency"
  call ranking.bump("note-0")
  call ranking.bump("note-0")
  call ranking.bump("note-1")
  let n = call ranking.signals()
  assert n == 3
  let s0 = call ranking.score("note-0")
  assert s0 == 2
  let s1 = call ranking.score("note-1")
  assert s1 == 1
  unload TrendingRanker
  assert no_residue
}

lifecycle test "get of an absent id is a typed 404 ApiError" {
  load MemoryStore
  load NotesHttp
  let miss = call notes_api.get_note("nope")
  assert miss == Err({ status: 404, code: "not_found",
                       message: "no note with that id" })
  unload NotesHttp
  unload MemoryStore
  assert no_residue
}

lifecycle test "list returns created rows and a reloaded store is empty" {
  load MemoryStore
  load NotesHttp
  call notes_api.create_note({ title: "a", body: "1" })
  call notes_api.create_note({ title: "b", body: "2" })
  let all = call notes_api.list_notes(None)
  assert all == Ok([{ id: "note-0", title: "a", body: "1" },
                    { id: "note-1", title: "b", body: "2" }])
  unload NotesHttp
  unload MemoryStore
  load MemoryStore
  load NotesHttp
  let empty = call notes_api.list_notes(None)
  assert empty == Ok([])
  unload NotesHttp
  unload MemoryStore
  assert no_residue
}
