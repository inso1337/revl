// REJECTED — G4: the undo expression runs with NO variables in scope. An
// extern binds none, and its own parameters are not implicitly visible —
// no tier defines teardown parameter capture. State the inverse needs must
// travel as constants or through other declared fns.
//
// expected error:
//   `path` is not declared — the `undo` slot of extern `open_ledger` runs
//   with no variables in scope

extern acquire fn open_ledger(path: Str) -> Int undo close_ledger(path)
  = @py { return abs(hash(path)) % 100000 }

extern pure fn close_ledger(handle: Int)
  = @py { return None }
