// `call` goes through a provision key and is checked against its service.
service Store { fn get(key: Str) -> Str }

component Kv provides kv: Store {
  let m = effect Map.new() undo m.drop()
  provide kv { fn get(key) = m.get(key) }
}

lifecycle test "calls an operation the service has not got" {
  load Kv
  call kv.put("k", "v")
  unload Kv
  assert no_residue
}
