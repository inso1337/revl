// REJECTED — A1 (roadmap item 131): silent leak #3. An acquisition's `undo`
// slot reaches an async operation.
//
// Teardown is synchronous on every tier: the two-phase abort loop does not
// await (docs/design/teardown-contract.md, the bound rule). A suspension in an
// `undo` would be a teardown that can hang or silently no-op — today py builds
// a coroutine the disposer drops. Item 131 makes it a compile error; teardown
// stays forward-path-free by construction (design §4 clause 4).
//
// `heat` is a PLAIN async operation on purpose: an `emission` in a bracket
// inverse is refused first, by G5 (docs/design/teardown-contract.md: a bracket
// inverse "may emit in teardown: no"), and this example is about the async
// fault alone.
//
// The acquisition is a plain async operation for the same kind of reason: an
// `effect await emit <async wrapper>` acquire records no emission step, so the
// emit side is refused first under G4 (issue #2969) and would hide the A1
// fault this document is about.
//
// expected error:
//   `undo` reaches async operation `w.heat`, but teardown is synchronous on
//   every tier

service Pool { async fn open(u: Str) -> Str }
service W { async fn heat() -> Int  fn cool() -> Int }
service Db { fn go() -> Str }
component A requires w: W, pool: Pool provides db: Db {
  config { u: Str }
  let c = effect await pool.open(config.u) undo w.heat()
  provide db { fn go() { return c } }
}
