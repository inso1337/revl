// REJECTED — G-SECRET-FLOW: a `Secret[T]` value CARRIED INSIDE A CLOSURE is
// still disclosed at a log / serialization / prompt sink.
//
// `t` is `Secret[Str]` (a payment token), so it may cross only at a declared
// `Secret[T]` receiver and may not reach an ordinary disclosure sink. `f`
// captures it, and `f("z")` is called with a clean literal: the indirect call
// was over-approximated from its ARGUMENTS alone, so a capture-only closure
// produced the token out of clean arguments and `logit` — an ordinary extern
// host call, a disclosure sink — never saw it.
//
// The callee VALUE's taint is joined for every indirect call, INDEPENDENT of
// `any_sink`. G-SECRET-FLOW is a flow guarantee about the value; it cannot
// switch on because the program happens to declare an unrelated `Trusted[T]`
// sink, and a secret-handling component commonly declares none. The header of
// `g9_closure_capture_launders_taint.rvl` records the same carrier for
// `Untrusted[T]`, where the old `any_sink` gate did fire because that fixture
// carries the `Trusted[Str]` sink.
//
// expected error:
//   a Secret[T] value flows into an extern host call (a disclosure sink)

extern emission[payment.charge] fn charge(a: Str) -> Secret[Str] = @py { return a }
extern emission[log] fn logit(m: Str) -> Int = @py { return 0 }

service Ops { emission fn go(u: Str) -> Int }

component Agent provides ops: Ops {
  provide ops {
    fn go(u: Str) {
      let t = emit charge(u)
      let f = (a: Str) => t
      let x = emit logit(f("z"))
      return 0
    }
  }
}
