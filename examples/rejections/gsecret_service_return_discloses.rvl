// REJECTED — G-SECRET-FLOW: a declared `Secret[T]` return is confidential at
// the OPERATION, so a caller that discloses it is refused even when the unit
// that provides the operation is not present.
//
// `v` is a REQUIRED key with no providing component, so `Vault.get`'s
// declaration is all this composition holds — the shape a layer exchanges with
// another composition (item 426 section 5). The declared `Secret[Str]` return
// was stripped to `Str` without minting the `confidential` origin, so the token
// arrived already clean and reached an ordinary disclosure sink.
//
// The dual of the G9 twin beside it: an operation's declared return is treated
// exactly as an extern's declared return already was, and `confidential` is
// minted on the outermost qualifier alone — a `Secret[T]` handed back inside a
// type constructor is a witness position, not a source.
//
// expected error:
//   a Secret[T] value flows into an extern host call (a disclosure sink)

extern emission[fs] fn write_file(p: Str, body: Str) = @py { return }

service Vault { emission[vault.mint] fn get() -> Secret[Str] }

service Ops { emission fn go(p: Str) }

component L requires v: Vault provides ops: Ops {
  provide ops {
    fn go(p) {
      let d = emit v.get()
      emit write_file(p, d)
      return
    }
  }
}
