// REJECTED — statements are newline-separated; there is no `;` separator in
// revl. The lexer refuses it at the source character with the rule in the
// hint (findings-map.md friction log).
//
// expected error:
//   unexpected ';'
//   statements are newline-separated — `;` is not a statement separator in
//   revl; put each statement on its own line

fn bump(n: Int) -> Int {
  let m = n + 1; return m
}
