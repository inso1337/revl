// REJECTED — G4: the nested host emission extern again, declared with a
// capability scope (`emission[net]`) rather than bare. The scope is the axis
// under test: it names WHICH boundary the call crosses and rides into the
// audit surface and the capability fold, and it changes nothing about whether
// the call site must say `emit`. An unscoped extern draws the same refusal
// (`g4_nested_host_emission_activation.rvl`).
//
// expected error:
//   call to emission `charge` must be marked `emit` (G4)

extern emission[net] fn log_line(n: Int) -> Int = @py { return 1 }
extern emission[net] fn charge(cents: Int) -> Int = @py { return 1 }

component Checkout {
  emit log_line(charge(199))
}
