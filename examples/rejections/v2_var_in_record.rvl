// REJECTED — a `var` never escapes its function (syntax-2.0 §3.5).
// A record literal is a value that can outlive the function, so it cannot
// contain a mutable cell directly. Copy the current value into a `let`
// first, or use the var outside the record.
//
// expected error:
//   `var` `n` cannot be used in a record literal — a `var` never escapes its function

fn leak() -> Int {
  var n = 1
  let row = { value: n }
  return row.value
}
