// REJECTED — G4: the undo slot may only call a DECLARED inverse. A typo'd or
// phantom teardown used to compile clean and then explode (or silently do
// nothing) at cleanup time on every tier.
//
// expected error:
//   `ghost_fn` is not declared — the `undo` slot of extern `open_ledger`
//   may only call a declared fn, extern, or host builtin

extern acquire fn open_ledger(path: Str) -> LedgerHandle undo ghost_fn(1)
  = @py { return abs(hash(path)) % 100000 }
