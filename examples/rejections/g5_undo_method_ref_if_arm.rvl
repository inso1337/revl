// REJECTED — G5: a crossing on ONE arm is enough, because the arm the local
// holds is decided at run time and the teardown cannot choose.
//
// `let g = if (b == 1) { w.task.run } else { pure1 }` binds a function value
// that is the `run` operation — declared `emission` — on one branch and a pure
// fn on the other, and `dispatch1(g)` hands whichever it is to the helper. The
// pure arm is the honest control that keeps the shape from being refused for the
// wrong reason: it is not the `if` that crosses, it is the value, so the check
// has to take the UNION of the arm values rather than the head it happens to
// read first. When `b` is 1 the emission fires in teardown, at or after the
// session verdict, which the slot's own head cannot bound.
//
// expected error:
//   the `undo` of this bracket calls `w.task.run`, which is an emission —
//     a bracket inverse runs in teardown and may not cross a boundary (G5)

extern pure fn pure1(k: Str) -> Int = @py { return 1 }

fn dispatch1(f: (Str) -> Int) -> Int { return f("z") }

service Net { emission[net] fn send(msg: Str) -> Int }
service Task { emission[net] fn run(prompt: Str) -> Int }
service S { fn go(b: Int) -> Int }

component Worker requires net: Net provides task: Task {
  provide task {
    fn run(prompt: Str) {
      emit net.send(prompt)
      return 1
    }
  }
}

component Sup requires net: Net provides s: S {
  let w = effect spawn Worker with { } undo w.dispose()
  provide s {
    fn go(b) {
      let g = if (b == 1) { w.task.run } else { pure1 }
      effect pure1("k")
      undo   dispatch1(g)
      return 1
    }
  }
}
