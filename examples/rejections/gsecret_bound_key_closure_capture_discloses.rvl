// REJECTED — G-SECRET: a capability-bound provider key CARRIED INSIDE A
// CLOSURE is still confined to its capability's extern bodies.
//
// `openai_key` is bound to `model.complete`, so `let s = emit complete(u)`
// mints the `secret` origin and that value has no declassifier and no allowed
// sink except a re-emission through the same bound capability. `f` captures
// it, and `f("z")` is called with a clean literal: the indirect call was
// over-approximated from its ARGUMENTS alone, so a capture-only closure
// produced the key out of clean arguments and `logit` — an ordinary extern
// host call — received it.
//
// The callee VALUE's taint is joined for every indirect call, INDEPENDENT of
// `any_sink`: G-SECRET is a flow guarantee about the value, and the comment on
// `gsecret_closure_capture_discloses.rvl` records the same `any_sink` gate for
// its `confidential` sibling. The direct spelling, `emit logit(s)`, is refused
// today ("a bound provider key can never leave its capability").
//
// expected error:
//   a capability-bound secret flows into an extern host call

secret openai_key for model.complete

extern emission[model.complete] fn complete(p: Str) -> Str = @py { return p }
extern emission[log] fn logit(m: Str) -> Int = @py { return 0 }

service Ops { emission fn go(u: Str) -> Int }

component Agent provides ops: Ops {
  provide ops {
    fn go(u: Str) {
      let s = emit complete(u)
      let f = (a: Str) => s
      let x = emit logit(f("z"))
      return 0
    }
  }
}
