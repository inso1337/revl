// REJECTED — G4: the teardown exists to INVERT the acquisition. Calling the
// acquiring extern inside its own `undo` would re-acquire during cleanup.
// (The parameter `path` is not visible here either: the slot's only
// implicit binding is `result`, the acquired value.)
//
// expected error:
//   extern `open_ledger`'s `undo` cannot call the extern itself

extern acquire fn open_ledger(path: Str) -> LedgerHandle undo open_ledger(path)
  = @py { return abs(hash(path)) % 100000 }
