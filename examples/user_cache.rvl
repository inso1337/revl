// The v0 demo pair: a database provider and a cache built on it.
// Swap PgDatabase for another Database provider at runtime and UserCache
// deactivates (LIFO, db still readable during its teardown) and reactivates
// against the replacement. Unload both and the environment is recovered.

service Database {
  fn query(sql: Str) -> List[Row]
  emission[db] fn execute(sql: Str) -> Int
}

service Cache {
  fn get(key: Str) -> Opt[Str]
  // emission: `put` writes the cache log through `db` (a service
  // declaration is an upper bound on what its providers may do)
  emission[db] fn put(key: Str, value: Str)
}

// revl:behavior begin
// kind: component
// effects: 1 reversible effect, 0 emissions
// capabilities: none
// realms: shared
// externs: Pool.open
// digest: sha256:7eb0c85eab290aa743d056d24407fb5efe9d2eb1b232d53ca85945e241497bcf
// revl:behavior end
component PgDatabase provides db: Database {
  config { url: Str, pool_size: Int = 10 }

  let pool = effect Pool.open(config.url, config.pool_size)
             undo   pool.close()

  provide db {
    fn query(sql)   = pool.query(sql)
    fn execute(sql) = pool.execute(sql)
  }
}

// revl:behavior begin
// kind: component
// effects: 2 reversible effects, 1 emission
// capabilities: db
// realms: shared
// externs: Map.new
// digest: sha256:a3d2827ffb2b439ab7a9de74d7688fc1259006fdcf1fb43d98e895792fb52019
// revl:behavior end
component UserCache requires db: Database provides cache: Cache {
  let store = effect Map.new() undo store.drop()

  provide cache {
    fn get(key) = store.get(key)
    fn put(key, value) {
      effect store.insert(key, value)
      undo   store.remove(key)
      emit db.execute(`INSERT INTO cache_log VALUES (${key})`)
    }
  }
}
