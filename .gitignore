.venv/
.cordis-py/
node_modules/
__pycache__/
*.egg-info/
.pytest_cache/

# written by `revl run --placement` (backends/typescript/_gen/mod_*.ts): the
# emitted cordis-ts module for a node-placed process, generated per run
backends/typescript/_gen/

# cargo build output for the in-repo crates and the rust consumer example
# (examples/ecosystem-consumer-rs is a standalone cargo project; its lockfile is
# resolved fresh, and tests/test_gate_consumer_example_rs.py builds a copy of it
# outside the checkout anyway)
crates/*/target/
examples/ecosystem-consumer-rs/target/
examples/ecosystem-consumer-rs/Cargo.lock

# the gate transpiled for JavaScript (tools/build_gate_js.py, roadmap item 335
# slice 4). Not committed for the same reason the .wasm is not: the output is a
# function of an exact jco and an exact rustc, so a committed copy would red on
# every bump while proving nothing. The crate SOURCE is what is drift-gated.
examples/ecosystem-consumer-js/dist/
examples/ecosystem-consumer-js/package-lock.json

# the exemplary web app's Vite output (docs/frontend-assets.md). `package-lock.json`
# IS committed next to it: `revl dev` spawns `npm run dev`, so the frontend half of
# the one dev command is only reproducible if its tree is pinned (item 461).
examples/app/frontend/dist/

# stray localhost access log (item 110a)
.srv.log
*.srv.log

# scratch artifacts written by harness demos / generated tests
*-note.txt
resume-web.log
backends/typescript/tests/generated/

# guard against sweeping machine-generated test output / secrets back in
backends/typescript/test-secret-store/
backends/typescript/.conformance-*/
backends/*/cost-ledger*.log
backends/*/costs-budgets.log
bench/results/opus-4-8-pilot/
uv.lock

# formal/ — generated by lake (the pinned toolchain + lean-toolchain
# reconstruct it; see formal/STATUS.md and .github/workflows/ci.yml)
formal/.lake/
formal/.axioms.out
formal/.oracle-axioms.out

# formal/ — harness outputs (corpus TSV + oracle verdict TSV), written by
# diff_corpus.py; regenerated on every `make formal`
formal/harness/out/
formal/harness/out/

# cargo build output for the rust in-process gate harness (item 333). The
# harness is source; its target/ is not, and `cargo run` in the checkout would
# otherwise leave a few hundred MB of untracked artefacts behind.
bench/inprocess_gate_rust/target/
bench/inprocess_gate_rust/Cargo.lock

# the playground/site compiler wheel (tools/check_site_wheel.py --write, or
# `python3 site/build.py`). NOT committed: it vendors the whole of src/revl, so
# a committed copy is stale the moment any module changes and can only be
# refreshed by a commit that races the merge queue — which is how `site wheel
# drift` came to be refreshed four times in one day and red again after each.
# `.github/workflows/pages.yml` builds it into the published artifact instead,
# so the deployed playground is built from the sha being deployed. Build it
# before serving `site/` or `playground/` from a checkout.
# (site/vendor/cordis-*.whl IS committed: its source is an external pinned
# clone, not this tree, so it cannot be built at deploy time.)
playground/vendor/revl-*.whl
site/vendor/revl-*.whl
