// A Postgres-backed Database provider. The plain hot-swap target: its provided
// interface is exactly the Database a UserCache consumes. `execute` declares
// the same `[db]` scope the running UserCache manifest declares, so the swap
// widens nothing — an exact, least-authority match, which ranks it first
// (docs/registry.md §2.1).

service Database {
  fn query(sql: Str) -> List[Row]
  emission[db] fn execute(sql: Str) -> Int
}

component PgDatabase provides db: Database {
  config { url: Str = "pg://", pool_size: Int = 10 }

  let pool = effect Pool.open(config.url, config.pool_size) undo pool.close()

  provide db {
    fn query(sql)   = pool.query(sql)
    fn execute(sql) = pool.execute(sql)
  }
}
